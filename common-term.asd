;;;; Public system names; legacy systems own the implementation.
(in-package #:asdf-user)
(defsystem "common-term" :depends-on ("lispterm")
  :in-order-to ((test-op (test-op "lispterm"))))
(defsystem "common-term/base" :depends-on ("lispterm/base")
  :in-order-to ((test-op (test-op "lispterm/base"))))
(defsystem "common-term/engine" :depends-on ("lispterm/engine")
  :in-order-to ((test-op (test-op "lispterm/engine"))))
(defsystem "common-term/pty" :depends-on ("lispterm/pty")
  :in-order-to ((test-op (test-op "lispterm/pty"))))
(defsystem "common-term/display" :depends-on ("lispterm/display")
  :in-order-to ((test-op (test-op "lispterm/display"))))
(defsystem "common-term/display-x11" :depends-on ("lispterm/display-x11")
  :in-order-to ((test-op (test-op "lispterm/display-x11"))))
(defsystem "common-term/display-wayland" :depends-on ("lispterm/display-wayland")
  :in-order-to ((test-op (test-op "lispterm/display-wayland"))))
(defsystem "common-term/launcher" :depends-on ("lispterm/launcher")
  :in-order-to ((test-op (test-op "lispterm/launcher"))))
(defsystem "common-term/autolith" :depends-on ("lispterm/autolith")
  :in-order-to ((test-op (test-op "lispterm/autolith"))))
(defsystem "common-term/tests" :depends-on ("lispterm/tests")
  :in-order-to ((test-op (test-op "lispterm/tests"))))
(defsystem "common-term/gpu" :depends-on ("lispterm/gpu")
  :in-order-to ((test-op (test-op "lispterm/gpu"))))
(defsystem "common-term/gpu-tests" :depends-on ("lispterm/gpu-tests")
  :in-order-to ((test-op (test-op "lispterm/gpu-tests"))))
