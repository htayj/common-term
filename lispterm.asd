(in-package #:asdf-user)
(defsystem "lispterm/base" :license "MIT" :serial t
 :components ((:file "src/package") (:file "src/conditions")))
(defsystem "lispterm/engine"
 :description "Native Lisp VT engine with a backend-neutral adapter"
 :license "MIT" :depends-on ("lispterm/base" "babel") :serial t
 :components (
 (:file "src/engine/compat")
 (:module "engine/nerimux/src" :serial t :components (
               (:file "package-types")
               (:file "package")
               (:file "cell")
               (:file "screen-data")
               (:file "screen")
               (:file "screen-metadata")
               (:file "screen-resize")
               (:file "screen-logic")
               (:file "scroll")
               (:file "erase")
               (:file "edit")
               (:file "cursor")
               (:file "char-write-definitions")
               (:file "char-write-cells")
               (:file "char-write")
               (:file "modes-alt-screen")
               (:file "modes-dec-pm-definitions")
               (:file "modes-cursor-save")
               (:file "modes-reset")
               (:file "modes-charset-definitions")
               (:file "modes-charset")
               (:file "modes-ansi-sm-rm-definitions")
               (:file "screen-projection")
               (:file "screen-osc-state")
               (:file "sgr-definitions")
               (:file "sgr-colors")
               (:file "sgr")
               (:file "sgr-report")
               (:file "csi-replies-definitions")
               (:file "csi-replies")
               (:file "csi-parameters")
               (:file "csi-dispatch")
               (:file "csi")
               (:file "csi-device-rules")
               (:file "csi-extended-rules")
               (:file "csi-compose")
               (:file "parser-dcs")
               (:file "parser-core")
               (:file "parser-csi")
               (:file "parser-utf8")
               (:file "parser")
               (:file "parser-vt52")
               (:file "parser-osc-clipboard")
               (:file "parser-osc-uri")
               (:file "parser-osc-color")
               (:file "parser-osc-dispatch")
               (:file "parser-osc")
               (:file "emulator")
)) (:file "src/engine/adapter")))

(defsystem "lispterm"
 :description "Same-image graphical terminal host"
 :depends-on ("lispterm/engine" "lispterm/pty" "lispterm/display-x11" "lispterm/display-wayland")
 :serial t :components ((:file "src/session") (:file "src/renderer")
                        (:file "src/window") (:file "src/host")))
(defsystem "lispterm/pty" :depends-on ("lispterm/base" "cffi")
 :serial t :components ((:file "src/pty/package") (:file "src/pty/ffi")
                        (:file "src/pty/posix") (:file "src/pty/process")))
(defsystem "lispterm/display" :depends-on ("lispterm/base" "babel")
 :serial t :components ((:file "src/display/package") (:file "src/display/cells")
                       (:file "src/display/font-otb") (:file "src/display/font")
                       (:file "src/display/keys") (:file "src/display/protocol")
                       (:file "src/display/framebuffer")))
(defsystem "lispterm/display-x11" :depends-on ("lispterm/display" "sb-bsd-sockets" "xclhb")
 :components ((:file "src/display/x11")))
(defsystem "lispterm/display-wayland" :depends-on ("lispterm/display" "cffi")
 :serial t :components ((:file "src/display/wayland-wire") (:file "src/display/wayland-protocol")
                       (:file "src/display/wayland-shm") (:file "src/display/xkb")
                       (:file "src/display/wayland")))

(defsystem "lispterm/launcher" :depends-on ("lispterm")
 :components ((:file "src/launcher")))
(defsystem "lispterm/autolith" :depends-on ("lispterm" "autolith")
 :components ((:file "src/autolith-adapter")))

(defsystem "lispterm/tests"
 :in-order-to ((test-op (load-op "lispterm/tests")))
 :depends-on ("lispterm/engine" "cl-weave") :serial t
 :components ((:module "engine/nerimux/t" :serial t :components (
(:file "package")
(:file "helpers-terminal-builders")
(:file "helpers-screen-assertions")
(:file "cell-tests")
(:file "cell-display-tests")
(:file "screen-tests")
(:file "screen-tests-b")
(:file "screen-tests-c")
(:file "screen-tests-d")
(:file "screen-queue-palette-tests")
(:file "screen-wrap-copy-tests")
(:file "cursor-tests")
(:file "cursor-tests-b")
(:file "cursor-tests-c")
(:file "cursor-tests-d")
(:file "cursor-tests-e")
(:file "char-write-tests")
(:file "scroll-tests")
(:file "scroll-erase-tests")
(:file "scroll-region-tests")
(:file "scroll-line-edit-tests")
(:file "scroll-tests-b")
(:file "scroll-tests-c")
(:file "scroll-tests-d")
(:file "modes-tests")
(:file "modes-tests-b")
(:file "modes-tests-c")
(:file "modes-tests-d")
(:file "modes-tests-e")
(:file "sgr-tests")
(:file "sgr-tests-b")
(:file "csi-composition-tests")
(:file "csi-tests")
(:file "csi-tests-d")
(:file "csi-tests-b")
(:file "csi-tests-c")
(:file "parser-utf8-tests")
(:file "parser-osc-tests")
(:file "parser-escape-tests")
(:file "parser-tests-b")
(:file "parser-control-state-tests")
(:file "parser-osc-continuations-tests")
(:file "parser-osc-dispatch-tests")
(:file "parser-osc52-tests")
(:file "parser-osc7-tests")
(:file "parser-dcs-tests")
(:file "parser-parser-utils-tests")
(:file "parser-basic-text-tests")
(:file "parser-inline-predicate-tests")
(:file "parser-state-cps-tests")
(:file "emulator-tests")
(:file "parser-fuzz-tests")
(:file "vt100-foundation-tests")
(:file "vt52-tests")
)) (:file "tests/engine-tests")))

(defmethod perform ((operation test-op) (system (eql (find-system "lispterm/tests"))))
  (declare (ignore operation system))
  (unless (uiop:symbol-call :cl-weave :run-all :reporter :spec :max-workers 1
                           :pass-with-no-tests nil)
    (error "lispterm engine suite failed")))


(defsystem "lispterm/gpu"
  :description "Offscreen ES3 renderer, Lisp-authored shaders and explicit driver lifetime"
  :license "MIT" :depends-on ("cffi") :serial t
  :components ((:module "src/gpu" :serial t :components (
    (:file "package") (:file "conditions")
    (:file "egl") (:file "gles") (:file "gbm") (:file "context")
    (:file "shader-dsl") (:file "shaders")
    (:file "atlas") (:file "instances")
    (:file "renderer") (:file "readback")))))

(defsystem "lispterm/gpu-tests"
  :license "MIT" :depends-on ("lispterm/gpu" "lispterm/display") :serial t
  :components ((:module "tests/gpu" :serial t :components (
    (:file "registry") (:file "language-tests") (:file "delivery-tests")
    (:file "foundation-tests") (:file "fixture-tests")
    (:file "shader-tests") (:file "probe-tests") (:file "software-control-tests")
    (:file "atlas-tests") (:file "offscreen-tests") (:file "evidence-tests")
    (:file "wayland-dmabuf-tests")))))
