;;;; Original navigation replay.
(load (merge-pathnames "vttest-vt52-native-io.lisp" *load-truename*))
(load (merge-pathnames "vttest-vt52-navigation.lisp" *load-truename*))
(load (merge-pathnames "vttest-vt52-native-trace.lisp" *load-truename*))
(defpackage :vttest-vt52-native-navigation
  (:use :cl) (:local-nicknames (:io :vttest-vt52-native-io))
  (:export :validate-recorder))
(in-package :vttest-vt52-native-navigation)
(defun event-properties (e)
  (io:guard-tree e :events t)
  (let ((keys nil))
    (loop for k in e by #'cddr do
      (io:need (and (keywordp k) (not (member k keys)))) (push k keys)))
  (dolist (k '(:seq :kind :pause :time :out :in)) (io:need (member k e))) e)
(defun one-event (events kind &optional hold)
  (let ((rows (remove-if-not (lambda (e) (and (eq kind (getf e :kind))
                (or (null hold) (eql hold (getf e :hold))))) events)))
    (io:need (= 1 (length rows))) (first rows)))
(defun input-offset (events)
  (let ((offset 0))
    (dolist (e events)
      (when (eq :wire-in (getf e :kind))
        (io:need (and (= offset (getf e :start)) (= offset (getf e :in))
          (< offset (getf e :end)) (= (- (getf e :end) offset) (length (getf e :bytes)))))
        (setf offset (getf e :end)))) offset))
(defun replay (proof stage hold output events pid)
  (io:properties proof '(:state :reasons :stage :start :markers :end :event :input :child-pid :ticks :checkpoint))
  (let* ((cp (getf proof :checkpoint)) (start (getf proof :start))
         (end (getf proof :end)) (seq (getf proof :event)))
    (io:properties cp '(:start :event :input :child-pid :ticks))
    (io:need (and (eq :ready (getf proof :state)) (null (getf proof :reasons))
      (eq stage (getf proof :stage)) (eql pid (getf proof :child-pid))
      (eql pid (getf cp :child-pid))
      (every (lambda (x) (typep x '(integer 0 *)))
        (list start end seq (getf proof :input) (getf proof :ticks)
              (getf cp :start) (getf cp :event) (getf cp :input) (getf cp :ticks)))
      (= start (getf cp :start)) (<= start end (length output))
      (< (getf cp :event) seq) (<= (getf cp :ticks) (getf proof :ticks))))
    (let* ((prefix (remove-if (lambda (e) (> (getf e :seq) seq)) events))
           (before (remove-if (lambda (e) (> (getf e :seq) (getf cp :event))) events))
           (between (remove-if (lambda (e) (<= (getf e :seq) (getf cp :event))) prefix))
           (driver (one-event between :driver))
           (first-p (eq stage :first-hold))
           (command (if first-p #(55 13) #(13)))
           (release (unless first-p (one-event between :navigation-released hold)))
           (wires (remove-if-not (lambda (e) (and (eq :wire-in (getf e :kind)) (eq :driver (getf e :source)))) between))
           (wire (car (last wires)))
           (marker (getf (first (getf proof :markers)) :start))
           (carrier (find-if (lambda (e) (and (eq :wire-out (getf e :kind))
                      (<= (getf e :start) marker) (< marker (getf e :end)))) prefix)))
      (io:need (= (getf cp :input) (input-offset before)))
      (io:need (= (getf proof :input) (input-offset prefix)))
      (io:need (and prefix (= seq (getf (car (last prefix)) :seq))
        (equalp command (getf driver :bytes))
        (or first-p (eql hold (getf release :pause)))
        (<= (getf driver :out) marker) (<= (getf wire :out) marker)
        (< (getf driver :seq) (getf wire :seq))
        (or first-p (< (getf driver :seq) (getf release :seq) (getf carrier :seq)))
        carrier (< (getf wire :seq) (getf carrier :seq))
        (equalp command (apply #'concatenate 'vector (mapcar (lambda (e) (getf e :bytes)) wires)))
        (<= (getf cp :input) (getf driver :in) (getf (first wires) :start))
        (= (+ (length command) (getf (first wires) :start)) (getf wire :end))
        (<= (getf wire :end) (getf proof :input))))
      (io:need (not (eq :refuse (getf (vttest-vt52-navigation:vt52-navigation-check
        (subseq output 0 start) before start pid :main-menu) :state))))
      (let ((fresh (vttest-vt52-navigation:vt52-navigation-check
                    (subseq output 0 end) prefix start pid stage)))
        (dolist (k '(:state :reasons :stage :start :markers))
          (io:need (equal (getf fresh k) (getf proof k))))))))
(defun validate-recorder (root backend scale)
  (let* ((paths '("recorder/RESULT.sexp" "recorder/observations.sexp"
                  "recorder/output.raw" "recorder/events.sexp" "recorder/input.raw"))
         (refs (mapcar (lambda (p) (io:reference root p)) paths))
         (r (io:read-data root (first paths)))
         (obs (io:read-data root (second paths)))
         (output (io:read-octets root (third paths) :limit 1048576))
         (events (io:read-events root (fourth paths)))
         (input (io:read-octets root (fifth paths) :limit 1048576)))
    (io:properties r '(:kind :version :backend :status :attempted :reached :captured
      :frame-verified :bytes :wire-accounting :reason :cleanup :checks :evidence
      :profile :scale :navigation-pauses :navigation :navigation-proofs :unverified-count))
    (io:need (and (eq :vttest-vt52-run (getf r :kind)) (eql 2 (getf r :version))
      (eq :vt52 (getf r :profile)) (equal backend (getf r :backend)) (eql scale (getf r :scale))
      (eq :pass (getf r :status)) (eq :pass (getf r :wire-accounting))
      (eq :graceful-exit (getf r :cleanup)) (eq :unverified (getf r :bytes))
      (eql 0 (getf r :unverified-count)) (equal '(1 2 3) (getf r :navigation-pauses))
      (every (lambda (k) (eql 1 (getf r k))) '(:attempted :reached :captured :frame-verified))))
    (io:need (= 3 (length (getf r :navigation))))
    (loop for n in (getf r :navigation) for pause from 1 do
      (io:properties n '(:pause :reached :released))
      (io:need (and (eql pause (getf n :pause)) (eq t (getf n :reached)) (eq t (getf n :released)))))
    (io:need (= 1 (length (getf r :checks))))
    (let ((c (first (getf r :checks))))
      (io:properties c '(:pause :pixels :bytes :timing :frame :target :native :comparison :evidence))
      (io:need (and (eql 2 (getf c :pause)) (eq :unverified (getf c :bytes))
        (every (lambda (k) (eq :pass (getf c k))) '(:pixels :timing :frame)))))
    (io:properties obs '(:kind :version :run :backend :clock :units-per-second :child-pid
      :association :query-production-time :sampling :missing :samples))
    (let* ((pid (getf obs :child-pid)) (samples (getf obs :samples))
           (spawn (remove-if-not (lambda (s) (and (eq :boundary (getf s :kind))
              (eq :child-spawn (getf s :boundary)) (eq :return (getf s :edge)))) samples)))
      (io:need (and (eq :recorder-observations (getf obs :kind)) (eql 1 (getf obs :version))
        (equal root (getf obs :run)) (eq (intern (string-upcase backend) :keyword) (getf obs :backend))
        (eq :single-owned-recorder-session (getf obs :association))
        (typep pid '(integer 1 *)) (= 1 (length spawn))
        (eql pid (getf (first spawn) :child-pid))))
      (dolist (e events)
        (event-properties e)
        (when (getf e :bytes)
          (setf (getf e :bytes) (map '(vector (unsigned-byte 8)) #'identity (getf e :bytes)))))
      (io:need (equalp input (apply #'concatenate 'vector
        (loop for e in events when (eq :wire-in (getf e :kind)) collect (getf e :bytes)))))
      (io:properties (getf r :navigation-proofs) '(:outer-hold :main-menu))
      (replay (getf (one-event events :navigation-reached 1) :proof) :first-hold 1 output events pid)
      (replay (getf (getf r :navigation-proofs) :outer-hold) :outer-hold 2 output events pid)
      (replay (getf (getf r :navigation-proofs) :main-menu) :main-menu 3 output events pid)
      (vttest-vt52-native-trace:validate-trace events output pid
        (getf (one-event events :navigation-reached 1) :proof)
        (getf (getf r :navigation-proofs) :outer-hold)
        (getf (getf r :navigation-proofs) :main-menu)))
    (dolist (ref refs) (io:check-reference ref root))
    (values r refs)))
