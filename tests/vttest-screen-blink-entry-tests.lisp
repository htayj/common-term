;;;; Reader-only entry-wait regression. No bootstrap or native session.
(require :sb-posix)
(in-package :cl-user)
(defparameter *source* (merge-pathnames "vttest-screen-recorder.lisp" *load-truename*))
(defparameter *checks* 0)
(defun check (name value)
  (unless value (error "Blink entry control failed: ~s" name))
  (incf *checks*))
;; Create reader packages and external symbols without loading their systems.
(dolist (p '("ASDF" "UIOP" "LISPTERM" "LISPTERM.ENGINE" "LISPTERM.PTY"
             "LISPTERM.DISPLAY.WAYLAND" "NERIMUX/TERMINAL" "VTTEST-SCREEN-RECORDER"
             "VTTEST-SCREEN-ORACLE" "VTTEST-SCREEN-FRAME" "VTTEST-SCREEN-BLINK-SELECTION"
             "VTTEST-SCREEN-BLINK-NATIVE" "VTTEST-SCREEN-BLINK-TIMING"
             "VTTEST-SCREEN-NATIVE-CONTRACT" "VTTEST-SCREEN-PIXELS" "VTTEST-CURSOR-DRIVER"))
  (unless (find-package p) (make-package p :use '("CL"))))
;; Shadow clock operations only in the recorder reader package. Actual AWAIT
;; keeps its default twenty-second deadline, driven by the deterministic clock.
(shadow '("GET-INTERNAL-REAL-TIME" "SLEEP") "VTTEST-SCREEN-RECORDER")
(defun constituent (c) (or (alphanumericp c) (find c "-._*+/")))
(let ((text (with-open-file (s *source*)
              (let ((v (make-string (file-length s)))) (read-sequence v s) v))))
  (loop for i from 1 below (1- (length text)) when (char= #\: (char text i)) do
    (let* ((start (loop for j downfrom (1- i) to 0 while (constituent (char text j))
                        finally (return (1+ j))))
           (p (and (< start i) (find-package (string-upcase (subseq text start i)))))
           (end (loop for j from (1+ i) below (length text) while (constituent (char text j))
                      finally (return j))))
      (when (and p (> end (1+ i))
                 (not (member (package-name p) '("SB-POSIX" "SB-EXT" "SB-THREAD") :test #'equal)))
        (let ((name (string-upcase (subseq text (1+ i) end))))
          (when (eq :inherited (nth-value 1 (find-symbol name p))) (shadow name p))
          (export (intern name p) p))))))
(defparameter *forms*
  (let ((*read-eval* nil) (*package* (find-package :cl-user)))
    (with-open-file (s *source*)
      (loop for f = (read s nil :eof) until (eq f :eof)
            when (eq (car f) 'in-package) do (setf *package* (find-package (second f)))
            when (and (eq (car f) 'defun)
                      (member (symbol-name (second f)) '("AWAIT" "AWAIT-BLINK-TARGET") :test #'equal))
              collect f))))
(in-package :vttest-screen-recorder)
(defparameter *output* 18588)
(defparameter *pause* 13)
(defparameter *wait-observer* nil)
(defvar *ticks* 0)
(defvar *polls* 0)
(defvar *schedule*)
(defvar *current*)
(defvar *render-candidates*)
(defun get-internal-real-time () *ticks*)
(defun sleep (seconds)
  (cl-user::check :poll-interval (= seconds .005))
  (incf *ticks* internal-time-units-per-second))
(defun check-native-failure ())
(defun check-host (host) (assert (eq host :host)))
(defun expected-text (snapshot) (declare (ignore snapshot)) "target")
(defun grid (host) (assert (eq host :host)) "target")
;; Entry-seam fixture, not a copy of the production admission predicate.
;; Existing render-quiescence controls exercise actual RENDER-STATE separately.
(defun render-state (host status)
  (assert (eq host :host))
  (assert (eq status *current*))
  (push status *render-candidates*)
  (list :render-quiescent (getf status :quiescent)))
(in-package :cl-user)
(defun stub (package name function) (setf (symbol-function (intern name package)) function))
(stub "LISPTERM" "STATUS"
      (lambda (host)
        (assert (eq host :host))
        (incf vttest-screen-recorder::*polls*)
        (setf vttest-screen-recorder::*current*
              (if (rest vttest-screen-recorder::*schedule*)
                  (pop vttest-screen-recorder::*schedule*)
                  (first vttest-screen-recorder::*schedule*)))))
(stub "VTTEST-SCREEN-BLINK-SELECTION" "WELL-FORMED-P" (constantly t))
(stub "VTTEST-SCREEN-FRAME" "SETTLED-P" (constantly t))
(stub "VTTEST-SCREEN-ORACLE" "SNAPSHOT-METADATA" #'identity)
(check :exact-selected-definitions (= 2 (length *forms*)))
(mapc #'eval *forms*)
(in-package :vttest-screen-recorder)
(defun candidate (visible quiescent)
  (list :blink-visible visible :quiescent quiescent :bytes-received *output* :input-pending 0))
(let* ((unpublished (candidate nil nil))
       (wrong-visible (candidate nil t))
       (dirty-visible (candidate t nil))
       (ready (candidate t t))
       (*schedule* (list unpublished wrong-visible dirty-visible ready))
       (*ticks* 0) (*polls* 0) (*render-candidates* nil))
  (cl-user::check :target (= *output* (await-blink-target :host '(:blink-visible t))))
  (cl-user::check :premature-admission-prevented (= *polls* 4))
  (cl-user::check :same-admitted-candidate (eq *current* ready))
  (cl-user::check :same-status-render-samples
                  (equal (reverse *render-candidates*) (list unpublished wrong-visible dirty-visible ready))))
(let ((*schedule* (list (candidate nil t)))
      (*ticks* 0) (*polls* 0) (*render-candidates* nil) (timed-out nil))
  (handler-case (await-blink-target :host '(:blink-visible t))
    (error (e)
      ;; Distinguish the real AWAIT deadline from fixture/setup errors.
      (unless (search "Deadline at pause" (princ-to-string e)) (error e))
      (setf timed-out t)))
  (cl-user::check :never-visible-times-out timed-out)
  (cl-user::check :default-twenty-second-deadline
                  (= *ticks* (* 21 internal-time-units-per-second)))
  (cl-user::check :all-candidates-refused (= *polls* 22)))
(format t "Blink entry: ~d checks passed.~%" cl-user::*checks*)
