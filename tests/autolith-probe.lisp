;;;; Runs only in a dedicated disposable SBCL, never the primary Autolith UI.
;; Loaded from the isolated user init by the actual bin/lispterm executable.
;; The launcher has already preloaded both extension systems before MAIN.
(unless (and (find-package :lispterm.autolith) (fboundp 'lispterm:main))
  (error "Autolith probe requires the graphical executable's loaded systems"))
(defpackage #:lispterm.autolith-probe (:use #:cl))
(in-package #:lispterm.autolith-probe)
(defvar *evaluated* nil)
(defvar *active-tested* nil)
(defvar *renderer-tested* nil)
(defvar *renderer-calls* 0)
(defvar *original-render-cell* nil)
(defvar *host* nil)
(defparameter *directory* (uiop:ensure-directory-pathname (uiop:getenv "LISPTERM_AUTOLITH_ARTIFACTS")))
(defun marker (name &optional value)
  (with-open-file (stream (merge-pathnames name *directory*) :direction :output :if-exists :supersede)
    (when value (write value :stream stream))))
(defun wait-for (predicate label)
  (let ((deadline (+ (get-internal-real-time) (* 100 internal-time-units-per-second))))
    (loop for tick from 0 until (funcall predicate)
          do (when (> (get-internal-real-time) deadline) (error "Timed out: ~A" label))
             (when (zerop (mod tick 20)) (ignore-errors (dump-screen)))
             (sleep .05))))
(defun dump-screen ()
  (when *host*
    (let ((session (lispterm::host-session *host*)))
      (sb-thread:with-mutex ((lispterm::session-lock session))
        (with-open-file (out (merge-pathnames "screen.txt" *directory*) :direction :output :if-exists :supersede)
          (let ((screen (lispterm::session-screen session)))
            (dotimes (row (lispterm.engine:rows screen))
              (dotimes (column (lispterm.engine:columns screen))
                (write-char (or (lispterm.engine:cell-character
                                 (lispterm.engine:cell-at screen row column)) #\Space) out))
              (terpri out))))))))
(defun enter (text)
  (lispterm:send-input *host* text)
  ;; Clinedi treats fast multi-character input as a paste. Submit separately.
  (sleep .3)
  (lispterm:send-input *host* (string #\Return)))
(defun active-test (application)
  ;; This function is invoked by Lisp input in the real application's controller.
  (let* ((before (loop for fd below 3 collect (sb-posix:readlink (format nil "/proc/self/fd/~D" fd))))
         (streams (list *standard-input* *standard-output* *error-output* *terminal-io*))
          (shell (progn
                   (assert (eq :continue (lispterm.autolith::graphical-shell-command application)))
                   (find-if (lambda (host) (not (eq host *host*)))
                            (loop for host being the hash-values of lispterm::*hosts* collect host)))))
      (assert shell)
      (assert (not (eq (lispterm::session-pty (lispterm::host-session shell))
                       (lispterm::session-pty (lispterm::host-session *host*)))))
    (unwind-protect
         (progn
           (assert (equal before (loop for fd below 3 collect (sb-posix:readlink (format nil "/proc/self/fd/~D" fd)))))
           (assert (equal streams (list *standard-input* *standard-output* *error-output* *terminal-io*)))
           (lispterm:send-input shell (format nil "printf 'ACTIVE-SHELL-OK\\n'~C" #\Return))
           (sleep .3)
           (assert (plusp (getf (lispterm:status shell) :bytes-received)))
            (marker "active-image.sexp" (list :registered-command-handler t :fresh-pty t :stdio-unchanged t :streams-identical t :same-image-pid (sb-posix:getpid)))
           (setf *active-tested* t))
      (lispterm.autolith:forget-host shell)
      (lispterm:close shell))))

(sb-thread:make-thread
 (lambda ()
   (handler-case
       (progn
         (wait-for (lambda () (setf *host* (first (loop for value being the hash-values of lispterm::*hosts* collect value)))) "graphical host")
         (wait-for (lambda () (and (boundp 'autolith::*active-application*)
                                  (typep autolith::*active-application* 'autolith::application))) "actual application")
         (sleep 2)
         (enter "(progn (with-open-file (s (merge-pathnames \"inside-runtime.sexp\" lispterm.autolith-probe::*directory*) :direction :output :if-exists :supersede) (write (list :pid (sb-posix:getpid) :main-thread (eq sb-thread:*current-thread* (sb-thread:main-thread)) :tty (loop for fd below 3 collect (plusp (cffi:foreign-funcall \"isatty\" :int fd :int))) :style (uiop:getenv \"AUTOLITH_SESSION_STYLE\") :term (uiop:getenv \"TERM\") :registered (not (null (autolith::tool-registry-find (autolith::application-tool-registry autolith::*active-application*) \"lispterm\" \"status\")))) :stream s)) (setf lispterm.autolith-probe::*evaluated* t) :same-heap-verified)")
         (wait-for (lambda () *evaluated*) "Lisp prompt evaluation")
         (let ((evidence (with-open-file (s (merge-pathnames "inside-runtime.sexp" *directory*)) (read s))))
           (assert (= (getf evidence :pid) (sb-posix:getpid)))
           (assert (getf evidence :main-thread))
           (assert (equal (getf evidence :tty) '(t t t)))
           (assert (string= (getf evidence :style) "direct"))
           (assert (string= (getf evidence :term) "xterm-256color"))
           (assert (getf evidence :registered)))
         (enter "(lispterm.autolith-probe::active-test autolith::*active-application*)")
         (wait-for (lambda () *active-tested*) "active-image shell")
          ;; Redefine the live renderer through the actual Lisp prompt. This is a
          ;; disposable source-backed change, not an Autolith journal mutation.
          (enter "(progn (setf lispterm.autolith-probe::*original-render-cell* (symbol-function 'lispterm.display::render-cell)) (defun lispterm.display::render-cell (display row column cell) (incf lispterm.autolith-probe::*renderer-calls*) (let ((copy (lispterm.display::copy-cell cell))) (setf (lispterm.display::cell-fg copy) #x70ff80) (funcall lispterm.autolith-probe::*original-render-cell* display row column copy))) (setf lispterm.autolith-probe::*renderer-tested* t) :live-renderer-green)")
          (wait-for (lambda () *renderer-tested*) "live renderer definition")
          (wait-for (lambda () (plusp *renderer-calls*)) "live renderer execution")
          (let ((session (lispterm::host-session *host*))
                (pty (lispterm::session-pty (lispterm::host-session *host*))))
            (lispterm:reopen *host*)
            (assert (eq session (lispterm::host-session *host*)))
            (assert (eq pty (lispterm::session-pty session)))
            (wait-for (lambda () (eq :attached (getf (lispterm:status *host*) :state))) "host reopened")
            (marker "live-renderer.sexp"
                    (list :definition-in-actual-prompt t :renderer-calls *renderer-calls*
                          :reopened t :same-session t :same-pty t :pid (sb-posix:getpid))))
         (sleep .5)
         (marker "ready")
         (wait-for (lambda () (probe-file (merge-pathnames "resized" *directory*))) "external resize")
         (wait-for (lambda () (let ((status (lispterm:status *host*)))
                               (and (= 45 (getf status :rows))
                                    (= 140 (getf status :columns))))) "resized PTY grid")
         (let ((pty (lispterm::session-pty (lispterm::host-session *host*))))
           (multiple-value-bind (rows columns) (lispterm.pty:pty-window-size pty)
             (assert (= 45 rows)) (assert (= 140 columns))))
         (marker "after-resize.sexp" (lispterm:status *host*))
         (dump-screen)
         (marker "capture-ready")
         (wait-for (lambda () (probe-file (merge-pathnames "captured" *directory*))) "screenshot capture")
         (enter "/quit")
         (marker "passed"))
     (serious-condition (condition)
       (ignore-errors (dump-screen))
       (marker "failure" (princ-to-string condition))
       (sb-ext:exit :code 1 :abort t))))
 :name "lispterm isolated Autolith test controller")
