;;;; Full synthetic outer boundary, with only the public PNG decoding call injected.
(load (merge-pathnames "vttest-vt52-native-contract-test-support.lisp" *load-truename*))
(load (merge-pathnames "vttest-vt52-native-navigation-test-support.lisp" *load-truename*))
(in-package :vttest-vt52-native-contract-tests)
(defun source-member (archive)
  (let ((p (sb-ext:run-program (namestring (truename "/run/current-system/sw/bin/tar"))
             (list "-xOzf" archive "vttest-20251205/vt52.c")
             :environment '("PATH=/run/current-system/sw/bin" "LC_ALL=C")
             :input nil :output :stream :error t :wait nil :external-format :utf-8)))
    (unwind-protect
      (let ((text (with-output-to-string (s)
                    (loop for c = (read-char (sb-ext:process-output p) nil) while c
                      for n from 1 do (assert (<= n 8192)) (write-char c s)))))
        (sb-ext:process-wait p)
        (format t "ARCHIVE-MEMBER-EXIT ~d~%" (sb-ext:process-exit-code p))
        (assert (eql 0 (sb-ext:process-exit-code p))) (a::bytes text))
      (sb-ext:process-close p))))
(defun recorder-files (root backend scale)
  (let ((raw (a::reserialize (vttest-vt52-admission-tests:fixture
                 :backend (intern (string-upcase backend) :keyword) :scale scale))))
    (dolist (k '(:before :ready :pre :final))
      (vttest-vt52-admission-tests::revise raw k
        (lambda (s) (setf (getf s :child-pid) 42) s)))
    (vttest-vt52-admission-tests::revise raw :request-sexp
      (lambda (r) (setf (getf (getf r :status) :child-pid) 42) r))
    (a::reserialize raw)
    (multiple-value-bind (r obs output events)
        (vttest-vt52-native-navigation-tests:fixture root backend scale)
      (setf (getf (first (getf r :checks)) :native) (a::parsed (getf raw :native)))
      (append
        (loop for (k suffix) on vttest-vt52-capture-adapter::*inputs* by #'cddr
          collect (cons (concatenate 'string "recorder/pause-02-" suffix) (getf raw k)))
        (list (cons "recorder/pause-02-actual.png" a::*png-bytes*)
          (cons "recorder/RESULT.sexp" (a::controlled-record r))
          (cons "recorder/observations.sexp" (a::controlled-record obs))
          (cons "recorder/output.raw" output)
          (cons "recorder/events.sexp"
            (a::bytes (format nil "~{~a~}"
              (mapcar (lambda (e) (sb-ext:octets-to-string (a::controlled-record e)
                                      :external-format :utf-8)) events)))))))))
(defun publish (root files)
  ;; Entire final queue exists before the first mkdir or exclusive output.
  (dolist (row files)
    (assert (<= (length (cdr row)) (fixture-limit (car row))))
    (format t "PREWRITE ~a~a ~d ~a~%" root (car row) (length (cdr row))
      (vttest-vt52-sha256:sha256-hex (cdr row))))
  (finish-output)
  (a::absent root) (sb-posix:mkdir root #o700)
  (dolist (d '("native/" "recorder/" "build/" "build/source/" "build/source/vttest-20251205/"))
    (sb-posix:mkdir (concatenate 'string root d) #o700))
  (dolist (row files)
    (let* ((p (concatenate 'string root (car row))) (v (cdr row)))
      (a::absent p)
      (let ((fd (sb-posix:open p (logior sb-posix:o-wronly sb-posix:o-creat sb-posix:o-excl sb-posix:o-nofollow) #o600)))
        (with-open-stream (s (sb-sys:make-fd-stream fd :output t :element-type '(unsigned-byte 8) :auto-close t))
          (write-sequence v s)))
      (assert (equalp v (a::read-bytes p))))) root)
(defun replace-queued (path value)
  (let ((row (assoc path *files* :test #'equal)))
    (assert row) (setf (cdr row) (a::controlled-record (copy-tree value)))))
(defun change-form (path fn) (replace-queued path (funcall fn (a::parsed (queued path)))))
(defun fixture (backend scale &optional mutate)
  (multiple-value-bind (root files) (assemble-root backend scale #'recorder-files :mutate mutate)
    (values (publish root files) files)))
(defun refusal (name root &rest options)
  (let ((r (apply #'c:validate-vt52-native root options)))
    (check name (and (eq :refuse (getf r :verdict)) (consp (getf r :reasons))
      (not (eql 1 (getf (getf r :counts) :passed))))) r))
(defun positive (backend scale)
  (multiple-value-bind (root files) (fixture backend scale)
    (let* ((a::*calls* 0) (r (c:validate-vt52-native root :backend backend :scale scale))
           (capture (getf r :capture)) (pixel (getf capture :checker)))
      (format t "OUTER ~a ~d ~s~%" backend scale r) (finish-output)
      (check (list :full-pass backend scale root)
        (and (eq :pass (getf r :verdict)) (null (getf r :reasons)) (= a::*calls* 1)
          (eql 1 (getf r :valid-frames))))
      (check :counts (equal '(:required 1 :attempted 1 :reached 1 :captured 1 :verified 1
                             :passed 1 :failed 0 :unverified 0) (getf r :counts)))
      (check :frame (equal '(:pause 2 :pixels :pass :bytes :unverified :timing :pass :frame :pass) (getf r :checks)))
      (check :actual-pixel-check (and (eq :pass (getf pixel :verdict))
        (eql 0 (getf pixel :frame-differences))
        (equal '(:count 32 :failed nil) (getf pixel :graphics))
        (equal '(:count 102 :failed nil) (getf pixel :boundaries))
        (equal (getf pixel :expected-sha256) (getf pixel :actual-rgba-sha256))))
      (check :same-originals (equal (getf capture :original-hashes) (getf capture :original-hashes-after)))
      (check :bounded (<= (length (a::controlled-record r)) 8192))
      (dolist (row files) (check (list :immutable (car row))
        (equalp (cdr row) (a::read-bytes (concatenate 'string root (car row))))))
    root)))
(defun negative (name path fn)
  (let ((root (fixture "x11" 1 (lambda () (change-form path fn)))))
    (refusal name root)))
(load (merge-pathnames "vttest-vt52-native-contract-fixture-cases.lisp" *load-truename*))
(defun run-tests ()
  (let* ((*checks* 0) (a::*calls* 0) (a::*action* nil) (a::*writes* 0)
         (font (a::read-bytes vttest-vt52-capture-adapter::*font-path*))
         (a::*images* (map 'vector (lambda (s)
           (vttest-vt52-pixels:expected-rgba (vttest-vt52-oracle:vt52-snapshot) font
             :font-sha256 vttest-vt52-capture-adapter::*font-pin* :scale s :blink-phase t)) '(1 2)))
         (symbol 'vttest-vt52-png-adapter:decode-original-png) (saved (symbol-function symbol)))
    (unwind-protect
      (progn
        (setf (symbol-function symbol) #'a::fake-decode)
        (let ((root (positive "x11" 1)))
          (refusal :backend-mismatch root :backend "wayland")
          (refusal :scale-mismatch root :scale 2)
          (check :no-public-candidate
            (handler-case (progn (c:validate-vt52-native root :candidate '(:status :pass)) nil)
              (program-error () t))))
        (positive "wayland" 1) (positive "wayland" 2)
        (refusal :bad-root "relative/")
        (dolist (entry '((:driver :native-driver "vt52-x11-v0") (:backend :backend "bad")
                         (:scale :scale 2) (:navigation :navigation-pauses (1 2))))
          (negative (first entry) "MANIFEST.sexp"
            (lambda (m) (setf (getf m (second entry)) (third entry)) m)))
        (negative :menu "MANIFEST.sexp" (lambda (m)
          (setf (getf (first (getf m :scenarios)) :menu-path) '(3)) m))
        (negative :ledger-pause "native/stages.sexp" (lambda (l)
          (setf (getf (first (getf l :entries)) :pause) 1) l))
        (negative :cleanup-wait "native/owned-cleanup.sexp" (lambda (u)
          (setf (getf (getf u :server) :waited) nil) u))
        (negative :deadline "native/import-deadline.sexp" (lambda (d)
          (setf (getf d :validated-ns) (getf d :deadline-ns)) d))
        (negative :abort "VT52-RUN.sexp" (lambda (n) (setf (getf n :abort) t) n))
        (negative :count "VT52-RUN.sexp" (lambda (n) (setf (getf n :captures) 2) n))
        (original-refusal-cases)
        (format t "CHECKS-BEFORE-KNOWN ~d~%" *checks*)
        (known-refusal-case)
        (format t "PASS ~d full synthetic outer checks. Lifecycle CLI callbacks pending; no native claim.~%" *checks*)
        *checks*)
      (setf (symbol-function symbol) saved)
      (assert (eq saved (symbol-function symbol))))))
