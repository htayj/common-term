;;;; Synthetic recorder evidence controls. Fake PNG text is not pixel evidence.
(in-package :vttest-keyboard-driver-tests)

(defun fixture-root-controls ()
  ;; Exercise actual artifact reads through both accepted environment spellings.
  (let* ((name "LISPTERM_KEYBOARD_TEST_ARTIFACTS")
         (old (sb-ext:posix-getenv name))
         (parent (string-right-trim "/" (or old "/tmp"))))
    (unwind-protect
         (dolist (suffix '("" "/"))
           (sb-posix:setenv name (c::cat parent suffix) 1)
           (let* ((root (recorder)) (dir (c::cat root "recorder/")))
             (check (and (not (search "//" root))
                         (char= #\/ (char root (1- (length root))))
                         (eq :pass (k::case-bytes "keyboard-cursor" dir)))
                    (list :fixture-root suffix))))
      (if old (sb-posix:setenv name old 1) (sb-posix:unsetenv name)))))

(defun source-wire (dir label suffix)
  (map 'string #'code-char (vttest-cursor-driver::bytes (c::cat dir label suffix))))
(defun save-events (path events)
  (with-open-file (s path :direction :output :if-exists :supersede)
    (let ((*print-pretty* nil))
      (dolist (e events) (write e :stream s) (terpri s)))))

(defun pending-enqueue-controls ()
  (dolist (variant '(nil (:input) (:transcript) (:input :transcript)))
    (dolist (wrong '(nil t))
      (let* ((root (recorder)) (dir (c::cat root "recorder/"))
             (label "keyboard-cursor") (events (k::events-of label dir)))
        (check (not (eq events :malformed)) :pending-fixture-readable)
        (unless (eq events :malformed)
          (let* ((begin (position :key-begin events :key (lambda (e) (getf e :kind))))
                 (enqueue (and begin (nth (1+ begin) events))))
            (check (and enqueue (eq :enqueue (getf enqueue :kind))) :pending-fixture-enqueue)
            (when (and enqueue (eq :enqueue (getf enqueue :kind)))
              (let* ((prefix (copy-tree (subseq events 0 (+ begin 2))))
                     (output (subseq (source-wire dir label ".transcript.raw") 0 (getf enqueue :out)))
                     (input (subseq (source-wire dir label ".input.raw") 0 (getf enqueue :in))))
                ;; Stop before accepting the first Up byte. Each variant owns its fixture.
                (when wrong (setf (getf (car (last prefix)) :bytes) "WRONG"))
                (save-events (c::cat dir label ".events.sexp") prefix)
                (put-bytes (c::cat dir label ".transcript.raw") output)
                (put-bytes (c::cat dir label ".input.raw") input)
                (sb-posix:unlink (c::cat dir label ".result.sexp"))
                (c:write-value (c::cat dir label ".exit") 3)
                (check (some (lambda (d) (search "pending" (string-downcase d)))
                             (c:check-events label output input prefix)) :strict-comparator-sees-pending)
                (check (eq (not wrong) (k::action-prefix-p label prefix)) :queued-intent)
                (dolist (wire variant)
                  (sb-posix:unlink (c::cat dir label
                                         (if (eq wire :input) ".input.raw" ".transcript.raw"))))
                (multiple-value-bind (state reasons) (k::case-bytes label dir)
                  (check (and (eq (if wrong :fail :unverified) state)
                              (or (not wrong)
                                  (and reasons (not (member :missing-byte-evidence reasons)))))
                         (list :pending-enqueue :wrong wrong :missing variant)))))))))))

(defun result-type-controls ()
  (let* ((root (recorder)) (dir (c::cat root "recorder/"))
         (label "keyboard-cursor") (path (c::cat dir label ".result.sexp"))
         (good (list :label label :returned-to-menu t :inventory-ok t :failure nil :errors nil
                     :status '(:error-count 0 :process-state :exited
                               :transport-state :hangup :input-pending 0))))
    (check (eq :pass (k::case-bytes label dir)) :typed-result-baseline)
    (dolist (mutation '((:returned-to-menu "false") (:inventory-ok 0)
                        (:status "not-a-plist")
                        (:status :error-count "0") (:status :input-pending "0")
                        (:status :process-state "exited") (:status :transport-state "hangup")))
      (let ((bad (copy-tree good)))
        (if (cddr mutation)
            (setf (getf (getf bad :status) (second mutation)) (third mutation))
            (setf (getf bad (first mutation)) (second mutation)))
        (c:write-value path bad)
        (check (eq :fail (k::case-bytes label dir)) (list :malformed-result mutation))))
    (let ((bad (copy-tree good)))
      (setf (getf bad :returned-to-menu) "false" (getf bad :inventory-ok) 0)
      (c:write-value path bad)
      (check (eq :fail (k::case-bytes label dir)) :truthy-malformed-completion))
    (c:write-value path good)
    (check (eq :pass (k::case-bytes label dir)) :typed-result-restored)
    (unwind-protect
         (dolist (missing '((:failure) (:errors) (:failure :errors)))
           (let ((partial (copy-tree good)))
             (dolist (key missing) (remf partial key))
             (c:write-value path partial)
             (check (eq :unverified (k::case-bytes label dir))
                    (list :missing-nullable-result missing))))
      (c:write-value path good))
    (check (eq :pass (k::case-bytes label dir)) :nullable-result-restored)))

(defun evidence-controls ()
  (let* ((root (recorder)) (dir (c::cat root "recorder/"))
         (label "keyboard-cursor") (path (c::cat dir label ".events.sexp"))
         (events (k::events-of label dir))
         (captures (unless (eq events :malformed)
                     (remove-if-not (lambda (e) (eq :capture (getf e :kind))) events))))
    (check (not (eq events :malformed)) :evidence-fixture-readable)
    (when (eq events :malformed) (return-from evidence-controls nil))
    (labels ((save (es) (with-open-file (s path :direction :output :if-exists :supersede)
                         (dolist (e es) (write e :stream s) (terpri s))))
             (inventory () (k::case-identity label dir)))
      (save (remove (car (last captures)) events :test #'eq))
      (check (eq :unverified (inventory)) :interrupted-prefix-inventory)
      (save events)
      (let ((a (first captures)) (b (second captures)))
        (save (mapcar (lambda (e) (cond ((eq e a) b) ((eq e b) a) (t e))) events)))
      (check (eq :fail (inventory)) :wrong-capture-order)
      (save events)
      (put-bytes path "(:not-an-event)")
      (check (eq :fail (k::case-bytes label dir)) :finite-malformed-events)
      (put-bytes path "#1=(:kind :capture :next #1#)")
      (check (eq :fail (k::case-bytes label dir)) :circular-events-rejected)
      (save events)
      (let ((result (c::cat dir label ".result.sexp")))
        (sb-posix:unlink result)
        (check (eq :unverified (k::case-bytes label dir)) :missing-result)
        (c:write-value result (list :label label :returned-to-menu nil :inventory-ok nil))
        (check (eq :unverified (k::case-bytes label dir)) :unfinished-result))
      (let* ((fresh (recorder)) (raw (c::cat fresh "recorder/" label ".input.raw"))
             (target (c::cat fresh "fixture-wire")))
        (put-bytes target "owned-fixture")
        (sb-posix:unlink raw) (sb-posix:symlink target raw)
        (check (eq :fail (k::case-bytes label (c::cat fresh "recorder/"))) :raw-symlink))
      (let* ((fresh (recorder)) (raw (c::cat fresh "recorder/" label ".input.raw")))
        (with-open-file (s raw :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
          (file-position s 16777216) (write-byte 0 s))
        (check (eq :fail (k::case-bytes label (c::cat fresh "recorder/"))) :raw-oversize)))))
