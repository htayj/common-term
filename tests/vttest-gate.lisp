;;;; Recorder v3. Baseline recording and fail-closed mechanical acceptance are distinct.
(load (merge-pathnames "../scripts/bootstrap.lisp" *load-truename*))
(asdf:load-system "lispterm")
(load (merge-pathnames "vttest-protocol.lisp" *load-truename*))
(defparameter *art* (uiop:ensure-directory-pathname (uiop:getenv "LISPTERM_VTTEST_ARTIFACTS")))
(defparameter *desired-scale* (parse-integer (or (uiop:getenv "LISPTERM_VTTEST_SCALE") "1")))
(defparameter *accept* (string= "accept" (uiop:getenv "LISPTERM_VTTEST_MODE")))
(defparameter *label* "startup")
(defparameter *phase* "startup")
(defparameter *output-count* 0)
(defparameter *input-count* 0)
(defparameter *event-number* 0)
(defparameter *capture-number* 0)
(defparameter *event-lock* (sb-thread:make-mutex :name "vttest evidence"))
(defparameter *sources* (make-hash-table :test #'eq))
(defvar *write-source* nil)
(defparameter *wayland-committed-output* -1)
(defparameter *wayland-ack-output* -1)
(defparameter *expected* nil)
(defparameter *attempted* nil)
(defparameter *completed* nil)
;; Counts are from the pinned source's holdit/MENU_HOLD paths, not inferred
;; from a partially successful recorder run. Keys are separately inventoried.
(defparameter *cases* vttest-check:*case-specs*)
(defun artifact (name) (merge-pathnames name *art*))
(defun record-value (name value) (vttest-check:write-value (artifact name) value))
(defun event-unlocked (kind &rest properties)
  (with-open-file (out (artifact (format nil "~a.events.sexp" *label*))
                       :direction :output :if-exists :append :if-does-not-exist :create)
    (let ((*print-pretty* nil))
      (write (append (list :seq (incf *event-number*) :kind kind :phase *phase*
                          :time (/ (get-internal-real-time) internal-time-units-per-second)
                          :out *output-count* :in *input-count*) properties) :stream out)
      (terpri out))))
(defun event (kind &rest properties)
  (sb-thread:with-mutex (*event-lock*) (apply #'event-unlocked kind properties)))
(defun enter-phase (name)
  (sb-thread:with-mutex (*event-lock*) (setf *phase* name) (event-unlocked :phase)))
(defun record-wire (kind bytes &optional source)
  (when (plusp (length bytes))
    (sb-thread:with-mutex (*event-lock*)
      (let* ((outp (eq kind :wire-out))
             (end (+ (if outp *output-count* *input-count*) (length bytes))))
        (with-open-file (s (artifact (format nil "~a.~a.raw" *label* (if outp "transcript" "input")))
                           :direction :output :element-type '(unsigned-byte 8)
                           :if-exists :append :if-does-not-exist :create) (write-sequence bytes s))
        (event-unlocked kind :end end :bytes (map 'string #'code-char bytes) :source source)
        (if outp (setf *output-count* end) (setf *input-count* end))))))
(defun grid-text (host)
  (let ((session (lispterm::host-session host)))
    (sb-thread:with-mutex ((lispterm::session-lock session))
      (let ((screen (lispterm::session-screen session)))
        (with-output-to-string (out)
          (dotimes (row (lispterm.engine:rows screen))
            (dotimes (column (lispterm.engine:columns screen))
              (write-char (or (lispterm.engine:cell-character
                               (lispterm.engine:cell-at screen row column)) #\Space) out))
            (terpri out)))))))
;; Instrument this disposable process only. Associate the actual queue head
;; with its origin, so partial PTY writes cannot turn driver bytes into replies.
(let ((reader (symbol-function 'lispterm.pty:pty-read))
      (writer (symbol-function 'lispterm.pty:pty-write))
      (enqueue (symbol-function 'lispterm::session-write))
      (flush (symbol-function 'lispterm::session-flush-input)))
  (setf (symbol-function 'lispterm.pty:pty-read)
        (lambda (&rest args)
          (let ((bytes (apply reader args)))
            (when (vectorp bytes) (record-wire :wire-out bytes)) bytes))
        (symbol-function 'lispterm.pty:pty-write)
        (lambda (pty bytes &rest args)
          (let ((count (apply writer pty bytes args)))
            (when (plusp count) (record-wire :wire-in (subseq bytes 0 count) *write-source*)) count))
        (symbol-function 'lispterm::session-write)
        (lambda (session bytes)
          (let ((count (funcall enqueue session bytes)))
            (when (plusp count)
              (let ((source (if lispterm::*enqueueing-response* :reply :input)))
                (setf (gethash (car (lispterm::session-input-tail session)) *sources*) source)
                (event :enqueue :source source :bytes (map 'string #'code-char bytes)))) count))
        (symbol-function 'lispterm::session-flush-input)
        (lambda (session)
          (let ((*write-source* (gethash (car (lispterm::session-input-head session)) *sources*)))
            (funcall flush session)))))
;; A session frame count records submission. Native capture additionally waits
;; for the compositor's frame callback for a commit containing the target read.
(let ((present (symbol-function 'lispterm.display.wayland::protocol-present))
      (pump (symbol-function 'lispterm.display.wayland::protocol-pump)))
  (setf (symbol-function 'lispterm.display.wayland::protocol-present)
        (lambda (&rest args)
          (let ((result (apply present args)))
            (when result (setf *wayland-committed-output* *output-count*)) result))
        (symbol-function 'lispterm.display.wayland::protocol-pump)
        (lambda (state &rest args)
          (prog1 (apply pump state args)
            (unless (lispterm.display.wayland::wayland-state-frame-pending-p state)
              (setf *wayland-ack-output* *wayland-committed-output*))))))
(defun trace-native (value)
  (with-open-file (s (artifact "native-events.sexp") :direction :output
                     :if-exists :append :if-does-not-exist :create)
    (let ((*print-pretty* nil))
      (write (list :label *label* :phase *phase* :out *output-count* :in *input-count*
                   :time (/ (get-internal-real-time) internal-time-units-per-second) :event value) :stream s)
      (terpri s))))
(let ((translate (symbol-function 'lispterm.display.x11::translate-key))
      (keyboard (symbol-function 'lispterm.display.wayland::keyboard-event))
      (emit (symbol-function 'lispterm.display.wayland::protocol-emit)))
  (setf (symbol-function 'lispterm.display.x11::translate-key)
        (lambda (client keycode modifiers)
          (let ((key (funcall translate client keycode modifiers)))
            (trace-native (list :backend :x11 :keycode keycode :modifiers modifiers
                                :core-mod2-mask (logand modifiers 16)
                                :keysyms (cdr (assoc keycode (xclhb:client-keycode-keysym-table client)))
                                :normalized key)) key))
        (symbol-function 'lispterm.display.wayland::keyboard-event)
        (lambda (state opcode payload)
          (trace-native (list :backend :wayland :opcode opcode :payload (coerce payload 'list)))
          (funcall keyboard state opcode payload))
        (symbol-function 'lispterm.display.wayland::protocol-emit)
        (lambda (state type &rest values)
          (when (member type '(:key :focus)) (trace-native (list :backend :wayland :type type :values values)))
          (apply emit state type values))))

(defun check-host (host)
  (when (lispterm:host-errors host) (error "Host error in ~a: ~s" *phase* (lispterm:host-errors host))))
(defun deadline (seconds) (+ (get-internal-real-time) (* seconds internal-time-units-per-second)))
(defun expired-p (end) (> (get-internal-real-time) end))
(defun menu-title (path)
  (case (first path)
    (5 "Keyboard Tests") (6 "Terminal Reports/Responses")
    (9 "Choose bug test number") (10 "Test of reset and self-test")
    (otherwise "Test of cursor movements")))
(defun menu-p (text title)
  (and (search "Enter choice number" text) (search title text)))
(defun wait-screen (host &key (seconds 25) (after -1) predicate)
  "Only a fresh, stable, explicitly recognized boundary succeeds."
  (loop with end = (deadline seconds) with previous = -1 with stable = 0
        for text = (grid-text host)
        do (check-host host)
           (if (= previous *output-count*) (incf stable) (setf stable 0 previous *output-count*))
        when (and (> *output-count* after) (>= stable 3) (zerop (getf (lispterm:status host) :input-pending)) (funcall predicate text))
          do (event :boundary :text text) (return text)
        when (eq :exited (getf (lispterm:status host) :process-state))
          do (error "Unexpected PTY exit in phase ~a" *phase*)
        when (expired-p end) do (error "Deadline waiting for ~a after output ~d" *phase* after)
        do (sleep .05)))
(defun frame-barrier (host)
  "Observe a ready geometry attempt, then force and await a fresh redraw."
  (let ((before nil) (target *output-count*) (end (deadline 10)))
    (loop for status = (lispterm:status host)
          for g = (getf status :geometry)
          do (check-host host)
             (when (member (getf g :phase) '(:refused :timed-out :cancelled :superseded))
               (error "Geometry capture rejected terminal phase ~a" (getf g :phase)))
             (unless (= target *output-count*) (error "PTY changed during geometry barrier"))
             (when (and (null before) (vttest-check:geometry-capture-ready-p status *desired-scale*)
                        (>= (getf status :bytes-received) target))
               (setf before status)
               (lispterm:invalidate host))
             (when (and before (not (vttest-check::same-geometry-attempt-p before status)))
               (error "Geometry attempt changed during capture barrier"))
          when (and before (vttest-check::fresh-geometry-frame-p before status *desired-scale*)
                    (>= (getf status :bytes-received) target) (eql 0 (getf status :input-pending))
                    (or (eq :x11 (getf status :backend)) (>= *wayland-ack-output* target)))
            return (list :recorder-version 3 :desired-scale *desired-scale*
                         :target-output target :before-frame (getf before :frames)
                         :before-status before :status status :native-ack-output *wayland-ack-output*)
          when (expired-p end) do (error "Geometry/render barrier expired in ~a: ~a" *phase*
                                        (nth-value 1 (vttest-check:geometry-capture-ready-p status *desired-scale*)))
          do (sleep .02))))
(defun capture (host suffix)
  (let* ((barrier (frame-barrier host))
         (name (format nil "~3,'0d-~a-~a" (incf *capture-number*) *label* suffix))
         (status (lispterm:status host))
         (requested-columns (vttest-check:requested-columns
                             (vttest-check::wire (artifact (format nil "~a.transcript.raw" *label*))))))
    (when (and *accept* (/= requested-columns (getf status :columns)))
      (error "Requested columns ~d, actual logical grid ~d" requested-columns (getf status :columns)))
    (with-open-file (out (artifact (concatenate 'string name ".grid.txt"))
                         :direction :output :if-exists :supersede) (write-string (grid-text host) out))
    (record-value (concatenate 'string name ".status.sexp") status)
    (record-value (concatenate 'string name ".barrier.sexp") barrier)
    (with-open-file (out (artifact "request-tmp") :direction :output :if-exists :supersede)
      (let ((g (getf status :geometry)))
      (format out "~a ~d ~d ~d~%" name (getf g :actual-width) (getf g :actual-height) *desired-scale*)))
    (rename-file (artifact "request-tmp") (artifact "capture-request"))
    (loop with end = (deadline 15) until (probe-file (artifact "captured"))
          when (expired-p end) do (error "Screenshot acknowledgement deadline") do (sleep .05))
    (delete-file (artifact "captured"))
    (let ((final (lispterm:status host)))
      (record-value (concatenate 'string name ".final-status.sexp") final)
      (unless (and (= (getf barrier :target-output) *output-count*)
                   (vttest-check::capture-proof-p status final barrier
                     (vttest-check:read-value (artifact (concatenate 'string name ".external.sexp")))
                     (vttest-check::png-size (artifact (concatenate 'string name ".png")))))
        (error "Geometry/output changed or external capture proof failed")))
    (event :capture :name name :barrier barrier)
    name))
(defun send (host text)
  (event :driver :bytes text)
  (lispterm:send-input host text))
(defun send-line (host number) (send host (format nil "~d~c" number #\Return)))
(defun native-key (host key)
  (event :key-begin :key key)
  (with-open-file (out (artifact "key-tmp") :direction :output :if-exists :supersede) (write-line key out))
  (rename-file (artifact "key-tmp") (artifact "key-request"))
  (loop with end = (deadline 10) until (probe-file (artifact "key-done"))
        when (expired-p end) do (error "Native key injection deadline") do (sleep .05))
  (delete-file (artifact "key-done"))
  ;; Both success and no delivery are measured. Exact expected bytes are checked
  ;; offline using this bracket. No missing key can masquerade as a terminal reply.
  (sleep .2)
  (check-host host)
  (loop with end = (deadline 5) until (zerop (getf (lispterm:status host) :input-pending))
        when (expired-p end) do (error "Native input delivery stalled") do (sleep .02))
  (event :key-end :key key))
(defun inventory ()
  (record-value "inventory.sexp" (list :recorder-version 3 :desired-scale *desired-scale* :expected *expected*
                                     :attempted *attempted* :completed *completed*)))
(defun run-case (backend label path holds)
  (setf *label* label *phase* "startup" *output-count* 0 *input-count* 0 *event-number* 0
        *wayland-committed-output* -1 *wayland-ack-output* -1)
  (clrhash *sources*)
  (setf *attempted* (append *attempted* (list label))) (inventory)
  (enter-phase "startup")
  (let ((host nil) (returned nil) (pauses 0) (key-phases 0) (choice-count 0)
        (failure nil) (capture-start *capture-number*) (status nil) (errors nil) (mark -1))
    (unwind-protect
         (handler-case
             (progn
               (setf host (lispterm:open :backend backend :rows 24 :columns 80
                           :title (uiop:getenv "LISPTERM_VTTEST_TITLE")
                           :argv (list (uiop:getenv "LISPTERM_VTTEST_BASH")
                                       (namestring (artifact "child.sh")) label)))
               (record-value (format nil "~a.initial-status.sexp" label) (lispterm:status host))
               (wait-screen host :predicate (lambda (text) (menu-p text "Test of cursor movements")))
               (loop for choice in path for tail on path for depth from 0
                     do (enter-phase (format nil "navigate-~d" depth))
                        (let ((before *output-count*))
                          (setf mark before)
                          (send-line host choice)
                          (when (rest tail)
                            (wait-screen host :after before
                              :predicate (lambda (text) (menu-p text (menu-title path)))))))
               (loop with after = mark repeat 40
                     do (let ((text (wait-screen host :after after
                                      :predicate (lambda (text)
                                                   (or (search "Push <RETURN>" text)
                                                       (search "Enter 0 to exit" text)
                                                       (search "Press each" text)
                                                       (menu-p text (menu-title (if (rest path) path nil))))))))
                          (setf after *output-count*)
                          (cond
                            ((search "Enter 0 to exit" text)
                             (unless (and (string= label "bug-d") (zerop choice-count))
                               (error "Unexpected choice0 screen"))
                             (incf choice-count) (capture host "choice0")
                             (setf after *output-count*)
                             ;; Temporal blink/pixel acceptance is a separate scheduled batch.
                             (send-line host 0))
                            ((search "Press each" text)
                             (let* ((cursorp (string= label "keyboard-cursor"))
                                    (titles (if cursorp '("ANSI / Cursor key mode RESET" "ANSI / Cursor key mode SET" "VT52 Mode")
                                                '("ANSI Numeric mode" "ANSI Application mode" "VT52 Numeric mode" "VT52 Application mode"))))
                               (unless (and (< key-phases (length titles)) (search (nth key-phases titles) text))
                                 (error "Unexpected keyboard phase ~d" key-phases))
                               (enter-phase (format nil "keys-~d" key-phases))
                               (dolist (key (if cursorp '("Up" "Down" "Left" "Right") '("KP_1" "KP_2" "KP_Enter")))
                                 (native-key host key)
                                 (capture host (format nil "keys~d-~a" key-phases (string-downcase key))))
                               (setf after *output-count*)
                               (native-key host "Tab") (incf key-phases)))
                            ((search "Push <RETURN>" text)
                             (incf pauses)
                             (when (> pauses holds) (error "Extra/stale pause boundary ~d" pauses))
                             (let ((anchor (vttest-check:pause-anchor label pauses)))
                               (unless (and anchor (search anchor text))
                                 (error "Wrong pause phase ~d, expected caption ~s" pauses anchor)))
                             (enter-phase (format nil "pause-~d" pauses))
                             (capture host (format nil "pause~2,'0d" pauses))
                             (setf after *output-count*)
                             (send host (string #\Return)))
                            (t
                             (unless (and (= pauses holds)
                                          (= key-phases (cond ((string= label "keyboard-cursor") 3)
                                                              ((string= label "keyboard-keypad") 4) (t 0)))
                                          (= choice-count (if (string= label "bug-d") 1 0)))
                               (error "Premature return: holds ~d/~d, keys ~d" pauses holds key-phases))
                             (setf returned t) (return)))))
               (unless returned (error "Screen loop exhausted"))
               ;; Exact return submenu, then main. Never exit by sending arbitrary zeros.
               (when (rest path)
                 (enter-phase "return-main")
                 (let ((before *output-count*))
                   (send-line host 0)
                   (wait-screen host :after before :predicate (lambda (text) (menu-p text "Test of cursor movements")))))
               (enter-phase "exit") (send-line host 0)
               (loop with end = (deadline 10) for s = (lispterm:status host)
                     until (and (eq :exited (getf s :process-state)) (eq :hangup (getf s :transport-state)))
                     do (check-host host)
                     when (expired-p end) do (error "Normal exit/hangup deadline") do (sleep .05))
               (unless (eql 0 (vttest-check:read-value (artifact (format nil "~a.exit" label))))
                 (error "Missing or nonzero vttest exit marker"))
               (event :exit))
           (error (c) (setf failure (princ-to-string c))
             (record-value (format nil "~a.failure.sexp" label) (list :phase *phase* :error failure))))
      (when host
        (setf status (lispterm:status host) errors (lispterm:host-errors host))
        (lispterm:close host)))
    (let ((ok (and returned (null failure))))
      (record-value (format nil "~a.result.sexp" label)
        (list :label label :path path :returned-to-menu returned :pauses pauses :expected-pauses holds
              :key-phases key-phases :captures (- *capture-number* capture-start)
              :expected-captures (+ holds (cond ((string= label "keyboard-cursor") 12)
                                               ((string= label "keyboard-keypad") 12)
                                               ((string= label "bug-d") 1) (t 0)))
              :inventory-ok ok :failure failure :status status :errors errors))
      (when ok (setf *completed* (append *completed* (list label)))) (inventory))))
(let* ((backend (if (string= (uiop:getenv "LISPTERM_VTTEST_BACKEND") "wayland") :wayland :x11))
       (filter (uiop:getenv "LISPTERM_VTTEST_FILTER"))
       (selected (remove-if-not (lambda (test) (or (null filter) (search filter (first test)))) *cases*)))
  (when (eq backend :wayland) (assert (null (uiop:getenv "DISPLAY"))))
  (setf *expected* (mapcar #'first selected)) (inventory)
  (unless selected (error "Empty vttest selection for filter ~s" filter))
  (dolist (test selected) (apply #'run-case backend test)))
(record-value "finished.sexp" (list :recorder-version 3 :captures *capture-number* :baseline-only (not *accept*)))
(let ((report (vttest-check:check-directory *art* :mode (if *accept* :accept :measure))))
  (record-value "checks.sexp" report)
  (unless (getf report :pass) (uiop:quit 1)))
