;;;; Offline, dependency-free vttest wire and recorder checks. Never evaluate artifacts.
(require :asdf)
(defpackage #:vttest-check (:use #:cl) (:export #:check-directory #:main #:read-value #:write-value
                                          #:case-complete-p #:expected-keys #:check-events #:*case-specs* #:pause-anchor #:requested-columns
                                          #:geometry-capture-ready-p))
(in-package #:vttest-check)
(defun read-value (path)
  (when (probe-file path)
    (with-open-file (s path) (let ((*read-eval* nil)) (read s nil nil)))))
(defun read-values (path)
  (when (probe-file path)
    (with-open-file (s path)
      (let ((*read-eval* nil)) (loop for v = (read s nil :eof) until (eq v :eof) collect v)))))
(defun write-value (path value)
  (with-open-file (s path :direction :output :if-exists :supersede)
    (let ((*print-pretty* t)) (write value :stream s) (terpri s))))
(defun wire (path)
  ;; Latin-1 character mapping, not UTF-8 decoding: offsets are octet offsets.
  (if (probe-file path)
      (with-open-file (s path :element-type '(unsigned-byte 8))
        (let ((v (make-array (file-length s) :element-type '(unsigned-byte 8))))
          (read-sequence v s) (map 'string #'code-char v))) ""))
(defun esc (tail) (concatenate 'string (string #\Esc) tail))
(defun occurrences (needle text)
  (loop for start = 0 then (+ pos (length needle))
        for pos = (search needle text :start2 start) while pos collect pos))
(defun nocc (needle text) (length (occurrences needle text)))
(defun cat (&rest strings) (apply #'concatenate 'string strings))
(defun expected-keys (label phase)
  (cond ((string= label "keyboard-cursor")
         (let ((prefix (nth phase '("[" "O" ""))))
           (when prefix (apply #'cat (loop for x in '("A" "B" "D" "C") collect (esc (cat prefix x)))))))
        ((string= label "keyboard-keypad")
         (case phase (0 (format nil "12~c" #\Return))
               (1 (cat (esc "Oq") (esc "Or") (esc "OM")))
               (2 (format nil "12~c" #\Return))
               (3 (cat (esc "?q") (esc "?r") (esc "?M")))))))
(defun case-complete-p (result exit)
  (let ((status (getf result :status)))
    (and result (getf result :returned-to-menu) (not (getf result :failure))
         (null (getf result :errors)) (eql 0 (getf status :error-count))
         (eq :exited (getf status :process-state)) (eq :hangup (getf status :transport-state))
         (eql 0 (getf status :input-pending)) (eql 0 exit)
         (getf result :inventory-ok))))
(defun report-measurement (dir)
  (flet ((w (label) (wire (merge-pathnames (cat label ".input.raw") dir))))
    (let ((dsr (w "reports-dsr")) (da (w "reports-da")) (param (w "reports-parameters")))
      (list :dsr5-terminal-ok (= 1 (nocc (esc "[0n") dsr))
            :cpr5-1-count (nocc (esc "[5;1R") dsr)
            :primary-da-count-including-startup (nocc (esc "[?1;2c") da)
            :parameter-report2-present (not (null (search (esc "[2;") param)))
            :parameter-report3-present (not (null (search (esc "[3;") param)))))))
;; DEC VT100 UG chapter 3, DECREQTPARM/DECREPTPARM parameter table:
;; https://vt100.net/docs/vt100-ug/chapter3.html#DECREQTPARM
;; This virtual terminal profile is 9600 baud (112), no parity (1), 8 bits (1),
;; multiplier16 (1), STP flags0. It has no SET-UP mode/unsolicited reports.
(defparameter *serial-profile* '(:parity 1 :bits 1 :tx-speed 112 :rx-speed 112 :clock 1 :flags 0))
(defparameter *case-specs*
  '(("cursor" (1) 6) ("screen" (2) 15) ("charsets" (3) 1)
    ("double-size" (4) 6) ("reports-dsr" (6 3) 1) ("reports-da" (6 4) 1)
    ("reports-parameters" (6 7) 1) ("vt52" (7) 3) ("vt102" (8) 14)
    ("bug-b" (9 2) 2) ("bug-c" (9 3) 1) ("bug-d" (9 4) 1)
    ("bug-e" (9 5) 1) ("bug-f" (9 6) 2) ("bug-wrap" (9 7) 1)
    ("bug-erase" (9 8) 6) ("bug-scroll" (9 9) 2) ("reset-ris" (10 1) 2)
    ("keyboard-cursor" (5 4) 1) ("keyboard-keypad" (5 5) 1)))
(defun case-spec (label) (assoc label *case-specs* :test #'equal))
(defun expected-captures (label)
  (let ((spec (case-spec label)))
    (when spec (+ (third spec) (cond ((member label '("keyboard-cursor" "keyboard-keypad") :test #'equal) 12)
                                   ((equal label "bug-d") 1) (t 0))))))
(defun requested-columns (output &optional (end (length output)))
  ;; DECCOLM can share a DEC private mode list with origin/reverse modes.
  ;; Do not apply a request until its h/l final byte is within END.
  (labels ((column-mode-final (start)
             (let ((position start) (column-mode-p nil))
               (loop
                 (let ((parameter-start position))
                   (loop while (and (< position end) (digit-char-p (char output position)))
                         do (incf position))
                   (when (= parameter-start position) (return nil))
                   (when (= 3 (parse-integer output :start parameter-start :end position))
                     (setf column-mode-p t)))
                 (when (= position end) (return nil))
                 (let ((final (char output position)))
                   (cond ((char= final #\;) (incf position))
                         ((and column-mode-p (find final "hl")) (return final))
                         (t (return nil))))))))
    (let ((columns 80))
      (loop for p from 0 below end
            do (cond
                 ((and (<= (+ p 3) end)
                       (string= (esc "[?") output :start2 p :end2 (+ p 3)))
                  (case (column-mode-final (+ p 3))
                    (#\h (setf columns 132))
                    (#\l (setf columns 80))))
                 ((and (<= (+ p 2) end)
                       (string= (esc "c") output :start2 p :end2 (+ p 2)))
                  (setf columns 80))))
      columns)))
(defun png-size (path)
  (when (probe-file path)
    (with-open-file (s path :element-type '(unsigned-byte 8))
      (let ((bytes (make-array 24 :element-type '(unsigned-byte 8) :initial-element 0)))
        (when (and (= 24 (read-sequence bytes s))
                   (equalp (subseq bytes 0 8) #(137 80 78 71 13 10 26 10))
                   (equalp (subseq bytes 12 16) #(73 72 68 82)))
          (flet ((u32 (i) (loop for j from i below (+ i 4) for n = (aref bytes j) then (+ (* n 256) (aref bytes j)) finally (return n))))
            (list (u32 16) (u32 20))))))))
(defun pause-anchor (label n)
  "Stable source-written captions identify phases. Repeated geometric tests share
captions but must have fresh output and the exact source-defined phase inventory."
  (let ((anchors
          (cond
            ((equal label "cursor") '("The screen should be cleared" "The screen should be cleared" "Test of autowrap" "Test of autowrap" "Test of cursor-control" "Test of leading zeros"))
            ((equal label "screen") '("WRAP AROUND" "Test of TAB" "132 column mode, light" "80 column mode, light" "132 column mode, dark" "80 column mode, dark"
                                       "Soft" "Soft" "Jump" "Jump" "Origin mode test" "Origin mode test" "Dark background" "Light background" "SAVE/RESTORE CURSOR"))
            ((equal label "charsets") '("Character set A"))
            ((equal label "double-size") '("80 column mode" "80 column mode" "132 column mode" "132 column mode" "Another test pattern" "Exactly half of the box"))
            ((equal label "reports-dsr") '("Device Status Report 5"))
            ((equal label "reports-da") '("Device Attributes report"))
            ((equal label "reports-parameters") '("Request Terminal Parameters"))
            ((equal label "vt52") '("rectangle of" "special graphics character set" "IDENTIFY command"))
            ((equal label "vt102") (loop repeat 2 append '("Screen accordion test" "Top line: A's" "Insert Mode" "Delete Character" "right column should be staggered" "right column should be staggered" "Insert Character")))
            ((equal label "bug-b") '("Here we go" "Line 11 should be double-wide"))
            ((equal label "bug-c") '("Except for this line"))
            ((equal label "bug-d") '("If the bug is present"))
            ((equal label "bug-e") '("This test should put an"))
            ((equal label "bug-f") '("bug, part 1" "bug, part 2"))
            ((equal label "bug-wrap") '("wrap around bug"))
            ((equal label "bug-erase") '("80 characters in single width" "40 characters in double width" "80 characters in single width" "132 characters in single width" "66 characters in double width" "132 characters in single width"))
            ((equal label "bug-scroll") '("no scroll region" "no scroll region"))
            ((equal label "reset-ris") '("terminal will now be RESET" "Push <RETURN>"))
            ((member label '("keyboard-cursor" "keyboard-keypad") :test #'equal) '("Push <RETURN>")))))
    (nth (1- n) anchors)))

(defun query-forms (label)
  "Wire grammar shared by complete-query matching and pending-prefix validation."
  (append (list (list (esc "[c") (esc "[?1;2c"))
                (list (esc "[0c") (esc "[?1;2c")))
          (when (equal label "reports-dsr")
            (list (list (esc "[5n") (esc "[0n")) (list (esc "[6n") (esc "[5;1R"))))
          (when (equal label "reports-parameters")
            (list (list (esc "[0x") (esc "[2;1;1;112;112;1;0x"))
                  (list (esc "[x") (esc "[2;1;1;112;112;1;0x"))
                  (list (esc "[1x") (esc "[3;1;1;112;112;1;0x"))))
          (when (equal label "vt52") (list (list (esc "Z") (esc "/Z"))))))
(defun known-query-forms ()
  "Recognize the union even in cases that must not issue these requests."
  (remove-duplicates (loop for label in '("reports-da" "reports-dsr" "reports-parameters" "vt52")
                           append (query-forms label)) :test #'equal))
(defun query-specs (label output)
  (declare (ignore label))
  (sort (loop for (query reply) in (known-query-forms)
              append (loop for p in (occurrences query output)
                           collect (list :start p :end (+ p (length query)) :query query :reply reply)))
        #'< :key (lambda (q) (getf q :start))))
(defun pending-query-prefix (label output)
  "Bounded prefix automaton, not a terminal emulator. Completed nonquery commands
  and ordinary text discard candidates. ESC restarts; CAN/SUB cancel. State is
  at most the longest proper prefix of a query in QUERY-FORMS. Read cuts do not
  change the stream, so an unfinished prefix cannot disappear at a read boundary."
  (declare (ignore label))
  (let ((forms (mapcar #'first (known-query-forms))) (pending ""))
    (loop for c across output
          do (setf pending (cond ((char= c #\Esc) (string c))
                                 ((find c '(#\Can #\Sub)) "")
                                 ((plusp (length pending)) (cat pending (string c)))
                                 (t "")))
             (when (or (member pending forms :test #'equal)
                       (notany (lambda (q) (and (< (length pending) (length q))
                                                (string= pending q :end2 (length pending)))) forms))
               (setf pending "")))
    (unless (zerop (length pending)) pending)))
(defun expected-key-byte-list (label p)
  (if (string= label "keyboard-cursor")
      (loop for x in '("A" "B" "D" "C") collect (esc (cat (nth p '("[" "O" "")) x)))
      (if (evenp p) (list "1" "2" (string #\Return))
          (loop for x in '("q" "r" "M") collect (esc (cat (if (= p 1) "O" "?") x))))))
(defun query-phase-inventory (label)
  "Query reply counts by recorder phase, derived from the source case catalog.
Reports run after the last navigation choice. VT52 IDENTIFY follows hold two."
  (append (list (list "startup" (esc "[?1;2c") 1))
          (let ((phase (format nil "navigate-~d" (1- (length (second (case-spec label)))))))
            (cond ((equal label "reports-da") (list (list phase (esc "[?1;2c") 1)))
                  ((equal label "reports-dsr")
                   (list (list phase (esc "[0n") 1) (list phase (esc "[5;1R") 2)))
                  ((equal label "reports-parameters")
                   (list (list phase (esc "[2;1;1;112;112;1;0x") 1)
                         (list phase (esc "[3;1;1;112;112;1;0x") 1)))
                  ((equal label "vt52") (list (list "pause-2" (esc "/Z") 1)))))))
(defun query-event-span (query events)
  "Return the contiguous read span and its completing event. Never cross a phase."
  (let* ((start (getf query :start)) (end (getf query :end))
         (reads (remove-if-not
                 (lambda (e) (and (eq :wire-out (getf e :kind))
                                  (< (getf e :out) end) (> (getf e :end) start))) events))
         (first (first reads)) (last (car (last reads))))
    (when (and first (<= (getf first :out) start) (>= (getf last :end) end)
               (loop for (a b) on reads while b always (= (getf a :end) (getf b :out)))
               (every (lambda (e) (equal (getf first :phase) (getf e :phase))) reads)
               (notany (lambda (e) (and (eq :phase (getf e :kind))
                                        (< (getf first :seq) (getf e :seq) (getf last :seq)))) events))
      (values reads last))))
(defun query-anchor-action (label phase)
  "Pinned vttest-20251205 reports.c menu entries and main.c VT52 hold two.
  Return the complete source action required before any test query octet."
  (cond ((equal phase "startup") nil)
        ((equal label "vt52") (list "pause-2" (string #\Return)))
        (t (let ((path (second (case-spec label))))
             (list (format nil "navigate-~d" (1- (length path)))
                   (format nil "~d~c" (car (last path)) #\Return))))))
(defun accepted-driver-actions (events)
  "Derive action completion from actual FIFO writes, not enqueue intent.
  CHECK-EVENTS independently validates every byte/source/offset of this replay."
  (let ((queue nil) (driver nil) (remaining "") (actions nil))
    (dolist (e events)
      (case (getf e :kind)
        (:driver (setf driver e remaining (getf e :bytes)))
        (:enqueue (setf queue (append queue (list (list (getf e :source) (getf e :bytes))))))
        (:wire-in
         (let* ((head (first queue)) (bytes (getf e :bytes)) (n (length bytes)))
           (when (and head (eq (first head) (getf e :source))
                      (<= n (length (second head)))
                      (string= bytes (second head) :end2 n))
             (setf (second head) (subseq (second head) n))
             (when (zerop (length (second head))) (pop queue))
             (when (and driver (eq :input (getf e :source)) (plusp n)
                        (equal (getf driver :phase) (getf e :phase))
                        (<= n (length remaining)) (string= bytes remaining :end2 n))
               (setf remaining (subseq remaining n))
               (when (zerop (length remaining))
                 (push (list :phase (getf driver :phase) :bytes (getf driver :bytes)
                             :completion e) actions)
                 (setf driver nil))))))))
    (nreverse actions)))
(defun query-inventory-errors (label queries events)
  (let ((errors nil) (observed nil) (wanted (query-phase-inventory label))
        (actions (accepted-driver-actions events)))
    (dolist (q queries)
      (multiple-value-bind (span completion) (query-event-span q events)
        (if completion
            (let* ((phase (getf completion :phase))
                   (spec (query-anchor-action label phase))
                   (anchor (if spec
                               (getf (find spec actions :test #'equal
                                           :key (lambda (a) (list (getf a :phase) (getf a :bytes)))) :completion)
                               (find-if (lambda (e) (and (eq :phase (getf e :kind))
                                                        (equal "startup" (getf e :phase)))) events))))
              (push (list phase (getf q :reply)) observed)
              (unless (and anchor (< (getf anchor :seq) (getf (first span) :seq))
                           (<= (getf anchor :time) (getf (first span) :time)))
                (push (format nil "Query starts before fully accepted source action ~s at ~d"
                              (or spec '("startup")) (getf q :start)) errors)))
            (push (format nil "Query crosses a phase or lacks contiguous reads at ~d" (getf q :start)) errors))))
    (dolist (spec wanted)
      (unless (= (third spec) (count (subseq spec 0 2) observed :test #'equal))
        (push (format nil "Wrong source-defined query inventory for ~s" spec) errors)))
    (dolist (item observed)
      (unless (find item wanted :test #'equal :key (lambda (s) (subseq s 0 2)))
        (push (format nil "Query outside source-defined phase: ~s" item) errors)))
    errors))
(defun check-events (label output input events)
  "Validate both wires, origins, query counts, causal ordering and phase identity.
Offsets refer to octets. Times use one process's monotonic clock. Accepted
writes must match the enqueue FIFO and driver intent or a native-key bracket."
  (let ((errors nil) (out 0) (in 0) (seq 0) (phase nil) (last-time -1)
        (replies nil) (keys nil) (active-key nil) (drivers "") (enqueued nil)
        (queries (query-specs label output)))
    (flet ((bad (format-control &rest args) (push (apply #'format nil format-control args) errors)))
      (unless events (bad "Missing phase/wire events"))
      (let ((prefix (pending-query-prefix label output)))
        (when prefix (bad "Unconsumed query/control prefix at EOF: ~s" prefix)))
      (dolist (e events)
        (unless (and (eql (getf e :seq) (incf seq))
                     (numberp (getf e :time)) (>= (getf e :time) last-time)
                     (eql (getf e :out) out) (eql (getf e :in) in))
          (bad "Corrupt event sequence/clock/offset at ~s" seq))
        (setf last-time (or (getf e :time) last-time))
        (case (getf e :kind)
          (:phase (when active-key (bad "Phase changed inside native key"))
                  (unless (and (zerop (length drivers)) (null enqueued)) (bad "Phase changed with pending input"))
                  (setf phase (getf e :phase)))
          (:wire-out
           (let ((end (getf e :end)))
             (if (and (integerp end) (<= out end (length output))
                      (equal (getf e :bytes) (subseq output out end)))
                 (setf out end) (bad "Output wire corruption at ~s" seq))))
          (:enqueue
           (unless (and (member (getf e :source) '(:reply :input)) (stringp (getf e :bytes))) (bad "Invalid enqueue origin/bytes"))
           (setf enqueued (append enqueued (list (list (getf e :source) (getf e :bytes) e)))))
          (:wire-in
           (let ((end (getf e :end)) (bytes (getf e :bytes)) (source (getf e :source))
                 (origin (third (first enqueued))))
             (if (and (integerp end) (<= in end (length input)) (equal bytes (subseq input in end)))
                 (progn
                   (unless (and enqueued (eq source (caar enqueued))
                                (<= (length bytes) (length (second (first enqueued))))
                                (string= bytes (second (first enqueued)) :end2 (length bytes)))
                     (bad "Accepted write differs from enqueue FIFO/source"))
                   (when enqueued
                     (let ((remaining (second (first enqueued))))
                       (if (>= (length bytes) (length remaining)) (pop enqueued)
                           (setf (second (first enqueued)) (subseq remaining (length bytes))))))
                   (case source
                    (:reply (push (list :bytes bytes :out out :phase phase :seq seq :time (getf e :time)
                                        :origin origin) replies))
                     (:input
                      (if active-key
                          (progn (unless (zerop (length drivers)) (bad "Driver/native overlap"))
                                 (push bytes (getf active-key :chunks)))
                          (if (and (<= (length bytes) (length drivers)) (string= bytes drivers :end2 (length bytes)))
                              (setf drivers (subseq drivers (length bytes)))
                              (bad "Input outside driver intent/native bracket"))))
                     (otherwise (bad "Unattributed input")))
                   (setf in end)) (bad "Input wire corruption at ~s" seq))))
          (:driver (when active-key (bad "Driver input inside native bracket"))
                   (setf drivers (cat drivers (getf e :bytes))))
          (:key-begin (when (or active-key (plusp (length drivers))) (bad "Overlapping native key/driver"))
                      (setf active-key (list :phase phase :key (getf e :key) :chunks nil)))
          (:key-end (unless (and active-key (equal (getf active-key :key) (getf e :key))) (bad "Unmatched native key end"))
                    (when active-key
                      (push (list :phase (getf active-key :phase) :key (getf active-key :key)
                                  :bytes (apply #'cat (reverse (getf active-key :chunks)))) keys))
                    (setf active-key nil))
          (:exit (when (pending-query-prefix label (subseq output 0 out))
                   (bad "Unconsumed query/control prefix at normal exit")))
          ((:capture :boundary) nil)
          (otherwise (bad "Unknown event kind ~s" (getf e :kind))))
        (unless (equal (getf e :phase) phase) (bad "Phase corruption at ~s" seq)))
      (when (or active-key enqueued (plusp (length drivers))) (bad "Unclosed key/pending enqueue/driver input"))
      (unless (and (= out (length output)) (= in (length input))) (bad "Truncated wire event inventory"))
      (dolist (issue (query-inventory-errors label queries events)) (bad "~a" issue))
      (let ((pending (reverse replies)))
        (loop for q in queries
              do (let* ((expected (getf q :reply)) (actual "")
                        (qe (nth-value 1 (query-event-span q events)))
                        (next-driver (find-if (lambda (e) (and qe (> (getf e :seq) (getf qe :seq))
                                                                           (member (getf e :kind) '(:driver :key-begin :phase)))) events)))
                   (loop while (and pending (< (length actual) (length expected)))
                         for r = (pop pending)
                         do (unless (and qe (>= (getf r :out) (getf q :end))
                                         (> (getf r :seq) (getf qe :seq))
                                         (getf r :origin)
                                         (> (getf (getf r :origin) :seq) (getf qe :seq))
                                         (>= (getf (getf r :origin) :out) (getf q :end))
                                         (equal (getf (getf r :origin) :phase) (getf qe :phase))
                                         (equal (getf qe :phase) (getf r :phase))
                                         (<= 0 (- (getf r :time) (getf qe :time)) 5)
                                         (or (null next-driver) (< (getf r :seq) (getf next-driver :seq))))
                              (bad "Reply timing/phase mismatch for output query ~d" (getf q :start)))
                            (setf actual (cat actual (getf r :bytes))))
                   (unless (string= expected actual)
                     (bad "Wrong/missing/duplicate reply to ~s at output ~d: expected ~s, got ~s"
                          (getf q :query) (getf q :start) expected actual))))
        (when pending (bad "Unexpected or duplicate terminal replies")))
      (when (member label '("keyboard-cursor" "keyboard-keypad") :test #'string=)
        (let ((ordered (reverse keys)) (phases (if (string= label "keyboard-cursor") 3 4)))
          (unless (= (length ordered) (* phases (if (string= label "keyboard-cursor") 5 4)))
            (bad "Extra or missing native key inventory"))
          (dotimes (p phases)
            (let* ((phase-name (format nil "keys-~d" p))
                   (group (remove-if-not (lambda (k) (equal phase-name (getf k :phase))) ordered))
                   (wanted (append (if (string= label "keyboard-cursor") '("Up" "Down" "Left" "Right")
                                       '("KP_1" "KP_2" "KP_Enter")) '("Tab")))
                   (bytes (append (expected-key-byte-list label p) (list (string #\Tab)))))
              (unless (and (equal wanted (mapcar (lambda (k) (getf k :key)) group))
                           (equal bytes (mapcar (lambda (k) (getf k :bytes)) group)))
                (bad "Native key order/per-key bytes mismatch in ~a" phase-name))))))
      (nreverse errors))))
(defun phase-inventory-errors (label events)
  (unless (case-spec label)
    (return-from phase-inventory-errors (list "Unknown source-defined case")))
  (let* ((spec (case-spec label)) (path (second spec)) (holds (third spec))
         (key-count (cond ((equal label "keyboard-cursor") 3) ((equal label "keyboard-keypad") 4) (t 0)))
         (wanted (append '("startup") (loop for i below (length path) collect (format nil "navigate-~d" i))
                         (loop for i below key-count collect (format nil "keys-~d" i))
                         (loop for i from 1 to holds collect (format nil "pause-~d" i))
                         (when (rest path) '("return-main")) '("exit")))
         (phases (loop for e in events when (eq :phase (getf e :kind)) collect (getf e :phase)))
         (drivers (loop for e in events when (eq :driver (getf e :kind)) collect (getf e :bytes)))
         (expected-drivers (append (mapcar (lambda (n) (format nil "~d~c" n #\Return)) path)
                                   (when (equal label "bug-d") (list (format nil "0~c" #\Return)))
                                   (loop repeat holds collect (string #\Return))
                                   (when (rest path) (list (format nil "0~c" #\Return)))
                                   (list (format nil "0~c" #\Return)))))
    (append (unless (equal wanted phases) (list "Source-defined phase inventory/order mismatch"))
            (unless (equal drivers expected-drivers) (list "Driver navigation/advance/normal-exit intent mismatch")))))

(defun geometry-capture-ready-p (status desired-scale)
  "Validate one published STATUS, not frame freshness or capture provenance.
Return readiness and a diagnostic keyword. No display or recorder is loaded."
  (handler-case
      (let* ((g (getf status :geometry)) (cols (getf status :columns))
             (rows (getf status :rows)) (cw (getf g :cell-width)) (ch (getf g :cell-height))
             (id (getf g :request-id)) (phase (getf g :phase))
             (w (getf g :actual-width)) (h (getf g :actual-height)))
        (flet ((fail (reason) (return-from geometry-capture-ready-p (values nil reason))))
          (unless g (fail :no-geometry))
          (unless (and (member desired-scale '(1 2)) (eql 0 (getf status :error-count)))
            (fail :scale-or-errors))
          (unless (every (lambda (n) (typep n '(integer 1))) (list cols rows cw ch))
            (fail :metrics))
          (unless (and (eql cols (getf g :columns)) (eql rows (getf g :rows))
                       (eql cols (getf status :pty-columns)) (eql rows (getf status :pty-rows))
                       (eql w (* cols cw)) (eql h (* rows ch)))
            (fail :grid-or-dimensions))
          (unless (and (every (lambda (key) (typep (getf g key) '(integer 0)))
                              '(:epoch :display-epoch :metric-generation :presentation))
                       (every (lambda (key) (typep (getf status key) '(integer 0)))
                              '(:frames :bytes-received :engine-geometry-generation)))
            (fail :missing-generations))
          (cond ((null id)
                 (unless (and (eq phase :idle) (eql 0 (getf status :engine-geometry-generation))
                              (null (getf g :target-presentation))) (fail :not-initial-idle)))
                (t
                 (unless (and (typep id '(integer 0)) (eq phase :settled)
                              (eql id (getf status :engine-geometry-generation))
                              (eql cols (getf g :requested-columns)) (eql rows (getf g :requested-rows))
                              (eql w (getf g :requested-width)) (eql h (getf g :requested-height))
                              (typep (getf g :target-presentation) '(integer 0))
                              (>= (getf g :presentation) (getf g :target-presentation)))
                   (fail :not-settled))))
          (case (getf status :backend)
            (:x11 (unless (= 1 desired-scale) (fail :x11-scale)))
            (:wayland
             (unless (and (getf g :configured-p) (member :frame-pending-p g)
                          (not (getf g :frame-pending-p)) (eql desired-scale (getf g :buffer-scale))
                          (eql w (getf g :committed-width)) (eql h (getf g :committed-height))
                          (eql (* desired-scale w) (getf g :committed-buffer-width))
                          (eql (* desired-scale h) (getf g :committed-buffer-height))
                          (eql (* desired-scale w) (getf g :buffer-width))
                          (eql (* desired-scale h) (getf g :buffer-height))) (fail :wayland-buffer))
             ;; After the closing sync, ordinary frames carry NIL request tokens.
             (unless (and (typep (getf g :commit-generation) '(integer 0))
                          (eql (getf g :commit-generation) (getf g :frame-generation))
                          (eql (getf g :committed-request-id) (getf g :frame-request-id))
                          (eql (getf g :committed-epoch) (getf g :frame-epoch))
                          (if (getf g :committed-request-id)
                              (and (eql id (getf g :committed-request-id))
                                   (eql (getf g :epoch) (getf g :committed-epoch)))
                              (null (getf g :committed-epoch)))) (fail :wayland-request)))
            (otherwise (fail :backend)))
          (values t nil)))
    (error () (values nil :malformed-status))))

(defun same-geometry-attempt-p (a b)
  "Correlate stable dimensions and attempt identity, excluding progress counters."
  (and (every (lambda (key) (equal (getf a key) (getf b key)))
              '(:backend :engine-geometry-generation :columns :rows :pty-columns :pty-rows))
       (let ((ga (getf a :geometry)) (gb (getf b :geometry)))
         (every (lambda (key) (equal (getf ga key) (getf gb key)))
                '(:request-id :epoch :display-epoch :metric-generation :phase
                  :cell-width :cell-height :actual-width :actual-height :columns :rows
                  :requested-columns :requested-rows :requested-width :requested-height
                  :target-presentation :buffer-scale)))))

(defun fresh-geometry-frame-p (before after scale)
  (and (geometry-capture-ready-p before scale) (geometry-capture-ready-p after scale)
       (same-geometry-attempt-p before after)
       (> (getf after :frames) (getf before :frames))
       (>= (getf (getf after :geometry) :presentation) (getf (getf before :geometry) :presentation))
       ;; Presentation counts geometry settlements, not ordinary redraws.
       (or (eq :x11 (getf after :backend))
           (let ((a (getf after :geometry)) (b (getf before :geometry)))
             (and (> (getf a :commit-generation) (getf b :commit-generation))
                  (> (getf a :frame-generation) (getf b :frame-generation)))))))

(defun geometry-progress-p (before after)
  (and (>= (getf after :frames) (getf before :frames))
       (>= (getf (getf after :geometry) :presentation) (getf (getf before :geometry) :presentation))
       (or (eq :x11 (getf after :backend))
           (every (lambda (key) (>= (getf (getf after :geometry) key) (getf (getf before :geometry) key)))
                  '(:commit-generation :frame-generation)))))

(defun capture-proof-p (status final barrier external png)
  "Independently check the v3 status, fresh-frame and external size evidence."
  (handler-case
      (let* ((scale (getf barrier :desired-scale)) (before (getf barrier :before-status))
             (ready (getf barrier :status)) (target (getf barrier :target-output))
             (g (getf status :geometry)) (w (getf g :actual-width)) (h (getf g :actual-height)))
        (and (eql 3 (getf barrier :recorder-version)) (eql 3 (getf external :recorder-version))
             (eql (getf barrier :before-frame) (getf before :frames))
             (typep target '(integer 0)) (fresh-geometry-frame-p before ready scale)
             (every (lambda (s)
                      (and (geometry-capture-ready-p s scale) (same-geometry-attempt-p ready s)
                           (geometry-progress-p ready s)
                           (eql 0 (getf s :input-pending))
                           (= (getf s :bytes-received) target)
                           (= (getf s :bytes-received) (getf ready :bytes-received))))
                    (list status final))
             (geometry-progress-p status final)
             (= (getf before :bytes-received) target)
             (or (eq :x11 (getf ready :backend)) (>= (getf barrier :native-ack-output) target))
             (eql scale (getf external :scale))
             (eql w (getf external :logical-width)) (eql h (getf external :logical-height))
             (<= (* 132 (getf g :cell-width)) (getf external :output-width))
             (every (lambda (key) (integerp (getf external key))) '(:x :y :output-x :output-y))
             (>= (getf external :x) (getf external :output-x))
             (>= (getf external :y) (getf external :output-y))
             (<= (+ (getf external :x) w) (+ (getf external :output-x) (getf external :output-width)))
             (<= (+ (getf external :y) h) (+ (getf external :output-y) (getf external :output-height)))
             (equal png (list (* scale w) (* scale h)))
             (equal png (list (getf external :pixel-width) (getf external :pixel-height)))))
    (error () nil)))

(defun capture-errors (label output events dir desired-scale)
  (let ((errors nil) (pauses nil))
    (flet ((bad (control &rest args) (push (apply #'format nil control args) errors)))
      (dolist (e events)
        (when (eq (getf e :kind) :capture)
          (let* ((name (getf e :name)) (phase (getf e :phase))
                 (safe (and (stringp name) (every (lambda (c) (or (find c "-_0123456789") (and (char>= c #\a) (char<= c #\z)))) name))))
            (if (not safe) (bad "Unsafe/missing capture name")
                (let* ((s (read-value (merge-pathnames (cat name ".status.sexp") dir)))
                       (barrier (read-value (merge-pathnames (cat name ".barrier.sexp") dir)))
                       (target (getf barrier :target-output))
                       (cols (and (integerp target) (<= 0 target (length output)) (requested-columns output target))))
                  (unless (and cols (eql cols (getf s :columns))
                               (eql target (getf e :out))
                               (equal barrier (getf e :barrier))
                               (eql desired-scale (getf barrier :desired-scale))
                               (capture-proof-p s
                                 (read-value (merge-pathnames (cat name ".final-status.sexp") dir))
                                 barrier (read-value (merge-pathnames (cat name ".external.sexp") dir))
                                 (png-size (merge-pathnames (cat name ".png") dir))))
                    (bad "Wrong capture geometry/barrier/grid at ~a" name))
                  (when (and (stringp phase) (uiop:string-prefix-p "pause-" phase))
                    (let* ((n (parse-integer phase :start 6 :junk-allowed nil))
                           (anchor (pause-anchor label n))
                           (grid (uiop:read-file-string (merge-pathnames (cat name ".grid.txt") dir))))
                      (push n pauses)
                      (unless (and anchor (search anchor grid)) (bad "Wrong pause caption ~a" name)))))))))
      (unless (equal (sort pauses #'<) (loop for n from 1 to (third (case-spec label)) collect n))
        (bad "Wrong per-pause capture phase inventory"))
      (nreverse errors))))

(defun capture-name-owned-p (name label)
  "Recognize a capture basename without its extension, owned by LABEL."
  (when (and (stringp name) (stringp label))
    (let* ((hyphen (position #\- name))
           (label-start (and hyphen (1+ hyphen)))
           (label-end (and label-start (+ label-start (length label)))))
      (and hyphen (plusp hyphen)
           (every (lambda (c) (digit-char-p c 10)) (subseq name 0 hyphen))
           (< label-end (1- (length name)))
           (string= label name :start2 label-start :end2 label-end)
           (char= #\- (char name label-end))))))

(defun owned-capture-names (label physical-names)
  (remove-if-not (lambda (name) (capture-name-owned-p name label)) physical-names))

(defun capture-inventory-p (label physical-names event-names)
  "Require distinct event names and exactly the physical captures owned by LABEL."
  (let ((owned (owned-capture-names label physical-names)))
    (and (every (lambda (name) (capture-name-owned-p name label)) event-names)
         (= (length event-names) (length (remove-duplicates event-names :test #'equal)))
         (= (length owned) (length event-names))
         (null (set-exclusive-or owned event-names :test #'equal)))))

(defun check-directory (directory &key (mode :measure))
  (unless (uiop:directory-exists-p directory) (error "Missing artifact directory ~a" directory))
  (let* ((dir (uiop:ensure-directory-pathname directory))
         (manifest (read-value (merge-pathnames "inventory.sexp" dir)))
         (expected (getf manifest :expected))
         (results (sort (directory (merge-pathnames "*.result.sexp" dir)) #'string< :key #'namestring))
         (physical-names (mapcar #'pathname-name (directory (merge-pathnames "*.png" dir))))
         (errors nil) (cases nil))
    ;; Read labels independently of file counts: duplicate evidence cannot stand
    ;; in for a different expected case.
    (when (eq mode :accept)
      (let ((labels (mapcar (lambda (p) (getf (read-value p) :label)) results)))
        (unless (and (= (length labels) (length (remove-duplicates labels :test #'equal)))
                     (= (length labels) (length expected))
                     (every (lambda (label) (member label labels :test #'equal)) expected))
          (push "Result labels must cover expected cases exactly once" errors))))
    (flet ((bad (control &rest args) (push (apply #'format nil control args) errors)))
      (when (eq mode :accept)
        (unless (and expected (eql 3 (getf manifest :recorder-version))) (bad "Missing/nonempty v3 expected inventory"))
        (unless (and (every #'case-spec expected) (= (length expected) (length (remove-duplicates expected :test #'equal))))
          (bad "Unknown or duplicated expected case"))
        (unless (equal expected (getf manifest :attempted)) (bad "Expected/attempted inventory mismatch"))
        (unless (equal expected (getf manifest :completed)) (bad "Expected/completed inventory mismatch"))
        (unless (and (eql 3 (getf (read-value (merge-pathnames "finished.sexp" dir)) :recorder-version))
                     (= (length expected) (length results))) (bad "Missing finish or case result inventory"))
        (when (directory (merge-pathnames "*.failure.sexp" dir)) (bad "Recorded case failure")))
      (dolist (p results)
        (let* ((r (read-value p)) (label (getf r :label))
               (output (wire (merge-pathnames (cat label ".transcript.raw") dir)))
               (input (wire (merge-pathnames (cat label ".input.raw") dir)))
               (events (read-values (merge-pathnames (cat label ".events.sexp") dir)))
               (exit (read-value (merge-pathnames (cat label ".exit") dir)))
               (issues (when events (check-events label output input events))))
          (when (eq mode :accept)
            (unless (member label expected :test #'equal) (bad "Unexpected case ~a" label))
            (unless (equal (file-namestring p) (cat label ".result.sexp"))
              (bad "Result filename/label mismatch: ~a / ~s" (file-namestring p) label))
            (unless (and (case-spec label) (equal (getf r :path) (second (case-spec label)))
                         (eql (getf r :pauses) (third (case-spec label)))
                         (eql (getf r :expected-captures) (expected-captures label)))
              (bad "Wrong source-defined case/capture contract ~a" label))
            (dolist (issue (phase-inventory-errors label events)) (bad "~a: ~a" label issue))
            (dolist (issue (handler-case (capture-errors label output events dir (getf manifest :desired-scale))
                             (error (c) (list (format nil "Malformed capture evidence: ~a" c)))))
              (bad "~a: ~a" label issue))
            (unless (case-complete-p r exit) (bad "Incomplete/error/nonzeroexit case ~a" label))
            (let* ((captures (remove-if-not (lambda (e) (eq :capture (getf e :kind))) events))
                   (wanted (getf r :expected-captures)))
              (unless (and (typep wanted '(integer 1)) (= wanted (or (getf r :captures) -1) (length captures))
                           (capture-inventory-p label physical-names
                                                (mapcar (lambda (e) (getf e :name)) captures)))
                (bad "~a: capture inventory mismatch" label))
              (dolist (e captures)
                (let ((name (getf e :name)))
                  (dolist (suffix '(".png" ".grid.txt" ".status.sexp" ".final-status.sexp" ".barrier.sexp" ".external.sexp" ".dimensions.txt"))
                    (let ((p (merge-pathnames (cat name suffix) dir)))
                      (unless (and (probe-file p) (with-open-file (s p :element-type '(unsigned-byte 8)) (plusp (file-length s))))
                        (bad "Missing/empty capture component ~a" p)))))))
            (unless events (bad "~a: legacy evidence lacks exact phase events" label))
            (dolist (issue issues) (bad "~a: ~a" label issue)))
          (push (list :label label :exit exit :returned-to-menu (getf r :returned-to-menu)
                      :events (length events) :issues issues :queries (query-specs label output)) cases)))
      (list :recorder-version (getf manifest :recorder-version) :mode mode :pass (null errors) :errors (nreverse errors)
            :reports (report-measurement dir)
            :keyboard (loop for label in '("keyboard-cursor" "keyboard-keypad")
                            for text = (wire (merge-pathnames (cat label ".input.raw") dir))
                            collect (list :label label :input text
                                          :normal-arrow-up-present (not (null (search (esc "[A") text)))
                                          :ss3-up-count (nocc (esc "OA") text)
                                          :vt52-up-expected-escape-a-present (not (null (search (esc "A") text)))
                                          :keypad-application-ss3-or-vt52-prefix-present
                                          (not (null (or (search (esc "Oq") text) (search (esc "?q") text))))))
            :cases (nreverse cases)))))
(defun main ()
  (handler-case
      (let* ((args (uiop:command-line-arguments))
             (mode (if (equal (first args) "accept") :accept :measure))
             (dirs (rest args)))
        (unless (and dirs (member (first args) '("accept" "measure") :test #'equal))
          (error "Usage: vttest-check measure|accept ARTIFACT-DIR..."))
        (let ((results (mapcar (lambda (dir) (check-directory dir :mode mode)) dirs)))
          (let ((*print-pretty* t)) (write results) (terpri))
          (uiop:quit (if (every (lambda (r) (getf r :pass)) results) 0 1))))
    (error (c) (format *error-output* "vttest-check: ~a~%" c) (uiop:quit 1))))
(when (member "--vttest-check" sb-ext:*posix-argv* :test #'equal)
  ;; The marker is stripped here, not accepted as an artifact path.
  (setf sb-ext:*posix-argv* (remove "--vttest-check" sb-ext:*posix-argv* :test #'equal))
  (main))
