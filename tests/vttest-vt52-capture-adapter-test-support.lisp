;;;; Synthetic adapter boundary support. No real PNG decoder or application load.
(load (merge-pathnames "vttest-vt52-capture-adapter.lisp" *load-truename*))
(load (merge-pathnames "vttest-vt52-admission-tests.lisp" *load-truename*))
(defpackage #:vttest-vt52-capture-adapter-tests
  (:use #:cl)
  (:local-nicknames (#:a #:vttest-vt52-capture-adapter)
    (#:f #:vttest-vt52-admission-tests) (#:h #:vttest-vt52-sha256)
    (#:p #:vttest-vt52-png-adapter))
  (:export #:run-tests))
(in-package #:vttest-vt52-capture-adapter-tests)
(defvar *root*)
(defvar *serial* 0)
(defvar *writes* 0)
(defvar *checks* 0)
(defvar *calls* 0)
(defvar *action* nil)
(defvar *images*)
(defparameter *png-bytes* (make-array 4 :element-type '(unsigned-byte 8)
                                   :initial-contents '(137 80 78 71)))
(defun bytes (s) (sb-ext:string-to-octets s :external-format :utf-8))
(defun read-bytes (path)
  (with-open-file (s path :element-type '(unsigned-byte 8))
    (let ((v (make-array (file-length s) :element-type '(unsigned-byte 8))))
      (assert (= (length v) (read-sequence v s)))
      (assert (null (read-byte s nil nil))) v)))
(defun absent (path)
  (handler-case (progn (sb-posix:lstat path) (error "Already exists: ~a" path))
    (sb-posix:syscall-error (c)
      (unless (= sb-posix:enoent (sb-posix:syscall-errno c)) (error c)))))
(defun measured (path data)
  (assert (and (typep data '(vector (unsigned-byte 8))) (<= (length data) 8192)))
  (format t "PREWRITE ~a ~d ~a~%" path (length data) (h:sha256-hex data))
  (finish-output) data)
(defun write-new (path data)
  (measured path data) (absent path)
  (with-open-file (s path :direction :output :element-type '(unsigned-byte 8)
                         :if-exists nil :if-does-not-exist :create)
    (assert s) (write-sequence data s))
  (assert (equalp data (read-bytes path))) (incf *writes*) path)
(defun new-directory (path)
  (absent path) (sb-posix:mkdir path #o700) (uiop:ensure-directory-pathname path))
(defun file-path (dir suffix)
  (merge-pathnames (concatenate 'string "pause-02-" suffix) dir))
(defun fixture-directory (raw &key omit)
  (let ((dir (new-directory (merge-pathnames (format nil "case-~d/" (incf *serial*)) *root*))))
    (loop for (key suffix) on a::*inputs* by #'cddr
          unless (eq key omit) do (write-new (file-path dir suffix) (getf raw key)))
    (write-new (file-path dir "actual.png") *png-bytes*) dir))
(defun summary (v) (list :bytes (length v) :sha256 (h:sha256-hex v)))
(defun controlled-record (form)
  ;; Same controlled bindings as WRITE-RECEIPT-VALUE, without loading recorder.
  (bytes (with-output-to-string (s)
    (with-standard-io-syntax
      (let ((*print-readably* nil) (*print-escape* t) (*print-base* 10)
            (*print-pretty* nil) (*print-length* nil) (*print-level* nil))
        (write form :stream s) (terpri s))))))
(defun parsed (v)
  (let ((*read-eval* nil))
    (read-from-string (sb-ext:octets-to-string v :external-format :utf-8))))
(defun reserialize (raw)
  (dolist (key '(:before :ready :request-sexp :native-ready :pre :final :native))
    (setf (getf raw key) (controlled-record (parsed (getf raw key)))))
  (let ((trace (parsed (getf raw :control))))
    (loop for file in '(:pre :pre :request :request-sexp :native-ready :native :final :final)
          for i in '(0 1 2 2 2 3 4 5)
          for k in '(:sha256 :linked-sha256 :request-sha256 :request-sexp-sha256
                     :native-ready-sha256 :native-sha256 :sha256 :linked-sha256)
          do (setf (getf (nth i trace) k) (h:sha256-hex (getf raw file))))
    (setf (getf raw :control) (controlled-record trace))) raw)
(defun fake-decode (path &key scale decoder-argv)
  (incf *calls*)
  (assert (equal decoder-argv (list a::*decoder*)))
  (assert (equalp (read-bytes path) *png-bytes*))
  (let* ((sha (h:sha256-hex *png-bytes*))
         (image (aref *images* (1- scale)))
         (out (bytes "decoded")) (err (bytes "diagnostic"))
         (name (namestring (truename path))))
    (when (eq *action* :refuse)
      (error 'p:png-refusal :reason :synthetic-decoder-failed
             :evidence (list :stdout out :stderr err :exit 7)))
    (when (eq *action* :mutate)
      (let* ((before (merge-pathnames "pause-02-before.sexp" path))
             (old (read-bytes before))
             (new (concatenate '(vector (unsigned-byte 8)) old (bytes (string #\Newline)))))
        ;; Fixture-only byte/hash guard, complete premeasurement, then readback.
        (measured before new)
        (assert (equalp old (read-bytes before)))
        (with-open-file (s before :direction :output :element-type '(unsigned-byte 8)
                                 :if-exists :overwrite :if-does-not-exist :error)
          (write-sequence new s))
        (assert (equalp new (read-bytes before))) (incf *writes*)))
    (when (eq *action* :bad-pixel)
      (setf image (copy-seq image) (aref image 0) (logxor 255 (aref image 0))))
    (append (list :sha256-before sha :sha256-after sha :width (* 640 scale)
      :height (* 384 scale) :rgba image
      :identify (list :argv (list a::*decoder* "identify" "-format" "%w %h" name)
        :stdout (bytes (format nil "~d ~d" (* 640 scale) (* 384 scale)))
        :stderr (bytes "") :exit 0))
      (list :argv (list a::*decoder* name "-depth" "8" "rgba:synthetic")
            :stdout out :stderr err :exit 0))))
(defun check (name ok)
  (incf *checks*) (unless ok (error "FAILED ~s" name)))
(defun report-for (raw &key (scale 1) omit)
  (let ((dir (fixture-directory raw :omit omit)))
    (a:check-vt52-capture-directory dir :pause 2 :scale scale)))
(defun refused (r) (and (eq :refuse (getf r :verdict)) (consp (getf r :reasons))))
