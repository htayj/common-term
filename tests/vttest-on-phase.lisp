;;;; Optional static ON-phase evidence. Loaded only in the disposable recorder.
;;;; wp_presentation v1 is used for realized Wayland presentation, not wl_surface.frame.
(defpackage #:vttest-on-phase
  (:use #:cl)
  (:export #:eligible-p #:validate-attempt #:install #:capture #:*attempts*))
(in-package #:vttest-on-phase)

(defparameter *attempts* nil)
(defvar *root*)
(defvar *write*)
(defvar *output*)
(defvar *check*)
(defvar *scale*)
(defvar *session* nil)
(defvar *display* nil)
(defvar *submission* nil)
(defparameter *lock* (sb-thread:make-mutex :name "on-phase evidence"))
(defparameter *sequence* 0)
(defparameter *images* (make-hash-table :test #'eq))
(defparameter *submitted* (make-hash-table :test #'eq))
(defparameter *acknowledged* (make-hash-table :test #'eq))
(defparameter *presentations* (make-hash-table :test #'eq))
(defparameter *sessions* (make-hash-table :test #'eq))
(defparameter *session-number* 0)

(defun eligible-p (backend label suffix)
  (or (and (member backend '(:x11 :wayland)) (string= label "screen")
           (string= suffix "pause14"))
      (and (eq backend :x11) (string= label "bug-d") (string= suffix "choice0"))))

(defun monotonic ()
  (/ (get-internal-real-time) internal-time-units-per-second))
(defun uptime ()
  ;; Linux uptime is monotonic (including suspend), printed to 10ms precision.
  ;; It brackets the shell acquisition; it is never compared to Lisp's epoch.
  (with-open-file (in "/proc/uptime")
    (let* ((text (read-line in)) (point (position #\. text))
           (end (position #\Space text)))
      (/ (parse-integer (remove #\. (subseq text 0 end)))
         (expt 10 (- end point 1))))))
(defun save-value (name value)
  (funcall *write* (merge-pathnames name *root*) value))
(defun trace-value (value)
  (sb-thread:with-mutex (*lock*)
    (with-open-file (out (merge-pathnames "presentation-events.sexp" *root*)
                         :direction :output :if-exists :append :if-does-not-exist :create)
      (let ((*print-pretty* nil)) (write value :stream out) (terpri out)))))
(defun pin-session (session)
  (sb-thread:with-mutex (*lock*)
    (or (gethash session *sessions*)
        (setf (gethash session *sessions*) (incf *session-number*)))))
(defun note-submission (display token)
  (sb-thread:with-mutex (*lock*) (setf (gethash display *submitted*) token))
  (trace-value (list :kind :submitted :time (monotonic) :token token)))
(defun note-ack (display token kind &rest properties)
  (let ((ack (append (list :token token :kind kind :time (monotonic)) properties)))
    (sb-thread:with-mutex (*lock*) (setf (gethash display *acknowledged*) ack))
    (trace-value (list :kind :acknowledged :ack ack))))

(defun pty-identity (session)
  (let ((pty (lispterm::session-pty session)))
    (when pty (list :master-fd (lispterm.pty:pty-master-fd pty)
                   :slave (lispterm.pty:pty-slave-name pty)))))
(defun snapshot (host)
  ;; Status locks are released before taking our lock. A racing renderer causes
  ;; token/status disagreement, which the predicate rejects rather than repairs.
  (let* ((status (lispterm:status host))
         (session (lispterm::host-session host))
         (display (lispterm::host-display host)))
    (sb-thread:with-mutex (*lock*)
      (list :time (monotonic) :uptime (uptime) :status status
            :pty (pty-identity session)
            :session (gethash session *sessions*) :output (funcall *output*)
            :submitted (copy-tree (gethash display *submitted*))
            :ack (copy-tree (gethash display *acknowledged*))))))

(defun same-geometry-p (a b)
  ;; Commit/frame counters are intentionally excluded from geometry identity.
  (every (lambda (key) (equal (getf a key) (getf b key)))
         '(:request-id :display-epoch :epoch :metric-generation :phase
           :actual-width :actual-height :cell-width :cell-height :window-id
           :configure-serial :configure-generation :buffer-generation :buffer-scale)))
(defun same-target-p (a b)
  (let ((x (getf a :status)) (y (getf b :status)))
    (and (equal (getf a :session) (getf b :session))
         (equal (getf a :pty) (getf b :pty))
         (every (lambda (key) (equal (getf x key) (getf y key)))
                '(:id :backend :child-pid :rows :columns :pty-rows :pty-columns
                  :engine-geometry-generation :bytes-received))
         (same-geometry-p (getf x :geometry) (getf y :geometry))
         (= (getf a :output -1) (getf b :output -2)))))
(defun associated-p (sample phase)
  (let* ((s (getf sample :status)) (token (getf sample :submitted))
         (ack (getf sample :ack)) (backend (getf s :backend)))
    (and token ack (getf sample :session) (getf s :child-pid)
         (getf sample :pty) (equal (getf sample :pty) (getf token :pty))
         (eql (getf s :blink-phase) phase) (getf s :blink-visible)
         (eql (getf token :phase) phase)
         (equal token (getf ack :token))
         (= (getf token :frame -1) (getf s :frames -2))
         (= (getf token :session -1) (getf sample :session -2))
         (= (getf token :output -1) (getf sample :output -2)
            (getf token :bytes -3) (getf s :bytes-received -4))
         (= (getf token :width -1) (getf (getf s :geometry) :actual-width -2))
         (= (getf token :height -1) (getf (getf s :geometry) :actual-height -2))
         (eql 0 (getf s :input-pending))
         (eq :settled (getf (getf s :geometry) :phase))
         (eq :running (getf s :process-state))
         (<= (getf token :time) (getf ack :time) (getf sample :time))
         (case backend
           (:x11 (and (eq (getf ack :kind) :x11-ordered-get-geometry)
                      (= (getf ack :width -1) (getf (getf s :geometry) :actual-width -2))
                      (= (getf ack :height -1) (getf (getf s :geometry) :actual-height -2))))
           (:wayland (and (eq (getf ack :kind) :wp-presentation-presented)
                          (integerp (getf ack :clock-id))
                          (eql (getf token :buffer-scale) *scale*)
                          (eql (getf (getf s :geometry) :buffer-scale) *scale*)
                          (= 1 (length (getf token :outputs)))
                          (getf ack :outputs)
                          (every (lambda (id) (member id (getf token :outputs)))
                                 (getf ack :outputs))))))))

(defun %validate-attempt (packet)
  "Return acceptance and a precise rejection reason. This never judges pixels."
  (let* ((off (getf packet :off)) (pre (getf packet :pre)) (post (getf packet :post))
         (external (getf packet :external)) (request (getf packet :request))
         (ack (getf packet :ack)) (s (getf pre :status)))
    (cond
      ((getf packet :error) (values nil :acquisition-error))
      ((not (and off pre post external request ack)) (values nil :partial-packet))
      ((not (and (same-target-p off pre) (same-target-p pre post)))
       (values nil :target-output-or-geometry-changed))
      ((not (and (associated-p off nil) (associated-p pre t) (associated-p post t)))
       (values nil :missing-phase-specific-presentation))
      ((not (and (< (getf (getf off :submitted) :frame) (getf s :frames))
                 (< (getf off :time) (getf pre :time))
                 (<= (- (getf pre :time) (getf off :time)) 10)))
       (values nil :no-natural-off-to-on))
      ((not (and (<= (getf pre :time) (getf request :time)
                     (getf ack :time) (getf post :time))
                 (<= (getf request :uptime) (getf external :start)
                     (getf external :end) (getf ack :uptime))
                 (<= (- (getf external :end) (getf external :start)) 10)
                 (<= (- (getf ack :time) (getf request :time)) 10)))
       (values nil :acquisition-interval-invalid))
      ((not (and (eql 0 (getf external :exit))
                 (getf external :png) (getf external :identity-stable)
                 (eql (getf external :client) (sb-posix:getpid))
                 (getf external :window) (getf external :output)
                 (eql (getf external :scale) *scale*)
                 (= (getf external :width) (getf (getf s :geometry) :actual-width))
                 (= (getf external :height) (getf (getf s :geometry) :actual-height))
                 (= (getf external :pixel-width -1) (* *scale* (getf external :width)))
                 (= (getf external :pixel-height -1) (* *scale* (getf external :height)))
                 (or (eq :wayland (getf s :backend))
                     (= (getf external :window) (getf (getf pre :submitted) :window)))))
       (values nil :external-identity-or-image-invalid))
      ;; Check hard acquisition/identity failures before the only retryable race.
      ((not (equal (getf pre :submitted) (getf post :submitted)))
       (values nil :frame-changed-during-exposure))
      (t (values t :associated-static-on-phase)))))

(defun validate-attempt (packet)
  (handler-case (%validate-attempt packet)
    (error () (values nil :malformed-packet))))

(defun install (root write output check scale)
  "Install disposable-process wrappers. No renderer clock argument is supplied."
  (setf *root* root *write* write *output* output *check* check *scale* scale)
  ;; All wraps preserve original argument lists/return values. PRESENT is called
  ;; under the render session lock; the token describes the actual CPU image.
  (let ((render (symbol-function 'lispterm::render-session))
        (present (symbol-function 'lispterm.display:present))
        (flush (symbol-function 'lispterm.display.wayland::flush-window))
        (protocol-present (symbol-function 'lispterm.display.wayland::protocol-present))
        (bind (symbol-function 'lispterm.display.wayland::bind-global))
        (send (symbol-function 'lispterm.display.wayland::wire-send)))
    (setf (symbol-function 'lispterm::render-session)
          (lambda (session display &rest keys)
            (let ((*session* session)) (apply render session display keys)))
          (symbol-function 'lispterm.display:present)
          (lambda (display)
            (if (null *session*) (funcall present display)
                (let* ((state (lispterm.display:display-backend-state display))
                       (backend (lispterm.display:display-backend display))
                       (token (list :sequence (incf *sequence*) :time (monotonic)
                                    :session (pin-session *session*)
                                    :pty (pty-identity *session*)
                                    :frame (1+ (lispterm::session-frames *session*))
                                    :phase (lispterm.display::display-blink-phase display)
                                    :output (funcall *output*)
                                    :bytes (lispterm::session-bytes-received *session*)
                                    :width (lispterm.display:display-width display)
                                    :height (lispterm.display:display-height display)
                                    :window (when (eq backend :x11)
                                              (lispterm.display.x11::x-state-window state)))))
                  (setf (gethash display *images*) token)
                  (prog1 (funcall present display)
                    (when (eq backend :x11)
                      (note-submission display token)
                      (let ((client (lispterm.display.x11::x-state-client state)))
                        ;; Same-connection reply is ordered after every PutImage.
                        ;; This is server processing evidence, not physical scanout.
                        (xclhb:get-geometry client
                          (lambda (reply)
                            (note-ack display token :x11-ordered-get-geometry
                                      :width (xclhb:get-geometry-reply-width reply)
                                      :height (xclhb:get-geometry-reply-height reply)))
                          (getf token :window))
                        (xclhb:flush client)))))))
          (symbol-function 'lispterm.display.wayland::flush-window)
          (lambda (display window)
            (let ((*display* display)) (funcall flush display window)))
          (symbol-function 'lispterm.display.wayland::protocol-present)
          (lambda (state pixels width height)
            (let ((*submission* (and *display* (copy-list (gethash *display* *images*)))))
              (when *submission*
                (setf (getf *submission* :surface)
                      (lispterm.display.wayland::wayland-state-surface state)
                      (getf *submission* :commit-before)
                      (lispterm.display.wayland::wayland-state-commit-generation state)
                      (getf *submission* :buffer-scale)
                      (lispterm.display.wayland::wayland-state-scale state)
                      (getf *submission* :outputs)
                      (copy-list (lispterm.display.wayland::wayland-state-entered-outputs state))))
              (prog1 (funcall protocol-present state pixels width height)
                ;; Successful commits are recorded by the wire wrapper, never by
                ;; a session frame count or an output-only callback.
                )))
          (symbol-function 'lispterm.display.wayland::bind-global)
          (lambda (state name interface version)
            (if (not (string= interface "wp_presentation"))
                (funcall bind state name interface version)
                (let* ((wire (lispterm.display.wayland::wayland-state-wire state))
                       (info (list :clock-id nil)))
                  (setf (getf info :id)
                        (lispterm.display.wayland::registry-bind state name interface 1
                          (lambda (id opcode payload)
                            (declare (ignore id))
                            (unless (and (= opcode 0) (= (length payload) 4))
                              (error "Invalid wp_presentation.clock_id"))
                            (setf (getf info :clock-id)
                                  (lispterm.display.wayland::bytes-u32 payload 0)))))
                  (setf (gethash wire *presentations*) info))))
          (symbol-function 'lispterm.display.wayland::wire-send)
          (lambda (wire object opcode &rest args)
            (block install-wire-send
            (when (and *submission* (= object (getf *submission* :surface)) (= opcode 6))
              (let ((info (gethash wire *presentations*))
                    (token *submission*) (display *display*) (outputs nil))
                (when info
                  (let ((feedback
                          (lispterm.display.wayland::wire-id wire :presentation-feedback
                            (lambda (id event payload)
                              (case event
                                (0 (unless (= (length payload) 4) (error "Invalid sync_output"))
                                   (push (lispterm.display.wayland::bytes-u32 payload 0) outputs))
                                (1 (unless (and (= (length payload) 28)
                                                (< (lispterm.display.wayland::bytes-u32 payload 8) 1000000000))
                                     (error "Invalid presented event"))
                                   (remhash id (lispterm.display.wayland::wire-handlers wire))
                                   (note-ack display token :wp-presentation-presented
                                             :clock-id (getf info :clock-id) :outputs outputs
                                             :feedback id :payload (coerce payload 'list)))
                                (2 (remhash id (lispterm.display.wayland::wire-handlers wire))
                                   (trace-value (list :kind :discarded :token token :feedback id)))
                                (otherwise (error "Invalid presentation feedback opcode")))))))
                    ;; feedback targets precisely the next surface commit.
                    (funcall send wire (getf info :id) 1 object feedback)))
                (apply send wire object opcode args)
                (note-submission display token)
                (return-from install-wire-send nil)))
            (apply send wire object opcode args))))))

(defun wait-transition (host end)
  (let ((off nil) (initial nil))
    (loop for sample = (snapshot host)
          do (trace-value (list :kind :transition-sample :sample sample))
             (funcall *check* host)
             (unless initial (setf initial sample))
             (unless (same-target-p initial sample)
               (error "On-phase target/output/geometry changed"))
             (when (associated-p sample nil) (unless off (setf off sample)))
          when (and off (associated-p sample t)
                    (> (getf (getf sample :status) :frames)
                       (getf (getf off :status) :frames)))
            return (values off sample sample)
          when (>= (monotonic) end) return (values off nil sample)
          do (sleep .005))))

(defun capture (host label suffix)
  "Retain at most six attempts, each awaiting a real OFF->ON transition.
A selected attempt is ASSOCIATED, not visual PASS. Inspect all retained PNGs."
  (let* ((subject (format nil "~(~a~)-~a-~a" (getf (lispterm:status host) :backend) label suffix))
         (limit (+ (monotonic) 120)) (selected nil) (stop nil))
    (dotimes (index 6)
      (when (or selected stop (>= (monotonic) limit)) (return))
      (let* ((name (format nil "~a-attempt~2,'0d" subject (1+ index)))
             (packet (list :subject subject :attempt (1+ index) :name name :start (monotonic))))
        (handler-case
            (multiple-value-bind (off pre last) (wait-transition host (min limit (+ (monotonic) 10)))
              (setf (getf packet :off) off (getf packet :pre) pre (getf packet :last-sample) last)
              (if (null pre) (setf (getf packet :error) :transition-timeout)
                  (progn
                    (let ((g (getf (getf pre :status) :geometry)))
                      (setf (getf packet :request) (list :time (monotonic) :uptime (uptime)))
                      (save-value (concatenate 'string name ".pending.sexp") packet)
                      (with-open-file (out (merge-pathnames "request-tmp" *root*)
                                           :direction :output :if-exists :error)
                        (format out "~a ~d ~d ~d~%" name (getf g :actual-width)
                                (getf g :actual-height) *scale*))
                      (rename-file (merge-pathnames "request-tmp" *root*)
                                   (merge-pathnames "capture-request" *root*)))
                    (loop with end = (min limit (+ (monotonic) 10))
                          until (probe-file (merge-pathnames (concatenate 'string name ".ack") *root*))
                          when (>= (monotonic) end) do (error "External screenshot timeout")
                          do (sleep .005))
                    (setf (getf packet :ack) (list :time (monotonic) :uptime (uptime))
                          (getf packet :post) (snapshot host))
                    (with-open-file (in (merge-pathnames (concatenate 'string name ".external.sexp") *root*))
                      (let ((*read-eval* nil)) (setf (getf packet :external) (read in)))))))
          (error (condition)
            ;; Stop on ownership/geometry/unknown failures, and leave all partial
            ;; files/request markers for diagnosis. Only phase races may retry.
            (setf (getf packet :error) (princ-to-string condition) stop t)))
        (multiple-value-bind (ok reason) (validate-attempt packet)
          (setf (getf packet :selected) ok (getf packet :reason) reason)
          (when ok (setf selected name))
          ;; Only a completed, otherwise valid exposure with a changed frame
          ;; may retry. Missing presentation, malformed data and unknown reasons stop.
          (unless (or ok (eq reason :frame-changed-during-exposure))
            (setf stop t)))
        (save-value (concatenate 'string name ".attempt.sexp") packet)
        (push packet *attempts*)
        (save-value "inventory.sexp"
                    (list :scope :static-native-on-phase-only :attempts (reverse *attempts*)))
        (when (getf packet :error) (setf stop t))))
    (save-value (concatenate 'string subject ".result.sexp")
                (list :subject subject :selected selected
                      :disposition (if selected :associated :unverified)
                      :visual-review :required :natural-timing-conformance :not-claimed
                      :end (monotonic)))
    selected))
