;;;; Deterministic recorder-only controls. No bootstrap, product or native session.
(require :sb-posix)
(in-package :cl-user)
(defparameter *source* (or (sb-ext:posix-getenv "RECORDER_SOURCE")
                          "tests/vttest-screen-recorder.lisp"))
(defparameter *artifacts* (pathname (sb-ext:posix-getenv "RECORDER_TEST_ROOT")))
(defparameter *checks* 0)
(defun check (name value)
  (unless value (error "Render-quiescence control failed: ~s" name))
  (incf *checks*))
;; Reader scaffolding only. Admit named recorder definitions, never its bootstrap.
(dolist (p '("ASDF" "UIOP" "LISPTERM" "LISPTERM.ENGINE" "LISPTERM.PTY"
             "LISPTERM.DISPLAY.WAYLAND" "NERIMUX/TERMINAL" "VTTEST-SCREEN-RECORDER"
             "VTTEST-SCREEN-ORACLE" "VTTEST-SCREEN-FRAME" "VTTEST-SCREEN-BLINK-SELECTION"
             "VTTEST-SCREEN-BLINK-NATIVE" "VTTEST-SCREEN-BLINK-TIMING" "VTTEST-SCREEN-NATIVE-CONTRACT"
             "VTTEST-SCREEN-PIXELS" "VTTEST-CURSOR-DRIVER"))
  (unless (find-package p) (make-package p :use '("CL"))))
(defun constituent (c) (or (alphanumericp c) (find c "-._*+/")))
(let ((text (with-open-file (s *source*)
              (let ((v (make-string (file-length s)))) (read-sequence v s) v))))
  (loop for i from 1 below (1- (length text)) when (char= #\: (char text i)) do
    (let* ((start (loop for j downfrom (1- i) to 0 while (constituent (char text j))
                        finally (return (1+ j))))
           (p (and (< start i) (find-package (string-upcase (subseq text start i)))))
           (end (loop for j from (1+ i) below (length text) while (constituent (char text j))
                      finally (return j))))
      (when (and p (> end (1+ i))
                 (not (member (package-name p) '("SB-POSIX" "SB-EXT" "SB-THREAD") :test #'equal)))
        (let ((name (string-upcase (subseq text (1+ i) end))))
          (when (eq :inherited (nth-value 1 (find-symbol name p))) (shadow name p))
          (export (intern name p) p))))))
(defparameter *forms*
  (let ((*read-eval* nil) (*package* (find-package :cl-user)))
    (with-open-file (s *source*)
      (loop for f = (read s nil :eof) until (eq f :eof)
            when (eq (car f) 'in-package) do (setf *package* (find-package (second f)))
            when (eq (car f) 'defun) collect f))))
(defun admit (name)
  (let ((f (find name *forms* :test #'equal :key (lambda (f) (symbol-name (second f))))))
    (when f (eval f))))
(defun stub (package name function)
  (setf (symbol-function (intern name package)) function))
(in-package :vttest-screen-recorder)
(defparameter *output* 18007)
(defparameter *input* 0)
(defparameter *sequence* 0)
(defparameter *ack* 0)
(defparameter *backend* :x11)
(defparameter *scale* 1)
(defparameter *surface* nil)
(defparameter *binary* "mock")
(defparameter *presentation-witness* nil)
(defvar *wait-observer*)
(defvar *session*)
(defvar *art*)
(defvar *receipt*)
(defvar *calls*)
(defvar *extra*)
(defun tick ()
  (when (or (getf *session* :forced) (getf *session* :dirty) (getf *session* :cursor-pending) (getf *session* :geometry-pending))
    (incf (getf *session* :frames))
    (when (getf *session* :geometry-pending)
      (setf (getf *session* :geometry)
            (cl-user::geometry (getf *session* :generation))
            (getf *session* :geometry-pending) nil))
    (setf (getf *session* :forced) nil (getf *session* :dirty) nil
          (getf *session* :cursor-pending) nil)))
(defun await (host predicate)
  (declare (ignore host))
  (case (incf *calls*)
    (3 (tick) (when *extra* (incf (getf *session* :frames))) t)
    (4 (throw 'authorized :authorized))
    (otherwise (loop repeat 4 for value = (funcall predicate)
                     when value return value do (tick)
                     finally (error "Mock poll did not settle")))))
(defun checked-poll-status (status &rest args) (declare (ignore args)) status)
(defun expected-text (snapshot) (declare (ignore snapshot)) "target")
(defun grid (host) (declare (ignore host)) "target")
(defun select-capture-phase (&rest args) (declare (ignore args)) nil)
(defun cursor-matches-p (&rest args) (declare (ignore args)) t)
(defun event (&rest args) (declare (ignore args)))
(defun save (&rest args) (declare (ignore args)))
(defun observe-once (&rest args) (declare (ignore args)))
(defun publish-request (&rest args) (declare (ignore args)))
(defun publish-request-value (&rest args) (declare (ignore args)))
(defun read-value (name) (declare (ignore name)) *receipt*)
(defun predicate-details (&rest args)
  (declare (ignore args))
  (loop for k in '(:grid-match :cursor-match :settled :output-match :input-empty
                  :blink-content-match :frame-complete :blink-phase-match) append (list k t)))
(defun pause-name (n suffix) (format nil "pause-~d-~a" n suffix))
(in-package :cl-user)
(stub "LISPTERM" "HOST-SESSION" #'identity)
(stub "LISPTERM" "SESSION-LOCK" (lambda (s) (getf s :lock)))
(stub "LISPTERM" "SESSION-SCREEN" #'identity)
(stub "LISPTERM" "SESSION-FRAMES" (lambda (s) (getf s :frames)))
(stub "LISPTERM" "SESSION-FORCE-FRAME" (lambda (s) (getf s :forced)))
(stub "LISPTERM" "SESSION-LAST-CURSOR"
      (lambda (s) (if (getf s :cursor-pending) '(0 1 t) '(0 0 t))))
(stub "LISPTERM.ENGINE" "CURSOR-ROW" (constantly 0))
(stub "LISPTERM.ENGINE" "CURSOR-COLUMN" (constantly 0))
(stub "LISPTERM.ENGINE" "DIRTY-P"
      (lambda (s) (assert (sb-thread:holding-mutex-p (getf s :lock))) (getf s :dirty)))
(stub "NERIMUX/TERMINAL" "SCREEN-CURSOR-VISIBLE" (constantly t))
(defun geometry (generation)
  (list :request-id generation :phase :settled :columns 80 :rows 24
        :window-id 42 :actual-width 640 :actual-height 384))
(stub "LISPTERM" "SESSION-GEOMETRY-GENERATION" (lambda (s) (getf s :generation)))
(stub "LISPTERM" "SESSION-GEOMETRY-STATUS" (lambda (s) (getf s :geometry)))
(stub "LISPTERM" "STATUS"
      (lambda (s) (list :frames (getf s :frames) :bytes-received 18007 :input-pending 0
                       :blink-visible nil :blink-phase t
                       :engine-geometry-generation (getf s :generation)
                       :geometry (copy-tree (getf s :geometry)))))
(stub "LISPTERM" "INVALIDATE"
      (lambda (s)
        (check :geometry-drained-before-invalidate (not (getf s :geometry-pending)))
        (vttest-screen-recorder::tick)
        (incf (getf s :invalidations 0)) (setf (getf s :forced) t)))
(stub "VTTEST-SCREEN-ORACLE" "SNAPSHOT-METADATA"
      (constantly '(:cursor (:row 1 :column 1) :blink-visible nil)))
(stub "VTTEST-SCREEN-FRAME" "SETTLED-P" (constantly t))
(dolist (name '("PATH" "TOUCH" "RENDER-STATE" "AWAIT-TARGET" "CAPTURE-HOLD"))
  (admit name))
(load "tests/vttest-screen-render-quiescence-cases.lisp")
