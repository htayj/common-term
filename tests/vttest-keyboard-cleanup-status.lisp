;;;; Partial cleanup validation and classification, without process operations.
(in-package #:vttest-keyboard-driver)

(define-condition cleanup-missing (error)
  ((fields :initarg :fields :initform nil :reader cleanup-missing-fields)))
(defvar *cleanup-collecting* nil)
(defvar *cleanup-omissions* nil)
(defmacro cleanup-validating (&body body)
  `(if *cleanup-collecting* (progn ,@body)
       (let ((*cleanup-collecting* t) (*cleanup-omissions* nil))
         (prog1 (progn ,@body)
           (when *cleanup-omissions*
             (error 'cleanup-missing :fields (reverse *cleanup-omissions*)))))))
(defun cleanup-present-p (record key)
  (loop for k in record by #'cddr thereis (eq k key)))
(defun cleanup-absent (key) (pushnew key *cleanup-omissions*))
(defun cleanup-fields (value keys)
  ;; Check shape and uniqueness even when required observations are absent.
  (vttest-area::plist-keys value keys nil)
  (dolist (key keys)
    (unless (cleanup-present-p value key) (cleanup-absent key)))
  value)
(defun cleanup-value (record key predicate reason)
  (when (cleanup-present-p record key)
    (need (funcall predicate (getf record key)) reason)))

(defun classify-raw-cleanup (raw backend fail missing)
  ;; All present fields have already been type checked. Missing fields cannot
  ;; erase independent contradictions, or substitute NIL for an observed fact.
  (let ((owned (getf raw :owned)) (waits nil)
        (roles (if (equal backend "x11")
                   '(("server" t) ("client" t))
                   '(("compositor" nil) ("client" t) ("keyboard-holder" t)))))
    (when (or (eq (getf raw :state) :failed)
              (eq (getf raw :stop-owned) :survived)
              (eq (getf raw :runtime) :retained)
              (eq (getf raw :wayland-holder) :failed)
              (getf raw :identity-failures))
      (funcall fail :cleanup-failed))
    (when (getf raw :adoption-failures) (funcall missing :root-adoption-unverified))
    (unless (and (eq (getf raw :state) :stopped) (getf raw :launch-valid))
      (funcall missing :cleanup-not-stopped))
    (dolist (spec roles)
      (let ((roots (remove (first spec) owned :key (lambda (o) (getf o :role)) :test-not #'equal)))
        (cond ((null roots) (funcall missing (list :missing-root (first spec))))
              ((cdr roots) (funcall fail (list :duplicate-root (first spec))))
              ((and (cleanup-present-p (first roots) :direct)
                    (not (eq (getf (first roots) :direct) (second spec))))
               (funcall fail (list :root-directness (first spec)))))))
    (dolist (o owned)
      (let ((observed (getf o :observed)) (direct (getf o :direct))
            (wait (getf o :wait-status)))
        (when (member (getf o :role)
                      (if (equal backend "x11") '("compositor" "keyboard-holder") '("server"))
                      :test #'equal)
          (funcall fail :wrong-backend-root))
        (when (or (eq (getf o :state) :failed) (eq observed :live)
                  ;; Role knowledge establishes a contradiction, not an observation.
                  (and (or direct (second (assoc (getf o :role) roles :test #'equal)))
                       (eq observed :zombie)))
          (funcall fail :owned-survivor-or-unreaped))
        (unless (and (eq (getf o :state) :stopped) (cleanup-present-p o :direct)
                     (member observed (if direct '(:absent :replaced) '(:absent :replaced :zombie)))
                     (or (not direct) (and wait (/= wait 127))))
          (funcall missing :owned-exit-unverified))
        (when (and (cleanup-present-p o :direct) (not direct) wait)
          (funcall fail :nonchild-wait))
        (when direct (push (list (getf o :pid) (getf o :start) wait) waits))))
    (when (equal backend "wayland")
      (let ((holder (find "keyboard-holder" owned :key (lambda (o) (getf o :role)) :test #'equal)))
        (cond ((null holder)
               (when (and (cleanup-present-p raw :owned) (cleanup-present-p raw :wayland-holder)
                          (not (member (getf raw :wayland-holder) '(:missing :incomplete :unknown)))
                          (every (lambda (o) (cleanup-present-p o :role)) owned))
                 (funcall fail :holder-claim-without-identity)))
              ((and (cleanup-present-p raw :wayland-holder) (cleanup-present-p holder :state)
                    (not (eq (getf raw :wayland-holder) (getf holder :state))))
               (funcall fail :holder-state-mismatch)))))
    (nreverse waits)))

(defun cleanup-project-fields (record mapping)
  (loop for (source target) in mapping when (cleanup-present-p record source)
        append (list target (getf record source))))
(defun cleanup-projection-conflict-p (claimed observed)
  ;; Compare only independently observed fields, including partial owned rows.
  (loop for (key value) on observed by #'cddr
        thereis (if (eq key :owned)
                    (let ((rows (getf claimed :owned)))
                      (or (/= (length rows) (length value))
                          (loop for row in rows for fact in value
                                thereis (loop for (k v) on fact by #'cddr
                                              thereis (not (equal (getf row k) v))))))
                    (not (equal (getf claimed key) value)))))
