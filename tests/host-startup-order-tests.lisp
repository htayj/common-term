;;;; Isolated public-startup controls. Run with the copied-source inert runner.
(in-package #:cl-user)

(defparameter *startup-checks* 0)
(defparameter *startup-events* nil)
(defparameter *startup-event-lock* (sb-thread:make-mutex :name "startup control events"))
(defparameter *startup-caller* nil)
(defparameter *startup-host* nil)
(defparameter *startup-pty* nil)
(defparameter *startup-failure* nil)
(defparameter *startup-mode* nil)
(defparameter *startup-shell* "/fake/shell")
(defparameter *startup-created* 0)
(defparameter *startup-spawns* 0)
(defparameter *startup-closes* 0)
(defparameter *startup-native-threads* nil)
(defparameter *startup-entered* nil)
(defparameter *startup-release* nil)
(defparameter *startup-read* nil)
(defparameter *startup-short-wait* nil)
(defparameter *startup-short-join* nil)
(defparameter *startup-real-make-thread* (symbol-function 'sb-thread:make-thread))
(defparameter *startup-real-join-thread* (symbol-function 'sb-thread:join-thread))
(defparameter *startup-real-wait* nil)
(defparameter *startup-real-window-open* nil)
(defparameter *startup-real-start* nil)
(defparameter *startup-command* nil)

(defun startup-check (truth label)
  (unless truth (error "Startup control failed: ~A; events ~S" label *startup-events*))
  (sb-thread:with-mutex (*startup-event-lock*) (incf *startup-checks*)))
(defun startup-event (event)
  (sb-thread:with-mutex (*startup-event-lock*)
    (setf *startup-events* (append *startup-events* (list event)))))
(defun startup-native (event)
  (startup-check (not (eq sb-thread:*current-thread* *startup-caller*)) :native-owner-only)
  (pushnew sb-thread:*current-thread* *startup-native-threads*)
  (startup-event event))
(defun startup-gate ()
  (sb-thread:signal-semaphore *startup-entered*)
  (unless (sb-thread:wait-on-semaphore *startup-release* :timeout 2)
    (error "Control release missing")))

(define-condition lispterm::lispterm-error (error)
  ((operation :initarg :operation :reader lispterm::error-operation)
   (detail :initarg :detail :initform "" :reader lispterm::error-detail)))
(define-condition lispterm::host-error (lispterm::lispterm-error)
  ((host :initarg :host :initform nil :reader lispterm::host-error-host)))
(define-condition lispterm::host-timeout (lispterm::host-error) ())
(define-condition startup-injected (lispterm::host-error) ())
(define-condition ltd:display-open-failed (startup-injected)
  ((display :initarg :display :reader ltd:display-open-failed-display)))
(in-package #:lispterm.pty)
(defstruct (pty (:constructor cl-user::startup-make-pty)) rows columns process (open-p t))
(in-package #:cl-user)
(defstruct (startup-screen (:constructor startup-make-screen)) rows columns)
(in-package #:lispterm)
(defstruct (session (:constructor cl-user::startup-make-session))
  pty screen (lock (sb-thread:make-mutex)) geometry-status force-frame last-title)
(in-package #:cl-user)

(defun startup-install-stubs ()
  (setf
   (symbol-function 'uiop:getenv) (lambda (name) (startup-check (string= name "SHELL") :shell-only) *startup-shell*)
   (symbol-function 'lispterm.pty:open-pty)
   (lambda (&key rows columns)
     (incf *startup-created*)
     (setf *startup-pty* (startup-make-pty :rows rows :columns columns)))
   (symbol-function 'lispterm::make-session)
   (lambda (pty rows columns)
     (startup-make-session :pty pty :screen (startup-make-screen :rows rows :columns columns)))
   (symbol-function 'lispterm.engine:rows) #'startup-screen-rows
   (symbol-function 'lispterm.engine:columns) #'startup-screen-columns
   (symbol-function 'nerimux/terminal:screen-title) (lambda (screen) (declare (ignore screen)) nil)
   (symbol-function 'ltd:open-display)
   (lambda (&key rows columns backend display-name title)
     (declare (ignore backend display-name title))
     (startup-native :initialize)
     (startup-check (= rows 31) :window-rows)
     (startup-check (= columns 93) :window-columns)
     (case *startup-mode*
       ((:cancel-window :stuck-window) (startup-gate))
       (:slow (sleep .04))
       (:window-fail (error *startup-failure*))
       (:partial-fail (error *startup-failure*)))
     (startup-event :window-ready)
     :fake-display)
   (symbol-function 'ltd:close-display)
   (lambda (display)
     (startup-check (eq display :fake-display) :display-handle)
     (startup-native :display-close)
     (when (eq *startup-mode* :cleanup-fail) (error "Injected native close failure")))
   (symbol-function 'ltd:geometry-status) (lambda (display) (declare (ignore display)) '(:inert t))
   (symbol-function 'ltd:display-cleanup-pending-p) (constantly t)
   (symbol-function 'ltd:display-backend) (constantly :x11)
   (symbol-function 'lispterm.pty:spawn-on-pty)
   (lambda (pty argv &rest options)
     (startup-check (null options) :inherited-environment-no-overrides)
     (startup-check (not (eq sb-thread:*current-thread* (sb-thread:mutex-owner (lispterm::host-lock *startup-host*)))) :no-host-lock-over-spawn)
     (startup-check (eq sb-thread:*current-thread* (first *startup-native-threads*)) :spawn-on-owner)
     (startup-check (member :window-ready *startup-events*) :window-before-spawn)
     (startup-check (and (= 31 (lispterm.pty::pty-rows pty)) (= 93 (lispterm.pty::pty-columns pty))) :pty-size)
     (incf *startup-spawns*)
     (startup-event (list :spawn argv))
     (when (eq *startup-mode* :spawn-fail) (error *startup-failure*))
     (when (eq *startup-mode* :cancel-spawn) (startup-gate))
     ;; Publication is deliberately after the cancellation gate.
     (setf (lispterm.pty::pty-process pty) :inert-process)
     (startup-event :published)
     :inert-process)
   (symbol-function 'lispterm.pty:close-pty)
   (lambda (pty)
     (startup-check (or (null *startup-host*)
                        (null (lispterm::host-thread *startup-host*))
                        (not (sb-thread:thread-alive-p (lispterm::host-thread *startup-host*)))) :close-after-join)
     (incf *startup-closes*)
     (setf (lispterm.pty:pty-open-p pty) nil)
     (startup-event :pty-close))
   (symbol-function 'lispterm::session-read-output)
   (lambda (session)
     (startup-check (lispterm.pty::pty-process (lispterm::session-pty session)) :published-before-read)
     (startup-check (eq :done (lispterm::host-command-state *startup-command*)) :startup-complete-before-read)
     (startup-event :read)
     (sb-thread:signal-semaphore *startup-read*)
     :would-block)
   (symbol-function 'lispterm::display-step)
   (lambda (host) (declare (ignore host)) (startup-native :display)))
  ;; Resolve inert, unexercised dispatch branches before source evaluation.
  (dolist (symbol '(ltd:set-title ltd:request-grid-size ltd:cancel-size-request ltd:display-rows ltd:display-columns
                    lispterm::session-write lispterm::session-event lispterm::session-resize))
    (setf (symbol-function symbol) (lambda (&rest args) (declare (ignore args)) nil))))

(defun startup-install-wrappers ()
  (setf *startup-real-wait* (symbol-function 'lispterm::wait-host-command)
        *startup-real-window-open* (symbol-function 'lispterm::window-open)
        *startup-real-start* (symbol-function 'lispterm::start-window-worker))
  (setf (symbol-function 'lispterm::start-window-worker)
        (lambda (host &optional command)
          (setf *startup-command* command)
          (funcall *startup-real-start* host command)))
  (setf (symbol-function 'lispterm::window-open)
        (lambda (host)
          (setf *startup-host* host)
          (startup-check (not (eq sb-thread:*current-thread* (sb-thread:mutex-owner (lispterm::host-lock host)))) :no-host-lock-over-window)
          (funcall *startup-real-window-open* host)))
  (setf (symbol-function 'lispterm::wait-host-command)
        (lambda (host command timeout)
          (when (eq :startup (lispterm::host-command-operation command))
            (startup-check (eq command *startup-command*) :wait-same-startup-command))
          (funcall *startup-real-wait* host command (if *startup-short-wait* .02 timeout))))
  (sb-ext:without-package-locks
    (setf (symbol-function 'sb-thread:make-thread)
          (lambda (function &rest arguments)
            (when (eq *startup-mode* :thread-fail) (error *startup-failure*))
            (apply *startup-real-make-thread* function arguments)))
    (setf (symbol-function 'sb-thread:join-thread)
          (lambda (thread &rest arguments)
            (when *startup-short-join* (setf (getf arguments :timeout) .02))
            (apply *startup-real-join-thread* thread arguments)))))

(defun startup-reset (&optional mode)
  (setf *startup-events* nil *startup-host* nil *startup-pty* nil *startup-mode* mode
        *startup-failure* (make-condition 'startup-injected :operation :injected)
        *startup-shell* "/fake/shell" *startup-created* 0 *startup-spawns* 0 *startup-closes* 0
        *startup-native-threads* nil *startup-short-wait* nil *startup-short-join* nil
        *startup-entered* (sb-thread:make-semaphore) *startup-release* (sb-thread:make-semaphore)
        *startup-read* (sb-thread:make-semaphore))
  (clrhash lispterm::*hosts*))
(defun startup-open (&rest arguments)
  (apply #'lispterm::open :rows 31 :columns 93 arguments))
(defun startup-catch (function)
  (handler-case (progn (funcall function) nil) (error (condition) condition)))
(defun startup-halt (host)
  (lispterm::stop-window-worker host)
  (startup-check (null (lispterm::host-display host)) :closed-display)
  (startup-check (null (lispterm::host-thread host)) :joined-owner))
(defun startup-check-failed (condition expected owned-p)
  (startup-check (eq condition expected) :original-typed-condition)
  (startup-check (typep condition 'startup-injected) :typed-injection)
  (startup-check (= *startup-spawns* (if (eq *startup-mode* :spawn-fail) 1 0)) :failure-spawns)
  (startup-check (= *startup-closes* (if owned-p 1 0)) :failure-pty-close-count)
  (startup-check (not (member :read *startup-events*)) :failure-no-io)
  (startup-check (not (member :display *startup-events*)) :failure-no-display)
  (startup-check (zerop (hash-table-count lispterm::*hosts*)) :failure-not-registered))

(defun run-host-startup-order-tests ()
  (setf *startup-caller* sb-thread:*current-thread*)
  (startup-install-wrappers)
  (unwind-protect
       (progn
         ;; Slow initialization, exact arguments and first I/O ordering.
         (startup-reset :slow)
         (let ((host (startup-open :argv '("/exact/program" "arg with spaces"))))
           (startup-check (sb-thread:wait-on-semaphore *startup-read* :timeout 1) :first-read)
           (startup-check (equal (subseq *startup-events* 0 4)
                                 '(:initialize :window-ready (:spawn ("/exact/program" "arg with spaces")) :published)) :startup-order)
           (startup-check (= *startup-spawns* 1) :one-spawn)
           (startup-check (null (lispterm::host-errors host)) :no-io-error-or-eof-backoff)
           (startup-check (eq (gethash (lispterm::host-id host) lispterm::*hosts*) host) :registered-on-success)
           (lispterm::call-host host :detach)
           (lispterm::reopen host)
           (startup-check (= *startup-spawns* 1) :detach-reopen-no-respawn)
           (startup-check (= 1 (length *startup-native-threads*)) :one-native-owner)
           (startup-halt host))
         (dolist (shell '("/selected/shell" nil))
           (startup-reset)
           (setf *startup-shell* shell)
           (let ((host (startup-open)))
             (startup-check (member (list :spawn (list (or shell "/bin/sh"))) *startup-events* :test #'equal) :default-argv)
             (startup-halt host)))
         ;; An already live adopted PTY must never spawn, including reopen.
         (startup-reset)
         (let* ((pty (startup-make-pty :rows 31 :columns 93 :process :adopted))
                (host (startup-open :pty pty)))
           (lispterm::call-host host :detach)
           (lispterm::reopen host)
           (startup-check (zerop *startup-spawns*) :adoption-no-spawn)
           (startup-check (zerop *startup-created*) :adoption-no-allocation)
           (startup-halt host)
           (startup-check (zerop *startup-closes*) :adoption-stop-keeps-pty))
         (dolist (mode '(:window-fail :spawn-fail :thread-fail))
           (startup-reset mode)
           (startup-check-failed (startup-catch (lambda () (startup-open :argv '("/exact")))) *startup-failure* t))
         (startup-reset :window-fail)
         (let ((pty (startup-make-pty :rows 31 :columns 93 :process :adopted)))
           (startup-check-failed (startup-catch (lambda () (startup-open :pty pty))) *startup-failure* nil)
           (startup-check (lispterm.pty:pty-open-p pty) :failed-adoption-keeps-pty))
         ;; A typed partial native-open error supplies a recovery display.
         (startup-reset :partial-fail)
         (setf *startup-failure* (make-condition 'ltd:display-open-failed :operation :injected :display :fake-display))
         (startup-check-failed (startup-catch (lambda () (startup-open :argv '("/exact")))) *startup-failure* t)
         (startup-check (member :display-close *startup-events*) :partial-display-cleaned)
         ;; Force real timeout while owner is blocked before spawn, then release.
         ;; Also force timeout while irreversible spawn has begun but publication
         ;; has not returned. Caller joins the owner before releasing the PTY.
         (dolist (mode '(:cancel-window :cancel-spawn))
           (startup-reset mode)
           (setf *startup-short-wait* t)
           (let ((releaser (funcall *startup-real-make-thread*
                                   (lambda ()
                                     (sb-thread:wait-on-semaphore *startup-entered* :timeout 1)
                                     (sleep .06)
                                     (sb-thread:signal-semaphore *startup-release*)))))
             (let ((condition (startup-catch (lambda () (startup-open :argv '("/exact"))))))
               (funcall *startup-real-join-thread* releaser)
               (startup-check (typep condition 'lispterm::host-timeout) :cancel-typed-timeout)
               (startup-check (= *startup-spawns* (if (eq mode :cancel-spawn) 1 0)) :cancellation-spawn-boundary)
               (startup-check (= *startup-closes* 1) :cancel-close-once)
               (startup-check (not (member :read *startup-events*)) :cancel-no-read)
               (startup-check (not (member :display *startup-events*)) :cancel-no-display)
               (startup-check (null (lispterm::host-thread *startup-host*)) :cancel-joined)
               (startup-check (member :display-close *startup-events*) :cancel-display-cleaned))))
         ;; Cleanup failure must retain a registered recovery host and its PTY.
         (startup-reset :cleanup-fail)
         (setf *startup-failure* (make-condition 'startup-injected :operation :injected))
         (let ((original-spawn (symbol-function 'lispterm.pty:spawn-on-pty)))
           (unwind-protect
                (progn
                  (setf (symbol-function 'lispterm.pty:spawn-on-pty)
                        (lambda (&rest args) (declare (ignore args)) (error *startup-failure*)))
                  (let* ((condition (startup-catch (lambda () (startup-open :argv '("/exact")))))
                         (host (lispterm::host-error-host condition)))
                    (startup-check (typep condition 'lispterm::host-error) :cleanup-typed)
                    (startup-check (eq (lispterm::error-operation condition) :open-cleanup) :cleanup-operation)
                    (startup-check (eq host (gethash (lispterm::host-id host) lispterm::*hosts*)) :recovery-registered)
                    (startup-check (eq (lispterm::host-display host) :fake-display) :recovery-handle)
                    (startup-check (zerop *startup-closes*) :cleanup-pending-pty-not-closed)
                    (startup-check (search "INJECTED" (string-upcase (lispterm::error-detail condition))) :primary-error-retained)
                    (startup-check (not (member :read *startup-events*)) :cleanup-no-io)))
             (setf (symbol-function 'lispterm.pty:spawn-on-pty) original-spawn)))
         ;; Owner still active at cleanup deadline: no close underneath it.
         (startup-reset :stuck-window)
         (setf *startup-short-wait* t *startup-short-join* t)
         (let* ((condition (startup-catch (lambda () (startup-open :argv '("/exact")))))
                (host (lispterm::host-error-host condition)))
           (startup-check (eq (lispterm::error-operation condition) :open-cleanup) :active-recovery)
           (startup-check (sb-thread:thread-alive-p (lispterm::host-thread host)) :owner-retained)
           (startup-check (zerop *startup-closes*) :active-pty-retained)
           (startup-check (zerop *startup-spawns*) :active-cancel-before-spawn)
           (sb-thread:signal-semaphore *startup-release*)
           (funcall *startup-real-join-thread* (lispterm::host-thread host) :timeout 1)
           (startup-check (zerop *startup-spawns*) :no-late-spawn)
           (startup-check (not (member :read *startup-events*)) :late-no-io))
         (format t "~D startup controls passed.~%" *startup-checks*))
    (sb-ext:without-package-locks
      (setf (symbol-function 'sb-thread:make-thread) *startup-real-make-thread*
            (symbol-function 'sb-thread:join-thread) *startup-real-join-thread*))
    (setf (symbol-function 'lispterm::wait-host-command) *startup-real-wait*
          (symbol-function 'lispterm::window-open) *startup-real-window-open*
          (symbol-function 'lispterm::start-window-worker) *startup-real-start*)))
