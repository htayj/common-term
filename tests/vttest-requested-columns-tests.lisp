;;;; Focused offline width-predictor checks; no artifact directories or application.
(load (merge-pathnames "vttest-protocol.lisp" *load-truename*))
(in-package #:vttest-check)

(let ((checks 0) (failures 0))
  (flet ((expect (expected output name &optional (end (length output)))
           (let ((actual (requested-columns output end)))
             (incf checks)
             (unless (= expected actual) (incf failures))
             (format t "~a ~a: expected ~d, got ~d~%"
                     (if (= expected actual) "PASS" "FAIL") name expected actual))))
    (expect 80 "" "initial width")
    (expect 132 (esc "[?3h") "standalone set")
    (expect 80 (cat (esc "[?3h") (esc "[?3l")) "standalone reset")
    ;; vttest 20251205 main.c bug_f resets origin, reverse, and columns together.
    (expect 80 (cat (esc "[?5h") (esc "[?3h") (esc "[2J") (esc "[?6;5;3l"))
            "upstream combined reset")
    (dolist (parameters '("3;5;6" "6;3;5" "6;5;3"))
      (let ((set (esc (cat "[?" parameters "h")))
            (reset (esc (cat "[?" parameters "l"))))
        (expect 132 set (cat "combined set " parameters))
        (expect 80 (cat (esc "[?3h") reset) (cat "combined reset " parameters))
        (expect 80 set (cat "set before final " parameters) (1- (length set)))
        (expect 132 set (cat "set through final " parameters) (length set))
        (expect 132 (cat (esc "[?3h") reset) (cat "reset before final " parameters)
                (+ 5 (1- (length reset))))
        (expect 80 (cat (esc "[?3h") reset) (cat "reset through final " parameters)
                (+ 5 (length reset)))))
    (expect 132 (cat (esc "[?3h") (esc "[?6;5;3l") (esc "[?3;5h"))
            "last combined request wins")
    (expect 80 (cat (esc "[?3;5h") (esc "[?3l")) "later standalone reset wins")
    (expect 80 (cat (esc "[?3;5h") (esc "c")) "RIS after combined set")
    (expect 132 (cat (esc "[?3;5h") (esc "c") (esc "[?5;3h")) "set after RIS")
    (expect 132 (cat (esc "[?3h") (esc "c")) "RIS before final" 6)
    (expect 80 (cat (esc "[?3h") (esc "c")) "RIS through final" 7)
    (dolist (tail '("[?13h" "[?30h" "[?6;13;30h" "[3h" "[6;3;5h"
                    "[?3;5m" "[?3;5" "[?3;xh"))
      (expect 80 (esc tail) (cat "no width set from " tail)))
    (dolist (tail '("[?13l" "[?30l" "[?6;13;30l" "[3l" "[6;3;5l"
                    "[?3;5m" "[?3;5" "[?3;xl"))
      (expect 132 (cat (esc "[?3h") (esc tail)) (cat "no width reset from " tail)))
    (format t "Requested-columns checks: ~d total, ~d passed, ~d failed~%"
            checks (- checks failures) failures)
    (when (plusp failures) (error "~d requested-columns checks failed" failures))))
