;;;; Pure synthetic checks; no native acceptance. Load this file to run.
(load (merge-pathnames "vttest-vt52-native-check.lisp" *load-truename*))
(load (merge-pathnames "vttest-vt52-admission-tests.lisp" *load-truename*))
(defpackage #:vttest-vt52-native-check-tests
  (:use #:cl #:vttest-vt52-native-check)
  (:local-nicknames (#:a #:vttest-vt52-admission)
    (#:f #:vttest-vt52-admission-tests) (#:h #:vttest-vt52-sha256)
    (#:o #:vttest-vt52-oracle) (#:p #:vttest-vt52-pixels)
    (#:s #:vttest-screen-oracle)))
(in-package #:vttest-vt52-native-check-tests)
(defvar *checks* 0)
(defvar *failures* 0)
(defmacro check (name form)
  `(progn (incf *checks*)
     (unless (handler-case ,form (serious-condition () nil))
       (incf *failures*) (format t "FAIL ~s~%" ,name))))
(defparameter *font* (vttest-cursor-oracle:read-bytes
  (merge-pathnames "../.build/deps/share/fonts/terminus/ter-u16n.otb" *load-truename*)))
(defparameter *snapshot* (o:vt52-snapshot))
(defparameter *r1* (p:expected-rgba *snapshot* *font*
  :font-sha256 p:+font-sha256+ :scale 1 :blink-phase t))
(defparameter *r2* (p:expected-rgba *snapshot* *font*
  :font-sha256 p:+font-sha256+ :scale 2 :blink-phase t))
(defun admitted (raw)
  (multiple-value-bind (a reasons) (apply #'a:admit-vt52-capture raw)
    (unless (and a (null reasons)) (error "Fixture refused: ~s" reasons)) a))
(defun run (&rest over)
  (apply #'validate-vt52-capture
    (append over (list :admission (admitted (f:fixture)) :snapshot *snapshot*
      :font *font* :font-sha256 p:+font-sha256+ :scale 1
      :rgba *r1* :width 640 :height 384))))
(defun refused-p (report &rest reasons)
  (and (eq :refuse (getf report :verdict))
       (subsetp reasons (getf report :reasons) :test #'equal)))
(defun changed (key field value &optional remove)
  (let ((raw (f:fixture)))
    (f::revise raw key (lambda (p)
      (if remove (remf p field) (setf (getf p field) value)) p))
    ;; READY is also the original request's embedded status. Rebind its bytes.
    (when (eq key :ready)
      (f::revise raw :request-sexp (lambda (q)
        (setf (getf q :status) (let ((*read-eval* nil))
          (read-from-string (sb-ext:octets-to-string (getf raw :ready)
            :external-format :utf-8)))) q)))
    raw))
(defun changed-run (key field value &optional remove)
  (run :admission (admitted (changed key field value remove))))
(defun flip (frame scale row column)
  (let ((copy (copy-seq frame))
        (i (* 4 (+ (* (1- row) 16 scale 640 scale) (* (1- column) 8 scale)))))
    (setf (aref copy i) (logxor 255 (aref copy i))) copy))
(defun circular ()
  (let ((x (list :admission nil))) (setf (cdr (last x)) x) x))
(dolist (backend '(:x11 :wayland))
  (dolist (scale '(1 2))
    (let* ((raw (f:fixture :backend backend :scale scale)) (a (admitted raw))
           (r (run :admission a :scale scale :rgba (if (= scale 1) *r1* *r2*)
                   :width (* 640 scale) :height (* 384 scale))))
      (check (list :pass backend scale)
        (and (eq :pass (getf r :verdict)) (null (getf r :reasons))
          (eql 0 (getf r :frame-differences))
          (equal '(:count 32 :failed nil) (getf r :graphics))
          (equal '(:count 102 :failed nil) (getf r :boundaries))
          (equal (getf r :expected-sha256) (getf r :actual-rgba-sha256))))
      (check (list :computed-cursor backend scale)
        (equal (getf r :cursor)
          (list :before-seq 2 :after-seq 6
            :pre-sha256 (h:sha256-hex (getf raw :pre))
            :final-sha256 (h:sha256-hex (getf raw :final))
            :trace-sha256 (h:sha256-hex (getf raw :control))))))))
(let ((r (run)))
  (check :closed-keys (equal (loop for k in r by #'cddr collect k)
    '(:schema :verdict :reasons :scale :pause :frame-differences :graphics
      :boundaries :expected-sha256 :actual-rgba-sha256 :cursor :limitations))))
(let ((r (run :rgba (flip *r1* 1 9 31))))
  (check :graphics-pixel (and (refused-p r :graphics)
    (eql 1 (getf r :frame-differences))
    (equal '((9 31)) (getf (getf r :graphics) :failed)))))
(let ((r (run :admission (admitted (f:fixture :scale 2))
  :scale 2 :rgba (flip *r2* 2 4 62) :width 1280 :height 768)))
  (check :boundary-pixel (and (refused-p r :boundaries)
    (eql 1 (getf r :frame-differences))
    (null (getf (getf r :graphics) :failed))
    (equal '((4 62)) (getf (getf r :boundaries) :failed)))))
(check :background-pixel (equal '(:frame-differences)
  (getf (run :rgba (flip *r1* 1 20 70)) :reasons)))
(let ((image (copy-seq *r1*))) (setf (aref image 3) 254)
  (check :opacity (refused-p (run :rgba image) :nonopaque)))
(check :scale-3 (refused-p (run :scale 3) :scale))
(check :size (refused-p (run :width 641) :size))
(check :raster-length (refused-p (run :scale 2 :width 1280 :height 768) :rgba-length))
(check :admitted-scale (refused-p
  (run :scale 2 :width 1280 :height 768 :rgba *r2*) :admission-geometry))
(check :font (refused-p (run :font (subseq *font* 1)) :font))
(check :font-pin (refused-p (run :font-sha256 "0") :font-sha256))
(check :snapshot-nil (refused-p (run :snapshot nil) :snapshot))
(let ((cells (o:snapshot-cells *snapshot*)))
  (setf (aref cells 0) (s:make-cell :code 88))
  (check :snapshot-edited (refused-p (run :snapshot (o::%snapshot cells)) :snapshot)))
(dolist (value (list nil '(:pause 2 :target 100) '(:pause . 2) (circular) 42))
  (check :non-admission (let ((r (run :admission value)))
    (and (refused-p r :admission-missing) (null (getf r :cursor))
         (eql 0 (getf r :frame-differences))))))
(check :admission-omitted (refused-p
  (validate-vt52-capture :snapshot *snapshot* :font *font*
    :font-sha256 p:+font-sha256+ :scale 1 :rgba *r1* :width 640 :height 384)
  :admission-missing))
(check :phase-nil (refused-p (changed-run :ready :blink-phase nil) '(:blink :ready)))
(check :visible-t (refused-p (changed-run :pre :blink-visible t) '(:blink :pre)))
(check :blink-omitted
  (refused-p (changed-run :before :blink-visible nil t) '(:blink-missing :before)))
(check :one-frame (refused-p (changed-run :before :frames 3)
  '(:frame-bracket (:one-frame))))
(check :target-bytes (refused-p (changed-run :pre :bytes-received 101)
  '(:frame-bracket (:target-bytes :ready-pre))))
(check :final-bracket (refused-p (changed-run :final :frames 4)
  '(:frame-bracket (:ready-final))))
(check :session-bracket (refused-p (changed-run :before :id 6)
  '(:frame-bracket ((:before-state :id)))))
;; Builder-owned failures are tested at the public boundary, never bypassed.
(let ((raw (f:fixture))) (setf (getf raw :pause) 3)
  (check :pause (f::refused raw)))
(dolist (pair '((:row 13) (:visible nil) (:when :after-done)
                (:seq 30) (:linked-sha256 "AB")))
  (let ((raw (f:fixture)))
    (f::revise raw :control (lambda (events)
      (setf (getf (second events) (first pair)) (second pair)) events))
    (check (list :cursor-ledger pair) (f::refused raw))))
(let ((raw (changed :native :pause 3)))
  (check :native-pause (f::refused raw)))
(let ((raw (f:fixture)))
  (setf (getf raw :pre) (concatenate '(vector (unsigned-byte 8))
    (getf raw :pre) #(32)))
  (check :stale-original-hash (f::refused raw)))
(format t "VT52 checker synthetic tests: ~d checks, ~d failures~%" *checks* *failures*)
(unless (zerop *failures*) (error "Checker synthetic suite failed"))
