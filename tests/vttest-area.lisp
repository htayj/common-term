;;;; Standalone, fail-closed area gate core. No project or recorder is loaded.
(load (merge-pathnames "vttest-selection.lisp" *load-truename*))
(require :sb-posix)
(defpackage :vttest-area
  (:use :cl)
  (:export :main :read-data :validate-manifest :aggregate-observations
           :run-selected :gate-problem :problem-code :problem-reason))
(in-package :vttest-area)

(defconstant +limit+ 1048576)
(defparameter *areas*
  '("cursor-movements" "screen-features" "character-sets" "double-size-characters"
    "keyboard" "terminal-reports" "vt52-mode" "vt102-features" "known-bugs"
    "reset-self-test" "non-vt100-extensions"))
;; Pinned interface vocabulary from vttest-protocol.lisp, not a substring filter.
(defparameter *recorders*
  '(("cursor" (1) 6) ("screen" (2) 15) ("charsets" (3) 1)
    ("double-size" (4) 6) ("reports-dsr" (6 3) 1) ("reports-da" (6 4) 1)
    ("reports-parameters" (6 7) 1) ("vt52" (7) 3) ("vt102" (8) 14)
    ("bug-b" (9 2) 2) ("bug-c" (9 3) 1) ("bug-d" (9 4) 1)
    ("bug-e" (9 5) 1) ("bug-f" (9 6) 2) ("bug-wrap" (9 7) 1)
    ("bug-erase" (9 8) 6) ("bug-scroll" (9 9) 2) ("reset-ris" (10 1) 2)
    ("keyboard-cursor" (5 4) 1) ("keyboard-keypad" (5 5) 1)))
(define-condition gate-problem (error)
  ((code :initarg :code :reader problem-code)
   (reason :initarg :reason :reader problem-reason))
  (:report (lambda (c s) (format s "~A (exit ~D)" (problem-reason c) (problem-code c)))))
(defun refuse (reason &optional (code 2))
  (error 'gate-problem :reason reason :code code))
(defun need (test reason) (unless test (refuse reason)))
(defun bounded-string-p (x &optional (limit 256))
  (and (stringp x) (<= 1 (length x) limit)
       (every (lambda (c) (and (>= (char-code c) 32) (/= (char-code c) 127))) x)))
(defun identifier-p (x)
  (and (bounded-string-p x 128)
       (every (lambda (c) (or (find c "abcdefghijklmnopqrstuvwxyz0123456789-_") nil)) x)))
(defun hash-p (x &optional (length 64))
  (and (stringp x) (= (length x) length) (every (lambda (c) (find c "0123456789abcdef")) x)))
(defun proper (x &optional (limit 4096))
  ;; Also safe for caller-supplied circular structures outside the file reader.
  (let ((seen (make-hash-table :test #'eq)) (n 0))
    (loop while (consp x) do
      (when (or (gethash x seen) (> (incf n) limit)) (refuse :nonfinite-list))
      (setf (gethash x seen) t x (cdr x)))
    (need (null x) :improper-list) n))
(defun plist-keys (x allowed &optional (required allowed))
  (need (evenp (proper x)) :odd-properties)
  (let ((seen nil))
    (loop for key in x by #'cddr do
      (need (member key allowed) :unknown-key)
      (need (not (member key seen)) :duplicate-key) (push key seen))
    (need (every (lambda (k) (member k seen)) required) :missing-key)) x)
(defun unique-strings (xs &key (nonempty t))
  (proper xs) (need (or (not nonempty) xs) :empty-list)
  (need (every #'identifier-p xs) :invalid-identifier)
  (need (= (length xs) (length (remove-duplicates xs :test #'equal))) :duplicate-identifier) xs)
(defun safe-components (path)
  (need (bounded-string-p path 4096) :invalid-path)
  (need (and (not (find #\Null path)) (not (find #\\ path))) :invalid-path)
  (let ((parts nil) (start (if (char= (char path 0) #\/) 1 0)))
    (loop for end = (position #\/ path :start start) do
      (let ((part (subseq path start end)))
        (need (and (plusp (length part)) (not (member part '("." "..") :test #'equal))) :unsafe-path)
        (push part parts))
      (unless end (return)) (setf start (1+ end)))
    (nreverse parts)))
;; openat pins each parent directory. O_NOFOLLOW applies to every component,
;; including a replaced parent, rather than relying on a racy preflight lstat.
(sb-alien:define-alien-routine ("openat" %openat) sb-alien:int
  (dir sb-alien:int) (path sb-alien:c-string) (flags sb-alien:int) (mode sb-alien:unsigned-int))
(defun open-input-fd (path)
  (let* ((parts (safe-components path))
         (dir (sb-posix:open (if (char= (char path 0) #\/) "/" ".")
                             (logior sb-posix:o-rdonly sb-posix:o-directory)))
         (result nil))
    (unwind-protect
         (progn
           (dolist (part (butlast parts))
             (let ((next (%openat dir part (logior sb-posix:o-rdonly sb-posix:o-directory sb-posix:o-nofollow) 0)))
               (when (minusp next) (refuse :unsafe-or-missing-parent))
               (sb-posix:close dir) (setf dir next)))
           (setf result (%openat dir (car (last parts))
                                (logior sb-posix:o-rdonly sb-posix:o-nofollow sb-posix:o-nonblock) 0))
           (when (minusp result) (setf result nil) (refuse :unsafe-or-missing-file))
           (let ((stat (sb-posix:fstat result)))
             (need (sb-posix:s-isreg (sb-posix:stat-mode stat)) :not-regular)
             (need (<= (sb-posix:stat-size stat) +limit+) :oversize))
           (prog1 result (setf result nil)))
      (when result (sb-posix:close result)) (sb-posix:close dir))))

;; SHA256 over retained input bytes, with no external hasher or tree traversal.
(defparameter *sha-k*
  #(#x428a2f98 #x71374491 #xb5c0fbcf #xe9b5dba5 #x3956c25b #x59f111f1 #x923f82a4 #xab1c5ed5
    #xd807aa98 #x12835b01 #x243185be #x550c7dc3 #x72be5d74 #x80deb1fe #x9bdc06a7 #xc19bf174
    #xe49b69c1 #xefbe4786 #x0fc19dc6 #x240ca1cc #x2de92c6f #x4a7484aa #x5cb0a9dc #x76f988da
    #x983e5152 #xa831c66d #xb00327c8 #xbf597fc7 #xc6e00bf3 #xd5a79147 #x06ca6351 #x14292967
    #x27b70a85 #x2e1b2138 #x4d2c6dfc #x53380d13 #x650a7354 #x766a0abb #x81c2c92e #x92722c85
    #xa2bfe8a1 #xa81a664b #xc24b8b70 #xc76c51a3 #xd192e819 #xd6990624 #xf40e3585 #x106aa070
    #x19a4c116 #x1e376c08 #x2748774c #x34b0bcb5 #x391c0cb3 #x4ed8aa4a #x5b9cca4f #x682e6ff3
    #x748f82ee #x78a5636f #x84c87814 #x8cc70208 #x90befffa #xa4506ceb #xbef9a3f7 #xc67178f2))
(defun u32 (n) (logand n #xffffffff))
(defun rotr (n k) (u32 (logior (ash n (- k)) (ash n (- 32 k)))))
(defun sha256 (bytes)
  (let* ((n (length bytes)) (size (* 64 (ceiling (+ n 9) 64)))
         (data (make-array size :element-type '(unsigned-byte 8) :initial-element 0))
         (h (vector #x6a09e667 #xbb67ae85 #x3c6ef372 #xa54ff53a #x510e527f #x9b05688c #x1f83d9ab #x5be0cd19))
         (w (make-array 64 :initial-element 0)))
    (replace data bytes) (setf (aref data n) 128)
    (dotimes (i 8) (setf (aref data (- size 1 i)) (ldb (byte 8 (* i 8)) (* n 8))))
    (loop for offset from 0 below size by 64 do
      (dotimes (i 16)
        (setf (aref w i) (loop for j below 4 sum (ash (aref data (+ offset (* i 4) j)) (* 8 (- 3 j))))))
      (loop for i from 16 below 64 do
        (let ((x (aref w (- i 15))) (y (aref w (- i 2))))
          (setf (aref w i) (u32 (+ (aref w (- i 16)) (logxor (rotr x 7) (rotr x 18) (ash x -3))
                                        (aref w (- i 7)) (logxor (rotr y 17) (rotr y 19) (ash y -10)))))))
      (let ((a (aref h 0)) (b (aref h 1)) (c (aref h 2)) (d (aref h 3))
            (e (aref h 4)) (f (aref h 5)) (g (aref h 6)) (hh (aref h 7)))
        (dotimes (i 64)
          (let* ((t1 (u32 (+ hh (logxor (rotr e 6) (rotr e 11) (rotr e 25))
                            (logxor (logand e f) (logand (lognot e) g)) (aref *sha-k* i) (aref w i))))
                 (t2 (u32 (+ (logxor (rotr a 2) (rotr a 13) (rotr a 22))
                            (logxor (logand a b) (logand a c) (logand b c))))))
            (psetf hh g g f f e e (u32 (+ d t1)) d c c b b a a (u32 (+ t1 t2)))))
        (loop for x in (list a b c d e f g hh) for i from 0 do (setf (aref h i) (u32 (+ (aref h i) x))))))
    (string-downcase (format nil "~{~8,'0X~}" (coerce h 'list)))))

(defun preflight (text)
  ;; Bound nesting before READ; reject all reader macros except the bounded
  ;; #A((n) BASE-CHAR . "...") strings in the documentary manifests.
  (let ((depth 0) (tokens 0) (i 0) (n (length text)))
    (labels ((spacep (c) (find c '(#\Space #\Tab #\Newline #\Return)))
             (skip-space () (loop while (and (< i n) (spacep (char text i))) do (incf i))))
      (loop while (< i n) for c = (char text i) do
        (when (> (incf tokens) 100000) (refuse :too-many-tokens))
        (cond
          ((spacep c) (incf i))
          ((char= c #\;) (setf i (or (position #\Newline text :start i) n)))
          ((char= c #\")
           (incf i)
           (loop
             (need (< i n) :unterminated-string)
             (let ((x (char text i))) (incf i)
               (cond ((char= x #\\) (need (< i n) :unterminated-escape) (incf i))
                     ((char= x #\") (return))))))
          ((char= c #\() (incf depth) (need (<= depth 64) :too-deep) (incf i))
          ((char= c #\)) (decf depth) (need (>= depth 0) :bad-parentheses) (incf i))
          ((char= c #\#)
           (need (and (<= (+ i 4) n) (string-equal "#A((" text :start2 i :end2 (+ i 4))) :reader-macro)
           (incf i 4)
           (let ((start i))
             (loop while (and (< i n) (digit-char-p (char text i))) do (incf i))
             (need (and (< start i) (<= (- i start) 4) (< i n) (char= (char text i) #\))
                        (<= (parse-integer text :start start :end i) 4096)) :array-dimension))
           ;; Account for the array's outer list and dimensions list.
           (incf depth 2) (need (<= depth 64) :too-deep)
           ;; Only this simple one-dimensional representation is allowed.
           (incf i) (decf depth) (skip-space)
           (need (and (<= (+ i 9) n) (string-equal "BASE-CHAR" text :start2 i :end2 (+ i 9))) :array-type)
           (incf i 9) (skip-space) (need (and (< i n) (char= (char text i) #\.)) :array-shape)
           (incf i) (skip-space) (need (and (< i n) (char= (char text i) #\")) :array-shape))
          ((or (alphanumericp c) (find c ":-_.+"))
           (let ((start i))
             (loop while (and (< i n) (or (alphanumericp (char text i)) (find (char text i) ":-_.+"))) do (incf i))
             (need (<= (- i start) 256) :oversize-token)
             (let ((token (subseq text start i)))
               (need (or (and (char= (char token 0) #\:) (> (length token) 1)
                              (not (find #\: token :start 1)))
                         (every #'digit-char-p token)
                         (member (string-upcase token) '("NIL" "T") :test #'equal)) :invalid-token))))
          (t (refuse :reader-macro))))
      (need (zerop depth) :bad-parentheses))))
(defun read-data (path)
  (let* ((fd (open-input-fd path))
         (stream (sb-sys:make-fd-stream fd :input t :element-type '(unsigned-byte 8) :auto-close t))
         (bytes nil))
    (unwind-protect
         (let* ((buffer (make-array (1+ +limit+) :element-type '(unsigned-byte 8)))
                (n (read-sequence buffer stream)))
           (need (<= n +limit+) :oversize) (setf bytes (subseq buffer 0 n)))
      (close stream))
    (let ((text (sb-ext:octets-to-string bytes :external-format :utf-8)))
      (preflight text)
      (let ((*read-eval* nil) (*readtable* (copy-readtable nil))
            (*read-default-float-format* 'single-float) (*package* (find-package :vttest-area)))
        (with-input-from-string (s text)
          (let* ((eof (gensym)) (form (read s nil eof)))
            (need (not (eq form eof)) :empty-file)
            (need (eq (read s nil eof) eof) :multiple-forms)
            (values form (sha256 bytes))))))))

(defun validate-scenario (s)
  (plist-keys s '(:id :recorder-label :new-path :menu-path :pauses :captures :bytes :timing :oracle :requires)
              '(:id :recorder-label :menu-path :pauses :captures :bytes :timing :oracle :requires))
  (need (identifier-p (getf s :id)) :scenario-id)
  (let* ((label (getf s :recorder-label)) (known (assoc label *recorders* :test #'equal))
         (path (getf s :menu-path)) (pauses (getf s :pauses)))
    (need (identifier-p label) :recorder-label) (proper path 16)
    (need (and path (every (lambda (v) (typep v '(integer 0 999))) path)) :menu-path)
    (need (typep pauses '(integer 0 4096)) :pauses)
    (if known
        (need (and (equal path (second known)) (= pauses (third known)) (not (getf s :new-path))) :recorder-selector)
        (need (eq (getf s :new-path) t) :undeclared-recorder)))
  (dolist (key '(:bytes :timing)) (need (member (getf s key) '(nil t)) :boolean))
  (let ((oracle (getf s :oracle)))
    (plist-keys oracle '(:path :sha256)) (safe-components (getf oracle :path))
    (need (hash-p (getf oracle :sha256)) :oracle-hash))
  (let ((captures (getf s :captures)))
    (proper captures 4096) (need captures :empty-captures)
    (dolist (c captures)
      (plist-keys c '(:id :pause)) (need (identifier-p (getf c :id)) :capture-id)
      (need (and (typep (getf c :pause) '(integer 0 4096)) (<= (getf c :pause) (getf s :pauses))) :capture-pause))
    (unique-strings (mapcar (lambda (c) (getf c :id)) captures)))
  (let ((requires (getf s :requires)))
    (proper requires 64) (need requires :empty-requires)
    (dolist (r requires)
      (plist-keys r '(:capability :path)) (need (identifier-p (getf r :capability)) :capability)
      (safe-components (getf r :path)))
    (unique-strings (mapcar (lambda (r) (getf r :capability)) requires))) s)
(defun validate-manifest (m area backend)
  (proper m)
  ;; Documentary records are deliberately not promoted into executable scope.
  (when (and (getf m :areas) (getf m :area-dependencies))
    (proper (getf m :areas) 64)
    (need (find area (getf m :areas) :test #'equal :key (lambda (r) (getf r :area))) :unknown-documentary-area)
    (refuse :scope-not-executable 3))
  (plist-keys m '(:kind :version :area :backend :scope-status :conditions :scenarios :required-count :native-driver :pins)
              '(:kind :version :area :backend :scope-status :conditions :scenarios :required-count))
  (need (and (eq (getf m :kind) :vttest-area-manifest) (eql (getf m :version) 1)) :manifest-version)
  (need (and (equal (getf m :area) area) (equal (getf m :backend) backend)) :manifest-selector)
  (need (eq (getf m :scope-status) :frozen) :scope-not-frozen)
  (unique-strings (getf m :conditions))
  (let ((scenarios (getf m :scenarios)))
    (proper scenarios 1024) (need scenarios :empty-scenarios)
    (mapc #'validate-scenario scenarios)
    (unique-strings (mapcar (lambda (s) (getf s :id)) scenarios)))
  ;; Count is capture identities, not a guessed native test cardinality.
  (need (and (typep (getf m :required-count) '(integer 1 65536))
             (= (getf m :required-count) (loop for s in (getf m :scenarios) sum (length (getf s :captures))))) :required-count)
  m)
(defun parse-cli (args)
  (need (= (length args) 6) :usage)
  (let ((seen nil) (values nil))
    (loop for (key value) on args by #'cddr do
      (need (member key '("--area" "--backend" "--manifest") :test #'equal) :unknown-flag)
      (need (not (member key seen :test #'equal)) :repeated-flag)
      (push key seen) (push (cons key value) values))
    (let ((area (cdr (assoc "--area" values :test #'equal)))
          (backend (cdr (assoc "--backend" values :test #'equal)))
          (path (cdr (assoc "--manifest" values :test #'equal))))
      (need (member area *areas* :test #'equal) :unknown-area)
      (need (member backend '("x11" "wayland") :test #'equal) :unknown-backend)
      (safe-components path) (values area backend path))))
(defun git-binding (name)
  (handler-case
      (with-output-to-string (out)
        (let ((p (sb-ext:run-program "git" (list "rev-parse" "--verify" name) :search t :output out :error nil)))
          (unless (zerop (sb-ext:process-exit-code p)) (refuse :source-binding-unavailable 3))))
    (error () (refuse :source-binding-unavailable 3))))
(defun source-bindings ()
  (let ((head (string-trim '(#\Newline #\Return) (git-binding "HEAD")))
        (tree (string-trim '(#\Newline #\Return) (git-binding "HEAD^{tree}"))))
    (unless (and (hash-p head 40) (hash-p tree 40)) (refuse :source-binding-unavailable 3))
    (values head tree)))
(defun capability-ready (r m manifest-hash head tree)
  (handler-case
      (multiple-value-bind (record hash) (read-data (getf r :path))
        (plist-keys record '(:kind :version :capability :status :source-head :source-tree :manifest-sha256 :backend :conditions))
        (unless (and (eq (getf record :kind) :vttest-capability) (eql (getf record :version) 1)
                     (eq (getf record :status) :ready)
                     (equal (getf record :capability) (getf r :capability))
                     (equal (getf record :source-head) head) (equal (getf record :source-tree) tree)
                     (equal (getf record :manifest-sha256) manifest-hash)
                     (equal (getf record :backend) (getf m :backend))
                     (equal (getf record :conditions) (getf m :conditions)))
          (refuse :capability-mismatch 3))
        (list :capability (getf r :capability) :path (getf r :path) :sha256 hash :status :ready))
    (error () (refuse :capability-unavailable-or-mismatched 3))))
(defun preflight-selection (labels &optional filter)
  "Validate exact recorder selection without loading the recorder or starting a child."
  (handler-case
      (vttest-selection:select-cases *recorders* :exact-labels labels :filter filter)
    (vttest-selection:invalid-selection () (refuse :invalid-recorder-selection))))
(load (merge-pathnames "vttest-cursor-driver.lisp" *load-truename*))
(defvar *run-context* nil)
(defun run-selected (manifest readiness)
  "Only the built-in cursor X11 driver can produce live observations."
  (declare (ignore readiness))
  (preflight-selection
   (format nil "~{~A~^,~}" (remove-duplicates
                           (mapcar (lambda (s) (getf s :recorder-label))
                                   (getf manifest :scenarios)) :test #'equal))
   (sb-ext:posix-getenv "LISPTERM_VTTEST_FILTER"))
  (unless (equal (getf manifest :native-driver) "cursor-x11-v1")
    (refuse :driver-not-integrated 3))
  (let ((labels (sb-ext:posix-getenv "LISPTERM_VTTEST_EXACT_LABELS")))
    (when (and labels (not (equal labels "cursor"))) (refuse :invalid-recorder-selection)))
  (apply #'vttest-cursor-driver:run manifest *run-context*))

(defun expected-identities (scenarios)
  (loop for s in scenarios append
    (loop for c in (getf s :captures) collect (list (getf s :id) (getf c :id)))))
(defun aggregate-observations (scenarios observations &key fixture)
  "Pure comparator integration: exact (scenario,capture) identities only.
Returns status, reasoned per-scenario records. Fixture success is :FIXTURE-PASS."
  (proper scenarios 1024) (need scenarios :empty-scenarios)
  (mapc #'validate-scenario scenarios)
  (unique-strings (mapcar (lambda (s) (getf s :id)) scenarios))
  (proper observations 65536)
  (let ((ids nil) (expected (expected-identities scenarios)) (invalid nil) (results nil))
    (dolist (o observations)
      (plist-keys o '(:scenario :capture :fresh :fixture :pixels :bytes :timing))
      (need (and (identifier-p (getf o :scenario)) (identifier-p (getf o :capture))) :observation-identity)
      (dolist (key '(:fresh :fixture)) (need (member (getf o key) '(t nil)) :boolean))
      (dolist (key '(:pixels :bytes :timing))
        (need (member (getf o key) '(:pass :fail :unverified)) :observation-status))
      (let ((id (list (getf o :scenario) (getf o :capture))))
        (when (or (member id ids :test #'equal) (not (member id expected :test #'equal))) (setf invalid t))
        (push id ids)))
    (dolist (s scenarios)
      (let ((state :pass) (reasons nil))
        (dolist (c (getf s :captures))
          (let ((o (find (list (getf s :id) (getf c :id)) observations :test #'equal
                         :key (lambda (o) (list (getf o :scenario) (getf o :capture))))))
            (cond
              ((null o) (push :missing-observation reasons) (unless (eq state :fail) (setf state :unverified)))
              (t
               (let ((statuses (cons (getf o :pixels)
                                     (append (when (getf s :bytes) (list (getf o :bytes)))
                                             (when (getf s :timing) (list (getf o :timing)))))))
                 (cond ((member :fail statuses) (setf state :fail) (push :comparison-failed reasons))
                       ((or (not (getf o :fresh)) (and (getf o :fixture) (not fixture))
                            (and fixture (not (getf o :fixture))) (member :unverified statuses))
                        (unless (eq state :fail) (setf state :unverified)) (push :incomplete-or-nonlive reasons))))))))
        (when invalid (unless (eq state :fail) (setf state :unverified)) (push :identity-mismatch reasons))
        (push (list :id (getf s :id) :status state :reasons (or (remove-duplicates reasons) '(:complete))) results)))
    (let ((states (mapcar (lambda (r) (getf r :status)) results)))
      (values (cond ((member :fail states) :fail) ((member :unverified states) :unverified)
                    (fixture :fixture-pass) (t :pass)) (nreverse results)))))

(defun new-run-directory ()
  ;; Pin the evidence parent; refuse symlinks, and never repair existing modes.
  (dolist (path '(".build" ".build/evidence" ".build/evidence/vttest-area-runs"))
    (handler-case (sb-posix:mkdir path #o700)
      (sb-posix:syscall-error (e) (unless (= (sb-posix:syscall-errno e) sb-posix:eexist) (error e))))
    (let ((s (sb-posix:lstat path)))
      (unless (sb-posix:s-isdir (sb-posix:stat-mode s)) (refuse :unsafe-result-parent 3))))
  (concatenate 'string (sb-posix:mkdtemp ".build/evidence/vttest-area-runs/run-XXXXXX") "/"))
(defun write-result (directory result)
  (let* ((*print-readably* t) (*print-pretty* nil) (*print-circle* nil)
         (text (with-output-to-string (s) (write result :stream s) (terpri s)))
         (tmp (concatenate 'string directory "RESULT.pending"))
         (target (concatenate 'string directory "RESULT.sexp")))
    (need (<= (length text) +limit+) :result-oversize)
    (with-open-file (s tmp :direction :output :if-exists :error :if-does-not-exist :create)
      (write-string text s) (finish-output s))
    ;; link is atomic and fails if the target exists, unlike rename overwrite.
    (sb-posix:link tmp target) (sb-posix:unlink tmp) target))
(defun main (args)
  (let ((directory nil) (area nil) (backend nil) (path nil) (hash nil) (head nil) (tree nil)
         (manifest nil) (readiness nil) (count nil) (exit 3) (reason :internal-error)
         (observations nil) (scenario-results nil) (outcome :unverified) (driver-evidence nil))
    (handler-case
        (progn
          (setf directory (new-run-directory))
          (multiple-value-setq (head tree) (source-bindings))
          (multiple-value-setq (area backend path) (parse-cli args))
            ;; Explicit selectors must refuse before documentary scope or readiness.
            (when (sb-ext:posix-getenv "LISPTERM_VTTEST_EXACT_LABELS")
              (preflight-selection (sb-ext:posix-getenv "LISPTERM_VTTEST_EXACT_LABELS")
                                   (sb-ext:posix-getenv "LISPTERM_VTTEST_FILTER")))
          (multiple-value-setq (manifest hash) (read-data path))
          (validate-manifest manifest area backend)
          (setf count (getf manifest :required-count))
          (if (getf manifest :native-driver)
              (vttest-cursor-driver:validate manifest)
              (dolist (s (getf manifest :scenarios))
                (dolist (r (getf s :requires))
                  (push (capability-ready r manifest hash head tree) readiness))))
          (let ((*run-context* (list directory path hash head tree)))
            (multiple-value-setq (observations driver-evidence readiness)
              (run-selected manifest readiness)))
          (multiple-value-setq (outcome scenario-results)
            (aggregate-observations (getf manifest :scenarios) observations))
          (setf exit (if (eq outcome :pass) 0 (if (eq outcome :fail) 1 3))
                reason (if (eq outcome :pass) :complete :incomplete-or-failed)))
      (gate-problem (e) (setf exit (problem-code e) reason (problem-reason e)))
      (error (e) (format *error-output* "vttest-area input/IO condition: ~a~%" e)
        (setf exit 2 reason :invalid-input-or-io)))
    (let ((result (list :kind :vttest-area-result :version 1 :gate :vttest-area
                        :area area :backend backend :manifest-path path :manifest-sha256 hash
                        :source-head head :source-tree tree :required-count count
                        :observed-count (when observations (length observations))
                        :passed-count (when observations (count :pass observations :key (lambda (o) (getf o :pixels))))
                        :failed-count (when observations (count :fail observations :key (lambda (o) (getf o :pixels))))
                        :unverified-count (when observations (count :unverified observations :key (lambda (o) (getf o :pixels))))
                        :scenarios (or scenario-results (when count
                                     (mapcar (lambda (s) (list :id (getf s :id) :status :unverified :reasons (list reason)))
                                             (getf manifest :scenarios))))
                        :driver-evidence driver-evidence
                        :readiness (nreverse readiness) :outcome outcome :reason reason :exit exit :fixture nil)))
      (handler-case
          (if directory
              (format t "RESULT ~A~%" (write-result directory result))
              (progn (format *error-output* "No result directory was created.~%") (setf exit 3)))
        (error (e) (format *error-output* "Result could not be written: ~A~%" e) (setf exit 3)))
      (if (and (zerop exit) (eq outcome :pass))
          (format t "vttest-area: PASS ~d/~d fresh non-fixture observations~%" (length observations) count)
          (format *error-output* "vttest-area: ~A~%" reason)) exit)))

;; The dispatcher sets an entry marker because SBCL removes the script path
;; from *POSIX-ARGV*. Ordinary LOAD has no CLI side effects.
(when (equal (sb-ext:posix-getenv "LISPTERM_VTTEST_AREA_CLI") "1")
  (sb-posix:unsetenv "LISPTERM_VTTEST_AREA_CLI")
  (sb-ext:exit :code (main (rest sb-ext:*posix-argv*))))
