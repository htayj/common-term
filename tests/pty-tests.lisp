(defpackage #:lispterm.pty.tests (:use #:cl #:lispterm.pty))
(in-package #:lispterm.pty.tests)
(defvar *checks* 0)
(defvar *runner* (merge-pathnames "run-pty-tests.lisp" *load-truename*))
(defun check (name value)
  (incf *checks*)
  (format t "~S~%" (list :check name :pass (not (null value)))) (finish-output)
  (unless value (error "Check ~A failed" name)))
(defun raises (type thunk) (handler-case (progn (funcall thunk) nil)
                           (error (e) (typep e type))))
(defun collect-until (pty marker &optional (timeout 5))
  (let ((deadline (+ (get-internal-real-time) (* timeout internal-time-units-per-second)))
        (text ""))
    (loop for data = (pty-read pty :timeout 0.05)
          do (when (and data (not (eq data :eof)))
               (setf text (concatenate 'string text (sb-ext:octets-to-string data :external-format :latin-1))))
          when (or (search marker text) (eq data :eof) (> (get-internal-real-time) deadline)) return text)))
(defun bytes (string) (sb-ext:string-to-octets string :external-format :utf-8))
(defun fd-count ()
  (let ((dir (sb-posix:opendir "/proc/self/fd")) (count 0))
    (unwind-protect (loop for entry = (sb-posix:readdir dir) until (sb-alien:null-alien entry)
                         unless (member (sb-posix:dirent-name entry) '("." "..") :test #'string=)
                           do (incf count))
      (sb-posix:closedir dir)) count))
(defun attach-child ()
  ;; Closing our own controlling PTY during process teardown sends SIGHUP.
  (sb-sys:enable-interrupt sb-posix:sighup :ignore)
  (with-pty (pty :rows 39 :columns 101)
    (attach-slave-to-stdio pty :disposable t)
    (unless (and (every (lambda (fd) (= 1 (sb-unix:unix-isatty fd))) (quote (0 1 2)))
                 (= (sb-posix:getpid) (pty-foreground-process-group pty))
                 (equal (quote (39 101)) (multiple-value-list (pty-window-size pty))))
      (uiop:quit 1))
    (let* ((message "ATTACHED") (octets (bytes message)))
      (cffi:with-foreign-string (p message)
        (lispterm.pty::%write 1 p (length octets)))
      (let ((data (pty-read pty :timeout 1)))
        (uiop:quit (if (and (vectorp data) (string= message (sb-ext:octets-to-string data))) 0 1))))))
(defun disposable-run (mode &rest arguments)
  (zerop (nth-value 2
           (uiop:run-program
            (append (list "setsid" "--wait"
                          (namestring (merge-pathnames "../scripts/sbcl"
                                                       (uiop:pathname-directory-pathname *runner*)))
                          "--script" (namestring *runner*) mode)
                    arguments)
            :ignore-error-status t :output t :error-output t))))
(defun closed-stdio-child (fd)
  ;; This entire process is disposable. Keep the master across the final exec
  ;; so test -t checks inherited stdio without a last-master-close hangup.
  (let* ((shell (uiop:run-program '("sh" "-c" "command -v sh")
                                  :output '(:string :stripped t)))
         (pty (open-pty)))
    (sb-posix:close fd)
    (attach-slave-to-stdio pty :fds (list fd) :controlling-terminal nil :disposable t)
    (unless (and (= 1 (sb-unix:unix-isatty fd))
                 (zerop (logand 1 (lispterm.pty::%fcntl fd 1 0))))
      (uiop:quit 31))
    (lispterm.pty::%check (lispterm.pty::%fcntl (pty-master-fd pty) 2 0)
                         'pty-io-error :test-inherit-master)
    ;; A genuine exec, not another spawn file-action which could repair stdio.
    (lispterm.pty::%call-with-strings
     (list shell "-c" (format nil "test -t ~D" fd))
     (lambda (argv)
       (cffi:foreign-funcall "execv" :string shell :pointer argv :int)
       (error "execv failed: errno ~D" (lispterm.pty::%errno))))))
(defun detach-fork-child ()
  ;; Executed only by a fresh disposable SBCL, never the agent image. There
  ;; are no background Lisp threads; all PTY operations finish before fork.
  (check :fork-single-thread (= 1 (length (sb-thread:list-all-threads))))
  (with-pty (pty)
    (let* ((process (spawn-on-pty pty '("sh" "-c"
              "trap 'exit 77' HUP; printf READY; while IFS= read -r line; do printf 'ALIVE:%s\\n' \"$line\"; done")))
           (pid (process-pid process))
           (fd (pty-master-fd pty))
           (saver nil))
      (check :detach-parent-ready (search "READY" (collect-until pty "READY")))
      ;; Locked but quiescent copied mutexes must not be needed by detach.
      (sb-thread:with-mutex ((lispterm.pty::pty-lock pty))
        (sb-thread:with-mutex ((lispterm.pty::process-lock process))
          (sb-thread:with-mutex ((lispterm.pty::pty-cancellation-lock pty))
            (setf saver (sb-posix:fork))
            (when (zerop saver)
              (handler-case
                  (progn
                    (setf (symbol-function 'lispterm.pty::%kill)
                          (lambda (&rest args) (declare (ignore args)) (error "Detach signaled child"))
                          (symbol-function 'lispterm.pty::%waitpid)
                          (lambda (&rest args) (declare (ignore args)) (error "Detach reaped child")))
                    (check :detach-idempotent (and (detach-pty pty) (detach-pty pty)))
                    (check :detach-child-fd-closed
                           (and (= -1 (lispterm.pty::%fcntl fd 1 0))
                                (= sb-posix:ebadf (lispterm.pty::%errno))))
                    (check :detach-child-state
                           (and (not (pty-open-p pty)) (= -1 (pty-master-fd pty))
                                (null (pty-process pty)) (null (process-pid process))
                                (null (process-exit-code process))
                                (eq :detached (process-poll process))
                                (eq :detached (process-wait process :timeout 0))
                                (eq process (process-signal process sb-posix:sighup))))
                    (check :detach-child-close (close-pty pty))
                    (cffi:foreign-funcall "_exit" :int 0 :void))
                (error (condition)
                  (format *error-output* "Saver test: ~A~%" condition)
                  (finish-output *error-output*)
                  (cffi:foreign-funcall "_exit" :int 32 :void)))))))
      (let ((saver-process (lispterm.pty::%make-process :pid saver)))
        (unwind-protect
             (check :detach-saver-exit
                    (and (eq :exited (process-wait saver-process :timeout 5))
                         (zerop (process-exit-code saver-process))))
          (when (eq :running (process-status saver-process))
            (process-signal saver-process sb-posix:sigkill)
            (process-wait saver-process))))
      (check :detach-parent-ownership
             (and (pty-open-p pty) (= fd (pty-master-fd pty))
                  (eq process (pty-process pty)) (= pid (process-pid process))
                  (eq :running (process-poll process))))
      (pty-write pty (bytes (format nil "probe~%")))
      (check :detach-parent-responsive (search "ALIVE:probe" (collect-until pty "ALIVE:probe")))
      (close-pty pty)
      (check :detach-parent-reaped (not (eq :running (process-status process))))))
  (uiop:quit 0))
(defmacro with-injected-error ((name errno) &body body)
  `(let* ((symbol ,name) (original (symbol-function symbol)) (first t))
     (unwind-protect
          (progn (setf (symbol-function symbol)
                       (lambda (&rest args)
                         (if first
                             (progn (setf first nil
                                          (cffi:mem-ref (lispterm.pty::%errno-location) :int) ,errno) -1)
                             (apply original args))))
                 (prog1 (progn ,@body) (check :injected-syscall-consumed (not first))))
       (setf (symbol-function symbol) original))))
(defun run-tests ()
  (setf *checks* 0)
  (let* ((shell (uiop:run-program '("sh" "-c" "command -v sh") :output '(:string :stripped t)))
         (initial-fds (fd-count)))
    (format t "(:shell ~S :spawn :posix-spawnp :platform :linux-x86-64-glibc)~%" shell)
    (check :abi-attributes (= 336 (cffi:foreign-type-size '(:struct lispterm.pty::spawn-attributes))))
    (check :abi-actions (= 80 (cffi:foreign-type-size '(:struct lispterm.pty::spawn-actions))))
    (dolist (bad '(0 -1 65536 1.5 nil "24"))
      (check (list :invalid-rows bad) (raises 'type-error (lambda () (open-pty :rows bad))))
      (check (list :invalid-columns bad) (raises 'type-error (lambda () (open-pty :columns bad)))))
    (with-pty (pty :rows 24 :columns 80 :x-pixels 640 :y-pixels 384)
      (check :initial-winsize
             (equal '(24 80 640 384) (multiple-value-list (pty-window-size pty :pixels t))))
      (check :invalid-x-pixels (raises 'type-error (lambda () (pty-resize pty 30 100 :x-pixels 65536))))
      (check :invalid-y-pixels (raises 'type-error (lambda () (pty-resize pty 30 100 :y-pixels -1))))
      (check :winsize-after-invalid-resize
             (equal '(24 80 640 384) (multiple-value-list (pty-window-size pty :pixels t)))))
    (with-pty (pty :rows 31 :columns 97)
      (check :dimensions (equal '(31 97) (multiple-value-list (pty-window-size pty))))
      (check :unknown-pixels (equal '(31 97 0 0) (multiple-value-list (pty-window-size pty :pixels t))))
      (check :timeout (null (pty-read pty :timeout 0.01)))
      (check :refuse-rebind (raises 'stdio-rebind-refused (lambda () (attach-slave-to-stdio pty))))
      (dolist (argv (list nil (list "") (list shell (string #\Null)) '(3)))
        (check :invalid-argv (raises 'type-error (lambda () (spawn-on-pty pty argv)))))
      (check :invalid-env-nul
             (raises 'type-error (lambda () (spawn-on-pty pty (list shell) :environment (list (format nil "X=~C" #\Null))))))
      (check :invalid-env-format
             (raises 'pty-spawn-error (lambda () (spawn-on-pty pty (list shell) :environment '("oops")))))
      (let ((process (spawn-on-pty pty (list shell "-c"
        "test -t 0 && test -t 1 && test -t 2 || exit 91; printf 'TTY_OK '; stty size; printf 'PID=%s\\n' $$; trap 'printf WINCH:; stty size' WINCH; printf 'READY\\n'; while :; do IFS= read -r line; case $line in done) exit 7;; *) printf 'INPUT=%s\\n' \"$line\";; esac; done"))))
        (let ((output (collect-until pty "READY")))
          (format t "(:tty-output ~S)~%" output)
          (check :child-tty (search "TTY_OK" output))
          (check :child-size (search "31 97" output))
          (check :child-pid (search (format nil "PID=~D" (process-pid process)) output)))
        (check :foreground-group (= (process-pid process) (pty-foreground-process-group pty)))
        (check :write (= 6 (pty-write pty (bytes (format nil "hello~%")))))
        (check :input-bytes (search "INPUT=hello" (collect-until pty "INPUT=hello")))
        (pty-resize pty 43 109 :x-pixels 872 :y-pixels 688)
        ;; Bash may defer a trapped signal while its read builtin waits.
        (pty-write pty (bytes (format nil "wake~%")))
        (check :resized-size (equal '(43 109) (multiple-value-list (pty-window-size pty))))
        (check :resized-winsize
               (equal '(43 109 872 688) (multiple-value-list (pty-window-size pty :pixels t))))
        (let ((output (collect-until pty "43 109")))
          (format t "(:winch-output ~S)~%" output)
          (check :sigwinch (and (search "WINCH:" output) (search "43 109" output))))
        (pty-write pty (bytes (format nil "done~%")))
        (check :wait-exit (eq :exited (process-wait process)))
        (check :exit-code (= 7 (process-exit-code process)))
        (loop repeat 20 for data = (pty-read pty :timeout 0.05)
              when (eq data :eof) do (check :eof-eio t) (return)
              finally (check :eof-eio nil))
        (check :poll-idempotent (eq :exited (process-poll process)))
        (check :closed-twice (and (close-pty pty) (close-pty pty)))
        (check :closed-read (raises 'pty-closed-error (lambda () (pty-read pty))))))
    (with-pty (pty)
      (check :spawn-error (raises 'pty-spawn-error
                           (lambda () (spawn-on-pty pty '("/definitely/missing/lispterm"))))))
    (with-pty (pty)
      (let ((p (spawn-on-pty pty (list shell "-c" "printf '%s:%s' \"$PROBE\" \"$PWD\"; exit 0")
                             :environment '("PROBE=exact value") :directory "/")))
        (check :environment-directory (search "exact value:/" (collect-until pty "exact value:/")))
        (check :environment-exit (eq :exited (process-wait p)))))
    (with-pty (pty)
      (let ((p (spawn-on-pty pty (list shell "-c" "trap '' HUP; printf READY; while :; do :; done"))))
        (check :terminate-ready (search "READY" (collect-until pty "READY")))
        (check :wait-timeout (null (process-wait p :timeout 0.01)))
        (close-pty pty :terminate t :timeout 0.05)
        (check :kill-reaped (and (eq :signaled (process-status p)) (= 137 (process-exit-code p))))
        (cffi:with-foreign-object (status :int)
          (check :no-zombie (and (= -1 (lispterm.pty::%waitpid (process-pid p) status sb-posix:wnohang))
                                 (= sb-posix:echild (lispterm.pty::%errno)))))))
    (with-pty (pty)
      (spawn-on-pty pty (list shell "-c" "stty raw -echo; printf READY; exec cat"))
      (check :raw-ready (search "READY" (collect-until pty "READY")))
      (let ((payload (make-array 256 :element-type (quote (unsigned-byte 8)))))
        (dotimes (i 256) (setf (aref payload i) i))
        (dolist (errno (list sb-posix:eintr sb-posix:eagain))
          (with-injected-error ((quote lispterm.pty::%write) errno)
            (check :write-retry (= 256 (pty-write pty payload))))
          (with-injected-error ((quote lispterm.pty::%read) errno)
            (check :binary-read-retry (equalp payload (pty-read pty :timeout 1)))))
        (with-injected-error ((quote lispterm.pty::%poll) sb-posix:eintr)
          (check :poll-retry-timeout (null (pty-read pty :timeout 0.01))))))
    (with-pty (pty)
      (spawn-on-pty pty (list shell "-c" "stty raw -echo; printf BLOCKED; while :; do :; done"))
      (check :backpressure-ready (search "BLOCKED" (collect-until pty "BLOCKED")))
      (let* ((payload (make-array (* 1024 1024) :element-type (quote (unsigned-byte 8)) :initial-element 65))
             (start (get-internal-real-time))
             (written (pty-write pty payload))
             (elapsed (/ (- (get-internal-real-time) start) internal-time-units-per-second)))
        (format t "(:backpressure :written ~D :seconds ~F)~%" written elapsed)
        (check :partial-write (< 0 written (length payload)))
        (check :bounded-write (< elapsed 3))))
    (let* ((pty (open-pty))
           (reader (sb-thread:make-thread (lambda () (pty-read pty :timeout 30)) :name "close-read-test")))
      (unwind-protect
           (progn (sleep 0.1)
                  (let ((start (get-internal-real-time)))
                    (close-pty pty)
                    (check :close-unblocks-read
                           (eq :eof (sb-thread:join-thread reader :timeout 1 :default :timeout)))
                    (check :close-bounded
                           (< (/ (- (get-internal-real-time) start) internal-time-units-per-second) 1))))
        (close-pty pty)))
    (dotimes (i 20)
      (with-pty (pty) (let ((p (spawn-on-pty pty (list shell "-c" "exit 0"))))
                       (process-wait p))))
    (check :fd-cleanup (= initial-fds (fd-count)))
    (check :disposable-attach (disposable-run "--attach-child"))
    (dolist (fd '(0 1 2))
      (check (list :closed-stdio-exec fd)
             (disposable-run "--closed-stdio-child" (write-to-string fd))))
    (check :disposable-fork-detach (disposable-run "--detach-fork-child"))
    (format t "(:pty-tests :passed :checks ~D)~%" *checks*)
    (uiop:quit 0)))
