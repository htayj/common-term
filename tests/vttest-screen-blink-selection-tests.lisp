;;;; Pure blink selection replay tests. Standalone: sbcl --non-interactive --load this file.
(load (merge-pathnames "vttest-screen-blink-selection.lisp" *load-truename*))
(defpackage #:vttest-screen-blink-selection-tests
  (:use #:cl #:vttest-screen-blink-selection #:vttest-screen-blink-timing))
(in-package #:vttest-screen-blink-selection-tests)

(defvar *checks* 0)
(defun check (name value)
  (incf *checks*)
  (format t "~S~%" (list :check name :pass (not (null value))))
  (unless value (error "Blink selection check failed: ~S" name)))

(defun gen (g &key (step 1/2) (epoch-at 10) (previous nil))
  "Status of lifetime toggle G, STEP apart, toggle 0 at EPOCH-AT."
  (list :id 1 :frames (+ 10 g) :bytes-received 500 :blink-phase (evenp g)
        :blink-visible t :blink-epoch 3 :blink-epoch-at epoch-at :blink-toggles g
        :blink-toggled-at (+ 10 (* g step))
        :blink-previous-at (or previous (+ 10 (* (1- g) step))) :blink-toggle-frame (+ 10 g)))
(defun with (status &rest pairs)
  (let ((copy (copy-list status)))
    (loop for (k v) on pairs by #'cddr do (setf (getf copy k) v))
    copy))
(defun circular (&rest items) (let ((l (copy-list items))) (setf (cdr (last l)) l) l))

(defun selected (polls wanted &optional (target 500))
  (nth-value 0 (validate-blink-selection polls wanted target)))
(defun errors (polls wanted &optional (target 500))
  (nth-value 1 (validate-blink-selection polls wanted target)))
(defun refused-p (polls wanted error &optional (target 500))
  (member error (errors polls wanted target) :test #'equal))

(defparameter *stale* (gen 2 :epoch-at 111/10) "Previous epoch's last toggle.")
(defparameter *fresh* (gen 3 :epoch-at 111/10 :previous 111/10) "First in-epoch toggle.")

(defun shape-tests ()
  (check :id-scalar (and (well-formed-p (gen 1)) (well-formed-p (with (gen 1) :id "pty-1"))
                         (well-formed-p (with (gen 1) :id :pty))))
  (check :id-list-refused (not (well-formed-p (with (gen 1) :id '(1 2)))))
  (check :id-circular-refused (not (well-formed-p (with (gen 1) :id (circular 1)))))
  (check :status-circular-refused (not (well-formed-p (circular :id 1))))
  (check :status-dotted-refused (not (well-formed-p (list* :id 1 :frames 2))))
  (check :chain-statuses-42 (equal '((:statuses-malformed)) (getf (chain-report 42) :errors)))
  (check :chain-circular (not (getf (chain-report (circular (gen 1) (gen 2))) :valid)))
  (check :chain-circular-id (not (getf (chain-report (list (with (gen 1) :id (circular 1)))) :valid)))
  (check :polls-atom (equal '(:polls-malformed) (errors 42 nil)))
  (check :polls-dotted (equal '(:polls-malformed) (errors (list* (gen 2) (gen 3) 7) nil)))
  (check :polls-circular (equal '(:polls-malformed) (errors (circular (gen 2) (gen 3)) nil)))
  (check :poll-circular-id (refused-p (list (gen 2) (with (gen 3) :id (circular 1))) nil '(:malformed 1)))
  (check :wanted-checked (equal '(:wanted) (errors (list (gen 2) (gen 3)) :hidden))))

(defun order-tests ()
  (check :precedes-or-equal (and (precedes-or-equal-p (gen 2) (gen 3))
                                 (precedes-or-equal-p (gen 2) (gen 2))
                                 (not (precedes-or-equal-p (gen 3) (gen 2)))))
  (check :two-four-three (refused-p (list (gen 2) (gen 4) (gen 3)) nil '(:order 2)))
  (check :same-generation-changed
         (refused-p (list (gen 2) (with (gen 2) :blink-toggled-at 23/2)) nil '(:order 1)))
  (check :decreasing-frame
         (refused-p (list (with (gen 2) :frames 20) (with (gen 2) :frames 19)) nil '(:order 1)))
  (check :toggle-frame-not-later
         (refused-p (list (gen 2) (with (gen 3) :blink-toggle-frame 12)) nil '(:order 1)))
  (dolist (case '((:blink-epoch 4) (:blink-epoch-at 21/2) (:id 2) (:bytes-received 501)))
    (check (list :source-changed (first case))
           (refused-p (list (gen 2) (apply #'with (gen 3) case)) nil '(:source-changed 1)))))

(defun gens-stale () (list (gen 2 :epoch-at 111/10) (gen 3 :epoch-at 111/10)))
(defun selection-tests ()
  (check :fresh-hidden (equal (gen 3) (selected (list (gen 2) (gen 3)) nil)))
  (check :fresh-visible-after-hidden (equal (gen 4) (selected (list (gen 2) (gen 2) (gen 3) (gen 4)) t)))
  (check :any-first-fresh (equal (gen 3) (selected (list (gen 2) (gen 3)) :any)))
  (check :initial-never-selected (equal '(:incomplete) (errors (list (gen 2) (gen 2)) t)))
  (check :incomplete-hidden-passed (equal '(:incomplete) (errors (list (gen 2) (gen 3)) t)))
  (check :appended (refused-p (list (gen 2) (gen 3) (gen 4)) nil '(:appended 1)))
  (check :appended-same-generation (refused-p (list (gen 2) (gen 3) (gen 3)) :any '(:appended 1)))
  (check :wrong-target (refused-p (list (gen 2) (gen 3)) nil :target-mismatch 501))
  (check :visibility-lost (refused-p (list (gen 2) (with (gen 3) :blink-visible nil)) nil '(:not-visible 1)))
  (check :stale-first-then-fresh (equal *fresh* (selected (list *stale* *fresh*) nil)))
  (check :repeated-stale-prefix-then-fresh
         (equal *fresh* (selected (list *stale* *stale* (with *stale* :frames 12) *fresh*) :any)))
  (check :stale-prefix-incomplete (equal '(:incomplete) (errors (list *stale* *stale*) :any)))
  (check :stale-fresh-refused (refused-p (gens-stale) nil '(:stale-toggle 1)))
  (check :stale-after-current-refused
         (refused-p (list *stale* *fresh* (with (gen 4 :epoch-at 111/10) :blink-previous-at 11)) t
                    '(:stale-toggle 2))))

(defun link-tests ()
  (check :ready-linked (ready-linked-p (gen 3) (with (gen 3) :frames 20)))
  (check :toggle-before-ready (not (ready-linked-p (gen 3) (gen 4))))
  (check :ready-frames-earlier (not (ready-linked-p (gen 3) (with (gen 3) :frames 12))))
  (check :ready-id-changed (not (ready-linked-p (gen 3) (with (gen 3) :id 2))))
  (let ((record (blink-selection-record 13 nil 500 (list (gen 2) (gen 3))))
        (ready (with (gen 3) :frames 14)))
    (flet ((replay (&key (record record) (pause 13) (ready ready) (target 500))
             (multiple-value-list (validate-selection-record record pause ready target))))
      (check :record-keys (equal *selection-record-keys* (record-keys record)))
      (check :record-valid (equal (list (gen 3) nil) (replay)))
      (check :record-wrong-phase (equal '(nil (:phase-mismatch)) (replay :record (with record :phase t))))
      (check :record-wrong-pause (equal '(nil (:pause-mismatch)) (replay :pause 14)))
      (check :record-target (equal '(nil (:target-mismatch)) (replay :target 501)))
      (check :record-extra-key (equal '(nil (:selection-keys)) (replay :record (append record '(:x 1)))))
      (check :record-atom (equal '(nil (:selection-keys)) (replay :record 42)))
      (check :record-polls-42 (equal '(nil ((:selection :polls-malformed)))
                                     (replay :record (with record :polls 42))))
      (check :record-ready-toggled (equal '(nil (:ready-not-linked)) (replay :ready (gen 4))))
      (check :record-ready-circular (equal '(nil (:ready-malformed)) (replay :ready (circular :id 1)))))))

(shape-tests)
(order-tests)
(selection-tests)
(link-tests)
(format t "~S~%" (list :blink-selection-tests :passed *checks*))
