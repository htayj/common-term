;;;; Mock-only timing controls: synthetic proof records and PNG headers.
;;;; Never native, pixel or acceptance proof.
(in-package :vttest-keyboard-driver-tests)
(load (merge-pathnames "vttest-keyboard-timing-fixtures.lisp" *load-truename*))

(defun mock-png (path w h)
  (with-open-file (s path :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
    (flet ((u32 (n) (loop for shift from 24 downto 0 by 8 do (write-byte (ldb (byte 8 shift) n) s))))
      (write-sequence #(137 80 78 71 13 10 26 10) s) (u32 13)
      (write-sequence (map 'vector #'char-code "IHDR") s) (u32 w) (u32 h))))

(defun mock-status (frames bytes)
  (list :columns 80 :rows 24 :pty-columns 80 :pty-rows 24 :backend :x11 :error-count 0
        :input-pending 0 :frames frames :bytes-received bytes :engine-geometry-generation 0
        :geometry (list :request-id nil :phase :idle :epoch 3 :display-epoch 1 :metric-generation 2
                        :presentation 10 :target-presentation nil :cell-width 8 :cell-height 16
                        :columns 80 :rows 24 :actual-width 640 :actual-height 384)))

(defun mock-external (scale)
  (list :recorder-version 3 :scale scale :logical-width 640 :logical-height 384 :pixel-width 640
        :pixel-height 384 :output-width 1280 :output-height 800 :x 0 :y 0 :output-x 0 :output-y 0))

(defun mock-proofs (root)
  (let ((dir (c::cat root "recorder/")))
    (dolist (label '("keyboard-cursor" "keyboard-keypad") root)
      (let ((events (k::events-of label dir)))
        (dolist (e events)
          (when (eq (getf e :kind) :capture)
            (let* ((name (getf e :name)) (target (getf e :out)) (ready (mock-status 2 target))
                   (barrier (list :recorder-version 3 :desired-scale 1 :target-output target
                                  :before-frame 1 :before-status (mock-status 1 target)
                                  :status ready :native-ack-output -1)))
              (flet ((p (suffix) (c::cat dir name suffix)))
                (c:write-value (p ".status.sexp") ready)
                (c:write-value (p ".barrier.sexp") barrier)
                (c:write-value (p ".final-status.sexp") ready)
                (c:write-value (p ".external.sexp") (mock-external 1))
                (put-bytes (p ".grid.txt") "Push <RETURN>")
                (mock-png (p ".png") 640 384))
              (nconc e (list :barrier barrier)))))
        (save-events (c::cat dir label ".events.sexp") events)))))

(defun timing-of (root label &optional (scale k::+timing-scale+))
  (let ((dir (c::cat root "recorder/")))
    (k::case-timing label dir (k::case-bytes label dir) scale)))

(defun edit-events (root label fn)
  (let ((dir (c::cat root "recorder/")))
    (save-events (c::cat dir label ".events.sexp")
                 (loop for e in (funcall fn (k::events-of label dir)) for n from 1
                       collect (let ((c (copy-list e)))
                                 (setf (getf c :seq) n (getf c :time) (/ n 100)) c)))))

(defun move-event (events from to)
  (let* ((e (nth from events)) (rest (remove e events :test #'eq)))
    (append (subseq rest 0 to) (list e) (subseq rest to))))

(defun first-capture (events) (position :capture events :key (lambda (e) (getf e :kind))))

(defun edit-cursor (fn) (lambda (r) (edit-events r "keyboard-cursor" fn)))
(defun shift-first (delta)
  (edit-cursor (lambda (es) (let ((i (first-capture es))) (move-event es i (+ i delta))))))

(defun expect-timing (root state label &optional reason)
  (multiple-value-bind (s reasons) (timing-of root "keyboard-cursor")
    (check (and (eq s state) (or (null reason) (search reason (format nil "~s" reasons))))
           (list :timing label))))

(defun mutated (label fn &rest recorder-args)
  (let ((root (timed-root (apply #'recorder recorder-args))))
    (when fn (funcall fn root))
    (check (or (not (eq :fail (timing-of root "keyboard-cursor")))
               (nth-value 1 (mock-evidence root)))
           (list :native-evidence-fails label))
    root))

(defun timing-controls ()
  (let* ((root (timed-root (recorder))) (m (k:make-manifest "x11")))
    (dolist (label '("keyboard-cursor" "keyboard-keypad"))
      (check (eq :pass (timing-of root label)) (list label :mock-timing-flow)))
    (check (eq :fail (timing-of root "keyboard-cursor" 2)) :scale-mismatch)
    (multiple-value-bind (checks failed) (mock-evidence root)
      (check (and (not failed) (= 26 (length checks)) (eq :pass (k::timing-aggregate checks))
                  (every (lambda (k) (and (eq :pass (getf k :timing)) (eq :unverified (getf k :pixels)))) checks))
             :native-evidence-linked-timing)
      (let ((record (list :kind :vttest-keyboard-native :version 1 :backend "x11"
                          :manifest-sha256 (make-string 64 :initial-element (code-char 97))
                          :status :incomplete :checks checks)))
        (multiple-value-bind (obs evidence) (k:summarize-native m record 3 root)
          (check (and (every (lambda (o) (and (eq :pass (getf o :timing)) (eq :unverified (getf o :pixels)))) obs)
                      (= 26 (getf (getf evidence :counts) :unverified))
                      (zerop (getf (getf evidence :counts) :passed)))
                 :summary-timing-pass-pixels-unverified))
        (check (notany (lambda (o) (eq :pass (getf o :timing))) (k:summarize-native m record 3))
               :receipt-pass-needs-recomputed-proof)
        (let ((bad (copy-tree record)))
          (setf (getf (first (getf bad :checks)) :name) "999-keyboard-cursor-keys0-up")
          (check (eq :fail (getf (first (k:summarize-native m bad 3 root)) :timing)) :unlinked-receipt-name))
        (let ((bad (copy-tree record)))
          (setf (getf (first (getf bad :checks)) :timing) :unverified)
          (check (eq :unverified (getf (first (k:summarize-native m bad 3 root)) :timing))
                 :receipt-claim-required)))))
  (let ((root (mutated :before-own-key-end (shift-first -1))))
    (check (eq :pass (k::case-bytes "keyboard-cursor" (c::cat root "recorder/"))) :reorder-bytes-pass)
    (expect-timing root :fail :before-own-key-end "CAPTURE-ORDER"))
  (expect-timing (mutated :after-next-key-begin (shift-first 1))
                 :fail :after-next-key-begin "CAPTURE-ORDER")
  (expect-timing (mutated :foreign-name
                          (edit-cursor (lambda (es) (let ((e (nth (first-capture es) es)))
                                                     (setf (getf e :name) "001-keyboard-keypad-keys0-up") es))))
                 :fail :foreign-name "CAPTURE-ORDER")
  (expect-timing (mutated :missing-name
                          (edit-cursor (lambda (es) (remf (nth (first-capture es) es) :name) es)))
                 :fail :missing-name)
  (expect-timing (mutated :duplicate-name nil :cursor '(:duplicate t)) :fail :duplicate-name "CAPTURE-ORDER")
  (expect-timing (mutated :wrong-key-bytes nil :cursor (list :wrong (c::esc "[A"))) :fail :wrong-key-bytes "BYTES")
  (expect-timing (mutated :clock-regression
                          (lambda (r) (let* ((p (c::cat r "recorder/keyboard-cursor.events.sexp"))
                                            (es (k::events-of "keyboard-cursor" (c::cat r "recorder/"))))
                                       (setf (getf (nth 6 es) :time) 0) (save-events p es))))
                 :fail :clock-regression "BYTES")
  (flet ((proof (suffix) (let ((root (mock-proofs (recorder))))
                           (values root (c::cat root "recorder/001-keyboard-cursor-keys0-up" suffix)))))
    (multiple-value-bind (root path) (proof ".external.sexp")
      (c:write-value path (mock-external 2))
      (expect-timing root :fail :external-scale "Wrong capture geometry"))
    (multiple-value-bind (root path) (proof ".barrier.sexp")
      (let ((barrier (c:read-value path)))
        (setf (getf barrier :before-frame) 2)
        (c:write-value path barrier))
      (expect-timing root :fail :unlinked-barrier "Wrong capture geometry"))
    (multiple-value-bind (root path) (proof ".external.sexp")
      (sb-posix:unlink path)
      (expect-timing root :unverified :missing-external))))
