;;;; Standalone acceptance: --endpoint wayland-1 (Sway IPC close and mapping),
;;;; --no-ipc --endpoint wayland-1 [--dma-trace FRESH-PATH] (SIGHUP to the owned
;;;; PTY shell, no SWAYSOCK and no mapping receipt), or --offline-controls.
;;;; No application/display is opened by the offline controls.
(load (merge-pathnames "../scripts/bootstrap.lisp" *load-truename*))
(require :sb-posix)
(defpackage #:lispterm.real-launch-test (:use #:cl))
(in-package #:lispterm.real-launch-test)
(defparameter *root*
  (truename (merge-pathnames "../" (uiop:pathname-directory-pathname *load-truename*))))
(defvar *evidence*)
(defvar *owned* nil)
(defvar *samples* 0)
(defparameter *close-seconds* 8 "Seconds allowed for a graceful owned close.")
(defun now () (/ (get-internal-real-time) internal-time-units-per-second))
(defun record (name value)
  (with-open-file (out (merge-pathnames name *evidence*) :direction :output
                       :if-exists :supersede :if-does-not-exist :create)
    (let ((*print-readably* t)) (write value :stream out) (terpri out))))
(defun fields (pid)
  (let ((text (ignore-errors (uiop:read-file-string (format nil "/proc/~D/stat" pid)))))
    (when text
      (remove "" (uiop:split-string (subseq text (1+ (position #\) text :from-end t))))
              :test #'equal))))
(defun process-identity (pid) (let ((f (fields pid))) (and f (list pid (nth 19 f)))))
(defun live (id)
  (let ((f (and id (fields (first id)))))
    (and f (equal (second id) (nth 19 f)) (string/= "Z" (first f)))))
(defun remember (pid)
  (let ((id (process-identity pid)))
    (when (and id (not (member id *owned* :test #'equal)))
      (push id *owned*)
      (record "owned.sexp" *owned*))
    id))
(defun task-children (path)
  (let ((text (ignore-errors (uiop:read-file-string path))))
    (loop for word in (and text (uiop:split-string text))
          for pid = (parse-integer word :junk-allowed t) when pid collect pid)))
(defun discover ()
  ;; Linux children lists are per-thread. The window owner, not the leader,
  ;; spawns the real PTY. Enumerate tasks only inside authenticated owned PIDs.
  (dolist (id (copy-list *owned*))
    (when (live id)
      (dolist (task (ignore-errors
                      (uiop:subdirectories (format nil "/proc/~D/task/" (first id)))))
        (when (live id)
          (dolist (pid (task-children (merge-pathnames "children" task)))
            (let ((f (fields pid)))
              (when (and (live id) f (= (parse-integer (second f)) (first id)))
                (remember pid)))))))))
(defun proc-link (pid name)
  (ignore-errors (sb-posix:readlink (format nil "/proc/~D/~A" pid name))))
(defun pty-shell-facts (launcher child)
  "Authenticate a direct session-leading PTY child, not a startup helper."
  (let* ((pid (first child)) (f (fields pid))
         (tty (proc-link pid "fd/0"))
         (exe (proc-link (first launcher) "exe")))
    (when (and (live launcher) (live child) f
               exe (search "sbcl" (file-namestring exe))
               (= (parse-integer (second f)) (first launcher))
               (= (parse-integer (nth 3 f)) pid)
               (not (zerop (parse-integer (nth 4 f))))
               tty (uiop:string-prefix-p "/dev/pts/" tty)
               (every (lambda (fd) (equal tty (proc-link pid (format nil "fd/~D" fd)))) '(1 2)))
      (list :identity child :parent launcher :session pid
            :controlling-tty-number (nth 4 f) :stdio-pty tty :stdio-fds '(0 1 2)
            :executable (proc-link pid "exe")))))
(defun require-pty-shell (launcher)
  (discover)
  (or (loop for child in *owned* for facts = (pty-shell-facts launcher child)
            when facts return facts)
      (error "No live authenticated direct PTY shell of the owned SBCL launcher")))

(defun parse-json (text)
  ;; Parse in memory: never retain the compositor's unrelated window metadata.
  (let ((i 0) (n (length text)))
    (labels ((peek () (and (< i n) (char text i)))
             (take () (prog1 (or (peek) (error "Truncated JSON")) (incf i)))
             (space* () (loop while (and (peek) (find (peek) '(#\Space #\Tab #\Newline #\Return))) do (incf i)))
             (expect (c) (unless (eql c (take)) (error "Invalid JSON")))
             (string* ()
               (expect #\")
               (with-output-to-string (out)
                 (loop for c = (take) until (eql c #\") do
                   (write-char
                    (if (eql c #\\)
                        (let ((e (take)))
                          (case e
                            (#\u (let ((v (parse-integer text :start i :end (+ i 4) :radix 16)))
                                    (incf i 4) (or (code-char v) #\?)))
                            (#\n #\Newline) (#\r #\Return) (#\t #\Tab)
                            (#\b #\Backspace) (#\f #\Page)
                            (otherwise e))) c) out))))
             (value* ()
               (space*)
               (case (peek)
                 (#\" (string*))
                 (#\{ (incf i)
                   (let ((table (make-hash-table :test #'equal)))
                     (space*)
                     (unless (eql (peek) #\})
                       (loop (space*) (let ((key (string*))) (space*) (expect #\:)
                                        (setf (gethash key table) (value*)))
                             (space*) (unless (eql (peek) #\,) (return)) (incf i)))
                     (expect #\}) table))
                 (#\[ (incf i)
                   (let ((items nil))
                     (space*)
                     (unless (eql (peek) #\])
                       (loop (push (value*) items) (space*)
                             (unless (eql (peek) #\,) (return)) (incf i)))
                     (expect #\]) (nreverse items)))
                 (otherwise
                  (let ((start i))
                    (loop while (and (peek) (not (find (peek) '(#\, #\] #\} #\Space #\Tab #\Return #\Newline)))) do (incf i))
                    (let ((word (subseq text start i)))
                      (cond ((equal word "true") t) ((member word '("false" "null") :test #'equal) nil)
                            (t (unless (and (plusp (length word))
                                            (every (lambda (c) (find c "0123456789+-.eE")) word))
                                 (error "Invalid JSON number"))
                               (let ((*read-eval* nil)) (read-from-string word))))))))))
      (prog1 (value*) (space*) (unless (= i n) (error "Trailing JSON"))))))
(defun mapping-metadata (tree pid)
  (let ((matches nil))
    (labels ((walk (node)
               (when (hash-table-p node)
                 (when (eql pid (gethash "pid" node))
                   (let ((rect (gethash "rect" node)))
                     (when (and (equal "xdg_shell" (gethash "shell" node))
                                (hash-table-p rect)
                                (plusp (gethash "width" rect 0)) (plusp (gethash "height" rect 0)))
                       (push (list :pid pid :id (gethash "id" node) :shell "xdg_shell"
                                   :width (gethash "width" rect) :height (gethash "height" rect)) matches))))
                 (dolist (key '("nodes" "floating_nodes"))
                   (dolist (child (gethash key node)) (walk child))))))
      (walk tree))
    (unless (= 1 (length matches)) (error "Expected exactly one mapped owned xdg_shell client"))
    (first matches)))
(defun owned-mapping (id name)
  (unless (live id) (error "Owned launcher is no longer live"))
  (let ((text (with-output-to-string (out)
                (let ((p (sb-ext:run-program "timeout"
                           (list "5s" "swaymsg" "-s" (uiop:getenv "SWAYSOCK") "-t" "get_tree" "-r")
                           :search t :input "/dev/null" :output out :error :stream)))
                  (unwind-protect
                       (unless (eql 0 (sb-ext:process-exit-code p)) (error "Owned Sway mapping query failed"))
                    (close (sb-ext:process-error p)))))))
    (let ((receipt (mapping-metadata (parse-json text) (first id))))
      (unless (live id) (error "Owned launcher ended during mapping query"))
      (record name (list :launcher id :sway-socket (uiop:getenv "SWAYSOCK")
                         :endpoint (uiop:getenv "WAYLAND_DISPLAY") :client receipt)) receipt)))
(defun wait-for (predicate seconds)
  (let ((end (+ (now) seconds)))
    (loop (when (funcall predicate) (return t))
          (when (>= (now) end) (return nil)) (sleep .05))))
(defun empty-file (path)
  (with-open-file (in path :element-type '(unsigned-byte 8)) (zerop (file-length in))))
(defun monitor (process id seconds errors)
  (let ((start (now)))
    (loop
      (discover) (incf *samples*)
      (unless (and (sb-ext:process-alive-p process) (live id))
        (error "Owned launcher exited after ~,3F seconds (status ~S)"
               (- (now) start) (sb-ext:process-exit-code process)))
      (unless (empty-file errors) (error "Owned launcher wrote stderr; see app.stderr"))
      (when (>= (- (now) start) seconds) (return (- (now) start)))
      (sleep .05))))
(defun command (name program args)
  (let* ((out (merge-pathnames (concatenate 'string name ".stdout") *evidence*))
         (err (merge-pathnames (concatenate 'string name ".stderr") *evidence*))
         (process (sb-ext:run-program program args :search t :wait nil :input "/dev/null"
                                     :output out :error err :if-output-exists :supersede
                                     :if-error-exists :supersede)))
    (unless (wait-for (lambda () (not (sb-ext:process-alive-p process))) 5)
      (sb-ext:process-kill process sb-posix:sigkill)
      (sb-ext:process-wait process)
      (record (concatenate 'string name ".status") :timeout)
      (error "Timed out: ~A" name))
    (sb-ext:process-wait process)
    (let ((code (sb-ext:process-exit-code process)))
      (record (concatenate 'string name ".status") code)
      (unless (eql code 0) (error "~A exited ~S" name code)))
    out))
(defun source-identity (name)
  (let* ((listing (command (concatenate 'string name "-files") "git"
                          '("ls-files" "-z" "--cached" "--others" "--exclude-standard")))
         (paths (remove "" (uiop:split-string (uiop:read-file-string listing)
                                             :separator '(#\Null)) :test #'equal)))
    (unless paths (error "Empty source inventory"))
    (command name "sha256sum" (append '("--zero" "--") paths))))
(defun cleanup (process &key no-ipc shell)
  (discover)
  (let* ((pid (sb-ext:process-pid process)) (launcher (assoc pid *owned*))
         (hangup nil) (forced nil) (clean nil) (reaped nil))
    (labels ((receipt ()
               (record "cleanup.sexp"
                       (list :graceful clean :owned *owned*
                             :survivors (remove-if-not #'live *owned*)
                             :launcher-status (sb-ext:process-status process)
                             :reaped reaped :hangup hangup :forced (reverse forced))))
             (ended ()
               ;; /proc can show Z before waitpid updates the process handle.
               ;; Wait for both facts, then process-wait is bounded by termination.
               (discover)
               (and (not (sb-ext:process-alive-p process))
                    (notany #'live *owned*))))
      (receipt)
      (unwind-protect
           (progn
             (cond (no-ipc
                    (when (and shell (pty-shell-facts launcher shell))
                      (sb-posix:kill (first shell) sb-posix:sighup)
                      (setf hangup shell)))
                   ((and (live launcher) (sb-ext:process-alive-p process))
                    (handler-case
                        (command "close" "swaymsg"
                                 (list "-s" (uiop:getenv "SWAYSOCK") (format nil "[pid=~D] kill" pid)))
                      (error (e) (record "close-error.sexp" (princ-to-string e))))))
             (receipt)
             (setf clean (and (or hangup (not no-ipc))
                              (wait-for #'ended *close-seconds*)))
             (unless clean
               ;; Every forced signal is recorded before sending and always fails.
               (dolist (signal (list sb-posix:sigterm sb-posix:sigkill))
                 (discover)
                 (dolist (id *owned*)
                   (when (live id)
                     (push (list signal id) forced)
                     (receipt)
                     (sb-posix:kill (first id) signal)))
                 (wait-for #'ended 2)))
             (unless (sb-ext:process-alive-p process)
               (sb-ext:process-wait process)
               (setf reaped t)
               (record "app.status" (sb-ext:process-exit-code process)))
             (unless reaped (error "Launcher survived owned cleanup"))
             (unless (and clean (null forced) (notany #'live *owned*)
                          (eql 0 (sb-ext:process-exit-code process)))
               (error "Owned cleanup failed or required forced termination")))
        (receipt)))))
(defun fresh-trace-path (path)
  "Production tracing appends, so only a not yet existing absolute file is exact evidence."
  (let ((slash (and (stringp path) (position #\/ path :from-end t))))
    (unless (and slash (char= #\/ (char path 0)) (< (1+ slash) (length path))
                 (not (ignore-errors (sb-posix:lstat path)))
                 (ignore-errors (sb-posix:s-isdir
                                 (sb-posix:stat-mode (sb-posix:stat (subseq path 0 (max 1 slash)))))))
      (error "--dma-trace requires a fresh absolute file path in an existing directory"))
    path))
(defun parse-arguments (arguments)
  (let ((count (length arguments)))
    (cond ((equal arguments '("--offline-controls")) (list :mode :offline))
          ((and (= 2 count) (equal "--endpoint" (first arguments)))
           (list :mode :ipc :endpoint (second arguments)))
          ((and (member count '(3 5)) (equal "--no-ipc" (first arguments))
                (equal "--endpoint" (second arguments))
                (or (= 3 count) (equal "--dma-trace" (fourth arguments))))
           (list :mode :no-ipc :endpoint (third arguments) :dma-trace (fifth arguments)))
          (t (error "Usage: --endpoint WAYLAND_DISPLAY | --no-ipc --endpoint WAYLAND_DISPLAY [--dma-trace FRESH-PATH] | --offline-controls")))))
(defun real-run (endpoint &key no-ipc dma-trace)
  (unless (and endpoint (plusp (length endpoint))
               (equal endpoint (uiop:getenv "WAYLAND_DISPLAY")))
    (error "Require explicit --endpoint matching WAYLAND_DISPLAY"))
  (unless (or no-ipc (let ((s (uiop:getenv "SWAYSOCK"))) (and s (plusp (length s)))))
    (error "SWAYSOCK is required for exact owned-client close"))
  (when no-ipc
    ;; The launcher inherits this environment; production reads the variable at load.
    (if dma-trace
        (sb-posix:setenv "LISPTERM_DMA_TRACE" (fresh-trace-path dma-trace) 1)
        (sb-posix:unsetenv "LISPTERM_DMA_TRACE")))
  (let ((before (source-identity "source-before")) (process nil) (runtime nil) (observed-shell nil)
        (primary-error nil) (cleanup-error nil)
        (errors (merge-pathnames "app.stderr" *evidence*)))
    (unwind-protect
         (handler-case
           (progn
           (setf process (sb-ext:run-program (namestring (merge-pathnames "bin/lispterm" *root*))
                                             nil :wait nil :input "/dev/null"
                                             :output (merge-pathnames "app.stdout" *evidence*)
                                             :error errors :if-output-exists :supersede
                                             :if-error-exists :supersede))
           (let ((id (remember (sb-ext:process-pid process))))
             (unless id (error "Could not authenticate owned launcher"))
             (record "launch.sexp" (append (list :endpoint endpoint :argv nil :pid (first id)
                                                 :start (second id) :required-seconds 30)
                                           (when no-ipc (list :mode :no-ipc :dma-trace dma-trace))))
             (setf runtime
                   (handler-case (monitor process id 30 errors)
                     (error (e)
                       (record "observation-error.sexp" (princ-to-string e))
                       (error e))))
             (record "monitor.sexp" (list :elapsed-seconds runtime :samples *samples*
                                            :stderr-empty (empty-file errors) :owned *owned*))
             (record "shell-candidates.sexp"
                     (loop for child in *owned* when (live child)
                           collect (list :identity child :stat (subseq (fields (first child)) 0 5)
                                         :exe (proc-link (first child) "exe")
                                         :stdio (loop for fd from 0 to 2 collect
                                                      (proc-link (first child) (format nil "fd/~D" fd))))))
              (let ((shell (require-pty-shell id)))
                (unless no-ipc (owned-mapping id "owned-mapping.sexp"))
                ;; Recheck after IPC, not merely an ever-observed descendant.
                (unless (pty-shell-facts id (getf shell :identity))
                  (error "Authenticated PTY shell ended before final observation"))
                (record "observation.sexp"
                        (append (list :elapsed-seconds runtime :samples *samples*
                                      :stderr-empty (empty-file errors) :live-pty-shell shell
                                      :host-state :not-directly-observed)
                                (when no-ipc (list :mapping :not-observed-no-ipc))))
                (setf observed-shell (getf shell :identity)))))
           (error (e)
             (setf primary-error e)
             (record "observation-error.sexp" (princ-to-string e))))
      (when process
        (handler-case (cleanup process :no-ipc no-ipc :shell observed-shell)
          (error (e)
            (setf cleanup-error e)
            (record "cleanup-error.sexp" (princ-to-string e))))))
    (when primary-error (error primary-error))
    (when cleanup-error (error cleanup-error))
    (unless (empty-file errors) (error "stderr was not empty after close"))
    (when dma-trace
      (let ((stat (ignore-errors (sb-posix:stat dma-trace))))
        (unless stat (error "Production DMA tracing did not create the requested trace"))
        (record "dma-trace.sexp" (list :path dma-trace :bytes (sb-posix:stat-size stat)))))
    (unless (equal (uiop:read-file-string before)
                   (uiop:read-file-string (source-identity "source-after")))
      (error "Acceptance source changed during run"))
    (format t "real-wayland-launch PASS~:[~; no-IPC~] observed ~,3F seconds, ~D samples; owned cleanup complete~%"
            no-ipc runtime *samples*)))
(defun fake-launcher (name shell-command &key threaded (exit-delay 0))
  "Offline SBCL with a direct PTY child, optionally spawned by a non-main owner."
  (let ((script (merge-pathnames (format nil "~A.lisp" name) *evidence*)))
    (with-open-file (out script :direction :output :if-exists :supersede)
      (format out "(load ~S)~%(asdf:load-system \"lispterm/pty\")~%(flet ((owner ()~%  (let ((pty (lispterm.pty:open-pty)))~%    (lispterm.pty:spawn-on-pty pty '(\"/bin/sh\" \"-c\" ~S))~%    (loop while (eq :running (lispterm.pty:process-poll (lispterm.pty:pty-process pty)))~%          do (sleep .05))~%    (lispterm.pty:close-pty pty)~%    (sleep ~S))))~%  ~A)~%(sb-ext:exit :code 0)~%"
              (namestring (merge-pathnames "scripts/bootstrap.lisp" *root*)) shell-command exit-delay
              (if threaded "(sb-thread:join-thread (sb-thread:make-thread #'owner))" "(owner)")))
    (sb-ext:run-program (namestring (merge-pathnames "scripts/sbcl" *root*))
                        (list "--script" (namestring script)) :wait nil :input "/dev/null"
                        :output (merge-pathnames (format nil "~A.stdout" name) *evidence*)
                        :error (merge-pathnames (format nil "~A.stderr" name) *evidence*)
                        :if-output-exists :supersede :if-error-exists :supersede)))
(defun offline-controls ()
  (let ((passed 0))
    (dolist (case '(:survive :exit :stderr))
      (let* ((*owned* nil)
             (err (merge-pathnames (format nil "offline-~A.stderr" case) *evidence*))
             (process (sb-ext:run-program "sh"
                       (list "-c" (ecase case (:survive "exec sleep 5") (:exit "exit 0")
                                       (:stderr "printf problem >&2; exec sleep 5")))
                       :search t :wait nil :input "/dev/null"
                       :output (merge-pathnames (format nil "offline-~A.stdout" case) *evidence*)
                       :error err))
             (id (remember (sb-ext:process-pid process))) (accepted nil))
        (unwind-protect
             (handler-case (progn (monitor process id .3 err) (setf accepted t))
               (error () nil))
          (dolist (owned *owned*) (when (live owned) (sb-posix:kill (first owned) sb-posix:sigkill)))
          (sb-ext:process-wait process))
        (record (format nil "offline-~A.status" case) (sb-ext:process-exit-code process))
        (unless (and (eq accepted (eq case :survive)) (notany #'live *owned*))
          (error "Offline monitor/cleanup control failed: ~A" case))
        (incf passed)))
    ;; A startup helper is a descendant but has no controlling PTY/session.
    (let* ((*owned* nil)
           (process (sb-ext:run-program "sh" '("-c" "sleep 5 & wait") :search t :wait nil
                                        :input "/dev/null" :output nil :error nil))
           (id (process-identity (sb-posix:getpid))))
      (remember (sb-ext:process-pid process))
      (unwind-protect
           (progn
             (unless (wait-for (lambda () (discover) (> (length *owned*) 1)) 2)
               (error "Fake-helper control did not create its descendant"))
             (when (ignore-errors (require-pty-shell id))
               (error "Fake helper incorrectly accepted as PTY shell"))
             (record "offline-helper.sexp" (list :rejected t :owned *owned*)))
        (dolist (owned *owned*) (when (live owned) (sb-posix:kill (first owned) sb-posix:sigkill)))
        (sb-ext:process-wait process))
      (unless (notany #'live *owned*) (error "Fake helper cleanup failed"))
      (incf passed))
    (asdf:load-system "lispterm/pty")
    (let* ((*owned* nil)
           (pty (uiop:symbol-call :lispterm.pty :open-pty))
           (launcher (process-identity (sb-posix:getpid)))
           (child nil))
      (unwind-protect
           (progn
             (uiop:symbol-call :lispterm.pty :spawn-on-pty pty '("/bin/sh" "-c" "exec sleep 5"))
             (setf child (remember (uiop:symbol-call :lispterm.pty :process-pid
                                                   (uiop:symbol-call :lispterm.pty :pty-process pty))))
             (unless (wait-for (lambda () (pty-shell-facts launcher child)) 2)
               (error "Genuine direct PTY child was rejected"))
             (record "offline-pty.sexp" (require-pty-shell launcher)))
        (uiop:symbol-call :lispterm.pty :close-pty pty))
      (when (live child) (error "Offline PTY child survived cleanup"))
      (record "offline-pty-cleanup.sexp" (list :child child :live nil))
      (incf passed))
    (let* ((tree (parse-json "{\"nodes\":[{\"pid\":123,\"shell\":\"xdg_shell\",\"id\":7,\"rect\":{\"width\":800,\"height\":480}},{\"pid\":456,\"name\":\"private title\"}]}"))
           (receipt (mapping-metadata tree 123)))
      (unless (and (eql 123 (getf receipt :pid))
                   (not (search "private" (prin1-to-string receipt)))
                   (not (ignore-errors (mapping-metadata tree 456))))
        (error "Owned mapping metadata control failed"))
      (record "offline-mapping.sexp" receipt)
      (incf passed))
    ;; No-IPC close: SIGHUP to the authenticated shell alone ends the launcher with
    ;; status 0; a shell ignoring it forces the TERM/KILL fallback, which must fail.
    (dolist (case '(:hangup :ignored :threaded))
      (let* ((*owned* nil) (expected-clean (not (eq case :ignored)))
             (*close-seconds* (if expected-clean 8 1))
             (name (format nil "offline-no-ipc-~(~A~)" case))
             (*evidence* (ensure-directories-exist
                          (merge-pathnames (format nil "~A/" name) *evidence*)))
             (process (fake-launcher name (if expected-clean "exec sleep 30"
                                             "trap '' HUP; exec sleep 30")
                                     :threaded (eq case :threaded)
                                     :exit-delay (if (eq case :threaded) .3 0)))
             (id (remember (sb-ext:process-pid process))) (shell nil) (accepted nil))
        (unwind-protect
             (progn
               (unless (wait-for (lambda () (setf shell (ignore-errors (require-pty-shell id)))) 30)
                 (error "Fake no-IPC launcher produced no authenticated PTY shell"))
               (when (eq case :threaded)
                 (let ((leader-children (task-children
                                         (format nil "/proc/~D/task/~D/children" (first id) (first id)))))
                   (when (member (first (getf shell :identity)) leader-children)
                     (error "Threaded control did not reproduce the leader-only discovery omission"))
                   (record "threaded-discovery.sexp"
                           (list :leader-children leader-children :authenticated-shell shell
                                 :old-leader-only-discovery :missed))))
               (monitor process id .5 (merge-pathnames (format nil "~A.stderr" name) *evidence*))
               (record "shell.sexp" shell)
               (handler-case (progn (cleanup process :no-ipc t :shell (getf shell :identity))
                                    (setf accepted t))
                 (error (e) (record "cleanup-error.sexp" (princ-to-string e)))))
          (dolist (owned *owned*) (when (live owned) (sb-posix:kill (first owned) sb-posix:sigkill)))
          (sb-ext:process-wait process))
        (let ((receipt (with-open-file (in (merge-pathnames "cleanup.sexp" *evidence*)) (read in))))
          (unless (and (eq accepted expected-clean) (notany #'live *owned*)
                       (getf receipt :reaped)
                       (eq (getf receipt :graceful) expected-clean)
                       (equal (getf receipt :hangup) (getf shell :identity))
                       (eq (null (getf receipt :forced)) expected-clean))
            (error "Offline no-IPC close control failed: ~A" case)))
        (incf passed)))
    (let ((fresh (namestring (merge-pathnames "offline-fresh.trace" *evidence*))))
      (unless (and (equal '(:mode :ipc :endpoint "wayland-1") (parse-arguments '("--endpoint" "wayland-1")))
                   (equal '(:mode :no-ipc :endpoint "wayland-1" :dma-trace nil)
                          (parse-arguments '("--no-ipc" "--endpoint" "wayland-1")))
                   (equal (list :mode :no-ipc :endpoint "wayland-1" :dma-trace fresh)
                          (parse-arguments (list "--no-ipc" "--endpoint" "wayland-1" "--dma-trace" fresh)))
                   (equal fresh (fresh-trace-path fresh))
                   (notany (lambda (bad) (ignore-errors (parse-arguments bad)))
                           '(() ("--no-ipc") ("--no-ipc" "wayland-1") ("--endpoint" "wayland-1" "--no-ipc")
                             ("--no-ipc" "--endpoint" "wayland-1" "--dma-trace")
                             ("--no-ipc" "--endpoint" "wayland-1" "--trace" "/x")
                             ("--offline-controls" "--no-ipc")))
                   (notany (lambda (bad) (ignore-errors (fresh-trace-path bad)))
                           (list "" "relative.trace" "/" (namestring *evidence*)
                                 (namestring (merge-pathnames "missing-directory/x.trace" *evidence*))
                                 (namestring (merge-pathnames "tests/verify.sh" *root*)))))
        (error "No-IPC argument/trace-path control failed"))
      (record "offline-arguments.sexp" (list :fresh-trace fresh :rejected 13))
      (incf passed))
    (format t "real-wayland-launch offline PASS ~D monitor/cleanup controls; no display opened~%" passed)))
(let* ((arguments (uiop:command-line-arguments))
       (*evidence* (merge-pathnames
                    (format nil ".build/real-wayland-launch-~D-~D/" (get-universal-time) (sb-posix:getpid))
                    *root*)))
  (ensure-directories-exist *evidence*)
  (uiop:with-current-directory (*root*)
    (handler-case
        (progn
          (let ((plan (parse-arguments arguments)))
            (ecase (getf plan :mode)
              (:offline (source-identity "offline-source") (offline-controls))
              (:ipc (real-run (getf plan :endpoint)))
              (:no-ipc (real-run (getf plan :endpoint) :no-ipc t
                                 :dma-trace (getf plan :dma-trace)))))
          (record "result.sexp" '(:pass t))
          (sb-ext:exit :code 0))
      (error (e)
        (record "result.sexp" (list :pass nil :error (princ-to-string e)))
        (format *error-output* "real-wayland-launch FAIL: ~A~%Evidence: ~A~%" e *evidence*)
        (sb-ext:exit :code 1)))))
