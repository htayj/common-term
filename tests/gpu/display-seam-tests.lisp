;;;; Pure display-to-renderer contract tests. No driver or window is opened.
(in-package #:lispterm.display)

(defmethod backend-close ((backend (eql :renderer-seam-test)) display)
  (declare (ignore backend display))
  t)

(defun run-display-seam-tests ()
  (let ((saved (symbol-function 'gpu-call))
        (font (load-font nil 16))
        (calls nil) (failure nil) (failure-operation "OPEN-CONTEXT"))
    (labels ((fresh (&optional (request :cpu))
               (let ((d (make-display :font font :owner sb-thread:*current-thread*
                                      :renderer-request request)))
                 (resize-display d 24 16)
                 d))
             (called (name) (remove name calls :key #'car :test-not #'string=)))
      (unwind-protect
           (progn
             (setf (symbol-function 'gpu-call)
                   (lambda (name &rest args)
                     (push (cons name args) calls)
                     (when (and failure (string= name failure-operation)) (error failure))
                     (cond ((string= name "OPEN-CONTEXT") :context)
                           ((string= name "MAKE-RENDERER") :renderer)
                           ((string= name "RENDERER-READBACK")
                            (make-array (* 24 16) :element-type '(unsigned-byte 32)
                                                 :initial-element #xff123456)))))
             (let ((d (fresh)))
               (initialize-display-renderer d)
               (assert (eq :cpu (display-renderer-kind d)))
               (assert (null calls)))
             (setf failure (make-condition 'renderer-unavailable :detail "no device"))
             (let ((d (fresh :auto)))
               (initialize-display-renderer d)
               (assert (eq :cpu (display-renderer-kind d)))
               (assert (search "no device" (display-renderer-fallback-reason d)))
               (assert (= 384 (length (display-framebuffer d)))))
             (let ((d (fresh :gpu)))
               (assert (eq failure (handler-case (initialize-display-renderer d)
                                     (renderer-unavailable (c) c)))))
             (setf failure (make-condition 'simple-error :format-control "real bug"))
             (let ((d (fresh :auto)))
               (assert (eq failure (handler-case (initialize-display-renderer d)
                                     (simple-error (c) c)))))
             (setf failure-operation "MAKE-RENDERER")
             (let ((d (fresh :auto)))
               (assert (eq failure (handler-case (initialize-display-renderer d)
                                     (simple-error (c) c))))
               (assert (null (display-renderer-context d)))
               (assert (called "CLOSE-CONTEXT")))
             (setf failure nil calls nil)
             (let ((d (fresh :gpu)))
               (initialize-display-renderer d)
               (assert (eq :gpu (display-renderer-kind d)))
               (assert (null (called "RENDERER-READBACK")))
               (dotimes (bits 8)
                 (let* ((inverse (logbitp 0 bits)) (reverse (logbitp 1 bits))
                        (cursor (logbitp 2 bits))
                        (cell (make-cell :char #\A :fg #x102030 :bg #x405060
                                         :inverse inverse :bold t :underline t :blink t)))
                   (setf (display-reverse-screen d) reverse
                         (display-cursor-visible d) cursor
                         (display-cursor-row d) 0 (display-cursor-col d) 0
                         (display-blink-phase d) nil)
                   (render-cell d 0 0 cell)
                   (let* ((args (nthcdr 4 (first calls)))
                          (swap (oddp (logcount bits)))
                          (mask (getf args :mask)))
                     (assert (= (getf args :foreground) (if swap #x405060 #x102030)))
                     (assert (= (getf args :background) (if swap #x102030 #x405060)))
                     (assert (getf args :hidden))
                     (assert (getf args :bold)) (assert (getf args :underline))
                     (assert (= (length mask) 128))
                     (assert (every (lambda (x) (member x '(0 255))) mask)))))
               (assert (null (called "RENDERER-READBACK")))
               (assert (= #xff123456 (aref (display-framebuffer d) 0)))
               (display-framebuffer d)
               (assert (= 1 (length (called "RENDERER-DRAW"))))
               (assert (= 1 (length (called "RENDERER-READBACK"))))
               (setf calls nil (display-reverse-screen d) nil)
               (paint-row-remainder d 0 2 (make-cell :fg #x010203 :bg #x040506))
               (assert (equal (first calls)
                              '("RENDERER-WRITE-REMAINDER" :renderer 16 0 8 16 263430)))
               (assert (null (called "RENDERER-READBACK")))
              (let ((grid (display-grid d)) (damage (display-damage d))
                    (cache (display-framebuffer-storage d)))
                (setf failure-operation "RENDERER-RESIZE"
                      failure (make-condition 'simple-error :format-control "resize failed"))
                (assert (eq failure (handler-case (resize-display d 48 32)
                                      (simple-error (c) c))))
                (assert (= 24 (display-width d)))
                (assert (= 16 (display-height d)))
                (assert (eq grid (display-grid d)))
                (assert (eq damage (display-damage d)))
                (assert (eq cache (display-framebuffer-storage d)))
                (setf failure nil))
               (resize-display d 24 16)
               (assert (called "RENDERER-RESIZE"))
               (let ((thread (sb-thread:make-thread
                              (lambda ()
                                (handler-case (progn (display-framebuffer d) nil)
                                  (display-error () t))))))
                 (assert (sb-thread:join-thread thread)))
               (let ((pid (display-process-id d)))
                 (unwind-protect
                      (progn (setf (display-process-id d) -1)
                             (assert (handler-case (progn (display-framebuffer d) nil)
                                       (display-error () t))))
                   (setf (display-process-id d) pid)))
               (setf calls nil failure-operation "RENDERER-CLOSE"
                     failure (make-condition 'simple-error :format-control "close failed")
                     (display-backend d) :renderer-seam-test (display-open-p d) t)
               (assert (eq failure (handler-case (close-display d) (simple-error (c) c))))
               (assert (display-cleanup-pending-p d))
               (assert (not (display-open-p d)))
               (assert (eq :renderer (display-renderer-state d)))
               (assert (eq :context (display-renderer-context d)))
               (setf calls nil failure nil)
               (close-display d)
               (assert (equal (mapcar #'car (reverse calls))
                              '("RENDERER-CLOSE" "CLOSE-CONTEXT")))
               (assert (null (display-renderer-state d)))
               (assert (null (display-renderer-context d)))
               (assert (not (display-cleanup-pending-p d))))
             (let ((d (fresh :auto)))
               (initialize-display-renderer d)
               (setf failure-operation "RENDERER-DRAW"
                     failure (make-condition 'renderer-unavailable :detail "draw failed"))
               (assert (eq failure (handler-case (display-framebuffer d)
                                     (renderer-unavailable (c) c))))
               (assert (eq :gpu (display-renderer-kind d)))
               (assert (null (display-renderer-fallback-reason d)))
               (assert (display-renderer-pending-p d))
               (setf failure nil)
               (close-display-renderer d))
             ;; Cached CPU callers must continue resolving the live RENDER-CELL function.
             (let* ((d (fresh)) (old (symbol-function 'render-cell)) (count 0))
               (unwind-protect
                    (progn
                      (setf (symbol-function 'render-cell)
                            (lambda (&rest args) (declare (ignore args)) (incf count)))
                      (draw-cells d 0 0 (list (make-cell :char #\Q)))
                      (assert (= count 1)))
                 (setf (symbol-function 'render-cell) old)))
             t)
        (setf (symbol-function 'gpu-call) saved)))))

(run-display-seam-tests)
(format t "DISPLAY RENDERER SEAM PASS~%")
