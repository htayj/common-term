;;;; Pure syntax/emission and executable AST semantics. These are not GL tests.
(in-package #:lispterm.gpu.tests)

(defun shader-rejects-p (form)
  (handler-case (progn (lispterm.gpu:emit-shader form) nil)
    (lispterm.gpu:shader-error (c)
      (and (lispterm.gpu:shader-error-reason c) t))))

(defun interpret-cell-shader (form bindings &optional fetch)
  "Execute the bounded expression subset used by the authored cell programs.
This independent test interpreter checks the maintained AST, not driver output."
  (let ((env (copy-tree bindings)))
    (labels ((get-value (name)
               (let ((pair (assoc name env)))
                 (unless pair (error "Unbound interpreter identifier ~S" name))
                 (cdr pair)))
             (put-value (name value)
               (let ((pair (assoc name env)))
                 (if pair (setf (cdr pair) value) (push (cons name value) env))))
             (numeric-op (operation a b)
               (cond ((and (vectorp a) (vectorp b)) (map 'vector operation a b))
                     ((vectorp a) (map 'vector (lambda (x) (funcall operation x b)) a))
                     ((vectorp b) (map 'vector (lambda (x) (funcall operation a x)) b))
                     (t (funcall operation a b))))
             (expression (x)
               (cond ((numberp x) x) ((eq x :true) t) ((eq x :false) nil)
                     ((keywordp x) (get-value x))
                     (t
                      (let ((op (first x)) (a (second x)) (b (third x)))
                        (case op
                          (:choose (expression (if (expression a) b (fourth x))))
                          (:and (and (expression a) (expression b)))
                          (:or (or (expression a) (expression b)))
                          (:not (not (expression a)))
                          (:uint a) (:float (float a 1.0d0))
                          (:cast
                           (let ((value (expression b)))
                             (flet ((convert (v) (if (member a '(:int :uint :ivec2 :ivec3 :ivec4
                                                               :uvec2 :uvec3 :uvec4))
                                                     (truncate v) (float v 1.0d0))))
                               (if (vectorp value) (map 'vector #'convert value) (convert value)))))
                          (:swizzle
                           (let* ((v (expression a)) (fields (string-downcase (symbol-name b)))
                                  (result (map 'vector (lambda (c) (aref v (position c "xyzw"))) fields)))
                             (if (= (length result) 1) (aref result 0) result)))
                          ((:ivec2 :ivec3 :ivec4 :uvec2 :uvec3 :uvec4 :vec2 :vec3 :vec4)
                           (let ((values (loop for part in (rest x) for value = (expression part)
                                               append (if (vectorp value) (coerce value 'list) (list value)))))
                             (coerce (if (= (length values) 1)
                                         (make-list (lispterm.gpu::shader-components op) :initial-element (first values))
                                         values) 'vector)))
                          (:texel-fetch (funcall fetch (expression b)))
                          (otherwise
                           (let ((left (expression a)) (right (expression b)))
                             (case op
                               (:+ (numeric-op #'+ left right)) (:- (numeric-op #'- left right))
                               (:* (numeric-op #'* left right))
                               (:/ (numeric-op (lambda (u v) (if (and (integerp u) (integerp v))
                                                                (truncate u v) (/ u v))) left right))
                               (:% (numeric-op #'rem left right))
                               (:bit-and (numeric-op #'logand left right))
                               (:shift-right (numeric-op (lambda (u v) (ash u (- v))) left right))
                               (:= (= left right)) (:/= (/= left right))
                               (:< (< left right)) (:<= (<= left right))
                               (:> (> left right)) (:>= (>= left right))
                               (otherwise (error "Unsupported interpreter operator ~S" op))))))))))
             (statements (forms)
               (dolist (s forms)
                 (case (first s)
                   (:let (put-value (third s) (expression (fourth s))))
                   (:set (put-value (second s) (expression (third s))))
                   (:if (statements (if (expression (second s)) (third s) (fourth s))))))))
      (statements (cdr (car (last form))))
      env)))

(defun test-shader-syntax ()
  (dolist (stage '(:vertex :fragment))
    (let* ((form (lispterm.gpu:shader-form stage)) (text (lispterm.gpu:emit-shader form)))
      (check (and (stringp text) (> (length text) 500)) "No emitted program for ~S" stage)
      (check (search "#version 300 es" text) "Not an ES3 shader")
      (check (not (search "layout(location = 2)" text)) "ES3 varying received an unsupported location")
      (check (equal form (lispterm.gpu:shader-form stage)) "Shader form mutated on emission")))
  (check (search "texelFetch" (lispterm.gpu:emit-shader (lispterm.gpu:shader-form :fragment)))
         "Coverage must use exact texel fetch, not filtered sampling")
  (check (handler-case (progn (lispterm.gpu:shader-form :geometry) nil)
           (lispterm.gpu:shader-error () t)) "Unknown stage accepted")
  (dolist (bad '((:shader :geometry (:main))
                 (:shader :vertex (:main (:let :int :x (:+ 1))))
                 (:shader :vertex (:main (:let :int :x (:unknown 1 2))))
                 (:shader :vertex (:main (:let :bogus :x 1)))
                 (:shader :vertex (:main (:let :int :x (:float 1))))
                 (:shader :vertex (:main (:set :position (:ivec4 1))))
                 (:shader :vertex (:input :int :x 0) (:main (:set :x 1)))
                 (:shader :vertex (:input :uvec4 :x 0) (:input :uvec4 :y 0) (:main))
                 (:shader :vertex (:main (:let :int :x :missing)))
                 (:shader :vertex (:main (:let :int :x (:swizzle (:ivec2 1 2) :z))))
                 (:shader :vertex (:main (:let :int :x (:bit-and (:float 1) (:float 2)))))
                 (:shader :vertex (:main (:let :uint :x (:uint -1))))
                 (:shader :vertex (:main (:let :uint :x (:uint 4294967296))))
                 (:shader :vertex (:main (:let :int :x 2147483648)))
                 (:shader :vertex (:main (:let :int :|x;discard| 1)))
                 (:shader :vertex (:main (:let :int :gl-x 1)))
                 (:shader :vertex (:main (:let :int :if 1)))
                 (:shader :vertex (:main (:let :int :x__y 1)))
                 (:shader :vertex (:main (:let :int :x :fragment-coordinate)))
                 (:shader :fragment (:input :int :x 0) (:output :vec4 :o 0) (:main))
                 (:shader :fragment (:main))
                 (:shader :vertex (:main (:if :true ((:let :int :x 1))) (:let :int :y :x)))
                 (:shader . :vertex)
                 (:shader :vertex (:main (:let :int :x (:+ 1 . 2))))
                 (:shader :vertex (:main (:let :int :a-b 1) (:let :int :a_b 2)))
                 (:shader :vertex (:input :bool :x 0) (:main))
                 (:shader :vertex (:input :int :x 0 :flat) (:main))
                 (:shader :vertex (:main (:let :int :position 1)))
                 (:shader :vertex (:main (:let :int :x "gl_Position=vec4(0)")))))
    (check (shader-rejects-p bad) "Invalid AST accepted: ~S" bad))
  (let ((cycle (list :shader :vertex)))
    (setf (cddr cycle) cycle)
    (check (shader-rejects-p cycle) "Cyclic AST accepted"))
  (let ((deep 1))
    (dotimes (i 100) (setf deep (list :+ 1 deep)))
    (check (shader-rejects-p (list :shader :vertex (list :main (list :let :int :x deep))))
           "Unbounded AST accepted"))
  t)

(defun test-cell-shader-semantics (&optional (cw 5) (ch 6))
  (let* ((target-height (* 3 ch))
         (mask (make-array (* cw ch) :initial-element 0))
         (fg #xe13b79) (bg #x072afb)
         (vertex (lispterm.gpu:shader-form :vertex))
         (fragment (lispterm.gpu:shader-form :fragment))
         (tested 0) (fetches 0))
    ;; Sparse asymmetric mask exposes vertical-half and horizontal smear mistakes.
    (dolist (index '(0 4 7 11 18 24 26))
      (when (< index (length mask)) (setf (aref mask index) 255)))
    (labels ((fetch (coord)
               ;; Slot 3 in a two-column atlas has tile origin (cw,ch).
               (let ((x (- (aref coord 0) cw)) (y (- (aref coord 1) ch)))
                 (check (and (<= 0 x) (< x cw) (<= 0 y) (< y ch)) "Out-of-tile fetch ~S" coord)
                 (incf fetches)
                 (vector (/ (aref mask (+ x (* y cw))) 255.0d0) 0.0d0 0.0d0 1.0d0)))
             (source-ink (gx gy flags)
               (and (not (logbitp 2 flags))
                    (or (and (< gx cw) (plusp (aref mask (+ gx (* gy cw)))))
                        (and (logbitp 0 flags) (> gx 0) (<= gx cw)
                             (plusp (aref mask (+ (1- gx) (* gy cw)))))
                        (and (logbitp 1 flags) (= gy (- ch 2)))))))
      (loop for line from 0 to 3 for sx = (if (zerop line) 1 2) do
        (loop for span from 1 to 2 do
          (loop for flags from 0 to 7 do
            (dotimes (dy ch)
              (dotimes (dx (* span cw sx))
                (let* ((gx (floor dx sx))
                       (gy (if (>= line 2) (floor (+ dy (if (= line 3) ch 0)) 2) dy))
                       (expected (if (source-ink gx gy flags) fg bg))
                       (env (interpret-cell-shader
                             fragment `((:u-target-size . ,(vector 43 target-height))
                                        (:u-cell-size . ,(vector cw ch)) (:u-atlas-columns . 2)
                                        (:u-atlas . 0) (:v-origin . ,(vector 0 ch))
                                        (:v-meta . ,(vector 3 flags fg bg)) (:v-shape . ,(vector span line))
                                        (:fragment-coordinate . ,(vector (+ dx 0.5d0)
                                                                         (- target-height ch dy 0.5d0) 0 1)))
                             #'fetch))
                       (actual (cdr (assoc :o-color env))))
                  (check (and (= (round (* (aref actual 0) 255)) (ldb (byte 8 16) expected))
                              (= (round (* (aref actual 1) 255)) (ldb (byte 8 8) expected))
                              (= (round (* (aref actual 2) 255)) (ldb (byte 8 0) expected))
                              (= 1 (aref actual 3)))
                         "Pixel mismatch line~D span~D flags~D at (~D,~D)" line span flags dx dy)
                  (incf tested)))))))
      ;; Six corners, full and odd column clipping, and targets narrower than a cell.
      (dolist (width '(1 9 25 26 43))
        (loop for line from 0 to 3 for sx = (if (zerop line) 1 2) do
          (loop for span from 1 to 2 do
            (let* ((columns (max 1 (floor width cw)))
                   (logical (max 1 (floor columns sx)))
                   (col (1- logical)) (right (min width (* cw sx logical)))
                   (origin (* col cw sx)))
              (dotimes (id 6)
                (let* ((corner-x (if (member id '(1 4 5)) 1 0))
                       (corner-y (if (member id '(2 3 5)) 1 0))
                       (px (min right (+ origin (* corner-x span cw sx))))
                       (py (+ ch (* corner-y ch)))
                       (env (interpret-cell-shader
                             vertex `((:u-target-size . ,(vector width target-height))
                                      (:u-cell-size . ,(vector cw ch)) (:vertex-id . ,id)
                                      (:a-cell . ,(vector col 1 3 0))
                                      (:a-style . ,(vector fg bg span line)))))
                       (position (cdr (assoc :position env))))
                  (check (< (abs (- (aref position 0) (- (* 2 (/ px width)) 1))) 1.0d-10)
                         "Incorrect clipped vertex x")
                  (check (< (abs (- (aref position 1) (- 1 (* 2 (/ py target-height))))) 1.0d-10)
                         "Incorrect top-left vertex y")))))))
      (check (= tested (* cw ch 8 3 7)) "Incomplete fragment semantic coverage")
      (check (> fetches 1000) "Atlas lookup not exercised"))
    t))

(defun test-typed-shader-transform ()
  (let* ((original (lispterm.gpu:shader-form :fragment))
         (changed (subst '(:swizzle :v-meta :w) '(:swizzle :v-meta :z) original :test #'equal))
         (bindings `((:u-target-size . #(5 6)) (:u-cell-size . #(5 6))
                     (:u-atlas-columns . 1) (:u-atlas . 0) (:v-origin . #(0 0))
                     (:v-meta . ,(vector 0 0 #xff0000 #x0000ff)) (:v-shape . #(1 0))
                     (:fragment-coordinate . #(0.5d0 5.5d0 0 1))))
         (fetch (lambda (coord) (declare (ignore coord)) #(1.0d0 0 0 1)))
         (before (cdr (assoc :o-color (interpret-cell-shader original bindings fetch))))
         (after (cdr (assoc :o-color (interpret-cell-shader changed bindings fetch)))))
    (check (not (string= (lispterm.gpu:emit-shader original) (lispterm.gpu:emit-shader changed)))
           "Typed AST transformation did not affect generated shader")
    (check (and (= 1 (aref before 0)) (= 0 (aref before 2))
                (= 0 (aref after 0)) (= 1 (aref after 2)))
           "Typed AST transformation did not change the foreground from red to blue")
    (check (equal original (lispterm.gpu:shader-form :fragment)) "Shader form was not fresh data"))
  t)

(register-check "gpu-shader"
                (lambda () (test-shader-syntax) (test-cell-shader-semantics)
                  (test-cell-shader-semantics 3 5) (test-typed-shader-transform) t))
