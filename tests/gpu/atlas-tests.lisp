(in-package #:lispterm.gpu.tests)

(defun atlas-test-rejects (thunk)
  (check (handler-case (progn (funcall thunk) nil) (error () t)) "Expected model rejection"))

(defun atlas-test-u32 (bytes offset)
  (loop for i below 4 sum (ash (aref bytes (+ offset i)) (* i 8))))

(defun test-atlas-model ()
  (let* ((mask (make-array 4 :element-type '(unsigned-byte 8) :initial-contents '(0 255 255 0)))
         (a '("a" nil 1)) (b '("b" nil 1)) (c '("c" t 2))
         (atlas (lispterm.gpu:make-atlas :tile-width 2 :tile-height 2 :capacity 1 :max-capacity 3)))
    (lispterm.gpu:atlas-begin-frame atlas (list a))
    (multiple-value-bind (slot epoch upload) (lispterm.gpu:atlas-ensure-glyph atlas a mask)
      (check (and (= slot 0) (= epoch 0) upload) "First allocation")
      (check (third (multiple-value-list (lispterm.gpu:atlas-ensure-glyph atlas a mask)))
             "Pending upload must survive repeat lookup")
      (lispterm.gpu:atlas-acknowledge-upload atlas slot epoch)
      (check (null (third (multiple-value-list (lispterm.gpu:atlas-ensure-glyph atlas a mask))))
             "Warm atlas must need zero uploads"))
    ;; Growth preserves slot identity but invalidates generations and texture data.
    (lispterm.gpu:atlas-begin-frame atlas (list a b))
    (check (= 2 (lispterm.gpu:atlas-capacity atlas)) "Atlas grows")
    (check (not (lispterm.gpu:atlas-reference-valid-p atlas 0 0)) "Growth invalidates epoch")
    (check (= 1 (length (lispterm.gpu:atlas-pending-uploads atlas))) "Growth reuploads live mask")
    (atlas-test-rejects (lambda () (lispterm.gpu:atlas-acknowledge-upload atlas 0 0)))
    (lispterm.gpu:atlas-ensure-glyph atlas b mask)
    ;; New keys encountered before old keys cannot evict the latter.
    (lispterm.gpu:atlas-begin-frame atlas (list b c))
    (let ((old-epoch (lispterm.gpu:atlas-epoch atlas)))
      (check (= 0 (lispterm.gpu:atlas-ensure-glyph atlas c mask)) "Deterministic first evictable slot")
      (check (> (lispterm.gpu:atlas-epoch atlas) old-epoch) "Eviction increments epoch")
      (check (= 1 (lispterm.gpu:atlas-ensure-glyph atlas b mask)) "Whole-frame key protected")
      (check (not (lispterm.gpu:atlas-reference-valid-p atlas 0 old-epoch a)) "Stale reference rejected"))
    (let ((epoch (lispterm.gpu:atlas-epoch atlas)))
      (atlas-test-rejects (lambda () (lispterm.gpu:atlas-begin-frame atlas
                                      (list a b c '("d" nil 1)))))
      (check (= epoch (lispterm.gpu:atlas-epoch atlas)) "Rejected frame is atomic")
      (lispterm.gpu:atlas-ensure-glyph atlas b mask))
    (atlas-test-rejects (lambda () (lispterm.gpu:atlas-ensure-glyph atlas a mask)))
    (atlas-test-rejects (lambda () (lispterm.gpu:atlas-ensure-glyph atlas b #(0 255 255 0))))
    (atlas-test-rejects (lambda () (lispterm.gpu:atlas-ensure-glyph atlas b
                                  (make-array 4 :element-type '(unsigned-byte 8) :initial-element 3))))
    (atlas-test-rejects (lambda () (lispterm.gpu:atlas-ensure-glyph atlas b
                                  (make-array 3 :element-type '(unsigned-byte 8) :initial-element 0))))
    ;; Input and returned snapshots cannot mutate internal hash keys or masks.
    (let* ((text (copy-seq "mutable")) (key (list text nil 1))
           (source (copy-seq mask)))
      (lispterm.gpu:atlas-begin-frame atlas (list key))
      (lispterm.gpu:atlas-ensure-glyph atlas key source)
      (setf (char text 0) #\X (second key) t (aref source 0) 255)
      (let ((entry (first (lispterm.gpu:atlas-live-glyphs atlas))))
        (setf (first (getf entry :key)) "bad" (aref (getf entry :mask) 0) 255))
      (lispterm.gpu:atlas-ensure-glyph atlas '("mutable" nil 1) mask)
      (atlas-test-rejects (lambda () (lispterm.gpu:atlas-ensure-glyph atlas key mask))))
    ;; Reach the true configured maximum and protect every live slot.
    (lispterm.gpu:atlas-begin-frame atlas (list a b c))
    (dolist (key (list a b c)) (lispterm.gpu:atlas-ensure-glyph atlas key mask))
    (check (= 3 (lispterm.gpu:atlas-capacity atlas)) "Growth reaches configured maximum")
    (check (= 3 (length (lispterm.gpu:atlas-live-glyphs atlas))) "All frame masks retained")
    (dolist (upload (lispterm.gpu:atlas-pending-uploads atlas))
      (lispterm.gpu:atlas-acknowledge-upload atlas (getf upload :slot) (getf upload :epoch)))
    (lispterm.gpu:atlas-begin-frame atlas (list c b a a))
    (dolist (key (list c b a))
      (check (not (third (multiple-value-list (lispterm.gpu:atlas-ensure-glyph atlas key mask))))
             "Repeated complete frame uploads zero masks"))
    (let ((cycle (list "cycle" nil 1)))
      (setf (cdddr cycle) cycle)
      (atlas-test-rejects (lambda () (lispterm.gpu:atlas-begin-frame atlas (list cycle)))))
    (dolist (key '(nil ("" nil 1) ("x" :yes 1) ("x" nil 3) (42 nil 1)))
      (atlas-test-rejects (lambda () (lispterm.gpu:atlas-begin-frame atlas (list key)))))
    (dolist (args '((:tile-width 0 :tile-height 1 :capacity 1 :max-capacity 1)
                    (:tile-width 1 :tile-height 1 :capacity 2 :max-capacity 1)
                    (:tile-width 1 :tile-height -1 :capacity 1 :max-capacity 1)))
      (atlas-test-rejects (lambda () (apply #'lispterm.gpu:make-atlas args)))))
  t)

(defun test-atlas-linear-candidates ()
  ;; Count the allocator's actual entry reads, not elapsed time. Exercise two
  ;; large sizes, growth, retained keys, total churn and warm lookups.
  (dolist (size '(12000 24000))
    (let* ((half (/ size 2))
           (atlas (lispterm.gpu:make-atlas :tile-width 1 :tile-height 1
                                         :capacity 1 :max-capacity size))
           (mask (make-array 1 :element-type '(unsigned-byte 8) :initial-element 255))
           (keys (loop for i below size collect (list (format nil "glyph-~D" i) nil 1)))
           (replacements (loop for i below half collect (list (format nil "new-~D" i) nil 1)))
           (fresh (loop for i below size collect (list (format nil "fresh-~D" i) nil 1)))
           (counts nil))
      (flet ((probes () (lispterm.gpu::atlas-candidate-probes atlas))
             (ensure-slot (key slot)
               (check (= slot (lispterm.gpu:atlas-ensure-glyph atlas key mask))
                      "Ascending candidate preserves deterministic slot order")))
        (lispterm.gpu:atlas-begin-frame atlas (subseq keys 0 half))
        (loop for key in keys for i below half do (ensure-slot key i))
        (check (= half (probes)) "Growing initial fill inspects one candidate per slot")
        (push (probes) counts)
        (dolist (upload (lispterm.gpu:atlas-pending-uploads atlas))
          (lispterm.gpu:atlas-acknowledge-upload atlas (getf upload :slot) (getf upload :epoch)))
        (lispterm.gpu:atlas-begin-frame atlas keys)
        (check (= half (length (lispterm.gpu:atlas-pending-uploads atlas)))
               "Large growth restores acknowledged masks to pending")
        ;; New keys first, while the whole old half is already protected.
        (loop for key in (nthcdr half keys) for i from half do (ensure-slot key i))
        (loop for key in keys for i below half do (ensure-slot key i))
        (check (= size (probes)) "Second growth scans old slots only once")
        (push (probes) counts)
        (let ((retained (loop for key in keys for i from 0 when (oddp i) collect key)))
          (lispterm.gpu:atlas-begin-frame atlas (append replacements retained))
          ;; Invalid operations must not consume a candidate or reset a cursor.
          (atlas-test-rejects
           (lambda () (lispterm.gpu:atlas-ensure-glyph atlas (first replacements)
                        (make-array 1 :element-type '(unsigned-byte 8) :initial-element 3))))
          (check (zerop (probes)) "Rejected mask consumes no candidate")
          (loop for key in replacements for slot from 0 by 2 do (ensure-slot key slot))
          (let ((before (probes)))
            (atlas-test-rejects
             (lambda () (lispterm.gpu:atlas-begin-frame atlas (append fresh (list '("excess" nil 1))))))
            (check (= before (probes)) "Rejected frame preserves allocation state"))
          (loop for key in retained for slot from 1 by 2 do (ensure-slot key slot))
          (check (= (1- (* 2 size)) (probes)) "Protected churn uses two monotone scans")
          (push (probes) counts))
        (lispterm.gpu:atlas-begin-frame atlas fresh)
        (loop for key in fresh for slot from 0 do (ensure-slot key slot))
        (check (= (* 2 size) (probes)) "Full replacement inspects at most two candidates per slot")
        (push (probes) counts)
        (check (= size (length (lispterm.gpu:atlas-pending-uploads atlas)))
               "Full churn preserves every pending upload")
        (lispterm.gpu:atlas-begin-frame atlas fresh)
        (loop for key in fresh for slot from 0 do (ensure-slot key slot))
        (check (zerop (probes)) "Warm frame does not search slots")
        (format t "Atlas ~D slots: candidate reads fill/grow/partial/full/warm ~S~%"
                size (append (nreverse counts) (list (probes)))))))
  t)

(defun test-instance-model ()
  (let ((buffer (lispterm.gpu:make-instance-buffer :columns 3 :rows 2 :slot-limit 12)))
    (check (equal '((0 192)) (lispterm.gpu:instance-buffer-dirty-ranges buffer)) "Initial upload")
    (lispterm.gpu:instance-buffer-clear-dirty buffer)
    (lispterm.gpu:instance-buffer-write buffer 2 1 :slot 11 :foreground #x123456
                                      :background #xabcdef :span 2 :bold t :underline t :hidden t
                                      :line-size :double-height-bottom)
    (let ((octets (lispterm.gpu:instance-buffer-octets buffer)))
      (check (equal '(2 1 11 7 #x123456 #xabcdef 2 3)
                    (loop for offset from 160 below 192 by 4 collect (atlas-test-u32 octets offset)))
             "32-byte little-endian packed record")
      (check (equal '(#x56 #x34 #x12 0) (coerce (subseq octets 176 180) 'list)) "Byte order"))
    (check (equal '((160 192)) (lispterm.gpu:instance-buffer-dirty-ranges buffer)) "Exact dirty range")
    (check (equal '(1) (lispterm.gpu:instance-buffer-dirty-rows buffer)) "Dirty rows")
    (lispterm.gpu:instance-buffer-clear-dirty buffer)
    (check (not (lispterm.gpu:instance-buffer-write buffer 2 1 :slot 11 :foreground #x123456
                        :background #xabcdef :span 2 :bold t :underline t :hidden t
                        :line-size :double-height-bottom)) "Identical cell avoids dirtying")
    (check (null (lispterm.gpu:instance-buffer-dirty-ranges buffer)) "Warm buffer no uploads")
    (lispterm.gpu:instance-buffer-write buffer 0 0 :slot 1)
    (lispterm.gpu:instance-buffer-write buffer 1 0 :slot 1)
    (lispterm.gpu:instance-buffer-write buffer 0 1 :slot 1)
    (check (equal '((0 64) (96 128)) (lispterm.gpu:instance-buffer-dirty-ranges buffer))
           "Adjacent records merge; gaps remain disjoint")
    (lispterm.gpu:instance-buffer-clear-dirty buffer)
    (dolist (args '((-1 0) (3 0) (0 2) (0 0 :slot 12) (0 0 :slot -1)
                    (0 0 :foreground #x1000000) (0 0 :background -1)
                    (0 0 :span 0) (0 0 :hidden :yes) (0 0 :line-size :bogus)))
      (atlas-test-rejects (lambda () (apply #'lispterm.gpu:instance-buffer-write buffer args))))
    (check (null (lispterm.gpu:instance-buffer-dirty-ranges buffer)) "Invalid writes are atomic"))
  (dolist (args '((:columns 0 :rows 1) (:columns 1 :rows -1)
                  (:columns 4 :rows 4 :max-instances 15) (:columns 1 :rows 1 :slot-limit 0)))
    (atlas-test-rejects (lambda () (apply #'lispterm.gpu:make-instance-buffer args))))
  (let ((large (lispterm.gpu:make-instance-buffer :columns 240 :rows 100)))
    (dotimes (row 100)
      (dotimes (column 240)
        (lispterm.gpu:instance-buffer-write large column row :slot (mod column 100)
                                           :foreground #xffffff)))
    (check (= 768000 (length (lispterm.gpu:instance-buffer-octets large))) "Realistic large grid")
    (check (= 239 (atlas-test-u32 (lispterm.gpu:instance-buffer-octets large) 767968))
           "Last grid cell packed"))
  t)

(register-check "gpu-atlas" (lambda () (test-atlas-model) (test-atlas-linear-candidates)
                                      (test-instance-model) t))
