(in-package #:lispterm.gpu.tests)

(defun dma-pump-until (display predicate label)
  (loop repeat 120 when (funcall predicate) do (return-from dma-pump-until t)
        do (lispterm.display:poll-events display :timeout .025))
  (error "Direct presentation timed out: ~A" label))

(defun dma-test-pattern (display phase)
  (let ((cpu (parity-display (lispterm.display:display-width display)
                             (lispterm.display:display-height display))))
    (dotimes (row (lispterm.display::display-rows display))
      (dotimes (col (lispterm.display::display-columns display))
        (let ((cell (lispterm.display::make-cell
                     :char (char "Ag#W " (mod (+ row col phase) 5))
                     :fg #xe1ab73 :bg (if (evenp (+ row phase)) #x123456 #x675321)
                     :bold (oddp col) :underline (= 2 (mod col 4)))))
          (lispterm.display::render-cpu-cell cpu row col cell)
          (lispterm.display::render-cell display row col cell))))
    cpu))

(defun dma-capture-compare (display cpu directory label)
  ;; Capture the compositor output, not the client's framebuffer. PPM avoids a
  ;; second image decoder in the pixel oracle. Retain PNG for visual inspection.
  (let ((ppm (merge-pathnames (format nil "~A.ppm" label) directory))
        (png (merge-pathnames (format nil "~A.png" label) directory)))
    (fixture-command (list (format nil "XDG_RUNTIME_DIR=~A" (uiop:getenv "XDG_RUNTIME_DIR"))
                           (format nil "WAYLAND_DISPLAY=~A" (uiop:getenv "WAYLAND_DISPLAY"))
                           "grim" "-t" "ppm" (namestring ppm)))
    (fixture-command (list (format nil "XDG_RUNTIME_DIR=~A" (uiop:getenv "XDG_RUNTIME_DIR"))
                           (format nil "WAYLAND_DISPLAY=~A" (uiop:getenv "WAYLAND_DISPLAY"))
                           "grim" (namestring png)))
    (with-open-file (s ppm :element-type '(unsigned-byte 8))
      (flet ((line () (coerce (loop for c = (read-byte s) until (= c 10) collect (code-char c)) 'string)))
        (check (equal "P6" (line)) "Not a PPM screenshot")
        (let* ((dimensions (uiop:split-string (line) :separator '(#\Space)))
               (w (parse-integer (first dimensions))) (h (parse-integer (second dimensions)))
               (pixels (lispterm.display:display-framebuffer cpu)))
          (check (equal "255" (line)) "Unsupported PPM depth")
          (check (and (= w (lispterm.display:display-width display))
                      (= h (lispterm.display:display-height display)))
                 "Compositor screenshot and client size differ: ~Dx~D" w h)
          (dotimes (i (* w h))
            (let ((rgb (logior (ash (read-byte s) 16) (ash (read-byte s) 8) (read-byte s))))
              (check (= rgb (logand #xffffff (aref pixels i)))
                     "Direct screenshot ~A pixel(~D,~D): compositor~6,'0X CPU~6,'0X"
                     label (mod i w) (floor i w) rgb (logand #xffffff (aref pixels i)))))
          (check (null (read-byte s nil)) "PPM trailing bytes")
          (format t "DIRECT SCREENSHOT ~A ~D exact compositor RGB pixels ~A~%" label (* w h) png))))))

(defun dma-name-allocation-controls (context)
  (dolist (symbol '(lispterm.gpu:gl-gen-textures lispterm.gpu:gl-gen-framebuffers))
    (let ((generate (symbol-function symbol))
          (destroy (symbol-function 'lispterm.gpu:dma-destroy))
          (owner nil) (failure nil) (invalid-name nil))
      (unwind-protect
           (progn
             (setf (symbol-function symbol)
                   (lambda (count output)
                     (declare (ignore count))
                     ;; Real GL_INVALID_VALUE must leave zero-initialized output.
                     (funcall generate -1 output))
                   (symbol-function 'lispterm.gpu:dma-destroy)
                   (lambda (target)
                     (setf owner target
                           invalid-name (if (eq symbol 'lispterm.gpu:gl-gen-textures)
                                            (lispterm.gpu::dma-target-texture target)
                                            (lispterm.gpu:dma-target-framebuffer target)))
                     (funcall destroy target)))
             (handler-case (lispterm.gpu:dma-create context 16 16)
               (lispterm.gpu:gpu-unavailable (condition) (setf failure condition))))
        (setf (symbol-function symbol) generate
              (symbol-function 'lispterm.gpu:dma-destroy) destroy))
      (check (and failure owner (null invalid-name)
                  (lispterm.gpu::dma-target-closed-p owner)
                  (not (gethash owner lispterm.gpu::*dma-pending-targets*)))
             "Failed ~A recorded a bogus name or lost cleanup ownership" symbol)
      (format t "DIRECT ALLOCATION real invalid-count ~A checked, no bogus name~%" symbol))))

(defun dma-partial-construction-control (context)
  ;; Both failures enter the real driver: invalid texture dimensions followed
  ;; by invalid-enum GL state at cleanup entry. Restore every function binding.
  (let ((allocate (symbol-function 'lispterm.gpu:gl-tex-image-2d))
        (destroy (symbol-function 'lispterm.gpu:dma-destroy))
        (target nil) (failure nil))
    (unwind-protect
         (progn
           (setf (symbol-function 'lispterm.gpu:gl-tex-image-2d)
                 (lambda (kind level format width height border channels type pixels)
                   (declare (ignore width))
                   (funcall allocate kind level format -1 height border channels type pixels))
                 (symbol-function 'lispterm.gpu:dma-destroy)
                 (lambda (owner)
                   (setf target owner)
                   (lispterm.gpu:gl-bind-texture #xffffffff 0)
                   (funcall destroy owner)))
           (handler-case (lispterm.gpu:dma-create context 16 16)
             (error (condition) (setf failure condition))))
      (setf (symbol-function 'lispterm.gpu:gl-tex-image-2d) allocate
            (symbol-function 'lispterm.gpu:dma-destroy) destroy))
    (check (and failure target (lispterm.gpu::dma-target-texture target)
                (not (lispterm.gpu::dma-target-closed-p target)))
           "Partial allocation/cleanup control did not retain a live GL name")
    (format t "DIRECT PARTIAL allocation+cleanup real GL failures: ~A owner texture ~S~%"
            failure (lispterm.gpu::dma-target-texture target))
    (check (and (typep failure 'lispterm.gpu:dma-cleanup-failed)
                (eq target (lispterm.gpu:dma-failed-target failure))
                (gethash target lispterm.gpu::*dma-pending-targets*))
           "Partial construction failure lost its condition or pending cleanup owner")
    (check (not (typep failure 'lispterm.gpu:gpu-unavailable))
           "Failed partial cleanup can be mistaken for clean GPU unavailability")
    target))

(defun dma-allocation-transfer-controls (context)
  (dolist (mode '(:image-interrupt :fd-interrupt :fd-throw))
    (let ((address (symbol-function 'lispterm.gpu::extension-address))
          (check-egl (symbol-function 'lispterm.gpu::egl-check))
          (destroy (symbol-function 'lispterm.gpu:dma-destroy))
          (close-fd (symbol-function 'lispterm.gpu::dma-close-fd))
          (target nil) (image nil) (fds nil) (sentinels nil)
          (closes (make-hash-table)) (image-destroys 0) (injected nil) (caught nil))
      (unwind-protect
           (progn
             (setf (symbol-function 'lispterm.gpu::extension-address)
                   (lambda (name)
                     (let ((pointer (funcall address name)))
                       (when (string= name "eglDestroyImageKHR") (incf image-destroys))
                       (when (and (not injected)
                                  (or (and (eq mode :image-interrupt) (string= name "eglCreateImageKHR"))
                                      (and (eq mode :fd-interrupt) (string= name "eglExportDMABUFImageMESA"))))
                         (setf injected t)
                         ;; Queue a real SBCL asynchronous nonlocal exit. The
                         ;; driver call must finish and publish ownership first.
                         (sb-thread:interrupt-thread sb-thread:*current-thread*
                           (lambda () (throw 'dma-allocation :interrupted))))
                       pointer))
                   (symbol-function 'lispterm.gpu::egl-check)
                   (lambda (result operation)
                     (prog1 (funcall check-egl result operation)
                       (when (and (eq mode :fd-throw) (eq operation 'lispterm.gpu::dma-export))
                         (setf injected t)
                         (throw 'dma-allocation :thrown))))
                   (symbol-function 'lispterm.gpu:dma-destroy)
                   (lambda (owner)
                     (setf target owner image (lispterm.gpu::dma-target-image owner)
                           fds (copy-list (lispterm.gpu:dma-target-fds owner)))
                     (funcall destroy owner))
                   (symbol-function 'lispterm.gpu::dma-close-fd)
                   (lambda (fd)
                     (prog1 (funcall close-fd fd)
                       (when (member fd fds)
                         (incf (gethash fd closes 0))
                         ;; Reuse the just-closed number. A duplicate close must
                         ;; not close this unrelated descriptor during unwind.
                         (push (sb-posix:open "/dev/null" sb-posix:o-rdonly) sentinels)))))
             (setf caught (catch 'dma-allocation (lispterm.gpu:dma-create context 16 16))))
        (setf (symbol-function 'lispterm.gpu::extension-address) address
              (symbol-function 'lispterm.gpu::egl-check) check-egl
              (symbol-function 'lispterm.gpu:dma-destroy) destroy
              (symbol-function 'lispterm.gpu::dma-close-fd) close-fd))
      (unwind-protect
           (progn
             (check (and injected (eq caught (if (eq mode :fd-throw) :thrown :interrupted))
                         target image (= 1 image-destroys)
                         (lispterm.gpu::dma-target-closed-p target)
                         (not (gethash target lispterm.gpu::*dma-pending-targets*)))
                    "DMA allocation exit lost image/target ownership: ~S" mode)
             (unless (eq mode :image-interrupt)
               (check fds "Export exit lost FD ownership")
               (dolist (fd fds) (check (= 1 (gethash fd closes 0)) "FD ~D closed other than once" fd)))
             (dolist (fd sentinels)
               (check (integerp (sb-posix:fcntl fd sb-posix:f-getfd)) "Reused FD was closed again"))
             (format t "DIRECT ALLOCATION TRANSFER ~S image-destroys=~D FD-closes=~S reused-FDs-live=~D~%"
                     mode image-destroys (loop for fd in fds collect (gethash fd closes)) (length sentinels)))
        (dolist (fd sentinels) (funcall close-fd fd))))))

(defun dma-import-transfer-controls (display)
  ;; Fail after a real successful compositor import, before params destruction.
  ;; Exercise the actual dma-present caller's unwind, not a model of it.
  (let* ((state (lispterm.display.wayland::window-protocol display))
         (dma (gethash state lispterm.display.wayland::*dma-protocols*))
         (wire (lispterm.display.wayland::wayland-state-wire state))
         (send (symbol-function 'lispterm.display.wayland::wire-send))
         (create (symbol-function 'lispterm.gpu:dma-create))
         (all-safe t))
    (dolist (mode '(:error :throw))
      (let ((target nil) (injected nil) (caught nil)
            (old (copy-list (lispterm.display.wayland::dma-protocol-buffers dma)))
            (busy nil))
        (setf busy (mapcar #'lispterm.display.wayland::dma-buffer-busy-p old))
        (unwind-protect
             (progn
               (dolist (buffer old) (setf (lispterm.display.wayland::dma-buffer-busy-p buffer) t))
               (setf (symbol-function 'lispterm.gpu:dma-create)
                     (lambda (&rest arguments) (setf target (apply create arguments)))
                     (symbol-function 'lispterm.display.wayland::wire-send)
                     (lambda (connection id opcode &rest arguments)
                       (when (and (= opcode 0)
                                  (eq :dma-params (gethash id (lispterm.display.wayland::wire-interfaces wire))))
                         (setf injected t)
                         (if (eq mode :throw) (throw 'dma-transfer :thrown)
                             (error "Injected trailing params destruction failure")))
                       (apply send connection id opcode arguments)))
               (setf caught
                     (catch 'dma-transfer
                       (handler-case (lispterm.display.wayland::dma-present display)
                         (error () :error)))))
          (setf (symbol-function 'lispterm.gpu:dma-create) create
                (symbol-function 'lispterm.display.wayland::wire-send) send)
          (loop for buffer in old for value in busy do
            (setf (lispterm.display.wayland::dma-buffer-busy-p buffer) value)))
        (let* ((buffer (find target (lispterm.display.wayland::dma-protocol-buffers dma)
                             :key #'lispterm.display.wayland::dma-buffer-target))
               (safe (and injected (eq caught (if (eq mode :throw) :thrown :error))
                          target buffer (not (lispterm.gpu::dma-target-closed-p target))
                          (lispterm.gpu:dma-target-fds target)
                          (= 1 (count target (lispterm.display.wayland::dma-protocol-buffers dma)
                                      :key #'lispterm.display.wayland::dma-buffer-target))
                          (not (gethash target lispterm.gpu::*dma-pending-targets*))
                          (lispterm.display.wayland::dma-buffer-params-created-p buffer)
                          (not (lispterm.display.wayland::dma-buffer-params-destroyed-p buffer))
                          (not (lispterm.display.wayland::dma-buffer-protocol-destroyed-p buffer))
                          (not (lispterm.display.wayland::dma-buffer-complete-p buffer)))))
          (format t "DIRECT TRANSFER ~S injected=~S caught=~S pool-owner=~S closed=~S safe=~S~%"
                  mode injected caught (not (null buffer))
                  (and target (lispterm.gpu::dma-target-closed-p target)) (not (null safe)))
          (unless safe
            (setf all-safe nil)
            ;; Permit the second pre-repair reproduction without exhausting the
            ;; bounded pool with the first broken buffer.
            (when buffer
              (lispterm.display.wayland::dma-buffer-destroy state buffer)
              (setf (lispterm.display.wayland::dma-protocol-buffers dma)
                    (remove buffer (lispterm.display.wayland::dma-protocol-buffers dma)))))
          ;; Failed imports must be collectible while still connected, including
          ;; retrying params destruction, without damaging the normal pool.
          (when safe
            (let ((fds (copy-list (lispterm.gpu:dma-target-fds target))))
              (lispterm.display.wayland::dma-collect state dma)
              (lispterm.display.wayland::protocol-roundtrip state)
              (check (and (lispterm.gpu::dma-target-closed-p target)
                          (lispterm.display.wayland::dma-buffer-params-destroyed-p buffer)
                          (lispterm.display.wayland::dma-buffer-protocol-destroyed-p buffer)
                          (not (gethash target lispterm.gpu::*dma-pending-targets*))
                          (not (member buffer (lispterm.display.wayland::dma-protocol-buffers dma))))
                     "Failed import retry did not release pool ownership")
              (dolist (fd fds)
                (check (handler-case (progn (sb-posix:fcntl fd sb-posix:f-getfd) nil)
                         (sb-posix:syscall-error () t)) "Import retry leaked FD ~D" fd)))))))
    (check all-safe "Trailing params failure/nonlocal exit retained a destroyed pool target")))

(defun dma-one-session (directory &key (label "direct"))
  (let ((display (lispterm.display:open-display :backend :wayland :renderer :gpu :columns 12 :rows 4))
        (fds nil) (context nil) (partial nil))
    (unwind-protect
         (progn
           (setf context (lispterm.display::display-renderer-context display))
           (lispterm.gpu:require-hardware-context context)
            (dma-allocation-transfer-controls context)
            (dma-name-allocation-controls context)
            (setf partial (dma-partial-construction-control context))
           (let* ((state (lispterm.display.wayland::window-protocol display))
                  (dma (gethash state lispterm.display.wayland::*dma-protocols*)))
             (check (and dma (lispterm.display.wayland::dma-protocol-formats dma))
                    "Private GLES compositor did not advertise dma-buf formats/modifiers")
             ;; Warm up mapping/configure before writing the exact output-sized frame.
             (dotimes (phase 5)
               (let ((cpu (dma-test-pattern display phase)))
                 (lispterm.display:present display)
                 (dma-pump-until display
                   (lambda () (not (lispterm.display.wayland::wayland-state-frame-pending-p state))) "frame callback")
                 (check (zerop (getf (lispterm.display:display-metrics display) :readbacks 0))
                        "Direct presentation performed a GPU readback")
                 (check (null (lispterm.display::display-framebuffer-storage display))
                        "Direct presentation allocated a CPU composed/readback frame")
                 (check (plusp (lispterm.display.wayland::dma-protocol-presents dma))
                        "Direct path did not present, reason ~S" (lispterm.display.wayland::dma-metrics state))
                 (when (= phase 4) (dma-capture-compare display cpu directory label))))
              (dma-import-transfer-controls display)
             (check (plusp (lispterm.display.wayland::dma-protocol-releases dma)) "No actual wl_buffer.release")
             (check (plusp (lispterm.display.wayland::dma-protocol-reuses dma)) "No released-buffer reuse")
             (check (= (lispterm.display.wayland::dma-protocol-presents dma)
                       (lispterm.display.wayland::dma-protocol-finishes dma)) "Missing GPU completion barrier")
             ;; Force a genuine capability-negative path, which must request readback.
             (let ((lispterm.display.wayland::*dma-force-unsupported* t))
               (dma-test-pattern display 7)
               (lispterm.display:present display)
               (dma-pump-until display
                 (lambda () (not (lispterm.display.wayland::wayland-state-frame-pending-p state))) "fallback frame")
               (check (plusp (getf (lispterm.display:display-metrics display) :readbacks))
                      "Capability-negative presentation did not use GPU readback/SHM"))
             ;; Resize to a new generation without reusing old in-flight images.
             ;; Owned compositor output mode drives the actual configure transaction.
             (fixture-command (list (format nil "SWAYSOCK=~A" (uiop:getenv "SWAYSOCK"))
                                    "swaymsg" "output HEADLESS-1 mode 400x280"))
             (dma-pump-until display (lambda () (= 400 (lispterm.display:display-width display))) "resize configure")
              ;; Connected resize collection must resume after a real GLES error.
              (let ((old (find-if (lambda (b)
                                   (and (not (lispterm.display.wayland::dma-buffer-busy-p b))
                                        (/= (lispterm.display.wayland::dma-buffer-generation b)
                                            (lispterm.display.wayland::wayland-state-generation state))))
                                 (lispterm.display.wayland::dma-protocol-buffers dma)))
                    (caught nil))
                (check old "Resize lacks a released old-generation DMA buffer")
                (lispterm.gpu:gl-bind-texture #xffffffff 0)
                (handler-case (lispterm.display.wayland::dma-collect state dma)
                  (lispterm.gpu:gpu-unavailable () (setf caught t)))
                (check (and caught (member old (lispterm.display.wayland::dma-protocol-buffers dma)))
                       "Connected failed collection lost target ownership")
                (lispterm.display.wayland::dma-collect state dma)
                (lispterm.display.wayland::protocol-roundtrip state)
                (check (not (member old (lispterm.display.wayland::dma-protocol-buffers dma)))
                       "Connected collection retry retained old target")
                (format t "DIRECT CONNECTED resize collection real GL error/retry/roundtrip passed~%"))
             (let ((before (lispterm.display.wayland::dma-protocol-presents dma))
                   (cpu (dma-test-pattern display 8)))
               (lispterm.display:present display)
               (dma-pump-until display
                 (lambda () (and (> (lispterm.display.wayland::dma-protocol-presents dma) before)
                                 (not (lispterm.display.wayland::wayland-state-frame-pending-p state)))) "resized direct frame")
               (dma-capture-compare display cpu directory (concatenate 'string label "-resized")))
             (setf fds (loop for b in (lispterm.display.wayland::dma-protocol-buffers dma)
                             append (copy-list (lispterm.gpu:dma-target-fds
                                               (lispterm.display.wayland::dma-buffer-target b)))))
              (format t "DIRECT METRICS ~S~%" (lispterm.display.wayland::dma-metrics state))
              ;; Real GLES error state must stop checked teardown without losing
              ;; ownership, even though the compositor transport is disconnected.
              (let* ((target (lispterm.display.wayland::dma-buffer-target
                              (first (lispterm.display.wayland::dma-protocol-buffers dma))))
                     (texture (lispterm.gpu::dma-target-texture target))
                     (framebuffer (lispterm.gpu:dma-target-framebuffer target))
                     (owned-fds (copy-list (lispterm.gpu:dma-target-fds target)))
                     (caught nil))
                (lispterm.gpu:gl-bind-texture #xffffffff 0)
                (handler-case (lispterm.display:close-display display)
                  (lispterm.gpu:gpu-unavailable () (setf caught t)))
                (check caught "Real stale GL error did not stop export cleanup")
                (check (and (lispterm.display::display-cleanup-pending-p display)
                            (not (lispterm.display::display-open-p display))
                            (not (lispterm.gpu::context-closed-p context))
                            (eql texture (lispterm.gpu::dma-target-texture target))
                            (eql framebuffer (lispterm.gpu:dma-target-framebuffer target))
                            (equal owned-fds (lispterm.gpu:dma-target-fds target))
                            (lispterm.display:display-backend-state display))
                       "Failed export cleanup lost ownership or claimed quiescence")
                (format t "DIRECT CLEANUP real GL error retained target/FD/context ownership; retry follows~%"))))
      (lispterm.display:close-display display))
    (check (lispterm.gpu::context-closed-p context) "Direct display context survived close")
    (check (and (lispterm.gpu::dma-target-closed-p partial)
                (not (gethash partial lispterm.gpu::*dma-pending-targets*)))
           "Ordinary display close did not retry the retained partial DMA owner")
    (dolist (fd fds)
      (check (handler-case (progn (sb-posix:fcntl fd sb-posix:f-getfd) nil)
               (sb-posix:syscall-error () t)) "Export FD ~D leaked" fd))
    (check (zerop (hash-table-count lispterm.display.wayland::*dma-protocols*)) "Direct protocol state survived close")
    t))

(defun gpu-wayland-dmabuf-check ()
  (dolist (name '("DISPLAY" "WAYLAND_DISPLAY" "WAYLAND_SOCKET"))
    (check (not (uiop:getenv name)) "Inherited endpoint ~A" name))
  (call-with-direct-compositor
   (lambda (directory)
     (dma-one-session directory)
     ;; Fresh open after complete close, with the same verified owned compositor.
     (fixture-command (list (format nil "SWAYSOCK=~A" (uiop:getenv "SWAYSOCK"))
                            "swaymsg" "output HEADLESS-1 mode 320x240"))
     (dma-one-session directory :label "reopened")))
  t)
(register-check "gpu-wayland-dmabuf" #'gpu-wayland-dmabuf-check)
