(in-package #:lispterm.gpu.tests)

(defun dma-pump-until (display predicate label)
  (loop repeat 120 when (funcall predicate) do (return-from dma-pump-until t)
        do (lispterm.display:poll-events display :timeout .025))
  (error "Direct presentation timed out: ~A" label))

(defun dma-test-pattern (display phase)
  (let ((cpu (parity-display (lispterm.display:display-width display)
                             (lispterm.display:display-height display))))
    (dotimes (row (lispterm.display::display-rows display))
      (dotimes (col (lispterm.display::display-columns display))
        (let ((cell (lispterm.display::make-cell
                     :char (char "Ag#W " (mod (+ row col phase) 5))
                     :fg #xe1ab73 :bg (if (evenp (+ row phase)) #x123456 #x675321)
                     :bold (oddp col) :underline (= 2 (mod col 4)))))
          (lispterm.display::render-cpu-cell cpu row col cell)
          (lispterm.display::render-cell display row col cell))))
    cpu))

(defun dma-capture-compare (display cpu directory label)
  ;; Capture the compositor output, not the client's framebuffer. PPM avoids a
  ;; second image decoder in the pixel oracle. Retain PNG for visual inspection.
  (let ((ppm (merge-pathnames (format nil "~A.ppm" label) directory))
        (png (merge-pathnames (format nil "~A.png" label) directory)))
    (fixture-command (list (format nil "XDG_RUNTIME_DIR=~A" (uiop:getenv "XDG_RUNTIME_DIR"))
                           (format nil "WAYLAND_DISPLAY=~A" (uiop:getenv "WAYLAND_DISPLAY"))
                           "grim" "-t" "ppm" (namestring ppm)))
    (fixture-command (list (format nil "XDG_RUNTIME_DIR=~A" (uiop:getenv "XDG_RUNTIME_DIR"))
                           (format nil "WAYLAND_DISPLAY=~A" (uiop:getenv "WAYLAND_DISPLAY"))
                           "grim" (namestring png)))
    (with-open-file (s ppm :element-type '(unsigned-byte 8))
      (flet ((line () (coerce (loop for c = (read-byte s) until (= c 10) collect (code-char c)) 'string)))
        (check (equal "P6" (line)) "Not a PPM screenshot")
        (let* ((dimensions (uiop:split-string (line) :separator '(#\Space)))
               (w (parse-integer (first dimensions))) (h (parse-integer (second dimensions)))
               (pixels (lispterm.display:display-framebuffer cpu)))
          (check (equal "255" (line)) "Unsupported PPM depth")
          (check (and (= w (lispterm.display:display-width display))
                      (= h (lispterm.display:display-height display)))
                 "Compositor screenshot and client size differ: ~Dx~D" w h)
          (dotimes (i (* w h))
            (let ((rgb (logior (ash (read-byte s) 16) (ash (read-byte s) 8) (read-byte s))))
              (check (= rgb (logand #xffffff (aref pixels i)))
                     "Direct screenshot ~A pixel(~D,~D): compositor~6,'0X CPU~6,'0X"
                     label (mod i w) (floor i w) rgb (logand #xffffff (aref pixels i)))))
          (check (null (read-byte s nil)) "PPM trailing bytes")
          (format t "DIRECT SCREENSHOT ~A ~D exact compositor RGB pixels ~A~%" label (* w h) png))))))

(defun dma-one-session (directory &key (label "direct"))
  (let ((display (lispterm.display:open-display :backend :wayland :renderer :gpu :columns 12 :rows 4))
        (fds nil) (context nil))
    (unwind-protect
         (progn
           (setf context (lispterm.display::display-renderer-context display))
           (lispterm.gpu:require-hardware-context context)
           (let* ((state (lispterm.display.wayland::window-protocol display))
                  (dma (gethash state lispterm.display.wayland::*dma-protocols*)))
             (check (and dma (lispterm.display.wayland::dma-protocol-formats dma))
                    "Private GLES compositor did not advertise dma-buf formats/modifiers")
             ;; Warm up mapping/configure before writing the exact output-sized frame.
             (dotimes (phase 5)
               (let ((cpu (dma-test-pattern display phase)))
                 (lispterm.display:present display)
                 (dma-pump-until display
                   (lambda () (not (lispterm.display.wayland::wayland-state-frame-pending-p state))) "frame callback")
                 (check (zerop (getf (lispterm.display:display-metrics display) :readbacks 0))
                        "Direct presentation performed a GPU readback")
                 (check (null (lispterm.display::display-framebuffer-storage display))
                        "Direct presentation allocated a CPU composed/readback frame")
                 (check (plusp (lispterm.display.wayland::dma-protocol-presents dma))
                        "Direct path did not present, reason ~S" (lispterm.display.wayland::dma-metrics state))
                 (when (= phase 4) (dma-capture-compare display cpu directory label))))
             (check (plusp (lispterm.display.wayland::dma-protocol-releases dma)) "No actual wl_buffer.release")
             (check (plusp (lispterm.display.wayland::dma-protocol-reuses dma)) "No released-buffer reuse")
             (check (= (lispterm.display.wayland::dma-protocol-presents dma)
                       (lispterm.display.wayland::dma-protocol-finishes dma)) "Missing GPU completion barrier")
             ;; Force a genuine capability-negative path, which must request readback.
             (let ((lispterm.display.wayland::*dma-force-unsupported* t))
               (dma-test-pattern display 7)
               (lispterm.display:present display)
               (dma-pump-until display
                 (lambda () (not (lispterm.display.wayland::wayland-state-frame-pending-p state))) "fallback frame")
               (check (plusp (getf (lispterm.display:display-metrics display) :readbacks))
                      "Capability-negative presentation did not use GPU readback/SHM"))
             ;; Resize to a new generation without reusing old in-flight images.
             ;; Owned compositor output mode drives the actual configure transaction.
             (fixture-command (list (format nil "SWAYSOCK=~A" (uiop:getenv "SWAYSOCK"))
                                    "swaymsg" "output HEADLESS-1 mode 400x280"))
             (dma-pump-until display (lambda () (= 400 (lispterm.display:display-width display))) "resize configure")
             (let ((before (lispterm.display.wayland::dma-protocol-presents dma))
                   (cpu (dma-test-pattern display 8)))
               (lispterm.display:present display)
               (dma-pump-until display
                 (lambda () (and (> (lispterm.display.wayland::dma-protocol-presents dma) before)
                                 (not (lispterm.display.wayland::wayland-state-frame-pending-p state)))) "resized direct frame")
               (dma-capture-compare display cpu directory (concatenate 'string label "-resized")))
             (setf fds (loop for b in (lispterm.display.wayland::dma-protocol-buffers dma)
                             append (copy-list (lispterm.gpu:dma-target-fds
                                               (lispterm.display.wayland::dma-buffer-target b)))))
              (format t "DIRECT METRICS ~S~%" (lispterm.display.wayland::dma-metrics state))
              ;; Real GLES error state must stop checked teardown without losing
              ;; ownership, even though the compositor transport is disconnected.
              (let* ((target (lispterm.display.wayland::dma-buffer-target
                              (first (lispterm.display.wayland::dma-protocol-buffers dma))))
                     (texture (lispterm.gpu::dma-target-texture target))
                     (framebuffer (lispterm.gpu:dma-target-framebuffer target))
                     (owned-fds (copy-list (lispterm.gpu:dma-target-fds target)))
                     (caught nil))
                (lispterm.gpu:gl-bind-texture #xffffffff 0)
                (handler-case (lispterm.display:close-display display)
                  (lispterm.gpu:gpu-unavailable () (setf caught t)))
                (check caught "Real stale GL error did not stop export cleanup")
                (check (and (lispterm.display::display-cleanup-pending-p display)
                            (not (lispterm.display::display-open-p display))
                            (not (lispterm.gpu::context-closed-p context))
                            (eql texture (lispterm.gpu::dma-target-texture target))
                            (eql framebuffer (lispterm.gpu:dma-target-framebuffer target))
                            (equal owned-fds (lispterm.gpu:dma-target-fds target))
                            (lispterm.display:display-backend-state display))
                       "Failed export cleanup lost ownership or claimed quiescence")
                (format t "DIRECT CLEANUP real GL error retained target/FD/context ownership; retry follows~%"))))
      (lispterm.display:close-display display))
    (check (lispterm.gpu::context-closed-p context) "Direct display context survived close")
    (dolist (fd fds)
      (check (handler-case (progn (sb-posix:fcntl fd sb-posix:f-getfd) nil)
               (sb-posix:syscall-error () t)) "Export FD ~D leaked" fd))
    (check (zerop (hash-table-count lispterm.display.wayland::*dma-protocols*)) "Direct protocol state survived close")
    t))

(defun gpu-wayland-dmabuf-check ()
  (dolist (name '("DISPLAY" "WAYLAND_DISPLAY" "WAYLAND_SOCKET"))
    (check (not (uiop:getenv name)) "Inherited endpoint ~A" name))
  (call-with-direct-compositor
   (lambda (directory)
     (dma-one-session directory)
     ;; Fresh open after complete close, with the same verified owned compositor.
     (fixture-command (list (format nil "SWAYSOCK=~A" (uiop:getenv "SWAYSOCK"))
                            "swaymsg" "output HEADLESS-1 mode 320x240"))
     (dma-one-session directory :label "reopened")))
  t)
(register-check "gpu-wayland-dmabuf" #'gpu-wayland-dmabuf-check)
