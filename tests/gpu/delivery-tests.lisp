(in-package #:lispterm.gpu.tests)
(eval-when (:compile-toplevel :load-toplevel :execute) (require :sb-posix))

(defun trimmed-git (root &rest args)
  (string-trim '(#\Newline #\Return) (apply #'git-output root args)))

(defun read-bounded-data (path)
  (with-open-file (stream path)
    (check (<= (file-length stream) 1048576) "Oversized delivery receipt: ~A" path)
    (let ((*read-eval* nil))
      (let ((value (read stream t nil)))
        (check (eq :eof (read stream nil :eof)) "Trailing receipt data: ~A" path)
        value))))

(defun check-preservation (outer manifest)
  (let ((main (pathname (getf manifest :root))))
    (check (equal (getf manifest :status)
                  (git-output main "status" "--porcelain=v1" "-z" "--untracked-files=all"))
           "Main checkout's preserved dirty status changed")
    (dolist (entry (getf manifest :files))
      (let* ((path (getf entry :path))
             (file (merge-pathnames path main))
             (stat (sb-posix:lstat file)))
        (check (sb-posix:s-isreg (sb-posix:stat-mode stat)) "Not a regular preserved file: ~A" path)
        (check (= (getf entry :mode) (sb-posix:stat-mode stat)) "Mode changed: ~A" path)
        (check (= (getf entry :size) (sb-posix:stat-size stat)) "Size changed: ~A" path)
        (check (equal (getf entry :blob) (trimmed-git main "hash-object" "--" path))
               "Contents changed: ~A" path)
        (check (equal (getf entry :blob)
                      (trimmed-git main "hash-object" "--"
                                   (namestring (merge-pathnames path (merge-pathnames "preserved/" outer)))))
               "Preserved content snapshot changed: ~A" path))))
  t)

(defun check-early-preservation ()
  "Verify the actual CPU checkout before integration, independently of delivery."
  (let* ((outer (uiop:pathname-parent-directory-pathname *root*))
         (manifest (read-bounded-data (merge-pathnames "preservation.sexp" outer)))
         (main (pathname (getf manifest :root))))
    (check (equal *cpu-baseline* (getf manifest :initial-head)) "Unexpected preservation baseline")
    (check (equal *cpu-baseline* (trimmed-git main "rev-parse" "HEAD"))
           "Main HEAD changed before integration")
    (check (= 21 (length (getf manifest :files))) "Expected all 21 preserved source files")
    ;; CHECK-PRESERVATION lstats and hashes the originals, including executable
    ;; modes. Backup content is checked too, but backup modes are not originals.
    (check-preservation outer manifest))
  t)

(register-check "gpu-preservation" #'check-early-preservation)

(defun check-delivery ()
  ;; Evidence lives outside the committed tree, avoiding a commit that must name itself.
  ;; The orchestrator authenticates reviewer provenance before supplying this receipt.
  (let* ((outer (uiop:pathname-parent-directory-pathname *root*))
         (manifest (read-bounded-data (merge-pathnames "preservation.sexp" outer)))
         (main (pathname (getf manifest :root)))
         (revision (trimmed-git *root* "rev-parse" "HEAD")))
    (check (equal *cpu-baseline* (getf manifest :initial-head)) "Unexpected CPU baseline")
    (check (equal revision (trimmed-git main "rev-parse" "HEAD"))
           "Main HEAD differs from tested implementation HEAD")
    (check (equal "" (git-output *root* "status" "--porcelain=v1" "--untracked-files=all"))
           "Test tree is not clean")
    (check-preservation outer manifest)
    (let* ((review (read-bounded-data (merge-pathnames "independent-review.sexp" outer)))
           (evidence (getf review :evidence-path)))
      (check (equal revision (getf review :revision)) "Review is not bound to final revision")
      (check (and (eq :independent-review (getf review :role))
                  (eq :passed (getf review :status))
                  (stringp (getf review :reviewer))
                  (plusp (length (getf review :reviewer))))
             "Missing successful independent review identity")
      (check (and (stringp evidence) (uiop:absolute-pathname-p evidence)
                  (probe-file evidence)) "Missing independent review artifact")
      (with-open-file (stream evidence)
        (check (plusp (file-length stream)) "Empty independent review artifact"))
      (check (equal (getf review :evidence-blob)
                    (trimmed-git *root* "hash-object" "--" evidence))
             "Independent review artifact digest differs")))
  t)

(register-check "gpu-delivery" #'check-delivery)
