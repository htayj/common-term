(in-package #:lispterm.gpu.tests)

(defun call-with-direct-compositor (function)
  "Start and verify a private headless hardware GLES compositor, then reap it."
  (let* ((runtime (loop for name = (format nil "/tmp/ltd-~36R" (random (expt 36 10)))
                        when (handler-case (progn (sb-posix:mkdir name #o700) t)
                               (sb-posix:syscall-error () nil)) return name))
         (directory (merge-pathnames (format nil ".build/direct-~D-~D/" (sb-posix:getpid) (get-internal-real-time)) *root*))
         (config (merge-pathnames "sway.conf" directory))
         (log (merge-pathnames "sway.log" directory)) (process nil) (pid nil)
         (settings '("XDG_RUNTIME_DIR" "WAYLAND_DISPLAY" "SWAYSOCK" "DISPLAY" "WAYLAND_SOCKET"))
         (old (mapcar (lambda (name) (cons name (uiop:getenv name))) settings)))
    (unwind-protect
         (progn
           (ensure-directories-exist directory)
           (with-open-file (s config :direction :output :if-exists :error)
             (format s "output HEADLESS-1 mode 320x240~%default_border none~%default_floating_border none~%seat seat0 fallback true~%"))
           (setf process
                 (uiop:launch-program
                  (list "env" "-u" "DISPLAY" "-u" "WAYLAND_DISPLAY" "-u" "WAYLAND_SOCKET"
                        "-u" "SWAYSOCK" "-u" "XAUTHORITY" "-u" "DBUS_SESSION_BUS_ADDRESS"
                        (format nil "XDG_RUNTIME_DIR=~A" runtime)
                        "WLR_BACKENDS=headless" "WLR_HEADLESS_OUTPUTS=1" "WLR_RENDERER=gles2"
                        "WLR_RENDER_DRM_DEVICE=/dev/dri/renderD128" "WLR_LIBINPUT_NO_DEVICES=1"
                        "sway" "--unsupported-gpu" "-d" "-c" (namestring config))
                  :directory *root* :input nil :output log :error-output :output)
                 pid (uiop:process-info-pid process))
           (fixture-wait (lambda ()
                           (check (uiop:process-alive-p process) "Direct GLES compositor exited; inspect ~A" log)
                           (probe-file (format nil "~A/wayland-1" runtime)))
                         "owned direct GLES compositor")
           (let ((socket (format nil "~A/wayland-1" runtime))
                 (ipc (format nil "~A/sway-ipc.~D.~D.sock" runtime (sb-posix:getuid) pid)))
             (fixture-wait (lambda () (fixture-socket-owner-p pid ipc)) "owned compositor IPC")
             (check (fixture-socket-owner-p pid socket) "Direct compositor socket owner differs")
             (let ((stat (sb-posix:stat runtime))
                   (environment (uiop:split-string (uiop:read-file-string (format nil "/proc/~D/environ" pid))
                                                   :separator '(#\Null))))
               (check (and (= (sb-posix:stat-uid stat) (sb-posix:getuid))
                           (= #o700 (logand #o777 (sb-posix:stat-mode stat)))) "Unsafe direct runtime")
               (dolist (prefix '("DISPLAY=" "WAYLAND_DISPLAY=" "WAYLAND_SOCKET="))
                 (check (notany (lambda (entry) (uiop:string-prefix-p prefix entry)) environment)
                        "Direct compositor inherited ~A" prefix))
               (dolist (setting '("WLR_BACKENDS=headless" "WLR_RENDERER=gles2"
                                  "WLR_RENDER_DRM_DEVICE=/dev/dri/renderD128"))
                 (check (member setting environment :test #'equal) "Missing explicit compositor setting ~A" setting)))
             (sb-posix:setenv "XDG_RUNTIME_DIR" runtime 1)
             (sb-posix:setenv "WAYLAND_DISPLAY" socket 1)
             (sb-posix:setenv "SWAYSOCK" ipc 1)
             (sb-posix:unsetenv "DISPLAY") (sb-posix:unsetenv "WAYLAND_SOCKET")
             (let ((outputs (fixture-command (list (format nil "SWAYSOCK=~A" ipc) "swaymsg" "-t" "get_outputs" "-r"))))
               (check (and (search "HEADLESS-1" outputs) (search "320" outputs))
                      "Direct fixture lacks configured output")
               (with-open-file (s (merge-pathnames "outputs.json" directory) :direction :output :if-exists :error)
                 (write-string outputs s)))
             (let ((text (uiop:read-file-string log)))
               (check (and (search "GL renderer:" text) (search "AMD Radeon" text)
                           (not (search "llvmpipe" text :test #'char-equal)))
                      "Direct compositor lacks actual hardware GLES renderer: ~A" log))
             (format t "DIRECT FIXTURE pid=~D socket-owner verified, hardware GLES AMD, renderD128, private runtime ~A~%" pid runtime)
             (funcall function directory)))
      (dolist (setting old)
        (if (cdr setting) (sb-posix:setenv (car setting) (cdr setting) 1)
            (sb-posix:unsetenv (car setting))))
      (when process
        (when (uiop:process-alive-p process) (uiop:terminate-process process))
        (uiop:wait-process process)
        (check (not (uiop:process-alive-p process)) "Direct compositor survived reap"))
      (uiop:delete-directory-tree (uiop:ensure-directory-pathname runtime) :validate t))))
