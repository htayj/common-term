;;;; Mock-only controls for LOAD-CASE-CONTEXT single reads and CONTEXT-TIMING over
;;;; supplied barriers. Synthetic recorder data; never native or pixel proof.
;;;; Load after vttest-keyboard-timing-tests.lisp (MOCK-PROOFS; SAVE-EVENTS from
;;;; vttest-keyboard-evidence-tests.lisp), vttest-keyboard-prerequisites.lisp and
;;;; vttest-keyboard-context.lisp. Entry point: (CONTEXT-CONTROLS).
(in-package :vttest-keyboard-driver-tests)
(load (merge-pathnames "vttest-keyboard-context-fixtures.lisp" *load-truename*))

(defun loader-positive (dir label)
  (multiple-value-bind (ctx state reads data events calls) (counted-load label dir)
    (let* ((names (capture-names events))
           (transcript (c::cat dir label ".transcript.raw"))
           (barrier-paths (mapcar (lambda (n) (c::cat dir n ".barrier.sexp")) names))
           (octets (vttest-cursor-driver::bytes transcript)))
      (check (and ctx (eq state :pass)) (list label :context-pass))
      (when ctx
        (check (and (equal label (k::case-context-label ctx)) (equal dir (k::case-context-dir ctx))
                    (null (k::case-context-oracle-octets ctx)))
               (list label :context-identity-oracle-octets-nil))
        (check (eq events (k::case-context-events ctx)) (list label :same-events-object))
        (check (and (equal names (mapcar #'car (k::case-context-barriers ctx)))
                    (= (length names) (length (k::capture-ids label)))
                    (every (lambda (b p) (eq (cdr b) (gethash p data)))
                           (k::case-context-barriers ctx) barrier-paths))
               (list label :same-barrier-objects-in-event-order))
        (let ((out (k::case-context-output ctx)))
          (check (and (stringp out) (plusp (length out)) (= (length out) (length octets))
                      (every (lambda (ch o) (= (char-code ch) o)) out octets))
                 (list label :output-code-char-per-octet))))
      (check (and (= 1 calls)
                  (= 1 (gethash (c::cat dir label ".events.sexp") reads 0))
                  (= 1 (gethash transcript reads 0))
                  (every (lambda (p) (= 1 (gethash p reads 0))) barrier-paths)
                  (= (+ 2 (length names)) (hash-table-count reads)))
             (list label :one-read-per-input)))))

(defun loader-status-controls (label)
  (macrolet ((try (state key ctx-p &body body)
               `(expect-load (mutate label (lambda (d n) (declare (ignorable d n)) ,@body))
                             label ,state ,key ,key ,ctx-p)))
    (flet ((file (d stem suffix) (c::cat d stem suffix))
           (link (path) (sb-posix:unlink path) (sb-posix:symlink "/dev/null" path)))
      (expect-load nil label :unverified :no-run-directory :no-run-directory nil)
      (expect-load (string-right-trim "/" (fresh-dir)) label :fail :run-directory :run-directory nil)
      (expect-load (fresh-dir) "keyboard-none" :fail :unknown-label :unknown-label nil)
      (try :unverified :missing-events nil (sb-posix:unlink (file d label ".events.sexp")))
      (try :unverified :missing-transcript nil (sb-posix:unlink (file d label ".transcript.raw")))
      (let ((ctx (try :unverified :missing-barrier t (sb-posix:unlink (file d n ".barrier.sexp")))))
        (check (and ctx (= (1+ (length (k::case-context-barriers ctx)))
                           (length (k::capture-ids label))))
               (list label :missing-barrier-entry-absent)))
      (try :fail :malformed-events nil (put-bytes (file d label ".events.sexp") "(:kind"))
      (try :fail :malformed-barrier nil
           (c:write-value (file d n ".barrier.sexp") '(:recorder-version)))
      (try :fail :unsafe-barrier nil (link (file d n ".barrier.sexp")))
      (try :fail :unsafe-transcript nil (link (file d label ".transcript.raw")))
      (dolist (bad (list "Bad-Name" (format nil "001-~a-keys0-up" (other-label label))
                         (format nil "999-~a-keys9-none" label)))
        (try :fail :unowned-capture nil (rename-first d label bad)))
      (try :fail :duplicate-capture nil
           (edit-first-capture d label (lambda (e) (list e (copy-list e))))))))

(defun timing-context-controls (label)
  (let* ((dir (fresh-dir)) (ctx (k::load-case-context label dir)) (scale k::+timing-scale+)
         (events (and ctx (k::case-context-events ctx)))
         (output (and ctx (k::case-context-output ctx)))
         (barriers (and ctx (k::case-context-barriers ctx))))
    (flet ((expect (state key tag at-scale &rest keys)
             (multiple-value-bind (s reasons touched)
                 (apply #'timing-without-barrier-reads label dir events output at-scale keys)
               (check (and ctx (eq s state) (not touched) (or (null key) (reason-p key reasons)))
                      (list label :context-timing tag)))))
      (expect :pass nil :supplied-barriers scale :barriers barriers)
      (expect :fail nil :scale-mismatch 2 :barriers barriers)
      (expect :unverified :missing-barrier :explicit-nil-not-disk scale :barriers nil)
      (expect :unverified :missing-barrier :missing-entry scale :barriers (rest barriers))
      (let ((bad (copy-tree barriers)))
        (setf (getf (cdr (first bad)) :before-frame) 2)
        (expect :fail nil :mismatched-barrier scale :barriers bad))
      (check (eq :pass (k::context-timing label dir events output scale))
             (list label :positional-context-timing))
      (check (eq :pass (k::case-timing label dir (k::case-bytes label dir) scale))
             (list label :positional-case-timing))
      (check (eq :unverified (k::context-timing label nil events output scale :barriers barriers))
             (list label :context-timing-no-run-directory))
      (sb-posix:unlink (c::cat dir (first (capture-names events)) ".external.sexp"))
      (expect :unverified :missing-capture-proof :missing-proof-file scale :barriers barriers))))

(defun context-controls ()
  (let ((originals (mapcar #'symbol-function *context-stubbed*)))
    (check (eq :disabled k::*proof-trace*) :proof-trace-default-disabled)
    (dolist (label '("keyboard-cursor" "keyboard-keypad"))
      (loader-positive (fresh-dir) label)
      (loader-status-controls label)
      (timing-context-controls label))
    (check (and (eq :disabled k::*proof-trace*)
                (every #'eq originals (mapcar #'symbol-function *context-stubbed*)))
           :context-stubs-and-trace-restored)))
