;;;; Missing cleanup evidence controls. Definitions only; all fixtures are synthetic.
(in-package #:vttest-keyboard-driver-tests)

(defun check-cleanup-summary (backend root record expected failed label)
  (multiple-value-bind (observations evidence)
      (k:summarize-native (k:make-manifest backend) record 3 root)
    (check (and (eq (getf evidence :cleanup) expected)
                (eql (getf evidence :native-failed) failed)
                (equal (getf evidence :native-record) record)
                (null (getf evidence :receipt-error))
                (getf evidence :cleanup-reasons)
                (zerop (getf (getf evidence :counts) :passed))
                (every (lambda (o) (and (not (getf o :fresh))
                                       (eq (getf o :pixels) :unverified)
                                       (eq (getf o :timing) :unverified))) observations))
           (list backend label))))

(defun cleanup-no-root-controls (backend)
  (multiple-value-bind (root launch exit raw) (cleanup-fixture backend)
    (declare (ignore raw))
    (multiple-value-bind (status reasons projection)
        (k::consume-gate-cleanup root backend launch exit)
      (declare (ignore reasons))
      (check (eq status :pass) (list backend :no-root-baseline))
      (let ((record (cleanup-native-record root backend projection)))
        (check-cleanup-summary backend nil record :unverified nil :no-root-positive)
        (dolist (axis (if (equal backend "wayland") '(:state :owned :wayland-holder)
                         '(:state :owned)))
          (let* ((bad (copy-tree record)) (claim (getf bad :cleanup)))
            (ecase axis
              (:state (setf (getf claim :state) :failed))
              (:owned (setf (getf (first (getf claim :owned)) :state) :failed))
              (:wayland-holder (setf (getf claim :wayland-holder) :failed)))
            (check-cleanup-summary backend nil bad :fail t (list :no-root-failure axis))))))))

(defun cleanup-linkage-controls (backend)
  (dolist (variant '(:absent :wrong-digest :unsafe :malformed))
    (multiple-value-bind (root launch exit raw) (cleanup-fixture backend (recorder))
      (multiple-value-bind (status reasons projection)
          (k::consume-gate-cleanup root backend launch exit)
        (declare (ignore reasons))
        (check (eq status :pass) (list backend variant :linkage-baseline))
        (let* ((record (cleanup-native-record root backend (copy-tree projection)))
               (path (c::cat root "recorder/cleanup-receipt.sexp"))
               (retained (c::cat root "recorder/cleanup-receipt.retained.sexp")))
          (check-cleanup-summary backend root record :pass nil (list variant :linked))
          (unwind-protect
               (progn
                 (ecase variant
                   (:absent (rename-file path retained))
                   (:wrong-digest
                    (setf (getf (getf record :cleanup) :receipt-sha256)
                          (make-string 64 :initial-element #\b)))
                   (:unsafe (rename-file path retained) (sb-posix:symlink retained path))
                     (:malformed
                       (put-bytes path "(:kind")
                       (setf (getf (getf record :cleanup) :receipt-sha256) (k::digest path))))
                 (if (eq variant :absent)
                     (check-cleanup-summary backend root record :unverified nil :absent-raw-integration)
                     (multiple-value-bind (obs evidence)
                         (k:summarize-native (k:make-manifest backend) record 3 root)
                       (check (and (getf evidence :native-failed)
                                   (zerop (getf (getf evidence :counts) :passed))
                                   (every (lambda (o) (not (getf o :fresh))) obs))
                              (list backend variant :contradiction-retained)))))
            (when (eq variant :unsafe) (sb-posix:unlink path))
            (when (member variant '(:absent :unsafe)) (rename-file retained path))
            (write-cleanup root raw))
          (check-cleanup-summary backend root (cleanup-native-record root backend projection)
                                 :pass nil (list variant :restored)))))))

(defun omit-cleanup-field (raw section key)
  (ecase section
    (:top (remf raw key))
    (:launch (remf (getf raw :launch) key))
    (:owned (remf (first (getf raw :owned)) key)))
  raw)

(defun cleanup-field-controls (backend)
  (multiple-value-bind (root launch exit raw) (cleanup-fixture backend)
    (check (eq :pass (k::consume-gate-cleanup root backend launch exit))
           (list backend :field-baseline))
    (dolist (field '((:top :version) (:top :phase) (:top :launch-valid)
                     (:top :adoption-failures) (:launch :gate-start) (:launch :title)
                     (:owned :wait-status) (:owned :direct) (:owned :start)))
      (dolist (contradiction '(nil :binding :survivor :failed :exit))
        (cleanup-mutation
         root backend launch exit raw (if contradiction :fail :unverified)
         (list backend :omitted field :contradiction contradiction)
         (lambda (l e r)
           (declare (ignore l))
           (omit-cleanup-field r (first field) (second field))
           (case contradiction
             (:binding (setf (getf (getf r :launch) :artifacts) "/foreign/recorder"))
             (:survivor (setf (getf r :stop-owned) :survived))
             (:failed (setf (getf r :state) :failed))
             (:exit (setf (getf e :exit-code) 7)))))))
    (check (eq :pass (k::consume-gate-cleanup root backend launch exit))
           (list backend :field-baseline-restored))))

(defun cleanup-role-zombie-controls (backend)
  (multiple-value-bind (root launch exit raw) (cleanup-fixture backend)
    (check (eq :pass (k::consume-gate-cleanup root backend launch exit))
           (list backend :role-zombie-baseline))
    ;; Cover every backend root, including the non-direct Wayland compositor.
    (dolist (original (getf raw :owned))
      (let* ((role (getf original :role)) (direct (getf original :direct))
             (changed (copy-tree raw))
             (row (find role (getf changed :owned) :key (lambda (o) (getf o :role)) :test #'equal)))
        (remf row :direct)
        (setf (getf row :observed) :zombie)
        (unwind-protect
             (progn
               (write-cleanup root changed)
               (multiple-value-bind (status reasons projection)
                   (k::consume-gate-cleanup root backend launch exit)
                 (check (and (eq status (if direct :fail :unverified))
                             (member :missing-cleanup-fields reasons)
                             (eql (not (null (member :owned-survivor-or-unreaped reasons))) direct)
                             (not (k::cleanup-present-p
                                   (find role (getf projection :owned)
                                         :key (lambda (o) (getf o :role)) :test #'equal)
                                   :direct)))
                        (list backend role :omitted-direct-zombie))))
          (write-cleanup root raw))))
    (check (eq :pass (k::consume-gate-cleanup root backend launch exit))
           (list backend :role-zombie-restored))))

(defun cleanup-evidence-controls ()
  (dolist (backend '("x11" "wayland"))
    (cleanup-no-root-controls backend)
    (cleanup-linkage-controls backend)
    (cleanup-field-controls backend)
    (cleanup-role-zombie-controls backend)))
