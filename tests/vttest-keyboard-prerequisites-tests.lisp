;;;; Controls for CASE-REPLY-END/CASE-TARGETS; need CHECK, row-output. ^ is ESC.
(in-package :vttest-keyboard-driver-tests)

(defun pre-x (s) (substitute (code-char 27) #\^ s))
(defun pre-kind (e) (getf e :kind))

(defun pre-row (echo name col label)
  (pre-x (format nil "^[23;1H^[0K^[23;1H^[7m ~a ^[m^[7m (~a key) ^[m^[1;~dH~a"
                 echo name col label)))

(defparameter *pre-keys*
  '(("Up" "A" "Up arrow" 57 "UP") ("Down" "B" "Down arrow" 62 "DN")
    ("Left" "D" "Left arrow" 67 "LT") ("Right" "C" "Right arrow" 72 "RT")))
(defparameter *pre-head* (pre-x "^[cPress each cursor key."))
(defparameter *pre-tab* (pre-x "^[23;1H^[0K^[23;1H^[7m <9> ^[m"))
(defparameter *pre-up* (pre-row "<27> [ A" "Up arrow" 57 "UP"))

(defun pre-run (&key (stale "") (extra "") (first-phase "keys-0") (first-key "Up") late)
  (let ((out "") (events nil) (barriers nil) (n 0) (phase "startup") (begins 0))
    (labels ((e (kind &rest args) (push (list* :kind kind :phase phase :out (length out) args) events))
             (w (text) (e :wire-out :bytes text) (setf out (concatenate 'string out text)))
             (key (k text)
               (if (plusp begins)
                   (e :key-begin :key k)
                   (push (list :kind :key-begin :phase first-phase :key first-key :out (length out))
                         events))
               (when (zerop begins)
                 (when late (e late :source :reply :bytes "r"))
                 (w extra))
               (incf begins)
               (e :wire-in :source :input :bytes "k") (w text) (e :key-end :key k))
             (shot (id)
               (let ((name (format nil "~3,'0d-keyboard-cursor-~a" (incf n) id))
                     (b (list :target-output (length out) :frames n)))
                 (e :capture :name name :barrier b)
                 (push (cons name b) barriers))))
      (w (subseq *pre-head* 0 3))
      (e :enqueue :source :reply :bytes "r") (e :wire-in :source :reply :bytes "r")
      (w stale) (w (subseq *pre-head* 3))
      (dotimes (p 3)
        (setf phase (format nil "keys-~d" p)) (e :phase)
        (loop for (k b name col label) in *pre-keys*
              do (key k (pre-row (format nil "<27> ~a~a" (nth p '("[ " "O " "")) b) name col label))
                 (shot (format nil "keys~d-~(~a~)" p k)))
        (key "Tab" *pre-tab*))
      (w (pre-x "^[23;1H^[0KPush <RETURN>")) (shot "pause01")
      (values (nreverse events) (reverse barriers) out))))

(defun pre-end (events) (multiple-value-list (k::case-reply-end "keyboard-cursor" events)))
(defun pre-targets (events barriers output end)
  (multiple-value-list (k::case-targets "keyboard-cursor" events barriers output end)))
(defun pre-rows (output end targets)
  (vttest-keyboard-row-output:case-row-output-errors "keyboard-cursor" output end targets))
(defun pre-capture (events i) (nth i (remove :capture events :key #'pre-kind :test-not #'eq)))
(defun pre-circular (list) (let ((l (copy-list list))) (setf (cdr (last l)) l) l))
(defun pre-put (plist key value)
  (setf (getf plist key) value) plist)

(defun pre-retarget (events barriers i target)
  (let ((ev (copy-tree events)) (bs (copy-tree barriers)))
    (setf (getf (cdr (nth i bs)) :target-output) target)
    (pre-put (pre-capture ev i) :barrier (copy-list (cdr (nth i bs))))
    (values ev bs)))

(defun pre-no (result reason name) (check (equal (list nil reason) result) name))
(defun prerequisite-controls (&aux events barriers out end ts)
  (setf (values events barriers out) (pre-run)
        end (length *pre-head*)
        ts (first (pre-targets events barriers out end)))
  (check (equal (list end nil) (pre-end events)) :r1-first-key-begin)
  (check (and (= 13 (length ts)) (= (first ts) (+ end (length *pre-up*)))
              (= (car (last ts)) (length out)) (null (pre-rows out end ts)))
         :r1-chain)
  (let ((bad (copy-list ts)))
    (setf (nth 4 bad) (+ (nth 3 ts) (length *pre-tab*)))
    (check (equal '(("keys1-up" :tab-residue))
                  (remove "keys1-up" (pre-rows out end bad) :key #'car :test-not #'equal))
           :t7-tab-residue))
  (pre-no (pre-end (remove :key-begin events :key #'pre-kind)) :no-key-begin :r2-no-key)
  (pre-no (pre-end (pre-run :first-phase "keys-1")) :first-key :r3-phase)
  (pre-no (pre-end (pre-run :first-key "Down")) :first-key :r3-key)
  (pre-no (pre-end (pre-run :late :wire-in)) :reply-after-key :r4-wire-in)
  (pre-no (pre-end (pre-run :late :enqueue)) :reply-after-key :r4-enqueue)
  (let ((ev (copy-tree events)))
    (pre-put (find :key-begin ev :key #'pre-kind) :out "9")
    (pre-no (pre-end ev) :boundary :r-boundary-type))
  (dolist (bad (list (cons 7 events) (cons '(:kind) events) (cons '(:kind . :key-begin) events)
                     (append events :tail) (pre-circular events)
                     (cons (pre-circular '(:kind :key-begin)) events) :malformed))
    (pre-no (pre-end bad) :arguments :r5-shape))
  (pre-no (multiple-value-list (k::case-reply-end "keyboard-other" events)) :arguments :r5-label)
  (multiple-value-bind (ev bs o) (pre-run :stale *pre-up*)
    (let* ((e (first (pre-end ev))) (s (first (pre-targets ev bs o e)))
           (wire (getf (find :wire-in ev :key #'pre-kind) :out)))
      (check (and (= e (+ end (length *pre-up*))) (null (pre-rows o e s))) :r6-stale-excluded)
      (check (equal '("keys0-up" :row-erase-count) (first (pre-rows o wire s)))
             :r6-wire-in-boundary-fails)))
  (multiple-value-bind (ev bs o) (pre-run :extra (pre-x "^[23;1H^[0K"))
    (let ((e (first (pre-end ev))))
      (check (equal '(("keys0-up" :row-erase-count))
                    (pre-rows o e (first (pre-targets ev bs o e))))
             :r7-extra-erase)))
  (dolist (d '(1 -1))
    (multiple-value-bind (ev bs) (pre-retarget events barriers 2 (+ d (nth 2 ts)))
      (pre-no (pre-targets ev bs out end) :target-out-mismatch :t1-off-by-one)))
  (let ((bs (copy-tree barriers)))
    (setf (getf (cdr (nth 2 bs)) :frames) 99)
    (pre-no (pre-targets events bs out end) :barrier-mismatch :t2-barrier))
  (pre-no (pre-targets events (remove (nth 5 barriers) barriers) out end) :missing-barrier :t3-one)
  (pre-no (pre-targets events nil out end) :missing-barrier :t3-all)
  (multiple-value-bind (ev bs) (pre-retarget events barriers 1 (first ts))
    (pre-put (pre-capture ev 1) :out (first ts))
    (pre-no (pre-targets ev bs out end) :target-order :t4-equal-targets))
  (pre-no (pre-targets events barriers out (first ts)) :target-order :t4-reply-end)
  (pre-no (pre-targets events barriers (subseq out 1) end) :target-range :t5-range)
  (let ((ev (copy-list events)))
    (rotatef (nth (position (pre-capture ev 0) ev) ev) (nth (position (pre-capture ev 1) ev) ev))
    (pre-no (pre-targets ev barriers out end) :capture-inventory :t6-order))
  (pre-no (pre-targets (remove (pre-capture events 3) events) barriers out end)
          :capture-inventory :t6-missing-capture)
  (let ((ev (copy-tree events)))
    (pre-put (pre-capture ev 0) :name "001-keyboard-keypad-keys0-up")
    (pre-no (pre-targets ev barriers out end) :capture-inventory :t6-foreign-name))
  (pre-no (pre-targets events (cons (first barriers) barriers) out end) :barrier-inventory :t6-duplicate)
  (pre-no (pre-targets events (acons "099-keyboard-cursor-keys9-up" '(:target-output 1) barriers) out end)
          :barrier-inventory :t6-unknown-barrier)
  (multiple-value-bind (ev bs) (pre-retarget events barriers 0 "12")
    (pre-no (pre-targets ev bs out end) :target-type :t-target-string))
  (let ((ev (copy-tree events)))
    (pre-put (pre-capture ev 4) :out nil)
    (pre-no (pre-targets ev (remove (nth 4 barriers) barriers) out end) :target-type :t-unbarriered-out))
  (dolist (args (list (list (cons 'x barriers) out end) (list (cons '("n" :target-output) barriers) out end)
                      (list (append barriers :tail) out end) (list (pre-circular barriers) out end)
                      (list barriers (coerce out 'list) end) (list barriers out -1)))
    (pre-no (apply #'pre-targets events args) :arguments :t-argument-shape))
  (pre-no (pre-targets (pre-circular events) barriers out end) :arguments :t-circular-events))
