(load (merge-pathnames "vttest-vt52-navigation.lisp" *load-truename*))
(defpackage #:vttest-vt52-navigation-tests
  (:use #:cl) (:export #:run-tests))
(in-package #:vttest-vt52-navigation-tests)

(defun bytes (text) (map '(vector (unsigned-byte 8)) #'char-code text))
(defparameter *outer*
  (format nil "Test of terminal response to IDENTIFY command~%Response was <27> / Z -- OK (means VT100 emulating VT52)~%Push <RETURN>"))
(defparameter *menu*
  (format nil "Choose test type:~%7. Test of VT52 mode~%Enter choice number (0 - 12): "))

(defun wires (output cuts &optional (owner 42))
  (let ((start 0) (seq 0))
    (mapcar (lambda (end)
              (prog1 (list :seq (incf seq) :kind :wire-out :pause 2 :time seq
                           :out start :in 1 :start start :end end
                           :bytes (subseq output start end) :source nil :child-pid owner)
                (setf start end))) cuts)))

(defun run-tests ()
  (let ((checks 0))
    (labels ((check (truth) (incf checks) (unless truth (error "Check ~D" checks)))
             (gate (o e &optional (start 0) (stage :outer-hold) (owner 42))
               (vttest-vt52-navigation:vt52-navigation-check o e start owner stage))
             (state (want o &optional (stage :outer-hold) (start 0))
               (check (eq want (getf (gate o (if (plusp (length o))
                                                 (wires o (list (length o))) nil)
                                          start stage) :state)))))
      (let* ((o (bytes *outer*)) (n (length o))
             (e (wires o (list 1 17 58 (- n 3) n)))
             (r (gate o e)))
        (check (eq :ready (getf r :state)))
        (check (equal '(:identify :response :ok :prompt)
                      (mapcar (lambda (m) (getf m :name)) (getf r :markers))))
        (check (= n (getf (car (last (getf r :markers))) :end)))
        ;; Every byte boundary splits real wire events, without decoding.
        (loop for cut from 1 below n do
          (check (eq :ready (getf (gate o (wires o (list cut n))) :state))))
        ;; Every incomplete prefix is pending, including empty output/events.
        (loop for end from 0 below n do (state :pending (subseq o 0 end)))
        (state :pending o :outer-hold n)
        (state :pending (bytes (concatenate 'string "Push <RETURN>"
                                            (subseq *outer* 0 (- n 13)))))
        (state :pending (bytes "Push <RETURN>Response was  -- OK (means VT100 emulating VT52)Test of terminal response to IDENTIFY command"))
        (state :pending (bytes "Test of terminal response to IDENTIFY command Response was  -- FAIL Push <RETURN>"))
        (state :refuse (bytes "You should have to press return to continue:"))
        (state :refuse (bytes (concatenate 'string
                            (subseq *outer* 0 (- n 13))
                            "You should have to press return to continue:Push <RETURN>")))
        (let* ((prefix (bytes "old Push <RETURN>"))
               (all (concatenate '(vector (unsigned-byte 8)) prefix o))
               (ev (wires all (list (length prefix) (length all)))))
          (setf (getf (first ev) :child-pid) 99)
          (check (eq :ready (getf (gate all ev (length prefix)) :state)))
          (check (= (length prefix) (getf (first (getf (gate all ev (length prefix))
                                                     :markers)) :start))))
        (dolist (mutation '((:child-pid 99) (:child-pid nil) (:source :reply)
                            (:out 1) (:start 1) (:end 0) (:seq 0)
                            (:bytes #(0)) (:end 999999)))
          (let ((bad (wires o (list n))))
            (setf (getf (car bad) (first mutation)) (second mutation))
            (check (eq :refuse (getf (gate o bad) :state)))))
        (let ((bad (wires o (list 5 n))))
          (setf (getf (second bad) :seq) 1)
          (check (eq :refuse (getf (gate o bad) :state))))
        (let ((bad (wires o (list 5 n))))
          (setf (getf (second bad) :start) 6)
          (check (eq :refuse (getf (gate o bad) :state))))
        (check (eq :refuse (getf (gate o (wires o (list (1- n)))) :state)))
        (check (eq :refuse (getf (gate (subseq o 0 (1- n)) (wires o (list n))) :state)))
        (check (eq :refuse (getf (gate o nil) :state)))
        (check (eq :refuse (getf (gate o (cons (car e) 3)) :state)))
        (dolist (bad (list (list (list :seq 1 :kind))
                          (list (cons :seq 1)) (list 3)
                          (list (list :seq 1 :seq 2))))
          (check (eq :refuse (getf (gate o bad) :state))))
        (let ((bad (wires o (list n))))
          (setf (cdr (last bad)) bad)
          (check (eq :refuse (getf (gate o bad) :state))))
        (let* ((entry (car (wires o (list n)))) (bad (list entry entry)))
          (check (eq :refuse (getf (gate o bad) :state))))
        (let* ((bad (wires o (list n))) (entry (car bad)))
          (setf (getf entry :source) entry)
          (check (eq :refuse (getf (gate o bad) :state))))
        (dolist (args (list (list o e -1 42 :outer-hold)
                           (list o e (1+ n) 42 :outer-hold)
                           (list o e 0 0 :outer-hold)
                           (list o e 0 42 :other)
                           (list *outer* e 0 42 :outer-hold)))
          (check (eq :refuse (getf (apply #'vttest-vt52-navigation:vt52-navigation-check
                                        args) :state)))))
      (state :ready (bytes *menu*) :main-menu)
      (dolist (text '("Choose test type:7. Test of VT52 mode"
                      "7. Test of VT52 mode Enter choice number (0 - 12): "
                      "Choose test type: Enter choice number (0 - 12): "
                      "Enter choice number (0 - 12): 7. Test of VT52 mode Choose test type:"))
        (state :pending (bytes text) :main-menu))
      (state :pending (bytes *menu*) :main-menu (length *menu*))
      (check (eq :refuse (getf (gate (make-array 1048577 :element-type '(unsigned-byte 8)
                                               :initial-element 0) nil) :state)))
      (check (eq :refuse (getf (gate (bytes "") (make-list 65537)) :state)))
      (check (eq :refuse (getf (gate (bytes "")
                         (list (make-array 2097153 :element-type '(unsigned-byte 8)
                                                  :initial-element 0))) :state)))
      (let* ((o (bytes *outer*)) (e (wires o (list 10 (length o)))))
        (setf (getf (second e) :seq) 3)
        (push (list :seq 2 :kind :navigation :out 10 :in 1) (cdr e))
        (check (eq :ready (getf (gate o e) :state))))
      (let* ((o (bytes *outer*)) (e (wires o (list (length o)))))
        (remf (car e) :source)
        (check (eq :refuse (getf (gate o e) :state))))
      (let* ((o (bytes *outer*)) (e (wires o (list (length o)))))
        (setf (aref (getf (car e) :bytes) 0) 0)
        (check (eq :refuse (getf (gate o e) :state))))
      (let* ((o (bytes *outer*)) (e (wires o (list (length o)) 99)))
        (check (eq :refuse (getf (gate o e 1) :state))))
      (let* ((o (bytes (format nil "The screen should be cleared, and have a centered~%rectangle of \"*\"s with \"!\"s on the inside to the~%left and right. Only this, and~%Push <RETURN>")))
             (n (length o)))
        (state :ready o :first-hold)
        (loop for cut from 1 below n do
          (check (eq :ready (getf (gate o (wires o (list cut n)) 0 :first-hold) :state))))
        (loop for end from 0 below n do (state :pending (subseq o 0 end) :first-hold))
        (state :pending (reverse o) :first-hold)
        (check (eq :refuse (getf (gate o (wires o (list n) 99) 0 :first-hold) :state))))
      (format t "~D navigation checks passed.~%" checks)
      checks)))
