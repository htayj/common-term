;;;; Real TOOL lifecycle with a fake display and real PTY, child and worker.
(defpackage #:lispterm.runtime-adoption.tests (:use #:cl))
(in-package #:lispterm.runtime-adoption.tests)
(defvar *checks* 0)
(defun check (value label)
  (unless value (error "Adoption check failed: ~A" label))
  (incf *checks*)
  (format t "CHECK ~D ~A~%" *checks* label))
(defun refused (tool)
  (handler-case (progn (autolith::tool-runtime-close tool) nil)
    (lispterm.autolith::runtime-opening () t)))
(defun validation-refused (registry)
  ;; Exercise the installed checkpoint backend callback, not a substitute gate.
  (let* ((configuration (autolith::configuration-create :defer-provider-validation-p t))
         (source (autolith::make-source-provenance (autolith::config :source-root configuration)))
         (backend (autolith::checkpoint-backend-create configuration nil :tool-registry registry)))
    (unwind-protect
         (handler-case
             (progn (funcall (sbcl-generations::checkpoint-backend-validate-function backend)
                             (autolith::source-revision source)) nil)
           (lispterm.autolith::runtime-opening () t))
      (funcall (sbcl-generations::checkpoint-backend-resume-function backend) nil))))
(defun fd-count () (length (directory #p"/proc/self/fd/*")))
(defun owned-p (runtime host)
  (find host (lispterm.autolith::runtime-hosts runtime)
        :key #'lispterm.autolith::owned-host-host :test #'eq))
(defun run-tests ()
  (let* ((runtime (lispterm.autolith::make-runtime))
         (registry (make-instance 'autolith::tool-registry))
         (tool (lispterm.autolith:register-runtime registry runtime))
         (original (symbol-function 'lispterm.autolith::host-call))
         (fds (fd-count)) (threads (sb-thread:list-all-threads))
         (hosts nil) (opening-thread nil))
    (labels ((open-host ()
               (let ((host (lispterm.autolith::open-owned-host
                            runtime :backend :x11 :argv '("/bin/sh") :rows 8 :columns 30)))
                 (push host hosts) host))
             (resume () (autolith::tool-runtime-resume tool registry))
             (close-host (host)
               (let ((pid (getf (lispterm:status host) :child-pid)))
                 (lispterm:close host)
                 (lispterm.autolith:forget-host host runtime)
                 (check (not (lispterm.pty:pty-open-p
                              (lispterm::session-pty (lispterm::host-session host)))) "master closed")
                 (check (not (getf (lispterm:status host) :worker-alive-p)) "worker joined")
                 (check (not (probe-file (format nil "/proc/~D/" pid))) "child reaped"))))
      (unwind-protect
           (progn
             ;; Original interleaving: CLOSE between the actual OPEN return and
             ;; publication. It must refuse, without blocking/reentrant deadlock.
             (setf (symbol-function 'lispterm.autolith::host-call)
                   (lambda (name &rest arguments)
                     (let ((result (apply original name arguments)))
                       (when (eq name :open)
                         (check (refused tool) "same-thread close in open/adopt gap refused")
                         (check (= 1 (getf (lispterm.autolith:runtime-status runtime) :openings))
                                "reservation visible without holding mutex"))
                       result)))
             (let ((host (open-host)))
               (check (owned-p runtime host) "new host atomically published")
               (check (eq :running (getf (lispterm.autolith:runtime-status runtime) :state))
                      "refusal left runtime running")
               (autolith::tool-runtime-close tool)
               (check (not (getf (lispterm:status host) :worker-alive-p)) "retry close joins new owner")
               (check (handler-case (progn (open-host) nil) (error () t)) "open refused while quiesced")
               (resume)
               (check (getf (lispterm:status host) :worker-alive-p) "resume restores published owner")
               (close-host host))
             ;; Actual concurrent CLOSE while a factory has returned its real
             ;; host but has not yet published it. Semaphores fix the ordering.
             (let ((entered (sb-thread:make-semaphore))
                   (release (sb-thread:make-semaphore)) (created nil) (failure nil))
               (setf (symbol-function 'lispterm.autolith::host-call)
                     (lambda (name &rest arguments)
                       (let ((result (apply original name arguments)))
                         (when (eq name :open)
                           (setf created result)
                           (sb-thread:signal-semaphore entered)
                           (unless (sb-thread:wait-on-semaphore release :timeout 30)
                             (error "Release timeout")))
                         result)))
               (setf opening-thread
                     (sb-thread:make-thread
                      (lambda () (handler-case (open-host) (error (e) (setf failure e))))
                      :name "adoption factory test"))
               (unwind-protect
                    (progn
                      (check (sb-thread:wait-on-semaphore entered :timeout 10) "real factory reached gap")
                      (check (getf (lispterm:status created) :worker-alive-p) "gap contains real live owner")
                      (check (refused tool) "concurrent close refused before disruption")
                      (check (validation-refused registry) "actual checkpoint validation refuses concurrent opening")
                      (check (eq :running (getf (lispterm.autolith:runtime-status runtime) :state))
                             "concurrent refusal preserves running state"))
                 (sb-thread:signal-semaphore release)
                 (sb-thread:join-thread opening-thread :timeout 15))
               (check (null failure) "factory completed after concurrent refusal")
               (check (owned-p runtime created) "concurrent host belongs to runtime")
               (autolith::tool-runtime-close tool)
               (check (eq :quiesced (getf (lispterm.autolith:runtime-status runtime) :state)) "next close includes new host")
               (resume)
               (close-host created))
             (setf (symbol-function 'lispterm.autolith::host-call) original)
             ;; An OPEN whose native cleanup also fails supplies a recovery
             ;; handle. Preserve the exact condition and register that host too.
             (let ((caught nil) (signaled nil) (recovery nil))
               (setf lispterm.host.tests::*fail-open* t
                     lispterm.host.tests::*fail-close* t)
               (unwind-protect
                    (handler-case
                        (handler-bind ((lispterm:host-error
                                         (lambda (e) (when (lispterm:host-error-host e)
                                                       (setf signaled e)))))
                          (open-host))
                      (lispterm:host-error (e) (setf caught e recovery (lispterm:host-error-host e))))
                 (setf lispterm.host.tests::*fail-open* nil))
               (check (and caught (eq caught signaled)) "original dual-failure condition preserved")
               (check recovery "partial-open recovery handle exposed")
               (push recovery hosts)
               (check (owned-p runtime recovery) "failed-cleanup host retained in runtime registry")
               (check (zerop (getf (lispterm.autolith:runtime-status runtime) :openings)) "failed open releases reservation")
               (check (handler-case (progn (lispterm:close recovery) nil) (error () t)) "cleanup failure remains observable")
               (check (owned-p runtime recovery) "cleanup retry failure cannot orphan host")
               (setf lispterm.host.tests::*fail-close* nil)
               (close-host recovery))
             ;; A plain open failure has no host to retain and no stale reservation.
             (setf lispterm.host.tests::*fail-open* t)
             (unwind-protect
                  (check (handler-case (progn (open-host) nil) (error () t)) "ordinary open failure returned")
               (setf lispterm.host.tests::*fail-open* nil))
             (check (zerop (getf (lispterm.autolith:runtime-status runtime) :openings)) "ordinary failure released reservation")
             (close-host (open-host))
             (check (null (lispterm.autolith::runtime-hosts runtime)) "runtime registry empty after final cleanup")
             (check (null (lispterm.autolith::runtime-tokens runtime)) "no residual rollback tokens")
             (check (null (lispterm:status)) "host registry empty")
             (check (= fds (fd-count)) "exact final FD baseline")
             (check (null (set-difference (sb-thread:list-all-threads) threads)) "exact final thread baseline")
             (format t "~S~%" (list :runtime-adoption-checks *checks* :passed t)))
        (setf (symbol-function 'lispterm.autolith::host-call) original
              lispterm.host.tests::*fail-open* nil lispterm.host.tests::*fail-close* nil)
        (dolist (host hosts)
          (lispterm:close host)
          (lispterm.autolith:forget-host host runtime))))))
