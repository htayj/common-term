;;;; Narrow live cursor gate. No import mode, native test hook, or product oracle.
(require :asdf)
(load (merge-pathnames "vttest-cursor-oracle.lisp" *load-truename*))
(load (merge-pathnames "vttest-protocol.lisp" *load-truename*))
(defpackage :vttest-cursor-driver
  (:use :cl)
  (:import-from :vttest-area :read-data :gate-problem)
  (:export :validate :run))
(in-package :vttest-cursor-driver)

(defparameter +binary+ "622bc81d4e2001824ae7012c234294072e0738834800d6642670237adcf2a2a9")
(defparameter +font+ "0d11d8ed0889a412fb6903710804643ad85858cc56905286cedae392a57255ca")
(defparameter +archive+ "cd6886f9aefe6a3f6c566fa61271a55710901a71849c630bf5376aa984bf77cc")
(defparameter +conditions+
  '("private-x11" "scale-1" "grid-80-132x24" "cell-8x16" "output-1280x800"
    "exact-rgb-all-pixels" "fresh-owned-capture" "source-bound"))
(defun backend-spec (backend)
  "Closed backend vocabulary. Values are driver, request kind and capability."
  (cond ((equal backend "x11") (values "cursor-x11-v1" :cursor-x11-launch "cursor-x11-runtime"))
        ((equal backend "wayland") (values "cursor-wayland-v1" :cursor-wayland-launch "cursor-wayland-runtime"))
        (t (vttest-area::refuse :unsupported-native-driver 3))))
(defun conditions-for (backend)
  (backend-spec backend)
  (cons (if (equal backend "wayland") "private-wayland" "private-x11") (cdr +conditions+)))
(defun dependency-names (backend)
  (backend-spec backend)
  (append '("vttest-area.lisp" "vttest-cursor-driver.lisp" "vttest-cursor-oracle.lisp" "vttest-gate.sh"
            "vttest-gate.lisp" "vttest-protocol.lisp" "vttest-selection.lisp" "verify.sh")
          (when (equal backend "wayland") '("wayland-gate.sh"))))
(defun module-pins (backend)
  (loop for path in (append (mapcar (lambda (name) (path+ "tests/" name)) (dependency-names backend))
                            '("scripts/sbcl" "scripts/deps.nix"))
        collect (list :path path :sha256 (digest path))))
(defun receipt-prefix (backend)
  (backend-spec backend)
  (format nil "vttest-~a-scale1-v3." backend))
(defun raw-suffixes (backend)
  (backend-spec backend)
  (append '(".png" ".external.sexp" ".status.sexp" ".barrier.sexp" ".final-status.sexp"
            ".dimensions.txt" ".image-size.txt")
          (if (equal backend "wayland") '(".tree.json" ".geometry.json") '(".geometry.txt"))))
(defun need (test reason) (unless test (vttest-area::refuse reason 3)))
(defun path+ (root name) (concatenate 'string root name))
(defun trim (s) (string-trim '(#\Space #\Newline #\Return) s))
(defun bytes (path)
  (let ((fd (vttest-area::open-input-fd path)))
    (with-open-stream (s (sb-sys:make-fd-stream fd :input t :element-type '(unsigned-byte 8) :auto-close t))
      (let* ((v (make-array (1+ vttest-area::+limit+) :element-type '(unsigned-byte 8)))
             (n (read-sequence v s)))
        (need (<= n vttest-area::+limit+) :artifact-too-large) (subseq v 0 n)))))
(defun text (path) (sb-ext:octets-to-string (bytes path) :external-format :utf-8))
(defun digest (path) (vttest-area::sha256 (bytes path)))
(defun put (path value)
  (with-open-file (s path :direction :output :if-exists :error :if-does-not-exist :create)
    (let ((*print-readably* t) (*print-pretty* t)) (write value :stream s) (terpri s))))
(defun raw-preflight (s)
  ;; Bound nesting before the Lisp reader allocates a tree. Disallow every
  ;; dispatch macro outside quoted strings, but allow the recorder's ESC text.
  (let ((depth 0) (quoted nil) (escaped nil))
    (loop for c across s do
      (cond (escaped (setf escaped nil))
            (quoted (cond ((char= c #\\) (setf escaped t)) ((char= c #\") (setf quoted nil))))
            ((char= c #\") (setf quoted t))
            ((char= c #\() (incf depth) (need (<= depth 64) :raw-too-deep))
            ((char= c #\)) (decf depth) (need (>= depth 0) :raw-parentheses))
            (t (need (or (alphanumericp c) (find c ":-+.")
                         (find c '(#\Space #\Newline #\Return #\Tab))) :raw-reader-macro))))
    (need (and (zerop depth) (not quoted)) :raw-parentheses)))
(defun raw-data (path)
  "Bounded raw recorder data. The area manifest reader is deliberately stricter.
Raw geometry has repeated equal keys and signed integers, and checks has ESC text."
  (let* ((s (text path)) (*read-eval* nil) (*readtable* (copy-readtable nil))
         (*package* (find-package :vttest-cursor-driver)))
    (raw-preflight s)
    (set-macro-character #\# (lambda (&rest args) (declare (ignore args))
                               (vttest-area::refuse :raw-reader-dispatch 3)))
    (with-input-from-string (in s)
      (let* ((eof (gensym)) (v (read in nil eof)))
        (need (not (eq eof v)) :empty-raw-data)
        (need (eq eof (read in nil eof)) :raw-trailing-data)
        (labels ((walk (x depth)
                   (need (< depth 64) :raw-too-deep)
                   (cond ((consp x) (vttest-area::proper x)
                          (dolist (y x) (walk y (1+ depth))))
                         (t (need (or (keywordp x) (null x) (eq x t) (stringp x) (integerp x))
                                  :raw-invalid-atom)))))
          (walk v 0)) v))))
(defun validate (m)
  (let ((backend (getf m :backend)))
    (need (and (equal (backend-spec backend) (getf m :native-driver))
               (equal "cursor-movements" (getf m :area))) :unsupported-native-driver)
    (need (equal (conditions-for backend) (getf m :conditions)) :cursor-conditions))
  (let* ((ss (getf m :scenarios)) (s (first ss)) (pins (getf m :pins)))
    (need (= 1 (length ss)) :cursor-scenario-count)
    (need (and (equal "cursor" (getf s :id)) (equal "cursor" (getf s :recorder-label))
               (equal '(1) (getf s :menu-path)) (= 6 (getf s :pauses))
               (= 6 (getf m :required-count)) (null (getf s :bytes)) (null (getf s :timing)))
          :cursor-scope)
    (need (equal (loop for n from 1 to 6 collect (list :id (format nil "pause-~d" n) :pause n))
                 (getf s :captures)) :cursor-exact-six)
    ;; A requirement is a request to prove this capability during the run,
    ;; never a user-supplied READY declaration. Other capabilities are refused.
    (need (equal (list (list :capability (nth-value 2 (backend-spec (getf m :backend)))
                            :path "tests/vttest-cursor-driver.lisp"))
                 (getf s :requires)) :unsupported-cursor-capability)
    (vttest-area::plist-keys pins (append '(:binary :font :upstream-archive :oracle :driver)
                                        (when (equal "wayland" (getf m :backend)) '(:modules))))
    (when (equal "wayland" (getf m :backend))
      (need (equal (module-pins "wayland") (getf pins :modules)) :cursor-module-pins))
    (need (and (equal +binary+ (getf pins :binary)) (equal +font+ (getf pins :font))
               (equal +archive+ (getf pins :upstream-archive))) :cursor-pins)
    (need (and (equal "tests/vttest-cursor-oracle.lisp" (getf (getf s :oracle) :path))
               (equal (getf pins :oracle) (getf (getf s :oracle) :sha256))
               (equal (digest "tests/vttest-cursor-oracle.lisp") (getf pins :oracle))
               (equal (digest "tests/vttest-cursor-driver.lisp") (getf pins :driver)))
          :cursor-source-pin)) m)

(defun command-output (program args)
  (let ((out (make-string-output-stream)))
    (let ((p (sb-ext:run-program program args :search t :input nil :output out :error *error-output*)))
      (need (eql 0 (sb-ext:process-exit-code p)) :binding-command-failed))
    (get-output-stream-string out)))
(defun source-snapshot ()
  ;; Matches the capture gate exactly, including untracked driver/oracle bytes.
  ;; Protected sources and the unrelated native-geometry bootstrap are excluded.
  (command-output "/run/current-system/sw/bin/env" (list "-i" "PATH=/run/current-system/sw/bin:/usr/bin:/bin"
     "bash" "-c" "find src engine tests scripts -type f ! -path 'tests/vt100-native-geometry.lisp' ! -path 'tests/vt100-native-geometry.sh' ! -path 'tests/capture-transaction.lisp' ! -path 'tests/capture-transaction-tests.lisp' -print0 | sort -z | xargs -0 sha256sum")))
(defun current-bindings-p (head tree snapshot)
  (multiple-value-bind (h tr) (vttest-area::source-bindings)
    (and (equal h head) (equal tr tree) (equal snapshot (source-snapshot)))))
(defun provenance-file (root name provenance)
  (let ((h (digest (path+ root name))))
    (need (search (format nil "~a  ./~a~%" h name) provenance) :artifact-provenance)
    (list :path (path+ root name) :sha256 h)))
(defun be32 (v p) (vttest-cursor-oracle::be32 v p))
(defun check-wayland-status (pause status barrier final child)
  "Check recorder-native readiness only, not external capture or session proof.
The live Wayland driver must also bind raw compositor identity and geometry."
  (need
   (handler-case
       (let* ((cols (if (member pause '(2 4)) 132 80)) (width (* cols 8))
              (before (getf barrier :before-status)) (after (getf barrier :status))
              (target (getf barrier :target-output)) (ack (getf barrier :native-ack-output)))
         (and (member pause '(1 2 3 4 5 6)) (typep child '(integer 1))
              (eql 3 (getf barrier :recorder-version)) (eql 1 (getf barrier :desired-scale))
              (typep target '(integer 0)) (typep ack '(integer 0)) (>= ack target)
              (eql (getf before :frames) (getf barrier :before-frame))
              (vttest-check::fresh-geometry-frame-p before after 1)
              (every
               (lambda (s)
                 (let ((g (getf s :geometry)))
                   (and (eq :wayland (getf s :backend)) (eq :wayland (getf g :backend))
                        (eq :attached (getf s :state)) (eq t (getf s :worker-alive-p))
                        (eql child (getf s :child-pid)) (eq :open (getf s :transport-state))
                        (eq :running (getf s :process-state)) (eql 0 (getf s :input-pending))
                        (eql cols (getf s :columns)) (eql 24 (getf s :rows))
                        (eql 8 (getf g :cell-width)) (eql 16 (getf g :cell-height))
                        (eql width (getf g :actual-width)) (eql 384 (getf g :actual-height))
                        (eq :settled (getf g :phase)) (typep (getf g :request-id) '(integer 0))
                        (typep (getf g :target-presentation) '(integer 1))
                        (vttest-check:geometry-capture-ready-p s 1)
                        (vttest-check::same-geometry-attempt-p before s)
                        (>= (getf s :bytes-received) target)
                        ;; Raw recorder plists repeat some metrics. Conflicting
                        ;; copies cannot supply alternative readiness evidence.
                        (loop for (key value) on s by #'cddr
                              always (equal value (getf s key)))
                        (loop for (key value) on g by #'cddr
                              always (equal value (getf g key))))))
               (list before after status final))
              (>= (getf status :frames) (getf after :frames))
              (>= (getf final :frames) (getf status :frames))
              (>= (getf (getf status :geometry) :commit-generation)
                  (getf (getf after :geometry) :commit-generation))
              (>= (getf (getf final :geometry) :commit-generation)
                  (getf (getf status :geometry) :commit-generation))))
     (error () nil))
   :wayland-native-readiness)
  (list :pause pause :backend :wayland :child child
        :native-acknowledgement (getf barrier :native-ack-output)))
;;; Retained Wayland proof, shared by finite controls and live dispatch.
(defun strict-json (source)
  "Parse bounded compositor JSON without reader evaluation or duplicate members."
  (need (and (stringp source) (<= (length source) vttest-area::+limit+)) :json-size)
  (let ((i 0) (n (length source)))
    (labels ((peek () (and (< i n) (char source i)))
             (take () (need (< i n) :json-incomplete) (prog1 (char source i) (incf i)))
             (space () (loop while (and (peek) (find (peek) '(#\Space #\Tab #\Return #\Newline))) do (incf i)))
             (expect (c) (need (eql c (take)) :json-syntax))
             (digits () (let ((start i))
                          (loop while (and (peek) (digit-char-p (peek))) do (incf i))
                          (need (<= 1 (- i start) 32) :json-number)
                          (parse-integer source :start start :end i)))
             (string-value ()
               (expect #\")
               (with-output-to-string (out)
                 (loop for c = (take) do
                   (cond ((char= c #\") (return))
                         ((char= c #\\)
                          (let ((e (take)))
                            (write-char
                             (case e
                               (#\" #\") (#\\ #\\) (#\/ #\/) (#\b #\Backspace)
                               (#\f #\Page) (#\n #\Newline) (#\r #\Return) (#\t #\Tab)
                               (#\u (let ((code 0))
                                      (dotimes (k 4)
                                        (let ((d (digit-char-p (take) 16)))
                                          (need d :json-unicode) (setf code (+ (* code 16) d))))
                                      ;; Sway titles here are ASCII. Reject lone or paired
                                      ;; UTF-16 surrogates rather than reinterpret identity.
                                      (need (not (<= #xd800 code #xdfff)) :json-surrogate)
                                      (or (code-char code) (vttest-area::refuse :json-unicode 3))))
                               (otherwise (vttest-area::refuse :json-escape 3))) out)))
                         (t (need (>= (char-code c) 32) :json-control) (write-char c out))))))
             (number-value ()
               (let ((negative (eql (peek) #\-)) (whole 0) (fraction 0) (divisor 1) (exponent 0))
                 (when negative (incf i))
                 (if (eql (peek) #\0) (incf i) (setf whole (digits)))
                 (when (eql (peek) #\.)
                   (incf i) (let ((start i)) (setf fraction (digits) divisor (expt 10 (- i start)))))
                 (when (and (peek) (find (peek) "eE"))
                   (incf i)
                   (let ((minus (eql (peek) #\-)))
                     (when (and (peek) (find (peek) "+-")) (incf i))
                     (setf exponent (digits)) (need (<= exponent 100) :json-exponent)
                     (when minus (setf exponent (- exponent)))))
                 (* (if negative -1 1) (+ whole (/ fraction divisor)) (expt 10 exponent))))
             (literal (word value)
               (loop for c across word do (expect c)) value)
             (value (depth)
               (need (< depth 64) :json-depth) (space)
               (case (peek)
                 (#\" (string-value))
                 (#\{ (incf i) (space)
                  (let ((object (make-hash-table :test #'equal)))
                    (unless (eql (peek) #\})
                      (loop
                        (need (eql (peek) #\") :json-object-key)
                        (let ((key (string-value)))
                          (need (not (nth-value 1 (gethash key object))) :json-duplicate-key)
                          (space) (expect #\:) (setf (gethash key object) (value (1+ depth))))
                        (space) (unless (eql (peek) #\,) (return)) (incf i) (space)))
                    (expect #\}) object))
                 (#\[ (incf i) (space)
                  (let ((items nil))
                    (unless (eql (peek) #\])
                      (loop (push (value (1+ depth)) items) (space)
                            (unless (eql (peek) #\,) (return)) (incf i)))
                    (expect #\]) (coerce (nreverse items) 'vector)))
                 (#\t (literal "true" :json-true))
                 (#\f (literal "false" :json-false))
                 (#\n (literal "null" :json-null))
                 (otherwise (need (and (peek) (or (digit-char-p (peek)) (eql (peek) #\-))) :json-value)
                            (number-value)))))
      (let ((result (value 0))) (space) (need (= i n) :json-trailing) result))))
(defun json-field (object key)
  (need (hash-table-p object) :json-object)
  (multiple-value-bind (value present) (gethash key object)
    (need present :json-missing-field) value))
(defun json-rect (object)
  (mapcar (lambda (key) (let ((v (json-field object key)))
                         (need (integerp v) :json-rectangle) v))
          '("x" "y" "width" "height")))
(defun consistent-proof-plist (p)
  (vttest-area::proper p)
  (need (evenp (length p)) :proof-plist)
  (need (loop for (key value) on p by #'cddr always (and (keywordp key) (equal value (getf p key))))
        :conflicting-proof))
(defun wayland-output (outputs)
  (let ((v (strict-json outputs)))
    (need (and (vectorp v) (not (stringp v)) (= 1 (length v))) :private-output-count)
    (let* ((o (aref v 0)) (mode (json-field o "current_mode")))
      (need (and (equal "HEADLESS-1" (json-field o "name"))
                 (eq :json-true (json-field o "active"))
                 (eql 1 (json-field o "scale"))
                 (equal '(0 0 1280 800) (json-rect (json-field o "rect")))
                 (eql 1280 (json-field mode "width")) (eql 800 (json-field mode "height")))
            :private-output) o)))
(defun check-wayland-proof (geometry-arguments session-arguments)
  "Compose offline proofs and bind the PTY parent to the selected native node."
  (let ((session (apply #'private-wayland-session session-arguments))
        (geometry (apply #'check-wayland-geometry geometry-arguments)))
    (need (and (eql (getf session :client) (getf geometry :client))
               (eql (getf session :child) (getf geometry :child))) :wayland-proof-owner)
    (list :session session :geometry geometry)))
(defun check-wayland-geometry (pause png e status barrier final tree geometry outputs dimensions image-size child client title)
  "Bind actual Sway node identity to raw geometry, PNG header and native readiness.
CHILD is the owned PTY shell; CLIENT is its parent, the native window owner."
  (dolist (p (list e barrier)) (consistent-proof-plist p))
  (check-wayland-status pause status barrier final child)
  (need (and (typep client '(integer 1)) (stringp title) (plusp (length title))) :wayland-owner)
  (let* ((cols (if (member pause '(2 4)) 132 80)) (w (* cols 8))
         (root (strict-json tree)) (raw (strict-json geometry)) (matches nil) (titles nil) (ids nil))
    (need (typep (json-field root "id") '(integer 1)) :wayland-tree-root)
    (dolist (key '("nodes" "floating_nodes"))
      (let ((nodes (json-field root key)))
        (need (and (vectorp nodes) (not (stringp nodes))) :wayland-tree-children)))
    (labels ((walk-value (v)
               (cond ((hash-table-p v) (walk v))
                     ((and (vectorp v) (not (stringp v))) (map nil #'walk-value v))))
             (walk (o)
               (let ((id (gethash "id" o)))
                 (when id (need (and (typep id '(integer 1)) (not (member id ids))) :wayland-node-id)
                       (push id ids)))
               (when (equal title (gethash "name" o))
                 (push o titles)
                 (when (and (eql client (gethash "pid" o)) (equal "floating_con" (gethash "type" o)))
                   (push o matches)))
               (dolist (key '("nodes" "floating_nodes"))
                 (multiple-value-bind (nodes present) (gethash key o)
                   (when present
                     (need (and (vectorp nodes) (not (stringp nodes)) (every #'hash-table-p nodes))
                           :wayland-tree-children))))
               ;; Match the producer's recursive `.. | objects`, including unexpected
               ;; nested members, rather than overlooking a second identity there.
               (maphash (lambda (key value) (declare (ignore key)) (walk-value value)) o)))
      (walk root))
    (need (and (= 1 (length titles)) (= 1 (length matches))) :unique-owned-wayland-node)
    (let* ((node (first matches)) (id (json-field node "id"))
           (rect (json-rect (json-field node "rect"))) (x (first rect)) (y (second rect)))
      (dolist (key '("id" "pid" "name"))
        (need (equal (json-field node key) (json-field raw key)) :wayland-raw-identity))
      (dolist (key '("rect" "window_rect" "geometry"))
        (need (equal (json-rect (json-field node key)) (json-rect (json-field raw key))) :wayland-raw-rectangle))
      (need (and (= w (third rect)) (= 384 (fourth rect))
                 (<= 0 x (- 1280 w)) (<= 0 y 416)) :wayland-rectangle)
      (wayland-output outputs)
      (need (and (>= (length png) 24)
                 (equal '(137 80 78 71 13 10 26 10) (coerce (subseq png 0 8) 'list))
                 (= 13 (be32 png 8)) (equal '(73 72 68 82) (coerce (subseq png 12 16) 'list))
                 (= w (be32 png 16)) (= 384 (be32 png 20))) :png-geometry)
      (need (and (eql 3 (getf e :recorder-version))
                 (eql w (getf e :logical-width)) (eql w (getf e :pixel-width))
                 (eql 384 (getf e :logical-height)) (eql 384 (getf e :pixel-height))
                 (eql 1 (getf e :scale)) (eql 1280 (getf e :output-width)) (eql 800 (getf e :output-height))
                 (eql 0 (getf e :output-x)) (eql 0 (getf e :output-y))
                 (eql x (getf e :x)) (eql y (getf e :y))) :wayland-external-proof)
      (need (and (equal (format nil "expected=~dx384 actual=~dx384 window=~d fixture-scale=1" w w id) (trim dimensions))
                 (equal (format nil "~d 384" w) (trim image-size))) :raw-external-geometry)
      (list :pause pause :backend :wayland :node id :client client :child child :width w :height 384))))
(defun proof-lines (s)
  (remove "" (uiop:split-string s :separator '(#\Newline)) :test #'equal))
(defun decimal-proof (s)
  (need (and (stringp s) (plusp (length s)) (every #'digit-char-p s)) :session-decimal)
  (parse-integer s))
(defun private-wayland-session (child proc transport isolation client-wait compositor-pid compositor-start runtime socket-proof outputs)
  "Check retained private-session artifacts, without probing any live endpoint.
SOCKET-PROOF is compositor/isolation.txt; PID, START and RUNTIME are its sibling files."
  (let* ((pid (decimal-proof (trim compositor-pid))) (start (trim compositor-start))
         (runtime (trim runtime)) (lines (proof-lines proc))
         (stat (second lines)) (end (and stat (position #\) stat :from-end t)))
         (fields (and end (remove "" (uiop:split-string (subseq stat (+ end 2)) :separator '(#\Space)) :test #'equal)))
         (audit (proof-lines isolation)) (sockets (proof-lines socket-proof)))
    (need (and (plusp pid) (plusp (decimal-proof start))
               (uiop:string-prefix-p "/tmp/lispterm-wayland." runtime)
               (> (length runtime) (length "/tmp/lispterm-wayland."))
               (every #'alphanumericp (subseq runtime (length "/tmp/lispterm-wayland.")))) :private-runtime)
    (need (and (= 6 (length lines)) (typep child '(integer 1)) end (>= (length fields) 20)
               (equal (first lines) (format nil "pid=~d" child))
               (equal (subseq stat 0 (1+ (position #\Space stat))) (format nil "~d " child))
               (= child (decimal-proof (nth 2 fields)) (decimal-proof (nth 3 fields)))
               (equal (third lines) (fourth lines)) (equal (third lines) (fifth lines))
               (uiop:string-prefix-p "/dev/pts/" (third lines))
               (every #'digit-char-p (subseq (third lines) 9)) (equal "24 80" (sixth lines))) :wayland-pty-session)
    (let* ((client (decimal-proof (nth 1 fields))) (wait (proof-lines client-wait))
           (client-prefix (format nil "client=~d " client))
           (client-records (remove-if-not (lambda (s) (uiop:string-prefix-p client-prefix s)) audit)))
      (need (and (plusp client) (/= child client) (/= pid client) (/= pid child)
                 (= 1 (length client-records)) (= 1 (length wait))) :wayland-client-session)
      (let* ((record (first client-records))
             (parts (uiop:split-string record :separator '(#\Space)))
             (token (and (= 3 (length parts)) (second parts))))
        (need (and token (uiop:string-prefix-p "start=" token)
                   (plusp (decimal-proof (subseq token 6)))
                   (equal "endpoints=private" (third parts))
                   (equal (first wait) (format nil "client-wait pid=~d ~a status=0" client token))) :client-wait-proof))
      (need (equal (proof-lines transport) '("DISPLAY=unset" "WAYLAND_DISPLAY=wayland-1")) :wayland-transport)
      (need (= 3 (length sockets)) :wayland-sockets)
      (let ((paths nil) (inodes nil))
        (dolist (line (subseq sockets 0 2))
          (let ((parts (uiop:split-string line :separator '(#\Space))))
            (need (= 2 (length parts)) :wayland-sockets)
            (let ((inode (decimal-proof (first parts))))
              (need (and (plusp inode) (not (member inode inodes))) :wayland-socket-inode)
              (push inode inodes))
            (push (second parts) paths)))
        (setf paths (nreverse paths))
        (need (equal (first paths) (path+ runtime "/wayland-1")) :wayland-display-socket)
        ;; UID is retained in the kernel socket pathname, not read from this session.
        (let* ((prefix (path+ runtime "/sway-ipc.")) (ipc (second paths)))
          (need (uiop:string-prefix-p prefix ipc) :wayland-ipc-socket)
          (let* ((tail (subseq ipc (length prefix))) (dot (position #\. tail)))
            (need dot :wayland-ipc-socket)
            (let ((uid (decimal-proof (subseq tail 0 dot))))
              (need (equal ipc (format nil "~a~d.~d.sock" prefix uid pid)) :wayland-ipc-socket))))
        (need (equal "fixture-scale=1" (third sockets)) :wayland-socket-scale))
      (let ((server-line (format nil "backend=wayland scale=1 server=~d start=~a runtime=~a" pid start runtime)))
        (need (member server-line audit :test #'equal) :wayland-server-session)
        (dolist (line audit)
          (cond ((uiop:string-prefix-p "backend=" line) (need (equal server-line line) :conflicting-session))
                ((uiop:string-prefix-p "client=" line)
                 (let ((parts (uiop:split-string line :separator '(#\Space))))
                   (need (and (= 3 (length parts))
                              (plusp (decimal-proof (subseq (first parts) 7)))
                              (uiop:string-prefix-p "start=" (second parts))
                              (plusp (decimal-proof (subseq (second parts) 6)))
                              (equal "endpoints=private" (third parts))) :wayland-endpoint-audit)))
                (t (let ((parts (uiop:split-string line :separator '(#\Space))))
                     (need (and (= 2 (length parts)) (plusp (decimal-proof (first parts)))
                                (member line (subseq sockets 0 2) :test #'equal)) :wayland-endpoint-audit))))))
      (dolist (line (subseq sockets 0 2))
        (need (member line audit :test #'equal) :wayland-socket-audit))
      (dolist (line audit)
        (when (uiop:string-prefix-p "client=" line)
          (let ((prefix (subseq line 0 (1+ (position #\Space line)))))
            (need (every (lambda (other) (or (not (uiop:string-prefix-p prefix other)) (equal line other))) audit)
                  :conflicting-session))))
      (need (member (format nil "client=~d start=~a endpoints=private" child (nth 19 fields)) audit :test #'equal)
            :wayland-child-session)
      (wayland-output outputs)
      (list :backend :wayland :client client :child child :server pid :start start :runtime runtime))))
(defun check-geometry (pause png e status barrier final geometry dimensions image-size child
                       &key (backend "x11") tree outputs client title session-arguments)
  "Dispatch to the complete retained backend proof, independently of PASS markers."
  (backend-spec backend)
  (when (equal backend "wayland")
    (return-from check-geometry
      (check-wayland-proof
       (list pause png e status barrier final tree geometry outputs dimensions image-size child client title)
       session-arguments)))
  (let* ((cols (if (member pause '(2 4)) 132 80)) (w (* cols 8))
         (g (getf status :geometry)) (window (getf g :window-id)))
    (need (and (>= (length png) 24)
               (equal '(137 80 78 71 13 10 26 10) (coerce (subseq png 0 8) 'list))
               (= 13 (be32 png 8)) (equal '(73 72 68 82) (coerce (subseq png 12 16) 'list))
               (= w (be32 png 16)) (= 384 (be32 png 20))) :png-geometry)
    (need (and (= 3 (getf e :recorder-version))
               (= w (getf e :logical-width) (getf e :pixel-width))
               (= 384 (getf e :logical-height) (getf e :pixel-height))
               (= 1 (getf e :scale) (getf barrier :desired-scale))
               (= 1280 (getf e :output-width)) (= 800 (getf e :output-height))
               (= 0 (getf e :output-x) (getf e :output-y))
               (<= 0 (getf e :x) (- 1280 w)) (<= 0 (getf e :y) 416)) :private-bounds)
    (need (and (integerp window) (plusp window)
               (search (format nil "WINDOW=~d~%" window) geometry)
               (search (format nil "X=~d~%Y=~d~%WIDTH=~d~%HEIGHT=384~%" (getf e :x) (getf e :y) w) geometry)
               (equal (format nil "expected=~dx384 actual=~dx384 window=~d fixture-scale=1" w w window) (trim dimensions))
               (equal (format nil "~d 384" w) (trim image-size))) :raw-external-geometry)
    (need (and (equal status final) (equal status (getf barrier :status))
               (= 3 (getf barrier :recorder-version))
               (eq :x11 (getf status :backend)) (eq :attached (getf status :state))
               (eq t (getf status :worker-alive-p)) (zerop (getf status :error-count))
               (= child (getf status :child-pid)) (eq :open (getf status :transport-state))
               (eq :running (getf status :process-state))
               (= 24 (getf status :rows) (getf status :pty-rows) (getf g :rows) (getf g :requested-rows))
               (= cols (getf status :columns) (getf status :pty-columns) (getf g :columns) (getf g :requested-columns))
               (= 8 (getf g :cell-width)) (= 16 (getf g :cell-height))
               (= w (getf g :actual-width) (getf g :requested-width) (getf g :width))
               (= 384 (getf g :actual-height) (getf g :requested-height) (getf g :height))
               (eq :settled (getf g :phase)) (eq :x11 (getf g :backend))
               (>= (getf g :presentation) (getf g :target-presentation))
               (plusp (getf g :target-presentation))
               (= (getf g :request-id) (getf status :engine-geometry-generation))
               (> (getf status :frames) (getf barrier :before-frame))
               (>= (getf status :bytes-received) (getf barrier :target-output))) :raw-readiness)
    ;; There is no native acknowledgement on this recorder path. Presentation,
    ;; bytes, raw external geometry and the exact image are the actual proofs.
    (need (= -1 (getf barrier :native-ack-output)) :unexpected-native-ack)
    (dolist (key '(:columns :rows :cell-width :cell-height))
      (need (loop for (k v) on g by #'cddr always (or (not (eq k key)) (eql v (getf g key))))
            :inconsistent-raw-geometry))
    (list :pause pause :width w :height 384 :window window :child child :native-acknowledgement nil)))

(defun validate-receipt (art root request snapshot head &optional backend)
  (when backend
    (need (and (equal backend (getf request :backend))
               (eq (nth-value 1 (backend-spec backend)) (getf request :kind))
               (uiop:string-suffix-p root (receipt-prefix backend))) :capture-receipt-backend))
  (need (and (> (length art) (length root))
             (equal root (subseq art 0 (length root)))
             (not (find #\/ art :start (length root)))) :capture-receipt-path)
  (vttest-area::safe-components art)
  (let ((a (concatenate 'string art "/")))
    (need (equal request (read-data (path+ a "area-request.sexp"))) :stale-launch-receipt)
    (need (equal snapshot (text (path+ a "source.sha256"))) :captured-source-changed)
    (need (equal head (trim (text (path+ a "run-head.txt")))) :captured-head-changed)
    a))
(defun private-session (pid proc transport isolation display-number client-wait)
  (let* ((lines (uiop:split-string proc :separator '(#\Newline)))
         (stat (second lines)) (end (position #\) stat :from-end t))
         (fields (and end (remove "" (uiop:split-string (subseq stat (+ end 2)) :separator '(#\Space)) :test #'equal)))
         (kv (loop for line in (uiop:split-string transport :separator '(#\Newline))
                   for pos = (position #\= line) when pos collect (cons (subseq line 0 pos) (subseq line (1+ pos)))))
         (server (cdr (assoc "server" kv :test #'equal))) (start (cdr (assoc "start" kv :test #'equal))))
    (need (and (integerp pid) (plusp pid) (= 6 (length (remove "" lines :test #'equal)))
               (equal (first lines) (format nil "pid=~d" pid))
               (search (format nil "~d (" pid) stat) (>= (length fields) 20)
               (= pid (parse-integer (nth 2 fields)) (parse-integer (nth 3 fields)))
               (search (format nil "client=~d start=~a endpoints=private~%" pid (nth 19 fields)) isolation)
               (every (lambda (x) (equal (third lines) x)) (subseq lines 2 5))
               (search "/dev/pts/" (third lines)) (equal "24 80" (sixth lines))
               (and server start (every #'digit-char-p server) (every #'digit-char-p start))
               (equal (cdr (assoc "DISPLAY" kv :test #'equal)) (format nil ":~a" (trim display-number)))
               (search (format nil "backend=x11 scale=1 server=~a start=~a runtime=/tmp/lispterm-x11." server start) isolation))
          :private-session)
    (let ((wait (uiop:split-string (trim client-wait) :separator '(#\Space))))
      (need (and (= 4 (length wait)) (equal "client-wait" (first wait))
                 (equal (format nil "pid=~a" (nth 1 fields)) (second wait))
                 (uiop:string-prefix-p "start=" (third wait))
                 (plusp (length (subseq (third wait) 6)))
                 (every #'digit-char-p (subseq (third wait) 6))
                 (equal "status=0" (fourth wait))
                 (search (format nil "client=~a ~a endpoints=private~%" (nth 1 fields) (third wait)) isolation))
            :client-wait-proof))
    t))
(defun wayland-session-arguments (a child)
  (append (list child)
          (mapcar (lambda (name) (text (path+ a name)))
                  '("cursor.process.txt" "transport.txt" "isolation.txt" "client-wait.log"
                    "compositor/compositor.pid" "compositor/compositor.start" "compositor/runtime-path"
                    "compositor/isolation.txt" "isolation-outputs.json"))))
(defun capture-title (fixture)
  (let ((titles (remove-if-not (lambda (s) (uiop:string-prefix-p "title=" s)) (proof-lines fixture))))
    (need (= 1 (length titles)) :capture-title)
    (let ((title (subseq (first titles) 6)))
      (need (and (uiop:string-prefix-p "Lispterm-vttest-" title) (> (length title) 16)) :capture-title)
      title)))
(defun mechanical (a &optional (backend "x11"))
  (backend-spec backend)
  (dolist (name '("harness.exit" "cursor.exit"))
    (need (equal "0" (trim (text (path+ a name)))) :native-exit))
  (let* ((inventory (raw-data (path+ a "inventory.sexp")))
         (finished (raw-data (path+ a "finished.sexp")))
         (r (raw-data (path+ a "cursor.result.sexp")))
         (checks (raw-data (path+ a "checks.sexp")))
         (cases (getf checks :cases)))
    (need (and (= 3 (getf inventory :recorder-version)) (= 1 (getf inventory :desired-scale))
               (every (lambda (key) (equal '("cursor") (getf inventory key))) '(:expected :attempted :completed))
               (= 3 (getf finished :recorder-version)) (= 6 (getf finished :captures))
               (getf finished :baseline-only)) :native-inventory)
    (need (and (equal "cursor" (getf r :label)) (equal '(1) (getf r :path))
               (eq t (getf r :returned-to-menu)) (getf r :inventory-ok)
               (not (getf r :failure)) (not (getf r :errors))
               (every (lambda (k) (= 6 (getf r k))) '(:pauses :expected-pauses :captures :expected-captures))
               (= 0 (getf r :key-phases))
               (eq t (getf checks :pass)) (null (getf checks :errors)) (= 1 (length cases))
               (equal "cursor" (getf (first cases) :label)) (= 0 (getf (first cases) :exit))
               (getf (first cases) :returned-to-menu) (null (getf (first cases) :issues))) :native-mechanical)
    (need (and (search "all-owned-stopped" (text (path+ a "cleanup.log")))
               (not (search "SURVIVED" (text (path+ a "cleanup.log")))) ) :owned-cleanup)
    (let* ((pid (getf (getf r :status) :child-pid))
           (proc (text (path+ a "cursor.process.txt")))
           (isolation (text (path+ a "isolation.txt"))))
      (if (equal backend "wayland")
          (apply #'private-wayland-session (wayland-session-arguments a pid))
          (private-session pid proc (text (path+ a "transport.txt")) isolation
                           (text (path+ a "display-number")) (text (path+ a "client-wait.log"))))
      pid)))

(defun launch-arguments (directory font &optional (backend "x11"))
  (backend-spec backend)
  (let ((d (namestring (truename directory))))
    (append (list "-i" "PATH=/run/current-system/sw/bin:/usr/bin:/bin")
            (loop for (key name) on '("HOME" "home" "XDG_CACHE_HOME" "cache" "XDG_CONFIG_HOME" "config"
                                     "XDG_DATA_HOME" "data" "TMPDIR" "tmp") by #'cddr
                  collect (format nil "~a=~a~a" key d name))
            (list (format nil "LISPTERM_FONT=~a" font)
                  (format nil "LISPTERM_SBCL=~a" (namestring (truename ".build/deps/bin/sbcl")))
                  (format nil "VTTEST=~a" (namestring (truename ".build/test-tools/bin/vttest")))
                  "LISPTERM_VTTEST_EXACT_LABELS=cursor" "LISPTERM_VTTEST_MODE=record"
                  "LISPTERM_VTTEST_SCALE=1" "LISPTERM_VTTEST_TIMEOUT=120"
                  (format nil "LISPTERM_VTTEST_AREA_REQUEST=~alaunch-request.sexp" d)
                  (format nil "LISPTERM_VTTEST_AREA_RECEIPT=~alaunch-receipt.txt" d))
            (when (equal backend "wayland") (list (format nil "LISPTERM_WAYLAND_ARTIFACTS=~awayland-artifacts" d)))
            (list "/run/current-system/sw/bin/bash" "tests/vttest-gate.sh" backend))))
(defun launch-binary (args)
  "Freeze the unique canonical VTTEST path from the actual launch arguments."
  (let ((bindings (remove-if-not (lambda (s) (uiop:string-prefix-p "VTTEST=" s)) args)))
    (need (= 1 (length bindings)) :launch-binary)
    (let ((path (subseq (first bindings) 7)))
      (need (and (uiop:absolute-pathname-p path)
                 (equal path (namestring (truename path)))) :launch-binary)
      path)))
(defun check-binary-provenance (record executable font)
  "Require exactly the launched executable and font with their reviewed digests."
  (need (equal record (format nil "~a  ~a~%~a  ~a~%" +binary+ executable +font+ font))
        :captured-binary)
  t)
(defun run (m directory manifest-path manifest-hash head tree)
  "One actual launch. The only path to fresh observations is a completed child,
its unique receipt, unchanged sources, retained raw proofs and new comparisons."
  (validate m)
  (need directory :missing-driver-context)
  (let* ((d (namestring (truename directory)))
         (backend (getf m :backend))
         (font (namestring (truename ".build/deps/share/fonts/terminus/ter-u16n.otb")))
         (snapshot (source-snapshot))
         (request (list :kind (nth-value 1 (backend-spec backend)) :nonce d :manifest-sha256 manifest-hash
                        :backend backend :conditions (getf m :conditions) :source-head head :source-tree tree
                        :source-sha256 (vttest-area::sha256 (sb-ext:string-to-octets snapshot :external-format :utf-8))))
         (args (launch-arguments d font backend)) (binary (launch-binary args))
         (bindings nil) (observations nil) (screens nil))
    (need (and (equal +binary+ (digest binary))
               (equal +font+ (digest font))) :runtime-pin)
    (need (current-bindings-p head tree snapshot) :source-changed-before-launch)
    (dolist (name '("home" "cache" "config" "data" "tmp")) (sb-posix:mkdir (path+ d name) #o700))
    (when (equal backend "wayland") (sb-posix:mkdir (path+ d "wayland-artifacts") #o700))
    (put (path+ d "launch-request.sexp") request)
    (put (path+ d "launch-command.sexp") (cons "/run/current-system/sw/bin/env" args))
    (with-open-file (s (path+ d "native.log") :direction :output :if-exists :error)
      (let ((p (sb-ext:run-program "/run/current-system/sw/bin/env" args :input nil :output s :error s)))
        (need (eql 0 (sb-ext:process-exit-code p)) :native-launch-failed)))
    (let* ((art (trim (text (path+ d "launch-receipt.txt"))))
           (root (path+ (namestring (truename ".build/evidence/")) (receipt-prefix backend)))
           (a (validate-receipt art root request snapshot head backend))
           (provenance (text (path+ a "provenance.sha256"))))
      (multiple-value-bind (child session) (mechanical a backend)
        (declare (ignore session))
      (need (equal (loop for n from 1 to 6 collect (format nil "~3,'0d-cursor-pause~2,'0d.png" n n))
                   (sort (mapcar #'file-namestring (uiop:directory-files a "*.png")) #'string<)) :exact-png-inventory)
      (need (current-bindings-p head tree snapshot) :source-changed-after-launch)
      (need (equal manifest-hash (nth-value 1 (read-data manifest-path))) :manifest-changed)
      (need (search (format nil "~a  ~a~%" +font+ font) (text (path+ a "binary-font.sha256"))) :captured-font)
      (check-binary-provenance (text (path+ a "binary-font.sha256")) binary font)
      (dolist (s (list "mode=record" "exact-labels=cursor" (format nil "backend=~a" backend) "fixture-scale=1" "override=false"))
        (need (search (format nil "~a~%" s) (text (path+ a "fixture.txt"))) :capture-fixture))
      (dolist (name (append '("area-request.sexp" "source.sha256" "run-head.txt" "working-tree.diff" "binary-font.sha256"
                             "fixture.txt" "inventory.sexp" "finished.sexp" "checks.sexp" "cursor.result.sexp"
                             "cursor.process.txt" "cursor.transcript.raw" "cursor.vttest.log" "isolation.txt" "transport.txt"
                             "harness.exit" "client-wait.log" "cursor.exit" "cleanup.log")
                           (if (equal backend "wayland")
                               '("compositor/compositor.pid" "compositor/compositor.start" "compositor/runtime-path"
                                 "compositor/isolation.txt" "isolation-outputs.json") '("display-number"))))
        (push (provenance-file a name provenance) bindings))
      (dolist (name (dependency-names backend))
        (need (equal (digest (path+ "tests/" name)) (digest (path+ a name))) :snapshot-mismatch)
        (push (provenance-file a name provenance) bindings))
      (loop for pause from 1 to 6 do
        (let* ((stem (format nil "~3,'0d-cursor-pause~2,'0d" pause pause)) (prefix (path+ a stem))
               (input (path+ prefix ".png"))
               (geometry (check-geometry pause (bytes input) (raw-data (path+ prefix ".external.sexp"))
                          (raw-data (path+ prefix ".status.sexp")) (raw-data (path+ prefix ".barrier.sexp"))
                          (raw-data (path+ prefix ".final-status.sexp"))
                          (text (path+ prefix (if (equal backend "wayland") ".geometry.json" ".geometry.txt")))
                          (text (path+ prefix ".dimensions.txt")) (text (path+ prefix ".image-size.txt")) child
                          :backend backend
                          :tree (when (equal backend "wayland") (text (path+ prefix ".tree.json")))
                          :outputs (when (equal backend "wayland") (text (path+ a "isolation-outputs.json")))
                          :client (when (equal backend "wayland")
                                    (getf (apply #'private-wayland-session (wayland-session-arguments a child)) :client))
                          :title (when (equal backend "wayland") (capture-title (text (path+ a "fixture.txt"))))
                          :session-arguments (when (equal backend "wayland") (wayland-session-arguments a child))))
               (out (path+ d (format nil "pause~d/" pause)))
               (comparison (vttest-cursor-oracle:compare-png pause input font out ".build/test-tools/bin/magick"))
               (result (getf comparison :comparison)))
          (dolist (suffix (raw-suffixes backend))
            (push (provenance-file a (path+ stem suffix) provenance) bindings))
          ;; Retain human-viewable expected/diff images as well as the API's PPM.
          (multiple-value-bind (cells cursor) (vttest-cursor-oracle:screen pause)
            (vttest-cursor-oracle:write-ppm (path+ out "expected.ppm")
              (vttest-cursor-oracle:rasterize cells (bytes font) :cursor cursor)
              :width (* 8 (array-dimension cells 1))))
          (dolist (name '("expected" "diff"))
            (command-output ".build/test-tools/bin/magick" (list (path+ out (path+ name ".ppm")) (path+ out (path+ name ".png")))))
          (put (path+ out "COMPARISON.sexp") comparison)
          (push (list :geometry geometry :comparison comparison :actual input :expected (path+ out "expected.png")
                      :diff (path+ out "diff.png") :actual-sha256 (digest input)
                      :expected-sha256 (digest (path+ out "expected.png")) :diff-sha256 (digest (path+ out "diff.png"))) screens)
          (push (list :scenario "cursor" :capture (format nil "pause-~d" pause) :fresh t :fixture nil
                      :pixels (if (getf result :pass) :pass :fail) :bytes :unverified :timing :unverified) observations)))
      (need (current-bindings-p head tree snapshot) :source-changed-during-comparison)
      (need (equal manifest-hash (nth-value 1 (read-data manifest-path))) :manifest-changed)
      (dolist (b bindings) (need (equal (getf b :sha256) (digest (getf b :path))) :artifact-changed))
      (let* ((evidence (list :capture a :launch-request request :provenance-sha256 (digest (path+ a "provenance.sha256"))
                             :bindings (nreverse bindings) :screens (nreverse screens)
                             :native-acknowledgement (when (equal backend "wayland") :verified-per-screen)
                             :image-inspection :pending))
             (ready (list :capability (nth-value 2 (backend-spec backend)) :status :ready :source-head head :source-tree tree
                          :manifest-sha256 manifest-hash :source-sha256 (getf request :source-sha256)
                          :backend backend :conditions (getf m :conditions) :capture a)))
        (put (path+ d "DRIVER-EVIDENCE.sexp") evidence)
        (values (nreverse observations) evidence (list ready)))))))
