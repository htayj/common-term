;;;; Narrow live cursor gate. No import mode, native test hook, or product oracle.
(require :asdf)
(load (merge-pathnames "vttest-cursor-oracle.lisp" *load-truename*))
(defpackage :vttest-cursor-driver
  (:use :cl)
  (:import-from :vttest-area :read-data :gate-problem)
  (:export :validate :run))
(in-package :vttest-cursor-driver)

(defparameter +binary+ "622bc81d4e2001824ae7012c234294072e0738834800d6642670237adcf2a2a9")
(defparameter +font+ "0d11d8ed0889a412fb6903710804643ad85858cc56905286cedae392a57255ca")
(defparameter +archive+ "cd6886f9aefe6a3f6c566fa61271a55710901a71849c630bf5376aa984bf77cc")
(defparameter +conditions+
  '("private-x11" "scale-1" "grid-80-132x24" "cell-8x16" "output-1280x800"
    "exact-rgb-all-pixels" "fresh-owned-capture" "source-bound"))
(defun need (test reason) (unless test (vttest-area::refuse reason 3)))
(defun path+ (root name) (concatenate 'string root name))
(defun trim (s) (string-trim '(#\Space #\Newline #\Return) s))
(defun bytes (path)
  (let ((fd (vttest-area::open-input-fd path)))
    (with-open-stream (s (sb-sys:make-fd-stream fd :input t :element-type '(unsigned-byte 8) :auto-close t))
      (let* ((v (make-array (1+ vttest-area::+limit+) :element-type '(unsigned-byte 8)))
             (n (read-sequence v s)))
        (need (<= n vttest-area::+limit+) :artifact-too-large) (subseq v 0 n)))))
(defun text (path) (sb-ext:octets-to-string (bytes path) :external-format :utf-8))
(defun digest (path) (vttest-area::sha256 (bytes path)))
(defun put (path value)
  (with-open-file (s path :direction :output :if-exists :error :if-does-not-exist :create)
    (let ((*print-readably* t) (*print-pretty* t)) (write value :stream s) (terpri s))))
(defun raw-preflight (s)
  ;; Bound nesting before the Lisp reader allocates a tree. Disallow every
  ;; dispatch macro outside quoted strings, but allow the recorder's ESC text.
  (let ((depth 0) (quoted nil) (escaped nil))
    (loop for c across s do
      (cond (escaped (setf escaped nil))
            (quoted (cond ((char= c #\\) (setf escaped t)) ((char= c #\") (setf quoted nil))))
            ((char= c #\") (setf quoted t))
            ((char= c #\() (incf depth) (need (<= depth 64) :raw-too-deep))
            ((char= c #\)) (decf depth) (need (>= depth 0) :raw-parentheses))
            (t (need (or (alphanumericp c) (find c ":-+.")
                         (find c '(#\Space #\Newline #\Return #\Tab))) :raw-reader-macro))))
    (need (and (zerop depth) (not quoted)) :raw-parentheses)))
(defun raw-data (path)
  "Bounded raw recorder data. The area manifest reader is deliberately stricter.
Raw geometry has repeated equal keys and signed integers, and checks has ESC text."
  (let* ((s (text path)) (*read-eval* nil) (*readtable* (copy-readtable nil))
         (*package* (find-package :vttest-cursor-driver)))
    (raw-preflight s)
    (set-macro-character #\# (lambda (&rest args) (declare (ignore args))
                               (vttest-area::refuse :raw-reader-dispatch 3)))
    (with-input-from-string (in s)
      (let* ((eof (gensym)) (v (read in nil eof)))
        (need (not (eq eof v)) :empty-raw-data)
        (need (eq eof (read in nil eof)) :raw-trailing-data)
        (labels ((walk (x depth)
                   (need (< depth 64) :raw-too-deep)
                   (cond ((consp x) (vttest-area::proper x)
                          (dolist (y x) (walk y (1+ depth))))
                         (t (need (or (keywordp x) (null x) (eq x t) (stringp x) (integerp x))
                                  :raw-invalid-atom)))))
          (walk v 0)) v))))
(defun validate (m)
  (need (and (equal "cursor-x11-v1" (getf m :native-driver))
             (equal "cursor-movements" (getf m :area)) (equal "x11" (getf m :backend)))
        :unsupported-native-driver)
  (need (equal +conditions+ (getf m :conditions)) :cursor-conditions)
  (let* ((ss (getf m :scenarios)) (s (first ss)) (pins (getf m :pins)))
    (need (= 1 (length ss)) :cursor-scenario-count)
    (need (and (equal "cursor" (getf s :id)) (equal "cursor" (getf s :recorder-label))
               (equal '(1) (getf s :menu-path)) (= 6 (getf s :pauses))
               (= 6 (getf m :required-count)) (null (getf s :bytes)) (null (getf s :timing)))
          :cursor-scope)
    (need (equal (loop for n from 1 to 6 collect (list :id (format nil "pause-~d" n) :pause n))
                 (getf s :captures)) :cursor-exact-six)
    ;; A requirement is a request to prove this capability during the run,
    ;; never a user-supplied READY declaration. Other capabilities are refused.
    (need (equal '((:capability "cursor-x11-runtime" :path "tests/vttest-cursor-driver.lisp"))
                 (getf s :requires)) :unsupported-cursor-capability)
    (vttest-area::plist-keys pins '(:binary :font :upstream-archive :oracle :driver))
    (need (and (equal +binary+ (getf pins :binary)) (equal +font+ (getf pins :font))
               (equal +archive+ (getf pins :upstream-archive))) :cursor-pins)
    (need (and (equal "tests/vttest-cursor-oracle.lisp" (getf (getf s :oracle) :path))
               (equal (getf pins :oracle) (getf (getf s :oracle) :sha256))
               (equal (digest "tests/vttest-cursor-oracle.lisp") (getf pins :oracle))
               (equal (digest "tests/vttest-cursor-driver.lisp") (getf pins :driver)))
          :cursor-source-pin)) m)

(defun command-output (program args)
  (let ((out (make-string-output-stream)))
    (let ((p (sb-ext:run-program program args :search t :input nil :output out :error *error-output*)))
      (need (eql 0 (sb-ext:process-exit-code p)) :binding-command-failed))
    (get-output-stream-string out)))
(defun source-snapshot ()
  ;; Matches the capture gate exactly, including untracked driver/oracle bytes.
  ;; Protected sources and the unrelated native-geometry bootstrap are excluded.
  (command-output "/run/current-system/sw/bin/env" (list "-i" "PATH=/run/current-system/sw/bin:/usr/bin:/bin"
     "bash" "-c" "find src engine tests scripts -type f ! -path 'tests/vt100-native-geometry.lisp' ! -path 'tests/vt100-native-geometry.sh' ! -path 'tests/capture-transaction.lisp' ! -path 'tests/capture-transaction-tests.lisp' -print0 | sort -z | xargs -0 sha256sum")))
(defun current-bindings-p (head tree snapshot)
  (multiple-value-bind (h tr) (vttest-area::source-bindings)
    (and (equal h head) (equal tr tree) (equal snapshot (source-snapshot)))))
(defun provenance-file (root name provenance)
  (let ((h (digest (path+ root name))))
    (need (search (format nil "~a  ./~a~%" h name) provenance) :artifact-provenance)
    (list :path (path+ root name) :sha256 h)))
(defun be32 (v p) (vttest-cursor-oracle::be32 v p))
(defun check-geometry (pause png e status barrier final geometry dimensions image-size child)
  "Validate a raw six-pause observation, independently of any PASS marker."
  (let* ((cols (if (member pause '(2 4)) 132 80)) (w (* cols 8))
         (g (getf status :geometry)) (window (getf g :window-id)))
    (need (and (>= (length png) 24)
               (equal '(137 80 78 71 13 10 26 10) (coerce (subseq png 0 8) 'list))
               (= 13 (be32 png 8)) (equal '(73 72 68 82) (coerce (subseq png 12 16) 'list))
               (= w (be32 png 16)) (= 384 (be32 png 20))) :png-geometry)
    (need (and (= 3 (getf e :recorder-version))
               (= w (getf e :logical-width) (getf e :pixel-width))
               (= 384 (getf e :logical-height) (getf e :pixel-height))
               (= 1 (getf e :scale) (getf barrier :desired-scale))
               (= 1280 (getf e :output-width)) (= 800 (getf e :output-height))
               (= 0 (getf e :output-x) (getf e :output-y))
               (<= 0 (getf e :x) (- 1280 w)) (<= 0 (getf e :y) 416)) :private-bounds)
    (need (and (integerp window) (plusp window)
               (search (format nil "WINDOW=~d~%" window) geometry)
               (search (format nil "X=~d~%Y=~d~%WIDTH=~d~%HEIGHT=384~%" (getf e :x) (getf e :y) w) geometry)
               (equal (format nil "expected=~dx384 actual=~dx384 window=~d fixture-scale=1" w w window) (trim dimensions))
               (equal (format nil "~d 384" w) (trim image-size))) :raw-external-geometry)
    (need (and (equal status final) (equal status (getf barrier :status))
               (= 3 (getf barrier :recorder-version))
               (eq :x11 (getf status :backend)) (eq :attached (getf status :state))
               (eq t (getf status :worker-alive-p)) (zerop (getf status :error-count))
               (= child (getf status :child-pid)) (eq :open (getf status :transport-state))
               (eq :running (getf status :process-state))
               (= 24 (getf status :rows) (getf status :pty-rows) (getf g :rows) (getf g :requested-rows))
               (= cols (getf status :columns) (getf status :pty-columns) (getf g :columns) (getf g :requested-columns))
               (= 8 (getf g :cell-width)) (= 16 (getf g :cell-height))
               (= w (getf g :actual-width) (getf g :requested-width) (getf g :width))
               (= 384 (getf g :actual-height) (getf g :requested-height) (getf g :height))
               (eq :settled (getf g :phase)) (eq :x11 (getf g :backend))
               (>= (getf g :presentation) (getf g :target-presentation))
               (plusp (getf g :target-presentation))
               (= (getf g :request-id) (getf status :engine-geometry-generation))
               (> (getf status :frames) (getf barrier :before-frame))
               (>= (getf status :bytes-received) (getf barrier :target-output))) :raw-readiness)
    ;; There is no native acknowledgement on this recorder path. Presentation,
    ;; bytes, raw external geometry and the exact image are the actual proofs.
    (need (= -1 (getf barrier :native-ack-output)) :unexpected-native-ack)
    (dolist (key '(:columns :rows :cell-width :cell-height))
      (need (loop for (k v) on g by #'cddr always (or (not (eq k key)) (eql v (getf g key))))
            :inconsistent-raw-geometry))
    (list :pause pause :width w :height 384 :window window :child child :native-acknowledgement nil)))

(defun validate-receipt (art root request snapshot head)
  (need (and (> (length art) (length root))
             (equal root (subseq art 0 (length root)))
             (not (find #\/ art :start (length root)))) :capture-receipt-path)
  (vttest-area::safe-components art)
  (let ((a (concatenate 'string art "/")))
    (need (equal request (read-data (path+ a "area-request.sexp"))) :stale-launch-receipt)
    (need (equal snapshot (text (path+ a "source.sha256"))) :captured-source-changed)
    (need (equal head (trim (text (path+ a "run-head.txt")))) :captured-head-changed)
    a))
(defun private-session (pid proc transport isolation display-number client-wait)
  (let* ((lines (uiop:split-string proc :separator '(#\Newline)))
         (stat (second lines)) (end (position #\) stat :from-end t))
         (fields (and end (remove "" (uiop:split-string (subseq stat (+ end 2)) :separator '(#\Space)) :test #'equal)))
         (kv (loop for line in (uiop:split-string transport :separator '(#\Newline))
                   for pos = (position #\= line) when pos collect (cons (subseq line 0 pos) (subseq line (1+ pos)))))
         (server (cdr (assoc "server" kv :test #'equal))) (start (cdr (assoc "start" kv :test #'equal))))
    (need (and (integerp pid) (plusp pid) (= 6 (length (remove "" lines :test #'equal)))
               (equal (first lines) (format nil "pid=~d" pid))
               (search (format nil "~d (" pid) stat) (>= (length fields) 20)
               (= pid (parse-integer (nth 2 fields)) (parse-integer (nth 3 fields)))
               (search (format nil "client=~d start=~a endpoints=private~%" pid (nth 19 fields)) isolation)
               (every (lambda (x) (equal (third lines) x)) (subseq lines 2 5))
               (search "/dev/pts/" (third lines)) (equal "24 80" (sixth lines))
               (and server start (every #'digit-char-p server) (every #'digit-char-p start))
               (equal (cdr (assoc "DISPLAY" kv :test #'equal)) (format nil ":~a" (trim display-number)))
               (search (format nil "backend=x11 scale=1 server=~a start=~a runtime=/tmp/lispterm-x11." server start) isolation))
          :private-session)
    (let ((wait (uiop:split-string (trim client-wait) :separator '(#\Space))))
      (need (and (= 4 (length wait)) (equal "client-wait" (first wait))
                 (equal (format nil "pid=~a" (nth 1 fields)) (second wait))
                 (uiop:string-prefix-p "start=" (third wait))
                 (plusp (length (subseq (third wait) 6)))
                 (every #'digit-char-p (subseq (third wait) 6))
                 (equal "status=0" (fourth wait))
                 (search (format nil "client=~a ~a endpoints=private~%" (nth 1 fields) (third wait)) isolation))
            :client-wait-proof))
    t))
(defun mechanical (a)
  (dolist (name '("harness.exit" "cursor.exit"))
    (need (equal "0" (trim (text (path+ a name)))) :native-exit))
  (let* ((inventory (raw-data (path+ a "inventory.sexp")))
         (finished (raw-data (path+ a "finished.sexp")))
         (r (raw-data (path+ a "cursor.result.sexp")))
         (checks (raw-data (path+ a "checks.sexp")))
         (cases (getf checks :cases)))
    (need (and (= 3 (getf inventory :recorder-version)) (= 1 (getf inventory :desired-scale))
               (every (lambda (key) (equal '("cursor") (getf inventory key))) '(:expected :attempted :completed))
               (= 3 (getf finished :recorder-version)) (= 6 (getf finished :captures))
               (getf finished :baseline-only)) :native-inventory)
    (need (and (equal "cursor" (getf r :label)) (equal '(1) (getf r :path))
               (eq t (getf r :returned-to-menu)) (getf r :inventory-ok)
               (not (getf r :failure)) (not (getf r :errors))
               (every (lambda (k) (= 6 (getf r k))) '(:pauses :expected-pauses :captures :expected-captures))
               (= 0 (getf r :key-phases))
               (eq t (getf checks :pass)) (null (getf checks :errors)) (= 1 (length cases))
               (equal "cursor" (getf (first cases) :label)) (= 0 (getf (first cases) :exit))
               (getf (first cases) :returned-to-menu) (null (getf (first cases) :issues))) :native-mechanical)
    (need (and (search "all-owned-stopped" (text (path+ a "cleanup.log")))
               (not (search "SURVIVED" (text (path+ a "cleanup.log")))) ) :owned-cleanup)
    (let* ((pid (getf (getf r :status) :child-pid))
           (proc (text (path+ a "cursor.process.txt")))
           (isolation (text (path+ a "isolation.txt"))))
      (private-session pid proc (text (path+ a "transport.txt")) isolation
                       (text (path+ a "display-number")) (text (path+ a "client-wait.log")))
      pid)))

(defun launch-arguments (directory font)
  (let ((d (namestring (truename directory))))
    (append (list "-i" "PATH=/run/current-system/sw/bin:/usr/bin:/bin")
            (loop for (key name) on '("HOME" "home" "XDG_CACHE_HOME" "cache" "XDG_CONFIG_HOME" "config"
                                     "XDG_DATA_HOME" "data" "TMPDIR" "tmp") by #'cddr
                  collect (format nil "~a=~a~a" key d name))
            (list (format nil "LISPTERM_FONT=~a" font)
                  "LISPTERM_VTTEST_EXACT_LABELS=cursor" "LISPTERM_VTTEST_MODE=record"
                  "LISPTERM_VTTEST_SCALE=1" "LISPTERM_VTTEST_TIMEOUT=120"
                  (format nil "LISPTERM_VTTEST_AREA_REQUEST=~alaunch-request.sexp" d)
                  (format nil "LISPTERM_VTTEST_AREA_RECEIPT=~alaunch-receipt.txt" d)
                  "tests/vttest-gate.sh" "x11"))))
(defun run (m directory manifest-path manifest-hash head tree)
  "One actual launch. The only path to fresh observations is a completed child,
its unique receipt, unchanged sources, retained raw proofs and new comparisons."
  (validate m)
  (need directory :missing-driver-context)
  (let* ((d (namestring (truename directory)))
         (font (namestring (truename ".build/deps/share/fonts/terminus/ter-u16n.otb")))
         (snapshot (source-snapshot))
         (request (list :kind :cursor-x11-launch :nonce d :manifest-sha256 manifest-hash
                        :backend "x11" :conditions (getf m :conditions) :source-head head :source-tree tree
                        :source-sha256 (vttest-area::sha256 (sb-ext:string-to-octets snapshot :external-format :utf-8))))
         (args (launch-arguments d font)) (bindings nil) (observations nil) (screens nil))
    (need (and (equal +binary+ (digest (namestring (truename ".build/test-tools/bin/vttest"))))
               (equal +font+ (digest font))) :runtime-pin)
    (need (current-bindings-p head tree snapshot) :source-changed-before-launch)
    (dolist (name '("home" "cache" "config" "data" "tmp")) (sb-posix:mkdir (path+ d name) #o700))
    (put (path+ d "launch-request.sexp") request)
    (put (path+ d "launch-command.sexp") (cons "/run/current-system/sw/bin/env" args))
    (with-open-file (s (path+ d "native.log") :direction :output :if-exists :error)
      (let ((p (sb-ext:run-program "/run/current-system/sw/bin/env" args :input nil :output s :error s)))
        (need (eql 0 (sb-ext:process-exit-code p)) :native-launch-failed)))
    (let* ((art (trim (text (path+ d "launch-receipt.txt"))))
           (root (path+ (namestring (truename ".build/evidence/")) "vttest-x11-scale1-v3."))
           (a (validate-receipt art root request snapshot head))
           (provenance (text (path+ a "provenance.sha256")))
           (child (mechanical a)))
      (need (equal (loop for n from 1 to 6 collect (format nil "~3,'0d-cursor-pause~2,'0d.png" n n))
                   (sort (mapcar #'file-namestring (uiop:directory-files a "*.png")) #'string<)) :exact-png-inventory)
      (need (current-bindings-p head tree snapshot) :source-changed-after-launch)
      (need (equal manifest-hash (nth-value 1 (read-data manifest-path))) :manifest-changed)
      (need (search (format nil "~a  ~a~%" +font+ font) (text (path+ a "binary-font.sha256"))) :captured-font)
      (need (search (format nil "~a  ~a.build/test-tools/bin/vttest~%" +binary+ (namestring (truename "./")))
                    (text (path+ a "binary-font.sha256"))) :captured-binary)
      (dolist (s '("mode=record" "exact-labels=cursor" "backend=x11" "fixture-scale=1" "override=false"))
        (need (search (format nil "~a~%" s) (text (path+ a "fixture.txt"))) :capture-fixture))
      (dolist (name '("area-request.sexp" "source.sha256" "run-head.txt" "working-tree.diff" "binary-font.sha256"
                      "fixture.txt" "inventory.sexp" "finished.sexp" "checks.sexp" "cursor.result.sexp"
                      "cursor.process.txt" "cursor.transcript.raw" "cursor.vttest.log" "isolation.txt" "transport.txt" "display-number"
                      "harness.exit" "client-wait.log" "cursor.exit" "cleanup.log"))
        (push (provenance-file a name provenance) bindings))
      (dolist (name '("vttest-area.lisp" "vttest-cursor-driver.lisp" "vttest-cursor-oracle.lisp" "vttest-gate.sh"
                      "vttest-gate.lisp" "vttest-protocol.lisp" "vttest-selection.lisp" "verify.sh"))
        (need (equal (digest (path+ "tests/" name)) (digest (path+ a name))) :snapshot-mismatch)
        (push (provenance-file a name provenance) bindings))
      (loop for pause from 1 to 6 do
        (let* ((stem (format nil "~3,'0d-cursor-pause~2,'0d" pause pause)) (prefix (path+ a stem))
               (input (path+ prefix ".png"))
               (geometry (check-geometry pause (bytes input) (raw-data (path+ prefix ".external.sexp"))
                          (raw-data (path+ prefix ".status.sexp")) (raw-data (path+ prefix ".barrier.sexp"))
                          (raw-data (path+ prefix ".final-status.sexp")) (text (path+ prefix ".geometry.txt"))
                          (text (path+ prefix ".dimensions.txt")) (text (path+ prefix ".image-size.txt")) child))
               (out (path+ d (format nil "pause~d/" pause)))
               (comparison (vttest-cursor-oracle:compare-png pause input font out ".build/test-tools/bin/magick"))
               (result (getf comparison :comparison)))
          (dolist (suffix '(".png" ".external.sexp" ".status.sexp" ".barrier.sexp" ".final-status.sexp"
                            ".geometry.txt" ".dimensions.txt" ".image-size.txt"))
            (push (provenance-file a (path+ stem suffix) provenance) bindings))
          ;; Retain human-viewable expected/diff images as well as the API's PPM.
          (multiple-value-bind (cells cursor) (vttest-cursor-oracle:screen pause)
            (vttest-cursor-oracle:write-ppm (path+ out "expected.ppm")
              (vttest-cursor-oracle:rasterize cells (bytes font) :cursor cursor)
              :width (* 8 (array-dimension cells 1))))
          (dolist (name '("expected" "diff"))
            (command-output ".build/test-tools/bin/magick" (list (path+ out (path+ name ".ppm")) (path+ out (path+ name ".png")))))
          (put (path+ out "COMPARISON.sexp") comparison)
          (push (list :geometry geometry :comparison comparison :actual input :expected (path+ out "expected.png")
                      :diff (path+ out "diff.png") :actual-sha256 (digest input)
                      :expected-sha256 (digest (path+ out "expected.png")) :diff-sha256 (digest (path+ out "diff.png"))) screens)
          (push (list :scenario "cursor" :capture (format nil "pause-~d" pause) :fresh t :fixture nil
                      :pixels (if (getf result :pass) :pass :fail) :bytes :unverified :timing :unverified) observations)))
      (need (current-bindings-p head tree snapshot) :source-changed-during-comparison)
      (need (equal manifest-hash (nth-value 1 (read-data manifest-path))) :manifest-changed)
      (dolist (b bindings) (need (equal (getf b :sha256) (digest (getf b :path))) :artifact-changed))
      (let* ((evidence (list :capture a :launch-request request :provenance-sha256 (digest (path+ a "provenance.sha256"))
                             :bindings (nreverse bindings) :screens (nreverse screens) :native-acknowledgement nil
                             :image-inspection :pending))
             (ready (list :capability "cursor-x11-runtime" :status :ready :source-head head :source-tree tree
                          :manifest-sha256 manifest-hash :source-sha256 (getf request :source-sha256)
                          :backend "x11" :conditions (getf m :conditions) :capture a)))
        (put (path+ d "DRIVER-EVIDENCE.sexp") evidence)
        (values (nreverse observations) evidence (list ready))))))
