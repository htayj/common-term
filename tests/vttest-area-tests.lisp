(defpackage :vttest-area-tests (:use :cl) (:export :run))
(in-package :vttest-area-tests)
(defvar *checks* 0)
(defvar *root*)
(defun check (test label)
  (unless test (error "Control failed: ~A" label))
  (incf *checks*) (format t "PASS ~A~%" label))
(defun fresh-path (name)
  (let ((p (concatenate 'string *root* name)))
    (when (probe-file p) (error "Fixture path already exists: ~A" p)) p))
(defun put-text (name text)
  (let ((p (fresh-path name)))
    (with-open-file (s p :direction :output :if-exists :error :if-does-not-exist :create)
      (write-string text s)) p))
(defun put-data (name data)
  (put-text name (with-output-to-string (s) (let ((*print-readably* t) (*print-pretty* nil)) (write data :stream s)))))
(defun documentary-fixture (name)
  (put-data name '(:areas ((:area "cursor-movements"))
                   :area-dependencies ((:area "cursor-movements")))))
(defun fixture ()
  (copy-tree (vttest-area:read-data "tests/fixtures/vttest-area/frozen.sexp")))
(defun scenario (m) (first (getf m :scenarios)))
(defun (setf scenario) (value m)
  (setf (first (getf m :scenarios)) value))
(defun observation (&rest changes)
  (let ((o (list :scenario "cursor-fixture" :capture "pause-1" :fresh t :fixture t
                 :pixels :pass :bytes :pass :timing :pass)))
    (loop for (k v) on changes by #'cddr do (setf (getf o k) v)) o))
(defun cli (args expected label &key reason count hash)
  ;; Exercise the real public dispatcher and read its exclusive result record.
  (let* ((out (make-string-output-stream)) (err (make-string-output-stream))
         (p (sb-ext:run-program "tests/verify.sh" (cons "vttest-area" args) :output out :error err))
         (stdout (get-output-stream-string out)) (stderr (get-output-stream-string err))
         (marker (search "RESULT " stdout)))
    (format t "CLI ~A~%~A~A" label stdout stderr)
    (check (= (sb-ext:process-exit-code p) expected) label)
    (check marker (list label :result-present))
    (let* ((start (+ marker 7)) (end (position #\Newline stdout :start start))
           (path (subseq stdout start end)) (r (vttest-area:read-data path)))
      (check (and (eq (getf r :gate) :vttest-area) (= (getf r :exit) expected)
                  (null (getf r :fixture)) (null (getf r :observed-count))
                  (null (getf r :passed-count)) (null (getf r :failed-count))) (list label :honest-record))
      (multiple-value-bind (head tree) (vttest-area::source-bindings)
        (check (and (equal head (getf r :source-head)) (equal tree (getf r :source-tree))) (list label :source-binding)))
      (check (eql count (getf r :required-count)) (list label :count))
      (when hash (check (equal hash (getf r :manifest-sha256)) (list label :manifest-hash)))
      (when reason (check (eq reason (getf r :reason)) (list label :reason))) r)))
(defun args (path &optional (area "cursor-movements") (backend "x11"))
  (list "--area" area "--backend" backend "--manifest" path))
(defun invalid-data (name text)
  (cli (args (put-text name text)) 2 name))
(defun invalid-manifest (name mutate)
  (let ((m (fixture))) (funcall mutate m) (cli (args (put-data name m)) 2 name)))
(defun aggregate (obs &key (fixture t) (scenarios (getf (fixture) :scenarios)))
  (vttest-area:aggregate-observations scenarios obs :fixture fixture))
(defun problem-p (thunk)
  (handler-case (progn (funcall thunk) nil) (vttest-area:gate-problem () t)))
(defun run ()
  (setf *checks* 0)
  (handler-case
      (progn
        ;; Parent creation and every fixture write are exclusive, never cleanup.
        (handler-case (sb-posix:mkdir ".build/evidence/vttest-area-runs" #o700)
          (sb-posix:syscall-error (e) (unless (= (sb-posix:syscall-errno e) sb-posix:eexist) (error e))))
        (setf *root* (concatenate 'string (sb-posix:mkdtemp ".build/evidence/vttest-area-runs/controls-XXXXXX") "/"))
        (format t "CONTROL-FIXTURES ~A~%" *root*)
        (check (equal (vttest-area::sha256 #()) "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") :sha-empty)
        (check (equal (vttest-area::sha256 (sb-ext:string-to-octets "abc" :external-format :utf-8))
                      "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") :sha-abc)
        (check (equal (vttest-area::sha256 (make-array 1000 :element-type '(unsigned-byte 8) :initial-element 97))
                      "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3") :sha-multiblock)
          (check (equal '(("cursor" (1) 6)) (vttest-area::preflight-selection "cursor")) :exact-cursor)
          (check (equal '(("bug-e" (9 5) 1)) (vttest-area::preflight-selection "bug-e")) :exact-not-substring)
          (dolist (bad '("cursor-extra" "cursor," "cursor cursor" "cursor,cursor" ""))
            (check (problem-p (lambda () (vttest-area::preflight-selection bad))) (list :bad-exact bad)))
          (check (problem-p (lambda () (vttest-area::preflight-selection "cursor" ""))) :simultaneous-selectors)
          (unwind-protect
              (progn
                (sb-posix:setenv "LISPTERM_VTTEST_EXACT_LABELS" "cursor-extra" 1)
                (cli (args (documentary-fixture "bad-selector-documentary.sexp"))
                     2 :bad-selector-before-readiness :reason :invalid-recorder-selection))
            (sb-posix:unsetenv "LISPTERM_VTTEST_EXACT_LABELS"))
        (cli nil 2 :no-flags)
        (cli '("--area" "cursor-movements") 2 :missing-flags)
        (cli '("--area" "cursor-movements" "--area" "cursor-movements" "--manifest" "x") 2 :repeated)
        (cli '("--area" "cursor-movements" "--backend" "x11" "--wat" "x") 2 :unknown-flag)
        (cli (append (args "x") '("extra")) 2 :extra)
        (cli (args "x" "unknown") 2 :unknown-area)
        (cli (args "x" "cursor-movements" "X11") 2 :bad-backend)
        (cli (args "../x") 2 :traversal)
        (cli (args "/etc/../x") 2 :absolute-traversal)
        (cli (args "no-such-area-manifest") 2 :missing-file)
        (cli (args "tests") 2 :directory)
        (let ((link (fresh-path "link")))
          (sb-posix:symlink (namestring (truename "tests/fixtures/vttest-area/frozen.sexp")) link)
          (cli (args link) 2 :symlink))
        (let ((link (fresh-path "parent-link")))
          (sb-posix:symlink (namestring (truename "tests/fixtures/vttest-area/")) link)
          (cli (args (concatenate 'string link "/frozen.sexp")) 2 :parent-symlink))
        (let ((fifo (fresh-path "fifo"))) (sb-posix:mkfifo fifo #o600) (cli (args fifo) 2 :fifo))
        (invalid-data "read-eval" "#.(error \"must not execute\")")
        (invalid-data "two-forms" "(:a 1) (:b 2)")
        (invalid-data "oversize" (make-string 1048577 :initial-element #\Space))
        (invalid-data "cycle" "#1=(:x . #1#)")
        (invalid-data "reader-label" "(#1=(:x) #1#)")
        (invalid-data "improper" "(:kind . :vttest-area-manifest)")
        (invalid-data "deep" (concatenate 'string (make-string 65 :initial-element #\() "nil" (make-string 65 :initial-element #\))))
        (invalid-data "huge-array" "#A((999999999999) BASE-CHAR . \"x\")")
        (invalid-manifest "duplicate-key" (lambda (m) (nconc m '(:version 1))))
        (invalid-manifest "unknown-key" (lambda (m) (nconc m '(:surprise t))))
        (invalid-manifest "empty-scenarios" (lambda (m) (setf (getf m :scenarios) nil)))
        (invalid-manifest "duplicate-scenarios" (lambda (m) (push (copy-tree (scenario m)) (getf m :scenarios))))
        (invalid-manifest "count" (lambda (m) (setf (getf m :required-count) 2)))
        (invalid-manifest "selector" (lambda (m) (setf (getf (scenario m) :recorder-label) "bug-e")))
        (invalid-manifest "hash" (lambda (m) (setf (getf (getf (scenario m) :oracle) :sha256) "bad")))
        (invalid-manifest "backend-mismatch" (lambda (m) (setf (getf m :backend) "wayland")))
        (invalid-manifest "unknown-label" (lambda (m) (setf (getf (scenario m) :recorder-label) "cursor-extra")))
        (invalid-manifest "capture-type" (lambda (m) (setf (getf (first (getf (scenario m) :captures)) :pause) "1")))
        (invalid-manifest "duplicate-captures" (lambda (m) (push (copy-tree (first (getf (scenario m) :captures))) (getf (scenario m) :captures))))
        (invalid-manifest "bytes-type" (lambda (m) (setf (getf (scenario m) :bytes) :yes)))
        (invalid-manifest "oracle-traversal" (lambda (m) (setf (getf (getf (scenario m) :oracle) :path) "../oracle")))
        (dolist (backend '("x11" "wayland"))
          (let* ((path (documentary-fixture (format nil "documentary-~A.sexp" backend)))
                 (label (list :documentary backend)))
            (check (and (probe-file path)
                        (equal (pathname-directory (truename path))
                               (pathname-directory (truename *root*))))
                   (list label :owned-fixture))
            (let ((r (cli (args path "cursor-movements" backend) 3 label
                          :reason :scope-not-executable)))
              (check (and (eq (getf r :outcome) :unverified)
                          (null (getf r :unverified-count))
                          (null (getf r :scenarios))
                          (null (getf r :readiness))
                          (null (getf r :driver-evidence)))
                     (list label :native-not-run)))))
        (multiple-value-bind (m hash) (vttest-area:read-data "tests/fixtures/vttest-area/frozen.sexp")
          (declare (ignore m))
          (cli (args "tests/fixtures/vttest-area/frozen.sexp") 3 :missing-capability :count 1 :hash hash
               :reason :capability-unavailable-or-mismatched))
        (let* ((m (fixture)) (record-path (fresh-path "ready.sexp"))
               (manifest-path (fresh-path "ready-manifest.sexp")))
          (setf (getf (first (getf (scenario m) :requires)) :path) record-path)
          (put-data "ready-manifest.sexp" m)
          (multiple-value-bind (ignore hash) (vttest-area:read-data manifest-path)
            (declare (ignore ignore))
            (multiple-value-bind (head tree) (vttest-area::source-bindings)
              (let ((record (list :kind :vttest-capability :version 1 :capability "capture" :status :ready
                                  :source-head head :source-tree tree :manifest-sha256 hash :backend "x11"
                                  :conditions (getf m :conditions))))
                (put-data "ready.sexp" record)
                (let ((r (cli (args manifest-path) 3 :spoofed-ready :count 1 :hash hash :reason :driver-not-integrated)))
                  (check (and (getf r :readiness) (getf (first (getf r :readiness)) :sha256)) :readiness-hashed))
                ;; A distinct mismatching record and manifest, never overwrite.
                (setf (getf record :backend) "wayland")
                (let ((bad (put-data "mismatch.sexp" record)))
                  (setf (getf (first (getf (scenario m) :requires)) :path) bad)
                  (cli (args (put-data "mismatch-manifest.sexp" m)) 3 :mismatch-capability :count 1
                       :reason :capability-unavailable-or-mismatched))))))
        (let ((m (fixture)))
          (setf (getf (scenario m) :recorder-label) "new-exact-label" (getf (scenario m) :new-path) t)
          (cli (args (put-data "new-path.sexp" m)) 3 :declared-new-path :count 1))
        (check (eq :fixture-pass (aggregate (list (observation)))) :fixture-positive)
        (check (eq :unverified (aggregate (list (observation)) :fixture nil)) :fixture-cannot-promote)
        (check (eq :unverified (aggregate (list (observation :pixels :unverified)))) :missing-pixels)
        (check (eq :unverified (aggregate nil)) :missing-observation)
        (check (eq :fail (aggregate (list (observation :bytes :fail)))) :failed-bytes)
        (check (eq :fail (aggregate (list (observation :timing :fail)))) :failed-timing)
          (check (eq :unverified (aggregate (list (observation :fresh nil)))) :stale)
          (check (eq :unverified (aggregate (list (observation) (observation)))) :duplicate-identities)
          (check (eq :unverified (aggregate (list (observation :scenario "other")))) :wrong-scenario)
          (check (eq :unverified (aggregate (list (observation :capture "other")))) :wrong-capture)
        (check (problem-p (lambda () (aggregate nil :scenarios nil))) :empty-refusal)
        (let ((cycle (list :id "cycle")))
          (setf (cdr (last cycle)) cycle)
          (check (problem-p (lambda () (vttest-area::proper cycle))) :in-memory-cycle))
        (format t "~D controls passed. Fixture capability only; no product gate passed.~%" *checks*) t)
    (error (e) (format *error-output* "CONTROL FAILURE: ~A~%" e) nil)))
