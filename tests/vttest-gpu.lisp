;;;; Dependency-free hardware-default evidence checks for the native vttest fixture.
(defpackage #:vttest-gpu
  (:use #:cl)
  (:export #:validate-receipt #:check-directory))
(in-package #:vttest-gpu)

(defun read-evidence (path)
  (with-open-file (in path)
    (assert (<= (file-length in) 1048576) () "Oversize GPU evidence: ~a" path)
    (let* ((*read-eval* nil) (eof (gensym)) (value (read in nil eof)))
      (assert (and (not (eq value eof)) (eq eof (read in nil eof))) ()
              "Expected exactly one evidence form: ~a" path)
      value)))

(defun validate-receipt (receipt label backend)
  "Require real draw metrics and EGL device classification, never a name heuristic."
  (assert (and (equal label (getf receipt :label))
               (eq backend (getf receipt :backend))
               (eq :auto (getf receipt :renderer-request))) () "GPU receipt identity mismatch")
  (let* ((status (getf receipt :status))
         (metrics (getf status :geometry)) (driver (getf metrics :driver))
         (missing (gensym)))
    (assert (eq backend (getf status :backend)))
    (assert (eq :gpu (getf metrics :renderer)) () "Default renderer fell back from GPU: ~s" metrics)
    (assert (and (eq t (getf driver :device-associated-p))
                 (null (getf driver :software-p missing))
                 (stringp (getf driver :device))
                 (plusp (length (getf driver :device)))) () "Missing associated hardware device: ~s" driver)
    (assert (and (integerp (getf metrics :draw-calls))
                 (plusp (getf metrics :draw-calls))) () "No real GL draw recorded: ~s" metrics))
  t)

(defun check-directory (directory)
  "Recheck each expected host's persisted proof after the ordinary protocol checker."
  (let* ((root (pathname directory))
         (inventory (read-evidence (merge-pathnames "inventory.sexp" root)))
         (expected (getf inventory :expected))
         (backend nil))
    (assert (and expected (equal expected (getf inventory :attempted))
                 (equal expected (getf inventory :completed))
                 (= (length expected) (length (remove-duplicates expected :test #'equal)))))
    (dolist (label expected)
      (assert (and (stringp label) (plusp (length label))
                   (every (lambda (c) (or (alphanumericp c) (find c "-_"))) label)))
      (let ((receipt (read-evidence (merge-pathnames (format nil "~a.gpu.sexp" label) root))))
        (unless backend (setf backend (getf receipt :backend)))
        (assert (member backend '(:x11 :wayland)))
        (assert (eq :accept (getf receipt :mode)) () "GPU acceptance requires native accept mode")
        (validate-receipt receipt label backend)))
    (format t "Hardware-default GPU receipts passed: ~d hosts, ~s.~%" (length expected) backend)
    t))
