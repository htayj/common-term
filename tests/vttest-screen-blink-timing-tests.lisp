;;;; Focused blink receipt tests. Standalone: sbcl --non-interactive --load this file.
(load (merge-pathnames "vttest-screen-blink-timing-stubs.lisp" *load-truename*))
(in-package #:vttest-screen-blink-timing-tests)

(defvar *checks* 0)
(defun check (name value)
  (incf *checks*)
  (format t "~S~%" (list :check name :pass (not (null value))))
  (unless value (error "Blink check failed: ~S" name)))
(defun valid-p (statuses) (getf (validate-blink-chain statuses) :valid))
(defun refuses (statuses error)
  (let ((report (validate-blink-chain statuses)))
    (and (not (getf report :valid)) (assoc error (getf report :errors)))))

(defun chain (first count &key (step 1/2) (epoch-at 10))
  "Statuses for toggles FIRST..FIRST+COUNT-1, STEP apart, toggle 0 at EPOCH-AT."
  (loop for g from first below (+ first count)
        collect (list :id 1 :frames (+ 10 g) :bytes-received 500 :blink-phase (evenp g)
                      :blink-visible t :blink-epoch 3 :blink-epoch-at epoch-at :blink-toggles g
                      :blink-toggled-at (+ epoch-at (* g step))
                      :blink-previous-at (+ epoch-at (* (1- g) step)) :blink-toggle-frame (+ 10 g))))
(defun with (statuses index key value)
  (let ((copy (mapcar #'copy-list statuses)))
    (setf (getf (nth index copy) key) value)
    copy))
(defun with1 (status key value) (first (with (list status) 0 key value)))
(defun without-id (s) (let ((c (copy-list s))) (remf c :id) c))
(defun capture-errors (&rest args) (nth-value 1 (apply #'blink-capture-ready-p args)))

(defun validator-tests ()
  (let ((report (validate-blink-chain (chain 1 4))))
    (check :exact-half-accepted (getf report :valid))
    (check :three-intervals-reported (equal '(1/2 1/2 1/2) (getf report :intervals)))
    (check :reset-to-first-separate (eql 1/2 (getf report :reset-to-first))))
  (check :late-accepted (equal '(5/4 5/4 5/4) (getf (validate-blink-chain (chain 2 4 :step 7/4))
                                                  :lateness)))
  (check :repeated-observations-accepted (valid-p (mapcan (lambda (s) (list s s)) (chain 2 4))))
  (check :below-minimum-refused (refuses (chain 2 4 :step 499/1000) :interval-below-minimum))
  (check :gap-refused (refuses (remove-if (lambda (s) (= 4 (getf s :blink-toggles))) (chain 2 5))
                               :toggle-gap))
  (check :previous-at-refused (refuses (with (chain 2 4) 2 :blink-previous-at 45/4)
                                       :previous-at-mismatch))
  (check :epoch-refused (refuses (with (chain 2 4) 3 :blink-epoch 4) :source-or-epoch-changed))
  (check :source-refused (refuses (with (chain 2 4) 1 :bytes-received 501) :source-or-epoch-changed))
  (check :phase-refused (refuses (with (chain 2 4) 1 :blink-phase t) :phase-repeated))
  (check :invisible-refused (refuses (with (chain 2 4) 0 :blink-visible nil) :not-visible))
  (check :two-intervals-refused (refuses (chain 2 3) :fewer-than-four-toggle-generations))
  (check :nil-time-refused (refuses (with (chain 2 4) 1 :blink-toggled-at nil) :malformed))
  (check :float-time-refused (refuses (with (chain 2 4) 1 :blink-toggled-at 11.5) :malformed))
  (check :decreasing-refused (refuses (reverse (chain 2 4)) :observation-order-decreased))
  (check :frame-bound-refused (refuses (with (chain 2 4) 1 :frames 11) :malformed))
  (destructuring-bind (s) (chain 3 1)
    (check :capture-same-accepted (blink-capture-ready-p s (copy-list s) (copy-list s) :phase nil))
    (check :capture-phase-refused (not (blink-capture-ready-p s s s :phase t)))
    (check :capture-toggle-refused (not (blink-capture-ready-p s s (first (chain 4 1)))))
    (check :capture-frame-refused
           (not (blink-capture-ready-p s (first (with (list s) 0 :frames 14)) s)))
    (check :missing-id-shape (equal '(:missing-id) (blink-receipt-errors (without-id s))))
    (check :nil-id-capture-refused (not (blink-capture-ready-p (list* :id nil s) s s)))
    (let ((stale (with1 s :blink-epoch-at 12)))
      (check :stale-epoch-capture-refused
             (equal '(:toggle-outside-epoch) (capture-errors stale stale stale))))
    (check :epoch-only-capture-refused
           (equal '(:changed-during-capture) (capture-errors s s (with1 s :blink-epoch 4))))
    (check :bytes-only-capture-refused
           (equal '(:changed-during-capture) (capture-errors s (with1 s :bytes-received 501) s))))
  (check :missing-id-refused (refuses (mapcar #'without-id (chain 2 4)) :malformed))
  (dolist (frame '(13 12))
    (check :toggle-frame-not-increasing-refused
           (refuses (with (chain 2 4) 2 :blink-toggle-frame frame) :toggle-frame-not-increasing)))
  (check :generation-inconsistent-refused
         (refuses (with (mapcan (lambda (s) (list s s)) (chain 2 4)) 2 :blink-phase t)
                  :generation-inconsistent))
  (check :short-reset-refused (refuses (chain 1 4 :step 499/1000) :reset-to-first-below-minimum))
  (check :toggle-outside-epoch-refused
         (refuses (mapcar (lambda (s) (with1 s :blink-epoch-at 11)) (chain 2 4)) :toggle-outside-epoch)))

(defun fresh () (lispterm::%make-session :screen (make-fake)))
(defun render (session now &optional (change (lambda (screen) screen)))
  (funcall change (lispterm::session-screen session))
  (lispterm::render-session session :display :now now))
(defun status (session)
  (list* :id 1 :frames (lispterm::session-frames session)
         :bytes-received (lispterm::session-bytes-received session)
         (lispterm::session-blink-receipt session)))
(defun fields (session &rest keys) (mapcar (lambda (k) (getf (status session) k)) keys))

(defun renderer-tests ()
  (let ((s (fresh)) (chain '()))
    (render s 10)
    (check :first-visible-reset (equal '(1 10 0 t t nil 1) (fields s :blink-epoch :blink-epoch-at
           :blink-toggles :blink-phase :blink-visible :blink-toggled-at :frames)))
    (check :initial-receipt-shape (null (blink-receipt-errors (status s))))
    (render s 10499/1000)
    (check :before-threshold (equal '(0 1) (fields s :blink-toggles :frames)))
    (render s 21/2)
    (check :exact-threshold (equal '(1 nil 10 21/2 2) (fields s :blink-toggles :blink-phase
           :blink-previous-at :blink-toggled-at :blink-toggle-frame)))
    (push (status s) chain)
    (let ((before (status s)))
      (render s 43/4 (lambda (screen) (setf (fake-char screen) #\Y (fake-dirty screen) t)))
      (check :stable-content-change (and (equal '(3) (fields s :frames))
                                         (equal (cdddr (cdddr before)) (cdddr (cdddr (status s))))))
      (setf before (status s))
      (render s 109/10 (lambda (screen) (setf (fake-cursor screen) 1)))
      (check :cursor-only (and (equal '(4) (fields s :frames))
                               (equal (cddr (cddr before)) (cddr (cddr (status s)))))))
    (let ((*fail-draw* t) (before (status s)))
      (check :draw-error-signalled (handler-case (progn (render s 11) nil) (error () t)))
      (check :draw-error-publishes-nothing (equal before (status s))))
    (dolist (now '(11 23/2 12)) (render s now) (push (status s) chain))
    (let ((report (validate-blink-chain (reverse chain))))
      (check :renderer-chain-valid (getf report :valid))
      (check :renderer-chain-reset-to-first (eql 1/2 (getf report :reset-to-first))))
    (render s 49/4 (lambda (screen) (setf (fake-blink screen) nil (fake-dirty screen) t)))
    (check :visible-to-hidden (equal '(2 49/4 t nil 4) (fields s :blink-epoch :blink-epoch-at
           :blink-phase :blink-visible :blink-toggles)))
    (render s 13 (lambda (screen) (setf (fake-blink screen) t (fake-dirty screen) t)))
    (check :hidden-to-visible (equal '(3 13 t t 4) (fields s :blink-epoch :blink-epoch-at
           :blink-phase :blink-visible :blink-toggles)))
    (render s 27/2)
    (check :first-toggle-chains-from-epoch-at
           (equal '(5 13 27/2) (fields s :blink-toggles :blink-previous-at :blink-toggled-at)))))

(validator-tests)
(renderer-tests)
(format t "~S~%" (list :blink-timing-tests :passed *checks*))
