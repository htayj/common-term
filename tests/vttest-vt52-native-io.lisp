;;;; Bounded original-evidence transport. No application or CLI entry point.
(require :sb-posix)
(load (merge-pathnames "vttest-vt52-sha256.lisp" *load-truename*))
(defpackage :vttest-vt52-native-io
  (:use :cl)
  (:export :need :guard-tree :properties :canonical-root :local-path
           :read-octets :read-text :parse-data :read-data :read-events :write-data
           :digest-file :reference :check-reference :hex-p))
(in-package :vttest-vt52-native-io)
(defun need (test &optional (reason "Invalid evidence"))
  (unless test (error "~a" reason)))
(defun guard-tree (value &key events)
  "Reject improper/shared/cyclic trees before any schema traversal."
  (let ((seen (make-hash-table :test 'eq)) (conses 0) (bytes 0) (nodes 0))
    (labels ((walk (x depth)
               (need (and (<= depth 32) (<= (incf nodes) (if events 2097152 16384))))
               (typecase x
                 (cons
                  (loop for tail = x then (cdr tail) while (consp tail) do
                    (need (and (not (gethash tail seen))
                               (<= (incf conses) (if events 65536 4096))))
                    (setf (gethash tail seen) t)
                    (walk (car tail) (1+ depth))
                    finally (need (null tail) "Improper list")))
                 (string (need (<= (length x) 8192)))
                 ((or boolean keyword integer) nil)
                 (vector
                  (need (and events (not (gethash x seen))))
                  (setf (gethash x seen) t)
                  (incf bytes (length x)) (need (<= bytes 1048576))
                  (loop for n across x do (need (typep n '(unsigned-byte 8)))))
                 (t (error "Unsupported evidence object")))))
      (walk value 0)))
  value)
(defun properties (value allowed &optional (required allowed))
  (guard-tree value)
  (need (and (listp value) (evenp (length value))))
  (let ((seen nil))
    (loop for k in value by #'cddr do
      (need (and (member k allowed) (not (member k seen))) "Unknown/duplicate key")
      (push k seen))
    (need (every (lambda (k) (member k seen)) required) "Missing key"))
  value)
(defun canonical-root (root)
  (need (and (stringp root) (plusp (length root)) (char= #\/ (char root 0))))
  (let* ((r (namestring (truename root))) (s (sb-posix:lstat r)))
    (need (and (equal r root) (sb-posix:s-isdir (sb-posix:stat-mode s))
               (= (sb-posix:getuid) (sb-posix:stat-uid s))) "Invalid owned root") r))
(defun relative-p (path)
  (and (stringp path) (plusp (length path))
       (char/= #\/ (char path 0)) (not (find #\Null path))
       (every (lambda (x) (and (plusp (length x)) (not (member x '("." "..") :test #'equal))))
         (loop for start = 0 then (1+ end) for end = (position #\/ path :start start)
               collect (subseq path start end) while end))))
(defun local-path (root relative &key missing)
  (canonical-root root) (need (relative-p relative) "Foreign path")
  (let ((p (concatenate 'string root relative)))
    (if missing
        (let ((parent (namestring (make-pathname :name nil :type nil :defaults p))))
          (need (equal parent (namestring (truename parent))))
          (handler-case (progn (sb-posix:lstat p) (error "Existing output"))
            (sb-posix:syscall-error (e) (need (= sb-posix:enoent (sb-posix:syscall-errno e))))))
        (need (equal p (namestring (truename p))) "Noncanonical/symlink path")) p))
(defun read-file-octets (path limit)
  (need (equal path (namestring (truename path))) "Noncanonical file")
  (let* ((s (sb-posix:lstat path))
         (fd (progn (need (and (sb-posix:s-isreg (sb-posix:stat-mode s))
                               (<= (sb-posix:stat-size s) limit)))
                    (sb-posix:open path (logior sb-posix:o-rdonly sb-posix:o-nofollow) 0))))
    (with-open-stream (in (sb-sys:make-fd-stream fd :input t :element-type '(unsigned-byte 8) :auto-close t))
      (let* ((actual (sb-posix:fstat fd)) (v (make-array (1+ limit) :element-type '(unsigned-byte 8)))
             (n (read-sequence v in)))
        (need (and (= (sb-posix:stat-ino s) (sb-posix:stat-ino actual))
                   (= (sb-posix:stat-dev s) (sb-posix:stat-dev actual))
                   (= n (sb-posix:stat-size s)) (<= n limit)))
        (subseq v 0 n)))))
(defun read-octets (root relative &key (limit 8192))
  (read-file-octets (local-path root relative) limit))
(defun read-text (root relative &key (limit 8192))
  (sb-ext:octets-to-string (read-octets root relative :limit limit) :external-format :utf-8))
(defun preflight (text events)
  (let ((quoted nil) (escape nil) (depth 0))
    (loop for i from 0 below (length text) for c = (char text i) do
      (cond (quoted (cond (escape (setf escape nil)) ((char= c #\\) (setf escape t))
                          ((char= c #\") (setf quoted nil))))
            ((char= c #\") (setf quoted t))
            ((char= c #\#)
             (need (and events (< (1+ i) (length text)) (char= #\( (char text (1+ i)))) "Reader dispatch"))
            ((char= c #\() (need (<= (incf depth) 32)))
            ((char= c #\)) (need (>= (decf depth) 0)))
            (t (need (or (find c '(#\Space #\Newline #\Tab #\Return)) (find c "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789:+-."))
                     "Unsupported reader syntax"))))
    (need (and (zerop depth) (not quoted) (not escape)) "Incomplete form")))
(defun parse-data (octets &key events protocol)
  (need (<= (length octets) (if (or events protocol) 1048576 8192)))
  (let* ((text (sb-ext:octets-to-string octets :external-format :utf-8))
         (*read-eval* nil) (*readtable* (copy-readtable nil))
         (*package* (find-package :cl-user)) (*read-base* 10) (eof (gensym)))
    (preflight text events)
    (with-input-from-string (s text)
      (if events
          (let ((rows (loop for x = (read s nil eof) until (eq x eof) collect x)))
            (guard-tree rows :events t))
          (let ((x (read s nil eof)))
            (need (and (not (eq x eof)) (eq eof (read s nil eof))) "Expected one form")
            (guard-tree x))))))
(defun read-data (root relative &key protocol)
  (parse-data (read-octets root relative :limit (if protocol 1048576 8192)) :protocol protocol))
(defun read-events (root relative)
  (parse-data (read-octets root relative :limit 1048576) :events t))
(defun write-data (root relative value)
  (guard-tree value)
  (let* ((*print-readably* nil) (*print-escape* t) (*print-pretty* nil) (*print-circle* nil)
         (*print-level* nil) (*print-length* nil) (*print-base* 10) (*print-radix* nil)
         (*print-case* :upcase) (*package* (find-package :cl-user))
         (text (with-output-to-string (s) (write value :stream s) (terpri s)))
         (octets (sb-ext:string-to-octets text :external-format :utf-8)))
    (need (<= (length octets) 8192) "Receipt too large") (parse-data octets)
    (let* ((path (local-path root relative :missing t))
           (fd (sb-posix:open path (logior sb-posix:o-wronly sb-posix:o-creat sb-posix:o-excl sb-posix:o-nofollow) #o600)))
      (with-open-stream (s (sb-sys:make-fd-stream fd :output t :element-type '(unsigned-byte 8) :auto-close t))
        (write-sequence octets s)))
    (need (equalp octets (read-octets root relative)) "Write readback differs") value))
(defun hex-p (x)
  (and (stringp x) (= 64 (length x)) (every (lambda (c) (find c "0123456789abcdef")) x)))
(defun digest-file (path &key (limit 8388608))
  (vttest-vt52-sha256:sha256-hex (read-file-octets path limit)))
(defun reference (root relative)
  (list :path relative :sha256 (digest-file (local-path root relative))))
(defun check-reference (ref root &optional expected)
  (properties ref '(:path :sha256))
  (need (and (hex-p (getf ref :sha256))
             (or (null expected) (equal expected (getf ref :path)))
             (equal ref (reference root (getf ref :path)))) "Changed reference") ref)
