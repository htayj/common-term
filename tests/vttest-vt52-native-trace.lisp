;;;; Pure whole-ledger validation. No process, application or decoder dependency.
(load (merge-pathnames "vttest-vt52-native-io.lisp" *load-truename*))
(load (merge-pathnames "vttest-vt52-navigation.lisp" *load-truename*))
(defpackage :vttest-vt52-native-trace
  (:use :cl) (:local-nicknames (:io :vttest-vt52-native-io))
  (:export :validate-trace))
(in-package :vttest-vt52-native-trace)
(defun rows (events kind)
  (remove-if-not (lambda (e) (eq kind (getf e :kind))) events))
(defun only (events kind &optional hold)
  (let ((found (remove-if-not (lambda (e) (or (null hold) (eql hold (getf e :hold))))
                              (rows events kind))))
    (io:need (= 1 (length found))) (first found)))
(defun seqno (e) (getf e :seq))
(defun validate-trace (events output pid first-proof outer menu)
  "Account for the original complete trace, including startup and explicit exit.
Five driver commands and exact DA/VT52 identification replies are authorized.
Replies consume preceding output queries and require recorded FIFO enqueues and
owned accepted prefixes before the final menu proof."
  (io:need (not (eq :refuse (getf
    (vttest-vt52-navigation:vt52-navigation-check output events 0 pid :main-menu) :state))))
  (let ((seq 0) (out 0) (input 0) (clock 0) (pending nil) (command nil)
        (drivers nil) (accepted nil) (query-end 0))
    (dolist (e events)
      (io:need (and (> (seqno e) seq) (= out (getf e :out)) (= input (getf e :in))
        (typep (getf e :time) '(integer 0 *)) (<= clock (getf e :time))
        (typep (getf e :pause) '(integer 0 3))))
      (setf seq (seqno e) clock (getf e :time))
      (case (getf e :kind)
        (:driver
         (io:need (null command)) (setf command e) (push e drivers))
        (:enqueue
         (let ((bytes (getf e :bytes)) (source (getf e :source)))
           (io:need (and (typep bytes '(vector (unsigned-byte 8))) (plusp (length bytes))))
           (ecase source
             (:driver (io:need (and command (equalp bytes (getf command :bytes))))
                      (setf command nil))
             (:reply
              (let* ((query (cond ((equalp bytes #(27 47 90)) #(27 90))
                                  ((equalp bytes #(27 91 63 49 59 50 99)) #(27 91 99))))
                     (at (and query (search query output :start2 query-end :end2 out))))
                (io:need (and at (< seq (getf menu :event))))
                (setf query-end (+ at (length query))))))
           (setf pending (nconc pending (list (list e 0))))))
        (:wire-in
         (let* ((head (first pending)) (enqueue (first head)) (offset (second head))
                (bytes (getf e :bytes)) (n (length bytes)))
           (io:need (and head (eql pid (getf e :child-pid))
             (eq (getf e :source) (getf enqueue :source))
             (= input (getf e :start)) (= (+ input n) (getf e :end)) (plusp n)
             (<= (+ offset n) (length (getf enqueue :bytes)))
             (equalp bytes (subseq (getf enqueue :bytes) offset (+ offset n)))))

           (incf input n) (incf (second head) n)
           (when (= (second head) (length (getf enqueue :bytes)))
              (when (eq :driver (getf enqueue :source)) (push e accepted))
              (pop pending))))
        (:wire-out (setf out (getf e :end)))))
    (io:need (and (null command) (null pending) (= out (length output))))
    (setf drivers (nreverse drivers) accepted (nreverse accepted))
    ;; Link each command to its completed FIFO write, allowing partial prefixes.
    (io:need (and (= 5 (length drivers)) (= 5 (length accepted))))
    (loop for d in drivers for w in accepted
          for bytes in '(#(55 13) #(13) #(13) #(13) #(48 13)) do
      (io:need (and (equalp bytes (getf d :bytes)) (typep (getf w :pause) '(integer 0 3))
                    (< (seqno d) (seqno w)))))
    (let ((previous nil))
      (loop for hold from 1 to 3 for d in (rest drivers) for w in (rest accepted) do
        (let ((reached (only events :navigation-reached hold))
              (release (only events :navigation-released hold)))
          (io:need (and (eql hold (getf reached :pause)) (eql hold (getf release :pause))
            (< (seqno reached) (seqno d) (seqno w))
            (< (seqno d) (seqno release)) (eql hold (getf d :pause))
            (or (null previous) (< (seqno previous) (seqno reached)))))
          (when (= hold 1)
            (io:need (and (equal first-proof (getf reached :proof))
              (< (getf first-proof :event) (seqno reached))
              (< (max (seqno release) (seqno w)) (getf (getf outer :checkpoint) :event)))))
          (when (= hold 3)
            (io:need (and (equal outer (getf reached :proof))
              (< (getf outer :event) (seqno reached))
              (<= (seqno reached) (getf (getf menu :checkpoint) :event)))))
          (setf previous (if (> (seqno w) (seqno release)) w release)))))
    (let ((link (only events :navigation-main-menu))
          (entry (getf first-proof :checkpoint)))
      (io:need (and (< (getf entry :event) (seqno (first drivers)))
        (< (seqno (first accepted)) (getf first-proof :event))
        (< (getf menu :event) (seqno link) (seqno (fifth drivers)))
        (eql 0 (getf (first drivers) :pause)) (eql 0 (getf (fifth drivers) :pause))
        (equal menu (getf link :proof))
        (<= (getf first-proof :end) (getf (getf outer :checkpoint) :start))
        (<= (getf outer :end) (getf (getf menu :checkpoint) :start))
        (< (getf first-proof :event) (getf outer :event) (getf menu :event))))))
  t)
