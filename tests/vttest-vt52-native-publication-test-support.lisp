;;;; Run only from a fresh, single-threaded pinned SBCL process.
(load (merge-pathnames "vttest-vt52-native-contract-tests.lisp" *load-truename*))
(in-package :vttest-vt52-native-contract-tests)
(defvar *publication-mode* nil)
(defvar *publication-operation* nil)
(defun publication-receipt (root name value)
  (let* ((bytes (a::controlled-record value)) (path (concatenate 'string root name)))
    (assert (<= (length bytes) 8192))
    (format t "PREWRITE ~a ~d ~a~%" path (length bytes)
      (vttest-vt52-sha256:sha256-hex bytes)) (finish-output)
    (a::absent path)
    (let ((fd (sb-posix:open path (logior sb-posix:o-wronly sb-posix:o-creat
                                   sb-posix:o-excl sb-posix:o-nofollow) #o600)))
      (with-open-stream (s (sb-sys:make-fd-stream fd :output t
                           :element-type '(unsigned-byte 8) :auto-close t))
        (write-sequence bytes s)))
    (assert (equalp bytes (a::read-bytes path))) value))
(defun publication-import (root)
  (let ((a::*action* (when (eq *publication-mode* :import-refuse) :refuse)))
    (handler-case
      (let ((value (c::validate-recorder-import root)))
        (publication-receipt root "native/audit-import.sexp"
          (list :status (getf value :status) :origin (getf value :origin)
                :native-run-exists (not (null (probe-file (concatenate 'string root "VT52-RUN.sexp"))))))
        value)
      (c::capture-refused (e)
        (publication-receipt root "native/audit-import-refused.sexp"
          (list :refused t :decoder-calls a::*calls*))
        (error e)))))
(defun publication-validate (root &key candidate)
  (let* ((phase (cond (candidate :candidate)
                     ((equal *publication-operation* "check") :check) (t :actual)))
         (exists (not (null (probe-file (concatenate 'string root "VT52-RUN.sexp")))))
         (a::*action* (when (or (and candidate (eq *publication-mode* :candidate-refuse))
                                (and (eq phase :actual) (eq *publication-mode* :final-refuse))) :refuse)))
    (assert (if candidate (not exists) exists))
    (assert (probe-file (concatenate 'string root "native/audit-import.sexp")))
    (unless candidate (assert (probe-file (concatenate 'string root "native/audit-candidate.sexp"))))
    (let ((value (if candidate (c::validate-evidence root :candidate candidate :backend "x11" :scale 1)
                     (c:validate-vt52-native root :backend "x11" :scale 1))))
      (publication-receipt root (format nil "native/audit-~(~a~).sexp" phase)
        (list :phase phase :exists exists :verdict (getf value :verdict)
              :native-run (getf (getf value :provenance) :native-run)
              :decoder-calls a::*calls*))
      value)))
(defstruct publication-child id pid status)
(defvar *publication-children* nil)
(define-condition publication-errors (error)
  ((original :initarg :original :reader publication-original)
   (cleanup :initarg :cleanup :reader publication-cleanup-errors))
  (:report (lambda (e s) (format s "Publication failure: ~a; cleanup: ~{~a~^; ~}"
    (publication-original e) (publication-cleanup-errors e)))))
(defun publication-register (pid)
  (assert (plusp pid))
  (push (make-publication-child :id pid :pid pid) *publication-children*) pid)
(defun publication-child-for (pid)
  (or (find pid *publication-children* :key #'publication-child-id)
      (error "Unknown child ~d" pid)))
(defun publication-poll (child seconds)
  (let ((end (+ (vttest-vt52-native-clock:monotonic-ns)
                (ceiling (* seconds 1000000000)))))
    (loop
      (unless (publication-child-pid child) (return t))
      (multiple-value-bind (got status)
          (sb-posix:waitpid (publication-child-pid child) sb-posix:wnohang)
        (when (plusp got)
          (assert (= got (publication-child-pid child)))
          ;; Clear only after the actual wait.
          (setf (publication-child-pid child) nil
                (publication-child-status child) status)
          (return t)))
      (when (>= (vttest-vt52-native-clock:monotonic-ns) end) (return nil))
      (sleep .01))))
(defun publication-wait (pid &optional (seconds 20))
  (let ((child (publication-child-for pid)))
    ;; Signal only after WNOHANG zero, never after a wait error. Sole reaper.
    (unless (publication-poll child seconds)
      (let ((errors nil))
        (handler-case (sb-posix:kill (publication-child-pid child) sb-posix:sigkill)
          (error (e) (push e errors)))
        (handler-case
            (unless (publication-poll child 5) (error "Child ~d unreaped after SIGKILL" pid))
          (error (e) (push e errors)))
        (error 'publication-errors :original (format nil "Child ~d exceeded ~ds" pid seconds)
          :cleanup (nreverse errors))))
    (let ((status (publication-child-status child)))
      (assert (sb-posix:wifexited status)) (sb-posix:wexitstatus status))))
(defun publication-reap-all (children)
  (let ((errors nil))
    (dolist (child children (nreverse errors))
      (when (publication-child-pid child)
        (handler-case (assert (zerop (publication-wait (publication-child-id child) 5)))
          (error (e) (push e errors)))))))
(defun publication-owned-call (function)
  (let ((*publication-children* nil) (original nil) (errors nil) (result nil))
    (unwind-protect
        (handler-case (setf result (funcall function)) (error (e) (setf original e)))
      (setf errors (publication-reap-all *publication-children*)))
    (cond (errors (error 'publication-errors :original original :cleanup errors))
          (original (error original)) (t result))))
(defun publication-operation (root operation &key missing-import)
  (finish-output) (finish-output *error-output*)
  (let ((pid (sb-posix:fork)))
    (when (zerop pid)
      (setf *publication-operation* operation)
      (sb-posix:setenv "LISPTERM_CHARSETS_OPERATION" operation 1)
      (sb-posix:setenv "LISPTERM_CHARSETS_ROOT" root 1)
      (vttest-vt52-native-lifecycle:main
        :validate-function #'publication-validate
        :import-function (unless missing-import #'publication-import))
      (sb-ext:exit :code 2 :abort t))
    (publication-register pid)
    (publication-wait pid)))
(defun publication-environment (key value)
  (sb-posix:setenv (concatenate 'string "LISPTERM_CHARSETS_" key)
    (if (stringp value) value (write-to-string value)) 1))
(defun publication-helper (&optional (token-function #'vttest-vt52-native-clock:process-token))
  (finish-output) (finish-output *error-output*)
  (let ((pid (sb-posix:fork)))
    (when (zerop pid) (sleep 2) (sb-ext:exit :code 0 :abort t))
    (publication-register pid)
    (values pid (or (funcall token-function pid)
                    (error "Owned helper exited before token capture")))))
(defun publication-queue (client token server server-token)
  ;; Remove unpublished lifecycle outputs only. Never overwrite an original.
  (setf *files* (remove-if (lambda (r) (member (car r)
    '("VT52-RUN.sexp" "native/stages.sexp" "native/finalization-clock.sexp.start"
      "native/finalization-clock.sexp" "native/import-deadline.sexp"
      "native/owned-cleanup.sexp") :test #'equal)) *files*))
  (setf (cdr (assoc "native/owned.tsv" *files* :test #'equal))
    (a::bytes (format nil "~d ~a~%~d ~a~%" client token server server-token)))
  (queue-text "native/stage-events.sexp" (format nil "(2 :REQUEST)~%(2 :INVOKED)~%(2 :COMPLETED 0)~%"))
  (queue-text "native/unowned-endpoints.txt" ""))
(defun publication-cleanup (root client token server server-token)
  (let ((errors (publication-reap-all
                  (mapcar #'publication-child-for (list client server)))))
    (when errors (error 'publication-errors :original nil :cleanup errors))
    (publication-receipt root "native/owned-cleanup.sexp"
      (list :version 1
        :client (list :pid client :start-token token :term-exit nil :kill-exit nil
          :wait-exit (sb-posix:wexitstatus (publication-child-status (publication-child-for client))) :waited t)
        :server (list :pid server :start-token server-token :term-exit nil :kill-exit nil
          :wait-exit (sb-posix:wexitstatus (publication-child-status (publication-child-for server))) :waited t)))))
