;;;; Pure transport adversarial checks; no application or native execution.
(load (merge-pathnames "vttest-vt52-native-io.lisp" *load-truename*))
(defpackage :vttest-vt52-native-io-tests
  (:use :cl :vttest-vt52-native-io) (:export :run-tests))
(in-package :vttest-vt52-native-io-tests)
(defvar *checks* 0)
(defun check (test) (incf *checks*) (assert test))
(defun refuses (thunk)
  (check (handler-case (progn (funcall thunk) nil) (error () t))))
(defun encoded (text) (sb-ext:string-to-octets text :external-format :utf-8))
(defun run-tests ()
  (let ((*checks* 0))
    (check (equal '(:a 1 :b "#.(not-code)" :c nil :d t)
                  (parse-data (encoded "(:a 1 :b \"#.(not-code)\" :c nil :d t)"))))
    (dolist (text '("" "nil nil" "(:a 1" "(:a 1))" "(:a . 1)"
                    "#.(error \"executed\")" "#A((1) BASE-CHAR . \"x\")"
                    "#1=(:a #1#)" "#(1 2)" "'(:a 1)" ";comment" "|foo|"))
      (refuses (lambda () (parse-data (encoded text)))))
    (dolist (object (list (list :a 1 :a 2) (list :a 1 :unknown 2) (list :b 1)))
      (refuses (lambda () (properties object '(:a)))))
    (check (equal '(:a 1) (properties '(:a 1) '(:a))))
    (check (equal '(:a 1) (properties '(:a 1) '(:a :b) '(:a))))
    (let* ((tail (list 1)) (shared (list tail tail)) (cyclic (list 1)))
      (setf (cdr cyclic) cyclic)
      (refuses (lambda () (guard-tree shared)))
      (refuses (lambda () (guard-tree cyclic))))
    (refuses (lambda () (guard-tree (cons 1 2))))
    (refuses (lambda () (guard-tree (make-list 4097))))
    (refuses (lambda () (guard-tree (make-string 8193))))
    (let ((deep nil))
      (dotimes (i 34) (setf deep (list deep)))
      (refuses (lambda () (guard-tree deep))))
    (refuses (lambda () (parse-data (encoded (make-string 8193 :initial-element #\Space)))))
    (refuses (lambda () (parse-data (make-array 2 :element-type '(unsigned-byte 8)
                                                :initial-contents '(192 128)))))
    (check (equalp '((:bytes #(0 27 255)) (:bytes #(1)))
                   (parse-data (encoded "(:bytes #(0 27 255)) (:bytes #(1))") :events t)))
    (dolist (text '("(:bytes #(256))" "(:bytes #(-1))" "(:bytes #(nil))"
                    "#.(error \"bad\")" "#1=(1 #1#)" "#*0101" "#A((1) T . (1))"))
      (refuses (lambda () (parse-data (encoded text) :events t))))
    (check (null (parse-data (encoded "") :events t)))
    (check (equal '(:a 1) (parse-data (encoded (concatenate 'string "(:a 1)"
                                    (make-string 9000 :initial-element #\Space))) :protocol t)))
    (refuses (lambda () (parse-data (encoded "#(1)") :protocol t)))
    ;; A real generic BUILD shape, rather than a fabricated root PASS.
    (check (eq :pass (getf (parse-data (encoded
      "(:kind :vttest-screen-build :version 1 :status :pass :reason \"executable-produced-effects-unverified\" :exit 0)")) :status)))
    (let* ((dir (format nil ".build/vt52-io320-~d/" (get-universal-time)))
           (absolute (namestring (merge-pathnames dir (truename ".")))))
      (handler-case (progn (sb-posix:lstat absolute) (error "Existing fixture root"))
        (sb-posix:syscall-error (e) (assert (= sb-posix:enoent (sb-posix:syscall-errno e)))))
      (sb-posix:mkdir absolute #o700)
      (check (equal absolute (canonical-root absolute)))
      (dolist (path '("../escape" "/etc/passwd" "a//b" "./a" "a/../b" ""))
        (refuses (lambda () (local-path absolute path))))
      (refuses (lambda () (read-data absolute "missing.sexp")))
      (refuses (lambda () (read-data absolute ".")))
      (let* ((s (coerce "ordinary base string" 'simple-base-string))
             (record (list :kind :fixture :text s :status :pass))
             (*print-readably* t) (*print-base* 16) (*print-level* 1) (*print-length* 1)
             (*print-circle* t) (*print-pretty* t))
        (write-data absolute "good.sexp" record)
        (check (equal record (read-data absolute "good.sexp")))
        (check (not (search "#A" (read-text absolute "good.sexp"))))
        (refuses (lambda () (write-data absolute "good.sexp" record))))
      (sb-posix:symlink (concatenate 'string absolute "good.sexp")
                        (concatenate 'string absolute "link.sexp"))
      (refuses (lambda () (read-data absolute "link.sexp")))
      (let ((ref (reference absolute "good.sexp")))
        (check (equal ref (check-reference ref absolute "good.sexp")))
        (refuses (lambda () (check-reference ref absolute "other.sexp")))
        (refuses (lambda () (check-reference (list :path "good.sexp" :sha256 (make-string 64 :initial-element #\0)) absolute))))
      (format t "Fixture root ~a~%" absolute))
    (format t "~d IO checks passed~%" *checks*) *checks*))
