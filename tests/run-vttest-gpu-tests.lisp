;;;; Offline controls only. No application, graphics library or display is opened.
(load (merge-pathnames "vttest-gpu.lisp" *load-truename*))
(require :asdf)
(defvar *checks* 0)
(defun check (value) (assert value) (incf *checks*))
(defun rejected (thunk)
  (check (handler-case (progn (funcall thunk) nil) (error () t))))
(defun sample-receipt ()
  (copy-tree '(:label "cursor" :backend :x11 :renderer-request :auto :mode :accept
               :status (:backend :x11 :geometry
                        (:renderer :gpu :draw-calls 2 :driver
                         (:device "/dev/dri/renderD128" :device-associated-p t :software-p nil))))))
(let ((receipt (sample-receipt)))
  (check (vttest-gpu:validate-receipt receipt "cursor" :x11)))
(dolist (mutation
         (list (lambda (r) (setf (getf r :renderer-request) :gpu))
               (lambda (r) (setf (getf (getf r :status) :backend) :wayland))
               (lambda (r) (setf (getf (getf (getf r :status) :geometry) :renderer) :cpu))
               (lambda (r) (setf (getf (getf (getf r :status) :geometry) :draw-calls) 0))
               (lambda (r) (setf (getf (getf (getf r :status) :geometry) :draw-calls) nil))
               (lambda (r) (setf (getf (getf (getf (getf r :status) :geometry) :driver) :software-p) t))
               (lambda (r) (remf (getf (getf (getf r :status) :geometry) :driver) :software-p))
               (lambda (r) (setf (getf (getf (getf (getf r :status) :geometry) :driver) :device-associated-p) nil))
               (lambda (r) (setf (getf (getf (getf (getf r :status) :geometry) :driver) :device) ""))))
  (let ((receipt (sample-receipt)))
    (funcall mutation receipt)
    (rejected (lambda () (vttest-gpu:validate-receipt receipt "cursor" :x11)))))

;; Synthetic persisted receipts test the reader/coverage wiring, not GPU execution.
(let* ((root (uiop:ensure-directory-pathname (sb-ext:posix-getenv "LISPTERM_VTTEST_GPU_TEST_ARTIFACTS")))
       (receipt (sample-receipt))
       (inventory '(:expected ("cursor") :attempted ("cursor") :completed ("cursor"))))
  (labels ((save (name value)
             (with-open-file (out (merge-pathnames name root) :direction :output
                                  :if-exists :supersede :if-does-not-exist :create)
               (write value :stream out))))
    (save "inventory.sexp" inventory)
    (rejected (lambda () (vttest-gpu:check-directory root)))
    (save "cursor.gpu.sexp" receipt)
    (check (vttest-gpu:check-directory root))
    (setf (getf receipt :mode) :record)
    (save "cursor.gpu.sexp" receipt)
    (rejected (lambda () (vttest-gpu:check-directory root)))
    (setf (getf receipt :mode) :accept)
    (save "cursor.gpu.sexp" receipt)
    (setf (getf inventory :expected) '("cursor" "absent"))
    (save "inventory.sexp" inventory)
    (rejected (lambda () (vttest-gpu:check-directory root)))
    (with-open-file (out (merge-pathnames "cursor.gpu.sexp" root) :direction :output :if-exists :supersede)
      (write-string "#.(error \"read-eval must be disabled\")" out))
    (rejected (lambda () (vttest-gpu::read-evidence (merge-pathnames "cursor.gpu.sexp" root))))))
(format t "VTTEST GPU offline controls: ~d passed.~%" *checks*)
