;;;; Native shell lifecycle transport. Public validation stays read-only.
(load (merge-pathnames "vttest-vt52-native-clock.lisp" *load-truename*))
(defpackage :vttest-vt52-native-lifecycle
  (:use :cl :vttest-vt52-native-io :vttest-vt52-native-clock)
  (:export :main))
(in-package :vttest-vt52-native-lifecycle)
(defun optional-reference (root relative)
  (handler-case (progn (local-path root relative :missing t) nil)
    (error () (reference root relative))))
(defun build-ledger (root backend)
  (let ((entry nil))
    (dolist (row (read-events root "native/stage-events.sexp"))
      (guard-tree row)
      (need (and (listp row) (<= 2 (length row) 3) (eql 2 (first row))))
      (destructuring-bind (n action &optional exit) row
        (declare (ignore n))
        (case action
          (:request
           (need (and (null entry) (= 2 (length row))))
           (setf entry (list :pause 2 :request (reference root "recorder/pause-02-request")
                             :invoked nil :completed nil :capture-exit nil :exit-origin nil :receipt nil)))
          (:invoked
           (need (and entry (= 2 (length row)) (not (getf entry :invoked))))
           (setf (getf entry :invoked) t))
          (:completed
           (need (and entry (= 3 (length row)) (getf entry :invoked)
                      (not (getf entry :completed)) (typep exit '(integer 0 255))))
           (setf (getf entry :completed) t (getf entry :capture-exit) exit
                 (getf entry :exit-origin) (reference root "recorder/pause-02-capture.exit")))
          (otherwise (error "Invalid native stage")))))
    (when entry (setf (getf entry :receipt) (optional-reference root "recorder/pause-02-native.sexp")))
    (let ((ledger (list :kind :vttest-charsets-native-stages :version 1 :backend backend
                        :entries (when entry (list entry)))))
      (write-data root "native/stages.sexp" ledger) ledger)))
(defun unowned-endpoints (root)
  (with-input-from-string (in (read-text root "native/unowned-endpoints.txt"))
    (loop for line = (read-line in nil) while line
          collect (list :path line :ownership :unestablished))))
(defun candidate (root backend)
  (let* ((manifest (read-data root "MANIFEST.sexp" :protocol t))
         (state (scalar "FINALIZATION")) (client-exit (scalar "CLIENT_EXIT"))
         (abort (optional-reference root "recorder/abort.sexp"))
         (imported (when (eq state :complete) (read-data root "native/recorder-import.sexp")))
         (ledger (build-ledger root backend)) (entries (getf ledger :entries))
         (recorder-stage (list :origin nil :attempted nil :reached nil :captured nil :frame-verified nil))
         (record nil) (checks nil) (navigation nil) (status (scalar "STATUS")))
    (need (member status '(:pass :fail :unverified)))
    (when imported
      (properties imported '(:origin :status :stage :checks))
      (check-reference (getf imported :origin) root "recorder/RESULT.sexp")
      (setf recorder-stage (copy-tree (getf imported :stage)) checks (copy-tree (getf imported :checks)))
      (properties recorder-stage '(:origin :attempted :reached :captured :frame-verified))
      (need (equal (getf imported :origin) (getf recorder-stage :origin)))
      ;; The mandatory validator replays navigation before this can be published PASS.
      (setf navigation (copy-tree (getf (read-data root "recorder/RESULT.sexp") :navigation))))
    (when (or abort (not (eq state :complete)) (not (eql client-exit 0))
              (not imported) (not (eq :pass (getf imported :status))))
      (setf status :fail))
    (setf record
      (list :kind :vttest-vt52-run :version 3 :backend backend :scale (getf manifest :scale)
            :attempted (scalar "ATTEMPTED") :reached (scalar "REACHED") :captured (scalar "CAPTURED")
            :captures (scalar "CAPTURED") :navigation-pauses '(1 2 3) :navigation navigation
            :unverified-count (when imported (if (eq :pass (getf imported :status)) 0 1))
            :checks checks :status status :build (scalar "BUILD") :native-started (scalar "STARTED")
            :cleanup (scalar "CLEANUP") :recorder-result "recorder/RESULT.sexp"
            :recorder-sha256 (getf (getf recorder-stage :origin) :sha256)
            :manifest (local-path root "MANIFEST.sexp") :manifest-sha256 (digest-file (local-path root "MANIFEST.sexp"))
            :execution-inputs "native/execution-inputs.sha256"
            :evidence '("native/" "build/BUILD.sexp" "recorder/RESULT.sexp") :reason (environment "REASON")
            :stages (list :recorder recorder-stage
                          :native (list :origin (reference root "native/stages.sexp")
                                        :request-observed (length entries)
                                        :capture-invoked (count-if (lambda (e) (getf e :invoked)) entries)
                                        :capture-completed (count-if (lambda (e) (getf e :completed)) entries)))
            :finalization (list :state state :client-exit client-exit :result (copy-tree (getf recorder-stage :origin))
                                :abort (copy-tree abort))
            :abort abort :unowned-endpoints (unowned-endpoints root) :count-basis :native-vt52))
    record))
(defun publish (root backend function)
  (let* ((record (candidate root backend))
         (pre (validate function root record)))
    ;; Callback refusal can only downgrade the shell's original outcome.
    (when (and (eq :pass (getf record :status)) (not (eq :pass (getf pre :verdict))))
      (setf (getf record :status) :fail))
    (write-data root "VT52-RUN.sexp" record)
    (let ((final (validate function root)))
      (when (eq :pass (getf final :verdict))
        (need (eq :pass (getf record :status)) "Validator upgraded shell failure")
        (check-reference (getf (getf final :provenance) :native-run) root "VT52-RUN.sexp"))
      (write-data root "vt52-check.sexp" final)
      (and (eq :pass (getf record :status)) (eq :pass (getf final :verdict))))))
(defun main (&key validate-function import-function)
  "Shell-only transport; calling the public validator never publishes receipts."
  (let ((operation (environment "OPERATION")) (code 1))
    (handler-case
        (let ((root (canonical-root (environment "ROOT"))) (backend (environment "BACKEND")))
          (need (member backend '("x11" "wayland") :test #'equal))
          (cond
            ((equal operation "start") (format t "~d~%" (start-cleanup root)) (setf code 0))
            ((equal operation "notify") (bounded-notify root backend) (setf code 0))
            ((equal operation "await")
             (let ((state (await-exit root backend))) (format t "~s~%" state)
               (setf code (if (eq :exited state) 0 124))))
            ((equal operation "import")
             (setf code (if (eq :pass (bounded-import root backend import-function)) 0 1))
             (format t "~s~%" (if (zerop code) :pass :refuse)))
            ((equal operation "publish")
             (setf code (if (publish root backend validate-function) 0 1))
             (format t "~s~%" (if (zerop code) :pass :refuse)))
            ((equal operation "check")
             (setf code (if (eq :pass (getf (validate validate-function root) :verdict)) 0 1))
             (format t "~s~%" (if (zerop code) :pass :refuse)))
            (t (error "Unknown lifecycle operation"))))
      (sb-ext:timeout ()
        (setf code 124)
        (cond ((equal operation "await") (format t ":TIMEOUT~%"))
              ((member operation '("import" "publish" "check") :test #'equal) (format t ":REFUSE~%")))
        (format *error-output* "Lifecycle deadline exceeded.~%"))
      (error ()
        (setf code 1)
        (when (member operation '("import" "publish" "check") :test #'equal) (format t ":REFUSE~%"))
        (format *error-output* "Lifecycle evidence refused.~%")))
    (finish-output) (finish-output *error-output*) (sb-ext:exit :code code)))
