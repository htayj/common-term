;;;; Pure lifecycle tests. Replace transports only inside this disposable test image.
(load (merge-pathnames "vttest-vt52-native-lifecycle.lisp" *load-truename*))
(defpackage :vttest-vt52-native-lifecycle-tests
  (:use :cl :vttest-vt52-native-io :vttest-vt52-native-clock))
(in-package :vttest-vt52-native-lifecycle-tests)
(defvar *checks* 0)
(defun ok (x) (assert x) (incf *checks*))
(defun refused (fn)
  (ok (handler-case (progn (funcall fn) nil) (error () t))))
(defmacro replacing (bindings &body body)
  (let ((old (gensym)))
    `(let ((,old (mapcar (lambda (s) (cons s (symbol-function s)))
                        ',(mapcar #'first bindings))))
       (unwind-protect
            (progn ,@(loop for (s fn) in bindings collect `(setf (symbol-function ',s) ,fn)) ,@body)
         (dolist (row ,old) (setf (symbol-function (car row)) (cdr row)))))))
(let ((now 100) (env (make-hash-table :test 'equal)) (data (make-hash-table :test 'equal))
      (writes nil) (called 0))
  (flet ((put (key x) (setf (gethash key env) x)))
    (replacing
        ((environment (lambda (key) (gethash key env)))
         (monotonic-ns (lambda () now))
         (read-data (lambda (root path &key protocol) (declare (ignore root protocol))
                      (multiple-value-bind (x found) (gethash path data)
                        (assert found) (copy-tree x))))
         (write-data (lambda (root path x) (declare (ignore root))
                       (guard-tree x) (assert (not (gethash path data)))
                       (push path writes) (setf (gethash path data) (copy-tree x)) x))
         (reference (lambda (root path) (declare (ignore root))
                      (list :path path :sha256 (make-string 64 :initial-element #\a))))
         (process-token (lambda (pid) (assert (= pid 77)) nil)))
      (dolist (pair '(("START_NS" . "100") ("DEADLINE_NS" . "15000000100")
                      ("PID" . "77") ("TOKEN" . "999"))) (put (car pair) (cdr pair)))
      (ok (= 100 (start-cleanup "/pure/")))
      (ok (= 15000000100 (deadline "/pure/")))
      (put "START_NS" "101") (refused (lambda () (deadline "/pure/"))) (put "START_NS" "100")
      (put "DEADLINE_NS" "15000000101") (refused (lambda () (deadline "/pure/")))
      (put "DEADLINE_NS" "15000000100")
      (dolist (bad '("#.(error)" "(1)" "1 2" "#xFF" ""))
        (put "BAD" bad) (refused (lambda () (scalar "BAD"))))
      (ok (eq :exited (await-exit "/pure/" "x11")))
      (let ((clock (gethash "native/finalization-clock.sexp" data)))
        (ok (equal "/pure/" (getf clock :run))) (ok (equal "x11" (getf clock :backend)))
        (ok (= 77 (getf clock :pid))) (ok (equal "999" (getf clock :token)))
        (ok (= 100 (getf clock :start-ns))) (ok (= 100 (getf clock :end-ns))))
      (flet ((importer (root)
               (ok (equal root "/pure/")) (incf called)
               (list :origin (reference root "recorder/RESULT.sexp") :status :pass
                     :stage (list :origin (reference root "recorder/RESULT.sexp")
                                  :attempted 1 :reached 1 :captured 1 :frame-verified 1)
                     :checks (list (list :pause 2 :pixels :pass :bytes :unverified :timing :pass)))))
        (ok (eq :pass (bounded-import "/pure/" "x11" #'importer)))
        (ok (= called 1))
        (let ((receipt (gethash "native/import-deadline.sexp" data)))
          (ok (eq :valid (getf receipt :state))) (ok (= 100 (getf receipt :validated-ns)))
          (ok (= 15000000100 (getf receipt :deadline-ns))))
        (remhash "native/recorder-import.sexp" data) (remhash "native/import-deadline.sexp" data)
        (let ((clock (gethash "native/finalization-clock.sexp" data)))
          (setf (getf clock :backend) "wayland")
          (refused (lambda () (bounded-import "/pure/" "x11" #'importer)))
          (ok (= called 1)) (setf (getf clock :backend) "x11"))
        (setf now 15000000100)
        (ok (handler-case (progn (bounded-import "/pure/" "x11" #'importer) nil)
              (sb-ext:timeout () t)))
        (ok (= called 1))
        (ok (eq :timeout (getf (gethash "native/import-deadline.sexp" data) :state)))
        (setf now 100)
        (remhash "native/import-deadline.sexp" data)
        (ok (handler-case
                (progn (bounded-import "/pure/" "x11"
                         (lambda (root) (prog1 (importer root) (setf now 15000000100)))) nil)
              (sb-ext:timeout () t)))
        (ok (= called 2))
        (ok (not (gethash "native/recorder-import.sexp" data)))
        (remhash "native/finalization-clock.sexp" data)
        (ok (eq :timeout (await-exit "/pure/" "x11"))))
      (ok (>= (length writes) 5)))))
;; Candidate publication and fresh revalidation: transport is in-memory, callbacks explicit.
(dolist (shell '(:pass :fail))
  (dolist (pre '(:pass :refuse))
    (let ((stored (make-hash-table :test 'equal)) (calls nil))
      (replacing
          ((vttest-vt52-native-lifecycle::candidate
             (lambda (root backend) (declare (ignore root backend)) (list :status shell)))
           (write-data (lambda (root path x) (declare (ignore root))
                         (assert (not (gethash path stored)))
                         (setf (gethash path stored) (copy-tree x))))
           (reference (lambda (root path) (declare (ignore root))
                        (list :path path :sha256 (make-string 64 :initial-element #\a)))))
        (let ((result
                (vttest-vt52-native-lifecycle::publish "/pure/" "x11"
                  (lambda (root &key candidate)
                    (ok (equal root "/pure/")) (push (if candidate :candidate :final) calls)
                    (let ((r (vttest-vt52-native-clock::refuse-report)))
                      (setf (getf r :verdict) (if candidate pre
                                                (if (eq :pass (getf (gethash "VT52-RUN.sexp" stored) :status))
                                                    :pass :refuse))
                            (getf r :provenance) (list :native-run (reference root "VT52-RUN.sexp"))) r)))))
          (ok (eq (not (null result)) (and (eq shell :pass) (eq pre :pass))))
          (ok (equal calls '(:final :candidate)))
          (ok (gethash "vt52-check.sexp" stored))
          (ok (eq (getf (gethash "VT52-RUN.sexp" stored) :status)
                  (if (and (eq shell :pass) (eq pre :refuse)) :fail shell))))))))
(dolist (fn (list (lambda (&rest args) (declare (ignore args)) (error "bad"))
                 (lambda (&rest args) (declare (ignore args)) '(:verdict :pass))
                 (lambda (&rest args) (declare (ignore args)) (list :schema :wrong))))
  (ok (eq :refuse (getf (validate fn "/pure/") :verdict))))
(let ((rows '((2 :request) (2 :invoked) (2 :completed 0))) (written nil))
  (replacing
      ((read-events (lambda (&rest args) (declare (ignore args)) rows))
       (write-data (lambda (root path x) (declare (ignore root path)) (setf written x)))
       (reference (lambda (root path) (declare (ignore root)) (list :path path :sha256 "hash")))
       (vttest-vt52-native-lifecycle::optional-reference
         (lambda (root path) (declare (ignore root path)) nil)))
    (vttest-vt52-native-lifecycle::build-ledger "/pure/" "x11")
    (let ((entry (first (getf written :entries))))
      (ok (= 2 (getf entry :pause))) (ok (getf entry :invoked))
      (ok (getf entry :completed)) (ok (= 0 (getf entry :capture-exit))))
    (dolist (bad '(((1 :request)) ((2 :invoked)) ((2 :request) (2 :request))
                   ((2 :request) (2 :completed 0)) ((2 :request) (2 :invoked) (2 :completed 256))
                   ((2 :request 0)) ((2 :request) (2 :bogus))))
      (setf rows bad)
      (refused (lambda () (vttest-vt52-native-lifecycle::build-ledger "/pure/" "x11"))))))
(format t "PASS ~d pure lifecycle assertions.~%" *checks*)
