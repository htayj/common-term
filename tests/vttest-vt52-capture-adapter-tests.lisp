;;;; Injected decoder-boundary tests. Explicit RUN-TESTS; no native acceptance.
(load (merge-pathnames "vttest-vt52-capture-adapter-test-support.lisp" *load-truename*))
(load (merge-pathnames "vttest-vt52-native-io.lisp" *load-truename*))
(in-package #:vttest-vt52-capture-adapter-tests)
(defun original-hashes (raw)
  (loop for (key suffix) on a::*inputs* by #'cddr
        append (list key (h:sha256-hex (getf raw key)))))
(defun positive (backend scale hostile)
  (let* ((*print-readably* hostile) (*print-base* (if hostile 16 10))
         (*print-length* (and hostile 1)) (*print-level* (and hostile 1))
         (*print-escape* (not hostile)) (*print-pretty* hostile)
         (raw (reserialize (f:fixture :backend backend :scale scale)))
         (*calls* 0) (r (report-for raw :scale scale))
         (c (getf r :checker)) (png (getf r :png))
         (name (list backend scale hostile)))
    (check (list :pass name) (and (eq :pass (getf r :verdict))
      (null (getf r :reasons)) (= *calls* 1)))
    (check (list :real-checker name) (and (eq :pass (getf c :verdict))
      (eql 0 (getf c :frame-differences))
      (equal '(:count 32 :failed nil) (getf c :graphics))
      (equal '(:count 102 :failed nil) (getf c :boundaries))
      (equal (getf c :expected-sha256) (getf c :actual-rgba-sha256))))
    (check (list :originals name) (and
      (equal (original-hashes raw) (getf r :original-hashes))
      (equal (getf r :original-hashes) (getf r :original-hashes-after))))
    (check (list :cursor name) (equal (getf c :cursor)
      (list :before-seq 2 :after-seq 6 :pre-sha256 (h:sha256-hex (getf raw :pre))
        :final-sha256 (h:sha256-hex (getf raw :final))
        :trace-sha256 (h:sha256-hex (getf raw :control)))))
    (check (list :font name) (and (= 38848 (getf (getf r :font) :bytes))
      (equal a::*font-pin* (getf (getf r :font) :sha256))))
    (check (list :png-hashes name) (and
      (equal (h:sha256-hex *png-bytes*) (getf png :sha256-before))
      (equal (getf png :sha256-before) (getf png :sha256-after))
      (= (* 640 scale) (getf png :width)) (= (* 384 scale) (getf png :height))))
    (check (list :binary-summaries name) (and
      (equal (summary (aref *images* (1- scale))) (getf png :rgba))
      (equal (summary (bytes "decoded")) (getf png :stdout))
      (equal (summary (bytes "diagnostic")) (getf png :stderr))
      (equal (summary (bytes (format nil "~d ~d" (* 640 scale) (* 384 scale))))
             (getf (getf png :identify) :stdout))
      (equal (summary (bytes "")) (getf (getf png :identify) :stderr))))
    (check (list :process-receipts name) (and (eql 0 (getf png :exit))
      (eql 0 (getf (getf png :identify) :exit))
      (equal a::*decoder* (first (getf png :argv)))
      (equal (rest (getf (getf png :identify) :argv))
        (list "identify" "-format" "%w %h" (second (getf png :argv))))))
    (check (list :limitations name) (equal a::*limitations* (getf r :limitations)))))
(defun early-refusal (raw name &key omit)
  (let* ((*calls* 0) (r (report-for raw :omit omit)))
    (check name (and (refused r) (zerop *calls*) (null (getf r :checker))))))
(defun run-tests ()
  (let* ((*root* (new-directory (format nil ".build/vt52-adapter-318-~d-~36r/"
                                 (get-universal-time) (random (expt 2 64)))))
         (*serial* 0) (*writes* 0) (*checks* 0) (*action* nil) (*calls* 0)
         (font (read-bytes a::*font-path*))
         (*images* (map 'vector (lambda (scale)
           (vttest-vt52-pixels:expected-rgba (vttest-vt52-oracle:vt52-snapshot) font
             :font-sha256 a::*font-pin* :scale scale :blink-phase t)) '(1 2)))
         (saved (symbol-function 'p:decode-original-png)))
    (unwind-protect
      (progn
        (setf (symbol-function 'p:decode-original-png) #'fake-decode)
        (dolist (backend '(:x11 :wayland))
          (dolist (scale '(1 2))
            (dolist (hostile '(nil t)) (positive backend scale hostile))))
        (loop for key in '(:before :ready :request :request-sexp :native-ready :pre :final :native :control)
          do (early-refusal (f:fixture) (list :missing key) :omit key)
             (let ((raw (f:fixture)))
               (setf (getf raw key) (bytes "invalid"))
               (early-refusal raw (list :malformed key))))
        (dolist (mutation '(:cursor :control :request :hash :utf8 :dispatch :duplicate))
          (let ((raw (f:fixture)))
            (case mutation
              (:cursor (f::revise raw :control (lambda (p)
                (setf (getf (second p) :row) 11) p)))
              (:control (f::revise raw :control (lambda (p)
                (setf (getf (fourth p) :seq) 3) p)))
              (:request (f::revise raw :request-sexp (lambda (p)
                (setf (getf p :target) 101) p)))
              (:hash (f::revise raw :control (lambda (p)
                (setf (getf (first p) :sha256) (make-string 64 :initial-element #\0)) p)))
              (:utf8 (setf (getf raw :before)
                (make-array 1 :element-type '(unsigned-byte 8) :initial-element 255)))
              (:dispatch (setf (getf raw :before) (bytes "#.(error :executed)")))
              (:duplicate (setf (getf raw :before) (bytes "(:id 5 :id 5)"))))
            (early-refusal raw mutation)))
        (let* ((*action* :refuse) (r (report-for (f:fixture))))
          (check :png-refusal (and (refused r)
            (equal '((:png :synthetic-decoder-failed)) (getf r :reasons))
            (equal (summary (bytes "diagnostic")) (getf (getf r :png) :stderr))
            (eql 7 (getf (getf r :png) :exit)))))
        (let* ((*action* :mutate) (r (report-for (f:fixture))))
          (check :changed-originals (and (refused r)
            (equal '(:changed-originals) (getf r :reasons))
            (not (equal (getf r :original-hashes) (getf r :original-hashes-after)))
            (eq :pass (getf (getf r :checker) :verdict)))))
        (let* ((*action* :bad-pixel) (r (report-for (f:fixture))))
          (check :real-checker-bad-rgba (and (refused r)
            (member :frame-differences (getf r :reasons))
            (eql 1 (getf (getf r :checker) :frame-differences)))))
        (let ((raw (f:fixture)))
          (f::revise raw :before (lambda (p) (setf (getf p :rows) 25) p))
          (let* ((r (report-for raw)) (c (getf r :checker))
                 (expected '((:frame-bracket (:unsettled :approved-grid (:before-state :rows))))))
            (check :refusal-detail (and (refused r) (eq :refuse (getf c :verdict))
              (eql 0 (getf c :frame-differences)) (equal expected (getf r :reasons))
              (equal expected (getf c :reasons))))
            (check :refusal-unshared-tree
              (handler-case (eq r (vttest-vt52-native-io:guard-tree r)) (error () nil)))
            (check :refusal-reasons-distinct
              (not (eq (getf r :reasons) (getf c :reasons))))
            (let ((shared (list :untrusted)))
              (check :external-alias-rejected
                (handler-case (progn (vttest-vt52-native-io:guard-tree (list shared shared)) nil)
                  (error () t))))))
        (let ((a::*font-pin* "bad")) (early-refusal (f:fixture) :font-pin))
        (let* ((path (merge-pathnames "bad-font.otb" *root*))
               (a::*font-path* (write-new path (bytes "badfont"))))
          (early-refusal (f:fixture) :font-length))
        (dolist (args '((:pause 1 :scale 1) (:pause 2 :scale 3)))
          (check (list :arguments args)
            (refused (apply #'a:check-vt52-capture-directory *root* args))))
        (check :directory (refused (a:check-vt52-capture-directory 42 :pause 2 :scale 1))))
      (setf (symbol-function 'p:decode-original-png) saved))
    (check :decoder-restored (eq saved (symbol-function 'p:decode-original-png)))
    (format t "ADAPTER318 PASS ~d checks; ~d bounded writes; fixtures ~a~%"
      *checks* *writes* *root*)
    (values *checks* *root*)))
