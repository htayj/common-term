;;;; Pure controls for OWN-DA-REPLY-P. No files, recorder, display or adapter.
(in-package :vttest-keyboard-driver-tests)

(defun octets (&rest codes) (map 'string #'code-char codes))
;; Independent literals: ESC [ c, ESC [ ? 1 ; 2 c, ESC [ > c, ESC [ ? 1 ; 0 c.
(defparameter *da-query* (octets 27 91 99))
(defparameter *da-answer* (octets 27 91 63 49 59 50 99))
(defparameter *da-secondary* (octets 27 91 62 99))
(defparameter *da-wrong* (octets 27 91 63 49 59 48 99))

(defun da-events (&key (query *da-query*) (reply *da-answer*) (source :reply) (nav t)
                       split unwired partial duplicate late early wire-only)
  "Gate-shaped events and transcript for one keyboard startup."
  (let ((events nil) (out "") (in "") (seq 0)
        (choose (octets 53 13)) (up (octets 27 91 65)))
    (labels ((e (kind &rest args)
               (push (list* :seq (incf seq) :kind kind :phase "startup" :time (/ seq 100)
                            :out (length out) :in (length in) args) events))
             (wout (bytes) (e :wire-out :bytes bytes :end (+ (length out) (length bytes)) :source nil)
               (setf out (c::cat out bytes)))
             (win (src bytes) (e :wire-in :bytes bytes :end (+ (length in) (length bytes)) :source src)
               (setf in (c::cat in bytes)))
             (answer ()
               (unless wire-only (e :enqueue :source source :bytes reply))
               (cond (unwired)
                     (partial (win source (subseq reply 0 4)))
                     (split (win source (subseq reply 0 3)) (win source (subseq reply 3)))
                     (t (win source reply)))))
      (when early (answer))
      (wout query)
      (unless (or early late) (answer))
      (when duplicate (answer))
      (when nav (e :driver :bytes choose) (e :enqueue :source :input :bytes choose) (win :input choose))
      (e :key-begin :key "Up")
      (when late (answer))
      (e :enqueue :source :input :bytes up) (win :input up) (e :key-end :key "Up")
      (values (nreverse events) out))))

(defun da-result (label &rest options)
  (multiple-value-bind (events output) (apply #'da-events options)
    (multiple-value-list (k::own-da-reply-p label events output))))

(defun da-controls ()
  (let ((label "keyboard-cursor"))
    (check (and (= 7 (length *da-answer*)) (equal *da-answer* k::+da-reply+)
                (equal *da-query* k::+da-query+)) :da-literals-seven-octets)
    (check (equal '(t nil) (da-result label)) :da-own-reply)
    (check (equal '(t nil) (da-result "keyboard-keypad" :split t)) :da-split-reply)
    (check (equal '(t nil) (da-result label :nav nil)) :da-reply-without-navigation)
    (dolist (c (list (list :da-secondary-query :no-query :query *da-secondary*)
                     (list :da-truncated-six :reply-bytes :reply (subseq *da-answer* 0 6))
                     (list :da-eight-octets :reply-bytes :reply (c::cat *da-answer* "c"))
                     (list :da-wrong-reply :reply-bytes :reply *da-wrong*)
                     (list :da-duplicate :reply-count :duplicate t)
                     (list :da-input-forged :reply-count :source :input)
                     (list :da-wire-without-enqueue :fifo :wire-only t)
                     (list :da-late :late-reply :late t)
                     (list :da-before-query :reply-before-query :early t)
                     (list :da-unwired-blocks-fifo :fifo :unwired t)
                     (list :da-partial-blocks-fifo :fifo :partial t)
                     (list :da-unwired :unwired-reply :unwired t :nav nil)
                     (list :da-partial :unwired-reply :partial t :nav nil)))
      (destructuring-bind (name reason &rest options) c
        (check (equal (list nil reason) (apply #'da-result label options)) name)))
    (multiple-value-bind (events output) (da-events)
      (let ((bad (copy-tree events)))
        (setf (getf (third bad) :in) 1)
        (check (equal '(nil :progress) (multiple-value-list (k::own-da-reply-p label bad output)))
               :da-forged-progress))
      (let ((bad (copy-tree events)))
        (setf (getf (third bad) :end) 9)
        (check (equal '(nil :input-link) (multiple-value-list (k::own-da-reply-p label bad output)))
               :da-forged-input-end))
      (check (equal '(nil :output-link)
                    (multiple-value-list (k::own-da-reply-p label events (octets 27 91 100))))
             :da-unlinked-output)
      (check (equal '(nil :output-length)
                    (multiple-value-list (k::own-da-reply-p label events (c::cat output "x"))))
             :da-unrecorded-output)
      (check (equal '(nil :arguments) (multiple-value-list (k::own-da-reply-p "keyboard-other" events output)))
             :da-unknown-label)
        (check (equal '(nil :arguments) (multiple-value-list (k::own-da-reply-p label :malformed output)))
               :da-malformed-events)
        (flet ((refusal (bad)
                 ;; A signal is a failed control, not a crash of the runner.
                 (handler-case (multiple-value-list (k::own-da-reply-p label bad output))
                   (error () :signalled)))
               (circular (list) (setf (cdr (last list)) list) list))
          (dolist (c (list (list :da-atom-event (cons :atom events))
                           (list :da-odd-event (cons (list :kind) events))
                           (list :da-dotted-event (cons (list* :kind :driver :dotted) events))
                           (list :da-circular-event (cons (circular (list :kind :driver)) events))
                           (list :da-dotted-events (append events :dotted))
                           (list :da-circular-events (circular (copy-list events)))))
            (check (equal '(nil :arguments) (refusal (second c))) (first c)))))))
