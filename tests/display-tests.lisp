(in-package #:lispterm.display)
(let* ((font (load-font nil 16)) (d (make-display :font font :owner sb-thread:*current-thread*)))
 (assert (= 8 (font-width font))) (assert (= 16 (font-height font)))
 (dolist (char '(#\A #\λ #\─ #\│ #\┌ #\┐ #\└ #\┘))
 (assert (plusp (font-glyph-index font (char-code char))))
 (assert (plusp (count 1 (glyph-bitmap font char)))))
 (assert (zerop (count 1 (glyph-bitmap font #\Space))))
 (resize-display d 32 32)
 (draw-cells d 0 0 (list (make-cell :char #\A :fg #xff0000 :bg #x0000ff) (make-cell :char #\Space :bg #x00ff00)))
 (let ((fb (copy-seq (display-framebuffer d))))
 (assert (find #xffff0000 fb)) (assert (find #xff0000ff fb))
 (dotimes (y 16) (loop for x from 8 below 16 do (assert (= #xff00ff00 (aref fb (+ x (* y 32)))))))
 (draw-cells d 1 3 (list (make-cell :char #\A :width 2))) ; clipped edge
 (setf (display-damage d) nil)
 (draw-cells d 0 0 (list (make-cell :char #\A :fg #xff0000 :bg #x0000ff)))
 (assert (null (display-damage d)))
 (set-cursor d 0 0 :visible t)
 (assert (not (equalp fb (display-framebuffer d))))
 (set-cursor d nil nil :visible nil)
 (assert (equalp (subseq fb 0 512) (subseq (display-framebuffer d) 0 512))))
 (assert (= 2 (char-cell-width #\界)))
 (assert (equalp #(27 91 65) (key-event-bytes (make-key-event :key :up))))
 (assert (equalp #(27 79 65) (key-event-bytes (make-key-event :key :up) :application-cursor t)))
 (assert (equalp #(27 3) (key-event-bytes (make-key-event :key #\c :modifiers '(:alt :control)))))
 (assert (equalp #(206 187) (key-event-bytes (make-key-event :key #\λ))))
 (format t "DISPLAY CORE PASS~%"))
;; Each visible cell field must invalidate the cache independently. In particular,
;; EQUALP considers #\E and #\e equal even though their glyph pixels differ.
(let ((font (load-font nil 16)))
  (dolist (change '((:char #\e) (:width 2) (:fg #xff0000) (:bg #x0000ff)
                    (:bold t) (:inverse t) (:underline t)))
    (let* ((d (make-display :font font :owner sb-thread:*current-thread*))
           (original (make-cell :char #\E :fg #xffffff :bg #x123456))
           (changed (apply #'make-cell
                           (append change '(:char #\E :fg #xffffff :bg #x123456)))))
      (resize-display d 16 16)
      (draw-cells d 0 0 (list original))
      (setf (display-damage d) nil)
      (draw-cells d 0 0 (list (copy-cell original)))
      (assert (null (display-damage d)))
      (let ((before (copy-seq (display-framebuffer d))))
        (draw-cells d 0 0 (list changed))
        (assert (equal (display-damage d)
                       (list (list 0 0 (* 8 (cell-width changed)) 16))))
        (assert (plusp (count nil (map 'vector #'= before (display-framebuffer d)))))))))
(format t "DISPLAY CASE-SENSITIVE/FIELD DAMAGE AND PIXELS PASS~%")

(let* ((font (load-font nil 16)) (d (make-display :font font :owner sb-thread:*current-thread*)))
  (resize-display d 24 16)
  (draw-cells d 0 0 (list (make-cell :char #\A :fg #x102030 :bg #x405060 :inverse t)))
  (let ((normal (copy-seq (display-framebuffer d))))
    (draw-cells d 0 0 (list (make-cell :char #\A :fg #x405060 :bg #x102030)))
    (assert (equalp normal (display-framebuffer d))))
  (draw-cells d 0 0 (list (make-cell :char #\Space :width 2 :bg #x123456)
                          (make-cell :char #\Space :width 0)))
  (dotimes (y 16) (dotimes (x 16)
    (assert (= #xff123456 (aref (display-framebuffer d) (+ x (* y 24)))))))
  (draw-cells d 0 2 (list (make-cell :char #\Space :underline t :fg #xabcdef)))
  (dotimes (x 8) (assert (= #xffabcdef (aref (display-framebuffer d) (+ 16 x (* 14 24))))))
  (assert (= #xffffff (palette-color 231)))
  (assert (= #x080808 (palette-color 232)))
  (assert (handler-case
              (let ((thread (sb-thread:make-thread
                             (lambda ()
                               (handler-case (progn (draw-cells d 0 0 #()) nil)
                                 (display-error () t))))))
                (sb-thread:join-thread thread))
            (error () nil)))
  (format t "DISPLAY PIXEL/WIDE/INVERSE/UNDERLINE/OWNER PASS~%"))
(assert (handler-case
            (progn (open-display :backend :not-an-installed-backend) nil)
          (display-open-failed () t)))
(assert (handler-case
            (progn (open-display :backend :x11 :font-path "/nonexistent-lispterm-font.otb") nil)
          (display-open-failed () t)))
(assert (equalp #(27 91 49 59 54 65)
                (key-event-bytes (make-key-event :key :up :modifiers '(:shift :control)))))
(format t "DISPLAY OPEN FAILURE/KEY MODIFIERS PASS~%")


;; A failed close must retain ownership without advertising a usable transport.
(defstruct close-test-backend
  (opens 0) (closes 0) close-actions open-error)

(defmethod backend-open ((backend close-test-backend) display)
  (incf (close-test-backend-opens backend))
  (setf (display-backend-state display) :residual-handle)
  (when (close-test-backend-open-error backend)
    (error (close-test-backend-open-error backend))))

(defmethod backend-close ((backend close-test-backend) display)
  (incf (close-test-backend-closes backend))
  (let ((action (pop (close-test-backend-close-actions backend))))
    (cond ((eq action :stall) (sleep 1))
          (action (error action))))
  (setf (display-backend-state display) nil))

(defmethod backend-poll ((backend close-test-backend) display timeout)
  (declare (ignore display timeout))
  (error "Unexpected poll during cleanup: ~s" backend))
(defmethod backend-blit ((backend close-test-backend) display framebuffer rectangles)
  (declare (ignore display framebuffer rectangles))
  (error "Unexpected blit during cleanup: ~s" backend))
(defmethod backend-set-title ((backend close-test-backend) display title)
  (declare (ignore display title))
  (error "Unexpected title update during cleanup: ~s" backend))
(defmethod backend-metrics ((backend close-test-backend) display)
  (declare (ignore display))
  (error "Unexpected metrics query during cleanup: ~s" backend))

(let* ((failure (make-condition 'display-error :detail "Close interrupted"))
       (backend (make-close-test-backend :close-actions (list failure failure)))
       (display (open-display :backend backend :columns 2 :rows 1)))
  (assert (eq failure (handler-case (close-display display)
                        (display-error (condition) condition))))
  (assert (not (display-open-p display)))
  (assert (display-cleanup-pending-p display))
  (assert (eq :residual-handle (display-backend-state display)))
  (assert (null (poll-events display)))
  (present display)
  (assert (typep (handler-case (set-title display "Unusable")
                   (display-error (condition) condition)) 'display-error))
  (assert (typep (handler-case (display-metrics display)
                   (display-error (condition) condition)) 'display-error))
  ;; Reopening cannot allocate a replacement while old cleanup fails.
  (assert (eq failure (handler-case (reopen-display display)
                        (display-error (condition) condition))))
  (assert (= 1 (close-test-backend-opens backend)))
  (assert (display-cleanup-pending-p display))
  ;; Ownership also applies during cleanup recovery.
  (assert (sb-thread:join-thread
           (sb-thread:make-thread
            (lambda ()
              (handler-case (progn (close-display display) nil)
                (display-error () t))))))
  (assert (= 2 (close-test-backend-closes backend)))
  (assert (eq display (close-display display)))
  (assert (not (display-cleanup-pending-p display)))
  (assert (null (display-backend-state display)))
  (close-display display)
  (assert (= 3 (close-test-backend-closes backend)))
  (let ((replacement (reopen-display display)))
    (assert (display-open-p replacement))
    (assert (= 2 (close-test-backend-opens backend)))
    (close-display replacement)))

;; Asynchronous timeout has the same retry contract as an ordinary error.
(let* ((backend (make-close-test-backend :close-actions (list :stall)))
       (display (open-display :backend backend :columns 2 :rows 1)))
  (assert (handler-case
              (progn (sb-ext:with-timeout .02 (close-display display)) nil)
            (sb-ext:timeout () t)))
  (assert (not (display-open-p display)))
  (assert (display-cleanup-pending-p display))
  (assert (eq :residual-handle (display-backend-state display)))
  (close-display display)
  (assert (= 2 (close-test-backend-closes backend)))
  (assert (not (display-cleanup-pending-p display)))
  (assert (null (display-backend-state display))))

;; Preserve both opening and cleanup errors and the object needed for retry.
(let* ((open-error (make-condition 'display-error :detail "Open interrupted"))
       (close-error (make-condition 'display-error :detail "Cleanup interrupted"))
       (backend (make-close-test-backend :open-error open-error
                                         :close-actions (list close-error)))
       (failure (handler-case (open-display :backend backend :columns 2 :rows 1)
                  (display-open-failed (condition) condition)))
       (display (display-open-failed-display failure)))
  (assert (eq open-error (display-error-detail failure)))
  (assert (eq close-error (display-open-failed-cleanup-error failure)))
  (assert (not (display-open-p display)))
  (assert (display-cleanup-pending-p display))
  (assert (eq :residual-handle (display-backend-state display)))
  (close-display display)
  (assert (not (display-cleanup-pending-p display)))
  (assert (null (display-backend-state display)))
  (assert (= 2 (close-test-backend-closes backend))))
(format t "DISPLAY CLOSE ERROR/TIMEOUT/RETRY/PARTIAL-OPEN PASS~%")

;; New visible fields participate independently in cell cache invalidation.
(let ((font (load-font nil 16)))
  (dolist (size '(:double-width :double-height-top :double-height-bottom))
    (let ((d (make-display :font font :owner sb-thread:*current-thread*)))
      (resize-display d 16 16)
      (draw-cells d 0 0 (list (make-cell :char #\E)))
      (let ((before (copy-seq (display-framebuffer d))))
        (setf (display-damage d) nil)
        (draw-cells d 0 0 (list (make-cell :char #\E :line-size size)))
        (assert (equal '((0 0 16 16)) (display-damage d)))
        (assert (not (equalp before (display-framebuffer d)))))))
  (let ((d (make-display :font font :owner sb-thread:*current-thread* :blink-phase nil)))
    (resize-display d 16 16)
    (draw-cells d 0 0 (list (make-cell :char #\E :bg #x123456)))
    (setf (display-damage d) nil)
    (draw-cells d 0 0 (list (make-cell :char #\E :bg #x123456 :blink t)))
    (assert (equal '((0 0 8 16)) (display-damage d)))
    (dotimes (y 16) (dotimes (x 8)
      (assert (= #xff123456 (aref (display-framebuffer d) (+ x (* y 16)))))))))
(format t "DISPLAY LINE SIZE/BLINK CACHE DAMAGE AND PIXELS PASS~%")
