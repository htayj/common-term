(load (merge-pathnames "vttest-vt52-native-navigation-test-support.lisp" *load-truename*))
(in-package :vttest-vt52-native-navigation-tests)
(defmacro change (place value)
  `(let ((plist ,(second place)) (key ,(third place)))
     (assert (member key plist)) (setf (cadr (member key plist)) ,value)))
(defun run-tests ()
  (let ((checks 0) (failures nil) (case-no 0)
        (base (format nil "/home/taylor/projects/lispterm/.build/nav332-~d-~d/" (get-universal-time) (sb-posix:getpid))))
    (sb-posix:mkdir base #o700)
    (labels ((check (truth label) (incf checks) (unless truth (push label failures)))
             (case-run (label mutate &key (backend "x11") (scale 1) pass overrides)
               (let ((root (format nil "~acase-~d/" base (incf case-no))))
                 (multiple-value-bind (r obs out ev) (fixture root backend scale)
                   (when mutate (funcall mutate r obs out ev))
                   (publish root r obs out ev overrides)
                   (let ((answer (handler-case
                                   (multiple-value-bind (actual refs)
                                       (vttest-vt52-native-navigation:validate-recorder root backend scale)
                                     (check (and (equal r actual) (= 5 (length refs))) (list label :return))
                                     :accepted)
                                   (error () :refused))))
                     (check (eq answer (if pass :accepted :refused)) label)))))
             (proof (r) (getf (getf r :navigation-proofs) :outer-hold))
             (wire (ev) (find-if (lambda (e) (and (eq :wire-out (getf e :kind)) (eql 2 (getf e :pause)))) ev))
             (release2 (ev) (find-if (lambda (e) (and (eq :navigation-released (getf e :kind)) (eql 2 (getf e :hold)))) ev)))
      (check (equal '(:accepted :refused) (first-hold-tests)) :first-hold-ownership)
      (dolist (mode '(:pre-wire :wire-driver :wire-release :no-hold3 :bad-link :late-hold3))
        (case-run mode (lambda (r o b e) (declare (ignore o b))
          (let* ((w (find-if (lambda (x) (and (eq :wire-in (getf x :kind)) (eql 2 (getf x :pause)))) e))
                 (h (find-if (lambda (x) (and (eq :navigation-reached (getf x :kind)) (eql 3 (getf x :hold)))) e)))
            (ecase mode
              (:pre-wire (change (getf w :out) (1+ (getf (first (getf (proof r) :markers)) :start))))
              (:wire-driver (change (getf w :seq) 1))
              (:wire-release (change (getf (release2 e) :seq) (getf w :seq)))
              (:no-hold3 (change (getf h :kind) :other))
              (:bad-link (change (getf h :proof) nil))
              (:late-hold3 (change (getf h :seq) 999)))))))
      (dolist (bs '(("x11" 1) ("wayland" 1) ("wayland" 2)))
        (case-run (list :positive bs) nil :backend (first bs) :scale (second bs) :pass t))
      (dolist (kv '((:kind :wrong) (:version 1) (:profile :charsets) (:backend "wayland") (:scale 2)
                    (:status :fail) (:wire-accounting :fail) (:cleanup :unknown) (:bytes :pass)
                    (:unverified-count 1) (:attempted 0) (:reached 0) (:captured 0) (:frame-verified 0)
                    (:navigation-pauses (1 2)) (:navigation nil) (:checks nil)))
        (case-run (list :result kv) (lambda (r o b e) (declare (ignore o b e)) (change (getf r (first kv)) (second kv)))))
      (dolist (kv '((:stage :main-menu) (:state :pending) (:start 0) (:end 0) (:event 0) (:child-pid 99) (:input 99)))
        (case-run (list :proof kv) (lambda (r o b e) (declare (ignore o b e)) (change (getf (proof r) (first kv)) (second kv)))))
      (dolist (kv '((:start 0) (:event 0) (:input 99) (:child-pid 99) (:ticks 99999)))
        (case-run (list :checkpoint kv) (lambda (r o b e) (declare (ignore o b e)) (change (getf (getf (proof r) :checkpoint) (first kv)) (second kv)))))
      (dolist (kv '((:child-pid 99) (:association :other) (:backend :wayland) (:version 2)))
        (case-run (list :observations kv) (lambda (r o b e) (declare (ignore r b e)) (change (getf o (first kv)) (second kv)))))
      (case-run :spawn-pid (lambda (r o b e) (declare (ignore r b e)) (change (getf (first (getf o :samples)) :child-pid) 99)))
      (dolist (kv '((:source :driver) (:child-pid 99) (:seq 0) (:start 1) (:out 1)))
        (case-run (list :wire kv) (lambda (r o b e) (declare (ignore r o b)) (change (getf (wire e) (first kv)) (second kv)))))
      (case-run :changed-output (lambda (r o b e) (declare (ignore r o e)) (setf (aref b 0) 0)))
      (case-run :missing-marker (lambda (r o b e) (declare (ignore o e)) (change (getf (proof r) :markers) nil) (setf (aref b 60) 0)))
      (case-run :stale-prefix (lambda (r o b e) (declare (ignore o b e)) (let ((p (proof r))) (change (getf p :start) (getf p :end)) (change (getf (getf p :checkpoint) :start) (getf p :end)))))
      (case-run :suffix-retroactive (lambda (r o b e) (declare (ignore o b e)) (change (getf (proof r) :end) (1- (getf (proof r) :end)))))
      (case-run :event-retroactive (lambda (r o b e) (declare (ignore o b e)) (change (getf (proof r) :event) (1- (getf (proof r) :event)))))
      (case-run :return-byte (lambda (r o b e) (declare (ignore r o b)) (change (getf (find :driver e :key (lambda (x) (getf x :kind)) :from-end t) :bytes) #(10))))
      (case-run :return-offset (lambda (r o b e) (declare (ignore r o b)) (let ((w (find :wire-in e :key (lambda (x) (getf x :kind)) :from-end t))) (change (getf w :start) (1+ (getf w :start))))))
      (case-run :release-missing (lambda (r o b e) (declare (ignore r o b)) (change (getf (release2 e) :kind) :other)))
      (case-run :release-wrong-hold (lambda (r o b e) (declare (ignore r o b)) (change (getf (release2 e) :hold) 3)))
      (case-run :release-order (lambda (r o b e) (declare (ignore r o b)) (change (getf (release2 e) :seq) 1)))
      (case-run :return-source (lambda (r o b e) (declare (ignore r o b))
        (change (getf (find :wire-in e :key (lambda (x) (getf x :kind)) :from-end t) :source) :reply)))
      (case-run :duplicate-release (lambda (r o b e) (declare (ignore r o b))
        (let ((tail (member (release2 e) e))) (push (copy-tree (car tail)) (cdr tail)))))
      (case-run :ordered-marker-removal (lambda (r o b e) (declare (ignore r o))
        (let* ((w (wire e)) (a (getf w :start)) (payload (copy-seq (getf w :bytes))))
          (setf (aref payload 0) 0) (replace b payload :start1 a) (change (getf w :bytes) payload))))
      (case-run :reordered-fresh-markers (lambda (r o b e) (declare (ignore r o))
        (let* ((w (wire e)) (a (getf w :start)) (payload (reverse (getf w :bytes))))
          (replace b payload :start1 a) (change (getf w :bytes) payload))))
      (dolist (path '("recorder/input.raw" "recorder/RESULT.sexp" "recorder/observations.sexp" "recorder/output.raw" "recorder/events.sexp"))
        (case-run (list :missing path) nil :overrides (list (cons path :omit))))
      (dolist (bytes '(#() #(0) #(55 13 13 13 13 48 13 13)))
        (case-run :raw-input-mismatch nil :overrides (list (cons "recorder/input.raw" bytes))))
      (dolist (raw '("(:kind)" "(:kind :a :kind :b)" "#.(error 1)" "#1=(:x #1#)" "(:x . 3)" "(:x #A(1))"))
        (case-run (list :malformed raw) nil :overrides (list (cons "recorder/RESULT.sexp" (octets raw)))))
      (dolist (raw '("(:seq 1 :seq 2)" "(:seq)" "#1=(:x #1#)" "(:bytes #(256))" "(:bytes #(a))" "(:bytes #A(1))" "(:bytes #.(error 1))"))
        (case-run (list :event-syntax raw) nil :overrides (list (cons "recorder/events.sexp" (octets raw)))))
      (dolist (kind '(:shared :cycle))
        (let* ((tail (list :x 1)) (bad (if (eq kind :shared) (list tail tail) tail)))
          (when (eq kind :cycle) (setf (cdr (last bad)) bad))
          (check (handler-case (progn (io:guard-tree bad) nil) (error () t)) kind)))
      (format t "NAV332 checks=~d failures=~s fixtures=~a~%" checks (reverse failures) base)
      (when failures (error "Navigation test failures ~s" (reverse failures)))
      checks)))
(run-tests)
