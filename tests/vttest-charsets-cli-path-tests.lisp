(require :sb-posix)
(defpackage #:vttest-charsets-cli-path-tests (:use #:cl))
(in-package #:vttest-charsets-cli-path-tests)
;; Only rejected full CLIs run. Accepted spelling tests source the parser alone.
(defparameter *bash* "/nix/store/kwyi4bq5s2qgwbhz6cs4gjy57c2zdxws-bash-interactive-5.3p20/bin/bash")
(defparameter *source* (namestring (truename "tests/vttest-charsets-native.sh")))
(defparameter *before* (equal (sb-ext:posix-getenv "CLI349_MODE") "before"))
(defparameter *checks* 0)
(defun check (value label)
  (incf *checks*) (unless value (error "Failed: ~S" label)))
(defun absent (path)
  (handler-case (progn (sb-posix:lstat path) nil)
    (sb-posix:syscall-error (e)
      (if (= (sb-posix:syscall-errno e) sb-posix:enoent) t (error e)))))
(defun directory-new (path)
  (check (absent path) (list :missing path))
  (sb-posix:mkdir path #o700) path)
(defun text-new (path text)
  (let ((octets (sb-ext:string-to-octets text :external-format :utf-8)))
    (check (<= (length octets) 8192) :premeasure)
    (check (absent path) (list :missing path))
    (let* ((fd (sb-posix:open path (logior sb-posix:o-wronly sb-posix:o-creat sb-posix:o-excl) #o600))
           (stream (sb-sys:make-fd-stream fd :output t :element-type '(unsigned-byte 8) :auto-close t)))
      (with-open-stream (s stream) (write-sequence octets s)))
    (with-open-file (s path :element-type '(unsigned-byte 8))
      (let ((readback (make-array (file-length s) :element-type '(unsigned-byte 8))))
        (read-sequence readback s) (check (equalp octets readback) :readback)))))
(defun execute (args &key parser (scale "1") profile)
  (let* ((out (make-string-output-stream)) (err (make-string-output-stream))
         (environment (append (list "PATH=/run/current-system/sw/bin" "LANG=C.UTF-8" "LC_ALL=C.UTF-8"
                                    (concatenate 'string "LISPTERM_VTTEST_SCALE=" scale))
                              (when profile (list (concatenate 'string "LISPTERM_VTTEST_PROFILE=" profile)))))
         (command (if parser
                      (append (list "--noprofile" "--norc" "-c"
                                    "source \"$1\"; charsets_profile_args \"${@:2}\" || exit 2; printf '%s' \"$profile\""
                                    "cli349" *source*) args)
                      (append (list "--noprofile" "--norc" *source*) args)))
         (process (sb-ext:run-program *bash* command :search nil :environment environment
                                     :input nil :output out :error err :wait t))
         (status (sb-ext:process-exit-code process))
         (stdout (get-output-stream-string out)) (stderr (get-output-stream-string err)))
    (format t "CLI ~S status=~D stdout=~S stderr=~S~%" args status stdout stderr)
    (check (string= stderr "") :stderr)
    (values status stdout)))
(let* ((base (directory-new (format nil "~A.build/cli349-~A-~D"
                                    (namestring (truename "."))
                                    (if *before* "before" "after") (get-universal-time))))
       (serial 0))
  (labels ((fixture ()
             (let* ((root (directory-new (format nil "~A/case-~D" base (incf serial))))
                    (run (directory-new (concatenate 'string root "/run")))
                    (manifest (concatenate 'string run "/MANIFEST.sexp")))
               (text-new manifest (format nil "(:cli349-fixture t)~%"))
               (values root run manifest)))
           (reject (args run &rest keys)
             (multiple-value-bind (status out) (apply #'execute args keys)
               (check (= status 2) :exit2) (check (string= out "") :stdout))
             (dolist (leaf '("home" "cache" "config" "data" "tmp" "native" "native-environment.command"))
               (check (absent (concatenate 'string run "/" leaf)) (list :unallocated leaf)))))
    (if *before*
        (multiple-value-bind (root run manifest) (fixture)
          (declare (ignore manifest))
          (directory-new (concatenate 'string root "/branch"))
          (let ((alias (concatenate 'string root "/branch/../run")))
            (check (= 2 (execute (list "x11" alias (concatenate 'string alias "/MANIFEST.sexp") "--profile" "vt52"))) :control-exit2)
            (dolist (leaf '("home" "cache" "config" "data" "tmp" "native-environment.command"))
              (check (not (absent (concatenate 'string run "/" leaf))) :control-allocation))
            (check (absent (concatenate 'string run "/native")) :control-no-native)))
        (progn
          (dolist (profile '(nil ("--profile" "charsets") ("--profile" "vt52")))
            (dolist (kind '(:dotdot :ancestor :manifest-dotdot :manifest-leaf :root-leaf))
              (multiple-value-bind (root run manifest) (fixture)
                (let ((input run) (m manifest))
                  (case kind
                    (:dotdot (directory-new (concatenate 'string root "/branch"))
                             (setf input (concatenate 'string root "/branch/../run")
                                   m (concatenate 'string input "/MANIFEST.sexp")))
                    (:ancestor (let ((link (concatenate 'string root "/alias")))
                                 (check (absent link) :link-missing) (sb-posix:symlink root link)
                                 (setf input (concatenate 'string link "/run")
                                       m (concatenate 'string input "/MANIFEST.sexp"))))
                    (:manifest-dotdot (setf m (concatenate 'string run "/../run/MANIFEST.sexp")))
                    (:manifest-leaf (let ((target (concatenate 'string root "/original.sexp")))
                                      (text-new target (format nil "(:cli349-fixture t)~%"))
                                      (sb-posix:unlink manifest)
                                      (check (absent manifest) :link-missing) (sb-posix:symlink target manifest)))
                    (:root-leaf (setf input (concatenate 'string root "/alias"))
                                (check (absent input) :link-missing) (sb-posix:symlink run input)
                                (setf m (concatenate 'string input "/MANIFEST.sexp"))))
                  (reject (append (list "x11" input m) profile) run))))
            (multiple-value-bind (root run manifest) (fixture)
              (declare (ignore root))
              (dolist (suffix '("" "/"))
                (multiple-value-bind (status out)
                    (execute (append (list "wayland" (concatenate 'string run suffix) manifest) profile) :parser t)
                  (check (= status 0) :parser-accept)
                  (check (string= out (or (second profile) "charsets")) :selected-profile)))))
          (dolist (kind '(:backend :arity :profile :conflict :scale :x11-scale))
            (multiple-value-bind (root run manifest) (fixture)
              (declare (ignore root))
              (let ((args (list "x11" run manifest)))
                (case kind
                  (:backend (setf (first args) "other"))
                  (:arity (setf args (butlast args)))
                  (:profile (setf args (append args '("--profile" "other")))))
                (reject args run :profile (when (eq kind :conflict) "vt52")
                        :scale (case kind (:scale "other") (:x11-scale "2") (t "1"))))))))
  (format t "PASS ~D checks; retained fixture ~A~%" *checks* base)))
