;;;; Fixed 15-second native finalization phase; no entry point runs on load.
(load (merge-pathnames "vttest-vt52-native-io.lisp" *load-truename*))
(defpackage :vttest-vt52-native-clock
  (:use :cl :vttest-vt52-native-io)
  (:export :environment :scalar :monotonic-ns :process-token :start-cleanup
           :await-exit :bounded-notify :bounded-import :deadline))
(in-package :vttest-vt52-native-clock)
(defun environment (key)
  (sb-ext:posix-getenv (concatenate 'string "LISPTERM_CHARSETS_" key)))
(defun scalar (key)
  (let ((text (environment key)))
    (need (and text (< (length text) 128)))
    (let ((x (parse-data (sb-ext:string-to-octets text :external-format :utf-8))))
      (need (atom x)) x)))
(defun monotonic-ns ()
  (multiple-value-bind (sec ns) (sb-unix:clock-gettime sb-unix:clock-monotonic)
    (+ (* sec 1000000000) ns)))
(defun process-token (pid)
  ;; Linux field22, after the last ')' in comm; zombies are exited for await.
  (need (typep pid '(integer 1 4194304)))
  (with-open-file (s (format nil "/proc/~d/stat" pid) :if-does-not-exist nil)
    (when s
      (let* ((row (read-line s)) (end (position #\) row :from-end t))
             (rest (subseq row (+ end 2))) (*read-eval* nil) (*read-base* 10))
        (need (< (length row) 8192))
        (unless (char= (char rest 0) #\Z)
          (with-input-from-string (in rest)
            (loop repeat 19 do (read in))
            (let ((n (read in))) (need (typep n '(integer 0)))
              (format nil "~d" n))))))))
(defun start-cleanup (root)
  (let ((start (monotonic-ns)))
    (write-data root "native/finalization-clock.sexp.start" start) start))
(defun deadline (root)
  (let ((start (read-data root "native/finalization-clock.sexp.start"))
        (given (scalar "START_NS")) (end (scalar "DEADLINE_NS")))
    (need (and (typep start '(integer 0)) (eql start given)
               (eql end (+ start 15000000000)) (<= start (monotonic-ns))))
    end))
(defun await-exit (root backend)
  (let* ((end (deadline root)) (start (- end 15000000000))
         (pid (scalar "PID")) (token (environment "TOKEN")) (state nil))
    (need (and (typep pid '(integer 1 4194304)) (stringp token)
               (plusp (length token)) (<= (length token) 32)
               (every (lambda (c) (find c "0123456789")) token)))
    (loop (when (>= (monotonic-ns) end) (setf state :timeout) (return))
          (unless (equal token (process-token pid)) (setf state :exited) (return))
          (sleep .02))
    (write-data root "native/finalization-clock.sexp"
      (list :clock :clock-monotonic :limit-seconds 15 :start-ns start
            :run root :backend backend :end-ns (monotonic-ns)
            :state state :pid pid :token token)) state))
(defun before-deadline (end function)
  (let ((seconds (/ (- end (monotonic-ns)) 1000000000d0)))
    (when (<= seconds 0) (error 'sb-ext:timeout))
    (prog1 (sb-ext:with-timeout seconds (funcall function))
      (when (>= (monotonic-ns) end) (error 'sb-ext:timeout)))))
(defun bounded-notify (root backend)
  (before-deadline (deadline root)
    (lambda ()
      (let ((pause (scalar "PAUSE")) (reason (environment "REASON"))
            (stage (scalar "STAGE")))
        (need (and (typep pause '(integer 0 3))
                   (member reason '("recorder" "request" "geometry" "authorization" "capture" "placement") :test #'equal)
                   (member stage '(:placement :request :geometry :authorization :capture))))
        (let ((row (list :kind :vttest-charsets-native-failure :version 1
                         :run root :backend backend :pause pause :reason reason
                         :stage stage :manifest (reference root "MANIFEST.sexp"))))
          (write-data root "native/native-failure-origin.sexp" row)
          (write-data root "native/native-failure.sexp.tmp"
            (append row (list :origin (reference root "native/native-failure-origin.sexp"))))
          (sb-posix:link (local-path root "native/native-failure.sexp.tmp")
                         (local-path root "native/native-failure.sexp" :missing t))
          (sb-posix:unlink (local-path root "native/native-failure.sexp.tmp")))))))
(defun bounded-import (root backend function)
  (need (functionp function) "Mandatory import callback absent")
  (let ((end (deadline root)))
    (handler-case
        (let ((row
                (before-deadline end
                  (lambda ()
                    (let ((clock (read-data root "native/finalization-clock.sexp")))
                      (properties clock '(:clock :limit-seconds :start-ns :run :backend :end-ns :state :pid :token))
                      (need (and (eq :clock-monotonic (getf clock :clock))
                                 (eql 15 (getf clock :limit-seconds))
                                 (eq :exited (getf clock :state))
                                 (equal root (getf clock :run)) (equal backend (getf clock :backend))
                                 (eql (- end 15000000000) (getf clock :start-ns))
                                 (eql (scalar "PID") (getf clock :pid))
                                 (equal (environment "TOKEN") (getf clock :token))
                                 (typep (getf clock :end-ns) '(integer 0))
                                 (<= (getf clock :start-ns) (getf clock :end-ns) (monotonic-ns))))
                      (let ((datum (funcall function root)))
                        (properties datum '(:origin :status :stage :checks))
                        (need (member (getf datum :status) '(:pass :fail)))
                        (check-reference (getf datum :origin) root "recorder/RESULT.sexp")
                        (properties (getf datum :stage) '(:origin :attempted :reached :captured :frame-verified))
                        (need (equal (getf datum :origin) (getf (getf datum :stage) :origin)))
                        datum))))))
          (write-data root "native/recorder-import.sexp" row)
          (let ((at (monotonic-ns)))
            (when (>= at end) (error 'sb-ext:timeout))
            (write-data root "native/import-deadline.sexp"
              (list :clock :clock-monotonic :deadline-ns end :validated-ns at :state :valid)))
          (getf row :status))
      (sb-ext:timeout ()
        (write-data root "native/import-deadline.sexp"
          (list :clock :clock-monotonic :deadline-ns end :validated-ns nil :state :timeout))
        (error 'sb-ext:timeout)))))
(defun refuse-report ()
  (list :schema :vt52-native-check-v1 :kind :vttest-vt52-native-check :version 1
        :verdict :refuse :reasons '(:validation-error) :backend nil :scale nil
        :pause 2 :pauses '(2) :navigation-pauses '(1 2 3) :valid-frames 0
        :counts (list :required 1 :attempted nil :reached nil :captured nil :verified nil
                      :passed nil :failed nil :unverified nil)
        :checks nil :capture nil :ledger nil :provenance nil :cleanup nil :limitations nil))
(defun validate (function root &optional candidate)
  (need (functionp function) "Mandatory validation callback absent")
  (handler-case
      (let ((report (if candidate (funcall function root :candidate candidate) (funcall function root))))
        (properties report '(:schema :kind :version :verdict :reasons :backend :scale :pause :pauses
                             :navigation-pauses :valid-frames :counts :checks :capture :ledger
                             :provenance :cleanup :limitations))
        (need (and (eq :vt52-native-check-v1 (getf report :schema))
                   (eq :vttest-vt52-native-check (getf report :kind))
                   (eql 1 (getf report :version))
                   (member (getf report :verdict) '(:pass :refuse))))
        report)
    (error () (refuse-report))))
(export 'validate)
