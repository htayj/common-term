;;;; Offline cleanup controls. No process launch, signalling, wait or display.
(in-package #:vttest-keyboard-driver-tests)
(load (merge-pathnames "vttest-keyboard-cleanup-fixtures.lisp" *load-truename*))

(defun cleanup-controls ()
  (dolist (backend '("x11" "wayland"))
    (multiple-value-bind (root launch exit raw) (cleanup-fixture backend)
      (multiple-value-bind (status reasons projection)
          (k::consume-gate-cleanup root backend launch exit)
        (check (and (eq status :pass) (eq (getf projection :state) :stopped)
                    (equal (getf projection :receipt-sha256)
                           (k::digest (c::cat root "recorder/cleanup-receipt.sexp")))
                    (find :first-waits reasons :key #'first))
               (list backend :independent-cleanup-positive))
        (check (not (problem-p (lambda () (k::validate-cleanup projection backend root))))
               :normalized-outer-schema))
      (flet ((mutate (status label fn)
               (cleanup-mutation root backend launch exit raw status (list backend label) fn)))
        (dolist (pair '((:gate-pid 702) (:gate-start "9002")
                        (:title "Lispterm-vttest-fedcba9876543210-701")
                        (:artifacts "/other/recorder")
                        (:area-request-sha256 "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")))
          (mutate :fail (list :binding (first pair))
                  (lambda (l e r) (declare (ignore l e))
                    (setf (getf (getf r :launch) (first pair)) (second pair))
                    (when (eq (first pair) :gate-pid)
                      (setf (getf (getf r :launch) :title) "Lispterm-vttest-0123456789abcdef-702")))))
        (dolist (pair '((:exit-code 3) (:exit-code 143) (:gate-pid 702) (:gate-start "9002")
                        (:backend "foreign") (:wait-observed "true")))
          (mutate :fail (list :actual-exit (first pair) (second pair))
                  (lambda (l e r) (declare (ignore l r)) (setf (getf e (first pair)) (second pair)))))
        (mutate :unverified :actual-wait-missing
                (lambda (l e r) (declare (ignore l r)) (setf (getf e :wait-observed) nil)))
        (mutate :unverified :raw-launch-start-unobserved
                (lambda (l e r) (declare (ignore l e)) (setf (getf (getf r :launch) :gate-start) nil)))
        (mutate :fail :known-mismatch-with-missing-binding
                (lambda (l e r) (declare (ignore l e))
                  (setf (getf (getf r :launch) :gate-start) nil
                        (getf (getf r :launch) :title) "Lispterm-vttest-fedcba9876543210-701")))
        (mutate :unverified :expected-start-missing
                (lambda (l e r) (declare (ignore e r)) (remf l :gate-start)))
        (dolist (spec '((:owned nil :unverified) (:state :unknown :unverified)
                        (:launch-valid nil :unverified) (:runtime :retained :fail)
                        (:stop-owned :survived :fail) (:state :failed :fail)))
          (mutate (third spec) (list :raw (first spec) (second spec))
                  (lambda (l e r) (declare (ignore l e))
                    (setf (getf r (first spec)) (second spec))
                    (when (eq (first spec) :owned)
                      (setf (getf r :state) :incomplete)
                      (when (equal backend "wayland") (setf (getf r :wayland-holder) :missing))))))
        (mutate :unverified :missing-root
                (lambda (l e r) (declare (ignore l e)) (pop (getf r :owned))))
        (mutate :fail :duplicate-root
                (lambda (l e r) (declare (ignore l e))
                  (let ((other (copy-list (first (getf r :owned)))))
                    (setf (getf other :pid) 799) (push other (getf r :owned)))))
        (mutate :fail :duplicate-pid-reused-token-cannot-inherit-wait
                (lambda (l e r) (declare (ignore l e))
                  (let ((other (copy-list (first (getf r :owned)))))
                    (setf (getf other :start) "99999") (push other (getf r :owned)))))
        (mutate :fail :gate-cannot-be-its-own-stopped-child
                (lambda (l e r) (declare (ignore l e))
                  (setf (getf (first (getf r :owned)) :pid) 701)))
        (mutate :fail :root-directness
                (lambda (l e r) (declare (ignore l e))
                  (let ((o (first (getf r :owned)))) (setf (getf o :direct) (not (getf o :direct))))))
        (mutate :fail :duplicate-plist-key
                (lambda (l e r) (declare (ignore l e)) (setf (getf r :launch) (append (getf r :launch) '(:gate-pid 701)))))
        (mutate :fail :malformed-owned-plist
                (lambda (l e r) (declare (ignore l e)) (setf (getf r :owned) '((:pid 710 :role)))))
        (mutate :unverified :adoption-failure-cannot-inherit-wait
                (lambda (l e r) (declare (ignore l e))
                  (setf (getf r :adoption-failures)
                        '((:role "client" :pid 799 :reason :initial-token-unreadable)))))
        (mutate :fail :identity-conflict-cannot-inherit-wait
                (lambda (l e r) (declare (ignore l e))
                  (let ((o (first (getf r :owned))))
                    (setf (getf r :identity-failures)
                          (list (list :pid (getf o :pid) :start (getf o :start)
                                      :observed-start "99999" :reason :pid-reused))))))
        (dolist (spec '((:observed :zombie :fail) (:observed :live :fail)
                        (:observed :unknown :unverified) (:wait-status nil :unverified)
                        (:wait-status 127 :unverified) (:wait-status "0" :fail)))
          (mutate (third spec) (list :direct-child (first spec) (second spec))
                  (lambda (l e r) (declare (ignore l e))
                      (let ((owned-row (find-if (lambda (o) (getf o :direct)) (getf r :owned))))
                        (setf (getf owned-row (first spec)) (second spec))))))
        (when (equal backend "wayland")
          (mutate :unverified :holder-missing
                  (lambda (l e r) (declare (ignore l e))
                    (setf (getf r :owned) (remove "keyboard-holder" (getf r :owned)
                                                 :key (lambda (o) (getf o :role)) :test #'equal)
                          (getf r :state) :incomplete (getf r :wayland-holder) :missing)))
          (mutate :pass :nonchild-zombie-is-exited
                  (lambda (l e r) (declare (ignore l e))
                    (setf (getf (first (getf r :owned)) :observed) :zombie)))
          (mutate :fail :holder-state-contradiction
                  (lambda (l e r) (declare (ignore l e)) (setf (getf r :wayland-holder) :unknown))))
        (let ((before (copy-tree raw)))
          (dotimes (n 2) (k::consume-gate-cleanup root backend launch exit))
          (check (and (equal raw before)
                      (= 143 (getf (find-if (lambda (o) (eql (getf o :wait-status) 143))
                                           (getf raw :owned)) :wait-status)))
                 (list backend :first-nonzero-wait-preserved)))
        (dolist (relative '("launch-request.sexp" "recorder/area-request.sexp" "launch-receipt.txt"))
          (let* ((path (c::cat root relative)) (saved (vttest-cursor-driver::text path)))
            (unwind-protect
                 (progn (put-bytes path "WRONG")
                        (check (eq :fail (k::consume-gate-cleanup root backend launch exit))
                               (list backend :copy-or-receipt-mismatch relative)))
              (put-bytes path saved))))
        (check (eq :unverified (k::consume-gate-cleanup root backend nil exit)) :missing-expected-launch)
        (check (eq :unverified (k::consume-gate-cleanup root backend launch nil)) :missing-actual-exit)
        (delete-file (c::cat root "recorder/cleanup-receipt.sexp"))
        (unwind-protect
             (check (eq :unverified (k::consume-gate-cleanup root backend launch exit)) :missing-raw-receipt)
          (write-cleanup root raw))))
    (cleanup-summary-controls backend)))
