;;;; Focused offline keyboard controls. Run from the repository root.
(load (merge-pathnames "vttest-area.lisp" *load-truename*))
(load (merge-pathnames "vttest-keyboard-driver-tests.lisp" *load-truename*))
(in-package :vttest-keyboard-driver-tests)
(defun with-functions (bindings thunk)
  (let ((old (mapcar (lambda (b) (cons (car b) (symbol-function (car b)))) bindings)))
    (unwind-protect
         (progn (dolist (b bindings) (setf (symbol-function (car b)) (cdr b))) (funcall thunk))
      (dolist (b old) (setf (symbol-function (car b)) (cdr b))))))
(defun dispatch-controls ()
  (dolist (backend '("x11" "wayland"))
    (let ((called nil) (validated nil) (result nil) (root (temp-root)))
      (with-functions
       (list (cons 'a::new-run-directory (lambda () root))
             (cons 'a::source-bindings (lambda () (values "head-fixture" "tree-fixture")))
             (cons 'a::write-result (lambda (directory value) (declare (ignore directory))
                                    (setf result value) "offline-result"))
             (cons 'k:validate (let ((real (symbol-function 'k:validate)))
                                (lambda (m) (setf validated t) (funcall real m))))
             (cons 'k:run (lambda (m &rest context) (declare (ignore context))
                           (setf called (getf m :backend))
                           (k:summarize-native m nil 3))))
       (lambda ()
         (check (= 3 (a:main (list "--area" "keyboard" "--backend" backend)))
                (list backend :cli-incomplete))
         (check (and validated (equal called backend) (= 26 (getf result :required-count))
                     (= 26 (getf result :unverified-count))) :default-manifest-validator-dispatch)))
      (let ((m (k:make-manifest backend)))
        (setf (getf m :native-driver) "cursor-x11-v1")
        (check (eq :driver-not-integrated (problem-p (lambda () (a:run-selected m nil))))
               :dispatcher-rejects-foreign-driver))))
  (let* ((root (temp-root)) (k::*adapter* (c::cat root "absent-adapter.sh")))
    (handler-case
        (progn (k:invoke-native "x11" root (c::cat root "MANIFEST.sexp"))
               (check nil :missing-adapter))
      (a:gate-problem (e)
        (check (and (= 3 (a:problem-code e))
                    (eq :keyboard-native-adapter-missing (a:problem-reason e))) :missing-adapter))))
  (let* ((root (recorder)) (m (k:make-manifest "x11"))
         (record (list :kind :vttest-keyboard-native :version 1 :backend "x11"
                       :manifest-sha256 (make-string 64 :initial-element #\a) :status :incomplete
                       :checks (loop for label in '("keyboard-cursor" "keyboard-keypad") append
                                  (loop for (id . name) in (nth-value 1 (k::case-identity label (c::cat root "recorder/")))
                                        collect (list :scenario label :capture id :name name
                                                      :pixels :unverified :timing :unverified))))))
    (multiple-value-bind (obs evidence) (k:summarize-native m record 3 root)
      (check (and (every (lambda (o) (and (eq :unverified (getf o :pixels))
                                         (eq :unverified (getf o :timing)) (not (getf o :fresh)))) obs)
                  (= 26 (getf (getf evidence :counts) :unverified))) :unverified-pixels-timing))
    (dolist (axis '(:pixels :timing))
      (let ((bad (copy-tree record)))
        (setf (getf (first (getf bad :checks)) axis) :fail)
        (let ((obs (k:summarize-native m bad 3 root)))
          (check (eq :fail (a:aggregate-observations (getf m :scenarios) obs))
                 (list :failed-evidence axis)))))
    (let ((bad (copy-tree record)))
      (push (copy-list (first (getf bad :checks))) (getf bad :checks))
      (check (problem-p (lambda () (k::validate-receipt bad "x11" root))) :duplicate-receipt-check))
    (remf (first (getf record :checks)) :timing)
    (check (problem-p (lambda () (k::validate-receipt record "x11" root))) :missing-timing)))
