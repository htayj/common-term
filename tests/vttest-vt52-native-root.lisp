;;;; Root provenance, independent of capture/navigation recomputation.
(load (merge-pathnames "vttest-vt52-native-provenance.lisp" *load-truename*))
(in-package :vttest-vt52-native-root)
(defun component-tree (value) (guard-tree (copy-tree value)))
(defun validate-root (run-dir &key backend scale candidate)
"Return a guarded root component; candidate mode never claims final native-run provenance."
(let ((reason :invalid-root) (root nil) (m nil) (n nil) (ledger nil) (refs nil) (pins nil) (cleanup nil) (originals nil) (sources nil))
(labels ((ref (key path) (setf (getf refs key) (reference root path)))
     (original (key path) (prog1 (read-data root path) (ref key path))))
(handler-case
(progn
  (setf root (canonical-root run-dir) reason :invalid-manifest)
  (setf originals (root-originals root candidate))
  (setf m (read-data root "MANIFEST.sexp" :protocol t))
  (properties m '(:kind :version :area :backend :scale :scope-status :conditions :navigation-pauses :scenarios
                  :required-count :native-driver :pins))
  (when backend (setf reason :backend-mismatch) (need (equal backend (getf m :backend))))
  (when scale (setf reason :scale-mismatch) (need (eql scale (getf m :scale))))
  (setf backend (getf m :backend) scale (getf m :scale) reason :invalid-manifest)
  (validate-manifest m backend scale) (ref :manifest "MANIFEST.sexp")
  (setf reason :source-binding-failed)
  (let ((expected (cons (local-path root "MANIFEST.sexp") (getf (getf refs :manifest) :sha256))))
    (need (and (equal (list expected) (sums root "native/manifest-pre.sha256"))
               (equal (list expected) (sums root "native/manifest-post.sha256")))))
  (ref :manifest-before "native/manifest-pre.sha256") (ref :manifest-after "native/manifest-post.sha256")
  (let ((rows (checked-sums root "native/execution-inputs.sha256" +source-root+ "native/execution-inputs-post.check")))
    (setf sources rows)
    (need (assoc (local-path root "MANIFEST.sexp") rows :test #'equal))
    (dolist (p (getf m :pins)) (need (assoc (getf p :path) rows :test #'equal))))
  (dolist (p '("/nix/store/9qvd27vg12177prxcl778rdhxh4lk2mi-terminus-font-4.49.1/share/fonts/terminus/ter-u16n.otb"
               "/nix/store/h74lg8wfwndnf5glr171kmcshlffi7l2-imagemagick-7.1.2-29/bin/magick"))
    (need (assoc p sources :test #'equal)))
  (ref :execution-inputs "native/execution-inputs.sha256")
  (ref :execution-inputs-post "native/execution-inputs-post.check")
  (let ((a (sums root "build/archive.actual.sha256")))
    (need (and (= 1 (length a)) (equal (cdar a) "cd6886f9aefe6a3f6c566fa61271a55710901a71849c630bf5376aa984bf77cc")))
    (setf pins (list :archive (pin (caar a) 243249 "cd6886f9aefe6a3f6c566fa61271a55710901a71849c630bf5376aa984bf77cc")
      :vt52-source (pin (local-path root "build/source/vttest-20251205/vt52.c") 7834
        "720867fb58f57ba70cdfc12643c94d256278e325fdf43d691a440fc16ab712d4")
      :font (pin "/nix/store/9qvd27vg12177prxcl778rdhxh4lk2mi-terminus-font-4.49.1/share/fonts/terminus/ter-u16n.otb"
        38848 "0d11d8ed0889a412fb6903710804643ad85858cc56905286cedae392a57255ca"))))
  (setf reason :build-failed)
  (let ((b (original :build "build/BUILD.sexp")))
    (properties b '(:kind :version :status :reason :exit))
    (need (and (eq :vttest-screen-build (getf b :kind)) (eql 1 (getf b :version))
               (eq :pass (getf b :status)) (eql 0 (getf b :exit)))))
  (dolist (p '("native/build.exit" "build/extract.exit" "build/configure.exit" "build/make.exit"))
    (need (eql 0 (read-data root p))))
  (let ((binary (sums root "build/binary.sha256")))
    (need (and (= 1 (length binary))
               (equal (caar binary) (local-path root "build/source/vttest-20251205/vttest"))
               (equal binary (checked-sums root "native/binary-pre.sha256" root))
               (equal binary (checked-sums root "native/binary-post.sha256" root)))))
  (checked-sums root "build/tools.sha256" root "build/tools-post.check")
  (checked-sums root "build/source.sha256" (concatenate 'string root "build/source/vttest-20251205/") "build/source-post.check")
  (setf reason :invalid-ledger ledger (validate-ledger (read-data root "native/stages.sexp") root backend))
  (ref :ledger "native/stages.sexp")
  (setf reason :invalid-native-run n (if candidate (guard-tree candidate) (original :native-run "VT52-RUN.sexp")))
  (properties n '(:kind :version :backend :scale :attempted :reached :captured :captures :navigation-pauses
    :navigation :unverified-count :checks :status :build :native-started :cleanup :recorder-result
    :recorder-sha256 :manifest :manifest-sha256 :execution-inputs :evidence :reason :stages
    :finalization :abort :unowned-endpoints :count-basis))
  (need (and (eq :vttest-vt52-run (getf n :kind)) (eql 3 (getf n :version))
             (equal backend (getf n :backend)) (eql scale (getf n :scale))
             (eq :native-vt52 (getf n :count-basis)) (eq :pass (getf n :build))
             (eq t (getf n :native-started)) (eq :pass (getf n :cleanup))
             (eq :pass (getf n :status)) (stringp (getf n :reason))
             (eql 0 (getf n :unverified-count)) (equal '(1 2 3) (getf n :navigation-pauses))
             (every (lambda (k) (eql 1 (getf n k))) '(:attempted :reached :captured :captures))
             (null (getf n :abort)) (equal (local-path root "MANIFEST.sexp") (getf n :manifest))
             (equal (getf (getf refs :manifest) :sha256) (getf n :manifest-sha256))
             (equal "recorder/RESULT.sexp" (getf n :recorder-result))
             (equal "native/execution-inputs.sha256" (getf n :execution-inputs))))
  (let* ((s (getf n :stages)) (r (getf s :recorder)) (v (getf s :native)))
    (properties s '(:recorder :native))
    (properties r '(:origin :attempted :reached :captured :frame-verified))
    (properties v '(:origin :request-observed :capture-invoked :capture-completed))
    (dolist (k '(:attempted :reached :captured :frame-verified)) (need (eql 1 (getf r k))))
    (dolist (k '(:request-observed :capture-invoked :capture-completed)) (need (eql 1 (getf v k))))
    (check-reference (getf r :origin) root "recorder/RESULT.sexp")
    (check-reference (getf v :origin) root "native/stages.sexp"))
  (need (= 1 (length (getf n :checks))))
  (dolist (c (getf n :checks))
    (properties c '(:pause :pixels :bytes :timing))
    (need (and (eql 2 (getf c :pause)) (eq :pass (getf c :pixels))
               (eq :pass (getf c :timing)) (eq :unverified (getf c :bytes)))))
  (ref :recorder "recorder/RESULT.sexp")
  (need (equal (getf n :recorder-sha256) (getf (getf refs :recorder) :sha256)))
  (setf reason :finalization-failed)
  (validate-finalization (getf n :finalization) root backend)
  (ref :finalization-clock "native/finalization-clock.sexp")
  (ref :import-deadline "native/import-deadline.sexp")
  (setf reason :cleanup-failed)
  (local-path root "recorder/abort.sexp" :missing t) (local-path root "recorder/ABORT" :missing t)
  (validate-cleanup root (read-data root "native/finalization-clock.sexp"))
  (ref :owned-cleanup "native/owned-cleanup.sexp")
  (dolist (u (getf n :unowned-endpoints))
    (properties u '(:path :ownership))
    (need (and (stringp (getf u :path)) (eq :unestablished (getf u :ownership)))))
  (setf cleanup (list :build :pass :native-started t :cleanup :pass
    :finalization (getf n :finalization) :abort nil :unowned-endpoints (getf n :unowned-endpoints)))
  (dolist (r originals) (check-reference r root))
  (setf reason nil))
(error () nil))
(component-tree (list :verdict (if reason :refuse :pass) :reasons (when reason (list reason))
    :mode (if candidate :candidate :final) :root root :backend backend :scale scale
    :manifest m :native-run n :ledger ledger :source-root +source-root+ :sources (mapcar (lambda (r) (list (car r) (cdr r))) sources) :originals originals
    :provenance (append (list :root root)
      (loop for k in '(:manifest-before :manifest-after :manifest :native-run :recorder :execution-inputs
        :execution-inputs-post :build :finalization-clock :import-deadline :owned-cleanup)
        append (list k (getf refs k))) (list :pins pins))
    :cleanup cleanup)))))
