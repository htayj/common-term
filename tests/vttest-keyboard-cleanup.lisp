;;;; Reconcile raw post-close evidence with independently frozen launch/join facts.
(in-package #:vttest-keyboard-driver)
(load (merge-pathnames "vttest-keyboard-cleanup-schema.lisp" *load-truename*))

(defun cleanup-read (root relative)
  (let ((path (concatenate 'string root relative)))
    (when (present-p path)
      (let ((sha (digest path)) (data (recorder-data path)))
        (need (equal sha (digest path)) :keyboard-cleanup-changed)
        (values data sha)))))
(defun cleanup-projection (raw sha)
  ;; Omitted raw fields are not synthesized into contradictory NIL claims.
  (append (cleanup-project-fields raw '((:phase :phase) (:state :state)))
          (list :receipt "recorder/cleanup-receipt.sexp" :receipt-sha256 sha)
          (when (cleanup-present-p raw :owned)
            (list :owned (loop for o in (getf raw :owned)
                               collect (cleanup-project-fields o
                                        '((:role :role) (:pid :pid) (:start :start-token) (:state :state))))))
          (cleanup-project-fields raw '((:wayland-holder :wayland-holder)))))
(defun consume-gate-cleanup (root backend expected-launch actual-gate-exit)
  "No process operations. Return cleanup status, bounded diagnostics, projection."
  (let ((failed nil) (unknown nil) (reasons nil) (projection nil)
        (*cleanup-collecting* t) (*cleanup-omissions* nil))
    (labels ((fail (why) (setf failed t) (pushnew why reasons :test #'equal))
             (missing (why) (setf unknown t) (pushnew why reasons :test #'equal)))
      (handler-case
          (progn
            (need (and (member backend '("x11" "wayland") :test #'equal)
                       (stringp root) (> (length root) 1)
                       (char= (char root 0) (code-char 47)) (char= (char root (1- (length root))) (code-char 47))
                       (equal root (namestring (truename root)))) :keyboard-cleanup-root)
            (let* ((launch (validate-gate-launch expected-launch backend root))
                   (exit (validate-gate-exit actual-gate-exit backend))
                   (evidence (multiple-value-list (cleanup-read root "recorder/cleanup-receipt.sexp")))
                   (raw (first evidence)))
              (unless (getf exit :wait-observed) (missing :gate-wait-unobserved))
              (when (and (cleanup-present-p exit :exit-code) (not (zerop (getf exit :exit-code))))
                (fail :gate-nonzero-exit))
              (dolist (key '(:gate-pid :gate-start))
                (when (and (getf launch key) (getf exit key)
                           (not (equal (getf launch key) (getf exit key))))
                  (fail :gate-exit-identity)))
              ;; These independent observations still matter without a raw receipt.
              (dolist (relative '("launch-request.sexp" "recorder/area-request.sexp"))
                (let ((path (concatenate 'string root relative)))
                  (if (not (present-p path)) (missing (list :missing-request relative))
                      (when (and (getf launch :area-request-sha256)
                                 (not (equal (digest path) (getf launch :area-request-sha256))))
                        (fail (list :request-hash relative))))))
              (let ((path (concatenate 'string root "launch-receipt.txt")))
                (if (not (present-p path)) (missing :missing-launch-receipt)
                    (unless (equal (vttest-cursor-driver::text path)
                                   (format nil "~a~%" (cleanup-artifacts root)))
                      (fail :launch-receipt-artifacts))))
              (if (null (second evidence)) (missing :missing-cleanup-receipt)
                  (progn
                    ;; Collect omissions without interrupting checks of supplied facts.
                    (let ((*cleanup-omissions* nil))
                      (validate-raw-cleanup raw backend)
                      (when *cleanup-omissions* (missing :missing-cleanup-fields))
                      (setf projection (cleanup-projection raw (second evidence))))
                    (let ((binding (getf raw :launch)))
                      (dolist (key '(:gate-pid :gate-start :title :artifacts :area-request-sha256))
                        (when (and (getf launch key) (getf binding key)
                                   (not (equal (getf launch key) (getf binding key))))
                          (fail (list :launch-mismatch key)))))
                    (let ((waits (classify-raw-cleanup raw backend #'fail #'missing)))
                      (when waits (push (list :first-waits waits) reasons)))))))
        (cleanup-missing () (missing :missing-cleanup-evidence))
        (error () (fail :malformed-cleanup-evidence)))
      (when *cleanup-omissions* (missing :missing-cleanup-evidence))
      (values (cond (failed :fail) (unknown :unverified) (t :pass))
              (subseq (reverse reasons) 0 (min 16 (length reasons))) projection))))
