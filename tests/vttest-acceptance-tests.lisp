;;;; Offline fixtures, confined to this implementation's new evidence root.
(load (merge-pathnames "vttest-acceptance.lisp" *load-truename*))
(in-package #:vttest-acceptance)
(defparameter *checks* 0)
(defun check (truth name)
  (unless truth (error "FAILED: ~a" name))
  (incf *checks*) (format t "PASS ~a~%" name))
(defun signals-error-p (thunk)
  (handler-case (progn (funcall thunk) nil) (error () t)))
(defun fixture-text (path text)
  (with-open-file (out path :direction :output :if-exists :error :if-does-not-exist :create)
    (write-string text out)) path)
(defparameter *root*
  (merge-pathnames ".build/evidence/canonical-acceptance-implementation-20261105-a/"
                   (uiop:getcwd)))
(demand (probe-file *root*) "Create the documented exclusive implementation evidence root first")
(defparameter *fixtures*
  (merge-pathnames (format nil "fixtures-~d-~d/" (get-universal-time) (random 1000000)) *root*))
(demand (not (probe-file *fixtures*)) "Fixture directory collision")
(ensure-directories-exist *fixtures*)
(defparameter *ref* (evidence (fixture-text (merge-pathnames "observations.txt" *fixtures*) "fixture evidence, not pixel inspection")))
(defun fixture-check (id scope backend &optional (result :pass))
  (list :id id :scope scope :backend backend :result result
        :method (if (eq scope :static-visual)
                    (list :kind :child-delegated-visual :description "Fixture child observation"
                          :child-id "fixture-child" :result-reference (copy-tree *ref*)
                          :delegation "Child-delegated pixel inspection; fixture data only")
                    (list :kind (if (eq scope :mechanical) :mechanical :independent-review)
                          :description "Offline fixture"))
        :evidence (list (copy-tree *ref*)) :unavailable nil :limits '("Static evidence does not establish blink timing")))
(defun acceptance-fixture (&optional (visual-result :pass))
  (list :schema-version 1 :kind :acceptance :mission-id "fixture-mission" :attempt-id "fixture-attempt"
        :source-commit (make-string 40 :initial-element #\a) :source-tree (make-string 40 :initial-element #\b)
        :required-checks '("mx" "vx" "mw" "vw")
        :checks (list (fixture-check "mx" :mechanical :x11) (fixture-check "vx" :static-visual :x11 visual-result)
                      (fixture-check "mw" :mechanical :wayland) (fixture-check "vw" :static-visual :wayland))
        :open-defects nil :result (if (eq visual-result :pass) :pass
                                     (if (eq visual-result :fail) :fail :unverified)) :prior-attempts nil))
(defun bad-record (name mutation)
  (let ((record (acceptance-fixture)))
    (funcall mutation record)
    (check (signals-error-p (lambda () (validate-record record))) name)))

(check (eq :pass (getf (validate-record (acceptance-fixture)) :result)) "complete required coverage passes")
(check (eq :fail (getf (validate-record (acceptance-fixture :fail)) :result)) "mechanical PASS plus visual FAIL is FAIL")
(check (eq :unverified (getf (validate-record (acceptance-fixture :unverified)) :result)) "UNVERIFIED prevents PASS")
(check (eq :unverified (getf (validate-record (acceptance-fixture :deferred)) :result)) "required DEFERRED prevents PASS")
(let ((record (acceptance-fixture)))
  (setf (getf record :open-defects) '((:id "diagnostic" :blocking nil :status :deferred :description "Explicit nonblocking diagnostic")))
  (check (eq :pass (getf (validate-record record) :result)) "nonblocking deferred diagnostic does not block")
  (setf (getf (first (getf record :open-defects)) :blocking) t)
  (check (signals-error-p (lambda () (validate-record record))) "blocking defect rejects overall PASS")
  (setf (getf record :result) :fail)
  (check (eq :fail (getf (validate-record record) :result)) "blocking defect conservatively aggregates FAIL"))
(bad-record "duplicate ID" (lambda (r) (setf (getf (second (getf r :checks)) :id) "mx")))
(bad-record "unknown result" (lambda (r) (setf (getf (first (getf r :checks)) :result) :green)))
(bad-record "missing required check" (lambda (r) (pop (getf r :checks))))
(bad-record "empty required checks" (lambda (r) (setf (getf r :required-checks) nil)))
(bad-record "missing required backend coverage" (lambda (r) (setf (getf r :required-checks) '("mx" "vx" "mw"))))
(bad-record "unknown schema property" (lambda (r) (nconc r (list :invented t))))
(bad-record "malformed plist" (lambda (r) (setf (getf (first (getf r :checks)) :method) '(:kind))))
(bad-record "duplicate property" (lambda (r) (setf (getf r :checks) (list* (append (first (getf r :checks)) '(:result :pass)) (rest (getf r :checks))))))
(bad-record "text review is not pixel inspection" (lambda (r) (setf (getf (getf (second (getf r :checks)) :method) :kind) :text-review)))
(bad-record "missing child identity" (lambda (r) (setf (getf (getf (second (getf r :checks)) :method) :child-id) nil)))
(bad-record "missing delegation disclosure" (lambda (r) (setf (getf (getf (second (getf r :checks)) :method) :delegation) nil)))
(bad-record "evidence hash mismatch" (lambda (r) (setf (getf (first (getf (first (getf r :checks)) :evidence)) :sha256) (make-string 64 :initial-element #\0))))
(bad-record "evidence missing" (lambda (r) (setf (getf (first (getf (first (getf r :checks)) :evidence)) :path) (namestring (merge-pathnames "absent" *fixtures*)))))
(bad-record "PASS without evidence" (lambda (r) (setf (getf (first (getf r :checks)) :evidence) nil)))
(bad-record "declared aggregation mismatch" (lambda (r) (setf (getf r :result) :fail)))
(let ((r (acceptance-fixture)))
  (setf (getf r :checks) (append (getf r :checks) (list (fixture-check "blink-x" :static-visual :x11 :unverified)))
        (getf r :required-checks) (append (getf r :required-checks) '("blink-x"))
        (getf r :result) :unverified)
  (check (eq :unverified (getf (validate-record r) :result)) "same-image qualified PASS does not promote another UNVERIFIED criterion"))
(let* ((r (acceptance-fixture :unverified)) (c (second (getf r :checks))))
  (setf (getf c :method) '(:kind :not-run :description "Not run")
        (getf c :evidence) nil (getf c :unavailable) "No pixels captured for this fixture")
  (check (eq :unverified (getf (validate-record r) :result)) "unrun visual evidence is explicitly unavailable")
  (setf (getf c :unavailable) nil)
  (check (signals-error-p (lambda () (validate-record r))) "unavailable evidence needs a reason"))
(defparameter *reader-effect* nil)
(dolist (text '("#.(progn (setf vttest-acceptance::*reader-effect* t) nil)" "(:kind :acceptance) (:extra t)" "(:kind" ""))
  (let ((path (merge-pathnames (format nil "bad-reader-~d.sexp" *checks*) *fixtures*)))
    (fixture-text path text)
    (check (signals-error-p (lambda () (read-record path))) "unsafe/trailing/truncated/empty input rejected")))
(check (null *reader-effect*) "read-time payload had no effect")
(check (signals-error-p (lambda () (validate-record (list* :kind :acceptance :broken)))) "dotted top-level plist rejected")

(let* ((r (acceptance-fixture :fail))
       (old (write-candidate (merge-pathnames "old/" *fixtures*) r))
       (current (copy-tree r)))
  (setf (getf current :prior-attempts) (list (evidence old))
        (getf current :open-defects) '((:id "bug-erase" :blocking t :status :open :description "Restoration failed")))
  (let* ((candidate (write-candidate (merge-pathnames "candidate/" *fixtures*) current))
         (review (list :schema-version 1 :kind :final-review :mission-id "fixture-mission" :attempt-id "fixture-attempt"
                       :source-commit (getf current :source-commit) :source-tree (getf current :source-tree)
                       :required-checks '("review") :checks (list (fixture-check "review" :independent-review nil))
                       :open-defects nil :result :pass :acceptance (evidence candidate)
                       :reviewer "independent-fixture-reviewer" :findings '("Confirmed acceptance FAIL") :disposition :fail))
         (canonical (merge-pathnames "canonical/" *fixtures*)))
    (check (equal current (read-record candidate)) "roundtrip retains methods limits defects and prior FAIL refs")
    (check (string= (record-text current) (record-text (read-record candidate))) "deterministic readable roundtrip")
    (check (eq :fail (getf (read-record (getf (first (getf current :prior-attempts)) :path)) :result)) "prior-attempt FAIL history retained")
    (check (signals-error-p (lambda () (write-candidate (uiop:pathname-directory-pathname candidate) current))) "candidate directory collision rejected")
    (check (eq :incomplete (pair-status (uiop:pathname-directory-pathname candidate))) "missing review is INCOMPLETE")
    (check (eq :pass (getf (validate-record review) :result)) "independent review process PASS can report acceptance FAIL")
    (let ((wrong (copy-tree review)))
      (setf (getf wrong :disposition) :pass)
      (check (signals-error-p (lambda () (validate-record wrong))) "review cannot greenwash acceptance FAIL"))
    (let ((wrong (copy-tree review)))
      (setf (getf (getf wrong :acceptance) :sha256) (make-string 64 :initial-element #\0))
      (check (signals-error-p (lambda () (validate-record wrong))) "review exact acceptance hash mismatch rejected"))
    (let ((wrong (copy-tree review)))
      (setf (getf wrong :attempt-id) "different")
      (check (signals-error-p (lambda () (validate-record wrong))) "review attempt identity mismatch rejected"))
    (publish-review candidate review canonical)
    (check (eq :complete (pair-status canonical)) "published pair readback complete")
    (check (string= (sha256 candidate) (sha256 (merge-pathnames "ACCEPTANCE.sexp" canonical))) "publication copies exact acceptance bytes")
    (check (string= (sha256 (merge-pathnames "FINAL-REVIEW.sexp" (uiop:pathname-directory-pathname candidate)))
                    (sha256 (merge-pathnames "FINAL-REVIEW.sexp" canonical))) "publication copies exact review bytes")
    (check (signals-error-p (lambda () (publish-review candidate review canonical))) "existing canonical pair never silently overwritten")
    ;; A second immutable attempt exercises explicit preservation before replacement.
    (let* ((next (copy-tree current))
           (next-dir (merge-pathnames "candidate2/" *fixtures*)))
      (setf (getf next :attempt-id) "fixture-attempt-2")
      (let* ((next-path (write-candidate next-dir next)) (next-review (copy-tree review))
             (preserved (merge-pathnames "preserved/" *fixtures*)))
        (setf (getf next-review :attempt-id) "fixture-attempt-2"
              (getf next-review :acceptance) (evidence next-path))
        (publish-review next-path next-review canonical :replace-existing t :preserve-directory preserved)
        (check (string= (sha256 candidate) (sha256 (merge-pathnames "ACCEPTANCE.sexp" preserved))) "replacement preserves previous acceptance exact bytes")
        (check (eq :complete (pair-status preserved)) "preserved prior pair validates")
        (check (eq :complete (pair-status canonical)) "replacement pair validates")
        (fixture-text (merge-pathnames "changed.txt" *fixtures*) "changed bytes")
        ;; Corrupt only fixture publication; original candidate and history are untouched.
        (with-open-file (out (merge-pathnames "ACCEPTANCE.sexp" canonical) :direction :output :if-exists :append)
          (terpri out))
        (check (eq :incomplete (pair-status canonical)) "even whitespace byte changes make pair INCOMPLETE")))))
(format t "~d checks passed; fixtures: ~a~%" *checks* *fixtures*)
