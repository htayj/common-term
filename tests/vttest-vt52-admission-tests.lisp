;;;; Synthetic admission tests.
(load (merge-pathnames "vttest-vt52-admission.lisp" *load-truename*))
(defpackage #:vttest-vt52-admission-tests
  (:use #:cl #:vttest-vt52-admission)
  (:export #:fixture #:run-tests))
(in-package #:vttest-vt52-admission-tests)
(defun octets (s) (sb-ext:string-to-octets s :external-format :utf-8))
(defun encode (form)
  (with-standard-io-syntax (octets (write-to-string form :pretty nil :readably nil))))
(defun digest (bytes) (vttest-vt52-sha256:sha256-hex bytes))
(defun fixture (&key (backend :x11) (scale 1))
  (let* ((wayland (eq backend :wayland)) (surface (if wayland 7 nil))
         (ack (if wayland 100 -1)) (node (if wayland 23 7))
         (geometry (list :phase :settled :request-id 1 :display-epoch 1 :epoch 1
           :actual-width 640 :actual-height 384 :cell-width 8 :cell-height 16
           :presentation 1 :target-presentation 1 :rows 24 :columns 80 :window-id 7
           :frame-pending-p nil :commit-generation 1 :frame-generation 1))
         (status (list :id 5 :child-pid 9 :frames 3 :bytes-received 100 :blink-phase t
           :blink-visible nil :input-pending 0 :error-count 0 :process-state :running
           :transport-state :open :backend backend :rows 24 :columns 80
           :pty-rows 24 :pty-columns 80 :geometry geometry))
         (before (copy-tree status))
         (native (list :version 3 :backend backend :pause 2 :owned t :custody t
           :capture-count 1 :capture-exit 0 :scale scale :window-id node
           :native-window-id node :width 640 :height 384 :png "pause-02-actual.png"
           :surface-id surface :ack-output ack :ack-basis :recorder-request-binding))
         (nr (copy-tree native))
         (raw (list :pause 2 :before nil :ready (encode status)
           :request (octets (format nil "2 7 640 384 ~d 100 ~d~%" scale ack))
           :request-sexp (encode (list :pause 2 :backend backend :target 100
              :surface-id surface :ack-output ack :executable "/fixture/lispterm"
              :status status))
           :native-ready nil :pre (encode status) :final (encode status)
           :native (encode native))))
    (setf (getf before :frames) 2 (getf nr :custody) nil (getf nr :capture-count) 0
          (getf raw :before) (encode before) (getf raw :native-ready) (encode nr))
    (labels ((hash-of (key) (digest (getf raw key))))
      (setf (getf raw :control)
        (encode
          (list (list :seq 1 :kind :pre-written :sha256 (hash-of :pre))
            (list :seq 2 :kind :cursor-sample :when :before-authorization
              :row 12 :col 14 :visible t :linked-sha256 (hash-of :pre))
            (list :seq 3 :kind :authorize :request-sha256 (hash-of :request)
              :request-sexp-sha256 (hash-of :request-sexp)
              :native-ready-sha256 (hash-of :native-ready))
            (list :seq 4 :kind :done :native-sha256 (hash-of :native))
            (list :seq 5 :kind :final-written :sha256 (hash-of :final))
            (list :seq 6 :kind :cursor-sample :when :after-done
              :row 12 :col 14 :visible t :linked-sha256 (hash-of :final))))))
    raw))
(defun revise (raw key function)
  (let ((*read-eval* nil))
    (setf (getf raw key) (encode
      (funcall function (read-from-string
        (sb-ext:octets-to-string (getf raw key) :external-format :utf-8))))))
  (unless (eq key :control)
    (revise raw :control (lambda (events)
      (loop for file in '(:pre :pre :request :request-sexp :native-ready :native :final :final)
            for i in '(0 1 2 2 2 3 4 5)
            for k in '(:sha256 :linked-sha256 :request-sha256 :request-sexp-sha256
               :native-ready-sha256 :native-sha256 :sha256 :linked-sha256)
            when (eq file key) do (setf (getf (nth i events) k) (digest (getf raw key))))
      events)))
  raw)
(defun refused (raw)
  (handler-case
    (multiple-value-bind (a reasons) (apply #'admit-vt52-capture raw)
      (and (null a) (consp reasons) (<= (length reasons) 16)))
    (serious-condition () nil)))
(defun run-tests ()
  (let ((checks 0) (failures nil))
    (labels ((check (name ok) (incf checks) (unless ok (push name failures)))
             (bad-field (backend record key value)
               (let ((raw (fixture :backend backend)))
                 (revise raw record
                    (lambda (p) (setf (getf p key) value) p))
                 (check (list backend record key value) (refused raw)))))
      (dolist (backend '(:x11 :wayland))
        (dolist (scale '(1 2))
          (let ((raw (fixture :backend backend :scale scale)))
            (multiple-value-bind (a reasons) (apply #'admit-vt52-capture raw)
              (check (list :positive backend scale)
                (and (admission-p a) (null reasons) (= scale (admission-scale a))
                     (= (length (admission-hashes a)) 18)))))))
      (dolist (key '(:before :ready :request :request-sexp :native-ready :pre :final :native :control))
        (dolist (value (list nil "not bytes" (make-array 8193 :element-type '(unsigned-byte 8))))
          (let ((raw (fixture))) (setf (getf raw key) value)
            (check (list :input key (type-of value)) (refused raw)))))
      (dolist (wire (list (format nil "2 7 640 384 1 100 -1 8~%")
                 (format nil "02 7 640 384 1 100 -1~%")
                 "2 7 640 384 1 100 -1"
                 (format nil "2 7 640 384 1 100.0 -1~%")))
        (let ((raw (fixture))) (setf (getf raw :request) (octets wire))
          (check :wire (refused raw))))
      (let ((raw (fixture)))
        (setf (getf raw :request) (octets (format nil "2 7 639 384 1 100 -1~%")))
        (check :geometry (refused raw)))
      (bad-field :x11 :request-sexp :target 101)
      (bad-field :x11 :request-sexp :ack-output 0)
      (bad-field :x11 :request-sexp :surface-id -1)
      (bad-field :wayland :request-sexp :surface-id 8)
      (bad-field :x11 :ready :bytes-received 101)
      (dolist (backend '(:x11 :wayland))
        (dolist (record '(:native-ready :native))
          (dolist (pair '((:surface-id 99) (:ack-output 99) (:native-window-id 99)
                 (:owned nil) (:custody :wrong) (:capture-count 2)
                 (:ack-basis :independent) (:width 639)))
            (bad-field backend record (first pair) (second pair)))))
      (let ((raw (fixture :backend :wayland)))
        (setf (getf raw :request) (octets (format nil "2 7 640 384 1 100 99~%")))
        (revise raw :request-sexp (lambda (p) (setf (getf p :ack-output) 99) p))
        (check :ack-below-target (refused raw)))
      (dolist (key '(:pre :final))
        (let* ((raw (fixture)) (bytes (getf raw key)))
          (setf (getf raw key) (concatenate '(vector (unsigned-byte 8)) bytes #(32)))
          (check (list :changed-byte key) (refused raw))))
      (dolist (mutation
        (list (lambda (p) (setf (getf (first p) :sha256) (make-string 64 :initial-element #\0)) p)
          (lambda (p) (setf (getf (third p) :seq) 4) p)
          (lambda (p) (setf (getf (fourth p) :kind) :authorize) p)
          (lambda (p) (rotatef (third p) (fourth p)) p)
          (lambda (p) (append p (list (copy-list (sixth p)))))))
        (let ((raw (fixture))) (revise raw :control mutation)
          (check :trace (refused raw))))
      (dolist (i '(1 5))
        (dolist (pair '((:row 11) (:col 15) (:visible nil)))
          (let ((raw (fixture)))
            (revise raw :control (lambda (p)
              (setf (getf (nth i p) (first pair)) (second pair)) p))
            (check (list :cursor i pair) (refused raw)))))
      (dolist (s '("(:frames 3 :frames 3)" "(:frames . 3)" "(:frames 3) ()"
               "#.(error \"reader-eval\")" "#999999999999999999999()"))
        (let ((raw (fixture))) (setf (getf raw :pre) (octets s))
          (check :reader (refused raw))))
      (let ((raw (fixture)))
        (setf (getf raw :pre) (make-array 2 :element-type '(unsigned-byte 8)
                 :initial-contents '(192 175)))
        (check :utf8 (refused raw))))
    (format t "~d checks, ~d failures~%" checks (length failures))
    (dolist (f (reverse failures)) (format t "FAIL ~s~%" f))
    (when failures (error "Admission synthetic suite failed"))
    checks))
