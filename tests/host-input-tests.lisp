;;;; Input FIFO tests, including a real raw slave that initially refuses to read.
(defpackage #:lispterm.input.tests (:use #:cl) (:export #:run-tests))
(in-package #:lispterm.input.tests)
(defvar *checks* 0)
(defun check (name value)
  (incf *checks*)
  (format t "~&(:input-check ~S :pass ~S)~%" name (not (null value)))
  (unless value (error "Input check failed: ~S" name)))
(defun raises (type thunk)
  (handler-case (progn (funcall thunk) nil)
    (error (condition) (if (typep condition type) condition (error condition)))))
(defun until (predicate &optional (timeout 10))
  (let ((deadline (+ (get-internal-real-time) (* timeout internal-time-units-per-second))))
    (loop when (funcall predicate) return t
          when (> (get-internal-real-time) deadline) do (error "Input test timed out")
          do (sleep .005))))
(defun elapsed (thunk)
  (let ((start (get-internal-real-time)))
    (funcall thunk)
    (/ (- (get-internal-real-time) start) internal-time-units-per-second)))
(defun octets (text) (lispterm::utf8 text))
(defun pending (session)
  (sb-thread:with-mutex ((lispterm::session-input-lock session))
    (lispterm::session-input-pending session)))
(defun mock-partials ()
  (let* ((session (lispterm::make-session nil 24 80))
         (original (symbol-function 'lispterm.pty:pty-write))
         (accepted (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0))
         (steps '(0 1 2 0 1 3 1 4)) (calls 0))
    (unwind-protect
         (progn
           (setf (symbol-function 'lispterm.pty:pty-write)
                 (lambda (pty bytes &key timeout)
                   (declare (ignore pty))
                   (check :nonblocking-chunk (and (= timeout 0) (<= (length bytes) 4096)))
                   (incf calls)
                   (let ((n (min (length bytes) (or (pop steps) 3))))
                     (dotimes (i n) (vector-push-extend (aref bytes i) accepted)) n)))
           (let ((source (octets "abcdef")))
             (lispterm::session-write session source)
             (setf (aref source 0) 90))
           (lispterm::session-event session (ltd:make-paste-event :text "PASTE"))
           (setf (nerimux/terminal:screen-response-queue (lispterm::session-screen session))
                 '("R2" "R1"))
           (lispterm::session-queue-responses session)
           (lispterm::session-write session (octets "TAIL"))
           (loop repeat 100 while (plusp (pending session)) do (lispterm::session-flush-input session))
           (check :partial-fifo-and-private-copy
                  (equalp accepted (octets "abcdefPASTER1R2TAIL")))
           (check :partial-queue-empty (and (zerop (pending session)) (> calls 3)))
           ;; A response batch that cannot fit retains engine ownership and blocks
           ;; later input rather than being dropped or overtaken.
           (let ((lispterm::*input-queue-limit* 8))
             (lispterm::session-write session (octets "12345678"))
             (let ((screen (lispterm::session-screen session)))
               (setf (nerimux/terminal:screen-response-queue screen) '("AB"))
               (check :response-backpressure (not (lispterm::session-queue-responses session)))
               (check :response-retained (equal '("AB") (nerimux/terminal:screen-response-queue screen)))
               (check :overflow-explicit
                      (raises 'lispterm::input-backpressure
                              (lambda () (lispterm::session-write session (octets "X")))))
               (check :overflow-no-enqueue (= 8 (pending session)))
               (loop while (plusp (pending session)) do (lispterm::session-flush-input session))
               (check :response-retry (lispterm::session-queue-responses session))
               (check :response-enqueued (= 2 (pending session))))))
      (setf (symbol-function 'lispterm.pty:pty-write) original))))
(defun touch (path)
  (with-open-file (out path :direction :output :if-exists :supersede) (write-line "go" out)))
(defun detached-host (argv)
  (let* ((pty (lispterm.pty:open-pty))
         (host (lispterm::%make-host :id -54 :session (lispterm::make-session pty 24 80))))
    (handler-case
        (progn (lispterm.pty:spawn-on-pty pty argv) (lispterm::start-window-worker host) host)
      (error (condition) (lispterm.pty:close-pty pty) (error condition)))))
(defun received (host)
  (getf (lispterm:status host) :bytes-received))
(defun close-test-host (host)
  (handler-case (lispterm:close host) (lispterm::input-cancelled () nil)))
(defun real-fifo (directory)
  (let* ((release (merge-pathnames "release" directory))
         (query (merge-pathnames "query" directory))
         (result (merge-pathnames "input.bin" directory))
         (payload (make-array 65536 :element-type '(unsigned-byte 8)))
         (query-text (format nil "~c[6n~c[c" #\Esc #\Esc))
         (screen (lispterm.engine:make-screen :rows 24 :columns 80))
         (paste (octets "PASTE")) (tail (octets "TAIL")))
    (dotimes (i (length payload)) (setf (aref payload i) (+ 33 (mod i 90))))
    (lispterm.engine:feed screen (octets "READY"))
    (lispterm.engine:feed screen (octets query-text))
    (let* ((response (octets (format nil "~{~a~}" (reverse (nerimux/terminal:screen-response-queue screen)))))
           (expected (concatenate '(vector (unsigned-byte 8)) payload paste response tail))
           (command (format nil "stty raw -echo; printf READY; while ! test -e ~A; do sleep .01; done; printf '\\033[6n\\033[c'; while ! test -e ~A; do sleep .01; done; dd bs=~D count=1 iflag=fullblock of=~A status=none; printf DONE; sleep 10"
                            (uiop:escape-sh-token (namestring query))
                            (uiop:escape-sh-token (namestring release)) (length expected)
                            (uiop:escape-sh-token (namestring result))))
           (host (detached-host (list "sh" "-c" command)))
           (session (lispterm::host-session host)))
      (unwind-protect
           (progn
             (until (lambda () (>= (received host) 5)))
             (check :64k-accepted-promptly (< (elapsed (lambda () (lispterm:send-input host payload))) .5))
             (lispterm::call-host host :event (ltd:make-paste-event :text "PASTE"))
             ;; No reader yet: force a real full kernel input buffer.
             (sleep .15)
             (check :real-kernel-backpressure (plusp (pending session)))
             (let ((before (received host)))
               (touch query)
               (until (lambda () (> (received host) before))))
             (lispterm:send-input host "TAIL")
             (let ((token nil) (count 0))
               (check :quiesce-responsive
                      (< (elapsed (lambda () (setf token (lispterm:quiesce host)))) .5))
               (setf count (pending session))
               (check :quiesce-preserves-suffix (plusp count))
               (sleep .03)
               (check :quiesced-queue-stable (= count (pending session)))
               (check :quiesced-input-rejected
                      (raises 'lispterm::host-error (lambda () (lispterm:send-input host "NO"))))
               (lispterm:resume host token))
             (touch release)
             (until (lambda () (and (probe-file result)
                                    (= (length expected) (with-open-file (in result :element-type '(unsigned-byte 8))
                                                           (file-length in))))))
             (until (lambda () (zerop (pending session))))
             (let ((actual (make-array (length expected) :element-type '(unsigned-byte 8))))
               (with-open-file (in result :element-type '(unsigned-byte 8)) (read-sequence actual in))
               (check :real-64k-paste-responses-tail-exact (equalp expected actual)))
             (check :fifo-no-host-errors (null (lispterm:host-errors host))))
        (close-test-host host)))))
(defun real-overflow-and-close ()
  (let* ((host (detached-host '("sh" "-c" "stty raw -echo; printf READY; sleep 20")))
         (session (lispterm::host-session host))
         (block (make-array 65536 :element-type '(unsigned-byte 8) :initial-element 65)))
    (unwind-protect
         (progn
           (until (lambda () (>= (received host) 5)))
           (loop repeat 4 do (lispterm:send-input host block))
           (let ((before (pending session)))
             (check :bounded-real-overflow
                    (raises 'lispterm::input-backpressure (lambda () (lispterm:send-input host block))))
             (check :bounded-queue (<= (pending session) before lispterm::*input-queue-limit*)))
           (let ((condition nil))
             (check :close-responsive
                    (< (elapsed (lambda ()
                                  (setf condition
                                        (raises 'lispterm::input-cancelled (lambda () (lispterm:close host)))))) 2))
             (check :close-cancellation-explicit
                    (and condition (plusp (lispterm::input-cancelled-bytes condition))))
             (check :closed-after-cancellation (eq :closed (getf (lispterm:status host) :state)))
             (check :close-cancellation-recorded (find :input-cancelled (lispterm:host-errors host)
                                                      :key (lambda (entry) (getf entry :operation))))
             (check :close-idempotent (eq host (lispterm:close host)))))
      (close-test-host host))))
(defun zero-timeout ()
  (let* ((pty (lispterm.pty:open-pty))
         (slave (sb-posix:open (lispterm.pty:pty-slave-name pty) (logior sb-posix:o-rdwr sb-posix:o-noctty)))
         (bytes (make-array 65536 :element-type '(unsigned-byte 8) :initial-element 65)))
    (unwind-protect
         (progn
           (dolist (bad '(-1 3601 nil "0"))
             (check :timeout-validation
                    (raises 'type-error (lambda () (lispterm.pty:pty-write pty bytes :timeout bad)))))
           (let ((count 0))
             (check :zero-timeout-bounded
                    (< (elapsed (lambda () (setf count (lispterm.pty:pty-write pty bytes :timeout 0)))) .2))
             (check :zero-timeout-prefix (< 0 count 65536))))
      (sb-posix:close slave) (lispterm.pty:close-pty pty))))
(defun zero-timeout-syscalls ()
  (let ((pty (lispterm.pty:open-pty))
        (poller (symbol-function 'lispterm.pty::%poll))
        (writer (symbol-function 'lispterm.pty::%write))
        (bytes (octets "abcdef")))
    (unwind-protect
         (progn
           (setf (symbol-function 'lispterm.pty::%poll)
                 (lambda (&rest ignored) (declare (ignore ignored)) 1))
           (dolist (errno (list sb-posix:eintr sb-posix:eagain))
             (let ((calls 0))
               (setf (symbol-function 'lispterm.pty::%write)
                     (lambda (&rest ignored)
                       (declare (ignore ignored)) (incf calls)
                       (setf (cffi:mem-ref (lispterm.pty::%errno-location) :int) errno) -1))
               (check :zero-interrupted-write-prefix (= 0 (lispterm.pty:pty-write pty bytes :timeout 0)))
               (check :zero-interrupted-write-single-attempt (= 1 calls))))
           (let ((calls 0))
             (setf (symbol-function 'lispterm.pty::%write)
                   (lambda (&rest ignored) (declare (ignore ignored)) (incf calls) 3))
             (check :zero-short-write-prefix (= 3 (lispterm.pty:pty-write pty bytes :timeout 0)))
             (check :zero-short-write-single-attempt (= 1 calls)))
           (let ((calls 0))
             (setf (symbol-function 'lispterm.pty::%poll)
                   (lambda (&rest ignored)
                     (declare (ignore ignored)) (incf calls)
                     (setf (cffi:mem-ref (lispterm.pty::%errno-location) :int) sb-posix:eintr) -1))
             (check :zero-interrupted-poll-prefix (= 0 (lispterm.pty:pty-write pty bytes :timeout 0)))
             (check :zero-interrupted-poll-single-attempt (= 1 calls))))
      (setf (symbol-function 'lispterm.pty::%poll) poller
            (symbol-function 'lispterm.pty::%write) writer)
      (lispterm.pty:close-pty pty))))
(defun terminal-key-modes ()
  "Exercise parser keypad/reset state and the session's three-flag snapshot."
  ;; VT52 parser selection is a separate batch. Set its agreed boolean directly
  ;; here to test input wiring, while feeding real ESC=/ESC>/RIS commands.
  (dolist (case '((nil nil "" :kp1 (49))
                  (nil nil "=" :kp1 (27 79 113))
                  (nil nil "=>" :kp1 (49))
                  (t nil "" :up (27 65))
                  (t nil "=" :kp-enter (27 63 77))
                  (t nil "=>" :kp-period (46))
                  (nil t "" :up (27 79 65))
                  (t t "" :up (27 65))
                  (nil nil "=c" :kp1 (49))
                  (t nil "=c" :up (27 91 65))))
    (destructuring-bind (vt52 app-cursor commands key expected) case
      (let* ((session (lispterm::make-session nil 24 80))
             (screen (lispterm::session-screen session)))
        (setf (nerimux/terminal:screen-vt52-mode screen) vt52
              (nerimux/terminal:screen-app-cursor-keys screen) app-cursor)
        (loop for command across commands
              do (lispterm.engine:feed screen (octets (format nil "~c~c" #\Esc command))))
        (lispterm::session-event session (ltd:make-key-event :key key))
        (check (list :session-key-mode vt52 app-cursor commands key)
               (equalp (coerce expected '(vector (unsigned-byte 8)))
                       (car (lispterm::session-input-head session)))))))
  (terminal-key-reset))

(defun terminal-key-reset ()
  "Enable actual application modes, then require RIS to restore numeric input."
  (let* ((session (lispterm::make-session nil 24 80))
         (screen (lispterm::session-screen session)))
    (flet ((feed (suffix) (lispterm.engine:feed screen (octets (format nil "~c~a" #\Esc suffix))))
           (queued () (apply #'concatenate '(vector (unsigned-byte 8))
                             (lispterm::session-input-head session))))
      (feed "[?1h") (feed "=")
      (check :parser-application-flags
             (and (nerimux/terminal:screen-app-cursor-keys screen)
                  (nerimux/terminal:screen-app-keypad screen)))
      (lispterm::session-event session (ltd:make-key-event :key :up))
      (lispterm::session-event session (ltd:make-key-event :key :kp1))
      (check :session-application-input (equalp #(27 79 65 27 79 113) (queued)))
      (feed ">")
      (check :parser-numeric-keypad (not (nerimux/terminal:screen-app-keypad screen)))
      (feed "=") (feed "c")
      ;; Compare newly appended bytes after the first two input events.
      (lispterm::session-event session (ltd:make-key-event :key :up))
      (lispterm::session-event session (ltd:make-key-event :key :kp1))
      (let ((after (subseq (queued) 6)))
        (format t "~&(:ris-input :expected #(27 91 65 49) :actual ~S)~%" after)
        (check :session-ris-restores-normal-input (equalp #(27 91 65 49) after)))
      (check :parser-ris-input-flags
             (and (not (nerimux/terminal:screen-app-cursor-keys screen))
                  (not (nerimux/terminal:screen-app-keypad screen))
                  (not (nerimux/terminal:screen-vt52-mode screen)))))))
(defun run-tests ()
  (setf *checks* 0)
  (let ((directory (merge-pathnames (format nil ".build/evidence/input54-~D-~D/" (get-universal-time) (sb-posix:getpid))
                                   (uiop:getcwd))))
    (ensure-directories-exist directory)
    (terminal-key-modes)
    (mock-partials)
    (zero-timeout)
    (zero-timeout-syscalls)
    (real-fifo directory)
    (real-overflow-and-close)
    (format t "~&(:host-input-checks ~D :passed T :artifacts ~S)~%" *checks* (namestring directory))))
