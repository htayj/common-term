;;;; Pure public provenance admission using actual declaration paths and file hashes.
(load (merge-pathnames "vttest-vt52-native-provenance.lisp" *load-truename*))
(load (merge-pathnames "vttest-vt52-source-input-test-support.lisp" *load-truename*))
(defpackage :vttest-vt52-source-pin-tests
  (:use :cl :vttest-vt52-native-io) (:export :run-tests :manifest))
(in-package :vttest-vt52-source-pin-tests)
(defvar *checks* 0)
(defun check (x) (incf *checks*) (assert x))
(defun refuses (fn) (check (handler-case (progn (funcall fn) nil) (error () t))))
(defun row (p)
  (assert (not (search "capture-transaction" p)))
  (list :path p :sha256 (digest-file
    (if (char= #\/ (char p 0)) p
        (namestring (truename (merge-pathnames p vttest-vt52-source-input-tests::*root*)))))))
(defun manifest (&optional (backend "x11") (scale 1))
  ;; Only read declarations, never evaluate the driver/area/application.
  (list :kind :vttest-area-manifest :version 1 :area "vt52-mode"
    :backend backend :scale scale :scope-status :frozen :conditions nil
    :navigation-pauses '(1 2 3) :required-count 1
    :native-driver (format nil "vt52-~a-v1" backend)
    :scenarios (list (list :id "vt52-01" :recorder-label "vt52" :menu-path '(7)
      :pauses 3 :captures '((:id "pause-02" :pause 2)) :bytes nil :timing t
      :oracle (row "tests/vttest-vt52-oracle.lisp") :requires nil))
    :pins (mapcar #'row (vttest-vt52-source-input-tests:manifest-paths))))
(defun admit (m)
  (vttest-vt52-native-root:validate-manifest m (getf m :backend) (getf m :scale)))
(defun run-tests ()
  (let* ((*checks* 0) (m (manifest)) (pins (getf m :pins)))
    (check (eq m (admit m)))
    (check (vttest-vt52-source-pins:expected-p (mapcar (lambda (p) (getf p :path)) pins)))
    (dolist (mode '(("wayland" 1) ("wayland" 2)))
      (let ((copy (copy-tree m)))
        (setf (getf copy :backend) (first mode) (getf copy :scale) (second mode)
              (getf copy :native-driver) "vt52-wayland-v1")
        (check (eq copy (admit copy)))))
    (flet ((reject-pins (rows)
             (let ((copy (copy-tree m))) (setf (getf copy :pins) rows)
               (refuses (lambda () (admit copy))))))
      ;; Coherent subset, every single omission, extras, duplicate positions, order.
      (reject-pins (list (copy-tree (first pins))))
      (dolist (p pins) (reject-pins (remove p (copy-tree pins) :test #'equal)))
      (reject-pins (append (copy-tree pins) (list (row "tests/vttest-vt52-source-input-tests.lisp"))))
      (reject-pins (append (copy-tree pins) (list (row "/nix/store/kwyi4bq5s2qgwbhz6cs4gjy57c2zdxws-bash-interactive-5.3p20/bin/bash"))))
      (reject-pins (cons (copy-tree (first pins)) (copy-tree pins)))
      (reject-pins (append (copy-tree pins) (list (copy-tree (first pins)))))
      (reject-pins (reverse (copy-tree pins)))
      (dolist (prefix (list "./" (namestring (truename vttest-vt52-source-input-tests::*root*))))
        (let ((rows (copy-tree pins)))
          (setf (getf (second rows) :path) (concatenate 'string prefix (getf (second rows) :path)))
          (reject-pins rows)))
      (let ((rows (copy-tree pins)))
        (setf (getf (second rows) :sha256) (make-string 64 :initial-element #\0))
        (reject-pins rows))
      (let ((rows (copy-tree pins)))
        (setf (getf (second rows) :path) "tests/capture-transaction.lisp")
        (reject-pins rows))
      (let ((rows (copy-tree pins)))
        (setf (getf (second rows) :unknown) t) (reject-pins rows)))
    (format t "VT52 trusted source pins PASS~D: pins=~D~%" *checks* (length pins))
    *checks*))
(run-tests)
