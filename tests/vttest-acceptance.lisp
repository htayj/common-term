;;;; Standalone v1 evidence records. No application or GUI dependency.
(require :asdf)
(defpackage #:vttest-acceptance
  (:use #:cl)
  (:export #:read-record #:validate-record #:sha256 #:evidence
           #:write-candidate #:publish-review #:pair-status #:aggregate-result))
(in-package #:vttest-acceptance)

(defun demand (truth control &rest args)
  (unless truth (apply #'error control args)))

(defun proper-list-p (value)
  (and (listp value) (handler-case (integerp (list-length value)) (type-error () nil))))

(defun plist-fields (value required optional)
  (demand (and (proper-list-p value) (evenp (length value))) "Expected a finite property list")
  (let ((keys (loop for (key val) on value by #'cddr collect key)))
    (demand (= (length keys) (length (remove-duplicates keys))) "Duplicate property")
    (dolist (key keys) (demand (member key (append required optional)) "Unknown property"))
    (dolist (key required) (demand (member key keys) "Missing property ~s" key)))
  value)

(defun text-p (value) (and (stringp value) (plusp (length value))))
(defun hex-p (value length)
  (and (stringp value) (= (length value) length)
       (every (lambda (c) (digit-char-p c 16)) value)))

(defun sha256 (path)
  (demand (and (probe-file path) (not (uiop:directory-pathname-p path))) "Missing evidence ~a" path)
  (let ((output (uiop:run-program (list "sha256sum" "--" (namestring (truename path)))
                                  :output :string)))
    (demand (and (>= (length output) 64) (hex-p (subseq output 0 64) 64)) "Invalid SHA output")
    (string-downcase (subseq output 0 64))))

(defun evidence (path)
  (list :path (namestring (truename path)) :sha256 (sha256 path)))

(defun validate-evidence (ref)
  (plist-fields ref '(:path :sha256) nil)
  (demand (and (text-p (getf ref :path)) (uiop:absolute-pathname-p (getf ref :path))
               (hex-p (getf ref :sha256) 64)) "Malformed evidence reference")
  (demand (string-equal (getf ref :sha256) (sha256 (getf ref :path)))
          "Evidence hash mismatch: ~a" (getf ref :path))
  ref)

(defun read-record (path)
  "Read exactly one data form. No read-time evaluation or custom reader macros."
  (with-open-file (in path :external-format :utf-8)
    (let* ((*read-eval* nil) (*readtable* (copy-readtable nil)) (*read-base* 10)
           (*package* (find-package :keyword)) (end (gensym))
           (form (read in nil end)))
      (demand (not (eq form end)) "Empty record")
      (demand (eq (read in nil end) end) "Trailing form")
      form)))

(defun validate-check (check)
  (plist-fields check '(:id :scope :backend :result :method :evidence :unavailable :limits) nil)
  (demand (text-p (getf check :id)) "Invalid check ID")
  (demand (member (getf check :scope) '(:mechanical :static-visual :independent-review)) "Unknown scope")
  (demand (member (getf check :backend) '(nil :x11 :wayland)) "Unknown backend")
  (demand (member (getf check :result) '(:pass :fail :unverified :deferred)) "Unknown result")
  (demand (and (proper-list-p (getf check :limits)) (every #'text-p (getf check :limits))) "Invalid limits")
  (let ((method (getf check :method)))
    (plist-fields method '(:kind :description) '(:child-id :result-reference :delegation))
    (demand (text-p (getf method :description)) "Missing method description")
    (unless (eq (getf method :kind) :child-delegated-visual)
      (plist-fields method '(:kind :description) nil))
    (cond
      ((eq (getf method :kind) :not-run)
       (demand (and (member (getf check :result) '(:unverified :deferred))
                    (null (getf check :evidence))) "Unrun method cannot claim observed evidence or PASS"))
      ((eq (getf check :scope) :static-visual)
       (demand (eq (getf method :kind) :child-delegated-visual) "Visual inspection requires disclosed child method")
       (demand (and (text-p (getf method :child-id)) (text-p (getf method :delegation))) "Missing child attribution")
       (validate-evidence (getf method :result-reference))
       (demand (member (getf method :result-reference) (getf check :evidence) :test #'equal)
               "Child result must be included in check evidence"))
      (t
       (demand (member (getf method :kind) (if (eq (getf check :scope) :mechanical)
                                             '(:mechanical :text-review) '(:independent-review)))
               "Method does not match scope"))))
  (demand (proper-list-p (getf check :evidence)) "Invalid evidence list")
  (mapc #'validate-evidence (getf check :evidence))
  (if (getf check :evidence)
      (demand (null (getf check :unavailable)) "Evidence and unavailable reason conflict")
      (demand (and (member (getf check :result) '(:unverified :deferred))
                   (text-p (getf check :unavailable))) "Missing evidence requires explicit reason and non-PASS result"))
  check)

(defun aggregate-result (record)
  "Aggregate only required checks and blocking defects; never infer observations."
  (let ((results (loop for id in (getf record :required-checks)
                       collect (getf (find id (getf record :checks) :key (lambda (c) (getf c :id)) :test #'equal) :result))))
    (cond ((or (member :fail results)
               (some (lambda (d) (getf d :blocking)) (getf record :open-defects))) :fail)
          ((or (null results) (some (lambda (r) (not (eq r :pass))) results)) :unverified)
          (t :pass))))

(defun validate-record (record)
  (demand (and (proper-list-p record) (evenp (length record))) "Malformed record property list")
  (let ((kind (getf record :kind)))
    (demand (member kind '(:acceptance :final-review)) "Unknown record kind")
    (plist-fields record
                  (append '(:schema-version :kind :mission-id :attempt-id :source-commit :source-tree
                            :required-checks :checks :open-defects :result)
                          (if (eq kind :acceptance) '(:prior-attempts)
                              '(:acceptance :reviewer :findings :disposition))) nil)
    (demand (eql (getf record :schema-version) 1) "Unknown schema version")
    (dolist (key '(:mission-id :attempt-id)) (demand (text-p (getf record key)) "Missing ~s" key))
    (dolist (key '(:source-commit :source-tree)) (demand (hex-p (getf record key) 40) "Invalid ~s" key))
    (demand (and (proper-list-p (getf record :checks)) (getf record :checks)) "Empty checks")
    (mapc #'validate-check (getf record :checks))
    (let* ((ids (mapcar (lambda (c) (getf c :id)) (getf record :checks)))
           (required (getf record :required-checks)))
      (demand (= (length ids) (length (remove-duplicates ids :test #'equal))) "Duplicate check ID")
      (demand (and (proper-list-p required) required (every #'text-p required)
                   (= (length required) (length (remove-duplicates required :test #'equal)))) "Invalid required checks")
      (dolist (id required) (demand (member id ids :test #'equal) "Missing required check ~a" id))
      (flet ((covered (scope backend)
               (some (lambda (c) (and (member (getf c :id) required :test #'equal)
                                     (eq (getf c :scope) scope) (eq (getf c :backend) backend)))
                     (getf record :checks))))
        (if (eq kind :acceptance)
            (dolist (backend '(:x11 :wayland))
              (dolist (scope '(:mechanical :static-visual))
                (demand (covered scope backend) "Missing required ~s/~s coverage" scope backend)))
            (demand (covered :independent-review nil) "Missing independent review coverage"))))
    (demand (proper-list-p (getf record :open-defects)) "Invalid defects")
    (dolist (defect (getf record :open-defects))
      (plist-fields defect '(:id :blocking :status :description) nil)
      (demand (and (text-p (getf defect :id)) (member (getf defect :blocking) '(t nil))
                   (member (getf defect :status) '(:open :deferred)) (text-p (getf defect :description))) "Invalid defect"))
    (demand (eq (getf record :result) (aggregate-result record)) "Declared result disagrees with aggregation")
    (if (eq kind :acceptance)
        (progn
          (demand (proper-list-p (getf record :prior-attempts)) "Invalid prior attempts")
          (mapc #'validate-evidence (getf record :prior-attempts)))
        (progn
          (demand (text-p (getf record :reviewer)) "Missing independent reviewer")
          (demand (and (proper-list-p (getf record :findings)) (every #'text-p (getf record :findings))) "Invalid findings")
          (validate-evidence (getf record :acceptance))
          (let ((acceptance (read-record (getf (getf record :acceptance) :path))))
            (demand (and (proper-list-p acceptance) (evenp (length acceptance))
                         (eq (getf acceptance :kind) :acceptance)) "Review target is not acceptance")
            (validate-record acceptance)
            (dolist (key '(:mission-id :attempt-id :source-commit :source-tree))
              (demand (equal (getf record key) (getf acceptance key)) "Review identity mismatch ~s" key))
            (demand (eq (getf record :disposition) (getf acceptance :result)) "Review disposition contradicts acceptance"))))
    record))

(defun record-text (record)
  (with-output-to-string (out)
    (let ((*print-readably* t) (*print-pretty* nil) (*print-circle* nil)
          (*print-base* 10) (*print-radix* nil) (*print-case* :upcase)
          (*package* (find-package :keyword)))
      (write record :stream out) (terpri out))))

(defun write-new-record (path record)
  (validate-record record)
  (with-open-file (out path :direction :output :if-exists :error :if-does-not-exist :create :external-format :utf-8)
    (write-string (record-text record) out))
  (demand (equal record (validate-record (read-record path))) "Readback mismatch")
  path)

(defun write-candidate (directory acceptance)
  "Create a new attempt directory and immutable ACCEPTANCE candidate. Never reuse a directory."
  (setf directory (uiop:ensure-directory-pathname directory))
  (demand (not (probe-file directory)) "Attempt directory already exists")
  (demand (eq (getf acceptance :kind) :acceptance) "Expected acceptance")
  (validate-record acceptance)
  (ensure-directories-exist directory)
  (write-new-record (merge-pathnames "ACCEPTANCE.sexp" directory) acceptance))

(defun pair-status (directory)
  "Return :COMPLETE only for two validated records bound to the exact acceptance bytes."
  (handler-case
      (let* ((directory (uiop:ensure-directory-pathname directory))
             (ap (merge-pathnames "ACCEPTANCE.sexp" directory))
             (fp (merge-pathnames "FINAL-REVIEW.sexp" directory))
             (a (validate-record (read-record ap))) (f (validate-record (read-record fp))))
        (demand (and (eq (getf a :kind) :acceptance) (eq (getf f :kind) :final-review)
                     (string-equal (sha256 ap) (getf (getf f :acceptance) :sha256))) "Incomplete pair")
        :complete)
    (error () :incomplete)))

(defun copy-new-bytes (source target)
  (with-open-file (in source :element-type '(unsigned-byte 8))
    (with-open-file (out target :direction :output :element-type '(unsigned-byte 8)
                         :if-exists :error :if-does-not-exist :create)
      (uiop:copy-stream-to-stream in out :element-type '(unsigned-byte 8))))
  (demand (string= (sha256 source) (sha256 target)) "Copy hash mismatch")
  target)

(defun publish-review (candidate review canonical-directory &key replace-existing preserve-directory)
  "Finalize immutable review, then publish acceptance first and final review last.
Existing canonical bytes require explicit replacement and a fresh preservation directory."
  (let* ((candidate (truename candidate))
         (attempt (uiop:pathname-directory-pathname candidate))
         (final (merge-pathnames "FINAL-REVIEW.sexp" attempt))
         (directory (uiop:ensure-directory-pathname canonical-directory))
         (ap (merge-pathnames "ACCEPTANCE.sexp" directory))
         (fp (merge-pathnames "FINAL-REVIEW.sexp" directory)))
    (validate-record review)
    (demand (eq (getf review :kind) :final-review) "Expected final review")
    (demand (equal (truename (getf (getf review :acceptance) :path)) candidate) "Review must reference exact candidate")
    (demand (not (and (probe-file directory) (equal attempt (truename directory))))
            "Candidate and canonical directories must differ")
    (demand (string= (file-namestring candidate) "ACCEPTANCE.sexp") "Expected immutable acceptance candidate filename")
    (when (or (probe-file ap) (probe-file fp))
      (demand (and replace-existing preserve-directory) "Canonical output collision: explicit preservation required")
      (setf preserve-directory (uiop:ensure-directory-pathname preserve-directory))
      (demand (not (probe-file preserve-directory)) "Preservation directory already exists")
      (ensure-directories-exist preserve-directory)
      (dolist (path (list ap fp))
        (when (probe-file path) (copy-new-bytes path (merge-pathnames (file-namestring path) preserve-directory)))))
    (write-new-record final review)
    (ensure-directories-exist directory)
    (let ((at (merge-pathnames (format nil ".acceptance-~a.tmp" (gensym)) directory))
          (ft (merge-pathnames (format nil ".review-~a.tmp" (gensym)) directory))
          (at-created nil) (ft-created nil))
      (unwind-protect
           (progn
             (copy-new-bytes candidate at) (setf at-created t)
             (validate-record (read-record at))
             (copy-new-bytes final ft) (setf ft-created t)
             (validate-record (read-record ft))
             (uiop:rename-file-overwriting-target at ap) (setf at-created nil)
             (uiop:rename-file-overwriting-target ft fp) (setf ft-created nil)
             (demand (eq (pair-status directory) :complete) "Published pair is incomplete")
             (values ap fp))
        (when at-created (delete-file at))
        (when ft-created (delete-file ft))))))
