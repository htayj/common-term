;;;; Closed one-hold character-set receipts, specialized from the screen contract.
;;;; This module has no load-time process, desktop, or application effects.
(require :sb-posix)
(load (merge-pathnames "vttest-screen-frame.lisp" *load-truename*))
(defpackage :vttest-charsets-native-contract
  (:use :cl)
  (:export :read-data :write-data :reference :validate-recorder :validate-native
           :import-recorder :publish-native :await-exit :main))
(in-package :vttest-charsets-native-contract)

(defun need (test &optional (reason "Native contract refusal"))
  (unless test (error "~a" reason)))
(defun tree (value)
  "Bound the data before traversing a plist, including reader-label cycles."
  (let ((seen (make-hash-table :test 'eq)) (nodes 0))
    (labels ((walk (x depth)
               (need (and (< (incf nodes) 65536) (< depth 128)) "Receipt too large")
               (typecase x
                 (cons (need (not (gethash x seen)) "Shared/cyclic receipt")
                       (setf (gethash x seen) t)
                       (walk (car x) (1+ depth)) (walk (cdr x) (1+ depth)))
                 (string (need (<= (length x) 65536)))
                 ((or boolean keyword integer) nil)
                 (t (error "Unsupported receipt object")))))
      (walk value 0)))
  value)
(defun properties (value allowed &optional (required allowed))
  (need (and (listp value) (evenp (length value))) "Improper properties")
  (let ((seen nil))
    (loop for key in value by #'cddr do
      (need (and (member key allowed) (not (member key seen))) "Unknown/duplicate key")
      (push key seen))
    (need (every (lambda (key) (member key seen)) required) "Missing key"))
  value)
(defun regular-file (path)
  (need (sb-posix:s-isreg (sb-posix:stat-mode (sb-posix:lstat path))) "Nonregular receipt")
  path)
(defun read-data (path)
  (regular-file path)
  (with-open-file (s path)
    (need (<= (file-length s) 1048576) "Oversize receipt file")
    (let* ((*read-eval* nil) (value (read s nil :eof)))
      (need (eq (read s nil :eof) :eof) "Trailing receipt object")
      (tree value))))
(defun write-data (path value)
  "Write bounded transport data, preserving string characters rather than array types."
  (tree value)
  ;; TREE bounds traversal and rejects shared/cyclic conses. Transport lists
  ;; must additionally be proper, and keyword names must fit the raw grammar.
  (labels ((portable (x)
             (cond ((consp x)
                    (loop for tail = x then (cdr tail) while (consp tail)
                          do (portable (car tail))
                          finally (need (null tail) "Improper transport list")))
                   ((keywordp x)
                    (need (and (plusp (length (symbol-name x)))
                               (alpha-char-p (char (symbol-name x) 0))
                               (string= (symbol-name x) (string-upcase (symbol-name x)))
                               (every (lambda (c) (or (alphanumericp c) (find c "-+.")))
                                      (symbol-name x))) "Unsupported transport keyword")))))
    (portable value))
  (let* ((*print-readably* nil) (*print-escape* t) (*print-pretty* nil)
         (*print-circle* nil) (*print-level* nil) (*print-length* nil)
         (*print-base* 10) (*print-radix* nil) (*print-case* :upcase)
         (*package* (find-package :vttest-charsets-native-contract))
         (text (with-output-to-string (s) (write value :stream s) (terpri s))))
    (need (<= (length (sb-ext:string-to-octets text :external-format :utf-8)) 1048576)
          "Oversize transport data")
    (with-open-file (s path :direction :output :if-exists :error
                           :if-does-not-exist :create :external-format :utf-8)
      (write-string text s))))
(defun relative-p (path)
  (and (stringp path) (plusp (length path)) (char/= (char path 0) #\/)
       (every (lambda (part) (and (plusp (length part)) (not (member part '("." "..") :test #'equal))))
              (loop for start = 0 then (1+ end) for end = (position #\/ path :start start)
                    collect (subseq path start end) while end))))
(defun local-path (root path)
  (need (relative-p path) "Foreign relative path")
  (let* ((base (namestring (truename root))) (full (concatenate 'string base path)))
    (need (equal (namestring (truename full)) full) "Noncanonical/symlink receipt path")
    full))
(defun digest (path)
  (regular-file path)
  (let* ((out (make-string-output-stream))
         (process (sb-ext:run-program "/run/current-system/sw/bin/sha256sum" (list "--" path)
                   :input nil :output out :error *error-output* :wait t))
         (text (get-output-stream-string out)))
    (need (and (eql 0 (sb-ext:process-exit-code process)) (>= (length text) 64)) "Hash failure")
    (subseq text 0 64)))
(defun reference (root path)
  (list :path path :sha256 (digest (local-path root path))))
(defun check-reference (ref &optional root expected)
  (properties ref '(:path :sha256))
  (need (and (relative-p (getf ref :path))
             (or (null expected) (equal expected (getf ref :path)))
             (stringp (getf ref :sha256)) (= 64 (length (getf ref :sha256)))
             (every (lambda (c) (find c "0123456789abcdef")) (getf ref :sha256))) "Bad reference")
  (when root (need (equal ref (reference root (getf ref :path))) "Reference hash mismatch")))
(defun counts (object keys &optional unknown)
  (let ((values (mapcar (lambda (k) (getf object k)) keys)))
    (if (and unknown (every #'null values)) nil
        (progn (need (every (lambda (n) (typep n '(integer 0 1))) values) "Missing/invalid count")
               (need (apply #'>= values) "Contradictory counts")))))
(defun check-checks (checks &optional recorder)
  (need (and (listp checks) (<= (length checks) 1)) "Bad checks")
  (let ((seen nil))
    (dolist (c checks)
      (properties c (if recorder '(:pause :pixels :bytes :timing :frame :target :native :evidence :reason :comparison)
                       '(:pause :pixels :bytes :timing)) '(:pause :pixels :bytes :timing))
      (let ((n (getf c :pause)))
        (need (and (typep n '(integer 1 1)) (not (member n seen))) "Duplicate/bad pause")
        (push n seen)
        (when (getf c :evidence)
          (dolist (p (if (stringp (getf c :evidence)) (list (getf c :evidence)) (getf c :evidence)))
            (need (and (relative-p p) (search (format nil "pause-~2,'0d-" n) p :start2 0)
                       (zerop (search (format nil "pause-~2,'0d-" n) p))) "Foreign pause evidence"))))
      (dolist (k '(:pixels :bytes :timing))
        (need (member (getf c k) '(:pass :fail :unverified)) "Bad check status"))
      (when (member :frame c) (need (member (getf c :frame) '(:pass :fail :unverified))))
      (when (getf c :native)
        (properties (getf c :native)
          '(:version :backend :pause :window-id :native-window-id :surface-id :width :height :scale
            :capture-count :owned :capture-exit :png :ack-output :ack-basis :custody))))))
(defparameter +recorder-keys+
  '(:kind :version :backend :status :attempted :reached :captured :frame-verified :bytes
    :wire-accounting :reason :cleanup :checks :evidence))
(defun cleanup-value-p (value)
  (or (member value '(nil :graceful-exit :graceful-exit-after-failure :cooperative-native-abort))
      (and (listp value) (= 2 (length value))
           (eq :graceful-exit-unverified (first value)) (stringp (second value)))
      (and (listp value) (= 3 (length value))
           (cleanup-value-p (first value)) (eq :close-error (second value)) (stringp (third value)))))
(defun validate-comparison (check root)
  "Bind complete comparison evidence to this pause's original PNG and bracket."
  (let* ((n (getf check :pause)) (stem (format nil "recorder/pause-~2,'0d-" n))
         (r (read-data (local-path root (getf (getf check :comparison) :path))))
         (width 640)
         (font '( :path "/nix/store/9qvd27vg12177prxcl778rdhxh4lk2mi-terminus-font-4.49.1/share/fonts/terminus/ter-u16n.otb"
                  :sha256 "0d11d8ed0889a412fb6903710804643ad85858cc56905286cedae392a57255ca"))
         (decoder '(:path "/nix/store/h74lg8wfwndnf5glr171kmcshlffi7l2-imagemagick-7.1.2-29/bin/magick"
                    :sha256 "054c52b583c303bca2aae9fadcfd9e09fbc946f83e6621b39f22650d28d3027e")))
    (properties r '(:version :pause :png :phase :width :height :font :decoder :bracket
                    :identify :decode :rgba :decoded-length :opaque :comparison))
    (need (and (eql 1 (getf r :version)) (eql n (getf r :pause))
               (eql width (getf r :width)) (eql 384 (getf r :height))
               (equal font (getf r :font)) (equal decoder (getf r :decoder))
               (eql (* width 384 4) (getf r :decoded-length)) (eq t (getf r :opaque)))
          "Comparison profile refusal")
    (check-reference (getf r :png) root (concatenate 'string stem "actual.png"))
    (check-reference (getf r :rgba) root (concatenate 'string stem "actual.rgba"))
    (with-open-file (s (local-path root (getf (getf r :rgba) :path)) :element-type '(unsigned-byte 8))
      (need (= (file-length s) (getf r :decoded-length)) "Decoded length mismatch"))
    (let ((bracket (getf r :bracket)))
      (need (= 5 (length bracket)) "Incomplete original bracket")
      (loop for ref in bracket for suffix in '("before.sexp" "ready.sexp" "pre.sexp" "final.sexp" "native.sexp")
            do (check-reference ref root (concatenate 'string stem suffix)))
      (destructuring-bind (before ready pre final native)
          (mapcar (lambda (ref) (read-data (local-path root (getf ref :path)))) bracket)
        (need (equal native (getf check :native)) "Comparison native mismatch")
        (need (and (member :phase r) (eq (getf r :phase) (getf ready :blink-phase))) "Comparison phase mismatch")
        (let* ((request (read-data (local-path root (concatenate 'string stem "request.sexp"))))
               (target (getf request :target)))
          (need (and (equal ready (getf request :status)) (eql n (getf request :pause))) "Comparison request mismatch")
          (vttest-screen-frame:validate-frame before ready pre final native :pause n :target target
            :blink-content nil :endpoint nil :ack-output (getf request :ack-output)
            :surface-id (getf request :surface-id)))))
    (loop for key in '(:identify :decode) for action in '("identify" "decode") do
      (let ((refs (getf r key)) (base (concatenate 'string stem action)))
        (need (= 4 (length refs)) "Missing decoder evidence")
        (loop for ref in refs for suffix in '(".argv.sexp" ".stdout" ".stderr" ".exit")
              do (check-reference ref root (concatenate 'string base suffix)))
        (need (eql 0 (read-data (local-path root (concatenate 'string base ".exit")))) "Failed decoder")
        (need (equal (read-data (local-path root (concatenate 'string base ".argv.sexp")))
                     (if (eq key :identify)
                         (list (getf decoder :path) "identify" "-format" "%w %h"
                               (local-path root (concatenate 'string stem "actual.png")))
                         (list (getf decoder :path) (local-path root (concatenate 'string stem "actual.png"))
                               "-depth" "8" (concatenate 'string "rgba:" root stem "actual.rgba"))))
              "Foreign decoder invocation")))
    (let ((c (getf r :comparison)))
      (properties c '(:pass :compared-pixels :different-pixels :different-cells :first-difference :tolerance :masked-pixels))
      (need (and (eq t (getf c :pass)) (= (* width 384) (getf c :compared-pixels))
                 (eql 0 (getf c :different-pixels)) (null (getf c :different-cells))
                 (null (getf c :first-difference)) (eql 0 (getf c :tolerance))
                 (eql 0 (getf c :masked-pixels))) "Nonexact comparison"))
    r))

(defun validate-recorder (record backend &optional root)
  (tree record) (properties record +recorder-keys+)
  (need (and (eq (getf record :kind) :vttest-charsets-run) (eql 2 (getf record :version))
             (equal backend (getf record :backend)) (member backend '("x11" "wayland") :test #'equal)
             (member (getf record :status) '(:fail :pass :unverified))
             (member (getf record :bytes) '(:fail :pass :unverified))) "Recorder identity/status")
  (counts record '(:attempted :reached :captured :frame-verified))
  (need (or (member (getf record :wire-accounting) '(:pass :unverified))
            (let ((x (getf record :wire-accounting)))
              (and (listp x) (= 2 (length x)) (eq :fail (first x)) (stringp (second x))))))
  (need (or (stringp (getf record :reason))
            (eq :full-session-wire-and-pixel-proof-unverified (getf record :reason))))
  (need (cleanup-value-p (getf record :cleanup)))
  (check-checks (getf record :checks) t)
  (need (= 1 (length (getf record :checks))) "Incomplete recorder checks")
  (need (= (getf record :frame-verified)
           (count :pass (getf record :checks) :key (lambda (c) (getf c :frame)))) "Frame count mismatch")
  (when (eq :pass (getf record :status))
    (need (and (= 1 (getf record :attempted) (getf record :reached)
                      (getf record :captured) (getf record :frame-verified))
               (eq :graceful-exit (getf record :cleanup))
               (every (lambda (c) (every (lambda (k) (eq :pass (getf c k)))
                                          '(:pixels :timing :frame))) (getf record :checks)))
          "Invalid recorder PASS"))
  (dolist (c (getf record :checks))
    (when (eq :pass (getf c :pixels))
      (need (eq :pass (getf c :frame)) "Pixels without strict frame")
      (check-reference (getf c :comparison) root
                       (format nil "recorder/pause-~2,'0d-comparison.sexp" (getf c :pause)))
      (when root (validate-comparison c root)))
    (when (member :target c) (need (eq :recognized-navigation-only (getf c :target))))
    (when (member :reason c) (need (stringp (getf c :reason))))
    (when (getf c :native)
      (let ((r (getf c :native)))
        (need (and (eql 3 (getf r :version)) (eql (getf c :pause) (getf r :pause))
                   (eq (intern (string-upcase backend) :keyword) (getf r :backend))
                   (eql 1 (getf r :capture-count)) (eql 1 (getf r :scale))
                   (eq t (getf r :owned)) (typep (getf r :capture-exit) '(integer 0 255))
                   (member (getf r :custody) '(t nil))
                   (eq :recorder-request-binding (getf r :ack-basis))
                   (equal (getf r :png) (format nil "pause-~2,'0d-actual.png" (getf c :pause)))))))
    (when (eq :pass (getf c :frame)) (need (getf c :native))))
  (need (equal (getf record :evidence)
               '("events.sexp" "output.raw" "input.raw" "application.log" "launch.sexp" "terminal-status.sexp"))
        "Foreign recorder evidence")
  ;; Custody is the original canonical RESULT beneath this invocation's root.
  ;; Version 2 applies visible-screen acceptance, not child-internal wire proof.
  (when root (local-path root "recorder/RESULT.sexp"))
  record)
(defun import-recorder (root backend)
  (let* ((path (local-path root "recorder/RESULT.sexp"))
         (record (validate-recorder (read-data path) backend root))
         (checks (getf record :checks))
         (status (cond ((or (eq (getf record :status) :fail)
                             (some (lambda (c) (some (lambda (k) (eq (getf c k) :fail))
                                                    '(:pixels :timing :frame))) checks)) :fail)
                       ((and (eq (getf record :status) :pass) (= 1 (length checks))
                             (every (lambda (c) (every (lambda (k) (eq (getf c k) :pass))
                                                      '(:pixels :timing :frame))) checks)) :pass)
                       (t :unverified))))
    (write-data (concatenate 'string root "native/recorder-import.sexp")
      (list :origin (reference root "recorder/RESULT.sexp") :status status
            :stage (list :origin (reference root "recorder/RESULT.sexp")
                         :attempted (getf record :attempted) :reached (getf record :reached)
                         :captured (getf record :captured) :frame-verified (getf record :frame-verified))
            :checks (loop for c in checks collect
                      (loop for k in '(:pause :pixels :bytes :timing) append (list k (getf c k))))))
    status))

(defun monotonic-ns ()
  (multiple-value-bind (sec ns) (sb-unix:clock-gettime sb-unix:clock-monotonic)
    (+ (* sec 1000000000) ns)))
(defun process-token (pid)
  (handler-case
      (with-open-file (s (format nil "/proc/~d/stat" pid))
        (let* ((row (read-line s)) (end (position #\) row :from-end t))
               (rest (subseq row (+ end 2))) (*read-eval* nil))
          (unless (char= (char rest 0) #\Z)
            ;; Fields after comm begin with state (field3); starttime is field22.
            (with-input-from-string (in rest)
              (loop repeat 19 do (read in)) (princ-to-string (read in))))))
    (error () nil)))
(defun start-cleanup (root)
  "Start the one cleanup clock before publishing any native failure."
  (let ((start (monotonic-ns)))
    (write-data (concatenate 'string root "native/finalization-clock.sexp.start") start)
    start))
(defun await-exit (pid token output start)
  "Observe the owned recorder under the already started cleanup clock."
  (need (and (integerp start) (<= 0 start (monotonic-ns))) "Invalid cleanup start")
  (let* ((deadline (+ start 15000000000)) (state nil))
    (loop (when (>= (monotonic-ns) deadline) (setf state :timeout) (return))
          (unless (equal token (process-token pid)) (setf state :exited) (return))
          (sleep .02))
    (write-data output (list :clock :clock-monotonic :limit-seconds 15 :start-ns start
                             :run (sb-ext:posix-getenv "LISPTERM_CHARSETS_ROOT")
                             :backend (sb-ext:posix-getenv "LISPTERM_CHARSETS_BACKEND")
                             :end-ns (monotonic-ns) :state state :pid pid :token token))
    state))

;;; Native failure is closed data in the private invocation tree, never a success marker.
(defun validate-native-failure (record root backend pause &optional envelope)
  (tree record)
  (properties record (append '(:kind :version :run :backend :pause :reason :stage :manifest)
                             (when envelope '(:origin))))
  (need (and (eq :vttest-charsets-native-failure (getf record :kind))
             (eql 1 (getf record :version))
             (equal (namestring (truename root)) (getf record :run))
             (equal backend (getf record :backend))
             (member backend '("x11" "wayland") :test #'equal)
             (typep pause '(integer 0 1)) (eql pause (getf record :pause))
             (member (getf record :reason)
                     '("recorder" "request" "geometry" "authorization" "capture" "placement") :test #'equal)
             (member (getf record :stage) '(:placement :request :geometry :authorization :capture)))
        "Foreign/stale native failure")
  (check-reference (getf record :manifest) root "MANIFEST.sexp")
  (when envelope
    (check-reference (getf record :origin) root "native/native-failure-origin.sexp")
    (let ((origin (read-data (local-path root "native/native-failure-origin.sexp"))))
      (validate-native-failure origin root backend pause)
      (need (equal origin (loop for (k v) on record by #'cddr
                               unless (eq k :origin) append (list k v))) "Failure origin differs")))
  record)
(defun publish-native-failure (root backend pause reason stage)
  "Exclusive origin and atomic link publication; errors remain secondary to native failure."
  (let* ((record (list :kind :vttest-charsets-native-failure :version 1
                       :run (namestring (truename root)) :backend backend :pause pause
                       :reason reason :stage stage :manifest (reference root "MANIFEST.sexp")))
         (origin (concatenate 'string root "native/native-failure-origin.sexp"))
         (temporary (concatenate 'string root "native/native-failure.sexp.tmp"))
         (final (concatenate 'string root "native/native-failure.sexp")))
    (validate-native-failure record root backend pause)
    (write-data origin record)
    (setf record (append record (list :origin (reference root "native/native-failure-origin.sexp"))))
    (validate-native-failure record root backend pause t)
    (write-data temporary record)
    (sb-posix:link temporary final)
    (sb-posix:unlink temporary)
    record))

(defparameter +native-keys+
  '(:kind :version :backend :attempted :reached :captured :checks :status :build :native-started :cleanup
    :recorder-result :recorder-sha256 :manifest :manifest-sha256 :execution-inputs :evidence :reason
    :stages :finalization :abort :unowned-endpoints :count-basis))
(defun validate-ledger (ledger backend root stage)
  (tree ledger) (properties ledger '(:kind :version :backend :entries))
  (need (and (eq :vttest-charsets-native-stages (getf ledger :kind))
             (eql 1 (getf ledger :version)) (equal backend (getf ledger :backend))))
  (let ((entries (getf ledger :entries)) (invoked 0) (completed 0))
    (need (and (listp entries) (<= (length entries) 1)))
    (loop for entry in entries for n from 1 do
      (properties entry '(:pause :request :invoked :completed :capture-exit :exit-origin :receipt))
      (need (eql n (getf entry :pause)) "Nonsequential ledger")
      (check-reference (getf entry :request) root (format nil "recorder/pause-~2,'0d-request" n))
      (dolist (k '(:invoked :completed)) (need (member (getf entry k) '(t nil))))
      (when (getf entry :invoked) (incf invoked))
      (when (getf entry :completed)
        (need (and (getf entry :invoked) (typep (getf entry :capture-exit) '(integer 0 255))))
        (check-reference (getf entry :exit-origin) root (format nil "recorder/pause-~2,'0d-capture.exit" n))
        (when root (need (eql (getf entry :capture-exit)
                             (read-data (local-path root (getf (getf entry :exit-origin) :path))))))
        (incf completed))
      (unless (getf entry :completed)
        (need (and (null (getf entry :capture-exit)) (null (getf entry :exit-origin)))))
      (when (getf entry :receipt)
        (check-reference (getf entry :receipt) root (format nil "recorder/pause-~2,'0d-native.sexp" n))
        (when root
          (let ((r (read-data (local-path root (getf (getf entry :receipt) :path)))))
            (properties r '(:version :backend :pause :window-id :native-window-id :surface-id :width :height
                            :scale :capture-count :owned :capture-exit :png :ack-output :ack-basis :custody))
            (need (and (eql 3 (getf r :version)) (eq (intern (string-upcase backend) :keyword) (getf r :backend))
                       (eql n (getf r :pause)) (getf entry :completed)
                       (eql (getf entry :capture-exit) (getf r :capture-exit))) "Foreign capture receipt")))))
    (need (and (= (length entries) (getf stage :request-observed))
               (= invoked (getf stage :capture-invoked)) (= completed (getf stage :capture-completed))) "Ledger count mismatch"))
  ledger)
(defun validate-native (record backend &optional root)
  "Validate all identities, closed nested stages and counts before any salvage."
  (tree record) (properties record +native-keys+)
  (need (and (eq (getf record :kind) :vttest-charsets-run) (eql 3 (getf record :version))
             (equal backend (getf record :backend)) (eq :native-legacy (getf record :count-basis))
             (member (getf record :status) '(:pass :fail :unverified))
             (member (getf record :build) '(:pass :fail :unverified))
             (member (getf record :cleanup) '(:pass :fail :not-applicable))
             (member (getf record :native-started) '(t nil)) (stringp (getf record :reason))) "Native identity")
  (need (member backend '("x11" "wayland") :test #'equal))
  (need (and (listp (getf record :unowned-endpoints)) (<= (length (getf record :unowned-endpoints)) 4)))
  (check-reference (list :path "MANIFEST.sexp" :sha256 (getf record :manifest-sha256)))
  (counts record '(:attempted :reached :captured))
  (check-checks (getf record :checks))
  (let* ((stages (getf record :stages)) (r (getf stages :recorder)) (n (getf stages :native))
         (f (getf record :finalization)) (abort (getf record :abort)))
    (properties stages '(:recorder :native))
    (properties r '(:origin :attempted :reached :captured :frame-verified))
    (properties n '(:origin :request-observed :capture-invoked :capture-completed))
    (counts r '(:attempted :reached :captured :frame-verified) (null (getf r :origin)))
    (when (null (getf r :origin))
      (need (every (lambda (k) (null (getf r k))) '(:attempted :reached :captured :frame-verified))))
    (unless (getf r :origin) (need (null (getf record :checks)) "Checks without validated RESULT"))
    (counts n '(:request-observed :capture-invoked :capture-completed))
    (need (= (getf record :attempted) (getf n :request-observed)) "Legacy basis mismatch")
    (need (<= (getf record :captured) (getf n :capture-completed)))
    (check-reference (getf n :origin) root "native/stages.sexp")
    (when (getf r :origin) (check-reference (getf r :origin) root "recorder/RESULT.sexp"))
    (properties f '(:state :client-exit :result :abort))
    (need (member (getf f :state) '(:complete :exited-without-result :timeout :not-started :invalid-result)))
    (need (typep (getf f :client-exit) '(or null (integer 0 255))))
    (need (equal (getf f :result) (getf r :origin)))
    (need (equal abort (getf f :abort)))
    (when abort (check-reference abort root "recorder/abort.sexp"))
    (when (or abort (member (getf f :state) '(:timeout :invalid-result :exited-without-result))
              (eq :fail (getf record :cleanup)) (eq :fail (getf record :build))
              (and (getf f :client-exit) (not (member (getf f :client-exit) '(0 3)))))
      (need (eq :fail (getf record :status)) "Failure downgraded"))
    (need (equal (getf record :recorder-sha256) (getf (getf r :origin) :sha256)))
    (when root
      (when abort
        (let ((a (read-data (local-path root "recorder/abort.sexp"))))
          (properties a '(:pause :reason))
          (need (and (typep (getf a :pause) '(integer 0 1)) (stringp (getf a :reason))))))
      (when (integerp (getf f :client-exit))
        (need (eql (getf f :client-exit) (read-data (local-path root "native/client.exit")))))
      (when (eq :complete (getf f :state))
        (let ((clock (read-data (local-path root "native/finalization-clock.sexp")))
              (validation (read-data (local-path root "native/import-deadline.sexp"))))
          (properties clock '(:clock :limit-seconds :start-ns :end-ns :state :pid :token :run :backend))
          (properties validation '(:clock :deadline-ns :validated-ns :state))
          (need (and (equal root (getf clock :run)) (equal backend (getf clock :backend))) "Foreign finalization")
          (need (and (eq :clock-monotonic (getf clock :clock)) (eql 15 (getf clock :limit-seconds))
                     (eq :exited (getf clock :state)) (integerp (getf clock :start-ns))
                     (integerp (getf clock :end-ns)) (>= (getf clock :end-ns) (getf clock :start-ns))))
          (need (and (eq :clock-monotonic (getf validation :clock)) (eq :valid (getf validation :state))
                     (eql (+ (getf clock :start-ns) 15000000000) (getf validation :deadline-ns))
                     (integerp (getf validation :validated-ns))
                     (<= (getf clock :end-ns) (getf validation :validated-ns))
                     (< (getf validation :validated-ns) (getf validation :deadline-ns))) "Late import"))))
    (when (eq (getf f :state) :complete)
      (need (and (getf r :origin) (integerp (getf f :client-exit)))))
    (when (getf r :origin)
      (need (eq (getf f :state) :complete))
      (need (>= (getf r :reached) (getf n :request-observed)))
      (need (<= (getf r :captured) (getf n :capture-completed))))
    (dolist (u (getf record :unowned-endpoints))
      (properties u '(:path :ownership))
      (need (and (stringp (getf u :path)) (eq :unestablished (getf u :ownership)))))
    (when (eq :pass (getf record :status))
      (need (and (null abort) (eq :complete (getf f :state)) (eql 0 (getf f :client-exit))
                 (eq :pass (getf record :cleanup)) (eq :pass (getf record :build))
                 (= 1 (getf record :attempted) (getf record :reached) (getf record :captured))
                 (= 1 (getf n :request-observed) (getf n :capture-invoked) (getf n :capture-completed))
                 (= 1 (getf r :attempted) (getf r :reached) (getf r :captured) (getf r :frame-verified))
                 (= 1 (length (getf record :checks)))
                 (every (lambda (c) (every (lambda (k) (eq :pass (getf c k))) '(:pixels :timing)))
                        (getf record :checks))) "Invalid PASS"))
    (when root
      (let ((ledger (read-data (local-path root "native/stages.sexp"))))
        (validate-ledger ledger backend root n)
        (when (getf r :origin)
          (let ((rec (validate-recorder (read-data (local-path root "recorder/RESULT.sexp")) backend root)))
            (dolist (k '(:attempted :reached :captured :frame-verified)) (need (eql (getf r k) (getf rec k))))
            (need (equal (getf record :checks)
                         (loop for c in (getf rec :checks) collect
                           (loop for k in '(:pause :pixels :bytes :timing) append (list k (getf c k)))) )
                  "Projected checks differ from original RESULT")
            (when (eq :fail (getf rec :status)) (need (eq :fail (getf record :status))))
            (when (eq :pass (getf record :status)) (need (eq :pass (getf rec :status)) "Native PASS without recorder PASS"))
            (dolist (c (getf rec :checks))
              (when (eq :pass (getf c :frame))
                (let ((entry (find (getf c :pause) (getf ledger :entries) :key (lambda (e) (getf e :pause)))))
                  (need (and entry (eql 0 (getf entry :capture-exit)) (getf entry :receipt)))
                  (need (equal (getf c :native) (read-data (local-path root (getf (getf entry :receipt) :path))))
                        "Cross-stage native receipt mismatch")))))))))
  (need (equal "recorder/RESULT.sexp" (getf record :recorder-result)))
  (need (equal "native/execution-inputs.sha256" (getf record :execution-inputs)))
  (need (equal '("native/" "build/BUILD.sexp" "recorder/RESULT.sexp") (getf record :evidence)))
  (when root
    (need (equal (getf record :manifest) (local-path root "MANIFEST.sexp")))
    (need (equal (getf record :manifest-sha256) (digest (local-path root "MANIFEST.sexp"))))
    (need (equal (getf record :recorder-sha256)
                 (getf (getf (getf (getf record :stages) :recorder) :origin) :sha256))
          "Recorder digest projection mismatch"))
  record)

(defun build-ledger (root backend)
  (let ((entries nil))
    (with-open-file (s (concatenate 'string root "native/stage-events.sexp"))
      (need (<= (file-length s) 16384))
      (let ((*read-eval* nil))
        (loop for row = (read s nil :eof) until (eq row :eof) do
          (tree row)
          (need (and (listp row) (<= 2 (length row) 3) (typep (first row) '(integer 1 1))))
          (destructuring-bind (n action &optional exit) row
            (let ((entry (first entries)))
              (case action
                (:request
                 (need (= n (1+ (length entries))))
                 (push (list :pause n :request (reference root (format nil "recorder/pause-~2,'0d-request" n))
                             :invoked nil :completed nil :capture-exit nil :exit-origin nil :receipt nil) entries))
                (:invoked (need (and (eql n (getf entry :pause)) (not (getf entry :invoked))))
                          (setf (getf entry :invoked) t))
                (:completed (need (and (eql n (getf entry :pause)) (getf entry :invoked)
                                       (not (getf entry :completed)) (typep exit '(integer 0 255))))
                            (setf (getf entry :completed) t (getf entry :capture-exit) exit
                                  (getf entry :exit-origin) (reference root (format nil "recorder/pause-~2,'0d-capture.exit" n))))
                (otherwise (error "Unknown stage event"))))))))
    (dolist (entry entries)
      (let ((path (format nil "recorder/pause-~2,'0d-native.sexp" (getf entry :pause))))
        (when (probe-file (concatenate 'string root path)) (setf (getf entry :receipt) (reference root path)))))
    (let ((ledger (list :kind :vttest-charsets-native-stages :version 1 :backend backend :entries (nreverse entries))))
      (write-data (concatenate 'string root "native/stages.sexp") ledger)
      ledger)))
(defun environment (key) (sb-ext:posix-getenv (concatenate 'string "LISPTERM_CHARSETS_" key)))
(defun scalar (key)
  (let* ((*read-eval* nil) (text (environment key)))
    (need (and text (< (length text) 128)))
    (multiple-value-bind (value end) (read-from-string text)
      (need (= end (length text))) (tree value) (need (atom value)) value)))
(defun publish-native ()
  (let* ((root (environment "ROOT")) (backend (environment "BACKEND"))
         (state (scalar "FINALIZATION")) (client-exit (scalar "CLIENT_EXIT"))
         (abort (when (probe-file (concatenate 'string root "recorder/abort.sexp"))
                  (reference root "recorder/abort.sexp")))
         (imported (when (eq state :complete) (read-data (concatenate 'string root "native/recorder-import.sexp"))))
         (ledger (build-ledger root backend))
         (entries (getf ledger :entries))
         (native-stage (list :origin (reference root "native/stages.sexp") :request-observed (length entries)
                             :capture-invoked (count-if (lambda (e) (getf e :invoked)) entries)
                             :capture-completed (count-if (lambda (e) (getf e :completed)) entries)))
         (recorder-stage (if imported (getf imported :stage)
                             (list :origin nil :attempted nil :reached nil :captured nil :frame-verified nil)))
         (unowned (with-open-file (s (concatenate 'string root "native/unowned-endpoints.txt"))
                    (loop for line = (read-line s nil) while line collect (list :path line :ownership :unestablished))))
         (status (scalar "STATUS"))
         (record nil))
    ;; Import products are internal receipts, still closed and freshly rebound.
    (when imported
      (tree imported) (properties imported '(:origin :status :stage :checks))
      (need (equal (getf imported :origin) (reference root "recorder/RESULT.sexp"))))
    (when (or abort (member state '(:timeout :exited-without-result :invalid-result))
              (and client-exit (not (member client-exit '(0 3))))
              (and imported (eq :fail (getf imported :status)))) (setf status :fail))
    (setf record
      (list :kind :vttest-charsets-run :version 3 :backend backend
            :attempted (scalar "ATTEMPTED") :reached (scalar "REACHED") :captured (scalar "CAPTURED")
            :checks (getf imported :checks) :status status :build (scalar "BUILD")
            :native-started (scalar "STARTED") :cleanup (scalar "CLEANUP")
            :recorder-result "recorder/RESULT.sexp" :recorder-sha256 (getf (getf recorder-stage :origin) :sha256)
            :manifest (concatenate 'string root "MANIFEST.sexp")
            :manifest-sha256 (digest (local-path root "MANIFEST.sexp"))
            :execution-inputs "native/execution-inputs.sha256"
            :evidence '("native/" "build/BUILD.sexp" "recorder/RESULT.sexp") :reason (environment "REASON")
            :stages (list :recorder recorder-stage :native native-stage)
            :finalization (list :state state :client-exit client-exit :result (copy-tree (getf recorder-stage :origin))
                                :abort (copy-tree abort))
            :abort abort :unowned-endpoints unowned :count-basis :native-legacy))
    (validate-native record backend root)
    (write-data (concatenate 'string root "CHARSETS-RUN.sexp") record)
    status))
(defun bounded-import ()
  "Use the original finalization deadline, including process startup and parsing."
  (let* ((deadline-text (environment "DEADLINE_NS"))
         (deadline (when deadline-text (parse-integer deadline-text)))
         (root (environment "ROOT")))
    (handler-case
        (let ((status
                (if deadline
                    (let ((seconds (/ (- deadline (monotonic-ns)) 1000000000d0)))
                      (when (<= seconds 0) (error 'sb-ext:timeout))
                      ;; This disposable validator has no live application state.
                      ;; Partial output after a timeout is retained, never imported.
                      (sb-ext:with-timeout seconds (import-recorder root (environment "BACKEND"))))
                    (import-recorder root (environment "BACKEND")))))
          (when deadline
            (let ((at (monotonic-ns)))
              (when (>= at deadline) (error 'sb-ext:timeout))
              (write-data (concatenate 'string root "native/import-deadline.sexp")
                (list :clock :clock-monotonic :deadline-ns deadline :validated-ns at :state :valid))))
          status)
      (sb-ext:timeout ()
        (write-data (concatenate 'string root "native/import-deadline.sexp")
          (list :clock :clock-monotonic :deadline-ns deadline :validated-ns nil :state :timeout))
        (sb-ext:exit :code 124)))))
(defun bounded-notify ()
  "Only this disposable publisher may be timed out, never the application owner."
  (let* ((deadline (parse-integer (environment "DEADLINE_NS")))
         (seconds (/ (- deadline (monotonic-ns)) 1000000000d0)))
    (handler-case
        (progn
          (when (<= seconds 0) (error 'sb-ext:timeout))
          (sb-ext:with-timeout seconds
            (publish-native-failure (environment "ROOT") (environment "BACKEND")
              (parse-integer (environment "PAUSE")) (environment "REASON") (scalar "STAGE")))
          (when (>= (monotonic-ns) deadline) (error 'sb-ext:timeout)))
      (sb-ext:timeout () (sb-ext:exit :code 124)))))
(defun main ()
  (let ((mode (environment "OPERATION")))
    (cond ((equal mode "start") (format t "~d~%" (start-cleanup (environment "ROOT"))))
          ((equal mode "notify") (bounded-notify))
          ((equal mode "await")
           (format t "~s~%" (await-exit (parse-integer (environment "PID")) (environment "TOKEN")
                                       (concatenate 'string (environment "ROOT") "native/finalization-clock.sexp")
                                       (parse-integer (environment "START_NS")))))
          ((equal mode "import") (format t "~s~%" (bounded-import)))
          ((equal mode "publish") (format t "~s~%" (publish-native)))
          (t (error "Unknown native contract operation")))))
