;;;; Standalone pure controls. Do not load the recorder, application or fixtures.
(load (merge-pathnames "vttest-selection.lisp" *load-truename*))
(in-package #:cl-user)
(defparameter *checks* 0)
(defparameter *sample-cases*
  '(("cursor" (1) 6) ("bug-e" (9 5) 1) ("bug-erase" (9 8) 6)
    ("keyboard-cursor" (5 4) 1)))
(defun check-selection (name expected &rest arguments)
  (let ((actual (mapcar #'first (apply #'vttest-selection:select-cases *sample-cases* arguments))))
    (assert (equal expected actual) () "~a: expected ~s, got ~s" name expected actual)
    (incf *checks*) (format t "PASS ~a~%" name)))
(defun check-refusal (name cases &rest arguments)
  (assert (handler-case (progn (apply #'vttest-selection:select-cases cases arguments) nil)
            (vttest-selection:invalid-selection () t)) () "~a: expected typed refusal" name)
  (incf *checks*) (format t "PASS ~a~%" name))
(check-selection "exact bug-e" '("bug-e") :exact-labels "bug-e")
(check-selection "exact bug-erase" '("bug-erase") :exact-labels "bug-erase")
(check-selection "exact cursor" '("cursor") :exact-labels "cursor")
(check-selection "multi once each, requested order" '("bug-erase" "cursor" "bug-e")
                 :exact-labels "bug-erase,cursor,bug-e")
(check-selection "absent selects all, source order" (mapcar #'first *sample-cases*))
(check-selection "legacy substring bug-e" '("bug-e" "bug-erase") :filter "bug-e")
(check-selection "legacy substring cursor" '("cursor" "keyboard-cursor") :filter "cursor")
(check-selection "legacy empty substring" (mapcar #'first *sample-cases*) :filter "")
(check-selection "legacy unmatched" nil :filter "not-known")
(loop for selector in (list "unknown" "" "cursor,cursor" ",cursor" "cursor," "cursor,,bug-e"
                           " cursor" "cursor " "cursor, bug-e" "cursor;bug-e" "cursor/bug-e"
                           "CURSOR" "(cursor)" "#.(error)" (format nil "cursor~%")
                           (format nil "cursor~c" #\Tab) (string (code-char 0))
                           (make-string 4097 :initial-element #\a) 42 '("cursor"))
      for number from 1
      do (check-refusal (format nil "invalid selector ~d" number) *sample-cases*
                        :exact-labels selector))
(check-refusal "conflicting old/new" *sample-cases* :exact-labels "cursor" :filter "bug-e")
(check-refusal "matching old/new also refused" *sample-cases* :exact-labels "cursor" :filter "cursor")
(check-refusal "empty old/new also refused" *sample-cases* :exact-labels "cursor" :filter "")
(check-refusal "ambiguous catalog" '(("cursor" (1) 6) ("cursor" (2) 9)) :exact-labels "cursor")
(check-refusal "unknown within multi" *sample-cases* :exact-labels "cursor,unknown")
(check-refusal "nonadjacent duplicate" *sample-cases* :exact-labels "cursor,bug-e,cursor")
;; The caller receives the original case records, not reconstructed menu paths.
(assert (eq (second *sample-cases*)
            (first (vttest-selection:select-cases *sample-cases* :exact-labels "bug-e"))))
(incf *checks*) (format t "PASS original case record identity~%")
(format t "~d pure selection controls passed.~%" *checks*)
