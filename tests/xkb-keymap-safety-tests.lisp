;;;; Run in a disposable SBCL: scripts/sbcl --script tests/run-xkb-tests.lisp
(defpackage #:lispterm.xkb-safety-tests
  (:use #:cl) (:export #:run)
  (:local-nicknames (#:wl #:lispterm.display.wayland)))
(in-package #:lispterm.xkb-safety-tests)
(cffi:defcfun ("memfd_create" memfd) :int (name :string) (flags :unsigned-int))
(cffi:defcfun ("write" fd-write) :long (fd :int) (buffer :pointer) (count :unsigned-long))
(cffi:defcfun ("ftruncate" truncate-fd) :int (fd :int) (length :long))
(cffi:defcfun ("fcntl" fd-flags) :int (fd :int) (command :int))
(cffi:defcfun ("xkb_keymap_new_from_names" keymap-from-names) :pointer
  (context :pointer) (names :pointer) (flags :int))
(cffi:defcfun ("xkb_keymap_get_as_string" keymap-string) :pointer
  (keymap :pointer) (format :int))
(cffi:defcfun ("free" free-string) :void (pointer :pointer))
(defvar *checks* 0)
(defun check (value label)
  (unless value (error "Failed: ~A" label)) (incf *checks*))
(defun fd-count () (length (directory #P"/proc/self/fd/*")))
(defun bytes-fd (bytes)
  (let ((fd (memfd "xkb-safety" 1)))
    (assert (>= fd 0))
    (cffi:with-foreign-object (buffer :uint8 (max 1 (length bytes)))
      (dotimes (i (length bytes)) (setf (cffi:mem-aref buffer :uint8 i) (aref bytes i)))
      (assert (= (fd-write fd buffer (length bytes)) (length bytes))))
    fd))
(defun rejected (bytes size label &optional parse-expected)
  (let ((fd (bytes-fd bytes)) (typed nil) (calls 0)
        (parser (symbol-function 'wl::%xkb-keymap-new)))
    (unwind-protect
        (progn
          (setf (symbol-function 'wl::%xkb-keymap-new)
                (lambda (&rest arguments) (incf calls) (apply parser arguments)))
          (handler-case (let ((xkb (wl::xkb-from-fd fd size))) (wl::xkb-close xkb))
            (wl::wayland-transport-error () (setf typed t))))
      (setf (symbol-function 'wl::%xkb-keymap-new) parser))
    (check typed label)
    (check (= (if parse-expected 1 0) calls) "parser reached only after validation")
    (check (= -1 (fd-flags fd 1)) "rejected FD closed")))
(defun valid-bytes ()
  (wl::ensure-xkb-library)
  (let* ((context (wl::%xkb-context-new 0))
         (keymap (keymap-from-names context (cffi:null-pointer) 0))
         (text (keymap-string keymap 1)))
    (assert (not (cffi:null-pointer-p keymap)))
    (unwind-protect
        (concatenate '(vector (unsigned-byte 8))
                     (babel:string-to-octets (cffi:foreign-string-to-lisp text :encoding :utf-8)
                                             :encoding :utf-8) #(0))
      (free-string text) (wl::%xkb-keymap-unref keymap) (wl::%xkb-context-unref context))))
(defun run ()
  (setf *checks* 0)
  (let* ((bytes (valid-bytes)) (baseline (fd-count))
         (original (symbol-function 'wl::%keymap-pread)))
    (unwind-protect
        (progn
          ;; The former mmap implementation crashes on this exact advertised length.
          (rejected #() 8193 "empty FD")
          (rejected #(65 0) 8193 "short FD")
          (dolist (size '(0 1 -1 16777217 4294967295))
            (rejected #() size "invalid size"))
          (rejected #(65 66) 2 "missing NUL")
          (rejected #(65 0 66 0) 4 "embedded NUL")
          (rejected #(255 0) 2 "invalid UTF-8")
          (rejected #(65 0) 2 "invalid XKB text" t)
          ;; Force a real truncate between two partial preads, not just an initial short file.
          (let ((calls 0))
            (setf (symbol-function 'wl::%keymap-pread)
                  (lambda (fd buffer count offset)
                    (incf calls)
                    (if (= calls 1)
                        (prog1 (funcall original fd buffer (min 17 count) offset)
                          (assert (zerop (truncate-fd fd 0))))
                        (funcall original fd buffer count offset))))
            (rejected bytes (length bytes) "truncate during copy")
            (check (= calls 2) "truncate actually exercised"))
          ;; EINTR followed by short reads must still construct a usable real keymap.
          (let ((calls 0) (fd (bytes-fd bytes)) (xkb nil))
            (setf (symbol-function 'wl::%keymap-pread)
                  (lambda (fd buffer count offset)
                    (incf calls)
                    (if (= calls 1)
                        (progn (setf (cffi:mem-ref (wl::%errno-location) :int) 4) -1)
                        (funcall original fd buffer (min count 97) offset))))
            (unwind-protect
                (progn
                  (setf xkb (wl::xkb-from-fd fd (length bytes)))
                  (check (> calls 2) "EINTR and partial reads exercised")
                  (check (eql #\a (getf (wl::xkb-normalized-key xkb 30) :key)) "real parsed keymap A")
                  (check (= -1 (fd-flags fd 1)) "valid FD consumed"))
              (wl::xkb-close xkb)
              (when xkb
                (check (and (null (wl::xkb-state xkb)) (null (wl::xkb-keymap xkb))
                            (null (wl::xkb-context xkb))) "native pointers cleared"))))
          (setf (symbol-function 'wl::%keymap-pread) original)
          ;; Malformed payloads retain queue ownership until wire-close; unknown formats consume FD.
          (dolist (length '(0 1 4 7 9))
            (let* ((fd (bytes-fd #())) (wire (wl::%make-wire :fds (list fd)))
                   (state (wl::make-wayland-state :wire wire)) (typed nil))
              (unwind-protect
                  (handler-case (wl::keyboard-event state 0 (make-array length :element-type '(unsigned-byte 8)))
                    (wl::wayland-transport-error () (setf typed t)))
                (wl::wire-close wire))
              (check typed "malformed keymap payload typed")
              (check (= -1 (fd-flags fd 1)) "malformed payload FD closed")))
          (let* ((fd (bytes-fd #())) (wire (wl::%make-wire :fds (list fd)))
                 (state (wl::make-wayland-state :wire wire)))
            (wl::keyboard-event state 0 #(0 0 0 0 0 0 0 0))
            (check (= -1 (fd-flags fd 1)) "unknown format closes FD")
            (check (null (wl::wire-fds wire)) "unknown format queue drained")
            (wl::wire-close wire))
          (check (= baseline (fd-count)) "exact FD baseline"))
      (setf (symbol-function 'wl::%keymap-pread) original)))
  (format t "~&(:XKB-SAFETY-CHECKS ~D :PASSED T)~%" *checks*)
  t)
