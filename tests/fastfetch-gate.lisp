;;;; Real host/PTY/engine/display acceptance, driven by fastfetch-gate.sh.
(load (merge-pathnames "../scripts/bootstrap.lisp" *load-truename*))
(asdf:load-system "lispterm")

(defun evidence-file (name)
  (merge-pathnames name (uiop:ensure-directory-pathname (uiop:getenv "LISPTERM_FASTFETCH_ARTIFACTS"))))
(defun write-evidence (name value)
  (with-open-file (out (evidence-file name) :direction :output :if-exists :supersede)
    (let ((*print-pretty* t)) (write value :stream out) (terpri out))))
(defun grid-text (host)
  (let ((session (lispterm::host-session host)))
    (sb-thread:with-mutex ((lispterm::session-lock session))
      (let ((screen (lispterm::session-screen session)))
        (with-output-to-string (out)
          (dotimes (row (lispterm.engine:rows screen))
            (dotimes (column (lispterm.engine:columns screen))
              (write-char (or (lispterm.engine:cell-character
                               (lispterm.engine:cell-at screen row column)) #\Space) out))
            (terpri out)))))))
;; Observe bytes returned by the real PTY reader, without rerouting child stdio.
;; This dedicated test process opens exactly one host; production definitions on
;; disk and the parent image are untouched.
(let ((reader (symbol-function 'lispterm.pty:pty-read)))
  (setf (symbol-function 'lispterm.pty:pty-read)
        (lambda (&rest arguments)
          (let ((bytes (apply reader arguments)))
            (when (and (vectorp bytes) (plusp (length bytes)))
              (with-open-file (out (evidence-file "transcript.raw") :direction :output
                                   :element-type '(unsigned-byte 8)
                                   :if-exists :append :if-does-not-exist :create)
                (write-sequence bytes out)))
            bytes))))
(let* ((backend (if (string= (uiop:getenv "LISPTERM_FASTFETCH_BACKEND") "wayland") :wayland :x11))
       (nonce (uiop:getenv "LISPTERM_FASTFETCH_NONCE"))
       (host nil))
  (when (eq backend :wayland) (assert (null (uiop:getenv "DISPLAY"))))
  (unwind-protect
       (progn
         (setf host (lispterm:open :backend backend :rows 32 :columns 120
                     :title (format nil "Lispterm ~a Fastfetch" (string-downcase (symbol-name backend)))
                     :argv (list (uiop:getenv "LISPTERM_FASTFETCH_BASH")
                                 (namestring (evidence-file "child.sh")))))
         (loop with deadline = (+ (get-internal-real-time) (* 30 internal-time-units-per-second))
               for status = (lispterm:status host)
               for text = (grid-text host)
               when (and (eq (getf status :process-state) :exited)
                         (search nonce text) (search "FASTFETCH_EXIT=0" text)
                         (> (getf status :frames) 0)) do (return)
               do (assert (< (get-internal-real-time) deadline) ()
                          "Fastfetch host timeout: ~s errors ~s" status (lispterm:host-errors host))
                  (sleep .05))
         (let* ((status (lispterm:status host))
                (process (lispterm.pty:pty-process (lispterm::session-pty (lispterm::host-session host))))
                (text (grid-text host)))
           (assert (zerop (lispterm.pty:process-exit-code process)))
           (assert (zerop (getf status :error-count)))
           (let* ((metrics (getf status :geometry)) (driver (getf metrics :driver)))
             (assert (eq :gpu (getf metrics :renderer)))
             (assert (and (getf driver :device-associated-p) (not (getf driver :software-p))))
             (assert (and (plusp (getf metrics :draw-calls)) (plusp (getf metrics :readbacks)))))
           (assert (search "Kernel" text))
           (assert (search "Memory" text))
           (with-open-file (out (evidence-file "grid.txt") :direction :output :if-exists :supersede)
             (write-string text out))
           (write-evidence "host.sexp" (list :backend backend :display (uiop:getenv "DISPLAY")
               :wayland-display (uiop:getenv "WAYLAND_DISPLAY") :nonce nonce
               :host status :fastfetch-exit 0 :errors (lispterm:host-errors host))))
         (sleep .5)
         (write-evidence "ready" :ready)
         (loop repeat 600 until (probe-file (evidence-file "captured")) do (sleep .05)
               finally (assert (probe-file (evidence-file "captured")))))
    (when host (lispterm:close host))))
(format t "Fastfetch host evidence passed.~%")
