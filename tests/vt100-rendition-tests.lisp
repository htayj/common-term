;;;; Deterministic engine and framebuffer rendition checks, no display connection.
(defpackage #:lispterm.rendition.tests
  (:use #:cl) (:export #:run-tests))
(in-package #:lispterm.rendition.tests)
(defvar *checks* 0)
(defun check (value &optional label)
  (incf *checks*) (assert value () "Rendition check failed: ~s" label))
(defun feed (screen text)
  (lispterm.engine:feed screen (babel:string-to-octets text :encoding :utf-8)))
(defun esc (screen tail) (feed screen (concatenate 'string (string #\Escape) tail)))
(defun character-at (screen x y)
  (lispterm.engine:cell-character (lispterm.engine:cell-at screen y x)))

(defun logical-row-tests ()
  (dolist (width '(80 132))
    (dolist (selector '(#\3 #\4 #\6))
      (let* ((s (lispterm.engine:make-screen :columns width :rows 4)) (half (/ width 2)))
        (feed s (make-string width :initial-element #\A))
        (esc s (format nil "#~c" selector))
        (check (= half (lispterm.engine:logical-columns s 0)) :logical-columns)
        (check (= (1- half) (lispterm.engine:cursor-column s)) :designation-clamp)
        (loop for col from half below width do
          (check (eql #\A (character-at s col 0)) :designation-preserves-hidden))
        (esc s "#5")
        (check (= width (lispterm.engine:logical-columns s 0)) :single-width)
        (loop for col from half below width do
          (check (eql #\A (character-at s col 0)) :single-restores-suffix))
        (esc s (format nil "#~c" selector))
        (esc s "[1;1H")
        (feed s (make-string half :initial-element #\B))
        (check (= (1- half) (lispterm.engine:cursor-column s)) :deferred-wrap-x)
        (check (nerimux/terminal/types:screen-pending-wrap s) :deferred-wrap)
        (feed s "C")
        (check (= 1 (lispterm.engine:cursor-row s)) :wrap-next-row)
        (check (eql #\C (character-at s 0 1)) :wrap-character)
        ;; CUP uses the destination row's width; vertical movements clamp too.
        (esc s (format nil "[1;~dH" width))
        (check (= (1- half) (lispterm.engine:cursor-column s)) :cup-clamp)
        (esc s "[2;1H") (esc s (format nil "[~dC" width))
        (check (= (1- width) (lispterm.engine:cursor-column s)) :single-right)
        (esc s "[A")
        (check (= (1- half) (lispterm.engine:cursor-column s)) :vertical-clamp)
        (esc s "[999C")
        (check (= (1- half) (lispterm.engine:cursor-column s)) :double-right)
        (feed s (string #\Tab))
        (check (= (1- half) (lispterm.engine:cursor-column s)) :tab-clamp)
        ;; Last logical cell, not a hidden physical cell, is erased/edited.
        (esc s "[1;1H") (feed s (make-string half :initial-element #\D))
        (esc s (format nil "[1;~dH" (1- half))) (esc s "[K")
        (check (eql #\D (character-at s (- half 3) 0)) :el-preserves-prefix)
        (check (eql #\Space (character-at s (- half 2) 0)) :el-start)
        (check (eql #\Space (character-at s (1- half) 0)) :el-end)
        (esc s "[1;1H") (feed s "XYZ") (esc s "[1;1H") (esc s "[P")
        (check (eql #\Y (character-at s 0 0)) :dch)
        (check (eql #\Space (character-at s (1- half) 0)) :dch-tail)
        (esc s "[@")
        (check (eql #\Space (character-at s 0 0)) :ich)
        (check (eql #\Y (character-at s 1 0)) :ich-shift)
        ;; EL preserves size; ED2 explicitly resets every line without moving cursor.
        (esc s "[2K")
        (check (= half (lispterm.engine:logical-columns s 0)) :el-keeps-size)
        (esc s "[2;3H") (esc s "#6") (esc s "[2J")
        (check (= 1 (lispterm.engine:cursor-row s)) :ed-keeps-row)
        (check (= 2 (lispterm.engine:cursor-column s)) :ed-keeps-column)
        (dotimes (row 4) (check (eq :single (lispterm.engine:line-size s row)) :ed-single))
        ;; DECALN fills the full physical pattern, including formerly doubled rows.
        (esc s "#6") (esc s "#8")
        (dotimes (row 4)
          (check (eq :single (lispterm.engine:line-size s row)) :decaln-single)
          (dotimes (col width) (check (eql #\E (character-at s col row)) :decaln-pattern)))))))

(defun physical-row (screen row)
  "Snapshot complete cell values, including attributes and hidden columns."
  (loop for col below (lispterm.engine:columns screen)
        collect (copy-structure (lispterm.engine:cell-at screen row col))))

(defun restoration-tests ()
  (dolist (width '(5 80 132))
    (dolist (selector '(#\3 #\4 #\6))
      (let* ((s (lispterm.engine:make-screen :columns width :rows 4))
             (half (floor width 2))
             (pattern (coerce (loop for col below width
                                    collect (char "This-is-a-long-line-" (mod col 20)))
                              'string)))
        (esc s "[1;4;31;44m")
        (feed s pattern)
        (let ((expected (physical-row s 0)))
          (check (= 4 (nerimux/terminal:cell-bg (nth (1- width) expected))) :fixture-background)
          (dotimes (cycle 3)
            (esc s (format nil "#~c" selector))
            (check (equalp expected (physical-row s 0)) :designation-complete-cells)
            (check (not (nerimux/terminal/types:screen-pending-wrap s)) :designation-cancels-wrap)
            ;; Writes reach only the visible logical positions.
            (esc s "[1;1H") (feed s "X")
            (esc s (format nil "[1;~dH" half)) (feed s "Z")
            (setf (first expected) (copy-structure (lispterm.engine:cell-at s 0 0))
                  (nth (1- half) expected) (copy-structure (lispterm.engine:cell-at s 0 (1- half))))
            (esc s "#5")
            (check (equalp expected (physical-row s 0)) :restores-full-pattern-and-attributes))
          (esc s (format nil "#~c" selector))
          ;; Logical editing must neither erase nor shift the hidden suffix.
          (dolist (operation '("[2K" "[@" "[P"))
            (esc s "[1;1H") (esc s operation)
            (check (equalp (nthcdr half expected) (nthcdr half (physical-row s 0)))
                   (list :hidden-edit-isolation operation)))
          (let ((edited (physical-row s 0)))
            (esc s "#5")
            (check (equalp edited (physical-row s 0)) :restores-edited-prefix-with-hidden-suffix))
          (esc s (format nil "#~c" selector))
          (esc s "[2J")
          (dotimes (row 4)
            (check (eq :single (lispterm.engine:line-size s row)) :full-ed-removes-designation)
            (dotimes (col width)
              (check (eql #\Space (character-at s col row)) :full-ed-clears-physical-cells))))))))

(defun hidden-row-motion-tests ()
  (dolist (width '(80 132))
    (dolist (operation '("[L" "[M" "M" "D"))
      (let ((s (lispterm.engine:make-screen :columns width :rows 4)))
        (loop for selector in '(#\3 #\4 #\6 #\6) for row from 0 do
          (esc s (format nil "[~d;1H" (1+ row)))
          (esc s (format nil "[~dm" (+ 41 row)))
          (feed s (make-string width :initial-element (code-char (+ 65 row))))
          (esc s (format nil "#~c" selector)))
        (let* ((down (member operation '("[L" "M") :test #'equal))
               (source-row (if down 0 1))
               (destination-row (if down 1 0))
               (blank-row (if down 0 3))
               (saved (physical-row s source-row))
               (size (lispterm.engine:line-size s source-row)))
          (esc s (if (equal operation "D") "[4;1H" "[1;1H"))
          (esc s operation)
          (check (eq size (lispterm.engine:line-size s destination-row)) :motion-copies-size)
          (check (equalp saved (physical-row s destination-row)) :motion-copies-hidden-cells)
          (esc s (format nil "[~d;1H" (1+ destination-row))) (esc s "#5")
          (check (equalp saved (physical-row s destination-row)) :motion-restores-hidden-cells)
          (check (eq :single (lispterm.engine:line-size s blank-row)) :exposed-row-single)
          (dotimes (col width)
            (check (eql #\Space (character-at s col blank-row)) :exposed-row-physically-cleared)))))))

(defun row-motion-tests ()
  (dolist (operation '("[L" "[M" "M" "D"))
    (let ((s (lispterm.engine:make-screen :columns 80 :rows 4)))
      (esc s "#3") (feed s "A")
      (esc s "[2;1H") (esc s "#4") (feed s "B")
      (esc s "[3;1H") (esc s "#6") (feed s "C")
      (esc s (if (equal operation "D") "[4;1H" "[1;1H"))
      (esc s operation)
      (cond ((member operation '("[L" "M") :test #'equal)
             (check (eq :single (lispterm.engine:line-size s 0)) :blank-top)
             (check (eq :double-height-top (lispterm.engine:line-size s 1)) :top-shift)
             (check (eq :double-height-bottom (lispterm.engine:line-size s 2)) :bottom-shift)
             (check (eql #\A (character-at s 0 1)) :content-shift-down))
            (t
             (check (eq :double-height-bottom (lispterm.engine:line-size s 0)) :row-up)
             (check (eq :double-width (lispterm.engine:line-size s 1)) :row-up-width)
             (check (eq :single (lispterm.engine:line-size s 3)) :blank-bottom)
             (check (eql #\B (character-at s 0 0)) :content-shift-up))))))

(defun test-display (&optional (columns 4) (rows 2))
  (let* ((font (ltd::load-font nil 16))
         (d (ltd::make-display :font font :owner sb-thread:*current-thread*)))
    (ltd::resize-display d (* columns 8) (* rows 16)) d))
(defun pixel (display x y)
  (aref (ltd::display-framebuffer display) (+ x (* y (ltd::display-width display)))))
(defun grid (cell &optional (columns 4) (rows 2))
  (make-array (list rows columns) :initial-element cell))

(defun raster-tests ()
  (let* ((d (test-display)) (font (ltd::display-font d))
         (glyph (ltd::glyph-bitmap font #\E)))
    (dolist (size '(:double-width :double-height-top :double-height-bottom))
      (ltd:draw-frame d (grid (ltd:make-cell :char #\E :fg #xffffff :bg #x123456
                                           :line-size size)))
      (dotimes (y 16) (dotimes (x 32)
        (let* ((gx (floor (mod x 16) 2))
               (gy (case size (:double-height-top (floor y 2))
                              (:double-height-bottom (floor (+ y 16) 2)) (otherwise y)))
               (expected (if (= 1 (aref glyph (+ gx (* gy 8)))) #xffffffff #xff123456)))
          (check (= expected (pixel d x y)) (list size x y)))))
      ;; Full row's physical pixels must have damage coverage.
      (dotimes (x 32)
        (check (some (lambda (r) (destructuring-bind (rx ry rw rh) r
                                  (and (<= rx x) (< x (+ rx rw)) (<= ry 0) (< 0 (+ ry rh)))))
                     (ltd::display-damage d)) :physical-damage)))
    ;; Reverse + cell inverse cancel for every foreground/background pixel.
    (let* ((ordinary (grid (ltd:make-cell :char #\E :fg #xabcdef :bg #x123456)))
           (inverse (grid (ltd:make-cell :char #\E :fg #xabcdef :bg #x123456 :inverse t))))
      (ltd:draw-frame d ordinary)
      (let ((before (copy-seq (ltd::display-framebuffer d))))
        (ltd:draw-frame d inverse :reverse-screen t)
        (check (equalp before (ltd::display-framebuffer d)) :reverse-inverse-parity)
        (ltd:draw-frame d ordinary :reverse-screen t)
        (check (not (equalp before (ltd::display-framebuffer d))) :global-reverse)
        (ltd:draw-frame d ordinary)
        (check (equalp before (ltd::display-framebuffer d)) :reverse-restored)))
    ;; Blink suppresses glyph and underline, never the background.
    (let ((g (grid (ltd:make-cell :char #\E :fg #xffffff :bg #x123456
                                 :blink t :underline t :line-size :double-width))))
      (ltd:draw-frame d g :blink-phase t)
      (let ((visible (copy-seq (ltd::display-framebuffer d))))
        (setf (ltd::display-damage d) nil)
        (ltd:draw-frame d g :blink-phase nil)
        (check (every (lambda (p) (= p #xff123456)) (ltd::display-framebuffer d)) :blink-background)
        (check (ltd::display-damage d) :blink-damage)
        (ltd:draw-frame d g :blink-phase t)
        (check (equalp visible (ltd::display-framebuffer d)) :blink-restored)))
    ;; A line-size-only change must redraw, even with identical characters.
    (let ((g (grid (ltd:make-cell :char #\E :line-size :double-height-top))))
      (ltd:draw-frame d g)
      (let ((top (copy-seq (ltd::display-framebuffer d))))
        (setf (ltd::display-damage d) nil)
        (ltd:draw-frame d (grid (ltd:make-cell :char #\E :line-size :double-height-bottom)))
        (check (not (equalp top (ltd::display-framebuffer d))) :half-toggle)
        (check (ltd::display-damage d) :half-damage)))))

(defun odd-width-tests ()
  ;; The unused strip extends the last logical cell's background, not its cursor.
  ;; Width one instead has one clipped doubled cell and no background strip.
  (dolist (columns '(1 3 5 7))
    (dolist (size '(:double-width :double-height-top :double-height-bottom))
      (let* ((d (test-display columns 1)) (logical (max 1 (floor columns 2)))
             (edge (* logical 16))
             (g (grid (ltd:make-cell :char #\Space :fg #xabcdef :bg #x123456
                                     :line-size size) columns 1)))
        (setf (aref g 0 (1- logical))
              (ltd:make-cell :char #\Space :fg #x987654 :bg #x345678
                             :line-size size :blink t))
        (ltd:draw-frame d (grid (ltd:make-cell :char #\Space :bg #xff0000) columns 1))
        (dolist (inverse '(nil t))
          (setf (ltd::cell-inverse (aref g 0 (1- logical))) inverse)
          (dolist (reverse '(nil t))
            (dolist (blink '(nil t))
              (dolist (cursor '(nil t))
                (setf (ltd::display-damage d) nil)
                (ltd:draw-frame d g :reverse-screen reverse :blink-phase blink
                                   :cursor-visible cursor :cursor-row 0 :cursor-col (1- logical))
                (dotimes (y 16)
                  (dotimes (x (* columns 8))
                    (let* ((strip (>= x edge))
                           (last (>= x (* (1- logical) 16)))
                           (swap (oddp (count-if #'identity
                                                (list reverse (and last inverse)
                                                      (and last (not strip) cursor)))))
                           (color (if last (if swap #x987654 #x345678)
                                           (if swap #xabcdef #x123456))))
                      (check (= (logior #xff000000 color) (pixel d x y))
                             (list :odd-background columns size inverse reverse blink cursor x y)))))))))
        ;; A last-cell-only change must repaint the strip without a row change.
        (ltd:draw-frame d g)
        (setf (ltd::display-damage d) nil
              (ltd::cell-bg (aref g 0 (1- logical))) #x456789)
        (ltd:draw-frame d g)
        (when (> columns 1)
          (check (member (list edge 0 8 16) (ltd::display-damage d) :test #'equal)
                 :odd-strip-damage)
          (check (every (lambda (r) (destructuring-bind (x y w h) r
                                     (and (<= 0 x) (<= (+ x w) (* columns 8))
                                          (= y 0) (= h 16))))
                        (ltd::display-damage d)) :odd-damage-bounds))
        (let ((pixels (copy-seq (ltd::display-framebuffer d))))
          (setf (ltd::display-damage d) nil)
          (ltd:draw-frame d g)
          (check (null (ltd::display-damage d)) :odd-identical-frame-no-damage)
          (check (equalp pixels (ltd::display-framebuffer d)) :odd-identical-frame-pixels))
        (ltd:draw-frame d (grid (ltd:make-cell :char #\Space :bg #x765432) columns 1))
        (check (every (lambda (p) (= p #xff765432)) (ltd::display-framebuffer d))
               :odd-return-to-single))))
  ;; Wide glyphs stop at the logical edge; width one clips rather than drops.
  (dolist (columns '(1 3 5 7))
    (dolist (size '(:double-width :double-height-top :double-height-bottom))
      (let* ((d (test-display columns 1)) (logical (max 1 (floor columns 2)))
             (g (grid (ltd:make-cell :char #\Space :fg #xffffff :bg #x123456
                                     :line-size size) columns 1))
             (edge (* logical 16))
             (glyph (ltd::glyph-bitmap (ltd::display-font d) #\E)))
        (setf (aref g 0 (1- logical))
              (ltd:make-cell :char #\E :width 2 :fg #xffffff :bg #x123456
                             :blink t :underline t :line-size size))
        (ltd:draw-frame d g)
        (dotimes (y 16)
          (dotimes (x (* columns 8))
            (let* ((dx (- x (* (1- logical) 16)))
                   (gy (case size (:double-height-top (floor y 2))
                                  (:double-height-bottom (floor (+ y 16) 2)) (otherwise y)))
                   (ink (and (<= 0 dx) (< x edge)
                             (or (= 1 (aref glyph (+ (floor dx 2) (* gy 8)))) (= gy 14)))))
              (check (= (if ink #xffffffff #xff123456) (pixel d x y)) :odd-glyph-clipping))))
        (ltd:draw-frame d g :blink-phase nil)
        (check (every (lambda (p) (= p #xff123456)) (ltd::display-framebuffer d))
               :odd-blink-background)))))

(defun scheduler-tests ()
  (let* ((s (lispterm::make-session nil 2 4)) (screen (lispterm::session-screen s))
         (d (test-display)))
    (setf (lispterm::session-last-title s) "")
    (esc screen "[?25l") (esc screen "[5m") (feed screen "E")
    (lispterm::render-session s d :now 0)
    (check (lispterm::session-blink-visible s) :blink-visible)
    (check (lispterm::session-blink-phase s) :initial-phase)
    (let ((frames (lispterm::session-frames s))
          (on (copy-seq (ltd::display-framebuffer d))))
      (lispterm::render-session s d :now 49/100)
      (check (= frames (lispterm::session-frames s)) :no-early-frame)
      (lispterm::render-session s d :now 1/2)
      (check (= (1+ frames) (lispterm::session-frames s)) :phase-frame)
      (check (not (lispterm::session-blink-phase s)) :opposite-phase)
      (check (not (equalp on (ltd::display-framebuffer d))) :phase-pixels)
      (lispterm::render-session s d :now 1)
      (check (equalp on (ltd::display-framebuffer d)) :phase-pixels-restored)
      (esc screen "[0m") (esc screen "[2J")
      (lispterm::render-session s d :now 11/10)
      (check (not (lispterm::session-blink-visible s)) :stop-empty-blink)
      (let ((stopped (lispterm::session-frames s)))
        (lispterm::render-session s d :now 100)
        (check (= stopped (lispterm::session-frames s)) :no-idle-animation)))))

(defun ed-partial-tests ()
  (dolist (mode '(0 1))
    (dolist (complete '(nil t))
      (let ((s (lispterm.engine:make-screen :columns 80 :rows 4)))
        (dotimes (row 4) (esc s (format nil "[~d;1H" (1+ row))) (esc s "#6"))
        (esc s (format nil "[2;~dH" (if complete (if (= mode 0) 1 40) 20)))
        (esc s "[44m")
        (esc s (format nil "[~dJ" mode))
        (check (eq (if complete :single :double-width) (lispterm.engine:line-size s 1))
               :ed-current-line-completion)
        (dotimes (row 4)
          (unless (= row 1)
            (check (eq (if (if (= mode 0) (> row 1) (< row 1)) :single :double-width)
                       (lispterm.engine:line-size s row)) :ed-complete-lines)))
        ;; Newly addressable cells on a fully erased row carry the erase background.
        (let ((row (if (= mode 0) 3 0)))
          (check (= 4 (nerimux/terminal:cell-bg (lispterm.engine:cell-at s row 79))) :ed-new-background))))))

(defun styled-scale-tests ()
  (dolist (style '((:bold t) (:underline t) (:inverse t) (:bold t :underline t :inverse t)))
    (let* ((single (test-display)) (scaled (test-display))
           (base (apply #'ltd:make-cell :char #\E :fg #xabcdef :bg #x123456 style)))
      (ltd:draw-frame single (grid base))
      (dolist (size '(:double-width :double-height-top :double-height-bottom))
        (let ((cell (ltd::copy-cell base)))
          (setf (ltd::cell-line-size cell) size)
          (ltd:draw-frame scaled (grid cell))
          (dotimes (y 16) (dotimes (x 16)
            (check (= (pixel scaled x y)
                      (pixel single (floor x 2)
                             (case size (:double-height-top (floor y 2))
                                        (:double-height-bottom (floor (+ y 16) 2)) (otherwise y))))
                   (list :styled-scale size style x y)))))))))

(defun cursor-composition-tests ()
  (dolist (inverse '(nil t))
    (dolist (reverse '(nil t))
      (dolist (cursor '(nil t))
        (let* ((d (test-display))
               (g (grid (ltd:make-cell :char #\E :fg #xabcdef :bg #x123456 :inverse inverse
                                      :line-size :double-width)))
               (glyph (ltd::glyph-bitmap (ltd::display-font d) #\E))
               (swap (oddp (count-if #'identity (list inverse reverse cursor)))))
          (ltd:draw-frame d g :reverse-screen reverse :cursor-visible cursor :cursor-row 0 :cursor-col 0)
          (dotimes (y 16) (dotimes (x 16)
            (let ((ink (= 1 (aref glyph (+ (floor x 2) (* y 8))))))
              (check (= (pixel d x y)
                        (if (eql ink swap) #xff123456 #xffabcdef))
                     (list :cursor-parity inverse reverse cursor x y))))))))))

(defun resize-tests ()
  (let ((s (lispterm.engine:make-screen :columns 80 :rows 4)))
    ;; These columns are genuinely removed by the physical shrink, not hidden.
    (feed s (make-string 80 :initial-element #\Q))
    (esc s "[1;1H")
    (esc s "#6") (feed s (make-string 40 :initial-element #\R))
    (esc s "[4;1H") (esc s "#3") (esc s "[1;40H")
    (feed s "R")
    (check (nerimux/terminal/types:screen-pending-wrap s) :resize-before-wrap)
    ;; Exercise the native engine API, not an adapter-only repair.
    (nerimux/terminal:screen-resize s 40 2)
    (check (= 19 (lispterm.engine:cursor-column s)) :resize-logical-clamp)
    (check (not (nerimux/terminal/types:screen-pending-wrap s)) :resize-cancels-wrap)
    (check (null (gethash 3 (nerimux/terminal:screen-line-sizes s))) :resize-prunes-row-size)
    (loop for col below 40 do
      (check (eql #\R (character-at s col 0)) :resize-preserves-physical-overlap))
    (nerimux/terminal:screen-resize s 80 4)
    (loop for col below 40 do
      (check (eql #\R (character-at s col 0)) :growth-keeps-physical-overlap))
    (loop for col from 40 below 80 do
      (check (eql #\Space (character-at s col 0)) :growth-blanks-new-physical-columns))
    (esc s "#5")
    (loop for col below 40 do
      (check (eql #\R (character-at s col 0)) :resize-restores-retained-suffix))
    (check (eq :single (lispterm.engine:line-size s 3)) :resize-no-resurrected-row-size))
  (let* ((session (lispterm::make-session nil 2 4))
         (s (lispterm::session-screen session)) (d (test-display)))
    (setf (lispterm::session-last-title session) "")
    (esc s "[?25l") (esc s "#6") (feed s "E")
    (lispterm::render-session session d :now 0)
    (let ((frames (lispterm::session-frames session)))
      (ltd::resize-display d 16 32)
      (lispterm.engine:resize s 2 2)
      (lispterm::render-session session d :now 1/10)
      (check (= (1+ frames) (lispterm::session-frames session)) :resize-forces-frame)
      (check (plusp (count #xffebdbb2 (ltd::display-framebuffer d))) :resize-redraws-glyph))))

(defmethod ltd::backend-blit ((backend (eql :rendition-test-failure)) display framebuffer rectangles)
  (declare (ignore display framebuffer rectangles))
  (error "Injected frame publication failure"))

(defun failed-phase-tests ()
  (let* ((s (lispterm::make-session nil 2 4)) (screen (lispterm::session-screen s))
         (d (test-display)))
    (setf (lispterm::session-last-title s) "")
    (esc screen "[?25l") (esc screen "[5m") (feed screen "E")
    (lispterm::render-session s d :now 0)
    (let ((frames (lispterm::session-frames s)))
      (setf (ltd::display-open-p d) t (ltd::display-backend d) :rendition-test-failure)
      (check (handler-case (progn (lispterm::render-session s d :now 1/2) nil)
               (simple-error () t)) :phase-present-failure)
      (check (lispterm::session-blink-phase s) :failed-frame-keeps-published-phase)
      (check (= frames (lispterm::session-frames s)) :failed-frame-counter)
      (check (ltd::display-damage d) :failed-frame-retains-damage)
      (setf (ltd::display-open-p d) nil)
      (lispterm::render-session s d :now 1/2)
      (check (not (lispterm::session-blink-phase s)) :retry-publishes-phase)
      (check (= (1+ frames) (lispterm::session-frames s)) :retry-publishes-frame))))

(defmethod ltd::backend-blit ((backend (eql :rendition-test-odd-retry)) display framebuffer rectangles)
  (declare (ignore display))
  (check (member '(32 0 8 16) rectangles :test #'equal) :retry-submits-strip)
  (check (= #xff123456 (aref framebuffer 39)) :retry-submits-strip-pixels))

(defun odd-retry-tests ()
  (let* ((d (test-display 5 1))
         (g (grid (ltd:make-cell :char #\Space :bg #x123456 :line-size :double-width) 5 1)))
    (ltd:draw-frame d (grid (ltd:make-cell :char #\Space :bg #xff0000) 5 1))
    (setf (ltd::display-damage d) nil)
    (ltd:draw-frame d g)
    (let ((damage (copy-tree (ltd::display-damage d)))
          (pixels (copy-seq (ltd::display-framebuffer d))))
      (setf (ltd::display-open-p d) t (ltd::display-backend d) :rendition-test-failure)
      (check (handler-case (progn (ltd:present d) nil) (simple-error () t)) :odd-present-failure)
      (check (member '(32 0 8 16) (ltd::display-damage d) :test #'equal) :failed-present-keeps-strip)
      (ltd:draw-frame d g)
      (check (equal damage (ltd::display-damage d)) :retry-cached-damage)
      (check (equalp pixels (ltd::display-framebuffer d)) :retry-cached-pixels)
      (setf (ltd::display-backend d) :rendition-test-odd-retry)
      (ltd:present d)
      (check (null (ltd::display-damage d)) :retry-clears-damage))))

(defun run-tests ()
  (setf *checks* 0)
  (logical-row-tests) (restoration-tests) (hidden-row-motion-tests)
  (ed-partial-tests) (row-motion-tests)
  (styled-scale-tests) (raster-tests) (cursor-composition-tests) (odd-width-tests)
  (scheduler-tests) (resize-tests) (failed-phase-tests) (odd-retry-tests)
  (format t "VT100 RENDITION PASS: ~d checks~%" *checks*) t)
