(load (merge-pathnames "run-display-tests.lisp" *load-truename*))
(require :sb-bsd-sockets)
(asdf:load-system "xclhb")
(load (merge-pathnames "../src/display/x11.lisp" *load-truename*))
(in-package #:lispterm.display)
(let* ((name (or (uiop:getenv "LISPTERM_TEST_DISPLAY") ":100"))
       (server nil) (d nil)
       (xdotool (or (uiop:getenv "XDOTOOL") "xdotool")))
 (labels ((start-server ()
            (setf server (uiop:launch-program (list "Xvfb" name "-screen" "0" (format nil "1024x768x~a" (or (uiop:getenv "LISPTERM_TEST_DEPTH") "24")) "-nolisten" "tcp" "-ac") :output :stream :error-output :output))
            (loop repeat 100 until (probe-file (format nil "/tmp/.X11-unix/X~a" (subseq name 1))) do (sleep 0.02)))
          (stop-server () (when server (uiop:terminate-process server) (uiop:wait-process server) (setf server nil)))
          (xd (&rest args) (uiop:run-program (append (list "env" (format nil "DISPLAY=~a" name) xdotool) args) :output :string))
          (until-event (predicate)
            (loop repeat 200 for events = (poll-events d :timeout 0.01)
                  for found = (find-if predicate events) when found return found
                  finally (error "Expected X11 event did not arrive"))))
  (unwind-protect
      (progn
       (start-server)
       (let ((original (uiop:getenv "DISPLAY")))
         (setf d (open-display :backend :x11 :display-name name :columns 60 :rows 20))
        (assert (equal original (uiop:getenv "DISPLAY"))))
       (draw-cells d 1 2 (map 'vector (lambda (c) (make-cell :char c :fg #x83a598)) "Lispterm: native Lisp X11 display"))
       (draw-cells d 3 2 (map 'vector (lambda (c) (make-cell :char c :fg #xb8bb26)) "┌────────────────────────────────────┐"))
       (draw-cells d 4 2 (map 'vector (lambda (c) (make-cell :char c :fg #xb8bb26)) "│ UTF-8 λ  framebuffer + Terminus OTB │"))
       (draw-cells d 5 2 (map 'vector (lambda (c) (make-cell :char c :fg #xb8bb26)) "└────────────────────────────────────┘"))
       (dotimes (i 16) (draw-cells d 8 (+ 2 (* i 3)) (vector (make-cell :char #\Space :bg (palette-color i) :width 2))))
       (set-cursor d 10 2 :visible t) (present d)
       (let ((id (princ-to-string (getf (display-metrics d) :window-id))))
         (assert (string= "common-term" (string-trim '(#\Newline) (xd "getwindowname" id))))
        (xd "windowfocus" id)
        (xd "key" "a")
        (let ((ev (until-event (lambda (e) (and (key-event-p e) (eql #\a (key-event-key e)))))))
         (assert (equalp #(97) (key-event-bytes ev))))
        (xd "key" "Caps_Lock" "a" "Caps_Lock")
        (until-event (lambda (e) (and (key-event-p e) (eql #\A (key-event-key e)))))
        (let ((injector (uiop:launch-program (list "env" (format nil "DISPLAY=~a" name) xdotool "key" "--delay" "100" "U03bb") :output nil)))
          (unwind-protect
              (until-event (lambda (e) (and (key-event-p e) (eql #\λ (key-event-key e)))))
            (uiop:wait-process injector)))
        (xd "key" "ctrl+c")
        (let ((ev (until-event (lambda (e) (and (key-event-p e) (characterp (key-event-key e)) (char-equal #\c (key-event-key e)))))))
         (assert (equalp #(3) (key-event-bytes ev))))
        (xd "windowsize" id "640" "384")
        (let ((ev (until-event #'resize-event-p))) (assert (= 80 (resize-event-columns ev))) (assert (= 24 (resize-event-rows ev))))
        ;; Redraw after the backend's configure event resized the framebuffer.
        (draw-cells d 1 2 (map 'vector (lambda (c) (make-cell :char c :fg #x83a598)) "Lispterm native X11: key + resize verified"))
        (draw-cells d 3 2 (map 'vector (lambda (c) (make-cell :char c :fg #xb8bb26)) "┌────────────────────────────────────┐"))
        (draw-cells d 4 2 (map 'vector (lambda (c) (make-cell :char c :fg #xb8bb26)) "│ UTF-8 λ  actual Terminus OTB glyphs │"))
        (draw-cells d 5 2 (map 'vector (lambda (c) (make-cell :char c :fg #xb8bb26)) "└────────────────────────────────────┘"))
        (dotimes (i 16) (draw-cells d 8 (+ 2 (* i 3)) (vector (make-cell :char #\Space :bg (palette-color i) :width 2))))
        (present d) (sleep 0.1)
        (let* ((s (display-backend-state d))
               (client (lispterm.display.x11::x-state-client s))
               (reply (xclhb:get-image-sync client 2 (lispterm.display.x11::x-state-window s) 0 0 1 1 #xffffffff))
               (bytes (xclhb:get-image-reply-data reply))
               (count (/ (lispterm.display.x11::x-state-bpp s) 8))
               (pixel (loop for i below count sum (ash (aref bytes i) (* 8 (if (zerop (lispterm.display.x11::x-state-byte-order s)) i (- count i 1))))))
                ;; CGA black in the server's native pixel format.
                (expected (logior
                           (lispterm.display.x11::channel-pixel 0 (lispterm.display.x11::x-state-red-mask s))
                           (lispterm.display.x11::channel-pixel 0 (lispterm.display.x11::x-state-green-mask s))
                           (lispterm.display.x11::channel-pixel 0 (lispterm.display.x11::x-state-blue-mask s)))))
          (assert (= pixel expected)))
         (let ((capture (or (uiop:getenv "LISPTERM_X11_CAPTURE")
                            (error "Set LISPTERM_X11_CAPTURE to the native capture path"))))
          (ensure-directories-exist capture)
          (uiop:run-program (list "import" "-display" name "-window" id capture))))
       (stop-server)
       (assert (handler-case (progn (poll-events d :timeout 0.2) nil) (display-connection-lost () t)))
       (close-display d) (close-display d)
       (start-server)
       (setf d (reopen-display d)) (assert (display-open-p d))
       (present d) (close-display d)
       (format t "X11 KEY RESIZE DISCONNECT REOPEN PASS~%"))
    (when d (ignore-errors (close-display d))) (stop-server))))
