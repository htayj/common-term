(defpackage #:lispterm.wayland-tests (:use #:cl) (:export #:run))
(in-package #:lispterm.wayland-tests)
(defun artifact (name) (merge-pathnames name (pathname (or (uiop:getenv "LISPTERM_WAYLAND_ARTIFACTS")
                                                          ".git/autolith-tests/wayland/"))))
(defun marker (name &optional (data t))
  (with-open-file (s (artifact name) :direction :output :if-exists :supersede
                                              :if-does-not-exist :create)
    (write data :stream s) (terpri s)))
(defun render-proof (display)
  (let* ((metrics (ltd:display-metrics display))
         (rows (getf metrics :rows)) (cols (getf metrics :columns))
         (grid (make-array (list rows cols))))
    (dotimes (row rows)
      (dotimes (col cols)
        (setf (aref grid row col)
              (ltd:make-cell :char (if (= row 0) #\= #\Space)
                             :fg #xebdbb2 :bg #x182838))))
    (loop for text in '("LISPTERM  NATIVE WAYLAND" "Common Lisp wire + wl_shm + xdg-shell"
                       "No X11 connection. DISPLAY is unset." "Keyboard input: virtual seat in isolated Sway."
                       "Resize, integer scale, disconnect and reopen gate.")
          for row from 2 do
      (loop for char across text for col from 2 below cols
            do (setf (aref grid row col) (ltd:make-cell :char char :fg #x83a598 :bg #x182838))))
    (ltd:draw-frame display grid) (ltd:present display)))
(defun wire-unit-checks ()
  (let ((wire (lispterm.display.wayland::%make-wire)) (seen nil))
    (setf (gethash 7 (lispterm.display.wayland::wire-handlers wire))
          (lambda (id op body) (push (list id op (lispterm.display.wayland::bytes-u32 body 0)) seen)))
    (let ((packet (concatenate '(vector (unsigned-byte 8))
                               (lispterm.display.wayland::u32-bytes 7)
                               (lispterm.display.wayland::u32-bytes (logior (ash 12 16) 3))
                               (lispterm.display.wayland::u32-bytes #xdeadbeef))))
      (setf (lispterm.display.wayland::wire-bytes wire) (subseq packet 0 7))
      (lispterm.display.wayland:wire-dispatch wire) (assert (null seen))
      (setf (lispterm.display.wayland::wire-bytes wire) packet)
      (lispterm.display.wayland:wire-dispatch wire)
      (assert (equal seen '((7 3 3735928559)))))
    (assert (string= "λ" (lispterm.display.wayland::payload-string
                           (lispterm.display.wayland::wl-string "λ") 0)))))
(defun run ()
  (assert (null (uiop:getenv "DISPLAY")))
  (wire-unit-checks)
  (let ((display nil) (keys nil) (resize-count 0) (scale2 nil) (lost nil)
        (initial-fds (length (directory "/proc/self/fd/*"))))
    (unwind-protect
        (progn
          (setf display (ltd:open-display :backend :wayland :title "Lispterm native Wayland gate"
                                        :columns 100 :rows 40 :font-size 16))
          (render-proof display)
          (marker "ready" (ltd:display-metrics display))
          (loop with deadline = (+ (get-internal-real-time) (* 30 internal-time-units-per-second))
                until (probe-file (artifact "disconnect-requested")) do
            (when (> (get-internal-real-time) deadline) (error "Wayland gate orchestration timed out"))
            (dolist (event (handler-case (ltd:poll-events display :timeout .02)
                             (ltd:display-connection-lost (c)
                               (if (probe-file (artifact "disconnect-requested"))
                                   (progn (setf lost t) nil) (error c)))))
              (typecase event
                (ltd:key-event (push event keys)
                               (marker "keys" (mapcar (lambda (key)
                                                        (list (ltd:key-event-key key)
                                                              (ltd:key-event-modifiers key)))
                                                      (reverse keys))))
                (ltd:resize-event (incf resize-count) (render-proof display)
                                  (marker "resized" (ltd:display-metrics display)))))
            (when (= 2 (getf (ltd:display-metrics display) :buffer-scale))
              (setf scale2 t) (marker "scale2" t))
            (when (and (probe-file (artifact "capture-requested"))
                       (not (probe-file (artifact "capture-ready"))))
              (render-proof display) (marker "capture-ready" t)))
          ;; The harness terminates only its own isolated compositor.
          (loop repeat 200 until lost do
            (handler-case (ltd:poll-events display :timeout .02)
              (ltd:display-connection-lost () (setf lost t))))
          (assert lost)
          (marker "connection-lost")
          (assert (find #\a keys :key #'ltd:key-event-key))
          (assert (find :up keys :key #'ltd:key-event-key))
          (assert (> (count #\b keys :key #'ltd:key-event-key) 1))
          (assert (find-if (lambda (key) (and (eql #\c (ltd:key-event-key key))
                                             (member :control (ltd:key-event-modifiers key)))) keys))
          (assert (plusp resize-count)) (assert scale2)
          (loop with deadline = (+ (get-internal-real-time) (* 15 internal-time-units-per-second))
                until (probe-file (artifact "reopen-requested")) do
            (when (> (get-internal-real-time) deadline) (error "Compositor restart timeout"))
            (sleep .05))
          (setf display (ltd:reopen-display display))
          (assert (ltd:display-open-p display)) (render-proof display)
          (dotimes (i 10) (ltd:poll-events display :timeout .02))
          (ltd:close-display display) (ltd:close-display display)
          ;; FDs are counted in the same process, after all native transport/keymap/pool cleanup.
          (assert (<= (length (directory "/proc/self/fd/*")) initial-fds))
          (marker "passed" (list :native-wayland t :display-unset t :input (length keys)
                                 :resize resize-count :scale2 scale2 :disconnect lost :reopen t
                                 :fd-cleanup t))
          (format t "NATIVE-WAYLAND-GATE PASS~%"))
      (when display (ltd:close-display display)))))
