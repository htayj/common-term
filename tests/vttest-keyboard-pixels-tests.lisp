;;;; Pixel gating controls over stubbed captures: no PNG, tool or font file is used.
;;;; Runtime comparison controls are separate. Entry point: (PIXEL-GATING-CONTROLS).
(in-package :vttest-keyboard-driver-tests)
(load (merge-pathnames "vttest-keyboard-pixels-fixtures.lisp" *load-truename*))

(defun gate-controls (label)
  "Proof, context and font refusals precede any trace step or decode."
  (flet ((gated (r status reason tag)
           (check (and (refused-p r status reason) (null (getf r :trace))) (list label tag))))
    (loop for (prereq timing status) in '((:fail :pass :fail) (:pass :fail :fail)
                                          (:fail :unverified :fail) (:unverified :pass :unverified)
                                          (:pass :unverified :unverified) (nil nil :unverified)
                                          (:passed :pass :unverified))
          do (gated (run-pixels label (pixel-context label) prereq timing) status :proof
                    (list :proof prereq timing)))
    (gated (run-pixels label nil :fail :pass) :fail :proof :fail-before-context)
    (let ((bogus (pixel-context label))
          (other (pixel-context (find label *pixel-labels* :test-not #'equal))))
      (setf (k::case-context-label bogus) "keyboard-bogus")
      (loop for (tag lab ctx prereq) in `((:no-context ,label nil :pass) (:plist ,label (:label ,label) :pass)
                                          (:context-before-unverified ,label nil :unverified)
                                          (:other-label ,label ,other :pass)
                                          (:unknown-label "keyboard-bogus" ,bogus :pass)
                                          (:nil-label nil ,bogus :pass))
            do (gated (run-pixels lab ctx prereq :pass) :fail :context tag)))
    (dolist (octets (list nil (vector) (list 1 2) (vector 1 2)
                          (make-array 0 :element-type '(unsigned-byte 8))))
      (gated (run-pixels label (pixel-context label :octets octets) :pass :pass)
             :fail :oracle-octets (list :font octets)))
    (gated (run-pixels label (pixel-context label :octets nil) :unverified :pass)
           :unverified :proof :proof-before-font)))

(defun link-controls (label)
  "Link refusals trace :PIXELS once on the same context and decode nothing."
  (let* ((names (pixel-names label)) (one (first names)) (final (car (last names))))
    (flet ((linked (ctx status reason tag &rest options)
             (let ((r (apply #'run-pixels label ctx :pass :pass options)))
               (check (and (refused-p r status reason) (traced-once-p r ctx)) (list label tag)))))
      (let ((ctx (pixel-context label)))
        (setf (k::case-context-barriers ctx)
              (remove final (k::case-context-barriers ctx) :key #'car :test #'equal))
        (linked ctx :unverified (list :missing-barrier final) :missing-barrier))
      (let ((ctx (pixel-context label)))
        (setf (getf (cdr (pixel-barrier-entry ctx one)) :status) :late)
        (linked ctx :fail (list :barrier-link one) :barrier-mismatch))
      (let ((ctx (pixel-context label)))
        (setf (getf (cdr (pixel-barrier-entry ctx one)) :target-output) 999
              (second (member :target-output (getf (pixel-event ctx one) :barrier))) 999)
        (linked ctx :fail (list :barrier-link one) :target-mismatch))
      (loop for (tag wrong) in `((:missing ,(remove (second names) names :test #'equal))
                                 (:duplicate ,(list* one one (cddr names)))
                                 (:out-of-order ,(list* (second names) one (cddr names)))
                                 (:extra ,(append names (list (format nil "99-~a-pause02" label)))))
            do (linked (pixel-context label :names wrong) :fail :capture-inventory tag))
      (linked (pixel-context label) :fail :capture-id-tables :table-mismatch
              :extra (list (cons 'vttest-keyboard-cells:capture-ids
                                 (lambda (l) (butlast (pixel-ids l)))))))))

(defun pass-controls (label)
  "All-pass run and per-capture propagation; returns the passing entries."
  (let* ((ctx (pixel-context label)) (r (run-pixels label ctx :pass :pass))
         (names (pixel-names label)) (ids (pixel-ids label)) (entries (getf r :entries)))
    (check (and (eq :pass (getf r :status)) (null (getf r :reasons)) (traced-once-p r ctx)
                (plusp (getf r :glyphs)) (eql 0 (getf r :tools)) (eql 0 (getf r :comparisons))
                (equal names (mapcar #'second (getf r :calls)))
                (every (lambda (c) (and (equal "/fixture/run/" (first c))
                                        (= (* 640 384 4) (length (third c)))
                                        (equal "/fixture/scratch/" (fourth c))))
                       (getf r :calls)))
           (list label :pass-once-in-order))
    (check (equal (mapcar (lambda (e) (mapcar (lambda (k) (getf e k))
                                              '(:label :name :id :pixels :reasons :sha256 :raw)))
                          entries)
                  (mapcar (lambda (n id) (list label n id :pass nil (nth-value 2 (pixel-pass n))
                                               (nth-value 3 (pixel-pass n))))
                          names ids))
           (list label :entries))
    (check (and (every (lambda (n) (eq :pass (k::capture-pixel-status entries n))) names)
                (eq :unverified (k::capture-pixel-status entries "absent")))
           (list label :capture-status))
    (let* ((bad (second names)) (gap (third names))
           (r (run-pixels label (pixel-context label) :pass :pass
                          :result (lambda (n)
                                    (cond ((equal n bad) (values :fail '(:pixel-mismatch) "sha-b" "raw-b"))
                                          ((equal n gap) (values :unverified '(:absent-png) nil nil))
                                          (t (pixel-pass n))))))
           (e (second (getf r :entries))))
      (check (and (eq :fail (getf r :status)) (= (length names) (length (getf r :calls)))
                  (equal (getf r :reasons) (list (list (second ids) :fail) (list (third ids) :unverified)))
                  (equal '(:fail (:pixel-mismatch) "sha-b" "raw-b")
                         (list (getf e :pixels) (getf e :reasons) (getf e :sha256) (getf e :raw)))
                  (eq :fail (k::capture-pixel-status (getf r :entries) bad))
                  (eq :unverified (k::capture-pixel-status (getf r :entries) gap)))
             (list label :per-capture-propagation)))
    entries))

(defun blink-controls (label)
  "Source-backed phase: T is fixed, no expected state holds a blink cell, and a
stubbed blink state is refused before any capture or glyph read."
  (check (eq t k::+blink-phase+) :fixed-blink-phase)
  (check (notany (lambda (id) (some #'vttest-screen-oracle:cell-blink
                                    (getf (vttest-keyboard-cells:expected-state label id) :cells)))
                 (pixel-ids label))
         (list label :no-expected-blink))
  (let ((cells (make-array 1920 :initial-element (vttest-screen-oracle:make-cell))))
    (setf (aref cells 0) (vttest-screen-oracle:make-cell :code 65 :blink t))
    (let ((r (run-pixels label (pixel-context label) :pass :pass
                         :extra (list (cons 'vttest-keyboard-cells:expected-state
                                            (lambda (l i) (declare (ignore l i))
                                              (list :cells cells :cursor '(:row 1 :column 1 :visible t))))))))
      (check (and (eq :unverified (getf r :status)) (untouched-p r)
                  (every (lambda (e) (equal '(:expected-blink-cells) (getf e :reasons))) (getf r :entries)))
             (list label :blink-refused)))))

(defun pixel-gating-controls ()
  "Every pixel gating control for both keyboard cases."
  (aggregate-controls (loop for label in *pixel-labels*
                            do (gate-controls label) (link-controls label) (blink-controls label)
                            append (pass-controls label))))
