;;;; Pure injected-runner tests. All file data is synthetic, not PNG evidence.
(load (merge-pathnames "vttest-vt52-png-adapter.lisp" *load-truename*))
(defpackage #:vttest-vt52-png-adapter-tests
  (:use #:cl) (:export #:run-tests))
(in-package #:vttest-vt52-png-adapter-tests)
(defun bytes (text)
  (map '(vector (unsigned-byte 8)) #'char-code text))
(defun put (path data)
  (with-open-file (s path :direction :output :element-type '(unsigned-byte 8)
                          :if-exists :supersede)
    (write-sequence data s)))
(defun run-tests ()
  (let ((count 0) (path (vttest-vt52-png-adapter::owned-file)))
    (labels ((check (test) (incf count) (assert test))
             (trial (scale mode expected)
               (put path (bytes "clearly synthetic original, not a PNG"))
               (let ((calls 0))
                 (flet ((runner (argv)
                          (incf calls)
                          (check (string= (first argv)
                                         vttest-vt52-png-adapter::*decoder*))
                          (when (eq mode :signal) (error "Synthetic runner error"))
                          (when (= calls 2)
                            (check (equal (subseq argv 2 4) '("-depth" "8")))
                            (check (string= (subseq (fifth argv) 0 5) "rgba:"))
                            (put (subseq (fifth argv) 5)
                                 (make-array (if (eq mode :short) 1
                                                 (* 640 384 scale scale 4))
                                   :element-type '(unsigned-byte 8) :initial-element 255))
                            (when (eq mode :changed)
                              (put path (bytes "different synthetic original"))))
                          (values (cond ((eq mode :nonbytes) "not octets")
                                        ((= calls 1)
                                         (bytes (if (eq mode :dimensions) "641 384"
                                                    (format nil "~d ~d"
                                                            (* 640 scale) (* 384 scale)))))
                                        (t (bytes "synthetic decode stdout")))
                                  (bytes "synthetic stderr")
                                  (case mode (:exit 9) (:decode-exit (if (= calls 2) 7 0))
                                        (:nil-exit nil) (:float-exit 0.0)
                                        (:negative-exit -1) (t 0)))))
                   (handler-case
                       (let ((r (vttest-vt52-png-adapter:decode-original-png
                                 path :scale scale :runner #'runner)))
                         (check (null expected))
                         (check (= calls 2))
                         (check (equal (getf r :sha256-before) (getf r :sha256-after)))
                         (check (string= (getf r :sha256-before)
                                        (vttest-vt52-png-adapter::digest path)))
                         (check (= (getf r :width) (* 640 scale)))
                         (check (= (getf r :height) (* 384 scale)))
                         (check (= (length (getf r :rgba)) (* 640 384 scale scale 4)))
                         (check (eql 0 (getf r :exit)))
                         (check (equalp (getf r :stdout) (bytes "synthetic decode stdout")))
                         (check (equalp (getf r :stderr) (bytes "synthetic stderr")))
                         (check (equal (getf r :argv)
                                       (list vttest-vt52-png-adapter::*decoder*
                                             (namestring (truename path)) "-depth" "8"
                                             (fifth (getf r :argv))))))
                     (vttest-vt52-png-adapter:png-refusal (c)
                       (check (eq expected (vttest-vt52-png-adapter:refusal-reason c)))
                       (when (member mode '(:exit :decode-exit))
                         (let ((e (vttest-vt52-png-adapter:refusal-evidence c)))
                           (check (integerp (getf e :exit)))
                           (check (plusp (getf e :exit)))
                           (check (equalp (getf e :stderr) (bytes "synthetic stderr")))
                           (check (typep (getf e :stdout) '(vector (unsigned-byte 8))))))))))))
      (unwind-protect
           (progn
             (trial 1 :good nil) (trial 2 :good nil)
             (loop for (mode reason) in
                   '((:changed :changed-original) (:exit :decoder-failed)
                     (:decode-exit :decoder-failed) (:dimensions :dimensions)
                     (:short :rgba-length) (:nonbytes :malformed-process-output)
                     (:nil-exit :malformed-process-output)
                     (:float-exit :malformed-process-output)
                     (:negative-exit :malformed-process-output)
                     (:signal :io-or-runner-error))
                   do (trial 1 mode reason))
             (dolist (args (list (list path :scale 3) (list path :scale nil)
                                (list path :scale 1 :decoder-argv '("foreign"))
                                (list (concatenate 'string path "-missing") :scale 1)))
               (check (handler-case
                          (progn (apply #'vttest-vt52-png-adapter:decode-original-png args) nil)
                        (vttest-vt52-png-adapter:png-refusal () t))))
             (format t "~d PNG adapter checks passed; synthetic injected runner only.~%" count)
             count)
        (delete-file path)))))
(run-tests)
