(load (merge-pathnames "../scripts/bootstrap.lisp" *load-truename*))
(asdf:load-system "lispterm")
(defvar *native-original-renderer*)
(defvar *native-renderer-seen*)
(defun native-fd-count ()
  (length (directory #p"/proc/self/fd/*")))
(defun run-native-host-tests ()
  (let* ((backend (if (equal "wayland" (uiop:getenv "LISPTERM_HOST_BACKEND")) :wayland :x11))
          (directory (uiop:ensure-directory-pathname (uiop:getenv "LISPTERM_HOST_ARTIFACTS")))
          (fds-before (native-fd-count))
          (threads-before (sb-thread:list-all-threads))
          (host (lispterm:open :backend backend :title "Lispterm native host" :columns 100 :rows 35
                  :argv '("sh" "-c" "stty raw -echo; printf READY; cat")))
          (session (lispterm::host-session host))
          (screen (lispterm::session-screen session))
          (pid (getf (lispterm:status host) :child-pid)))
    (labels ((text ()
               (let* ((session (lispterm::host-session host)) (screen (lispterm::session-screen session)))
                 (sb-thread:with-mutex ((lispterm::session-lock session))
                   (with-output-to-string (out)
                     (dotimes (r (lispterm.engine:rows screen))
                       (dotimes (c (lispterm.engine:columns screen))
                         (write-char (lispterm.engine:cell-character (lispterm.engine:cell-at screen r c)) out)))))))
             (until (predicate)
               (loop repeat 1000 when (funcall predicate) return t do (sleep .01)
                     finally (error "Native host condition timed out: ~S ~S" (lispterm:status host) (lispterm:host-errors host))))
             (mark (name value)
               (with-open-file (out (merge-pathnames name directory) :direction :output :if-exists :supersede)
                 (prin1 value out) (terpri out))))
      (unwind-protect
           (progn
             (until (lambda () (search "READY" (text))))
             (until (lambda () (plusp (or (getf (getf (lispterm:status host) :geometry) :draw-calls) 0))))
             (let* ((metrics (getf (lispterm:status host) :geometry)) (driver (getf metrics :driver)))
               (assert (eq :gpu (getf metrics :renderer)))
               (assert (and (getf driver :device-associated-p) (not (getf driver :software-p))))
               (assert (plusp (getf metrics :readbacks)))
               (mark "hardware-gpu.sexp" metrics))
             (mark "ready" (lispterm:status host))
             (until (lambda () (search "NATIVEKEY" (text))))
             (mark "keys" t)
             (lispterm::call-host host :detach)
             (lispterm:send-input host "DETACHEDSURVIVE")
             (until (lambda () (search "DETACHEDSURVIVE" (text))))
             (lispterm:reopen host)
             (until (lambda () (eq :attached (getf (lispterm:status host) :state))))
             ;; A real checkpoint validation failure must roll back onto the
             ;; same session/process, after native handles and owner are gone.
             (let ((token (lispterm:quiesce host)) (validation-failed nil))
               (assert (not (getf (lispterm:status host) :worker-alive-p)))
               (assert (null (lispterm::host-display host)))
               (lispterm.gpu::require-no-live-contexts)
               (handler-case
                   (unwind-protect (error "Injected checkpoint validation failure")
                     (lispterm:resume host token))
                 (simple-error () (setf validation-failed t)))
               (assert validation-failed)
               (assert (eq session (lispterm::host-session host)))
               (assert (eq screen (lispterm::session-screen session)))
               (assert (= pid (getf (lispterm:status host) :child-pid)))
               (assert (= 1 (count-if (lambda (thread)
                                       (and (not (member thread threads-before))
                                            (sb-thread:thread-alive-p thread)))
                                     (sb-thread:list-all-threads))))
               (mark "rollback" t))
             (lispterm:send-input host "ROLLBACKSURVIVE")
             (until (lambda () (search "ROLLBACKSURVIVE" (text))))
             (until (lambda () (plusp (or (getf (getf (lispterm:status host) :geometry) :draw-calls) 0))))
             (assert (eq :gpu (getf (getf (lispterm:status host) :geometry) :renderer)))
             ;; Install a DEFUN in this running heap while both PTY and native
             ;; display are live. The owner resolves it on its next frame.
             (let ((original (symbol-function 'lispterm::render-session)))
               ;; The existing owner reads global specials in its own thread.
               (setf *native-original-renderer* original
                     *native-renderer-seen* (sb-thread:make-semaphore))
               (unwind-protect
                    (progn
                      (eval '(defun lispterm::render-session (session display)
                               (sb-thread:signal-semaphore cl-user::*native-renderer-seen*)
                               (funcall cl-user::*native-original-renderer* session display)))
                      (let ((frames (getf (lispterm:status host) :frames)))
                        (lispterm:invalidate host)
                        (assert (sb-thread:wait-on-semaphore *native-renderer-seen* :timeout 3))
                        (until (lambda () (> (getf (lispterm:status host) :frames) frames))))
                      (mark "live-redefinition" t))
               (setf (symbol-function 'lispterm::render-session) original)))
             (mark "capture-ready" (lispterm:status host))
             (until (lambda () (probe-file (merge-pathnames "captured" directory))))
             (assert (null (lispterm:host-errors host)))
             (mark "acceptance" (list :backend backend :rollback t :live-redefinition t
                                      :status (lispterm:status host))))
        (lispterm:close host))
       (lispterm.gpu::require-no-live-contexts)
      (assert (= fds-before (native-fd-count)))
      (assert (null (set-difference (sb-thread:list-all-threads) threads-before)))
      (assert (null (lispterm:status)))
      (mark "passed" (list :backend backend :rollback t :live-redefinition t
                           :fd-cleanup t :thread-cleanup t)))))

(if (member "--native" sb-ext:*posix-argv* :test #'equal)
    (run-native-host-tests)
    (progn
      (load (merge-pathnames "host-tests.lisp" *load-truename*))
      (uiop:symbol-call :lispterm.host.tests :run-tests)))
