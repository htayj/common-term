;;;; Standalone, product-free placement and cooperative-abort controls.
(require :sb-posix)
(in-package :cl-user)
(defparameter *workspace* #p"/home/taylor/projects/lispterm/")
(defparameter *evidence* (merge-pathnames ".build/evidence/screen-area-wayland-placement-native-abort-repair-20261107-a/" *workspace*))
(defparameter *attempt* (pathname (sb-ext:posix-getenv "SCREEN_REPAIR_ATTEMPT")))
(defparameter *checks* nil)
(defun check (name value)
  (unless value (error "Focused check failed: ~s" name))
  (push name *checks*) t)
(defun bytes (path)
  (with-open-file (s path :element-type '(unsigned-byte 8))
    (let ((b (make-array (file-length s) :element-type '(unsigned-byte 8))))
      (assert (= (length b) (read-sequence b s))) b)))
(defun text (path)
  (sb-ext:octets-to-string (bytes path) :external-format :utf-8))
(defun put (path value)
  (with-open-file (s path :direction :output :if-exists :error)
    (let ((*print-pretty* nil) (*print-readably* nil)) (write value :stream s) (terpri s))))
(defun put-text (path value)
  (with-open-file (s path :direction :output :if-exists :error) (write-string value s)))
;; This entry point runs only IPC command-boundary controls, not the abort suite.
(defun placement-command-boundary-tests ()
  (let* ((source (merge-pathnames "current/vttest-screen-native.sh" *attempt*))
         (test (merge-pathnames "focused-tests.lisp" *attempt*))
         (bash "/nix/store/kwyi4bq5s2qgwbhz6cs4gjy57c2zdxws-bash-interactive-5.3p20/bin/bash")
         (jq "/nix/store/4b6f9wb1qak318gk7mxlfkhril6lxpcx-jq-1.8.2-bin/bin/jq"))
    (check :boundary-source-copy (equalp (bytes source) (bytes (merge-pathnames "tests/vttest-screen-native.sh" *workspace*))))
    (check :boundary-test-copy (equalp (bytes test) (bytes (merge-pathnames "tests/vttest-screen-placement-abort-tests.lisp" *workspace*))))
    ;; Suppressed reading checks delimiters without resolving product packages.
    (let ((*read-eval* nil) (*read-suppress* t))
      (with-open-file (s test)
        (loop for form = (read s nil :eof) until (eq form :eof))))
    (check :boundary-test-readable t)
    (labels ((run (name body expected)
               (let* ((base (merge-pathnames name *attempt*))
                      (script (pathname (concatenate 'string (namestring base) ".sh")))
                      (out (concatenate 'string (namestring base) ".stdout"))
                      (err (concatenate 'string (namestring base) ".stderr")))
                 (put-text script (format nil "set -Eeuo pipefail~%source ~s~%jq=~s~%~a~%" (namestring source) jq body))
                 (put (pathname (concatenate 'string (namestring base) ".command.sexp"))
                      (list :program bash :argv (list "--noprofile" "--norc" (namestring script)) :input :null))
                 (let* ((p (sb-ext:run-program bash (list "--noprofile" "--norc" (namestring script))
                                             :input nil :output out :error err :wait t))
                        (code (sb-ext:process-exit-code p)))
                   (put (pathname (concatenate 'string (namestring base) ".exit")) code)
                   (check (list :boundary-exit name) (= expected code))
                   (check (list :boundary-stderr name) (zerop (length (bytes err))))))))
      (dolist (case '(("single" "[{\"success\":true}]" 0)
                      ("false" "[{\"success\":false}]" 1)
                      ("mixed" "[{\"success\":true},{\"success\":false}]" 1)
                      ("extra" "[{\"success\":true},{\"success\":true}]" 1)
                      ("missing" "[{}]" 1) ("empty" "[]" 1)
                      ("object" "{}" 1)
                      ("parse-error" "[{\"success\":true,\"parse_error\":true}]" 1)
                      ("error" "[{\"success\":true,\"error\":\"failed\"}]" 1)))
        (destructuring-bind (name json code) case
          (let ((path (merge-pathnames (concatenate 'string name ".json") *attempt*)))
            (put-text path json)
            (run name (format nil "screen_rule_success ~s" (namestring path)) code))))
      ;; Shell-only fixture at the actual writer boundary. No compositor refusal is injected.
      (dolist (case '(("registered" 0 0 "[{\"success\":true}]" "[{\"success\":true}]" 0)
                      ("first-exit" 2 0 "[{\"success\":true}]" "[{\"success\":true}]" 1)
                      ("second-exit" 0 2 "[{\"success\":true}]" "[{\"success\":true}]" 1)
                      ("first-json" 0 0 "[{\"success\":true},{\"success\":false}]" "[{\"success\":true}]" 1)
                      ("second-json" 0 0 "[{\"success\":true}]" "[]" 1)))
        (destructuring-bind (name first-exit second-exit first-json second-json expected) case
          (let ((dir (merge-pathnames (concatenate 'string name "/") *attempt*)))
            (ensure-directories-exist (merge-pathnames ".reserve" dir))
            (run name
              (format nil "native=~s~%swaymsg=boundary_ipc~%count=0~%boundary_ipc() {~% [[ $# == 1 ]] || return 91~% count=$((count+1))~% local expected~% if [[ $count == 1 ]]; then expected=$(screen_placement_rule floating); else [[ $count == 2 ]] || return 92; expected=$(screen_placement_rule origin); fi~% [[ $1 == \"$expected\" && $1 != *,* ]] || return 93~% printf '%s\\n' \"$1\" >> \"$native/argv\"~% if [[ $count == 1 ]]; then printf '%s\\n' '~a'; return ~d; else printf '%s\\n' '~a'; return ~d; fi~%}~%rc=0; screen_register_placement || rc=$?~%[[ $rc == ~d ]] || exit 94~%[[ -f $native/window-rule-floating.command && -f $native/window-rule-floating.exit ]] || exit 95~%if [[ ~d == 0 && '~a' == '[{\"success\":true}]' ]]; then~% [[ $count == 2 && -f $native/window-rule-origin.command && -f $native/window-rule-origin.exit ]] || exit 96~%else [[ $count == 1 && ! -e $native/window-rule-origin.command ]] || exit 97; fi~%exit \"$rc\""
                      (namestring dir) first-json first-exit second-json second-exit expected first-exit first-json)
              expected))))
      (run "exact-rules" "screen_placement_rule floating; screen_placement_rule origin" 0)
      (let ((expected (format nil "for_window [app_id=~s title=~s] floating enable~%for_window [app_id=~s title=~s] move position 0 0~%"
                              "^org[.]autolith[.]lispterm$" "^Lispterm-screen-owned-run$"
                              "^org[.]autolith[.]lispterm$" "^Lispterm-screen-owned-run$")))
        (check :boundary-exact-owned-criteria (equal expected (text (merge-pathnames "exact-rules.stdout" *attempt*))))
        (check :boundary-complete-ordered-argv (equal expected (text (merge-pathnames "registered/argv" *attempt*)))))
      (let ((shell (text source)))
        (check :boundary-before-recorder
               (< (search "        screen_register_placement || return 1" shell)
                  (search " & client=$!" shell))))))
  (put (merge-pathnames "boundary-checks.sexp" *attempt*) (reverse *checks*))
  (format t "~d command-boundary checks passed.~%" (length *checks*)))
(when (sb-ext:posix-getenv "SCREEN_PLACEMENT_COMMAND_BOUNDARY_ONLY")
  (placement-command-boundary-tests)
  (sb-ext:exit :code 0))
(defparameter *sources* '("vttest-screen-native.sh" "vttest-screen-recorder.lisp"
                         "vttest-screen-native-contract.lisp" "vttest-screen-manifest.lisp"))
(dolist (file *sources*)
