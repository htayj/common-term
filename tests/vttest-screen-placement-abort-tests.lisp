                                  (bytes (merge-pathnames (concatenate 'string "current/" file) *attempt*)))))
(check :test-copy (equalp (bytes (merge-pathnames "tests/vttest-screen-placement-abort-tests.lisp" *workspace*))
                          (bytes (merge-pathnames "focused-tests.lisp" *attempt*))))
;; Reader scaffolding only. No product package definitions or system are loaded.
(dolist (p '("LISPTERM" "LISPTERM.ENGINE" "LISPTERM.PTY" "LISPTERM.DISPLAY.WAYLAND"
             "VTTEST-SCREEN-FRAME" "VTTEST-SCREEN-ORACLE" "VTTEST-SCREEN-RECORDER"
             "VTTEST-SCREEN-DRIVER" "VTTEST-AREA" "VTTEST-CURSOR-DRIVER" "UIOP" "ASDF"))
  (unless (find-package p) (make-package p :use '("CL"))))
(defun constituent-p (c) (or (alphanumericp c) (find c "-._*+")))
(defun scaffold-exports (string)
  (loop for i from 1 below (1- (length string)) when (char= #\: (char string i)) do
    (let* ((start (loop for j downfrom (1- i) to 0 while (constituent-p (char string j)) finally (return (1+ j))))
           (package (and (< start i) (find-package (string-upcase (subseq string start i)))))
           (end (loop for j from (1+ i) below (length string) while (constituent-p (char string j)) finally (return j))))
      (when (and package (> end (1+ i)) (not (member (package-name package) '("COMMON-LISP" "SB-POSIX" "SB-EXT" "SB-UNIX") :test #'equal)))
        (let ((name (string-upcase (subseq string (1+ i) end))))
          (multiple-value-bind (symbol status) (find-symbol name package)
            (declare (ignore symbol))
            (when (eq status :inherited) (shadow name package)))
          (export (intern name package) package))))))
(dolist (file '("vttest-screen-recorder.lisp" "vttest-screen-manifest.lisp"))
  (scaffold-exports (text (merge-pathnames (concatenate 'string "current/" file) *attempt*))))
(defun read-source (file)
  (let ((*read-eval* nil) (*package* (find-package :cl-user)) (pairs nil))
    (with-open-file (s (merge-pathnames (concatenate 'string "current/" file) *attempt*))
      (loop for form = (read s nil :eof) until (eq form :eof) do
        (assert (consp form))
        (assert (member (string-upcase (symbol-name (car form)))
                        '("REQUIRE" "LOAD" "LOAD-SYSTEM" "DEFPACKAGE" "IN-PACKAGE" "DEFUN" "DEFPARAMETER" "DEFVAR" "DEFINE-CONDITION" "EXPORT" "MAIN") :test #'equal))
        (cond ((eq (car form) 'defpackage) (eval form))
              ((eq (car form) 'in-package) (setf *package* (find-package (second form)))))
        (push (list (package-name *package*) form) pairs)))
    (nreverse pairs)))
(defparameter *contract* (read-source "vttest-screen-native-contract.lisp"))
(defparameter *recorder* (read-source "vttest-screen-recorder.lisp"))
(defparameter *manifest* (read-source "vttest-screen-manifest.lisp"))
(defun definition (pairs name)
  (or (find name pairs :key (lambda (pair) (and (consp (second pair))
                          (symbolp (second (second pair))) (symbol-name (second (second pair))))) :test #'equal)
      (error "No source definition ~a" name)))
(defun admit (pair)
  (let ((*package* (find-package (first pair)))) (eval (second pair))))
(defun named (pairs name) (second (definition pairs name)))
(defun matches-in-tree (form predicate)
  (let ((result nil))
    (labels ((walk (x) (when (consp x) (when (funcall predicate x) (push x result))
                                      (walk (car x)) (walk (cdr x))))) (walk form))
    (nreverse result)))
(defparameter *run* (named *recorder* "RUN-MAIN"))
(defparameter *result-slices*
  (matches-in-tree *run* (lambda (x) (and (eq (car x) 'let) (consp (second x))
                   (consp (first (second x))) (symbolp (first (first (second x))))
                   (equal "RESULT" (symbol-name (first (first (second x)))))))))
(defparameter *abort-slices*
  (matches-in-tree *run* (lambda (x) (and (eq (car x) 'error) (equal '(c) (second x))
                   (search "NATIVE-ABORTED" (prin1-to-string x))))))
;; C is in the source package, so compare its name rather than reader-package identity.
(unless *abort-slices*
  (setf *abort-slices* (matches-in-tree *run* (lambda (x) (and (eq (car x) 'error)
    (consp (second x)) (equal "C" (symbol-name (first (second x))))
    (search "NATIVE-ABORTED" (prin1-to-string x)))))))
(check :one-result-slice (= 1 (length *result-slices*)))
(check :one-abort-slice (= 1 (length *abort-slices*)))
(let ((shell (text (merge-pathnames "current/vttest-screen-native.sh" *attempt*)))
      (rec (text (merge-pathnames "current/vttest-screen-recorder.lisp" *attempt*))))
  (check :no-recorder-evaluation (equal '(vttest-screen-recorder::main) (second (car (last *recorder*)))))
    (check :rule-before-launch (< (search "        screen_register_placement || return 1" shell) (search " & client=$!" shell)))
  (check :initial-before-capture-loop (< (search "screen_initial_rect_valid \"$native/initial-geometry.json\"" shell)
                                        (search "for ((n=1;n<=15;n++))" shell)))
  (check :placement-before-target (< (search "placement-ready.sexp" rec) (search "(loop for n from 1 to 15 do" rec)))
  (check :one-rule-call (= 1 (length (loop for pos = (search "rule=$(screen_placement_rule)" shell)
                    then (search "rule=$(screen_placement_rule)" shell :start2 (1+ pos)) while pos collect pos))))
  (check :no-move-in-capture (null (search "move position" shell :start2 (search "for ((n=1;n<=15;n++))" shell))))
  (check :shared-clock-order (< (search "screen_contract start" shell) (search "screen_contract notify" shell) (search "screen_contract await" shell)))
  (check :skip-native-drain (search "(when (and failure (not native-aborted))" rec))
  (check :public-close (search "(lispterm:close host)" rec))
  (check :both-runtime-pins (and (search "tests/vttest-screen-native.sh tests/vttest-screen-native-contract.lisp tests/vttest-screen-recorder.lisp" shell)
    (every (lambda (p) (search p (text (merge-pathnames "current/vttest-screen-manifest.lisp" *attempt*))))
      '("tests/vttest-screen-native.sh" "tests/vttest-screen-recorder.lisp" "tests/vttest-screen-native-contract.lisp"))))
  ;; Identical capture-hold and await-target bodies bind both backend branches and
  ;; their content/phase requirements, without repeating the producer suite.
  (dolist (name '("CAPTURE-HOLD" "AWAIT-TARGET"))
    (let* ((current (named *recorder* name))
           (before-path (merge-pathnames "before/vttest-screen-recorder.lisp" *evidence*))
           (*read-eval* nil) (*package* (find-package :vttest-screen-recorder)))
      (with-input-from-string (s (subseq (text before-path) (search (format nil "(defun ~a " (string-downcase name)) (text before-path))))
        (check (list :unchanged-pause14 name) (equalp current (read s)))))))
;; All syntax, top-level and copy admission precedes source definition evaluation.
(put (if (sb-ext:posix-getenv "SCREEN_REPAIR_CHILD")
         (merge-pathnames "child-admission.sexp" (sb-ext:posix-getenv "SCREEN_REPAIR_CHILD"))
         (merge-pathnames "admission.sexp" *attempt*))
     (list :checks (reverse *checks*) :contract-forms (length *contract*) :recorder-forms (length *recorder*) :manifest-forms (length *manifest*)))
(proclaim '(special vttest-screen-recorder::*root* vttest-screen-recorder::*art* vttest-screen-recorder::*backend*))
(dolist (pair *contract*)
  (when (member (car (second pair)) '(defun defparameter)) (admit pair)))
(dolist (name '("*NATIVE-FAILURE-SEEN*" "*PAUSE*" "*WAIT-OBSERVER*" "NATIVE-ABORT" "PATH" "SAVE" "TOUCH" "PAUSE-NAME" "CHECK-NATIVE-FAILURE" "AWAIT"))
  (admit (definition *recorder* name)))
(admit (definition *manifest* "SUMMARIZE-NATIVE"))
(defun set-env (key value) (sb-posix:setenv key (princ-to-string value) 1))
(defun contract-env (key value) (set-env (concatenate 'string "LISPTERM_SCREEN_" key) value))
(defun shell-command (label command)
  (let* ((base (merge-pathnames label *attempt*))
         (bash "/nix/store/kwyi4bq5s2qgwbhz6cs4gjy57c2zdxws-bash-interactive-5.3p20/bin/bash")
         (args (list "--noprofile" "--norc" "-c" command)))
    (put (pathname (concatenate 'string (namestring base) ".command.sexp")) (list :program bash :argv args :input :null))
    (let* ((process (sb-ext:run-program bash args :input nil :output (concatenate 'string (namestring base) ".stdout")
                     :error (concatenate 'string (namestring base) ".stderr") :wait t))
           (exit (sb-ext:process-exit-code process)))
      (put (pathname (concatenate 'string (namestring base) ".exit")) exit) exit)))
(defun test-shell (label body expected)
  (let ((command (format nil "source ~a; jq=/nix/store/4b6f9wb1qak318gk7mxlfkhril6lxpcx-jq-1.8.2-bin/bin/jq; ~a"
                 (merge-pathnames "current/vttest-screen-native.sh" *attempt*) body)))
    (check label (eql expected (shell-command label command)))))
(defun fixture (name string)
  (let ((p (merge-pathnames name *attempt*))) (put-text p string) (namestring p)))
(defun refuses (thunk) (handler-case (progn (funcall thunk) nil) (error () t)))
(defun root-for (name)
  (let ((p (merge-pathnames (concatenate 'string name "/") *attempt*)))
    (ensure-directories-exist (merge-pathnames "native/.reserve" p))
    (ensure-directories-exist (merge-pathnames "recorder/.reserve" p))
    (put (merge-pathnames "MANIFEST.sexp" p) '(:inert-focused-control t))
    (namestring (truename p))))
(defun write-plain (root relative value) (put (merge-pathnames relative root) value))
(defun run-child (root marker)
  (set-env "SCREEN_REPAIR_CHILD" root) (set-env "SCREEN_REPAIR_MARKER" marker)
  (let* ((sbcl "/nix/store/rnyqmmrpp09r6rn7avh77bjkdaaxs0cm-sbcl-with-packages/bin/sbcl")
         (args (list "--noinform" "--no-userinit" "--no-sysinit" "--script" (namestring (merge-pathnames "focused-tests.lisp" *attempt*)))))
    (put (merge-pathnames "child.command.sexp" root) (list :program sbcl :argv args :input :null :root root :marker marker))
    (prog1 (sb-ext:run-program sbcl args :input nil :output (concatenate 'string root "child.stdout")
             :error (concatenate 'string root "child.stderr") :wait nil)
      (sb-posix:unsetenv "SCREEN_REPAIR_CHILD") (sb-posix:unsetenv "SCREEN_REPAIR_MARKER"))))
(defun child-main (root marker)
  (setf (symbol-value (intern "*ROOT*" :vttest-screen-recorder)) (pathname root)
        (symbol-value (intern "*ART*" :vttest-screen-recorder)) (merge-pathnames "recorder/" root)
        (symbol-value (intern "*BACKEND*" :vttest-screen-recorder)) :wayland
        vttest-screen-recorder::*pause* 1)
  (let* ((*package* (find-package :vttest-screen-recorder))
         (form `(let ((,(intern "FAILURE") nil) (,(intern "CHECKS") nil)
                      (,(intern "NATIVE-ABORTED") nil) (,(intern "ATTEMPTED") 1)
                      (,(intern "REACHED") 1) (,(intern "CAPTURED") 0)
                      (,(intern "ACCOUNTING") :unverified) (,(intern "CLEANUP") :cooperative-native-abort))
                  (handler-case
                      (vttest-screen-recorder::await nil
                        (lambda () (probe-file ,(concatenate 'string root "recorder/" marker))) 3)
                    ,(first *abort-slices*))
                  ,(first *result-slices*))))
    (sb-ext:exit :code (eval form))))
(when (sb-ext:posix-getenv "SCREEN_REPAIR_CHILD")
  ;; Admission output is per child root, not a shared filename.
  (child-main (sb-ext:posix-getenv "SCREEN_REPAIR_CHILD") (sb-ext:posix-getenv "SCREEN_REPAIR_MARKER")))
(defun main-tests ()
  (test-shell "rule" "screen_placement_rule floating; screen_placement_rule origin" 0)
  (check :exact-rule (equal (format nil "for_window [app_id=~s title=~s] floating enable~%for_window [app_id=~s title=~s] move position 0 0~%" "^org[.]autolith[.]lispterm$" "^Lispterm-screen-owned-run$" "^org[.]autolith[.]lispterm$" "^Lispterm-screen-owned-run$")
                           (text (merge-pathnames "rule.stdout" *attempt*))))
  (dolist (case '(("rule-good" "[{\"success\":true}]" 0) ("rule-bad" "[{\"success\":false}]" 1)
                  ("rule-empty" "[]" 1) ("rule-malformed" "{}" 1)))
    (test-shell (first case) (format nil "screen_rule_success ~a" (fixture (concatenate 'string (first case) ".json") (second case))) (third case)))
  (dolist (case '(("output-good" "HEADLESS-1" 1 0 0 1280 800 0)
                  ("output-name" "OTHER" 1 0 0 1280 800 1) ("output-scale" "HEADLESS-1" 2 0 0 1280 800 1)
                  ("output-origin" "HEADLESS-1" 1 1 0 1280 800 1) ("output-size" "HEADLESS-1" 1 0 0 1279 800 1)))
    (destructuring-bind (name output scale x y w h exit) case
      (test-shell name (format nil "screen_output_valid ~a" (fixture (concatenate 'string name ".json")
        (format nil "[{\"name\":~s,\"active\":true,\"scale\":~d,\"rect\":{\"x\":~d,\"y\":~d,\"width\":~d,\"height\":~d}}]" output scale x y w h))) exit)))
  (dolist (case '(("rect-640" 0 0 640 384 640 384 0) ("rect-1056" 0 0 1056 384 1056 384 0)
                  ("rect-old-clipped" 320 208 1056 384 1056 384 1) ("rect-negative" -1 0 640 384 640 384 1)
                  ("rect-size" 0 0 639 384 640 384 1) ("rect-window-size" 0 0 640 384 639 384 1)))
    (destructuring-bind (name x y w h ww wh exit) case
      (let ((path (fixture (concatenate 'string name ".json")
                    (format nil "{\"id\":5,\"rect\":{\"x\":~d,\"y\":~d,\"width\":~d,\"height\":~d},\"window_rect\":{\"width\":~d,\"height\":~d},\"geometry\":{\"width\":640,\"height\":384}}" x y w h ww wh))))
        (test-shell name (format nil "screen_rect_valid ~a ~d 384" path (if (= w 1056) 1056 640)) exit)
        (when (equal name "rect-640")
          (test-shell "initial-rect" (format nil "screen_initial_rect_valid ~a" path) 0)
          (test-shell "full-region" (format nil "screen_full_region ~a '0,0 640x384'" path) 0)
          (test-shell "wrong-region" (format nil "screen_full_region ~a '0,0 639x384'" path) 1)))))
  (let* ((node "{\"pid\":42,\"type\":\"floating_con\",\"app_id\":\"org.autolith.common-term\",\"name\":\"Lispterm-screen-owned-run\"}")
         (one (fixture "node-one.json" (format nil "[~a]" node)))
         (two (fixture "node-two.json" (format nil "[~a,~a]" node node)))
         (none (fixture "node-none.json" "[]")))
    (test-shell "owned-node" (format nil "screen_owned_node ~a 42" one) 0)
    (test-shell "wrong-pid" (format nil "screen_owned_node ~a 43" one) 5)
    (test-shell "ambiguous-node" (format nil "screen_owned_node ~a 42" two) 5)
    (test-shell "missing-node" (format nil "screen_owned_node ~a 42" none) 5))
  (dolist (marker '("pause-01-native-ready.sexp" "pause-01-go" "pause-01-done"))
    (let* ((root (root-for (subseq marker 0 (- (length marker) (if (search ".sexp" marker) 5 0)))))
           (process (run-child root marker))
           (pid (sb-ext:process-pid process))
           (token (vttest-screen-native-contract::process-token pid))
           (start (vttest-screen-native-contract::start-cleanup root)))
      (contract-env "ROOT" root) (contract-env "BACKEND" "wayland")
      ;; Production writer, then simultaneous success. Failure must win.
      (vttest-screen-native-contract::publish-native-failure root "wayland" 1 "geometry" :geometry)
      (write-plain root (concatenate 'string "recorder/" marker) '(:success t))
      (check (list :real-exit-observed marker)
        (eq :exited (vttest-screen-native-contract:await-exit pid token (concatenate 'string root "native/finalization-clock.sexp") start)))
      (sb-ext:process-wait process)
      (write-plain root "child.exit" (list :status (sb-ext:process-status process) :exit (sb-ext:process-exit-code process)))
      (write-plain root "native/client.exit" (sb-ext:process-exit-code process))
      (check (list :actual-exit1 marker) (eql 1 (sb-ext:process-exit-code process)))
      (check (list :actual-result marker) (probe-file (concatenate 'string root "recorder/RESULT.sexp")))
      (contract-env "ROOT" root) (contract-env "BACKEND" "wayland")
      (contract-env "DEADLINE_NS" (+ start 15000000000))
      (check (list :strict-import marker) (eq :fail (vttest-screen-native-contract::bounded-import)))
      (let ((r (vttest-screen-native-contract:read-data (concatenate 'string root "recorder/RESULT.sexp"))))
        (check :failure-current-frame (eq :fail (getf (first (getf r :checks)) :frame)))
        (check :native-reason (search "Native geometry" (getf r :reason)))
        (check :real-counters (equal '(1 1 0 0) (mapcar (lambda (k) (getf r k)) '(:attempted :reached :captured :frame-verified)))))
      (write-plain root "recorder/pause-01-request" '(1 9 640 384 1 0 0))
      (put-text (concatenate 'string root "native/stage-events.sexp") (format nil "(1 :request)~%"))
      (put-text (concatenate 'string root "native/unowned-endpoints.txt") "")
      (dolist (pair '(("FINALIZATION" . ":complete") ("CLIENT_EXIT" . "1") ("STATUS" . ":fail")
                      ("ATTEMPTED" . "1") ("REACHED" . "1") ("CAPTURED" . "0")
                      ("BUILD" . ":unverified") ("STARTED" . "T") ("CLEANUP" . ":pass") ("REASON" . "geometry")))
        (contract-env (car pair) (cdr pair)))
      (check :native-publish (eq :fail (vttest-screen-native-contract:publish-native)))
      (let* ((record (vttest-screen-native-contract:read-data (concatenate 'string root "SCREEN-RUN.sexp")))
             (manifest (list :backend "wayland" :scenarios (loop for n from 1 to 15 collect
                           (list :id (format nil "screen-~2,'0d" n) :captures (list (list :id (format nil "pause-~2,'0d" n))))))))
        (multiple-value-bind (observations evidence)
            (vttest-screen-driver::summarize-native manifest record 1 root)
          (declare (ignore observations))
          (write-plain root "outer-ingress.sexp" evidence)
          (check :outer-original-ingress (and (null (getf evidence :receipt-error)) (getf evidence :native-failed)))
          (check :outer-failed1 (eql 1 (getf (getf evidence :counts) :failed)))
          (check :original-result-hash (equal (getf record :recorder-sha256)
             (vttest-screen-native-contract::digest (concatenate 'string root "recorder/RESULT.sexp"))))))))
  ;; Closed-data rejection controls against the production validator and writer.
  (let* ((root (root-for "protocol"))
         (record (vttest-screen-native-contract::publish-native-failure root "wayland" 1 "geometry" :geometry)))
    (check :duplicate-publication (refuses (lambda () (vttest-screen-native-contract::publish-native-failure root "wayland" 1 "geometry" :geometry))))
    (dolist (case '((:backend "x11") (:pause 2) (:run "/foreign/") (:version 2) (:stage :unknown)))
      (let ((bad (copy-tree record))) (setf (getf bad (first case)) (second case))
        (check case (refuses (lambda () (vttest-screen-native-contract::validate-native-failure bad root "wayland" 1 t))))))
    (check :malformed-keys (refuses (lambda () (vttest-screen-native-contract::validate-native-failure
      (append record '(:reason "geometry")) root "wayland" 1 t))))
    (setf (symbol-value (intern "*ROOT*" :vttest-screen-recorder)) (pathname root)
          (symbol-value (intern "*ART*" :vttest-screen-recorder)) (merge-pathnames "recorder/" root)
          (symbol-value (intern "*BACKEND*" :vttest-screen-recorder)) :wayland
          vttest-screen-recorder::*pause* 1 vttest-screen-recorder::*native-failure-seen* nil)
    (check :typed-native-abort (handler-case (vttest-screen-recorder::check-native-failure)
                               (vttest-screen-recorder::native-abort (c) (search "Native geometry" (princ-to-string c)))))
    (check :duplicate-consumption (handler-case (vttest-screen-recorder::check-native-failure)
                              (vttest-screen-recorder::native-abort (c) (search "Duplicate" (princ-to-string c))))))
  (let ((root (root-for "publication-failure")))
    (put-text (concatenate 'string root "native/native-failure.sexp.tmp") "reserved")
    (check :publication-error (refuses (lambda () (vttest-screen-native-contract::publish-native-failure root "wayland" 1 "geometry" :geometry))))
    (check :no-fake-notification (not (probe-file (concatenate 'string root "native/native-failure.sexp")))))
  (dolist (case '("missing-result" "invalid-result"))
    (let* ((root (root-for case))
           (exit (shell-command (concatenate 'string case "-child") "exit 7")))
      (check (list case :actual-exit) (eql 7 exit))
      (write-plain root "native/client.exit" exit)
      (when (equal case "invalid-result") (write-plain root "recorder/RESULT.sexp" '(:bogus t)))
      (let ((refusal nil))
        (handler-case (vttest-screen-native-contract:import-recorder root "wayland")
          (error (c) (setf refusal (princ-to-string c))))
        (write-plain root "import-refusal.sexp" refusal)
        (check case refusal))
      (contract-env "ROOT" root) (contract-env "BACKEND" "wayland")
      (dolist (pair `(("FINALIZATION" . ,(if (equal case "missing-result") ":exited-without-result" ":invalid-result"))
                     ("CLIENT_EXIT" . "7") ("STATUS" . ":fail") ("ATTEMPTED" . "0")
                     ("REACHED" . "0") ("CAPTURED" . "0") ("BUILD" . ":unverified")
                     ("STARTED" . "T") ("CLEANUP" . ":pass") ("REASON" . "geometry")))
        (contract-env (car pair) (cdr pair)))
      (put-text (concatenate 'string root "native/stage-events.sexp") "")
      (put-text (concatenate 'string root "native/unowned-endpoints.txt") "")
      (check (list case :strict-publish) (eq :fail (vttest-screen-native-contract:publish-native)))
      (let ((record (vttest-screen-native-contract:read-data (concatenate 'string root "SCREEN-RUN.sexp"))))
        (multiple-value-bind (observations evidence)
            (vttest-screen-driver::summarize-native (list :backend "wayland") record exit root)
          (declare (ignore observations))
          (write-plain root "outer-ingress.sexp" evidence)
          (check (list case :strict-ingress) (null (getf evidence :receipt-error)))
          (let ((r (getf (getf record :stages) :recorder)))
            (check (list case :unknown-counts) (every (lambda (k) (null (getf r k)))
                       '(:origin :attempted :reached :captured :frame-verified))))))))
  ;; Local expired start: no sleeping15s and no substituted process observation.
  (let* ((root (root-for "expired-await")) (start (- (vttest-screen-native-contract::monotonic-ns) 15000000001)))
    (check :expired-await (eq :timeout (vttest-screen-native-contract:await-exit
       (sb-posix:getpid) (vttest-screen-native-contract::process-token (sb-posix:getpid))
       (concatenate 'string root "native/finalization-clock.sexp") start))))
  (let ((root (root-for "failure-during-predicate")))
    (setf vttest-screen-recorder::*root* (pathname root)
          vttest-screen-recorder::*art* (merge-pathnames "recorder/" root)
          vttest-screen-recorder::*backend* :wayland
          vttest-screen-recorder::*pause* 1 vttest-screen-recorder::*native-failure-seen* nil)
    (check :failure-after-success-candidate
      (handler-case
          (vttest-screen-recorder::await nil (lambda ()
            (vttest-screen-native-contract::publish-native-failure root "wayland" 1 "capture" :capture) t))
        (vttest-screen-recorder::native-abort (c) (search "Native capture" (princ-to-string c))))))
  (let* ((root (root-for "delayed-exit"))
         (bash "/nix/store/kwyi4bq5s2qgwbhz6cs4gjy57c2zdxws-bash-interactive-5.3p20/bin/bash")
         (args '("--noprofile" "--norc" "-c" "sleep .2; exit 7")))
    (put (merge-pathnames "child.command.sexp" root) (list :program bash :argv args :input :null))
    (let* ((process (sb-ext:run-program bash args :input nil :output (concatenate 'string root "child.stdout")
                      :error (concatenate 'string root "child.stderr") :wait nil))
           (pid (sb-ext:process-pid process))
           (token (vttest-screen-native-contract::process-token pid))
           (start (vttest-screen-native-contract::monotonic-ns)))
      (check :delayed-owned-live token)
      (check :delayed-real-exit (eq :exited (vttest-screen-native-contract:await-exit
         pid token (concatenate 'string root "native/clock.sexp") start)))
      (sb-ext:process-wait process)
      (write-plain root "child.exit" (sb-ext:process-exit-code process))
      (check :delayed-exit7 (eql 7 (sb-ext:process-exit-code process)))))
  (let* ((root (root-for "expired-import"))
         (sbcl "/nix/store/rnyqmmrpp09r6rn7avh77bjkdaaxs0cm-sbcl-with-packages/bin/sbcl")
         (args (list "--noinform" "--no-userinit" "--no-sysinit" "--non-interactive" "--load"
                 (namestring (merge-pathnames "current/vttest-screen-native-contract.lisp" *attempt*))
                 "--eval" "(vttest-screen-native-contract:main)")))
    (contract-env "ROOT" root) (contract-env "BACKEND" "wayland") (contract-env "OPERATION" "import")
    (contract-env "DEADLINE_NS" (1- (vttest-screen-native-contract::monotonic-ns)))
    (put (merge-pathnames "import.command.sexp" root) (list :program sbcl :argv args :deadline (sb-ext:posix-getenv "LISPTERM_SCREEN_DEADLINE_NS")))
    (let ((process (sb-ext:run-program sbcl args :input nil :output (concatenate 'string root "import.stdout")
                      :error (concatenate 'string root "import.stderr") :wait t)))
      (write-plain root "import.exit" (sb-ext:process-exit-code process))
      (check :expired-import-exit124 (eql 124 (sb-ext:process-exit-code process)))
      (check :expired-import-no-counts (not (probe-file (concatenate 'string root "native/recorder-import.sexp"))))
      (check :expired-import-timeout (eq :timeout (getf (vttest-screen-native-contract:read-data
         (concatenate 'string root "native/import-deadline.sexp")) :state)))))
  (dolist (case '("malformed" "foreign" "stale" "duplicate" "bad-hash"))
    (let* ((root (root-for (concatenate 'string "reader-" case)))
           (record (vttest-screen-native-contract::publish-native-failure root "wayland" 1 "geometry" :geometry)))
      ;; Deliberate negative fixture replacement is confined to its own fresh root.
      (delete-file (concatenate 'string root "native/native-failure.sexp"))
      (cond ((equal case "malformed") (setf record '(:bogus t)))
            ((equal case "foreign") (setf (getf record :backend) "x11"))
            ((equal case "stale") (setf (getf record :pause) 2))
            ((equal case "duplicate") (setf record (append record '(:reason "geometry"))))
            ((equal case "bad-hash") (setf (getf (getf record :origin) :sha256) (make-string 64 :initial-element #\0))))
      (write-plain root "native/native-failure.sexp" record)
      (setf vttest-screen-recorder::*root* (pathname root)
            vttest-screen-recorder::*art* (merge-pathnames "recorder/" root)
            vttest-screen-recorder::*backend* :wayland
            vttest-screen-recorder::*pause* 1 vttest-screen-recorder::*native-failure-seen* nil)
      (check (list case :actual-wait-refusal)
        (handler-case (vttest-screen-recorder::await nil (lambda () t))
          (vttest-screen-recorder::native-abort (c) (search "protocol refusal" (princ-to-string c)))))))
  (let ((path (fixture "initial-centered.json" "{\"rect\":{\"x\":320,\"y\":208,\"width\":640,\"height\":384},\"window_rect\":{\"width\":640,\"height\":384}}")))
    (test-shell "initial-centered-refusal" (format nil "screen_initial_rect_valid ~a" path) 1))
  (check :actual-fourteen-pins (= 14 (length (second (third (named *manifest* "+SCREEN-PINS+"))))))
  ;; Reader scaffolding inherits CL:OPEN. Only package-owned symbols could
  ;; indicate that product definitions were accidentally evaluated.
  (check :no-product-loaded
    (loop with package = (find-package :lispterm)
          for symbol being the symbols of package
          always (or (not (eq package (symbol-package symbol)))
                     (not (fboundp symbol)))))
  (dolist (file *sources*)
    (check (list :final-binding file) (equalp (bytes (merge-pathnames (concatenate 'string "tests/" file) *workspace*))
                                       (bytes (merge-pathnames (concatenate 'string "current/" file) *attempt*)))))
  (check :test-final (equalp (bytes (merge-pathnames "tests/vttest-screen-placement-abort-tests.lisp" *workspace*))
                            (bytes (merge-pathnames "focused-tests.lisp" *attempt*))))
  (put (merge-pathnames "checks.sexp" *attempt*) (list :count (length *checks*) :checks (reverse *checks*) :images nil))
  (format t "~d focused assertions passed.~%" (length *checks*)))
(main-tests)
