(load (merge-pathnames "vttest-vt52-native-navigation-test-support.lisp" *load-truename*))
(in-package :vttest-vt52-native-navigation-tests)
;; Rebase offsets and snapshot counters after deliberate coherent trace changes.
(defun rebase (r events)
  (let ((seq 0) (input 0) (out 0) (points (make-hash-table)) (seen (make-hash-table :test 'eq)))
    (setf (gethash 0 points) '(0 0))
    (dolist (e events)
      (let ((old (getf e :seq)))
        (setf (getf e :seq) (incf seq) (getf e :time) seq (getf e :out) out (getf e :in) input)
        (case (getf e :kind)
          (:wire-in (setf (getf e :start) input) (incf input (length (getf e :bytes))) (setf (getf e :end) input))
          (:wire-out (incf out (length (getf e :bytes)))))
        (setf (gethash old points) (list seq input))))
    (labels ((snapshot (p key)
               (let ((v (gethash (getf p key) points)))
                 (assert v) (setf (getf p key) (first v) (getf p :ticks) (first v) (getf p :input) (second v))))
             (proof (p)
               (when (and p (not (gethash p seen)))
                 (setf (gethash p seen) t) (snapshot p :event) (snapshot (getf p :checkpoint) :event))))
      (dolist (p (list (getf (getf r :navigation-proofs) :outer-hold) (getf (getf r :navigation-proofs) :main-menu))) (proof p))
      (dolist (e events) (proof (getf e :proof))))))
(defun inserted-input (seq bytes &optional (source :driver))
  (mapcar (lambda (e) (append '(:time 0 :out 0 :in 0 :start 0 :end 0) e))
   (append (when (eq source :driver) (list (list :seq seq :kind :driver :pause 0 :bytes (copy-seq bytes))))
    (list (list :seq seq :kind :enqueue :pause 0 :source source :bytes (copy-seq bytes))
          (list :seq seq :kind :wire-in :pause 0 :source source :bytes (copy-seq bytes) :child-pid 42)))))
(defun producer-navigation-tests ()
  ;; Evaluate only the audited polling definition, with real public gate calls.
  (let* ((*package* (find-package :vttest-vt52-native-navigation-tests)) (*read-eval* nil)
         (text (with-open-file (s *recorder-source*)
                 (let ((x (make-string (file-length s)))) (read-sequence x s) x)))
         (form (read-from-string (subseq text (search "(defun await-vt52-navigation " text)
                                             (search "(defun install-wire-recorder " text)))))
    (multiple-value-bind (r obs out events) (fixture "/producer-pure/" "x11" 1)
      (declare (ignore obs))
      (loop for stage in '(:outer-hold :main-menu) collect
        (let* ((p (getf (getf r :navigation-proofs) stage))
               (prefix (remove-if (lambda (e) (> (getf e :seq) (getf p :event))) events))
               (current (list :start (getf p :end) :event (getf p :event) :input (getf p :input)
                              :child-pid 42 :ticks (getf p :ticks)))
               (answer (eval `(flet ((check-native-failure () nil)
                                     (vt52-output-snapshot () (values ',(subseq out 0 (getf p :end)) ',prefix ',current)))
                               (funcall (lambda ,(third form) ,@(cdddr form)) ',(getf p :checkpoint) ',stage)))))
          (assert (equal answer p)) stage)))))
(defun run-trace-tests ()
  (let ((checks 0) (base (format nil "/home/taylor/projects/lispterm/.build/trace356-~d-~d/" (get-universal-time) (sb-posix:getpid))))
    (assert (equal '(:outer-hold :main-menu) (producer-navigation-tests)))
    (sb-posix:mkdir base #o700)
    (labels ((test (name pass transform &optional query)
               (let* ((*menu* (if query (concatenate 'string (coerce (map 'list #'code-char query) 'string) *menu*) *menu*))
                      (root (format nil "~a~d/" base (incf checks))))
                 (multiple-value-bind (r o b e) (fixture root "x11" 1)
                   (setf e (funcall transform r e))
                   (publish root r o b e)
                   (let ((got (handler-case (progn (vttest-vt52-native-navigation:validate-recorder root "x11" 1) t) (error (c) (when pass (format t "EXPECTED-POSITIVE ~s REFUSED ~a~%" name c)) nil))))
                     (assert (eql pass got) () "~a expected ~s got ~s" name pass got)))))
             (first-hold (e) (find-if (lambda (x) (and (eq :navigation-reached (getf x :kind)) (eql 1 (getf x :hold)))) e)))
      (test :base t (lambda (r e) (declare (ignore r)) e))
      (dolist (mode '(:missing :forged :late))
        (test mode nil (lambda (r e) (declare (ignore r))
          (let ((h (first-hold e)))
            (ecase mode (:missing (setf (getf h :proof) nil))
              (:forged (setf (getf (getf h :proof) :markers) nil))
              (:late (setf (getf (getf h :proof) :event) (getf h :seq))))) e)))
      (dolist (where '(:prefix :middle :suffix))
        (test where nil (lambda (r e)
          (setf e (ecase where
            (:prefix (append (inserted-input 0 #(13)) e))
            (:middle (let* ((h (first-hold e)) (p (position h e)))
                       (append (subseq e 0 p) (inserted-input (1- (getf h :seq)) #(13)) (subseq e p))))
            (:suffix (append e (inserted-input (1+ (getf (car (last e)) :seq)) #(13))))))
          (rebase r e) e)))
      (dolist (last-p '(nil t))
        (test (list :wrong-command last-p) nil (lambda (r e) (declare (ignore r))
          (let* ((ds (remove-if-not (lambda (x) (eq :driver (getf x :kind))) e))
                 (d (if last-p (car (last ds)) (first ds))) (start (position d e)))
            (dolist (x (subseq e start (+ start 3)))
              (let ((v (copy-seq (getf x :bytes)))) (setf (aref v 0) 57 (getf x :bytes) v)))) e)))
      (test :split t (lambda (r e)
        (setf e (loop for x in e append
          (if (and (eq :wire-in (getf x :kind)) (= 2 (length (getf x :bytes))))
            (loop for i below 2 collect (let ((y (copy-list x))) (setf (getf y :bytes) (subseq (getf x :bytes) i (1+ i))) y)) (list x))))
        (rebase r e) e))
      (test :queued t (lambda (r e)
        (dolist (release (remove-if-not (lambda (x) (eq :navigation-released (getf x :kind))) e))
          (let ((p (position release e))) (rotatef (nth p e) (nth (1- p) e))))
        (rebase r e) e))
      (test :queued-reply t (lambda (r e)
        (let ((reply (inserted-input 1 #(27 91 63 49 59 50 99) :reply)))
          (setf (getf (second reply) :seq) 3)
          (setf e (append (list (first e) (first reply)) (subseq e 1 3) (list (second reply)) (subseq e 3))))
        (rebase r e) e) #(27 91 99))
      (test :wrong-owner nil (lambda (r e) (declare (ignore r))
        (let ((w (find :wire-in e :key (lambda (x) (getf x :kind))))) (setf (getf w :child-pid) 99)) e))
      (dolist (pair '((nil nil #(27 91 63 49 59 50 99))
                      (t #(27 91 99) #(27 91 63 49 59 50 99))
                      (t #(27 90) #(27 47 90))
                      (nil #(27 90) #(27 91 63 49 59 50 99))
                      (nil #(27 90) #(27 13))))
        (test (list :reply pair) (first pair) (lambda (r e)
          (setf e (append (list (first e)) (inserted-input 1 (third pair) :reply) (rest e)))
          (rebase r e) e) (second pair)))
      (format t "TRACE356 checks=~d fixtures=~a~%" checks base) checks)))
(run-trace-tests)
