;;;; Geometry intent, configure races, protocol transactions and a real PTY.
(defpackage #:lispterm.geometry.tests
  (:use #:cl) (:export #:run-tests))
(in-package #:lispterm.geometry.tests)
(defvar *checks* 0)
(defvar *requests* nil)
(defvar *cancellations* nil)
(defmacro check (value &optional (description "geometry invariant"))
  `(progn (incf *checks*) (unless ,value (error "~A: ~S" ,description ',value))))
(defun bytes (text) (babel:string-to-octets text :encoding :utf-8))
(defun esc (tail) (concatenate 'string (string #\Esc) tail))
(defun feed (screen text) (lispterm.engine:feed screen (bytes text)))
(defun char-at (screen row col)
  (lispterm.engine:cell-character (lispterm.engine:cell-at screen row col)))
(defmacro with-functions (bindings &body body)
  (let ((saved (loop for binding in bindings collect (gensym "OLD"))))
    `(let ,(loop for (name value) in bindings for old in saved
                 collect `(,old (symbol-function ',name)))
       (unwind-protect
            (progn ,@(loop for (name value) in bindings
                           collect `(setf (symbol-function ',name) ,value)) ,@body)
         ,@(loop for (name value) in bindings for old in saved
                 collect `(setf (symbol-function ',name) ,old))))))
(defun engine-tests ()
  (let ((packet (bytes (concatenate 'string (esc "[?3h") (esc "[1;100H") "X"))))
    (dotimes (split (1+ (length packet)))
      (let* ((s (lispterm.engine:make-screen :columns 80 :rows 24))
             (tabs (list 3 11 19)))
        (feed s (concatenate 'string (esc "[3;20r") (esc "[?6h")
                             (esc "[31m") (esc ")0") (string #\So) (esc "[?5h") "OLD"))
        (setf (nerimux/terminal/types:screen-tab-stops s) tabs
              (nerimux/terminal/types:screen-pending-wrap s) t
              (gethash 0 (nerimux/terminal/types:screen-line-sizes s)) #\6)
        (lispterm.engine:feed s (subseq packet 0 split))
        (lispterm.engine:feed s (subseq packet split))
        (check (= 132 (lispterm.engine:columns s)))
        (check (char= #\X (char-at s 0 99)) "same-read column100")
        (check (char= #\Space (char-at s 2 0)))
        (check (= 1 (nerimux/terminal/types:screen-geometry-generation s)))
        (check (nerimux/terminal/types:screen-origin-mode s))
        (check (nerimux/terminal/types:screen-reverse-screen s))
        (check (= 1 (nerimux/terminal/types:screen-cur-fg s)))
        (check (eq :dec-graphics (nerimux/terminal/types:screen-charset s)))
        (check (eq tabs (nerimux/terminal/types:screen-tab-stops s)))
        (check (= 0 (hash-table-count (nerimux/terminal/types:screen-line-sizes s))))
        (check (not (nerimux/terminal/types:screen-pending-wrap s)))
        (check (= 0 (nerimux/terminal/types:screen-scroll-top s)))
        (check (= 23 (nerimux/terminal/types:screen-scroll-bottom s)))
        ;; Same command clears and homes, not merely a same-size resize no-op.
        (feed s (esc "[?3h"))
        (check (char= #\Space (char-at s 0 99)))
        (check (= 2 (nerimux/terminal/types:screen-geometry-generation s)))
        (check (zerop (nerimux/terminal/types:screen-cursor-x s)))
        (check (zerop (nerimux/terminal/types:screen-cursor-y s)))
        (feed s (concatenate 'string (esc "[1;132H") "Z" (esc "[?3l") (esc "[?3h")))
        (check (char= #\Space (char-at s 0 131)))
        (check (= 4 (nerimux/terminal/types:screen-geometry-generation s))))))
  (let ((s (lispterm.engine:make-screen :columns 80 :rows 3)))
    (feed s (concatenate 'string "MAIN" (esc "[?1049h") (esc "[?3h") "ALT" (esc "[?1049l")))
    (check (= (* 132 3) (length (nerimux/terminal/types:screen-cells s))))
    (check (char= #\M (char-at s 0 0)))
    (feed s (concatenate 'string (esc "[?1049h") (esc "[?3l") (esc "[?1049l")))
    (check (= (* 80 3) (length (nerimux/terminal/types:screen-cells s))))
    (feed s (concatenate 'string (esc "[?3h") (esc "c")))
    (check (= 80 (lispterm.engine:columns s)))
    (check (null (nerimux/terminal/types:screen-alt-cells s)))
    (check (= 4 (nerimux/terminal/types:screen-geometry-generation s)))))

(defmethod ltd:backend-request-size ((backend (eql :geometry-test)) display request)
  (declare (ignore backend display)) (push request *requests*))
(defmethod ltd:backend-cancel-size ((backend (eql :geometry-test)) display request)
  (declare (ignore backend display)) (push request *cancellations*))
(defun fake-display (&optional (columns 80) (rows 24))
  (let* ((font (ltd::load-font nil 16))
         (d (ltd::make-display :backend :geometry-test :font font :open-p t
                              :owner sb-thread:*current-thread*)))
    (ltd:resize-display d (* columns (ltd:font-width font)) (* rows (ltd:font-height font))) d))
(defun fake-settle (display request)
  (when (and (ltd:geometry-current-p display request) (ltd:geometry-active-p display))
    (ltd:resize-display display (ltd:geometry-request-width request) (ltd:geometry-request-height request))
    (incf (ltd:display-presentation-generation display))
    (ltd:geometry-result display request :settled :fake-frame)))
(defun fake-state-tests ()
  (let* ((pty (lispterm.pty:open-pty)) (session (lispterm::make-session pty 24 80))
         (host (lispterm::%make-host :session session)) (d (fake-display))
         (s (lispterm::session-screen session)) (clock 0)
         (ltd::*geometry-clock* (lambda () clock)) (*requests* nil) (*cancellations* nil))
    (unwind-protect
         (progn
           ;; Both actions execute; a single final native request and ioctl suffice.
           (feed s (concatenate 'string (esc "[?3h") (esc "[1;100H") "X" (esc "[?3l") "B"))
           (sb-thread:with-mutex ((lispterm::session-lock session)) (lispterm::session-observe-geometry session))
           (lispterm::window-geometry-intent host d)
           (check (= 1 (length *requests*)))
           (check (= 2 (getf (ltd:geometry-status d) :request-id)))
           (check (= 80 (nth-value 1 (lispterm.pty:pty-window-size pty))))
           (check (char= #\B (char-at s 0 0)))
           (let ((old (first *requests*)))
             (feed s (esc "[?3h"))
             (sb-thread:with-mutex ((lispterm::session-lock session)) (lispterm::session-observe-geometry session))
             (lispterm::window-geometry-intent host d)
             (lispterm::window-geometry-event host d (ltd:make-resize-event :rows 24 :columns 80))
             (check (= 132 (lispterm.engine:columns s)) "late80 cannot undo pending132")
             (check (= 132 (nth-value 1 (lispterm.pty:pty-window-size pty))))
             (fake-settle d old)
             (check (eq :pending (getf (ltd:geometry-status d) :phase)))
             (let ((current (first *requests*)))
               (fake-settle d current)
               (check (eq :settled (getf (ltd:geometry-status d) :phase)))
               (check (= 1 (getf (ltd:geometry-status d) :target-presentation)))))
           (feed s "CONTENT")
           (lispterm::window-geometry-event host d (ltd:make-resize-event :rows 25 :columns 90 :interactive-p t))
           (check (= 90 (lispterm.engine:columns s)))
           (check (char= #\C (char-at s 0 0)) "manual resize preserves content")
           (let* ((r (ltd:request-grid-size d 132 25 4))
                  (old-epoch (getf (ltd:geometry-status d) :epoch)))
             ;; Same engine generation under new font metrics is a distinct epoch.
             (setf (ltd:display-font d) (ltd::load-font
                   (or (first (directory "/nix/store/*-terminus-font-*/share/fonts/terminus/ter-u20n.otb"))
                       (error "Terminus 20 fixture is missing")) 20))
             (ltd:geometry-tick d)
             (check (> (getf (ltd:geometry-status d) :epoch) old-epoch))
             (fake-settle d r)
             (check (eq :pending (getf (ltd:geometry-status d) :phase))))
           (incf clock (* 3 internal-time-units-per-second))
           (ltd:geometry-tick d)
           (check (eq :timed-out (getf (ltd:geometry-status d) :phase)))
           (check (= 90 (lispterm.engine:columns s)) "timeout alone does not resize")
           ;; A terminal failure no longer guards: an ordinary configure (X11 has
           ;; no interactive-p) adopts the actual grid and keeps content.
           (lispterm::window-geometry-event host d (ltd:make-resize-event :rows 30 :columns 100))
           (check (= 100 (lispterm.engine:columns s)) "configure after timeout resizes")
           (check (= 30 (lispterm.engine:rows s)))
           (check (equal '(30 100) (multiple-value-list (lispterm.pty:pty-window-size pty))))
           (check (char= #\C (char-at s 0 0)) "configure after timeout preserves content")
           (check (eq :timed-out (getf (ltd:geometry-status d) :phase))))
      (lispterm.pty:close-pty pty))))

(defmethod ltd:backend-request-size ((backend (eql :geometry-refuse)) display request)
  ;; A tiling compositor: immediate refusal.
  (declare (ignore backend))
  (push request *requests*)
  (ltd:geometry-result display request :refused :constrained-toplevel))
(defun terminal-failure-tests ()
  "Refused or timed-out requests release ordinary configures; active phases do not."
  (let* ((pty (lispterm.pty:open-pty)) (session (lispterm::make-session pty 24 80))
         (host (lispterm::%make-host :session session)) (d (fake-display))
         (s (lispterm::session-screen session)) (font (ltd:display-font d))
         (clock 0) (ltd::*geometry-clock* (lambda () clock)) (*requests* nil) (*cancellations* nil))
    (labels ((observe ()
               (sb-thread:with-mutex ((lispterm::session-lock session))
                 (lispterm::session-observe-geometry session))
               (lispterm::window-geometry-intent host d))
             (configure (columns rows)
               (ltd:resize-display d (* columns (ltd:font-width font)) (* rows (ltd:font-height font)))
               (lispterm::window-geometry-event
                host d (ltd:make-resize-event :rows rows :columns columns
                                              :width (ltd:display-width d) :height (ltd:display-height d))))
             (grid () (list (lispterm.engine:rows s) (lispterm.engine:columns s)
                            (multiple-value-list (lispterm.pty:pty-window-size pty))))
             (current-phase () (getf (ltd:geometry-status d) :phase)))
      (unwind-protect
           (progn
             (setf (lispterm::host-display host) d)
             ;; Refusal: three ordinary configures reach engine and PTY.
             (setf (ltd:display-backend d) :geometry-refuse)
             (feed s (concatenate 'string (esc "[?3h") "REFUSED"))
             (observe)
             (check (eq :refused (current-phase)))
             (check (equal '(24 132 (24 132)) (grid)) "refusal keeps DECCOLM grid until configure")
             (let ((refused (first *requests*)))
               (dotimes (i 3) (configure 100 30))
               (check (equal '(30 100 (30 100)) (grid)) "configure after refusal resizes")
               (check (char= #\R (char-at s 0 0)) "configure after refusal preserves content")
               ;; A late settle of the refused request cannot claim success.
               (ltd:geometry-result d refused :settled :late)
               (check (eq :refused (current-phase)) "stale refused settle ignored"))
             ;; Timeout: same recovery, late settle stays terminal.
             (setf (ltd:display-backend d) :geometry-test)
             (feed s (concatenate 'string (esc "[?3h") "TIMED"))
             (observe)
             (let ((timed (first *requests*)))
               (check (eq :pending (current-phase)))
               ;; Pending still guards against stale native geometry.
               (configure 100 30)
               (check (equal '(30 132 (30 132)) (grid)) "pending guards ordinary configure")
               (dolist (active '(:surface-ready :closing))
                 (ltd:geometry-result d timed active :test)
                 (check (eq active (current-phase)))
                 (configure 90 30)
                 (check (equal '(30 132 (30 132)) (grid)) "active phase guards ordinary configure"))
               (incf clock (* 3 internal-time-units-per-second))
               (ltd:geometry-tick d)
               (check (eq :timed-out (current-phase)))
               (ltd:geometry-result d timed :settled :late)
               (check (eq :timed-out (current-phase)) "stale timed-out settle ignored")
               (check (equal '(30 132 (30 132)) (grid)) "terminal phase without configure keeps grid")
               (configure 100 30)
               (check (equal '(30 100 (30 100)) (grid)) "configure after timeout resizes")
               (check (char= #\T (char-at s 0 0)) "configure after timeout preserves content")
               (fake-settle d timed)
               (check (eq :timed-out (current-phase)) "fake frame cannot settle timed-out request"))
             ;; A new DECCOLM after failure negotiates and guards again, then settles.
             (feed s (esc "[?3h"))
             (observe)
             (let ((fresh (first *requests*)))
               (check (eq :pending (current-phase)))
               (configure 100 30)
               (check (= 132 (lispterm.engine:columns s)) "new request guards again")
               (fake-settle d fresh)
               (check (eq :settled (current-phase)))
               (configure 110 30)
               (check (equal '(30 110 (30 110)) (grid)) "configure after settle resizes"))
             ;; Retry after timeout re-requests the current engine grid.
             (feed s (esc "[?3l"))
             (observe)
             (incf clock (* 3 internal-time-units-per-second))
             (ltd:geometry-tick d)
             (check (eq :timed-out (current-phase)))
             (lispterm::dispatch-host-command host (lispterm::make-host-command :operation :geometry-retry))
             (check (eq :pending (current-phase)))
             (check (= 80 (getf (ltd:geometry-status d) :requested-columns)))
             (configure 100 30)
             (check (= 80 (lispterm.engine:columns s)) "retry guards again")
             ;; Cancel adopts the actual display grid.
             (lispterm::dispatch-host-command host (lispterm::make-host-command :operation :geometry-cancel))
             (check (eq :cancelled (current-phase)))
             (check (equal '(30 100 (30 100)) (grid)) "cancel adopts actual grid"))
        (lispterm.pty:close-pty pty)))))

(defun random-intent-tests ()
  ;; A reproducible stream of requests, stale completions and deadline events.
  (let ((seed 108) (clock 0) (d (fake-display)) (*requests* nil) (*cancellations* nil)
        (history nil) (generation 0))
    (let ((ltd::*geometry-clock* (lambda () clock)))
      (labels ((next (n) (setf seed (mod (+ (* seed 1103515245) 12345) 2147483648)) (mod seed n)))
        (dotimes (step 300)
          (case (next 5)
            ((0 1) (push (ltd:request-grid-size d (if (zerop (next 2)) 80 132) 3 (incf generation)) history))
            (2 (when history
                 (let* ((r (nth (next (length history)) history))
                        (current (and (ltd:geometry-current-p d r) (ltd:geometry-active-p d)))
                        (before (ltd:geometry-status d)))
                   (ltd:geometry-result d r :settled :replayed-frame)
                   (unless current (check (equal before (ltd:geometry-status d)) "obsolete epoch settled")))))
            (3 (ltd:cancel-size-request d))
            (4 (incf clock internal-time-units-per-second) (ltd:geometry-tick d)))
          (check (= generation (or (getf (ltd:geometry-status d) :request-id) 0)))
          (check (<= (length *requests*) 300))
          (check (<= (length *cancellations*) 600)))))))

(in-package #:lispterm.display.wayland)
(defun geometry-test-configure (state width height serial &optional states)
  "Use the actual binding handlers, including toplevel array/serial pairing."
  (let ((wire (wayland-state-wire state)))
    (funcall (gethash (wayland-state-toplevel state) (wire-handlers wire))
             (wayland-state-toplevel state) 0
             (apply #'concatenate '(vector (unsigned-byte 8))
                    (u32-bytes width) (u32-bytes height) (u32-bytes (* 4 (length states)))
                    (mapcar #'u32-bytes states)))
    (funcall (gethash (wayland-state-xdg-surface state) (wire-handlers wire))
             (wayland-state-xdg-surface state) 0 (u32-bytes serial))))
(defun geometry-test-callbacks (state)
  (let ((wire (wayland-state-wire state)))
    (loop for id being the hash-keys of (wire-handlers wire)
          when (eq :callback (gethash id (wire-interfaces wire))) collect id)))
(defun geometry-test-done (state id)
  (funcall (gethash id (wire-handlers (wayland-state-wire state))) id 0 (u32-bytes 0)))
(defun geometry-protocol-tests (scale)
  (call-with-buffer-test-state
   (lambda (state old-buffer requests unmaps)
     (declare (ignore unmaps))
     (let* ((d (lispterm.geometry.tests::fake-display 80 2))
            (wire (wayland-state-wire state))
            (font (lispterm.display:display-font d))
            (width (* 132 (lispterm.display:font-width font)))
            (height (* 2 (lispterm.display:font-height font)))
            (events nil))
       (setf (lispterm.display:display-backend d) :wayland
             (lispterm.display:display-backend-state d) (make-wayland-window :protocol state)
             (wayland-state-geometry-display state) d
             (wayland-state-scale state) scale
             (wayland-state-resize-sink state)
             (lambda (w h scale) (declare (ignore scale)) (lispterm.display:resize-display d w h))
             (wayland-state-event-sink state) (lambda (event) (push event events))
             ;; An old busy buffer must survive every geometry transaction.
             (shm-buffer-busy-p old-buffer) t)
       (lispterm.display:request-grid-size d 132 2 1)
       (let ((target (wayland-state-geometry-request state)))
         (lispterm.geometry.tests::check (equal (subseq (reverse (funcall requests)) 0 4)
                                               (list (list (wayland-state-toplevel state) 8 0 0)
                                                     (list (wayland-state-toplevel state) 7 0 0)
                                                     (list (wayland-state-toplevel state) 7 width height)
                                                     (list (wayland-state-toplevel state) 8 width height))))
         (geometry-test-configure state 0 0 100 '(4))
         (lispterm.geometry.tests::check (= 100 (wayland-state-configure-serial state)))
         (lispterm.geometry.tests::check (equal '(4) (wayland-state-states state)))
         (lispterm.geometry.tests::check (= width (wayland-state-width state)) "zero chooses latest target")
         (lispterm.geometry.tests::check (find (list (wayland-state-xdg-surface state) 4 100)
                                               (funcall requests) :test #'equal))
         (let ((snap (first events)))
           (geometry-test-configure state (* 80 (lispterm.display:font-width font)) height 101)
           (let ((event (convert-event snap d)))
             (lispterm.geometry.tests::check (= width (lispterm.display:resize-event-width event))
                                            "queued event retains its own dimensions")
             (lispterm.geometry.tests::check (= 100 (lispterm.display:resize-event-serial event)))))
         ;; Restore target by a real ACK, present, then process frame and sync.
         (geometry-test-configure state width height 102)
         (lispterm.geometry.tests::check (protocol-present state (lispterm.display:display-framebuffer d) width height))
         (lispterm.geometry.tests::check (not (protocol-present state (lispterm.display:display-framebuffer d) width height))
                                        "frame pending is nonblocking")
         (let* ((buffer (find-if (lambda (b) (not (eq b old-buffer))) (wayland-state-buffers state)))
                (frame (first (geometry-test-callbacks state))))
           (lispterm.geometry.tests::check (= (* width scale) (shm-buffer-width buffer)))
           (lispterm.geometry.tests::check (= (* height scale) (shm-buffer-height buffer)))
           (lispterm.geometry.tests::check (member old-buffer (wayland-state-buffers state)))
           (geometry-test-done state frame)
           (lispterm.geometry.tests::check (eq :closing (getf (lispterm.display:geometry-status d) :phase)))
           (lispterm.geometry.tests::check (not (eq :settled (getf (lispterm.display:geometry-status d) :phase))))
           (let ((sync (first (geometry-test-callbacks state))))
             (geometry-test-done state sync))
           (lispterm.geometry.tests::check (eq :settled (getf (lispterm.display:geometry-status d) :phase)))
           (lispterm.geometry.tests::check (= 1 (getf (lispterm.display:geometry-status d) :target-presentation)))
           (lispterm.geometry.tests::check (lispterm.display:geometry-current-p d target))
           (lispterm.geometry.tests::check (equal (subseq (reverse (funcall requests)) (- (length (funcall requests)) 6)
                                                        (- (length (funcall requests)) 2))
                                                 (list (list (wayland-state-toplevel state) 8 0 0)
                                                       (list (wayland-state-toplevel state) 7 0 0)
                                                       (list (wayland-state-toplevel state) 7 0 0)
                                                       (list (wayland-state-toplevel state) 8 0 0))))))
       ;; Supersession while a frame is pending restores old hints behind a fence.
       (lispterm.display:request-grid-size d 80 2 2)
       (lispterm.display:request-grid-size d 132 2 3)
       (lispterm.geometry.tests::check (eq :closing (wayland-state-geometry-phase state)))
       (lispterm.geometry.tests::check (= 3 (lispterm.display:geometry-request-id (wayland-state-geometry-next state))))
       (geometry-test-done state (first (geometry-test-callbacks state)))
       (lispterm.geometry.tests::check (= 3 (lispterm.display:geometry-request-id (wayland-state-geometry-request state))))
       (geometry-test-configure state width height 103 '(3 4))
       (lispterm.geometry.tests::check (eq :cancelled (getf (lispterm.display:geometry-status d) :phase)))
       (lispterm.geometry.tests::check (getf (cdr (first events)) :interactive-p))
       (geometry-test-done state (first (geometry-test-callbacks state)))
       (setf (wayland-state-states state) '(1))
       (lispterm.display:request-grid-size d 132 2 4)
       (lispterm.geometry.tests::check (eq :refused (getf (lispterm.display:geometry-status d) :phase)))
       (lispterm.geometry.tests::check (null (wayland-state-geometry-request state)))
       ;; A timeout releases hints even without a configure or frame callback.
       (setf (wayland-state-states state) nil)
       (let ((lispterm.display::*geometry-timeout* 0))
         (lispterm.display:request-grid-size d 132 2 5)
         (lispterm.display:geometry-tick d)
         (lispterm.geometry.tests::check (eq :timed-out (getf (lispterm.display:geometry-status d) :phase)))
         (geometry-test-done state (first (geometry-test-callbacks state)))
         (lispterm.geometry.tests::check (null (wayland-state-geometry-request state))))))))

(in-package #:lispterm.geometry.tests)
(defun x11-protocol-tests ()
  (let* ((d (fake-display)) (requests nil) (callbacks nil)
         (s (lispterm.display.x11::make-x-state :client :fake :window 42)))
    (setf (ltd:display-backend d) :x11 (ltd:display-backend-state d) s)
    (with-functions
        ((xclhb:configure-window (lambda (&rest args) (push args requests)))
         (xclhb:get-geometry (lambda (client callback window)
                              (check (eq client :fake)) (check (= window 42))
                              (push callback callbacks)))
         (xclhb:flush (lambda (client) (check (eq client :fake)))))
      (let* ((r (ltd:request-grid-size d 132 24 1))
             (w (ltd:geometry-request-width r)) (h (ltd:geometry-request-height r)))
        (check (equal (first requests) (list :fake 42 12 0 0 w h 0 0 0)))
        (check (null callbacks) "changed size requires ConfigureNotify, not GetGeometry")
        (lispterm.display.x11::x11-handle-configure d 42 w h 1 nil)
        (check (eq :surface-ready (getf (ltd:geometry-status d) :phase)))
        (lispterm.display.x11::x11-geometry-presented d)
        (check (eq :closing (getf (ltd:geometry-status d) :phase)))
        (funcall (pop callbacks) (xclhb:make-get-geometry-reply :width w :height h))
        (check (eq :settled (getf (ltd:geometry-status d) :phase)))
        (check (= 1 (getf (ltd:geometry-status d) :target-presentation)))))))

(defun call-with-x11-renderer (function)
  "Keep rendering and geometry callbacks real; replace only native transport."
  (let* ((d (fake-display)) (session (lispterm::make-session nil 24 80))
         (state (lispterm.display.x11::make-x-state :client :fake :window 42))
         (callbacks nil) (blits 0) (configures 0) (clock 0))
    (setf (ltd:display-backend d) :x11 (ltd:display-backend-state d) state
          (lispterm::session-last-title session)
          (nerimux/terminal:screen-title (lispterm::session-screen session)))
    (let ((ltd::*geometry-clock* (lambda () clock)))
      (with-functions
          ((xclhb:configure-window (lambda (&rest args) (declare (ignore args)) (incf configures)))
           (xclhb:get-geometry (lambda (client callback window)
                                (check (eq client :fake)) (check (= window 42))
                                (setf callbacks (nconc callbacks (list callback)))))
           (xclhb:flush (lambda (client) (check (eq client :fake))))
           (ltd:backend-blit (lambda (backend display framebuffer rectangles)
                               (declare (ignore framebuffer rectangles))
                               (check (eq backend :x11)) (check (eq display d))
                               (incf blits)
                               (lispterm.display.x11::x11-geometry-presented display))))
        (flet ((render () (lispterm::render-session session d :now 0))
               (reply (columns &optional (rows 24))
                 (check callbacks "a query must precede its reply")
                 (funcall (pop callbacks)
                          (xclhb:make-get-geometry-reply
                           :width (* columns (ltd:font-width (ltd:display-font d)))
                           :height (* rows (ltd:font-height (ltd:display-font d))))))
               (stats () (list :blits blits :queries (length callbacks) :configures configures))
               (expire () (setf clock (* 3 internal-time-units-per-second)) (ltd:geometry-tick d)))
          ;; Start with a genuinely rendered, clean screen and unchanged cursor.
          (render)
          (setf blits 0)
          (funcall function d session #'render #'reply #'stats #'expire))))))

(defun x11-renderer-tests ()
  ;; The first case failed before the renderer fix: no engine damage or resize
  ;; event survives the matching same-size reply, but a closing frame is owed.
  (dolist (order '(:clean-before-reply :dirty-at-reply :size-change))
    (call-with-x11-renderer
     (lambda (d session render reply stats expire)
       (declare (ignore expire))
       (let ((columns (if (eq order :size-change) 132 80)))
         (feed (lispterm::session-screen session) (esc (if (= columns 132) "[?3h" "[?3l")))
         (ltd:request-grid-size d columns 24 1)
         (when (eq order :clean-before-reply) (funcall render))
         (let ((frames (lispterm::session-frames session))
               (blits (getf (funcall stats) :blits)))
          (if (= columns 132)
              (let ((r (ltd:display-geometry-request d)))
                (lispterm.display.x11::x11-handle-configure
                 d 42 (ltd:geometry-request-width r) (ltd:geometry-request-height r) 1 nil))
              (funcall reply columns))
           (check (eq :surface-ready (getf (ltd:geometry-status d) :phase)))
           (check (= (if (= columns 132) 1 0) (getf (funcall stats) :configures))
                  "same-size requests query without configuring")
           (when (eq order :clean-before-reply)
             (check (not (lispterm.engine:dirty-p (lispterm::session-screen session))))
             (check (not (lispterm::session-force-frame session))))
           (when (= columns 80)
             (check (null (lispterm.display.x11::x-state-events (ltd:display-backend-state d)))
                    "same-size reply queues no resize"))
           (funcall render)
           (check (= (1+ frames) (lispterm::session-frames session)) "ready geometry needs one renderer frame")
           (check (= (1+ blits) (getf (funcall stats) :blits)))
           (check (eq :closing (getf (ltd:geometry-status d) :phase)))
           (check (= 1 (getf (funcall stats) :queries)))
           (check (zerop (ltd:display-presentation-generation d)))
           (funcall render)
           (check (= (1+ frames) (lispterm::session-frames session)) "closing does not redraw")
           (funcall reply columns)
           (check (eq :settled (getf (ltd:geometry-status d) :phase)))
           (check (= 1 (ltd:display-presentation-generation d)))
           (dotimes (i 3) (funcall render))
           (check (= (1+ frames) (lispterm::session-frames session)) "settled idle does not redraw"))))))
  (call-with-x11-renderer
   (lambda (d session render reply stats expire)
     (declare (ignore session expire))
     (let ((old (ltd:request-grid-size d 80 24 1)))
       (ltd:request-grid-size d 80 24 2)
       (check (= 1 (getf (funcall stats) :queries)) "one outstanding query")
       (funcall reply 80)
       (check (eq :pending (getf (ltd:geometry-status d) :phase)) "superseded reply cannot ready successor")
       (funcall render)
       (check (zerop (getf (funcall stats) :blits)))
       (check (= 1 (getf (funcall stats) :queries)))
       (ltd:geometry-result d old :surface-ready)
       (check (eq :pending (getf (ltd:geometry-status d) :phase)))
       (funcall reply 80)
       (funcall render)
       (check (= 1 (getf (funcall stats) :blits)))
       (check (eq :closing (getf (ltd:geometry-status d) :phase)))
       ;; Supersede a closing query too: it cannot settle the new request.
       (ltd:request-grid-size d 80 24 3)
       (funcall reply 80)
       (check (eq :pending (getf (ltd:geometry-status d) :phase)))
       (check (zerop (ltd:display-presentation-generation d)))
       (funcall reply 80)
       (funcall render)
       (funcall reply 80)
       (check (eq :settled (getf (ltd:geometry-status d) :phase)))
       (check (= 1 (ltd:display-presentation-generation d))))))
  (dolist (stop '(:missing-initial :missing-closing :incompatible-closing :cancelled :stale-display))
    (call-with-x11-renderer
     (lambda (d session render reply stats expire)
       (declare (ignore session))
       (let ((request (ltd:request-grid-size d 80 24 1)))
         (unless (eq stop :missing-initial) (funcall reply 80))
         (case stop
           ((:missing-closing :incompatible-closing)
            (funcall render)
            (when (eq stop :incompatible-closing)
              (funcall reply 81)
              (check (eq :closing (getf (ltd:geometry-status d) :phase)))
              (check (zerop (ltd:display-presentation-generation d)))))
           (:cancelled (ltd:cancel-size-request d))
           (:stale-display (incf (ltd::display-epoch d))))
         (let ((blits (getf (funcall stats) :blits)))
           (funcall render)
           (check (= blits (getf (funcall stats) :blits)) "inactive or stale geometry cannot redraw"))
         (unless (eq stop :stale-display)
           (funcall expire)
           (check (eq (if (eq stop :cancelled) :cancelled :timed-out)
                      (getf (ltd:geometry-status d) :phase)))
           (ltd:geometry-result d request :surface-ready)
           (when (plusp (getf (funcall stats) :queries)) (funcall reply 80))
           (check (zerop (ltd:display-presentation-generation d)))
           (let ((blits (getf (funcall stats) :blits)))
             (funcall render)
             (check (= blits (getf (funcall stats) :blits)) "late success cannot revive terminal request"))))))))

(defun pty-geometry-test ()
  (let* ((pty (lispterm.pty:open-pty)) (session (lispterm::make-session pty 24 80))
         (transcript ""))
    (labels ((until-text (text)
               (let ((end (+ (get-internal-real-time) (* 5 internal-time-units-per-second))))
                 (loop until (search text transcript) do
                   (check (< (get-internal-real-time) end) (format nil "missing PTY text ~S in ~S" text transcript))
                   (let ((data (lispterm::session-read-output session)))
                     (when (vectorp data)
                       (setf transcript (concatenate 'string transcript
                                                    (babel:octets-to-string data :encoding :utf-8)))))
                   (sleep .005)))))
      (unwind-protect
           (progn
             (lispterm.pty:spawn-on-pty pty
               (list "bash" "-c"
                 (format nil "stty -echo; trap 'printf \"WINCH \"; stty size' WINCH; printf 'READY~%'; while :; do read -r line; case $line in wide) printf '~c[?3h~c[1;100HX';; report) printf 'REPORT '; stty size;; done) exit;; esac; done" #\Esc #\Esc)))
             (until-text "READY")
             (lispterm::session-write session (bytes (format nil "wide~%")))
             (until-text (concatenate 'string (esc "[1;100H") "X"))
             (check (= 1 (lispterm::session-geometry-generation session)))
             (check (= 132 (lispterm::session-pty-columns session)))
             (check (char= #\X (char-at (lispterm::session-screen session) 0 99)))
             (lispterm::session-write session (bytes (format nil "report~%")))
             (until-text "REPORT 24 132")
             (until-text "WINCH 24 132")
             (format t "PTY-GEOMETRY-TRANSCRIPT ~S~%" transcript)
             (lispterm::session-write session (bytes (format nil "done~%")))
             (lispterm::session-flush-input session))
        (lispterm.pty:close-pty pty)))))
(defun x11-pty-order-tests ()
  "Drive the real owner and PTY, substituting only input bytes and X transport."
  (let* ((pty (lispterm.pty:open-pty)) (session (lispterm::make-session pty 24 80))
         (host (lispterm::%make-host :session session)) (d (fake-display))
         (state (lispterm.display.x11::make-x-state :client :fake :window 42))
         (screen (lispterm::session-screen session)) (font (ltd:display-font d))
         (requests nil) (callbacks nil) (input nil) (clock 0) (serial 0)
         (pending-configure nil) (resizes nil) (wire nil) (reads 0)
         (resize (symbol-function 'lispterm.pty:pty-resize))
         (ltd::*geometry-clock* (lambda () clock)))
    (setf (ltd:display-backend d) :x11 (ltd:display-backend-state d) state)
    (unwind-protect
         (with-functions
             ((ltd:open-display (lambda (&rest args) (declare (ignore args)) d))
              (ltd:set-title (lambda (&rest args) (declare (ignore args))))
              (ltd:close-display (lambda (display) (check (eq display d))))
              (lispterm.pty:pty-read (lambda (endpoint &key timeout)
                                      (declare (ignore timeout))
                                      (check (eq endpoint pty))
                                      (incf reads)
                                       (prog1 input (setf input nil))))
               (lispterm.pty:pty-write
                (lambda (endpoint packet &key timeout)
                  (declare (ignore timeout))
                  (check (eq endpoint pty))
                  (push (list :write (babel:octets-to-string packet :encoding :utf-8)
                              (nth-value 1 (lispterm.pty:pty-window-size pty))) wire)
                  (length packet)))
              (lispterm.pty:pty-resize
               (lambda (endpoint rows columns)
                 (check (eq endpoint pty))
                 (check (equal (list rows columns)
                               (list (ltd:display-rows d) (ltd:display-columns d)))
                        "ioctl size follows already observed window geometry")
                  (funcall resize endpoint rows columns)
                  (push (list rows columns) resizes)
                  (push (list :resize columns) wire)))
              (xclhb:configure-window
               (lambda (client window mask x y width height &rest args)
                 (declare (ignore mask x y args))
                 (check (and (eq client :fake) (= window 42)))
                 (push (list width height) requests)))
              (xclhb:get-geometry
               (lambda (client callback window)
                 (check (and (eq client :fake) (= window 42)))
                 (push callback callbacks)))
              (xclhb:flush (lambda (client) (check (eq client :fake))))
              (ltd:poll-events
               (lambda (display &key timeout)
                 (declare (ignore timeout))
                 (check (eq display d))
                 (when pending-configure (funcall pending-configure))
                 (setf pending-configure nil)
                 (prog1 (nreverse (lispterm.display.x11::x-state-events state))
                   (setf (lispterm.display.x11::x-state-events state) nil))))
              (lispterm::render-session (lambda (&rest args) (declare (ignore args)))))
           (labels ((step-owner (&optional tick)
                      (lispterm::display-step host :render-p tick))
                    (output (text)
                      (setf input (bytes text))
                      (check (lispterm::session-read-output session))
                      (step-owner))
                    (configure (columns &key (rows 24) (window 42) synthetic)
                      (setf pending-configure
                            (lambda ()
                              (lispterm.display.x11::x11-handle-configure
                               d window (* columns (ltd:font-width font))
                               (* rows (ltd:font-height font)) (incf serial) synthetic)))
                      (step-owner))
                    (pty-size () (multiple-value-list (lispterm.pty:pty-window-size pty)))
                    (check-grid (rows columns)
                      (check (equal (list rows columns) (pty-size)) "kernel PTY size")
                      (check (= rows (lispterm.engine:rows screen)))
                      (check (= columns (lispterm.engine:columns screen))))
                    (drain () (lispterm::session-read-output session))
                     (expire ()
                      (incf clock (* 3 internal-time-units-per-second))
                      (step-owner t)))
             (lispterm::window-open host)
             (check-grid 24 80)
              (let ((query (concatenate 'string (esc "[1;999H") (esc "[6n"))))
                (output (concatenate 'string (esc "[6n") (esc "[?3;25h") query "X"
                                     (esc "[?3l") query "Y"))
                (check-grid 24 80)
                (let ((count reads))
                  (check (null (drain)))
                  (check (= reads count) "held parser does not read a second chunk"))
                (check (equal wire (list (list :write (esc "[1;1R") 80)))
                       "only the pre-boundary reply was written")
                (let ((status (lispterm:status host)))
                  (check (equal '(24 80) (list (getf status :rows) (getf status :columns)))))
                (check (equal (list (* 132 (ltd:font-width font)) (* 24 (ltd:font-height font)))
                              (first requests)) "ConfigureWindow was sent before any ioctl")
                (configure 132 :synthetic t)
                (configure 132 :window 99)
                (configure 80)
                (check (null (drain)))
                (check (null resizes) "ignored ConfigureNotify events never trigger ioctl")
                (configure 132)
                (check-grid 24 132)
                (let ((received (lispterm::session-bytes-received session)))
                  (check (drain) "wide suffix parsed, stopping at narrow sequence")
                  (step-owner)
                  (check-grid 24 132)
                  (check (null (drain)))
                  (check (equal (first wire) (list :write (esc "[1;132R") 132)))
                  (configure 80)
                  (check-grid 24 80)
                  (check (drain))
                  (drain)
                  (check (equal (reverse wire)
                                (list (list :write (esc "[1;1R") 80) '(:resize 132)
                                      (list :write (esc "[1;132R") 132) '(:resize 80)
                                      (list :write (esc "[1;80R") 80)))
                         "successful ioctls precede each following CPR, exactly once")
                  (check (= received (lispterm::session-bytes-received session)))
                  (check (char= #\Y (char-at screen 0 79))))
                (check (equal '((24 80) (24 132)) resizes)))
             ;; Refused: no size-changing configure, no ioctl, and no guessed grid.
             (output (concatenate 'string (esc "[?3h") "TIMEOUT"))
             (check (equal '(24 80) (pty-size)))
             (expire)
              (check (drain))
             (check-grid 24 80)
             (check (char= #\T (char-at screen 0 0)))
             (check (= 2 (length resizes)))
             (configure 132) ; a genuine late size is still authoritative
             (check-grid 24 132)
             (check (eq :timed-out (getf (ltd:geometry-status d) :phase)))
             (configure 80)
             (check-grid 24 80)

             ;; An actual WM-adjusted size is authoritative, even during a request.
             (output (concatenate 'string (esc "[?3h") "ADJUSTED"))
             (configure 100 :rows 25)
             (check-grid 25 100)
              (check (null (drain)) "interim adjustment is not settlement")
              (expire)
              (check (drain))
              (check (char= #\A (char-at screen 0 0)))
             (check-grid 25 100)
             (configure 80) ; external resize without a DECCOLM request
             (check-grid 24 80)

             ;; The reverse request must be sent despite the last observed width
             ;; still being 80. Neither guessed target may trigger a PTY change.
             (let ((prior-resizes resizes) (prior-requests (length requests)))
               (output (esc "[?3h"))
                (check (lispterm::session-geometry-paused-p session) "exact read end pauses")
                (check (null (drain)))
                (expire)
               (output (esc "[?3l"))
               (check (equal (list (* 80 (ltd:font-width font)) (* 24 (ltd:font-height font)))
                             (first requests)) "rapid reverse sends 80 on the wire")
               (check (= (+ 2 prior-requests) (length requests)))
               (check (eq prior-resizes resizes))
               (configure 132)
               (check-grid 24 132)
               (let ((status (lispterm:status host)) (geometry (ltd:geometry-status d)))
                 (check (= 132 (getf status :columns)) "owner publishes the real intermediate width")
                 (check (eq :pending (getf geometry :phase)))
                 (check (= 80 (getf geometry :requested-columns))))
               (configure 80)
               (check-grid 24 80)
               (check (eq :surface-ready (getf (ltd:geometry-status d) :phase))))

              ;; Same-size DECCOLM clears and waits for server confirmation, without ioctl.
              (let ((prior-resizes resizes))
                (output "OLD")
                (output (concatenate 'string (esc "[?3l") "SAME"))
                (check (char= #\Space (char-at screen 0 0)))
                (check (null (drain)))
                (funcall (pop callbacks)
                         (xclhb:make-get-geometry-reply :width (ltd:display-width d)
                                                        :height (ltd:display-height d)))
                (step-owner)
                (check (drain))
                (check (char= #\S (char-at screen 0 0)))
                (check-grid 24 80)
                (check (eq prior-resizes resizes)))
              (output (concatenate 'string (esc "[?3h") "CANCELLED"))
              (lispterm::dispatch-host-command host (lispterm::make-host-command :operation :geometry-cancel))
              (check (drain))
              (check (char= #\C (char-at screen 0 0)))
              (output (concatenate 'string (esc "[?3h") "DETACHED"))
              (lispterm::window-close host)
              (check (drain))
              (check-grid 24 80)
              (check (char= #\D (char-at screen 0 0)))
              ;; A failed ioctl must not expose the configured width to the tail.
              (lispterm::window-open host)
              (output (concatenate 'string (esc "[?3h") (esc "[1;999H") (esc "[6n")))
              (let ((schedule (lispterm::make-owner-schedule)))
                (setf pending-configure
                      (lambda ()
                        (lispterm.display.x11::x11-handle-configure
                         d 42 (* 132 (ltd:font-width font)) (ltd:display-height d) (incf serial) nil)))
                (with-functions ((lispterm.pty:pty-resize
                                  (lambda (&rest args) (declare (ignore args)) (error "Injected resize failure"))))
                  (lispterm::owner-iteration host schedule))
                (check (eq :detached (lispterm::host-state-value host)))
                (check (lispterm:host-errors host))
                (check-grid 24 80)
                (drain)
                (check (equal (first wire) (list :write (esc "[1;80R") 80))
                       "fault releases only after detaching back to the committed grid"))
             (setf input (bytes (esc "[?3h")))
             ;; Detached sessions keep immediate behavior, so use the real ioctl
             ;; without the attached-window invariant from the instrumentation.
             (with-functions ((lispterm.pty:pty-resize resize))
               (check (lispterm::session-read-output session)))
             (check-grid 24 132)))
      (lispterm.pty:close-pty pty))))

(defun deferred-engine-test ()
  (let* ((s (lispterm.engine:make-screen :rows 4 :columns 80))
         (sequence (esc "[?3;25l"))
         (packet (bytes (concatenate 'string sequence "X"))))
    ;; Begin in one read and consume the final byte in the next.
    (lispterm.engine:feed s (subseq packet 0 3) :defer-geometry t)
    (multiple-value-bind (next paused-p) (lispterm.engine:feed s packet :start 3 :defer-geometry t)
      (check (and paused-p (= next (length sequence))))
      (check (= 80 (lispterm.engine:columns s)))
      (check (not (nerimux/terminal/types:screen-cursor-visible s)) "remaining CSI parameters run")
      (check (char= #\Space (char-at s 0 0)))
      (lispterm.engine:feed s packet :start next :defer-geometry t)
      (check (char= #\X (char-at s 0 0))))))
(defun run-tests ()
  (setf *checks* 0)
  (engine-tests)
  (deferred-engine-test)
  (fake-state-tests)
  (terminal-failure-tests)
  (epoch-and-recovery-tests)
  (random-intent-tests)
  (x11-protocol-tests)
  (x11-renderer-tests)
  (x11-wire-test)
  (lispterm.display.wayland::geometry-protocol-tests 1)
  (lispterm.display.wayland::geometry-protocol-tests 2)
  (lispterm.display.wayland::geometry-extra-protocol-tests)
  (pty-geometry-test)
  (x11-pty-order-tests)
  (format t "VT100 GEOMETRY PASS: ~D checks~%" *checks*))

(defun x11-wire-test ()
  ;; Exercise the generated encoder itself, not a guessed wrapper signature.
  ;; The wire bytes go to a unique test-owned temporary file that UIOP
  ;; deletes on exit, so no evidence directory is written.
  (let ((d (fake-display)) (wire-path nil))
    (uiop:with-temporary-file (:stream stream :pathname path :direction :io
                               :element-type '(unsigned-byte 8)
                               :prefix "lispterm-x11-wire-" :type "bin")
      (setf wire-path path)
      (let* ((client (xclhb:make-client :stream stream))
             (state (lispterm.display.x11::make-x-state :client client :window 42)))
        (setf (ltd:display-backend d) :x11 (ltd:display-backend-state d) state)
        (let ((r (ltd:request-grid-size d 132 24 1)))
          (let ((w (ltd:geometry-request-width r)) (h (ltd:geometry-request-height r)))
            (check (zerop (length (xclhb:client-request-reply-callback-table client)))
                   "changed size sends only ConfigureWindow")
            (check (= 20 (file-position stream)))
            (lispterm.display.x11::x11-handle-configure d 42 w h 1 nil)
            (dotimes (n 100) (ltd:request-grid-size d 132 24 (+ n 2)))
            (check (= 1 (length (xclhb:client-request-reply-callback-table client)))
                   "same-size requests share one outstanding GetGeometry")
            (check (= 101 (ltd:geometry-request-id (lispterm.display.x11::x-state-geometry-next state))))
            (check (= 28 (file-position stream)))
            (file-position stream 0)
            (let ((raw (make-array 28 :element-type '(unsigned-byte 8))))
              (check (= 28 (read-sequence raw stream)))
              (check (equalp (subseq raw 0 12) #(12 0 5 0 42 0 0 0 12 0 0 0)))
              (check (= w (lispterm.display.wayland::bytes-u32 raw 12)))
              (check (= h (lispterm.display.wayland::bytes-u32 raw 16)))
              (check (equalp (subseq raw 20) #(14 0 2 0 42 0 0 0)))))
          (ltd:cancel-size-request d)
          (check (null (lispterm.display.x11::x-state-geometry-next state))))))
    (check (and wire-path (null (probe-file wire-path))))))

(in-package #:lispterm.display.wayland)
(defun geometry-extra-protocol-tests ()
  (call-with-buffer-test-state
   (lambda (state old-buffer requests unmaps)
     (declare (ignore old-buffer unmaps))
     (let* ((d (lispterm.geometry.tests::fake-display 80 2))
            (font (lispterm.display:display-font d))
            (width132 (* 132 (lispterm.display:font-width font)))
            (height (* 2 (lispterm.display:font-height font))))
       (setf (lispterm.display:display-backend d) :wayland
             (lispterm.display:display-backend-state d) (make-wayland-window :protocol state)
             (wayland-state-geometry-display state) d
             (wayland-state-resize-sink state)
             (lambda (w h scale) (declare (ignore scale)) (lispterm.display:resize-display d w h))
             (wayland-state-normal-min-width state) 20
             (wayland-state-normal-min-height state) 10
             (wayland-state-normal-max-width state) 4096
             (wayland-state-normal-max-height state) 4096)
       (labels ((present-target ()
                  (lispterm.geometry.tests::check
                   (protocol-present state (lispterm.display:display-framebuffer d)
                                     (wayland-state-width state) (wayland-state-height state))))
                (callback () (geometry-test-done state (first (sort (geometry-test-callbacks state) #'<)))))
         ;; No configure is required for a client-initiated floating resize.
         (lispterm.display:request-grid-size d 132 2 1)
         (present-target)
         (callback)
         (lispterm.geometry.tests::check
          (equal (subseq (reverse (funcall requests)) (- (length (funcall requests)) 6)
                         (- (length (funcall requests)) 2))
                 (list (list (wayland-state-toplevel state) 8 0 0)
                       (list (wayland-state-toplevel state) 7 0 0)
                       (list (wayland-state-toplevel state) 7 4096 4096)
                       (list (wayland-state-toplevel state) 8 20 10))))
         (callback)
         (lispterm.geometry.tests::check (eq :settled (getf (lispterm.display:geometry-status d) :phase)))
         ;; A matching frame alone cannot settle an incompatible closing configure.
         (lispterm.display:request-grid-size d 80 2 2)
         (present-target)
         (callback)
         (geometry-test-configure state width132 height 300)
         (callback)
         (lispterm.geometry.tests::check (eq :refused (getf (lispterm.display:geometry-status d) :phase)))
         ;; Supersede a submitted frame: old callbacks cannot present the new epoch.
         (lispterm.display:request-grid-size d 132 2 3)
         (present-target)
         (let ((presentation (lispterm.display:display-presentation-generation d)))
           (lispterm.display:request-grid-size d 80 2 4)
           (callback)
           (lispterm.geometry.tests::check (= presentation (lispterm.display:display-presentation-generation d)))
           (callback)
           (lispterm.geometry.tests::check (= 4 (getf (lispterm.display:geometry-status d) :request-id)))
           (lispterm.geometry.tests::check (eq :surface-ready (getf (lispterm.display:geometry-status d) :phase))))
         (lispterm.display:cancel-size-request d)
         (callback)
         (lispterm.geometry.tests::check (null (wayland-state-geometry-request state))))))))
(in-package #:lispterm.geometry.tests)

(defmethod ltd:backend-close ((backend (eql :geometry-test)) display)
  (declare (ignore backend display)))
(defun epoch-and-recovery-tests ()
  (let* ((d1 (fake-display)) (d2 (fake-display))
         (r1 (ltd:request-grid-size d1 132 24 1))
         (epoch1 (getf (ltd:geometry-status d1) :display-epoch)))
    (ltd:close-display d1)
    (check (not (ltd:geometry-current-p d1 r1)))
    (check (> (getf (ltd:geometry-status d1) :display-epoch) epoch1))
    (ltd:request-grid-size d2 132 24 1)
    (ltd:geometry-result d2 r1 :settled :old-window)
    (check (eq :pending (getf (ltd:geometry-status d2) :phase)))
    (handler-bind ((ltd:geometry-incomplete
                     (lambda (condition)
                       (check (typep (ltd:geometry-incomplete-request condition) 'ltd:geometry-request))
                       (invoke-restart 'ltd::cancel))))
      (ltd:require-geometry-ready d2))
    (check (eq :cancelled (getf (ltd:geometry-status d2) :phase))))
  (let* ((pty (lispterm.pty:open-pty)) (session (lispterm::make-session pty 24 80))
         (host (lispterm::%make-host :session session)) (d (fake-display)))
    (unwind-protect
         (progn
           (feed (lispterm::session-screen session) (esc "[?3h"))
           (sb-thread:with-mutex ((lispterm::session-lock session)) (lispterm::session-observe-geometry session))
           (lispterm::window-geometry-intent host d)
           (lispterm::window-geometry-event host d (ltd:make-resize-event :columns 90 :rows 25 :interactive-p t))
           (let ((new-display (fake-display)))
             (setf (lispterm::host-geometry-sent-generation host) nil)
             (lispterm::window-geometry-intent host new-display)
             (check (= 90 (getf (ltd:geometry-status new-display) :requested-columns))
                    "reopen uses current engine grid, not last DECCOLM width")
             (check (= 25 (getf (ltd:geometry-status new-display) :requested-rows)))))
      (lispterm.pty:close-pty pty))))
