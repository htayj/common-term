(defpackage #:lispterm.pty.close-tests (:use #:cl #:lispterm.pty))
(in-package #:lispterm.pty.close-tests)

(defvar *checks* 0)
(defun check (name value)
  (incf *checks*)
  (unless value (error "PTY close check failed: ~A" name)))
(defun seconds () (/ (get-internal-real-time) internal-time-units-per-second))
(defun wait-for (semaphore)
  (unless (sb-thread:wait-on-semaphore semaphore :timeout 3)
    (error "Barrier timed out")))
(defun join (thread)
  (sb-thread:join-thread thread :timeout 3 :default :join-timeout))
(defun fd-count ()
  (let ((directory (sb-posix:opendir "/proc/self/fd")) (count 0))
    (unwind-protect
         (loop for entry = (sb-posix:readdir directory)
               until (sb-alien:null-alien entry)
               unless (member (sb-posix:dirent-name entry) '("." "..") :test #'string=)
                 do (incf count))
      (sb-posix:closedir directory))
    count))
(defun closed-error-p (thunk)
  (handler-case (progn (funcall thunk) nil) (pty-closed-error () t)))

(defun cancellation-barrier-test (operation)
  ;; Hold the *actual* transport mutex inside the readiness call. Publication
  ;; must finish while that mutex is unavailable. Queued IO must then skip
  ;; readiness entirely, independent of mutex handoff fairness.
  (let* ((pty (open-pty)) (fd (pty-master-fd pty))
         (entered (sb-thread:make-semaphore))
         (release (sb-thread:make-semaphore))
         (published (sb-thread:make-semaphore))
         (admitted (sb-thread:make-semaphore))
         (ensure-original (symbol-function 'lispterm.pty::%ensure-open))
         (ready-original (symbol-function 'lispterm.pty::%ready))
         (request-original (symbol-function 'lispterm.pty::%request-close))
         (close-original (symbol-function 'lispterm.pty::%close))
         (calls 0) (closes 0) (workers nil) (closers nil)
         (bytes (make-array 8 :element-type '(unsigned-byte 8) :initial-element 65)))
    (unwind-protect
         (progn
           (setf (symbol-function 'lispterm.pty::%ready)
                 (lambda (descriptor events deadline)
                   (declare (ignore descriptor events deadline))
                   (incf calls)
                   (sb-thread:signal-semaphore entered)
                   (wait-for release)
                   nil)
                 (symbol-function 'lispterm.pty::%ensure-open)
                 (lambda (transport)
                   (prog1 (funcall ensure-original transport)
                     (sb-thread:signal-semaphore admitted)))
                 (symbol-function 'lispterm.pty::%request-close)
                 (lambda (transport)
                   (prog1 (funcall request-original transport)
                     (sb-thread:signal-semaphore published)))
                 (symbol-function 'lispterm.pty::%close)
                 (lambda (descriptor)
                   (when (= descriptor fd) (incf closes))
                   (funcall close-original descriptor)))
           (push (sb-thread:make-thread
                  (lambda () (if (eq operation :read) (pty-read pty :timeout 30)
                                 (pty-write pty bytes :timeout 30)))) workers)
           (wait-for entered)
           (dotimes (i 6)
             (let ((reader (evenp i)))
               (push (sb-thread:make-thread
                      (lambda ()
                        (handler-case
                            (if reader (pty-read pty :timeout 30)
                                (pty-write pty bytes :timeout 30))
                          (pty-closed-error () :closed)))) workers)))
           ;; All seven calls have passed the real open check before close;
           ;; six are now waiting behind the locked readiness barrier.
           (dotimes (i 7) (wait-for admitted))
           (dotimes (i 3)
             (push (sb-thread:make-thread (lambda () (close-pty pty))) closers))
           (wait-for published)
           (check :published-while-syscall-locked (lispterm.pty::%close-requested-p pty))
           (check :active-fd-not-closed (>= (lispterm.pty::%fcntl fd 1 0) 0))
           (check :closed-entry-read (closed-error-p (lambda () (pty-read pty))))
           (check :closed-entry-write (closed-error-p (lambda () (pty-write pty bytes))))
           (sb-thread:signal-semaphore release)
           (let ((results (mapcar #'join (reverse workers))))
             (check :active-io-cancelled (eql (first results) (if (eq operation :read) :eof 0)))
             (check :queued-io-cancelled
                    (every (lambda (result) (member result '(:eof 0))) results)))
           (check :concurrent-closers (every #'identity (mapcar (lambda (thread) (eq t (join thread))) closers)))
           (check :no-poll-after-request (= 1 calls))
           (check :exactly-one-close (= 1 closes))
           (check :closed-fd (and (= -1 (lispterm.pty::%fcntl fd 1 0))
                                  (= sb-posix:ebadf (lispterm.pty::%errno)))))
      (sb-thread:signal-semaphore release 10)
      (mapc #'join workers)
      (mapc #'join closers)
      (setf (symbol-function 'lispterm.pty::%ready) ready-original
            (symbol-function 'lispterm.pty::%ensure-open) ensure-original
            (symbol-function 'lispterm.pty::%request-close) request-original
            (symbol-function 'lispterm.pty::%close) close-original)
      (close-pty pty))))

(defun stress-one (child-p)
  (let* ((pty (open-pty)) (workers nil) (closers nil) (process nil)
         (started (sb-thread:make-semaphore))
         (payload (make-array 262144 :element-type '(unsigned-byte 8) :initial-element 65)))
    (unwind-protect
         (progn
           (when child-p
             (setf process (spawn-on-pty pty '("sh" "-c"
                             "trap '' HUP; stty -echo -icanon; printf READY; while :; do :; done")))
             (loop with text = ""
                   for data = (pty-read pty :timeout 1)
                   do (unless (vectorp data) (error "Child did not start"))
                      (setf text (concatenate 'string text (sb-ext:octets-to-string data)))
                   until (search "READY" text)))
           (dotimes (i 6)
             (let ((reader (< i 4)))
               (push (sb-thread:make-thread
                      (lambda ()
                        (sb-thread:signal-semaphore started)
                        (handler-case
                            (if reader
                                (loop for result = (pty-read pty :timeout 30)
                                      when (eq result :eof) return :eof)
                                (pty-write pty payload :timeout 30))
                          (pty-closed-error () :closed)))) workers)))
           (dotimes (i 6) (wait-for started))
           ;; Ensure a poll is in progress, rather than measuring only entry
           ;; after cancellation. The deterministic tests cover publication.
           (sleep 0.003)
           (let ((start (seconds)))
             (dotimes (i 3)
               (push (sb-thread:make-thread (lambda () (close-pty pty :timeout 0.01))) closers))
             (let* ((close-results (mapcar #'join closers))
                    (io-results (mapcar #'join workers))
                    (elapsed (- (seconds) start)))
               (check :stress-closers (every (lambda (result) (eq t result)) close-results))
               (check :stress-workers
                      (every (lambda (result) (or (member result '(:closed :eof))
                                                  (typep result '(integer 0 262144)))) io-results))
               (check :stress-closed (and (not (pty-open-p pty)) (= -1 (pty-master-fd pty))))
               (when process
                 (check :child-killed-reaped (and (eq :signaled (process-status process))
                                                 (= 137 (process-exit-code process))))
                 (check :child-not-waitable
                        (handler-case (progn (sb-posix:waitpid (process-pid process) sb-posix:wnohang) nil)
                          (sb-posix:syscall-error (condition)
                            (= sb-posix:echild (sb-posix:syscall-errno condition))))))
               elapsed)))
      (close-pty pty :timeout 0.01)
      (mapc #'join workers)
      (mapc #'join closers))))

(defun run-tests ()
  (let ((fds (fd-count)) (threads (length (sb-thread:list-all-threads))) (times nil))
    (cancellation-barrier-test :read)
    (cancellation-barrier-test :write)
    (dotimes (i 120) (push (stress-one (oddp i)) times))
    (setf times (sort times #'<))
    (let ((failures (count-if (lambda (seconds) (>= seconds 1)) times)))
      (format t "~S~%" (list :close-stress :iterations (length times)
                             :no-child 60 :real-child 60 :max (float (car (last times)))
                             :p95 (float (nth (1- (ceiling (* 0.95 (length times)))) times))
                             :count-over-or-equal-1s failures))
      (check :all-close-and-join-under-one-second (zerop failures)))
    (check :fd-baseline (= fds (fd-count)))
    (check :thread-baseline (= threads (length (sb-thread:list-all-threads))))
    (format t "~S~%" (list :pty-close-checks *checks* :passed t))))
