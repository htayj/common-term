;;;; Standalone conditional content-metadata verification. No product system load.
(in-package #:cl-user)
(defparameter *root* #p"/home/taylor/projects/lispterm/")
(defparameter *e* (merge-pathnames ".build/evidence/screen-area-content-metadata-repair-20261107-a/attempt03/" *root*))
(defparameter *checks* nil)
(defun check (name value)
  (unless value (error "Failed focused check: ~s" name))
  (push name *checks*) t)
(defun bytes (path)
  (with-open-file (s path :element-type '(unsigned-byte 8))
    (let ((v (make-array (file-length s) :element-type '(unsigned-byte 8))))
      (assert (= (length v) (read-sequence v s))) v)))
(defun source-text (path)
  (with-open-file (s path :external-format :utf-8)
    (with-output-to-string (out)
      (loop for ch = (read-char s nil) while ch do (write-char ch out)))))
(defun save (name value)
  (with-open-file (s (merge-pathnames name *e*) :direction :output :if-exists :error)
    (let ((*print-pretty* t) (*print-readably* t)) (write value :stream s) (terpri s))))
(defparameter *inputs*
  '(("tests/vttest-screen-oracle.lisp" "vttest-screen-oracle.lisp")
    ("tests/vttest-cursor-oracle.lisp" "vttest-cursor-oracle.lisp")
    ("tests/vttest-screen-frame.lisp" "vttest-screen-frame.lisp")
    ("tests/vttest-screen-recorder.lisp" "vttest-screen-recorder.lisp")
    ("src/renderer.lisp" "renderer.lisp") ("src/engine/adapter.lisp" "adapter.lisp")))
(dolist (pair *inputs*)
  (check (list :current-copy (first pair))
         (equalp (bytes (merge-pathnames (first pair) *root*))
                 (bytes (merge-pathnames (concatenate 'string "current/" (second pair)) *e*)))))
(check :test-current-copy
       (equalp (bytes (merge-pathnames "tests/vttest-screen-content-metadata-tests.lisp" *root*))
               (bytes (merge-pathnames "focused-tests.lisp" *e*))))
;; Only package scaffolding is admitted before syntax/scope preflight.
(with-open-file (s (merge-pathnames "current/vttest-cursor-oracle.lisp" *e*))
  (let ((*read-eval* nil))
    (assert (equal (read s) '(require :asdf)))
    (let ((form (read s))) (assert (eq (first form) 'defpackage)) (eval form))))
(defpackage #:lispterm.engine (:use #:cl)
  (:export #:rows #:logical-columns #:cell-at #:cell-blink-p #:cell-width
           #:cell-underline-p #:cell-character))
(defpackage #:lispterm (:use #:cl))
(defpackage #:vttest-screen-recorder (:use #:cl))
(defun read-forms (path allowed)
  (let ((*read-eval* nil) (*package* (find-package :cl-user)) (end (gensym)) (forms nil))
    (with-open-file (s path :external-format :utf-8)
      (loop for form = (read s nil end) until (eq form end) do
        (assert (and (consp form) (member (first form) allowed)))
        (case (first form)
          (defpackage (eval form))
          (in-package (setf *package* (find-package (second form)))))
        (push (list (package-name *package*) form) forms)))
    (nreverse forms)))
(defun definition-name (form)
  (let ((name (second form))) (if (consp name) (first name) name)))
(defparameter *oracle-allowed*
  '("PROFILE-ERROR" "NEED" "BOOLEAN-P" "CELL" "MAKE-CELL" "SNAPSHOT"
    "SNAPSHOT-PAUSE" "SNAPSHOT-ROWS" "SNAPSHOT-COLUMNS" "SNAPSHOT-CELLS"
    "SNAPSHOT-METADATA" "SNAPSHOT-CELL" "NORMAL-SNAPSHOT"
    "WIDTH-BACKGROUND-SNAPSHOT" "MIDDLE-SNAPSHOT" "SCREEN-SNAPSHOT"))
(defparameter *oracle-forms*
  (read-forms (merge-pathnames "current/vttest-screen-oracle.lisp" *e*)
              '(load defpackage in-package define-condition defstruct defun)))
(defparameter *before-forms*
  (read-forms (merge-pathnames "before/vttest-screen-oracle.lisp" *e*)
              '(load defpackage in-package define-condition defstruct defun)))
(defun expected-correction (tree)
  ;; Exactly one metadata keyword/value is allowed per affected constructor.
  (let ((count 0))
    (labels ((walk (node)
               (cond ((atom node) node)
                     ((eq (car node) :blink-visible)
                      (assert (eq (second node) t)) (incf count)
                      (cons :blink-visible (cons nil (walk (cddr node)))))
                     (t (cons (walk (car node)) (walk (cdr node)))))))
      (let ((result (walk tree))) (assert (= count 1)) result))))
(defun form-equal-p (a b)
  "Reader-fresh uninterned symbols compare by spelling, interned symbols by identity."
  (cond ((and (consp a) (consp b))
         (and (form-equal-p (car a) (car b)) (form-equal-p (cdr a) (cdr b))))
        ((and (symbolp a) (symbolp b) (null (symbol-package a)) (null (symbol-package b)))
         (string= (symbol-name a) (symbol-name b)))
        (t (equal a b))))
(check :same-top-level-count (= (length *oracle-forms*) (length *before-forms*)))
(loop for old in *before-forms* for new in *oracle-forms* do
  (let* ((form (second old))
         (affected (and (eq (first form) 'defun)
                        (member (symbol-name (second form))
                                '("WIDTH-BACKGROUND-SNAPSHOT" "MIDDLE-SNAPSHOT") :test #'string=))))
    (check (list :structural-scope (if (member (first form) '(defun defstruct define-condition))
                                     (definition-name form) (first form)))
           (form-equal-p new (if affected (list (first old) (expected-correction form)) old)))))
(let ((expected (source-text (merge-pathnames "before/vttest-screen-oracle.lisp" *e*))))
  (dolist (old '(":screen-reverse (not (null light)) :blink-visible t"
                 ":screen-reverse nil :blink-visible t"))
    (let ((at (search old expected)))
      (assert at)
      ;; Replace only the final T byte, preserving all whitespace and other bytes.
      (let ((position (+ at (1- (length old)))))
        (setf expected (concatenate 'string (subseq expected 0 position) "nil"
                                    (subseq expected (1+ position)))))))
  (check :exact-two-literal-text-patch
         (string= expected (source-text (merge-pathnames "current/vttest-screen-oracle.lisp" *e*)))))
(defparameter *selected*
  (remove-if-not (lambda (pair)
                   (let ((f (second pair)))
                     (and (member (first f) '(define-condition defstruct defun))
                          (member (symbol-name (definition-name f)) *oracle-allowed* :test #'string=))))
                 *oracle-forms*))
(check :complete-constructor-closure (= (length *selected*) (length *oracle-allowed*)))
(defun extract-definition (file name next package)
  (let* ((text (source-text (merge-pathnames (concatenate 'string "current/" file) *e*)))
         (start (search (concatenate 'string "(defun " name) text))
         (end (and start (search (concatenate 'string "(defun " next) text :start2 (1+ start)))))
    (assert (and start end))
    (let ((*package* (find-package package)) (*read-eval* nil) (eof (gensym)))
      (with-input-from-string (s (subseq text start end))
        (let ((form (read s)))
          (assert (eq (first form) 'defun))
          (assert (string-equal name (symbol-name (second form))))
          (assert (eq eof (read s nil eof))) (list package form))))))
(defparameter *renderer*
  (extract-definition "renderer.lisp" "screen-visible-blink-p" "render-session" "LISPTERM"))
(defparameter *frame-forms*
  (read-forms (merge-pathnames "current/vttest-screen-frame.lisp" *e*)
              '(defpackage in-package define-condition defun)))
(defparameter *frame-selected*
  (remove-if-not (lambda (p)
                   (let ((f (second p)))
                     (and (member (first f) '(defun define-condition))
                          (member (symbol-name (definition-name f))
                                  '("FRAME-REFUSAL" "PROPER-PLIST-P" "REQUIRED-VALUE" "SETTLED-P")
                                  :test #'string=)))) *frame-forms*))
(check :complete-settled-closure (= (length *frame-selected*) 4))
(defparameter *details*
  (extract-definition "vttest-screen-recorder.lisp" "predicate-details" "await-target" "VTTEST-SCREEN-RECORDER"))
(defparameter *completion*
  (extract-definition "vttest-screen-recorder.lisp" "completed-wayland-frame-p" "check-host" "VTTEST-SCREEN-RECORDER"))
;; Read the hold predicate without admitting AWAIT-TARGET or any host access.
;; Its external reader symbols need inert package exports, not product functions.
(export '(lispterm::status) :lispterm)
(export '(lispterm.engine::cursor-row lispterm.engine::cursor-column) :lispterm.engine)
(defparameter *await-form*
  (extract-definition "vttest-screen-recorder.lisp" "await-target" "path" "VTTEST-SCREEN-RECORDER"))
(defparameter *hold-expression*
  (labels ((find-every (tree)
             (cond ((atom tree) nil)
                   ((eq (car tree) 'every) tree)
                   (t (or (find-every (car tree)) (find-every (cdr tree)))))))
    (find-every (second *await-form*))))
(check :exact-hold-key-scope
       (equal (third *hold-expression*)
              ''(:grid-match :cursor-match :settled :output-match :input-empty
                 :blink-content-match :frame-complete :blink-phase-match)))
;; Save admission before evaluating any oracle struct/function or product helper.
(save "preflight.sexp"
      (list :syntax :pass :scope :pass :source-copy-equality t
            :selected-oracle *selected* :selected-frame *frame-selected*
            :renderer *renderer* :details *details* :completion *completion*
            :hold-expression *hold-expression* :skipped '(:loads :systems :native :rasterizers)))
(defun evaluate-in-source-package (pair)
  (let ((*package* (find-package (first pair)))) (eval (second pair))))
(mapc #'evaluate-in-source-package *selected*)
(mapc #'evaluate-in-source-package *frame-selected*)
;; Inert raw screen/cell accessors. No live terminal or display exists here.
(in-package #:lispterm.engine)
(defun rows (s) (getf s :rows))
(defun logical-columns (s row)
  (let ((n (getf s :columns)))
    (if (eq :single (aref (getf s :sizes) row)) n (max 1 (floor n 2)))))
(defun cell-at (s row col) (aref (getf s :cells) (+ (* row (getf s :columns)) col)))
(defun cell-blink-p (c) (getf c :blink))
(defun cell-width (c) (getf c :width))
(defun cell-underline-p (c) (getf c :underline))
(defun cell-character (c) (code-char (getf c :code)))
(in-package #:cl-user)
(evaluate-in-source-package *renderer*)
(in-package #:vttest-screen-recorder)
(defparameter *output* 100)
(defparameter *ack* 100)
(defparameter *backend* :x11)
(defparameter *presentation-witness* '(:commit-generation 7 :frame-generation 7))
(in-package #:cl-user)
(evaluate-in-source-package *details*)
(evaluate-in-source-package *completion*)
(defparameter *hold*
  (let ((*package* (find-package :vttest-screen-recorder)))
    (eval `(lambda (,(intern "DETAILS" *package*)) ,*hold-expression*))))
(defun raw-cell (cell)
  (list :code (vttest-screen-oracle:cell-code cell)
        :width (vttest-screen-oracle:cell-width cell)
        :bold (vttest-screen-oracle:cell-bold cell)
        :underline (vttest-screen-oracle:cell-underline cell)
        :blink (vttest-screen-oracle:cell-blink cell)
        :inverse (vttest-screen-oracle:cell-inverse cell)
        :size (vttest-screen-oracle:cell-line-size cell)))
(defun enumerate-content (screen)
  ;; Independent full physical enumeration, with a separate addressability test.
  (let ((blink 0) (qualifying 0) (underlined-spaces 0) (visited 0))
    (dotimes (row (getf screen :rows))
      (dotimes (column (getf screen :columns))
        (let* ((c (aref (getf screen :cells) (+ (* row (getf screen :columns)) column)))
               (logical (if (eq :single (aref (getf screen :sizes) row))
                            (getf screen :columns) (max 1 (floor (getf screen :columns) 2)))))
          (incf visited)
          (when (getf c :blink) (incf blink))
          (when (and (< column logical) (getf c :blink) (> (getf c :width) 0)
                     (or (/= (getf c :code) 32) (getf c :underline)))
            (incf qualifying)
            (when (= (getf c :code) 32) (incf underlined-spaces))))))
    (list :content (plusp qualifying) :blink blink :qualifying qualifying
          :underlined-spaces underlined-spaces :visited visited)))
(defparameter *table* nil)
(loop for pause from 1 to 15 do
  (let* ((columns (if (member pause '(3 5)) 132 80))
         (snapshot (vttest-screen-oracle:screen-snapshot pause :columns columns))
         (raw (map 'vector #'raw-cell (vttest-screen-oracle:snapshot-cells snapshot)))
         (sizes (make-array 24 :initial-element :single))
         (screen (list :rows 24 :columns columns :cells raw :sizes sizes))
         (counts (enumerate-content screen)) (expected (>= pause 13)))
    (check (list :all-raw-width-size pause)
           (every (lambda (c) (and (= 1 (getf c :width)) (eq :single (getf c :size)))) raw))
    (check (list :complete-enumeration pause) (= (* 24 columns) (getf counts :visited)))
    (check (list :expected-vector pause) (eq expected (getf counts :content)))
    (check (list :metadata pause)
           (eq expected (getf (vttest-screen-oracle:snapshot-metadata snapshot) :blink-visible)))
    (check (list :renderer-helper pause) (eq expected (lispterm::screen-visible-blink-p screen)))
    (check (list :substantive-counts pause)
           (equal (list (getf counts :blink) (getf counts :qualifying) (getf counts :underlined-spaces))
                  (cond ((< pause 13) '(0 0 0)) ((< pause 15) '(136 132 8)) (t '(40 40 0)))))
    (push (list :pause pause :columns columns :counts counts) *table*)))
;; New focused controls, not a rerun of the historical renderer test suite.
(dolist (case '((:hidden-column 4 :double-width 3 88 1 nil nil)
                (:width-zero 4 :single 0 88 0 nil nil)
                (:plain-space 4 :single 0 32 1 nil nil)
                (:underlined-space 4 :single 0 32 1 t t)))
  (destructuring-bind (name columns size column code width underline expected) case
    (let* ((cells (make-array columns :initial-element '(:code 32 :width 1 :blink nil)))
           (screen (list :rows 1 :columns columns :sizes (vector size) :cells cells)))
      (setf (aref cells column) (list :code code :width width :blink t :underline underline))
      (check (list name :independent) (eq expected (getf (enumerate-content screen) :content)))
      (check (list name :real-helper) (eq expected (lispterm::screen-visible-blink-p screen))))))
(defparameter *status*
  '(:rows 24 :columns 80 :pty-rows 24 :pty-columns 80 :bytes-received 100
    :input-pending 0 :blink-visible t :blink-phase t
    :geometry (:phase :settled :request-id 1 :display-epoch 1 :epoch 1
               :actual-width 640 :actual-height 384 :cell-width 8 :cell-height 16
               :presentation 1 :target-presentation 1 :rows 24 :columns 80
               :commit-generation 7 :frame-generation 7 :frame-pending-p nil)))
(defun hold-details (status)
  (vttest-screen-recorder::predicate-details "same" "same"
    '(:row 23 :column 32) '(:row 23 :column 32) t status 14 :capture-hold))
(dolist (backend '(:x11 :wayland))
  (let ((vttest-screen-recorder::*backend* backend))
    (check (list :pause14 backend :positive-control) (funcall *hold* (hold-details (copy-tree *status*))))
    (dolist (key '(:blink-visible :blink-phase))
      (let ((status (copy-tree *status*)))
        (setf (getf status key) nil)
        (check (list :pause14 backend :refuse key) (not (funcall *hold* (hold-details status))))))))
(let ((vttest-screen-recorder::*backend* :wayland)
      (vttest-screen-recorder::*presentation-witness* nil))
  (check :wayland-ack-alone-refused (not (funcall *hold* (hold-details *status*)))))
(let ((vttest-screen-recorder::*backend* :wayland) (status (copy-tree *status*)))
  (setf (getf (getf status :geometry) :frame-pending-p) t)
  (check :wayland-pending-frame-refused (not (funcall *hold* (hold-details status)))))
;; Final byte custody binds current, copied and evaluated input bytes.
(dolist (pair *inputs*)
  (check (list :final-current-copy (first pair))
         (equalp (bytes (merge-pathnames (first pair) *root*))
                 (bytes (merge-pathnames (concatenate 'string "current/" (second pair)) *e*)))))
(check :final-test-copy
       (equalp (bytes (merge-pathnames "tests/vttest-screen-content-metadata-tests.lisp" *root*))
               (bytes (merge-pathnames "focused-tests.lisp" *e*))))
(save "checks.sexp" (list :pass t :check-count (length *checks*) :checks (reverse *checks*)
                          :snapshots (reverse *table*) :acceptance :conditional-pure-only :images nil))
(format t "PASS ~d focused checks; fifteen fresh snapshots; no native/runtime acceptance.~%" (length *checks*))
