;;;; Finite controls only. Never calls the live driver or emits observations.
(defpackage :vttest-cursor-driver-tests (:use :cl) (:export :run :manifest))
(in-package :vttest-cursor-driver-tests)
(defun manifest (&optional (backend "x11"))
  (let ((oracle (vttest-cursor-driver::digest "tests/vttest-cursor-oracle.lisp")))
      (list :kind :vttest-area-manifest :version 1 :area "cursor-movements" :backend backend
            :scope-status :frozen :native-driver (vttest-cursor-driver::backend-spec backend)
            :conditions (vttest-cursor-driver::conditions-for backend)
          :required-count 6
            :pins (append (list :binary vttest-cursor-driver::+binary+ :font vttest-cursor-driver::+font+
                                :upstream-archive vttest-cursor-driver::+archive+ :oracle oracle
                                :driver (vttest-cursor-driver::digest "tests/vttest-cursor-driver.lisp"))
                          (when (equal backend "wayland") (list :modules (vttest-cursor-driver::module-pins backend))))
          :scenarios (list (list :id "cursor" :recorder-label "cursor" :menu-path '(1) :pauses 6
                           :captures (loop for p from 1 to 6 collect (list :id (format nil "pause-~d" p) :pause p))
                           :bytes nil :timing nil :oracle (list :path "tests/vttest-cursor-oracle.lisp" :sha256 oracle)
                             :requires (list (list :capability (nth-value 2 (vttest-cursor-driver::backend-spec backend))
                                                   :path "tests/vttest-cursor-driver.lisp")))))))
(defun check (x label) (vttest-area-tests::check x label))
(defun reject (thunk label) (check (vttest-area-tests::problem-p thunk) label))
(defun geometry-fixture (pause)
  (let* ((cols (if (member pause '(2 4)) 132 80)) (w (* cols 8))
         (png (make-array 24 :element-type '(unsigned-byte 8) :initial-element 0))
         (e (list :recorder-version 3 :logical-width w :pixel-width w :logical-height 384 :pixel-height 384
                  :scale 1 :output-width 1280 :output-height 800 :output-x 0 :output-y 0 :x 0 :y 0))
         (g (list :request-id 2 :phase :settled :backend :x11 :requested-columns cols :requested-rows 24
                  :rows 24 :columns cols :cell-width 8 :cell-height 16 :actual-width w :requested-width w :width w
                  :actual-height 384 :requested-height 384 :height 384 :window-id 77 :presentation 2 :target-presentation 2))
         (s (list :backend :x11 :state :attached :worker-alive-p t :error-count 0 :child-pid 99 :transport-state :open
                  :process-state :running :rows 24 :pty-rows 24 :columns cols :pty-columns cols
                  :engine-geometry-generation 2 :frames 6 :bytes-received 100 :geometry g))
         (b (list :recorder-version 3 :desired-scale 1 :status (copy-tree s) :before-frame 5 :target-output 100 :native-ack-output -1)))
    (replace png #(137 80 78 71 13 10 26 10 0 0 0 13 73 72 68 82))
    (setf (aref png 18) (ldb (byte 8 8) w) (aref png 19) (ldb (byte 8 0) w)
          (aref png 22) 1 (aref png 23) 128)
    (list pause png e s b (copy-tree s) (format nil "WINDOW=77~%X=0~%Y=0~%WIDTH=~d~%HEIGHT=384~%" w)
          (format nil "expected=~dx384 actual=~dx384 window=77 fixture-scale=1" w w) (format nil "~d 384" w) 99)))
(defun bad-geometry (label mutate)
  (let ((f (geometry-fixture 1))) (funcall mutate f)
    (reject (lambda () (apply #'vttest-cursor-driver::check-geometry f)) label)))
(defun wayland-status-fixture (pause)
  ;; Synthetic recorder data only. No compositor, project backend or PNG output.
  (let* ((status (copy-tree (fourth (geometry-fixture pause))))
         (g (getf status :geometry)) (w (getf g :actual-width)))
    (setf (getf status :backend) :wayland (getf status :input-pending) 0
          (getf g :backend) :wayland (getf g :epoch) 7 (getf g :display-epoch) 7
          (getf g :metric-generation) 1 (getf g :configured-p) t
          (getf g :frame-pending-p) nil (getf g :buffer-scale) 1
          (getf g :committed-width) w (getf g :committed-height) 384
          (getf g :committed-buffer-width) w (getf g :committed-buffer-height) 384
          (getf g :buffer-width) w (getf g :buffer-height) 384
          (getf g :commit-generation) 4 (getf g :frame-generation) 4
          (getf g :committed-request-id) 2 (getf g :frame-request-id) 2
          (getf g :committed-epoch) 7 (getf g :frame-epoch) 7)
    (setf (getf status :geometry) g)
    (let ((before (copy-tree status)))
      (setf (getf before :frames) 5
            (getf (getf before :geometry) :commit-generation) 3
            (getf (getf before :geometry) :frame-generation) 3)
      (list pause status
            (list :recorder-version 3 :desired-scale 1 :target-output 100
                  :before-frame 5 :before-status before :status (copy-tree status) :native-ack-output 100)
            (copy-tree status) 99))))
(defun sync-wayland-status (fixture)
  (setf (getf (third fixture) :status) (copy-tree (second fixture))
        (fourth fixture) (copy-tree (second fixture))))
(defun wayland-status-controls ()
  (loop for pause from 1 to 6 do
    (check (apply #'vttest-cursor-driver::check-wayland-status (wayland-status-fixture pause))
           (list :wayland-native-status pause)))
  (flet ((bad (label mutate)
           (let ((f (wayland-status-fixture 1)))
             (funcall mutate f)
             (reject (lambda () (apply #'vttest-cursor-driver::check-wayland-status f)) label))))
    (dolist (entry '((:backend :x11) (:child-pid 100) (:state :detached)
                     (:process-state :exited) (:transport-state :hangup)
                     (:worker-alive-p nil) (:error-count 1) (:input-pending 1)
                     (:pty-columns 132) (:bytes-received 99) (:frames 5)))
      (bad (list :wayland-status (first entry))
           (lambda (f) (setf (getf (second f) (first entry)) (second entry))
             (sync-wayland-status f))))
    (dolist (entry '((:backend :x11) (:configured-p nil) (:frame-pending-p t) (:buffer-scale 2)
                     (:committed-width 639) (:committed-height 383)
                     (:committed-buffer-width 639) (:committed-buffer-height 383)
                     (:buffer-width 639) (:buffer-height 383)
                     (:commit-generation 3) (:frame-generation 3)
                     (:committed-request-id 1) (:frame-request-id 1)
                     (:committed-epoch 6) (:frame-epoch 6) (:epoch 6)
                     (:display-epoch 6) (:metric-generation 2) (:request-id 1)
                     (:cell-width 9) (:target-presentation 0)))
      (bad (list :wayland-geometry (first entry))
           (lambda (f) (setf (getf (getf (second f) :geometry) (first entry)) (second entry))
             (sync-wayland-status f))))
    (dolist (entry '((:native-ack-output -1) (:native-ack-output 99) (:native-ack-output nil)
                     (:before-frame 4) (:before-status nil) (:desired-scale 2) (:recorder-version 2)))
      (bad (list :wayland-barrier (first entry) (second entry))
           (lambda (f) (setf (getf (third f) (first entry)) (second entry)))))
    (bad :wayland-incomplete-status (lambda (f) (setf (second f) nil)))
    (bad :wayland-incomplete-final (lambda (f) (setf (fourth f) nil)))
    (bad :wayland-final-frame-regressed (lambda (f) (setf (getf (fourth f) :frames) 5)))
    (bad :wayland-conflicting-metric
         (lambda (f) (setf (getf (second f) :geometry)
                          (append (getf (second f) :geometry) '(:buffer-scale 2)))
           (sync-wayland-status f))))
  ;; Ordinary post-settlement frames have matching NIL request/epoch tokens.
  (let ((f (wayland-status-fixture 1)))
    (dolist (s (list (second f) (getf (third f) :before-status)))
      (dolist (key '(:committed-request-id :frame-request-id :committed-epoch :frame-epoch))
        (setf (getf (getf s :geometry) key) nil)))
    (sync-wayland-status f)
    (check (apply #'vttest-cursor-driver::check-wayland-status f) :wayland-ordinary-frame)))
(defun wayland-outputs-fixture ()
  "[{\"name\":\"HEADLESS-1\",\"active\":true,\"scale\":1.0,\"rect\":{\"x\":0,\"y\":0,\"width\":1280,\"height\":800},\"current_mode\":{\"width\":1280,\"height\":800}}]")
(defun wayland-proof-fixture (pause)
  (let* ((native (wayland-status-fixture pause)) (base (geometry-fixture pause))
         (w (getf (getf (second native) :geometry) :actual-width))
         (rect (format nil "{\"x\":0,\"y\":0,\"width\":~d,\"height\":384}" w))
         (raw (format nil "{\"id\":77,\"pid\":98,\"name\":\"cursor-owned-test\",\"rect\":~a,\"window_rect\":~a,\"geometry\":~a}" rect rect rect))
         (node (concatenate 'string (subseq raw 0 (1- (length raw))) ",\"type\":\"floating_con\",\"nodes\":[],\"floating_nodes\":[]}"))
         (tree (format nil "{\"id\":1,\"nodes\":[],\"floating_nodes\":[~a]}" node))
         (sockets (format nil "1001 /tmp/lispterm-wayland.test/wayland-1~%1002 /tmp/lispterm-wayland.test/sway-ipc.1000.55.sock~%fixture-scale=1~%"))
         (proc (format nil "pid=99~%99 (bash) ~{~a~^ ~}~%/dev/pts/1~%/dev/pts/1~%/dev/pts/1~%24 80~%"
                       (append '("S" 98 99 99 34851 99) (make-list 13 :initial-element 0) '(123))))
         (audit (format nil "1001 /tmp/lispterm-wayland.test/wayland-1~%1002 /tmp/lispterm-wayland.test/sway-ipc.1000.55.sock~%backend=wayland scale=1 server=55 start=888 runtime=/tmp/lispterm-wayland.test~%client=99 start=123 endpoints=private~%client=98 start=122 endpoints=private~%")))
    (list (list pause (second base) (third base) (second native) (third native) (fourth native)
                tree raw (wayland-outputs-fixture) (eighth base) (ninth base) 99 98 "cursor-owned-test")
          (list 99 proc (format nil "DISPLAY=unset~%WAYLAND_DISPLAY=wayland-1~%") audit
                (format nil "client-wait pid=98 start=122 status=0~%") "55" "888" "/tmp/lispterm-wayland.test"
                sockets (wayland-outputs-fixture)))))
(defun proof-replace (s old new)
  (let ((p (search old s)))
    (assert p)
    (concatenate 'string (subseq s 0 p) new (subseq s (+ p (length old))))))
(defun wayland-proof-controls ()
  (loop for pause from 1 to 6 do
    (check (apply #'vttest-cursor-driver::check-wayland-proof (wayland-proof-fixture pause))
           (list :wayland-composed-proof pause)))
  (flet ((bad (label mutate)
           (let ((fixture (wayland-proof-fixture 1)))
             (funcall mutate (first fixture) (second fixture))
             (reject (lambda () (apply #'vttest-cursor-driver::check-wayland-proof fixture)) label))))
    (dolist (entry '((6 "\"pid\":98" "\"pid\":97")
                     (6 "cursor-owned-test" "foreign-title")
                     (6 "floating_con" "con")
                     (6 "\"id\":77" "\"id\":1")
                     (7 "\"id\":77" "\"id\":78")
                     (7 "\"pid\":98" "\"pid\":97")
                     (7 "cursor-owned-test" "foreign-title")
                     (7 "\"width\":640" "\"width\":639")
                     (6 "\"width\":640" "\"width\":639")
                     (8 "\"scale\":1.0" "\"scale\":2")
                     (8 "HEADLESS-1" "HEADLESS-2")
                     (8 "\"active\":true" "\"active\":false")
                     (8 "\"width\":1280" "\"width\":1279")
                     (7 "\"id\":77" "\"id\":77,\"id\":77")
                     (6 "\"id\":1" "\"id\":1,\"id\":2")))
      (bad (list :wayland-raw-mutation entry)
           (lambda (g s) (declare (ignore s))
             (setf (nth (first entry) g) (proof-replace (nth (first entry) g) (second entry) (third entry))))))
    (bad :wayland-duplicate-owned-node
         (lambda (g s) (declare (ignore s))
           (let* ((tree (nth 6 g)) (start (search "[{\"id\":77" tree))
                  (node (subseq tree (1+ start) (- (length tree) 2))))
             (setf (nth 6 g) (concatenate 'string (subseq tree 0 (- (length tree) 2)) "," node "]}")))))
    (bad :wayland-ambiguous-title-wrong-pid
         (lambda (g s) (declare (ignore s))
           (let* ((tree (nth 6 g)) (start (search "[{\"id\":77" tree))
                  (node (subseq tree (1+ start) (- (length tree) 2))))
             (setf node (proof-replace (proof-replace node "\"id\":77" "\"id\":78") "\"pid\":98" "\"pid\":97")
                   (nth 6 g) (concatenate 'string (subseq tree 0 (- (length tree) 2)) "," node "]}")))))
    (dolist (i '(6 7 8 9 10))
      (bad (list :wayland-missing-raw i) (lambda (g s) (declare (ignore s)) (setf (nth i g) ""))))
    (dolist (entry '((:x 1) (:scale 2) (:output-width 1279) (:logical-width 639) (:pixel-height 383)))
      (bad (list :wayland-external-mutation entry)
           (lambda (g s) (declare (ignore s)) (setf (getf (third g) (first entry)) (second entry)))))
    (bad :wayland-conflicting-external
         (lambda (g s) (declare (ignore s)) (setf (third g) (append (third g) '(:scale 2)))))
    (bad :wayland-png-mismatch (lambda (g s) (declare (ignore s)) (setf (aref (second g) 19) 0)))
    (bad :wayland-protocol-backend
         (lambda (g s) (declare (ignore s)) (setf (getf (fourth g) :backend) :x11)))
    (bad :wayland-no-native-ack
         (lambda (g s) (declare (ignore s)) (setf (getf (fifth g) :native-ack-output) -1)))
    (bad :wayland-protocol-grid
         (lambda (g s) (declare (ignore s)) (setf (getf (fourth g) :columns) 132)))
    (bad :wayland-proof-parent
         (lambda (g s) (declare (ignore s)) (setf (nth 12 g) 97)))
    (bad :wayland-hidden-duplicate-node
         (lambda (g s) (declare (ignore s))
           (setf (nth 6 g)
                 (concatenate 'string (subseq (nth 6 g) 0 (1- (length (nth 6 g))))
                              ",\"extra\":{\"id\":78,\"pid\":98,\"name\":\"cursor-owned-test\",\"type\":\"floating_con\"}}"))))
    (bad :wayland-malformed-tree-children
         (lambda (g s) (declare (ignore s))
           (setf (nth 6 g) (proof-replace (nth 6 g) "\"nodes\":[]" "\"nodes\":[1]"))))
    (bad :wayland-incomplete-tree
         (lambda (g s) (declare (ignore s)) (setf (nth 6 g) "{}")))
    (bad :wayland-composed-owner-mismatch
         (lambda (g s) (declare (ignore s))
           (setf (nth 12 g) 97)
           (dolist (i '(6 7))
             (setf (nth i g) (proof-replace (nth i g) "\"pid\":98" "\"pid\":97")))))
    (bad :wayland-multiple-outputs
         (lambda (g s) (declare (ignore s))
           (let ((o (nth 8 g)))
             (setf (nth 8 g) (concatenate 'string (subseq o 0 (1- (length o))) "," (subseq o 1))))))
    (bad :wayland-shared-socket-inode
         (lambda (g s) (declare (ignore g))
           (setf (nth 8 s) (proof-replace (nth 8 s) "1002 " "1001 "))))
    (dolist (i '(1 2 4 5 6 7))
      (bad (list :wayland-incomplete-session i)
           (lambda (g s) (declare (ignore g)) (setf (nth i s) ""))))
    (dolist (entry '((5 "56") (6 "889") (7 "/tmp/lispterm-wayland.other")
                     (7 "/tmp/lispterm-wayland.test/../other")
                     (4 "client-wait pid=98 start=121 status=0")
                     (4 "client-wait pid=97 start=122 status=0")
                     (4 "client-wait pid=98 start=122 status=1")
                     (2 "DISPLAY=:7") (3 "") (8 "") (9 "[]")))
      (bad (list :wayland-session-mutation entry)
           (lambda (g s) (declare (ignore g)) (setf (nth (first entry) s) (second entry)))))
    (dolist (entry '((8 "1000.55.sock" "1000.56.sock")
                     (8 "wayland-1" "wayland-2")
                     (8 "fixture-scale=1" "fixture-scale=2")
                     (3 "start=123" "start=124")
                     (3 "start=122" "start=121")
                     (3 "backend=wayland" "backend=x11")
                     (3 "endpoints=private" "endpoints=shared")
                     (1 "99 (bash)" "100 (bash)")))
      (bad (list :wayland-session-raw entry)
           (lambda (g s) (declare (ignore g))
             (setf (nth (first entry) s) (proof-replace (nth (first entry) s) (second entry) (third entry))))))
    (bad :wayland-conflicting-session
         (lambda (g s) (declare (ignore g))
           (setf (fourth s) (concatenate 'string (fourth s) (format nil "client=99 start=999 endpoints=private~%")))))
    (bad :wayland-conflicting-server
         (lambda (g s) (declare (ignore g))
           (setf (fourth s) (concatenate 'string (fourth s) (format nil "backend=wayland scale=1 server=55 start=889 runtime=/tmp/lispterm-wayland.test~%"))))))
  (dolist (raw '("{\"x\":1,\"x\":2}" "{\"x\":1,\"\\u0078\":1}" "[1,]" "{\"x\":1,}"
                 "01" "1." "1e" "1e101" "true false" "{\"x\":NaN}" "{\"x\":\"\\q\"}"
                 "\"\\ud800\"" "[" "{\"x\":null,\"x\":null}"))
    (reject (lambda () (vttest-cursor-driver::strict-json raw)) (list :strict-json raw)))
  (let ((raw (vttest-cursor-driver::strict-json "{\"x\":1.0,\"y\":1e0,\"z\":\"\\u0061\"}")))
    (check (and (eql 1 (gethash "x" raw)) (eql 1 (gethash "y" raw)) (equal "a" (gethash "z" raw))) :strict-json-exact)))
(defun dispatch-proof (fixture)
  (let ((g (first fixture)))
    (apply #'vttest-cursor-driver::check-geometry
           (append (subseq g 0 6) (list (nth 7 g) (nth 9 g) (nth 10 g) (nth 11 g)
                   :backend "wayland" :tree (nth 6 g) :outputs (nth 8 g) :client (nth 12 g)
                   :title (nth 13 g) :session-arguments (second fixture))))))
(defun backend-controls ()
  (let ((m (manifest "wayland")))
    (check (vttest-area:validate-manifest m "cursor-movements" "wayland") :wayland-schema)
    (check (vttest-cursor-driver:validate m) :wayland-admission))
  (dolist (entry '((:native-driver "cursor-x11-v1") (:backend "other") (:conditions ("private-x11"))))
    (let ((m (manifest "wayland"))) (setf (getf m (first entry)) (second entry))
      (reject (lambda () (vttest-cursor-driver:validate m)) :backend-mismatch)))
  (let ((m (manifest "wayland")))
    (setf (getf (first (getf m :scenarios)) :requires) '((:capability "cursor-x11-runtime" :path "tests/vttest-cursor-driver.lisp")))
    (reject (lambda () (vttest-cursor-driver:validate m)) :wayland-capability-mismatch))
  (dolist (mutation '(:missing :changed :reordered))
    (let* ((m (manifest "wayland")))
      (setf (getf (getf m :pins) :modules)
            (ecase mutation (:missing nil) (:changed '((:path "tests/wayland-gate.sh" :sha256 "bad")))
                   (:reordered (reverse (getf (getf m :pins) :modules)))))
      (reject (lambda () (vttest-cursor-driver:validate m)) :wayland-module-pin)))
  (dolist (name '("wayland-gate.sh" "vttest-protocol.lisp" "vttest-cursor-oracle.lisp"))
    (check (member name (vttest-cursor-driver::dependency-names "wayland") :test #'equal) :wayland-dependency))
  (check (equal '(".tree.json" ".geometry.json") (last (vttest-cursor-driver::raw-suffixes "wayland") 2)) :wayland-raw-files)
  (check (not (member ".geometry.txt" (vttest-cursor-driver::raw-suffixes "wayland") :test #'equal)) :wayland-no-x11-geometry)
  (check (equal "vttest-wayland-scale1-v3." (vttest-cursor-driver::receipt-prefix "wayland")) :wayland-receipt-prefix)
  (check (eq :cursor-wayland-launch (nth-value 1 (vttest-cursor-driver::backend-spec "wayland"))) :wayland-request-kind)
  (let ((args (vttest-cursor-driver::launch-arguments vttest-area-tests::*root* "/test/font.otb" "wayland")))
    (check (equal '("/run/current-system/sw/bin/bash" "tests/vttest-gate.sh" "wayland") (last args 3)) :wayland-pinned-bash)
    (dolist (prefix '("LISPTERM_SBCL=" "VTTEST=" "LISPTERM_WAYLAND_ARTIFACTS=" "HOME=" "TMPDIR="))
      (let ((arg (find-if (lambda (s) (uiop:string-prefix-p prefix s)) args)))
        (check (and arg (char= #\/ (char arg (length prefix)))) :wayland-absolute-mapping)))
    (check (equal (format nil "LISPTERM_WAYLAND_ARTIFACTS=~awayland-artifacts" (namestring (truename vttest-area-tests::*root*)))
                  (find-if (lambda (s) (uiop:string-prefix-p "LISPTERM_WAYLAND_ARTIFACTS=" s)) args)) :owned-wayland-output)
    (check (notany (lambda (s) (some (lambda (p) (uiop:string-prefix-p p s)) '("DISPLAY=" "WAYLAND_DISPLAY=" "DBUS_" "SWAYSOCK="))) args) :wayland-no-inherited-endpoints))
  (loop for p from 1 to 6 do (check (dispatch-proof (wayland-proof-fixture p)) :wayland-live-proof-dispatch))
  (let ((f (wayland-proof-fixture 1)))
    (setf (getf (fifth (first f)) :native-ack-output) -1)
    (reject (lambda () (dispatch-proof f)) :dispatch-rejects-x11-ack))
  (let ((f (wayland-proof-fixture 1)))
    (setf (sixth (second f)) "56")
    (reject (lambda () (dispatch-proof f)) :dispatch-requires-private-session))
  ;; Bind real producer filenames to the exact composed session arguments.
  (let* ((f (wayland-proof-fixture 1)) (a (concatenate 'string (namestring (truename vttest-area-tests::*root*)) "wayland-session/")))
    (sb-posix:mkdir (subseq a 0 (1- (length a))) #o700)
    (sb-posix:mkdir (concatenate 'string a "compositor") #o700)
    (loop for name in '("cursor.process.txt" "transport.txt" "isolation.txt" "client-wait.log" "compositor/compositor.pid"
                       "compositor/compositor.start" "compositor/runtime-path" "compositor/isolation.txt" "isolation-outputs.json")
          for value in (rest (second f)) do
          (with-open-file (s (concatenate 'string a name) :direction :output :if-exists :error) (write-string value s)))
    (check (equal (second f) (vttest-cursor-driver::wayland-session-arguments a 99)) :actual-session-file-mapping)
    (check (apply #'vttest-cursor-driver::private-wayland-session (vttest-cursor-driver::wayland-session-arguments a 99)) :loaded-private-session))
  (let* ((root (concatenate 'string (namestring (truename vttest-area-tests::*root*))
                            (vttest-cursor-driver::receipt-prefix "wayland")))
         (art (concatenate 'string root "finite")) (a (concatenate 'string art "/"))
         (request '(:kind :cursor-wayland-launch :backend "wayland" :nonce "owned-finite-control")))
    (sb-posix:mkdir art #o700)
    (vttest-cursor-driver::put (concatenate 'string a "area-request.sexp") request)
    (dolist (entry '(("source.sha256" "source") ("run-head.txt" "head")))
      (with-open-file (s (concatenate 'string a (first entry)) :direction :output :if-exists :error)
        (write-string (second entry) s)))
    (check (equal a (vttest-cursor-driver::validate-receipt art root request "source" "head" "wayland")) :wayland-receipt)
    (dolist (backend '("x11" "other"))
      (reject (lambda () (vttest-cursor-driver::validate-receipt art root request "source" "head" backend)) :receipt-backend-mismatch))
    (let ((r (copy-list request)))
      (setf (getf r :kind) :cursor-x11-launch)
      (reject (lambda () (vttest-cursor-driver::validate-receipt art root r "source" "head" "wayland")) :receipt-request-kind))
    (let ((r (copy-list request)))
      (setf (getf r :nonce) "stale")
      (reject (lambda () (vttest-cursor-driver::validate-receipt art root r "source" "head" "wayland")) :wayland-stale-receipt))
    (reject (lambda () (vttest-cursor-driver::validate-receipt art root request "changed" "head" "wayland")) :wayland-changed-source))
  (check (equal "Lispterm-vttest-test-123" (vttest-cursor-driver::capture-title (format nil "backend=wayland~%title=Lispterm-vttest-test-123~%"))) :actual-launch-title)
  (dolist (text '("" "title=other" "title=Lispterm-vttest-test-123
title=Lispterm-vttest-test-123"))
    (reject (lambda () (vttest-cursor-driver::capture-title text)) :invalid-launch-title)))
(defun binary-provenance-controls ()
  (let* ((alias (namestring (merge-pathnames ".build/test-tools/bin/vttest" (truename "./"))))
         (font (namestring (truename ".build/deps/share/fonts/terminus/ter-u16n.otb")))
         (args (vttest-cursor-driver::launch-arguments vttest-area-tests::*root* font "wayland"))
         (binary (vttest-cursor-driver::launch-binary args)))
    (check (not (equal alias binary)) :vttest-alias-has-distinct-canonical-target)
    (check (equal binary (namestring (truename alias))) :launch-resolves-vttest-alias)
    (check (member (concatenate 'string "VTTEST=" binary) args :test #'equal) :exact-launched-binary)
    (flet ((record (hash path)
             (format nil "~a  ~a~%~a  ~a~%" hash path vttest-cursor-driver::+font+ font)))
      (let ((valid (record vttest-cursor-driver::+binary+ binary)))
        (check (vttest-cursor-driver::check-binary-provenance valid binary font) :canonical-binary-provenance)
        (dolist (bad (list (record vttest-cursor-driver::+binary+ alias)
                          (record vttest-cursor-driver::+binary+ (concatenate 'string binary "-other"))
                          (record vttest-cursor-driver::+binary+ (concatenate 'string "/stale" binary))
                          (record (make-string 64 :initial-element #\0) binary)
                          (concatenate 'string valid valid)
                          (concatenate 'string valid (record vttest-cursor-driver::+binary+ alias))
                          (concatenate 'string "prefix" valid)
                          (subseq valid 0 (1- (length valid)))))
          (reject (lambda () (vttest-cursor-driver::check-binary-provenance bad binary font))
                  :wrong-or-ambiguous-binary-provenance))))
    (dolist (bad (list (remove-if (lambda (s) (uiop:string-prefix-p "VTTEST=" s)) args)
                      (cons (concatenate 'string "VTTEST=" binary) args)
                      (list (concatenate 'string "VTTEST=" alias))
                      '("VTTEST=.build/test-tools/bin/vttest")))
      (reject (lambda () (vttest-cursor-driver::launch-binary bad)) :ambiguous-or-noncanonical-launch))))
(defun run ()
  (let ((before vttest-area-tests::*checks*))
    (binary-provenance-controls)
    (wayland-status-controls)
      (wayland-proof-controls)
    (backend-controls)
    (let ((m (manifest)))
      (check (vttest-area:validate-manifest m "cursor-movements" "x11") :cursor-manifest-schema)
      (check (vttest-cursor-driver:validate m) :cursor-driver-scope))
    (dolist (entry '((:backend "wayland") (:area "screen-features") (:native-driver "other") (:required-count 5)
                     (:conditions ("private-x11"))))
      (let ((m (manifest))) (setf (getf m (first entry)) (second entry))
        (reject (lambda () (vttest-cursor-driver:validate m)) :unsupported-cursor-scope)))
    (dolist (key '(:binary :font :upstream-archive :oracle :driver))
      (let ((m (manifest))) (setf (getf (getf m :pins) key) (make-string 64 :initial-element #\0))
        (reject (lambda () (vttest-cursor-driver:validate m)) :tampered-cursor-pin)))
    (dolist (key '(:bytes :timing))
      (let ((m (manifest))) (setf (getf (first (getf m :scenarios)) key) t)
        (reject (lambda () (vttest-cursor-driver:validate m)) :unsupported-byte-or-timing-scope)))
    (let ((m (manifest))) (push (copy-tree (first (getf m :scenarios))) (getf m :scenarios))
      (reject (lambda () (vttest-cursor-driver:validate m)) :duplicate-scenario))
    (let ((m (manifest))) (setf (getf (first (getf m :scenarios)) :captures) (butlast (getf (first (getf m :scenarios)) :captures)))
      (reject (lambda () (vttest-cursor-driver:validate m)) :partial-scope))
    (loop for pause from 1 to 6 do
      (check (apply #'vttest-cursor-driver::check-geometry (geometry-fixture pause)) (list :finite-geometry pause)))
    (bad-geometry :png-size (lambda (f) (setf (aref (second f) 19) 0)))
    (bad-geometry :scale (lambda (f) (setf (getf (third f) :scale) 2)))
    (bad-geometry :outside-private-output (lambda (f) (setf (getf (third f) :x) 1000)))
    (bad-geometry :status-not-final (lambda (f) (setf (getf (sixth f) :frames) 7)))
    (bad-geometry :frame-not-advanced (lambda (f) (setf (getf (fifth f) :before-frame) 6)))
    (bad-geometry :output-not-consumed (lambda (f) (setf (getf (fifth f) :target-output) 101)))
    (bad-geometry :no-fabricated-ack (lambda (f) (setf (getf (fifth f) :native-ack-output) 100)))
    (bad-geometry :wrong-child (lambda (f) (setf (tenth f) 100)))
    (bad-geometry :wrong-window (lambda (f) (setf (seventh f) "WINDOW=78")))
    (bad-geometry :raw-dimensions (lambda (f) (setf (eighth f) "wrong")))
    (dolist (change '((:pty-columns 132) (:worker-alive-p nil) (:error-count 1) (:engine-geometry-generation 1)))
      (bad-geometry :unready-raw-status
        (lambda (f) (setf (getf (fourth f) (first change)) (second change)
                         (sixth f) (copy-tree (fourth f)) (getf (fifth f) :status) (copy-tree (fourth f))))))
    (dolist (change '((:phase :waiting) (:presentation 1) (:target-presentation 0) (:cell-width 9) (:rows 23)))
      (bad-geometry :unsettled-raw-geometry
        (lambda (f) (setf (getf (getf (fourth f) :geometry) (first change)) (second change)
                         (sixth f) (copy-tree (fourth f)) (getf (fifth f) :status) (copy-tree (fourth f))))))
    (bad-geometry :conflicting-raw-duplicate
      (lambda (f) (setf (getf (fourth f) :geometry) (append (getf (fourth f) :geometry) '(:cell-width 9))
                       (sixth f) (copy-tree (fourth f)) (getf (fifth f) :status) (copy-tree (fourth f)))))
    (let ((args (vttest-cursor-driver::launch-arguments vttest-area-tests::*root* "/test/font.otb")))
      (check (equal "-i" (first args)) :empty-native-environment)
      (dolist (s '("LISPTERM_VTTEST_EXACT_LABELS=cursor" "LISPTERM_VTTEST_MODE=record" "LISPTERM_VTTEST_SCALE=1" "LISPTERM_VTTEST_TIMEOUT=120"))
        (check (member s args :test #'equal) :native-fixed-parameter))
      (check (equal '("tests/vttest-gate.sh" "x11") (last args 2)) :native-entrypoint)
      (dolist (prefix '("HOME=" "XDG_CACHE_HOME=" "XDG_CONFIG_HOME=" "XDG_DATA_HOME=" "TMPDIR="))
        (let ((s (find-if (lambda (s) (uiop:string-prefix-p prefix s)) args)))
          (check (and s (char= #\/ (char s (length prefix)))) :absolute-isolated-path)))
      (check (notany (lambda (s) (or (uiop:string-prefix-p "DISPLAY=" s) (uiop:string-prefix-p "DBUS_" s)
                                    (uiop:string-prefix-p "WAYLAND_DISPLAY=" s))) args) :no-inherited-endpoints))
    (let* ((d (concatenate 'string (namestring (truename vttest-area-tests::*root*)) "receipt/"))
           (request '(:kind :cursor-x11-launch :nonce "finite-control-only")))
      (sb-posix:mkdir (subseq d 0 (1- (length d))) #o700)
      (vttest-cursor-driver::put (concatenate 'string d "area-request.sexp") request)
      (with-open-file (s (concatenate 'string d "source.sha256") :direction :output :if-exists :error) (write-string "fixture-source" s))
      (with-open-file (s (concatenate 'string d "run-head.txt") :direction :output :if-exists :error) (write-string "fixture-head" s))
      (let ((art (subseq d 0 (1- (length d)))) (root (namestring (truename vttest-area-tests::*root*))))
        (check (equal d (vttest-cursor-driver::validate-receipt art root request "fixture-source" "fixture-head")) :finite-receipt)
        (reject (lambda () (vttest-cursor-driver::validate-receipt art root '(:nonce "old") "fixture-source" "fixture-head")) :stale-receipt)
        (reject (lambda () (vttest-cursor-driver::validate-receipt art root request "tampered" "fixture-head")) :changed-source)
        (reject (lambda () (vttest-cursor-driver::validate-receipt art root request "fixture-source" "other-head")) :changed-head)
        (reject (lambda () (vttest-cursor-driver::validate-receipt art "wrong-root" request "fixture-source" "fixture-head")) :foreign-capture-root)))
    (let* ((path (vttest-area-tests::put-text "bound-artifact" "fixture-bytes"))
           (p (format nil "~a  ./bound-artifact~%" (vttest-cursor-driver::digest path))))
      (check (vttest-cursor-driver::provenance-file vttest-area-tests::*root* "bound-artifact" p) :finite-provenance)
      (reject (lambda () (vttest-cursor-driver::provenance-file vttest-area-tests::*root* "bound-artifact" "")) :missing-provenance)
      (reject (lambda () (vttest-cursor-driver::provenance-file vttest-area-tests::*root* "missing" p)) :missing-artifact))
    (let ((p (vttest-area-tests::put-text "raw-signed" "(:native-ack-output -1 :name \"raw\")")))
      (check (= -1 (getf (vttest-cursor-driver::raw-data p) :native-ack-output)) :raw-signed-data))
    (dolist (s '("#.(error \"bad\")" "(#1=(:x) #1#)" "(:x 1) (:x 2)" "(:x 'a)" "(:x . 2)" "(:x 1/2)"))
      (let ((p (vttest-area-tests::put-text (format nil "raw-bad-~d" vttest-area-tests::*checks*) s)))
        (reject (lambda () (vttest-cursor-driver::raw-data p)) :raw-malformed)))
    (reject (lambda () (vttest-cursor-driver::raw-preflight (make-string 65 :initial-element #\())) :raw-depth)
    (let ((snapshot (vttest-cursor-driver::source-snapshot)))
      (dolist (name '("tests/vttest-cursor-driver.lisp" "tests/vttest-cursor-oracle.lisp"))
        (check (search (format nil "~a  ~a~%" (vttest-cursor-driver::digest name) name) snapshot) :untracked-module-bound))
      (check (not (search "tests/capture-transaction" snapshot)) :protected-not-source-input)
      (multiple-value-bind (head tree) (vttest-area::source-bindings)
        (check (vttest-cursor-driver::current-bindings-p head tree snapshot) :current-source-binding)
        (check (not (vttest-cursor-driver::current-bindings-p head tree (concatenate 'string snapshot "changed"))) :stale-source-binding)))
    (let* ((proc (format nil "pid=99~%99 (bash) ~{~a~^ ~}~%/dev/pts/1~%/dev/pts/1~%/dev/pts/1~%24 80~%"
                         (append '("S" 98 99 99 34851 99) (make-list 13 :initial-element 0) '(123))))
           (transport (format nil "DISPLAY=:7~%server=55~%start=888~%"))
           (isolation (format nil "backend=x11 scale=1 server=55 start=888 runtime=/tmp/lispterm-x11.test~%client=99 start=123 endpoints=private~%client=98 start=122 endpoints=private~%"))
           (wait (format nil "client-wait pid=98 start=122 status=0~%")))
      (check (vttest-cursor-driver::private-session 99 proc transport isolation "7" wait) :finite-private-session)
      (reject (lambda () (vttest-cursor-driver::private-session 100 proc transport isolation "7" wait)) :foreign-session-child)
      (reject (lambda () (vttest-cursor-driver::private-session 99 proc transport isolation "8" wait)) :foreign-session-display)
      (reject (lambda () (vttest-cursor-driver::private-session 99 proc transport "" "7" wait)) :unproved-endpoints)
      (reject (lambda () (vttest-cursor-driver::private-session 99 proc transport isolation "7" "client-wait pid=98 start=122 status=1")) :client-failed)
      (reject (lambda () (vttest-cursor-driver::private-session 99 proc transport isolation "7" "client-wait pid=98 start=0 status=0")) :client-reused-pid)
      (reject (lambda () (vttest-cursor-driver::private-session 99 proc transport isolation "7" "client-wait pid=97 start=122 status=0")) :foreign-client-parent))
    ;; Refuse through the public CLI strictly before native launch.
    (let ((m (manifest)))
      (setf (getf (first (getf m :scenarios)) :requires) '((:capability "capture" :path "fake-ready.sexp")))
      (vttest-area-tests::cli (vttest-area-tests::args (vttest-area-tests::put-data "cursor-forged-ready.sexp" m)) 3
                             :cursor-forged-ready :count 6 :reason :unsupported-cursor-capability))
    (let ((m (manifest)))
      (setf (getf (first (getf (first (getf m :scenarios)) :captures)) :pause) 2)
      (vttest-area-tests::cli (vttest-area-tests::args (vttest-area-tests::put-data "cursor-partial.sexp" m)) 3
                             :cursor-partial :count 6 :reason :cursor-exact-six))
    (let ((old (sb-ext:posix-getenv "LISPTERM_VTTEST_EXACT_LABELS")))
      (unwind-protect
           (progn (sb-posix:setenv "LISPTERM_VTTEST_EXACT_LABELS" "screen" 1)
                  (vttest-area-tests::cli
                   (vttest-area-tests::args (vttest-area-tests::put-data "cursor-selector-conflict.sexp" (manifest)))
                   2 :cursor-selector-conflict :count 6 :reason :invalid-recorder-selection))
        (if old (sb-posix:setenv "LISPTERM_VTTEST_EXACT_LABELS" old 1)
            (sb-posix:unsetenv "LISPTERM_VTTEST_EXACT_LABELS"))))
    (let* ((m (manifest)) (s (getf m :scenarios))
           (obs (loop for n from 1 to 6 collect (list :scenario "cursor" :capture (format nil "pause-~d" n)
                     :fresh t :fixture t :pixels :pass :bytes :unverified :timing :unverified))))
      (check (eq :fixture-pass (vttest-area:aggregate-observations s obs :fixture t)) :finite-six-complete)
      (check (eq :unverified (vttest-area:aggregate-observations s obs)) :finite-six-not-live)
      (check (eq :unverified (vttest-area:aggregate-observations s (butlast obs) :fixture t)) :partial-six)
      (check (eq :unverified (vttest-area:aggregate-observations s (cons (first obs) obs) :fixture t)) :duplicate-six)
      (setf (getf (first obs) :fresh) nil)
      (check (eq :unverified (vttest-area:aggregate-observations s obs :fixture t)) :stale-six))
    (format t "~d cursor driver controls passed. Native runs: 0; full area PASS: false.~%" (- vttest-area-tests::*checks* before)) t))
