;;;; Validate present raw observations before classifying missing evidence.
(in-package #:vttest-keyboard-driver)
(load (merge-pathnames "vttest-keyboard-cleanup-status.lisp" *load-truename*))

(defun start-token-p (x)
  (and (stringp x) (<= 1 (length x) 32) (find (char x 0) "123456789")
       (every (lambda (c) (find c "0123456789")) x)))
(defun cleanup-boolean-p (x) (or (null x) (eq x t)))
(defun cleanup-artifacts (root) (concatenate 'string root "recorder"))
(defun cleanup-title-p (title pid)
  (let ((prefix "Lispterm-vttest-") (suffix (format nil "-~d" pid)))
    (and (stringp title) (= (length title) (+ (length prefix) 16 (length suffix)))
         (equal prefix (subseq title 0 (length prefix)))
         (every (lambda (c) (find c "0123456789abcdef"))
                (subseq title (length prefix) (+ (length prefix) 16)))
         (equal suffix (subseq title (+ (length prefix) 16))))))
(defun validate-launch-bindings (launch)
  (cleanup-validating
    (cleanup-fields launch '(:gate-pid :gate-start :title :artifacts :area-request-sha256))
    (dolist (spec (list (list :gate-pid (lambda (x) (typep x '(integer 1))))
                       (list :gate-start #'start-token-p) (list :title #'text-p)
                       (list :artifacts (lambda (x) (and (text-p x) (char= (code-char 47) (char x 0)))))
                       (list :area-request-sha256 #'hex-p)))
      ;; A NIL launch observation is the producer's explicit unknown marker.
      (if (null (getf launch (first spec))) (cleanup-absent (first spec))
          (cleanup-value launch (first spec) (second spec) :keyboard-launch-bindings)))
    (when (and (getf launch :title) (getf launch :gate-pid))
      (need (cleanup-title-p (getf launch :title) (getf launch :gate-pid)) :keyboard-launch-title))
    (when (getf launch :artifacts) (vttest-area::safe-components (getf launch :artifacts)))
    launch))
(defparameter +launch-keys+
  '(:kind :version :backend :gate-pid :gate-start :title :artifacts :area-request-sha256))
(defun cleanup-header (record kind backend)
  (cleanup-value record :kind (lambda (x) (eq x kind)) :keyboard-cleanup-kind)
  (cleanup-value record :version (lambda (x) (eql x 1)) :keyboard-cleanup-version)
  (cleanup-value record :backend (lambda (x) (equal x backend)) :keyboard-cleanup-backend))
(defun validate-gate-launch (record backend root)
  (cleanup-validating
    (cleanup-fields record +launch-keys+)
    (cleanup-header record :vttest-keyboard-gate-launch backend)
    (validate-launch-bindings
     (loop for (key value) on record by #'cddr when (member key (cdddr +launch-keys+))
           append (list key value)))
    (when (getf record :artifacts)
      (need (equal (getf record :artifacts) (cleanup-artifacts root)) :keyboard-gate-artifacts))
    record))
(defun validate-gate-exit (record backend)
  (cleanup-validating
    (cleanup-fields record '(:kind :version :backend :gate-pid :gate-start :exit-code :wait-observed))
    (cleanup-header record :vttest-keyboard-gate-exit backend)
    (cleanup-value record :gate-pid (lambda (x) (typep x '(integer 1))) :keyboard-gate-exit)
    (cleanup-value record :gate-start #'start-token-p :keyboard-gate-exit)
    (cleanup-value record :exit-code (lambda (x) (typep x '(integer 0 255))) :keyboard-gate-exit)
    (cleanup-value record :wait-observed #'cleanup-boolean-p :keyboard-gate-exit)
    record))
(defun validate-raw-owned (owned)
  (vttest-area::proper owned 64)
  (let ((pids nil))
    (dolist (entry owned)
      (cleanup-fields entry '(:role :pid :start :state :observed :direct :wait-status))
      (flet ((check (key predicate) (cleanup-value entry key predicate :keyboard-raw-owned)))
        (check :role #'text-p)
        (check :pid (lambda (x) (typep x '(integer 1))))
        (check :start #'start-token-p)
        (check :state (lambda (x) (member x '(:stopped :failed :unknown))))
        (check :observed (lambda (x) (member x '(:absent :replaced :zombie :live :unknown))))
        (check :direct #'cleanup-boolean-p)
        (check :wait-status (lambda (x) (or (null x) (typep x '(integer 0 255))))))
      (when (cleanup-present-p entry :pid)
        (need (not (member (getf entry :pid) pids)) :keyboard-owned-duplicate-pid)
        (push (getf entry :pid) pids)))))
(defun validate-raw-failures (raw)
  (dolist (key '(:adoption-failures :identity-failures))
    (vttest-area::proper (getf raw key) 64)
    (dolist (entry (getf raw key))
      (if (eq key :adoption-failures)
          (progn
            (cleanup-fields entry '(:role :pid :reason))
            (cleanup-value entry :role #'text-p :keyboard-adoption-failure)
            (cleanup-value entry :reason (lambda (x) (eq x :initial-token-unreadable))
                           :keyboard-adoption-failure))
          (progn
            (cleanup-fields entry '(:pid :start :observed-start :reason))
            (cleanup-value entry :start #'start-token-p :keyboard-identity-failure)
            (cleanup-value entry :observed-start #'start-token-p :keyboard-identity-failure)
            (when (and (cleanup-present-p entry :start) (cleanup-present-p entry :observed-start))
              (need (not (equal (getf entry :start) (getf entry :observed-start)))
                    :keyboard-identity-failure))
            (cleanup-value entry :reason (lambda (x) (eq x :pid-reused)) :keyboard-identity-failure)))
      (cleanup-value entry :pid (lambda (x) (typep x '(integer 1))) :keyboard-failure-pid))))
(defun validate-raw-cleanup (raw backend)
  (cleanup-validating
    (cleanup-fields raw '(:kind :version :phase :launch :state :stop-owned :runtime :owned
                          :wayland-holder :launch-valid :adoption-failures :identity-failures))
    (flet ((check (key predicate) (cleanup-value raw key predicate :keyboard-raw-cleanup)))
      (check :kind (lambda (x) (eq x :vttest-gate-cleanup)))
      (check :version (lambda (x) (eql x 1)))
      (check :phase (lambda (x) (eq x :post-close)))
      (check :state (lambda (x) (member x '(:stopped :failed :unknown :incomplete))))
      (check :stop-owned (lambda (x) (member x '(:all-stopped :survived))))
      (check :runtime (lambda (x) (member x '(:none :removed :retained))))
      (check :wayland-holder (lambda (x) (member x (if (equal backend "x11") '(:not-applicable)
                                                     '(:stopped :failed :unknown :incomplete :missing)))))
      (check :launch-valid #'cleanup-boolean-p))
    (when (cleanup-present-p raw :launch) (validate-launch-bindings (getf raw :launch)))
    (validate-raw-owned (getf raw :owned))
    (let ((pid (getf (getf raw :launch) :gate-pid)))
      (when pid (need (not (find pid (getf raw :owned) :key (lambda (o) (getf o :pid))))
                      :keyboard-gate-self-ownership)))
    (validate-raw-failures raw)
    raw))
