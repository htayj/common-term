;;;; Synthetic component checks only. These fixtures do not assert a root PASS.
(load (merge-pathnames "vttest-vt52-native-root.lisp" *load-truename*))
(defpackage :vttest-vt52-native-root-tests
  (:use :cl :vttest-vt52-native-io :vttest-vt52-native-root) (:export :run-tests))
(in-package :vttest-vt52-native-root-tests)
(defvar *count* 0)
(defvar *fixture* 0)
(defun check (x) (incf *count*) (assert x))
(defun refuses (fn) (check (handler-case (progn (funcall fn) nil) (error () t))))
(defun raw (root path text)
  (let* ((bytes (sb-ext:string-to-octets text :external-format :utf-8))
         (p (local-path root path :missing t)))
    (assert (<= (length bytes) 8192))
    (let ((fd (sb-posix:open p (logior sb-posix:o-wronly sb-posix:o-creat sb-posix:o-excl) #o600)))
      (with-open-stream (s (sb-sys:make-fd-stream fd :output t :element-type '(unsigned-byte 8) :auto-close t))
        (write-sequence bytes s)))
    (assert (equalp bytes (read-octets root path)))))
(defun fixture (u &key (log "") (end 200) (validated 300) (deadline 15000000100))
  (let ((root (format nil "~a.build/vt52-root320-~d-~d/" (namestring (truename "."))
                      (get-universal-time) (incf *fixture*))))
    (handler-case (progn (sb-posix:lstat root) (error "Existing fixture"))
      (sb-posix:syscall-error (e) (assert (= sb-posix:enoent (sb-posix:syscall-errno e)))))
    (sb-posix:mkdir root #o700)
    (dolist (d '("native" "recorder")) (sb-posix:mkdir (concatenate 'string root d) #o700))
    (raw root "native/owned.tsv" (format nil "11 101~%12 102~%"))
    (raw root "native/cleanup.log" log)
    (write-data root "native/owned-cleanup.sexp" u)
    (write-data root "native/client.exit" 0)
    (write-data root "native/finalization-clock.sexp.start" 100)
    (write-data root "recorder/RESULT.sexp" '(:kind :unit-fixture))
    (write-data root "native/finalization-clock.sexp"
      (list :clock :clock-monotonic :limit-seconds 15 :start-ns 100 :end-ns end
            :state :exited :pid 11 :token "101" :run root :backend "x11"))
    (write-data root "native/import-deadline.sexp"
      (list :clock :clock-monotonic :deadline-ns deadline :validated-ns validated :state :valid))
    root))
(defun cleanup-record ()
  '(:version 1 :client (:pid 11 :start-token "101" :term-exit nil :kill-exit nil :wait-exit 0 :waited t)
    :server (:pid 12 :start-token "102" :term-exit 0 :kill-exit nil :wait-exit 143 :waited t)))
(defun boundary-checks (root f)
  ;; Reproduce trusted parsed-subtree aliases at the component assembly boundary.
  (let* ((n (parse-data (sb-ext:string-to-octets
               (let ((*print-readably* nil)) (write-to-string
                 (list :finalization f :unowned-endpoints
                   (list (list :path "/unit-endpoint" :ownership :unestablished)))))
               :external-format :utf-8)))
         (shared (list :native-run n :ledger (list :kind :component-fixture)
                   :sources (list (list "recorder/RESULT.sexp"
                                      (digest-file (local-path root "recorder/RESULT.sexp"))))
                   :cleanup (list :finalization (getf n :finalization)
                             :unowned-endpoints (getf n :unowned-endpoints)))))
    (check (eq (getf n :finalization) (getf (getf shared :cleanup) :finalization)))
    (refuses (lambda () (guard-tree shared)))
    (dolist (mode '(:candidate :final))
      (let* ((assembled (vttest-vt52-native-root::component-tree
                          (append (list :mode mode) shared)))
             (path (format nil "boundary-~(~a~).sexp" mode)))
        (check (equal assembled (guard-tree assembled)))
        (check (eq mode (getf assembled :mode)))
        (check (not (eq (getf (getf assembled :native-run) :finalization)
                        (getf (getf assembled :cleanup) :finalization))))
        (check (not (eq (getf (getf assembled :native-run) :unowned-endpoints)
                        (getf (getf assembled :cleanup) :unowned-endpoints))))
        (check (equal (getf n :finalization)
                      (getf (getf assembled :cleanup) :finalization)))
        (let ((row (first (getf assembled :sources))))
          (check (and (= 2 (length row)) (stringp (first row)) (hex-p (second row))))
        (write-data root path assembled)
        (check (equal assembled (read-data root path)))))
    (refuses (lambda () (guard-tree (list :sources (list (cons "x" "hash")))))))))
(defun run-tests ()
  (let ((*count* 0))
    (dolist (candidate '(nil (:kind :stored-pass)))
      (let ((r (validate-root "/missing-vt52-unit-root/" :candidate candidate)))
        (check (eq :refuse (getf r :verdict)))
        (check (eq (if candidate :candidate :final) (getf r :mode)))
        (check (null (getf (getf r :provenance) :native-run)))
        (check (equal r (guard-tree r)))))
    (let* ((u (cleanup-record)) (root (fixture u))
           (clock (read-data root "native/finalization-clock.sexp")))
      (check (equal u (validate-cleanup root clock)))
      (let ((f (list :state :complete :client-exit 0 :result (reference root "recorder/RESULT.sexp") :abort nil)))
        (check (equal f (validate-finalization f root "x11")))
          (boundary-checks root f)
        (refuses (lambda () (validate-finalization f root "wayland"))))
      (check (eq :refuse (getf (validate-root root :candidate '(:status :pass)) :verdict))))
    (dolist (change '((:server :waited nil) (:server :wait-exit nil) (:server :pid 11)
                      (:server :start-token "999") (:server :term-exit -1)
                      (:client :wait-exit 143) (:client :start-token "102")))
      (let ((u (copy-tree (cleanup-record))))
        (setf (getf (getf u (first change)) (second change)) (third change))
        (let ((root (fixture u)))
          (refuses (lambda () (validate-cleanup root (read-data root "native/finalization-clock.sexp")))))))
    (dolist (options '((:end 99) (:validated 199) (:validated 15000000100) (:deadline 15000000101)))
      (let* ((root (apply #'fixture (cleanup-record) options))
             (f (list :state :complete :client-exit 0 :result (reference root "recorder/RESULT.sexp") :abort nil)))
        (refuses (lambda () (validate-finalization f root "x11")))))
    (let ((root (fixture (cleanup-record) :log (format nil "owned-survivor /unit-only~%"))))
      (refuses (lambda () (validate-cleanup root (read-data root "native/finalization-clock.sexp")))))
    (format t "~d root component checks passed~%" *count*) *count*))
