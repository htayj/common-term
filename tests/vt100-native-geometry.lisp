;;;; C5 native-only disposable fixture. Loading/compiling defines functions only.
;;;; --self-test is explicitly non-GUI; --native and --producer require shell context.
(eval-when (:compile-toplevel :load-toplevel :execute) (require :asdf))
(eval-when (:compile-toplevel :load-toplevel :execute)
  (unless (asdf:find-system "lispterm" nil)
    (load (merge-pathnames "../scripts/bootstrap.lisp" #.(or *compile-file-truename* *load-truename*))))
  (asdf:load-system "lispterm")
  (load (merge-pathnames "vttest-protocol.lisp" #.(or *compile-file-truename* *load-truename*))))
(defpackage #:native-geometry (:use #:cl))
(in-package #:native-geometry)
(defparameter *source* #.(or *compile-file-truename* *load-truename*))
(defvar *art* nil)
(defvar *scale* 1)
(defvar *serial* 0)
(defvar *capture* 0)
(defvar *read-lock* (sb-thread:make-mutex :name "native PTY read evidence"))
(defvar *read-count* 0)
(defun path (name) (merge-pathnames name *art*))
(defun save (name value) (vttest-check:write-value (path name) value))
(defun append-value (name value)
  (with-open-file (s (path name) :direction :output :if-exists :append :if-does-not-exist :create)
    (let ((*print-pretty* nil)) (write value :stream s) (terpri s))))
(defun now () (/ (get-internal-real-time) internal-time-units-per-second))
(defun await (thunk &optional (seconds 15))
  (loop with end = (+ (now) seconds) for result = (funcall thunk)
        when result return result
        when (> (now) end) do (error "Native fixture deadline (~ds)" seconds)
        do (sleep .01)))
(defun publish (name value)
  (save "publish.tmp" value)
  (rename-file (path "publish.tmp") (path name)))
(defun status (host)
  (let ((s (lispterm:status host)))
    (append-value "status-history.sexp" (list :time (now) :status s))
    (unless (and (getf s :worker-alive-p) (zerop (getf s :error-count)))
      (error "Owner died or recorded errors: ~s" s))
    s))
(defun same-attempt-p (a b)
  (and (every (lambda (k) (equal (getf a k) (getf b k)))
              '(:backend :engine-geometry-generation :columns :rows :pty-columns :pty-rows :bytes-received))
       (every (lambda (k) (equal (getf (getf a :geometry) k) (getf (getf b :geometry) k)))
              '(:request-id :epoch :display-epoch :metric-generation :phase :cell-width :cell-height
                :columns :rows :actual-width :actual-height :requested-width :requested-height
                :requested-columns :requested-rows :target-presentation :buffer-scale))))
(defun progress-p (a b &key strict)
  (and (if strict (> (getf b :frames) (getf a :frames)) (>= (getf b :frames) (getf a :frames)))
       (>= (getf (getf b :geometry) :presentation) (getf (getf a :geometry) :presentation))
       (or (eq :x11 (getf b :backend))
           (every (lambda (k)
                    (if strict (> (getf (getf b :geometry) k) (getf (getf a :geometry) k))
                        (>= (getf (getf b :geometry) k) (getf (getf a :geometry) k))))
                  '(:commit-generation :frame-generation)))))
(defun fresh-p (a b scale)
  (handler-case
      (and (vttest-check:geometry-capture-ready-p a scale)
           (vttest-check:geometry-capture-ready-p b scale)
           (same-attempt-p a b) (progress-p a b :strict t))
    (error () nil)))
(defun external-proof-p (s external scale)
  (handler-case
      (let* ((g (getf s :geometry)) (w (getf g :actual-width)) (h (getf g :actual-height))
             (x (getf external :x)) (y (getf external :y))
             (ox (getf external :output-x)) (oy (getf external :output-y)))
        (and (vttest-check:geometry-capture-ready-p s scale)
             (= scale (getf external :scale)) (= w (getf external :logical-width))
             (= h (getf external :logical-height))
             (= (* scale w) (getf external :pixel-width)) (= (* scale h) (getf external :pixel-height))
             (>= (getf external :output-width) (* 132 (getf g :cell-width)))
             (>= x ox) (>= y oy) (<= (+ x w) (+ ox (getf external :output-width)))
             (<= (+ y h) (+ oy (getf external :output-height)))))
    (error () nil)))
(defun ready (host columns &optional generation)
  (await (lambda ()
           (let ((s (status host)))
             (when (and (= columns (getf s :columns))
                        (or (null generation) (= generation (getf s :engine-geometry-generation)))
                        (vttest-check:geometry-capture-ready-p s *scale*)) s)))))
(defun barrier (host columns)
  (let ((before (ready host columns)))
    (lispterm:invalidate host)
    (values before
            (await (lambda () (let ((s (status host)))
                                (unless (same-attempt-p before s)
                                  (error "Attempt/output changed during fresh-frame barrier"))
                                (when (fresh-p before s *scale*) s)))))))
(defun snapshot (host name)
  ;; Screen is data owned by the session lock, not a display-owner call.
  (let ((session (lispterm::host-session host)))
    (sb-thread:with-mutex ((lispterm::session-lock session))
      (let ((screen (lispterm::session-screen session)))
        (with-open-file (out (path (concatenate 'string name ".grid.txt"))
                             :direction :output :if-exists :supersede)
          (dotimes (r (lispterm.engine:rows screen))
            (dotimes (c (lispterm.engine:columns screen))
              (write-char (or (lispterm.engine:cell-character (lispterm.engine:cell-at screen r c)) #\Space) out))
            (terpri out)))))))
(defun markers-p (host columns rows)
  (let ((session (lispterm::host-session host)))
    (sb-thread:with-mutex ((lispterm::session-lock session))
      (let ((screen (lispterm::session-screen session)))
        (and (every (lambda (pair)
                      (eql (cdr pair) (lispterm.engine:cell-character
                                      (lispterm.engine:cell-at screen 0 (1- (car pair))))))
                    (if (= columns 132) '((1 . #\A) (80 . #\B) (100 . #\C) (132 . #\D))
                        '((1 . #\A) (80 . #\B))))
              ;; Row three is never touched by marker-text. Later edge/blink
              ;; painting cannot reconstruct this immediate post-mode sentinel.
              (eql #\I (lispterm.engine:cell-character
                         (lispterm.engine:cell-at screen 2 (if (= columns 132) 99 69))))
              (eql #\Z (lispterm.engine:cell-character (lispterm.engine:cell-at screen (1- rows) (1- columns)))))))))
(defun opposite-blink-captures-p (a b)
  ;; :BLINK-VISIBLE reports content presence, not the current display phase.
  (and (getf a :blink-visible) (getf b :blink-visible)
       (not (eql (getf a :blink-phase) (getf b :blink-phase)))))
(defun capture (host label &key (blink nil blink-p))
  (multiple-value-bind (before ready) (barrier host (getf (status host) :columns))
    (let* ((name (format nil "~3,'0d-~a" (incf *capture*) label))
           (g (getf ready :geometry)) (started (now)))
      (save (concatenate 'string name ".before.sexp") before)
      (save (concatenate 'string name ".ready.sexp") ready)
      (snapshot host name)
      ;; C5 request includes cell width for full132 output-fit validation.
      (with-open-file (s (path "capture.tmp") :direction :output :if-exists :supersede)
        (format s "~a ~d ~d ~d ~d~%" name (getf g :actual-width) (getf g :actual-height) *scale* (getf g :cell-width)))
      (rename-file (path "capture.tmp") (path "capture-request"))
      (await (lambda () (probe-file (path "capture-ack"))))
      (with-open-file (s (path "capture-ack"))
        (unless (string= name (read-line s)) (error "Wrong native capture ACK")))
      (delete-file (path "capture-ack"))
      (let ((final (status host)) (external (vttest-check:read-value (path (concatenate 'string name ".external.sexp")))))
        (save (concatenate 'string name ".final.sexp") final)
        (save (concatenate 'string name ".ack.sexp")
              (list :name name :start started :end (now) :before-blink (getf ready :blink-phase)
                    :final-blink (getf final :blink-phase) :visible (getf final :blink-visible)))
        (unless (and (vttest-check:geometry-capture-ready-p final *scale*)
                     (same-attempt-p ready final) (progress-p ready final)
                     (zerop (getf final :input-pending)) (external-proof-p final external *scale*)
                     (or (not blink-p)
                         (and (eql blink (getf ready :blink-phase)) (eql blink (getf final :blink-phase)))))
          (error "Native capture proof failed: ~a" name))
        final))))
(defun action (kind &optional w h)
  (with-open-file (s (path "action.tmp") :direction :output :if-exists :supersede)
    (format s "~a~@[ ~d~]~@[ ~d~]~%" kind w h))
  (rename-file (path "action.tmp") (path "action-request"))
  (await (lambda () (probe-file (path "action-ack"))))
  (append-value "actions.sexp" (list :kind kind :width w :height h :time (now)))
  (delete-file (path "action-ack")))
(defun esc (text) (concatenate 'string (string (code-char 27)) text))
(defun marker-text (columns rows)
  (with-output-to-string (out)
    (dolist (pair (if (= columns 132) '((1 . #\A) (80 . #\B) (100 . #\C) (132 . #\D)) '((1 . #\A) (80 . #\B))))
      (format out "~c[1;~dH~c" (code-char 27) (car pair) (cdr pair)))
    (format out "~c[2;20H~c[5mBLINK~c[0m~c[~d;~dHZ" (code-char 27) (code-char 27) (code-char 27) (code-char 27) rows columns)))
(defun immediate-sentinel (columns)
  (esc (format nil "[3;~dHI" (if (= columns 132) 100 70))))
(defun payload (kind rows)
  (let* ((columns (if (member kind '(:wide :repeat-wide :burst)) 132 80))
         (prefix (ecase kind
                   (:initial (concatenate 'string (esc "[2J") (esc "[H")))
                   (:wide (esc "[?3h")) (:narrow (esc "[?3l"))
                   (:repeat-wide (concatenate 'string (esc "[?3h") (esc "[?3h")))
                   (:repeat-narrow (concatenate 'string (esc "[?3l") (esc "[?3l")))
                   (:burst (concatenate 'string (esc "[?3l") (esc "[?3h") (esc "[?3l") (esc "[?3h"))))))
    ;; The sentinel immediately follows the last mode command in the same write.
    ;; No later command paints its cell, including the column100 edge marker.
    (concatenate 'string prefix (immediate-sentinel columns) (marker-text columns rows))))
(defun producer ()
  "One libc write per command. No synthetic claim about the owner's read boundaries."
  (unless (and (= 1 (cffi:foreign-funcall "isatty" :int 0 :int))
               (= 1 (cffi:foreign-funcall "isatty" :int 1 :int)))
    (error "Producer requires a real PTY on stdin/stdout"))
  (let ((input (cffi:foreign-funcall "ttyname" :int 0 :string))
        (output (cffi:foreign-funcall "ttyname" :int 1 :string)))
    (unless (equal input output) (error "Producer PTY endpoints differ"))
    (save "producer-ready.sexp" (list :pid (sb-posix:getpid) :time (now) :tty input :isatty t)))
  (loop
    (let* ((request (await (lambda () (vttest-check:read-value (path "producer-request"))) 180))
           (serial (getf request :serial)) (kind (getf request :kind)))
      (delete-file (path "producer-request"))
      (when (eq kind :stop) (return))
      (let* ((text (payload kind (getf request :rows))) (bytes (babel:string-to-octets text :encoding :latin-1))
             (count (length bytes)))
        (cffi:with-foreign-object (buffer :unsigned-char count)
          (dotimes (i count) (setf (cffi:mem-aref buffer :unsigned-char i) (aref bytes i)))
          (let ((written (cffi:foreign-funcall "write" :int 1 :pointer buffer :unsigned-long count :long)))
            (append-value "producer-writes.sexp" (list :serial serial :kind kind :time (now) :intended count :written written :bytes text))
            (unless (= written count) (error "Partial single producer write"))))
        (publish "producer-ack" (list :serial serial :bytes count))))))
(defun emit (host kind &optional (delta 1))
  (let* ((before (status host)) (generation (getf before :engine-geometry-generation))
         (serial (incf *serial*)) (rows (getf before :rows)))
    (publish "producer-request" (list :serial serial :kind kind :rows rows))
    (let ((ack (await (lambda () (vttest-check:read-value (path "producer-ack"))))))
      (unless (= serial (getf ack :serial)) (error "Wrong producer handshake"))
      (delete-file (path "producer-ack"))
      (await (lambda () (let ((s (status host)))
                         (when (>= (getf s :bytes-received) (+ (getf before :bytes-received) (getf ack :bytes))) s)))))
    (+ generation delta)))
(defun checkpoint (host label kind columns delta)
  (let ((generation (emit host kind delta)))
    (let ((s (ready host columns generation)))
        (await (lambda () (markers-p host columns (getf s :rows)))))
    (capture host label)))
(defun failure-status-p (s)
  (and (getf s :worker-alive-p) (eql 0 (getf s :error-count))
       (member (getf (getf s :geometry) :phase) '(:refused :timed-out))))
(defun request-refusal (host name)
  (action "tiled")
  (let* ((generation (emit host :wide)) (start (now))
         (failed (await (lambda ()
                          (let* ((s (status host)) (g (getf s :geometry)))
                            (when (and (failure-status-p s) (eql generation (getf g :request-id))
                                       (eql generation (getf s :engine-geometry-generation))) s))))))
    (save name (list :verdict :expected-refusal :elapsed (- (now) start) :status failed))
    (when (vttest-check:geometry-capture-ready-p failed *scale*) (error "Refusal accepted as success"))
    failed))
(defun refusal (host)
  (let* ((failed (request-refusal host "expected-refusal.sexp")) (g (getf failed :geometry)))
    (action "floating")
    (lispterm:retry-geometry host)
    (let ((recovered (ready host 132)))
      (unless (and (eql (getf g :request-id) (getf (getf recovered :geometry) :request-id))
                   (> (getf (getf recovered :geometry) :epoch) (getf g :epoch)))
        (error "Retry did not preserve id and advance epoch"))
      (save "retry-recovered.sexp" recovered))
    (capture host "retry-recovery"))
  ;; Exercise the signed failure recovery without a cancellation first.
  (request-refusal host "expected-refusal-ordinary.sexp")
  (action "floating") (external-resize host "post-failure-user-resize.sexp")
  (unless (failure-status-p (status host)) (error "Ordinary resize changed terminal failure phase"))
  (checkpoint host "post-failure-deccolm" :wide 132 1)
  (request-refusal host "expected-refusal-cancel.sexp")
  (lispterm:cancel-geometry host)
  (let ((cancelled (await (lambda ()
                          (let* ((s (status host)) (g (getf s :geometry)))
                            (when (and (eq :cancelled (getf g :phase))
                                       (= (getf s :columns) (getf s :pty-columns) (getf g :columns))
                                       (= (getf s :rows) (getf s :pty-rows) (getf g :rows))) s))))))
    (save "cancel-adopt.sexp" cancelled))
  (action "floating") (external-resize host "post-cancel-user-resize.sexp")
  (checkpoint host "post-cancel-deccolm" :wide 132 1))
(defun external-resize (host &optional (name "external-user-resize.sexp"))
  (let* ((s (status host)) (g (getf s :geometry))
         (w (* 100 (getf g :cell-width))) (h (* 26 (getf g :cell-height))))
    (action "resize" w h)
    ;; Terminal request phase need not become settled for an ordinary resize.
    (let ((adopted (await (lambda () (let ((s (status host)))
                                      (when (and (= 100 (getf s :columns) (getf s :pty-columns))
                                                 (= 26 (getf s :rows) (getf s :pty-rows))
                                                 (= w (getf (getf s :geometry) :actual-width))
                                                 (= h (getf (getf s :geometry) :actual-height))) s))))))
      (save name adopted))))
(defun observe-reads (thunk)
  "Instrument only the actual disposable client's PTY reader, restoring on exit."
  (let ((original (symbol-function 'lispterm.pty:pty-read)))
    (unwind-protect
         (progn
           (setf (symbol-function 'lispterm.pty:pty-read)
                 (lambda (&rest args)
                   (let ((bytes (apply original args)))
                     (when (and (vectorp bytes) (plusp (length bytes)))
                       (sb-thread:with-mutex (*read-lock*)
                         (with-open-file (s (path "pty-read.raw") :direction :output :element-type '(unsigned-byte 8)
                                            :if-exists :append :if-does-not-exist :create)
                           (write-sequence bytes s))
                         (append-value "pty-read-chunks.sexp"
                                       (list :start *read-count* :end (incf *read-count* (length bytes))
                                             :time (now) :bytes (map 'string #'code-char bytes))))) bytes)))
           (funcall thunk))
      (setf (symbol-function 'lispterm.pty:pty-read) original))))
(defun native-run ()
  (observe-reads
   (lambda ()
     (let ((host (lispterm:open :backend (ecase (intern (string-upcase (uiop:getenv "LISPTERM_NATIVE_BACKEND")) :keyword)
                                                (:x11 :x11) (:wayland :wayland))
                              :title (uiop:getenv "LISPTERM_NATIVE_TITLE")
                              :argv (list (namestring (merge-pathnames "../scripts/sbcl" (uiop:pathname-directory-pathname *source*))) "--script"
                                          (namestring *source*) "--producer"))))
       (unwind-protect
            (progn
              (await (lambda () (probe-file (path "producer-ready.sexp"))))
              (ready host 80 0)
              (checkpoint host "initial80" :initial 80 0)
              (checkpoint host "wide132-one-write" :wide 132 1)
              (checkpoint host "narrow80" :narrow 80 1)
              (checkpoint host "repeat-wide" :repeat-wide 132 2)
              (checkpoint host "repeat-narrow" :repeat-narrow 80 2)
              (checkpoint host "burst-latest132" :burst 132 4)
              (external-resize host)
              (checkpoint host "after-user-resize" :wide 132 1)
              (let* ((old (getf (status host) :blink-phase))
                     (edge (await (lambda () (let ((s (status host)))
                                              (when (not (eql old (getf s :blink-phase))) s))) 3))
                     (a (capture host "blink-a" :blink (getf edge :blink-phase)))
                     (phase (getf a :blink-phase)))
                (await (lambda () (not (eql phase (getf (status host) :blink-phase)))) 3)
                (let ((b (capture host "blink-b" :blink (not phase))))
                  (unless (opposite-blink-captures-p a b)
                    (error "Blink captures need content in both opposite phases"))))
              (when (equal "refusal" (uiop:getenv "LISPTERM_NATIVE_MODE")) (refusal host))
              (save "completed.sexp" (list :fixture :c5 :verdict :proof-complete :status (status host)
                                             :captures *capture* :pty-read-bytes *read-count*)))
         (ignore-errors (publish "producer-request" (list :kind :stop :serial (incf *serial*))))
         (lispterm:close host))))))
;;; Pure scheme/attempt/proof tests. No host or native display is constructed.
(defun selectors-p (backend scale font mode seconds)
  (and (member backend '(:x11 :wayland)) (member scale '(1 2))
       (or (eq backend :wayland) (= scale 1)) (member font '(14 16 18))
       (member mode '(:normal :refusal)) (or (eq mode :normal) (eq backend :wayland))
       (typep seconds '(integer 30 600))))
(defun mock-status (&key (backend :x11) (scale 1) (id nil) (epoch 0))
  (list :backend backend :worker-alive-p t :error-count 0 :columns 80 :rows 24 :pty-columns 80 :pty-rows 24
        :frames 1 :bytes-received 100 :input-pending 0 :engine-geometry-generation (or id 0)
        :geometry (list :columns 80 :rows 24 :cell-width 8 :cell-height 16 :actual-width 640 :actual-height 384
                        :phase (if id :settled :idle) :request-id id :epoch epoch :display-epoch 0 :metric-generation 0
                        :presentation 1 :target-presentation (and id 1) :requested-columns 80 :requested-rows 24
                        :requested-width 640 :requested-height 384 :buffer-scale scale :configured-p t
                        :frame-pending-p nil :committed-width 640 :committed-height 384
                        :committed-buffer-width (* scale 640) :committed-buffer-height (* scale 384)
                        :buffer-width (* scale 640) :buffer-height (* scale 384)
                        :commit-generation 1 :frame-generation 1 :committed-request-id id :frame-request-id id
                        :committed-epoch (and id epoch) :frame-epoch (and id epoch))))
(defun fixture-regressions (check)
  ;; Real renderer, unattached framebuffer: no native display or host is opened.
  (let* ((session (lispterm::make-session nil 2 4))
         (screen (lispterm::session-screen session))
         (display (ltd::make-display :font (ltd::load-font nil 16)
                                     :owner sb-thread:*current-thread*)))
    (ltd::resize-display display 32 32)
    (setf (lispterm::session-last-title session) "")
    (lispterm.engine:feed screen (babel:string-to-octets
                                 (concatenate 'string (esc "[?25l") (esc "[5mE")) :encoding :latin-1))
    (flet ((sample () (list :blink-phase (lispterm::session-blink-phase session)
                           :blink-visible (lispterm::session-blink-visible session))))
      (lispterm::render-session session display :now 0)
      (let ((a (sample)) (pixels (copy-seq (ltd::display-framebuffer display))))
        (lispterm::render-session session display :now 1/2)
        (let ((b (sample)))
          (funcall check (not (equalp pixels (ltd::display-framebuffer display))))
          (funcall check (and (eq t (getf a :blink-visible)) (eq t (getf b :blink-visible))))
          (funcall check (opposite-blink-captures-p a b))
          (funcall check (not (opposite-blink-captures-p a a)))
          (funcall check (not (opposite-blink-captures-p b b)))
          ;; Remove actual content and render again at each phase. Content flags
          ;; come from the renderer, never from invented opposite-presence data.
          (lispterm.engine:feed screen (babel:string-to-octets (esc "[2J") :encoding :latin-1))
          (lispterm::render-session session display :now 0)
          (let ((empty-a (sample)))
            (funcall check (not (getf empty-a :blink-visible)))
            (funcall check (not (opposite-blink-captures-p empty-a b))))
          (lispterm::render-session session display :now 1/2)
          (let ((empty-b (sample)))
            (funcall check (not (getf empty-b :blink-visible)))
            (funcall check (not (opposite-blink-captures-p a empty-b))))))))
  ;; Feed the actual payload, or mutate ONLY its immediate CUP+sentinel. Check
  ;; the production checkpoint predicate against the real engine, not a mock.
  (dolist (kind '(:initial :wide :narrow :repeat-wide :repeat-narrow :burst))
    (dolist (rows '(24 26))
      (let* ((columns (if (member kind '(:wide :repeat-wide :burst)) 132 80))
             (text (payload kind rows)) (sentinel (immediate-sentinel columns))
             (start (search sentinel text)))
        (funcall check start)
        (dolist (mutation '(:valid :missing :misplaced))
          (let* ((session (lispterm::make-session nil rows (if (= rows 26) 100 80)))
                 (host (lispterm::%make-host :session session))
                 (screen (lispterm::session-screen session))
                 (replacement (ecase mutation (:valid sentinel) (:missing "")
                                (:misplaced (esc (format nil "[3;~dHI" (if (= columns 132) 101 71))))))
                 (wire (concatenate 'string (subseq text 0 start) replacement
                                    (subseq text (+ start (length sentinel))))))
            ;; Initial has no mode command; start it at the real initial width.
            (when (eq kind :initial) (lispterm.engine:resize screen rows 80))
            ;; A prior successful same-mode checkpoint must not mask deletion.
            (when (member kind '(:repeat-wide :repeat-narrow))
              (lispterm.engine:feed screen (babel:string-to-octets text :encoding :latin-1)))
            (lispterm.engine:feed screen (babel:string-to-octets wire :encoding :latin-1))
            (funcall check (= columns (lispterm.engine:columns screen)))
            (funcall check (eql (eq mutation :valid) (not (null (markers-p host columns rows)))))))))))
(defun self-test ()
  (let ((checks 0))
    (flet ((check (truth) (incf checks) (unless truth (error "C5 self-test ~d failed" checks))))
      (fixture-regressions #'check)
      (dolist (backend '(:x11 :wayland))
        (dolist (scale (if (eq backend :x11) '(1) '(1 2)))
          (dolist (id '(nil 7))
            (let* ((s (mock-status :backend backend :scale scale :id id :epoch 2)) (g (getf s :geometry))
                   (next (copy-tree s)) (ng (getf next :geometry)))
              (check (vttest-check:geometry-capture-ready-p s scale))
              (check (not (fresh-p s s scale)))
              (incf (getf next :frames)) (incf (getf ng :commit-generation)) (incf (getf ng :frame-generation))
              (check (fresh-p s next scale))
              (dolist (key '(:epoch :display-epoch :metric-generation))
                (let ((bad (copy-tree next))) (incf (getf (getf bad :geometry) key)) (check (not (fresh-p s bad scale)))))
              (dolist (phase '(:pending :surface-ready :closing :refused :timed-out :cancelled :superseded))
                (let ((bad (copy-tree s))) (setf (getf (getf bad :geometry) :phase) phase)
                  (check (not (vttest-check:geometry-capture-ready-p bad scale)))))
              (dolist (key '(:cell-width :actual-width :requested-width :presentation))
                (when (or id (not (eq key :requested-width)))
                  (let ((bad (copy-tree s))) (setf (getf (getf bad :geometry) key) -1)
                    (check (not (vttest-check:geometry-capture-ready-p bad scale))))))
              (let ((bad (copy-tree next))) (incf (getf bad :bytes-received)) (check (not (fresh-p s bad scale))))
              (check (not (vttest-check:geometry-capture-ready-p s 3)))
              (when (eq backend :wayland)
                (let ((bad (copy-tree next))) (decf (getf (getf bad :geometry) :frame-generation)) (check (not (fresh-p s bad scale))))
                (check (not (vttest-check:geometry-capture-ready-p s (- 3 scale)))))
              (check (= (* 80 (getf g :cell-width)) (getf g :actual-width)))))))
      (let* ((s (mock-status)) (e '(:logical-width 640 :logical-height 384 :scale 1 :pixel-width 640 :pixel-height 384
                                    :x 0 :y 0 :output-x 0 :output-y 0 :output-width 1280 :output-height 800)))
        (check (external-proof-p s e 1))
        (dolist (key '(:logical-width :pixel-width :scale :output-width :output-height))
          (let ((bad (copy-list e))) (setf (getf bad key) 0) (check (not (external-proof-p s bad 1)))))
        (let ((bad (copy-list e))) (setf (getf bad :y) 700) (check (not (external-proof-p s bad 1)))))
      (let ((failed (mock-status :id 7 :epoch 2)) (retried (mock-status :id 7 :epoch 3)))
        (setf (getf (getf failed :geometry) :phase) :timed-out)
        (check (failure-status-p failed))
        (check (not (vttest-check:geometry-capture-ready-p failed 1)))
        (check (vttest-check:geometry-capture-ready-p retried 1))
        (check (not (same-attempt-p failed retried))))
      (check (search (concatenate 'string (esc "[?3h") (immediate-sentinel 132)) (payload :wide 24)))
      (check (= 4 (count #\? (payload :burst 24))))
      (dolist (backend '(:x11 :wayland))
        (dolist (scale '(1 2))
          (dolist (font '(14 16 18))
            (check (eql (not (null (selectors-p backend scale font :normal 180)))
                        (or (eq backend :wayland) (= scale 1)))))))
      (dolist (bad '((:x11 2 16 :normal 180) (:x11 1 16 :refusal 180)
                     (:wayland 3 16 :normal 180) (:wayland 1 17 :normal 180)
                     (:wayland 1 16 :normal 29) (:wayland 1 16 :normal 601)
                     (:auto 1 16 :normal 180) (:wayland 1 16 :unknown 180)))
        (check (not (apply #'selectors-p bad))))
      (let* ((s (mock-status :id 4)) (g (getf s :geometry)))
        (setf (getf g :cell-width) 9 (getf g :cell-height) 18
              (getf g :actual-width) 720 (getf g :actual-height) 432
              (getf g :requested-width) 720 (getf g :requested-height) 432)
        (check (vttest-check:geometry-capture-ready-p s 1))))
    (format t "NATIVE GEOMETRY SELF-TEST PASS: ~d checks~%" checks)))
(defun main (args)
  (cond ((equal args '("--self-test")) (self-test))
        ((member args '(("--native") ("--producer")) :test #'equal)
         (unless (and (uiop:getenv "LISPTERM_NATIVE_ARTIFACTS") (uiop:getenv "LISPTERM_NATIVE_SCALE")
                      (uiop:getenv "LISPTERM_NATIVE_BACKEND") (uiop:getenv "LISPTERM_GUI_LOCK_HELD"))
           (error "Native mode requires the isolated shell fixture"))
         (setf *art* (uiop:ensure-directory-pathname (uiop:getenv "LISPTERM_NATIVE_ARTIFACTS"))
               *scale* (parse-integer (uiop:getenv "LISPTERM_NATIVE_SCALE")))
         (if (equal args '("--producer")) (producer) (native-run)))
        (t (error "Use --self-test, or invoke native mode through tests/verify.sh native-geometry"))))
;; Explicit singleton flags only. Plain load/compile does not dispatch.
(let ((args (uiop:command-line-arguments)))
  (when (member args '(("--self-test") ("--native") ("--producer")) :test #'equal)
    (main args)))
