;;;; Pure manifest/source-receipt comparison; never load driver or application.
(defpackage :vttest-vt52-source-input-tests
  (:use :cl) (:export :manifest-paths :shell-paths :missing-pins :shell-text))
(in-package :vttest-vt52-source-input-tests)
(defparameter *root* (merge-pathnames "../" (make-pathname :name nil :type nil :defaults *load-truename*)))
(defparameter *bash* "/nix/store/kwyi4bq5s2qgwbhz6cs4gjy57c2zdxws-bash-interactive-5.3p20/bin/bash")
(defun file-text (path)
  (with-open-file (s (merge-pathnames path *root*) :external-format :utf-8)
    (let* ((v (make-string (file-length s))) (n (read-sequence v s))) (subseq v 0 n))))
(defun shell-text () (file-text "tests/vttest-charsets-native.sh"))
(defun declarations (path)
  ;; Read only data. Preserve real package resolution without executing IN-PACKAGE.
  (dolist (name '("VTTEST-CHARSETS-DRIVER" "VTTEST-VT52-DRIVER"
                  "VTTEST-AREA" "VTTEST-CURSOR-DRIVER"))
    (unless (find-package name) (make-package name :use '("CL"))))
  (let ((*read-eval* nil) (*package* (find-package :cl-user)) (result nil))
    (with-open-file (s (merge-pathnames path *root*))
      (loop for form = (read s nil :eof) until (eq form :eof) do
        (when (and (consp form) (eq 'in-package (car form)))
          (setf *package* (find-package (second form))))
        (when (and (consp form) (eq 'defparameter (car form))) (push form result))))
    (nreverse result)))
(defun initializer (name forms)
  (let ((form (find name forms :key (lambda (x) (symbol-name (second x))) :test #'equal)))
    (assert form) (third form)))
(defun quoted-list (form)
  (assert (and (consp form) (eq 'quote (first form)) (= 2 (length form))))
  (assert (every #'stringp (second form))) (copy-list (second form)))
(defun manifest-paths ()
  "Real declaration spellings, including the archive; no invented fixture list."
  (let* ((shared (declarations "tests/vttest-charsets-manifest.lisp"))
         (vt52 (declarations "tests/vttest-vt52-manifest.lisp"))
         (archive (initializer "+CHARSETS-ARCHIVE+" shared))
         (base (quoted-list (initializer "+CHARSETS-PINS+" shared)))
         (extended (initializer "+VT52-PINS+" vt52))
         (append-form (second extended)))
    (assert (stringp archive))
    (assert (eq 'remove-duplicates (first extended)))
    (assert (eq 'append (first append-form)))
    (assert (equal "+CHARSETS-PINS+" (symbol-name (second append-form))))
    (cons archive (remove-duplicates (append base (quoted-list (third append-form))) :test #'equal))))
(defun between (text start end)
  (let* ((a (or (search start text) (error "Missing start ~S" start)))
         (b (or (search end text :start2 a) (error "Missing end ~S" end))))
    (subseq text a b)))
(defun declaration-line (text variable)
  (between text (format nil "    local ~a=" variable) (string #\Newline)))
(defun shell-paths (&optional (text (shell-text)) (profile "vt52"))
  "Expand only audited variable/array declarations and checksum operands in Bash.
No setup runs. SHA256SUM is a printing function; no receipt or file is written."
  (assert (member profile '("vt52" "charsets") :test #'equal))
  (let* ((begin (if (search "    local archive_input=" text)
                    "    local archive_input=" "    local -a profile_inputs="))
         (selection (between text begin "        sha256sum -- \"$manifest\""))
         (operands (between text "    sha256sum -- \"$manifest\" tests/verify.sh"
                            " > \"$native/execution-inputs.sha256\""))
         (program (format nil "set -Eeuo pipefail~%sha256sum() { shift; printf '%s~%' \"$@\"; }~%selected() {~%local root=/synthetic manifest=/synthetic/MANIFEST.sexp profile=~a~%local LISPTERM_FONT=/nix/store/9qvd27vg12177prxcl778rdhxh4lk2mi-terminus-font-4.49.1/share/fonts/terminus/ter-u16n.otb~%~a~%~a~%~a~%~a~%~afi~%~a~%}~%selected~%"
                          profile (declaration-line text "bash") (declaration-line text "sbcl")
                          (declaration-line text "archive") (declaration-line text "decoder")
                          selection operands))
         (out (make-string-output-stream)) (err (make-string-output-stream))
         (process (sb-ext:run-program *bash* (list "--noprofile" "--norc" "-c" program)
                                     :input nil :output out :error err :wait t))
         (error-text (get-output-stream-string err)))
    (assert (zerop (sb-ext:process-exit-code process)))
    (assert (zerop (length error-text)) () "~a" error-text)
    (with-input-from-string (s (get-output-stream-string out))
      (loop for row = (read-line s nil) while row collect row))))
(defun missing-pins (&optional (text (shell-text)))
  (set-difference (manifest-paths) (shell-paths text) :test #'equal))
