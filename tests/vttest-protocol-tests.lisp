  (let ((good (check-directory dir :mode :accept)))
    (unless (getf good :pass) (format t "GOOD FIXTURE ISSUES: ~s~%" (getf good :errors)))
    (check (getf good :pass) "complete synthetic recorder fixture accepted mechanically"))
  ;; Exercise the original review duplicate-result bypass, not a count mismatch.
  (let ((r (read-value (merge-pathnames "reports-dsr.result.sexp" dir))))
    (write-value (merge-pathnames "reports-da.result.sexp" dir) r)
    (write-value (merge-pathnames "inventory.sexp" dir)
