        (check (not (getf (check-directory dir :mode :accept) :pass))
               (format nil "original review96 ~a rejected without modification" name))))))
;; Every supported spelling and each occurrence gets the same causal contract.
(defun report-query-cases ()
  (loop for label in '("reports-da" "reports-dsr" "reports-parameters" "vt52")
        append (loop for da in (subseq (query-forms label) 0 2)
                     append (loop for test in (cond ((equal label "reports-da") (subseq (query-forms label) 0 2))
                                                    ((equal label "reports-parameters") (subseq (query-forms label) 2 4))
                                                    (t (list nil)))
                                  collect (list label
                                                (cons da (cond ((equal label "reports-da") (list test))
                                                               ((equal label "reports-dsr") (rest (dsr-queries)))
                                                               ((equal label "reports-parameters")
                                                                (list test (car (last (query-forms label)))))
                                                               (t (last (query-forms label))))))))))
(defun event-wires (events)
  (values (apply #'cat (loop for e in events when (eq :wire-out (getf e :kind)) collect (getf e :bytes)))
          (apply #'cat (loop for e in events when (eq :wire-in (getf e :kind)) collect (getf e :bytes)))))
(defun event-errors (label events)
  (let ((events (rechunk-events events)))
    (multiple-value-bind (output input) (event-wires events)
      (check-events label output input events))))
(dolist (spec (report-query-cases))
  (destructuring-bind (label queries) spec
    (multiple-value-bind (out input events)
        (fixture queries :test-phase (if (equal label "vt52") "pause-2" "navigate-1"))
      (declare (ignore out input))
      (loop for cut from 1 below (reduce #'max queries :key (lambda (q) (max (length (first q)) (length (second q)))))
            do (check (null (event-errors label (rechunk-events events :boundary cut)))
                      (format nil "~a all spellings query/reply cut ~d passes" label cut)))
      (check (null (event-errors label (rechunk-events events :output-size 1 :input-size 1)))
             (format nil "~a all spellings single-byte queries/replies pass" label))
      (check (event-errors label (multiple-value-bind (o i duplicate)
                                    (fixture (append queries (last queries))
                                             :test-phase (if (equal label "vt52") "pause-2" "navigate-1"))
                                  (declare (ignore o i)) duplicate))
             (format nil "~a duplicate query rejected" label))
      (let* ((events (rechunk-events events :input-size 1))
             (driver (find :driver events :key (lambda (e) (getf e :kind))))
             (accepted (remove-if-not (lambda (e) (and (eq :wire-in (getf e :kind))
                                                       (eq :input (getf e :source)))) events))
             (reads (remove-if-not (lambda (e) (eq :wire-out (getf e :kind))) events)))
        (loop for read in (rest reads) for index from 1
              do (let ((without (remove read events :test #'eq)))
                   ;; Before driver, before enqueue, and before every accepted byte.
                   (dolist (target (append (list driver
                                                (find-if (lambda (e) (and (eq :enqueue (getf e :kind))
                                                                         (eq :input (getf e :source)))) events))
                                          accepted))
                     (let* ((p (position target without :test #'eq))
                            (bad (append (subseq without 0 p) (list read) (nthcdr p without)))
                            (errors (event-errors label bad)))
                       (check (some (lambda (s) (search "before fully accepted source action" s)) errors)
                              (format nil "~a query ~d before action event ~d rejects causally"
                                      label index (getf target :seq)))))
                   (multiple-value-bind (o i reordered)
                       (fixture (cons (first queries)
                                      (cons (nth index queries)
                                            (append (subseq queries 1 index) (nthcdr (1+ index) queries))))
                                :test-phase (if (equal label "vt52") "pause-2" "navigate-1"))
                     (declare (ignore o i))
                     (check (null (event-errors label (rechunk-events reordered :input-size 1)))
                            (format nil "~a query ~d immediately after final accepted byte passes" label index)))
                   ;; Start before acceptance but complete after it: completion alone
                   ;; is not evidence that the test caused the request.
                   (let* ((start (copy-list read)) (finish (copy-list read))
                          (bytes (getf read :bytes)) (p (position driver without :test #'eq)))
                     (setf (getf start :bytes) (subseq bytes 0 1)
                           (getf finish :bytes) (subseq bytes 1))
                     (check (some (lambda (s) (search "before fully accepted source action" s))
                                  (event-errors label (append (subseq without 0 p) (list start)
                                                              (subseq without p (1+ (position (car (last accepted)) without :test #'eq)))
                                                              (list finish)
                                                              (nthcdr (1+ (position (car (last accepted)) without :test #'eq)) without))))
                            (format nil "~a query ~d early start with late completion rejected" label index)))))
      ;; Every proper prefix of every supported request must remain pending at EOF.
      (dolist (form (query-forms label))
        (loop for cut from 1 below (length (first form))
              for prefix = (subseq (first form) 0 cut)
              do (check (event-errors label (append events (list (list :kind :wire-out
                                                                       :phase (getf (car (last events)) :phase)
                                                                       :bytes prefix))))
                        (format nil "~a unfinished ~s at EOF rejected" label prefix))
                 (check (some (lambda (s) (search "at normal exit" s))
                              (event-errors label
                                            (append events
                                                    (list (list :kind :wire-out :phase (getf (car (last events)) :phase) :bytes prefix)
                                                          (list :kind :exit :phase (getf (car (last events)) :phase))
                                                          (list :kind :wire-out :phase (getf (car (last events)) :phase)
                                                                :bytes (subseq (first form) cut))))))
                        (format nil "~a unfinished ~s at exit cannot complete after exit" label prefix))))
      (dolist (suffix (list "plain text and padding" (esc "[31m") (esc "[6;1H") (esc "[0K")
                            (esc "[?3h") (esc "#6") (cat (esc "[6") (string #\Can))))
        (check (null (event-errors label (append events (list (list :kind :wire-out
                                                                   :phase (getf (car (last events)) :phase)
                                                                   :bytes suffix)))))
               (format nil "~a complete nonquery/canceled prefix ~s passes" label suffix)))))))
;; The grammar is global, while allowed complete-query inventories are per case.
(dolist (label '("cursor" "reports-da" "reports-dsr" "reports-parameters" "vt52"))
  (let ((queries (second (find label (report-query-cases) :test #'equal :key #'first))))
    (multiple-value-bind (out input events)
        (fixture (or queries (list (first (dsr-queries))))
                 :test-phase (if (equal label "vt52") "pause-2" "navigate-1"))
      (declare (ignore out input))
      (dolist (form (known-query-forms))
        (let ((tail (list :kind :wire-out :phase (getf (car (last events)) :phase) :bytes (first form))))
          (unless (member form (query-forms label) :test #'equal)
            (loop for cut from 1 below (length (first form))
                  do (let ((a (copy-list tail)) (b (copy-list tail)))
                       (setf (getf a :bytes) (subseq (first form) 0 cut)
                             (getf b :bytes) (subseq (first form) cut))
                       (check (some (lambda (s) (search "Query outside source-defined phase" s))
                                    (event-errors label (append events (list a b))))
                              (format nil "~a unexpected known query ~s split ~d rejected by inventory" label (first form) cut)))))
          (loop for cut from 1 below (length (first form))
                for prefix = (subseq (first form) 0 cut)
                do (let ((a (copy-list tail)))
                     (setf (getf a :bytes) prefix)
                     (check (some (lambda (s) (search "Unconsumed query/control prefix at EOF" s))
                                  (event-errors label (append events (list a))))
                            (format nil "~a union prefix ~s EOF rejected" label prefix))
                     (check (some (lambda (s) (search "at normal exit" s))
                                  (event-errors label (append events (list a (list :kind :exit :phase (getf a :phase))))))
                            (format nil "~a union prefix ~s normal exit rejected" label prefix)))))))))
(dolist (name '("pre-navigation/" "unconsumed-partial/"))
  (let ((dir (merge-pathnames name #p".build/evidence/review-checker100/")))
    (when (probe-file dir)
      (check (not (getf (check-directory dir :mode :accept) :pass))
             (format nil "original review100 ~a rejected without modification" name)))))
(format t "FINAL ~d offline analyzer checks passed~%" *checks*)
