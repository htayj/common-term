;; Source-defined attribution is independent of self-consistent event metadata.
(dolist (label '("reports-da" "reports-dsr" "reports-parameters" "vt52"))
  (let* ((startup (first (dsr-queries)))
         (queries (cons startup
                        (cond ((equal label "reports-da") (list startup))
                              ((equal label "reports-dsr") (rest (dsr-queries)))
                              ((equal label "reports-parameters")
                               (list (list (esc "[x") (esc "[2;1;1;112;112;1;0x"))
                                     (list (esc "[1x") (esc "[3;1;1;112;112;1;0x"))))
                              ((equal label "vt52") (list (list (esc "Z") (esc "/Z")))))))
         (phase (if (equal label "vt52") "pause-2" "navigate-1")))
    (multiple-value-bind (out input events) (fixture queries :test-phase phase)
      (check (null (check-events label out input events)) (format nil "~a source phase accepted" label))
      (loop for boundary from 1 below (reduce #'max queries :key (lambda (q) (max (length (first q)) (length (second q)))))
            do (check (null (check-events label out input (rechunk-events events :boundary boundary)))
                      (format nil "~a query/reply boundary ~d accepted" label boundary)))
      (check (null (check-events label out input (rechunk-events events :output-size 1 :input-size 1)))
             (format nil "~a single-byte queries and replies accepted" label)))
    (multiple-value-bind (out input events) (fixture queries :test-phase "startup")
      (check (check-events label out input events) (format nil "~a test queries moved to startup rejected" label)))
    (multiple-value-bind (out input events) (fixture queries :test-phase "invented-test")
      (check (check-events label out input events) (format nil "~a spoofed query phase rejected" label)))))
(multiple-value-bind (out input events) (fixture (dsr-queries))
  (let* ((split (rechunk-events events :output-size 1))
         (first-read (position :wire-out split :key (lambda (e) (getf e :kind))))
         (last-read (+ first-read 3)))
    ;; Move the final startup-query octet after its reply; all wire offsets and
    ;; clocks are recomputed, so rejection must depend on query completion.
    (let* ((final (nth last-read split))
           (bad (remove final split :test #'eq))
           (where (position :wire-in bad :key (lambda (e) (getf e :kind)))))
      (setf bad (append (subseq bad 0 (1+ where)) (list final) (nthcdr (1+ where) bad)))
      (check (check-events "reports-dsr" out input (rechunk-events bad)) "reply before final query byte rejected"))
    (let* ((origin (find :enqueue split :key (lambda (e) (getf e :kind))))
           (bad (remove origin split :test #'eq)))
      (setf bad (append (subseq bad 0 last-read) (list origin) (nthcdr last-read bad)))
      (check (check-events "reports-dsr" out input (rechunk-events bad))
             "reply enqueued before complete query but accepted later rejected"))
    ;; Even a same-name phase transition invalidates a partially assembled query.
    (let ((marker (list :kind :phase :phase "startup")))
      (check (check-events "reports-dsr" out input
                           (rechunk-events (append (subseq split 0 (1+ first-read)) (list marker)
                                                   (nthcdr (1+ first-read) split))))
             "query cannot assemble across phase boundary")))
  (check (check-events "reports-dsr" (subseq out 1) input
                       (rechunk-events (remove (second events) events :test #'eq)))
         "query fragment from another case cannot supply startup inventory"))
(let ((base #p".build/evidence/review-harness96/"))
  (dolist (name '("duplicate-result/" "wrong-query-phase/"))
    (let ((dir (merge-pathnames name base)))
