                   :attempted ("reports-dsr" "reports-da") :completed ("reports-dsr" "reports-da")))
    (check (not (getf (check-directory dir :mode :accept) :pass)) "duplicate result cannot cover missing DA case")
    (delete-file (merge-pathnames "reports-da.result.sexp" dir)))
  (complete-fixture dir)
  (rename-file (merge-pathnames "reports-dsr.result.sexp" dir) (merge-pathnames "reports-da.result.sexp" dir))
  (let ((errors (getf (check-directory dir :mode :accept) :errors)))
    (check (some (lambda (e) (search "filename/label mismatch" e)) errors)
           "unique expected label in wrong filename rejected"))
  (delete-file (merge-pathnames "reports-da.result.sexp" dir))
  (complete-fixture dir)
  (let ((r (read-value (merge-pathnames "reports-dsr.result.sexp" dir))))
    (setf (getf r :path) '(6 4))
    (write-value (merge-pathnames "reports-dsr.result.sexp" dir) r)
    (check (not (getf (check-directory dir :mode :accept) :pass)) "metadata cannot redefine source case path"))
  (complete-fixture dir)
  (dolist (field '(:expected :attempted :completed))
    (let ((inventory (read-value (merge-pathnames "inventory.sexp" dir))))
      (setf (getf inventory field) '("reports-dsr" "reports-dsr"))
      (write-value (merge-pathnames "inventory.sexp" dir) inventory)
      (check (not (getf (check-directory dir :mode :accept) :pass)) (format nil "duplicate ~s inventory rejected" field)))
    (complete-fixture dir))
  (let ((r (read-value (merge-pathnames "reports-dsr.result.sexp" dir))))
    (setf (getf r :label) "invented-case" (getf r :path) '(6 3))
    (write-value (merge-pathnames "reports-dsr.result.sexp" dir) r)
    (check (not (getf (check-directory dir :mode :accept) :pass)) "spoofed result catalog rejected"))
  (complete-fixture dir)
  (let* ((path (merge-pathnames "reports-dsr.events.sexp" dir)) (events (read-values path)))
    ;; Every query and reply byte boundary, then all single-byte reads/writes.
    (loop for boundary from 1 below 7
          do (write-events path (rechunk-events events :boundary boundary))
             (check (getf (check-directory dir :mode :accept) :pass)
                    (format nil "complete fixture split at byte boundary ~d accepted" boundary)))
    (write-events path (rechunk-events events :output-size 1 :input-size 1))
    (check (getf (check-directory dir :mode :accept) :pass) "single-byte queries and partial reply writes accepted")
    (write-events path events))
  (dolist (code '(1 127))
    (write-value (merge-pathnames "reports-dsr.exit" dir) code)
    (check (not (getf (check-directory dir :mode :accept) :pass)) (format nil "complete recorder nonzero exit~d rejected" code)))
  (delete-file (merge-pathnames "reports-dsr.exit" dir))
  (check (not (getf (check-directory dir :mode :accept) :pass)) "complete recorder missing exit rejected")
  (write-value (merge-pathnames "reports-dsr.exit" dir) 0)
  (let ((r (read-value (merge-pathnames "reports-dsr.result.sexp" dir))))
    (setf (getf (getf r :status) :process-state) :running)
    (write-value (merge-pathnames "reports-dsr.result.sexp" dir) r)
    (check (not (getf (check-directory dir :mode :accept) :pass)) "nonexited PTY rejected")
    (setf (getf (getf r :status) :process-state) :exited (getf r :failure) "loop exhausted")
    (write-value (merge-pathnames "reports-dsr.result.sexp" dir) r)
    (check (not (getf (check-directory dir :mode :accept) :pass)) "loop exhaustion rejected"))
  (complete-fixture dir)
  (uiop:run-program (list "convert" "-size" "320x384" "xc:black" (namestring (merge-pathnames "001-reports-dsr-pause01.png" dir))))
  (check (not (getf (check-directory dir :mode :accept) :pass)) "wrong screenshot geometry rejected")
  (complete-fixture dir)
  (delete-file (merge-pathnames "001-reports-dsr-pause01.png" dir))
  (check (not (getf (check-directory dir :mode :accept) :pass)) "missing expected capture rejected"))
