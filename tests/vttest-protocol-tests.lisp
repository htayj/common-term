;; Keyboard fixtures exercise all modes, per-key ownership, and exact bytes.
(defun keyboard-fixture (label &optional wrong)
  (multiple-value-bind (out input events) (fixture (list (list (esc "[0c") (esc "[?1;2c"))))
    (let ((seq (length events)) (time 1) (phase "startup"))
      (labels ((e (kind &rest args)
                 (setf events (append events (list (append (list :seq (incf seq) :kind kind :phase phase :time (incf time 1/100)
                                                               :out (length out) :in (length input)) args))))))
        (dotimes (p (if (string= label "keyboard-cursor") 3 4))
          (setf phase (format nil "keys-~d" p)) (e :phase)
          (loop for key in (append (if (string= label "keyboard-cursor") '("Up" "Down" "Left" "Right") '("KP_1" "KP_2" "KP_Enter")) '("Tab"))
                for bytes in (append (expected-key-byte-list label p) (list (string #\Tab)))
                do (when (and wrong (= p 1) (not (string= key "Tab"))) (setf bytes "1"))
                   (e :key-begin :key key) (e :enqueue :source :input :bytes bytes)
                   (e :wire-in :source :input :bytes bytes :end (+ (length input) (length bytes)))
                   (setf input (cat input bytes)) (e :key-end :key key)))
        (check-events label out input events)))))
(check (null (keyboard-fixture "keyboard-cursor")) "normal/application/VT52 arrows exact per-key")
(check (null (keyboard-fixture "keyboard-keypad")) "ANSI/VT52 numeric/application keypad exact per-key")
(check (keyboard-fixture "keyboard-keypad" t) "numeric bytes in application keypad phase fail")
;; Legacy evidence is immutable measurement, not retrospectively phase-attributed.
(let* ((base #p".build/evidence/")
       (x (merge-pathnames "vttest-x11.soyWA3/" base))
       (w (merge-pathnames "vttest-wayland.4pz8fm/" base))
       (keys (merge-pathnames "vttest-wayland.P7So6b/" base)))
  (when (every #'probe-file (list x w keys))
    (dolist (dir (list x w))
      (let ((report (report-measurement dir)))
        (check (and (getf report :dsr5-terminal-ok) (= 2 (getf report :cpr5-1-count))
                    (= 2 (getf report :primary-da-count-including-startup))
                    (not (getf report :parameter-report2-present)) (not (getf report :parameter-report3-present)))
               (format nil "legacy report measurement reproduced ~a" dir)))
      (check (not (getf (check-directory dir :mode :accept) :pass)) (format nil "legacy acceptance rejected ~a" dir)))
    (let* ((xkeys (wire (merge-pathnames "keyboard-keypad.input.raw" x)))
           (wkeys (wire (merge-pathnames "keyboard-keypad.input.raw" keys)))
           (arrows (wire (merge-pathnames "keyboard-cursor.input.raw" keys))))
      (check (and (not (search "12" xkeys)) (= 4 (nocc (format nil "12~c" #\Return) wkeys))
                  (= 2 (nocc (esc "OA") arrows)) (not (search (esc "A") arrows)))
             "legacy X11/native keypad and VT52 arrow gaps reproduced"))))
(format t "~d offline analyzer checks passed~%" *checks*)
;; A complete synthetic recorder fixture proves acceptance is reachable, then
;; corruptions prove it is fail-closed. The PNG is generated offline, not a
;; screenshot or an application-conformance claim.
(defun complete-fixture (dir)
  (ensure-directories-exist (merge-pathnames "placeholder" dir))
  (let ((out "") (input "") (events nil) (phase "startup") (seq 0) (time 0)
        (name "001-reports-dsr-pause01"))
    (labels ((e (kind &rest fields)
               (push (append (list :kind kind :seq (incf seq) :time (incf time 1/100)
                                   :phase phase :out (length out) :in (length input)) fields) events))
             (p (name) (setf phase name) (e :phase))
             (o (bytes) (e :wire-out :end (+ (length out) (length bytes)) :bytes bytes) (setf out (cat out bytes)))
             (i (bytes source) (e :enqueue :bytes bytes :source source)
                (e :wire-in :end (+ (length input) (length bytes)) :bytes bytes :source source)
                (setf input (cat input bytes)))
             (d (bytes) (e :driver :bytes bytes) (i bytes :input)))
      (p "startup") (o (esc "[0c")) (i (esc "[?1;2c") :reply)
      (p "navigate-0") (d (format nil "6~c" #\Return)) (o "Terminal Reports/Responses Enter choice number")
      (p "navigate-1") (d (format nil "3~c" #\Return))
      (dolist (q (rest (dsr-queries))) (o (first q)) (i (second q) :reply))
      (o "Test of Device Status Report 5 Push <RETURN>")
      (p "pause-1")
      (let* ((s (list :frames 2 :bytes-received (length out) :columns 80 :rows 24 :backend :x11 :error-count 0))
             (b (list :target-output (length out) :before-frame 1 :status s :native-ack-output -1)))
        (write-value (merge-pathnames (cat name ".status.sexp") dir) s)
        (write-value (merge-pathnames (cat name ".barrier.sexp") dir) b)
        (with-open-file (s (merge-pathnames (cat name ".grid.txt") dir) :direction :output :if-exists :supersede)
          (write-string "Test of Device Status Report 5 Push <RETURN>" s))
        (with-open-file (s (merge-pathnames (cat name ".dimensions.txt") dir) :direction :output :if-exists :supersede)
          (write-string "expected=640x384 actual=640x384 fixture=synthetic" s))
        (uiop:run-program (list "convert" "-size" "640x384" "xc:black" (namestring (merge-pathnames (cat name ".png") dir))))
        (e :capture :name name :barrier b))
      (d (string #\Return)) (o "Terminal Reports/Responses Enter choice number")
      (p "return-main") (d (format nil "0~c" #\Return)) (o "Test of cursor movements Enter choice number")
      (p "exit") (d (format nil "0~c" #\Return)) (e :exit)
      (dolist (pair (list (list "reports-dsr.transcript.raw" out) (list "reports-dsr.input.raw" input)))
        (with-open-file (s (merge-pathnames (first pair) dir) :direction :output :if-exists :supersede :element-type '(unsigned-byte 8))
          (write-sequence (map 'vector #'char-code (second pair)) s)))
      (with-open-file (s (merge-pathnames "reports-dsr.events.sexp" dir) :direction :output :if-exists :supersede)
        (dolist (e (reverse events)) (write e :stream s) (terpri s)))
      (write-value (merge-pathnames "reports-dsr.result.sexp" dir)
                   '(:label "reports-dsr" :path (6 3) :returned-to-menu t :inventory-ok t :pauses 1 :captures 1 :expected-captures 1
                     :errors nil :status (:error-count 0 :process-state :exited :transport-state :hangup :input-pending 0)))
      (write-value (merge-pathnames "reports-dsr.exit" dir) 0)
      (write-value (merge-pathnames "finished.sexp" dir) '(:recorder-version 2 :captures 1))
      (write-value (merge-pathnames "inventory.sexp" dir)
                   '(:recorder-version 2 :expected ("reports-dsr") :attempted ("reports-dsr") :completed ("reports-dsr"))))))
(defun rechunk-events (events &key (output-size nil) (input-size nil) (boundary nil))
  "Rebuild arbitrary read/accepted-write chunks without changing either wire.
BOUNDARY splits each event once; SIZE chunks it repeatedly, including size one."
  (let ((out 0) (input 0) (seq 0) (time 0) (result nil))
    (dolist (event events (nreverse result))
      (let* ((kind (getf event :kind)) (bytes (getf event :bytes))
             (size (case kind (:wire-out output-size) (:wire-in input-size)))
             (chunks (if (and (member kind '(:wire-out :wire-in)) (or size boundary))
                         (if size
                             (loop for i from 0 below (length bytes) by size
                                   collect (subseq bytes i (min (length bytes) (+ i size))))
                             (if (< boundary (length bytes))
                                 (list (subseq bytes 0 boundary) (subseq bytes boundary)) (list bytes)))
                         (list bytes))))
        (dolist (chunk chunks)
          (let ((e (copy-list event)))
            (setf (getf e :seq) (incf seq) (getf e :time) (incf time 1/100)
                  (getf e :out) out (getf e :in) input)
            (case kind
              (:wire-out (setf (getf e :bytes) chunk (getf e :end) (incf out (length chunk))))
              (:wire-in (setf (getf e :bytes) chunk (getf e :end) (incf input (length chunk)))))
            (push e result)))))))
(defun write-events (path events)
  (with-open-file (s path :direction :output :if-exists :supersede)
    (dolist (event events) (write event :stream s) (terpri s))))
(let* ((root (uiop:ensure-directory-pathname (or (uiop:getenv "LISPTERM_HARNESS_TEST_ARTIFACTS") ".build/evidence/vttest-harness85/fixtures/")))
