;;;; Standalone offline fixtures. No application, GUI, vttest, or protected process.
(load (merge-pathnames "vttest-protocol.lisp" *load-truename*))
(in-package #:vttest-check)
(defparameter *checks* 0)
(defun check (truth name)
  (unless truth (error "FAILED: ~a" name)) (incf *checks*) (format t "PASS ~a~%" name))
(defun signals-error-p (thunk) (handler-case (progn (funcall thunk) nil) (error () t)))
(defun fixture (queries &key replies (source :reply) (phase-corrupt nil) (late nil) (test-phase "navigate-1"))
  (let ((events nil) (out "") (input "") (seq 0) (time 0) (phase "startup"))
    (labels ((e (kind &rest args)
               (push (append (list :seq (incf seq) :kind kind :phase phase :time (incf time 1/100)
                                   :out (length out) :in (length input)) args) events))
             (o (bytes) (e :wire-out :bytes bytes :end (+ (length out) (length bytes))) (setf out (cat out bytes)))
             (i (bytes) (e :enqueue :source source :bytes bytes)
                        (e :wire-in :source source :bytes bytes :end (+ (length input) (length bytes)))
                        (setf input (cat input bytes))))
      (e :phase)
      (loop for q in queries for r in (or replies (mapcar #'second queries)) for index from 0
            do (when (= index 1)
                 (setf phase test-phase) (e :phase)
                 (let ((bytes (if (equal test-phase "pause-2") (string #\Return)
                                  (format nil "~d~c" (cond ((equal (first q) (esc "[c")) 4)
                                                           ((equal (first q) (esc "[0c")) 4)
                                                           ((find #\x (first q)) 7) (t 3)) #\Return))))
                   (e :driver :bytes bytes) (e :enqueue :source :input :bytes bytes)
                   (e :wire-in :source :input :bytes bytes :end (+ (length input) (length bytes)))
                   (setf input (cat input bytes))))
               (o (first q))
               (when phase-corrupt (setf phase "wrong-phase"))
               (when late (incf time 10))
               (when r (i r)))
      (values out input (nreverse events)))))
(defun dsr-queries ()
  (list (list (esc "[0c") (esc "[?1;2c")) (list (esc "[5n") (esc "[0n"))
        (list (esc "[6n") (esc "[5;1R")) (list (esc "[6n") (esc "[5;1R"))))
(defun fixture-errors (&rest args)
  (multiple-value-bind (out input events) (apply #'fixture (dsr-queries) args)
    (check-events "reports-dsr" out input events)))
(check (null (fixture-errors)) "exact DSR/CPR/startup DA with both wire directions")
(check (fixture-errors :replies (list (esc "[?1;2c") (esc "[1n") (esc "[5;1R") (esc "[5;1R"))) "wrong reply rejected")
(check (fixture-errors :replies (list (esc "[?1;2c") nil (esc "[5;1R") (esc "[5;1R"))) "missing reply rejected")
(check (fixture-errors :replies (list (cat (esc "[?1;2c") (esc "[?1;2c")) (esc "[0n") (esc "[5;1R") (esc "[5;1R"))) "duplicate reply rejected")
(check (fixture-errors :source :input) "driver/native source cannot impersonate replies")
(check (fixture-errors :phase-corrupt t) "phase identity corruption rejected")
(check (fixture-errors :late t) "reply deadline corruption rejected")
(multiple-value-bind (out input events) (fixture (dsr-queries))
  (let ((bad (copy-tree events)))
    (incf (getf (second bad) :out))
    (check (check-events "reports-dsr" out input bad) "wire offset corruption rejected"))
  (check (check-events "reports-dsr" out input (butlast events)) "truncated event inventory rejected")
  (check (check-events "reports-dsr" (cat out "corrupt") input events) "unrecorded PTY output rejected")
  (let ((bad (copy-tree events)))
    (setf (getf (third bad) :source) :input)
    (check (check-events "reports-dsr" out input bad) "enqueue/source corruption rejected")))
(multiple-value-bind (out input events) (fixture (list (first (dsr-queries))))
  (check (check-events "reports-dsr" out input events) "missing test-query inventory rejected"))
(let ((good (list :returned-to-menu t :inventory-ok t :status
                  '(:error-count 0 :process-state :exited :transport-state :hangup :input-pending 0))))
  (check (case-complete-p good 0) "normal exit and hangup accepted")
  (dolist (code '(nil 1 127)) (check (not (case-complete-p good code)) (format nil "missing/nonzero exit ~s rejected" code))))
(let* ((root (uiop:ensure-directory-pathname (or (uiop:getenv "LISPTERM_HARNESS_TEST_ARTIFACTS") ".build/evidence/vttest-harness85/fixtures/")))
       (dir (merge-pathnames "empty/" root)))
  (ensure-directories-exist (merge-pathnames "placeholder" dir))
