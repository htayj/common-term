(defpackage #:lispterm.alternate-charset-policy-tests
  (:use #:cl #:nerimux/terminal/types #:nerimux/terminal/emulator)
  (:export #:run-alternate-charset-policy-tests))
(in-package #:lispterm.alternate-charset-policy-tests)

(defvar *checks* 0)
(defun check (truth label)
  (incf *checks*)
  (assert truth () "Alternate charset policy: ~A" label))

(defun bounded-profile (screen)
  (check (and (not (screen-vt52-mode screen))
              (not (screen-vt52-graphics screen))
              (not (screen-insert-mode screen))
              (not (screen-pending-wrap screen))
              (null (screen-single-shift screen))
              (= (screen-cursor-y screen) 0)
              (< (screen-cursor-x screen) 40)
              (zerop (hash-table-count (screen-line-sizes screen))))
         "ANSI, one row, single-width, no insert/wrap/single shift")
  (check (loop for cell across (screen-cells screen)
               always (and (= (cell-width cell) 1) (null (cell-combining cell))))
         "no wide or combining cells"))

(defun feed (screen octets &key (start 0) (end (length octets)))
  (bounded-profile screen)
  (check (loop for i from start below end always (< (aref octets i) 128))
         "seven-bit input, no UTF8")
  (screen-process-bytes screen octets :start start :end end)
  (bounded-profile screen))

(defun shift-to (screen bank)
  (feed screen (vector (ecase bank (:g0 15) (:g1 14)))))
(defun designate (screen bank final)
  (feed screen (vector 27 (ecase bank (:g0 40) (:g1 41)) final)))
(defun bank-value (screen bank)
  (ecase bank (:g0 (screen-g0-charset screen)) (:g1 (screen-g1-charset screen))))
(defun other-bank (bank) (ecase bank (:g0 :g1) (:g1 :g0)))
(defun bank-final (charset)
  (ecase charset (:dec-graphics 48) (:british 65)))

(defun print-codes (screen input expected)
  (let ((x (screen-cursor-x screen)))
    (feed screen input)
    (check (= (screen-cursor-x screen) (+ x (length expected))) "cursor advance")
    (loop for code across expected for column from x
          do (check (= code (char-code (cell-char (screen-cell screen column 0))))
                    "source-backed literal cell codepoint"))))

(defun prove-non-ascii (screen charset)
  (ecase charset
    (:dec-graphics (print-codes screen #(113 96 95) #(#x2500 #x25c6 32)))
    (:british (print-codes screen #(35) #(#xa3)))))

(defun visible-state (screen)
  ;; The parser continuation may change while an incomplete SCS has no visible effect.
  (list (screen-cursor-x screen) (screen-cursor-y screen)
        (screen-g0-charset screen) (screen-g1-charset screen)
        (screen-active-g screen) (screen-charset screen)
        (loop for cell across (screen-cells screen)
              collect (list (char-code (cell-char cell)) (cell-width cell)
                            (cell-combining cell) (cell-fg cell) (cell-bg cell)
                            (cell-attrs cell) (cell-attrs2 cell) (cell-ul-color cell)
                            (cell-hyperlink cell)))))

(defun select-in-chunks (screen bank final chunks)
  ;; Poison outside the actual slices makes :START/:END observable. No concatenation.
  (let ((bytes (vector 255 27 (ecase bank (:g0 40) (:g1 41)) final 255))
        (before (visible-state screen))
        (offset 1))
    (dolist (size chunks)
      (feed screen bytes :start offset :end (+ offset size))
      (incf offset size)
      (when (< offset 4)
        (check (equalp before (visible-state screen)) "incomplete SCS is invisible")
        (check (functionp (screen-parser screen)) "saved CPS continuation")))
    (check (= offset 4) "complete three-octet selection")))

(defun replacement-case (final bank prior active chunks)
  (let* ((screen (make-screen 80 1))
         (other (other-bank bank))
         (sentinel (ecase prior (:dec-graphics :british) (:british :dec-graphics)))
         (invoked (if active bank other)))
    (designate screen bank (bank-final prior))
    (designate screen other (bank-final sentinel))
    (shift-to screen bank)
    (prove-non-ascii screen prior)
    (shift-to screen other)
    (prove-non-ascii screen sentinel)
    (shift-to screen invoked)
    (check (eq (bank-value screen bank) prior) "established target prior")
    (check (eq (bank-value screen other) sentinel) "established distinct sentinel")
    (select-in-chunks screen bank final chunks)
    ;; Observe designation/invocation before subsequent print or locking shift.
    (check (eq (bank-value screen bank) :ascii) "alternate replaces selected bank")
    (check (eq (bank-value screen other) sentinel) "other bank preserved")
    (check (eq (screen-active-g screen) invoked) "designation does not invoke")
    (check (eq (screen-charset screen) (if active :ascii sentinel))
           "effective mapping changes only for active target")
    (shift-to screen bank)
    (print-codes screen #(113 96 95 35) #(113 96 95 35))
    (shift-to screen other)
    (prove-non-ascii screen sentinel)
    (shift-to screen bank)
    (print-codes screen #(113 96 95 35) #(113 96 95 35))
    (check (eq (bank-value screen bank) :ascii) "alternate survives bank round trip")))

(defun standard-and-del-case (bank final expected)
  (let ((screen (make-screen 80 1)))
    (designate screen bank final)
    (shift-to screen bank)
    (print-codes screen #(113 96 95 35) expected)
    (print-codes screen #(113) (vector (aref expected 0)))
    (let ((before (visible-state screen)))
      (feed screen #(127))
      (check (equalp before (visible-state screen)) "DEL makes no cell or cursor change"))
    (print-codes screen #(35) (vector (aref expected 3)))))

(defun run-alternate-charset-policy-tests ()
  "Exercise actual ANSI feed, CPS SCS, banks and cells against DEC/xterm literals."
  (let ((*checks* 0) (cases 0))
    (dolist (final '(49 50))
      (dolist (bank '(:g0 :g1))
        (dolist (prior '(:dec-graphics :british))
          (dolist (active '(nil t))
            (dolist (chunks '((3) (1 2) (2 1) (1 1 1)))
              (replacement-case final bank prior active chunks)
              (incf cases))))))
    (dolist (bank '(:g0 :g1))
      (loop for final in '(66 65 48 49 50)
            for expected in '(#(113 96 95 35) #(113 96 95 163)
                              #(#x2500 #x25c6 32 35) #(113 96 95 35) #(113 96 95 35))
            do (standard-and-del-case bank final expected) (incf cases)))
    (format t "~D focused checks PASS in ~D cases; zero failures.~%" *checks* cases)
    (values *checks* cases)))
