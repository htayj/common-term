(defun run-case (name &key dirty cursor extra mutation geometry-pending)
  (let* ((vttest-screen-recorder::*session*
           (list :frames 27 :invalidations 0 :dirty dirty :cursor-pending cursor :forced nil
                 :generation (if geometry-pending 6 5) :geometry (geometry 5)
                  :geometry-pending geometry-pending :lock (sb-thread:make-mutex)))
         (vttest-screen-recorder::*calls* 0)
         (vttest-screen-recorder::*extra* extra)
         (vttest-screen-recorder::*art* (merge-pathnames (format nil "~a/" name) *artifacts*))
         (vttest-screen-recorder::*receipt*
           (list :version 3 :backend :x11 :pause 12 :owned t :capture-count 0
                 :scale 1 :width 640 :height 384 :window-id 42)))
    (when mutation (setf (getf vttest-screen-recorder::*receipt* (first mutation)) (second mutation)))
    (ensure-directories-exist vttest-screen-recorder::*art*)
    (let ((result (handler-case
                      (catch 'vttest-screen-recorder::authorized
                        (vttest-screen-recorder::capture-hold vttest-screen-recorder::*session* 12 nil))
                    (error (e) (format t "~a refused: ~a~%" name e) :refused))))
      (check name (if (or extra mutation)
                      (and (eq result :refused)
                           (not (probe-file (vttest-screen-recorder::path "pause-12-go"))))
                      (and (eq result :authorized)
                           (probe-file (vttest-screen-recorder::path "pause-12-go"))
                           (= 1 (getf vttest-screen-recorder::*session* :invalidations))
                           (= (if (or dirty cursor geometry-pending) 29 28)
                              (getf vttest-screen-recorder::*session* :frames))))))))
(run-case "pending-geometry-same-80x24" :geometry-pending t)
(run-case "pending-dirty" :dirty t)
(run-case "pending-cursor" :cursor t)
(run-case "extra-frame" :extra t)
(loop for mutation in '((:pause 11) (:pause 13) (:window-id 43) (:version 2)
                       (:capture-count 1) (:owned nil))
      for i from 0 do (run-case (format nil "receipt-~d" i) :mutation mutation))
(let ((s (list :frames 27 :generation 5 :geometry (geometry 5) :lock (sb-thread:make-mutex))))
  (flet ((quiet (status) (getf (vttest-screen-recorder::render-state s
                      (append status (list :engine-geometry-generation 5 :geometry (geometry 5))))
                  :render-quiescent)))
    (check :quiescent (quiet '(:frames 27)))
    (check :frame-mismatch (not (quiet '(:frames 26))))
    (dolist (key '(:dirty :forced :cursor-pending))
      (setf (getf s key) t)
      (check key (not (quiet '(:frames 27))))
      (setf (getf s key) nil))))
(let* ((s (list :frames 27 :generation 6 :geometry (geometry 6)
                :lock (sb-thread:make-mutex)))
       (st (lispterm::status s)))
  (flet ((quiet (status) (getf (vttest-screen-recorder::render-state s status)
                              :render-quiescent)))
    (check :generation-6 (quiet st))
    (setf (getf st :geometry) (geometry 5))
    (check :stale-request-same-dimensions (not (quiet st)))
    (setf (getf st :geometry) (geometry 6) (getf st :engine-geometry-generation) 5)
    (check :status-generation-drift (not (quiet st)))
    (setf (getf st :engine-geometry-generation) 6 (getf s :generation) 7)
    (check :live-generation-drift (not (quiet st)))
    (setf (getf s :generation) 6 (getf (getf s :geometry) :window-id) 43)
    (check :publication-drift (not (quiet st)))
    (setf (getf st :geometry) (geometry nil))
    (check :missing-request (not (quiet st)))))
(format t "Render quiescence: ~d checks passed.~%" *checks*)
