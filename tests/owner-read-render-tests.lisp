;;;; Production scheduling regression controls; device boundaries simulated.
(in-package #:lispterm.owner.tests)
(let* ((*checks* 0) (now 0) (events nil) (read-bytes nil) (read-count 0)
       (draws 0) (cursors 0) (presents 0) (writes nil) (last-grid nil)
       (session (lispterm::make-session nil 2 8))
       (display (ltd::make-display :owner sb-thread:*current-thread*))
       (host (lispterm::%make-host :session session :display display :state :attached))
       (schedule (lispterm::make-owner-schedule))
       (real-render (symbol-function 'lispterm::render-session))
       (lispterm::*owner-clock* (lambda () now)))
  (setf (lispterm::session-pty session) (lispterm.pty::%make-pty :open-p nil))
  (with-functions
   (list
    (cons 'lispterm.pty:pty-read
          (lambda (&rest args) (declare (ignore args)) (incf read-count)
            (prog1 read-bytes (setf read-bytes nil))))
    (cons 'lispterm.pty:pty-process (lambda (&rest args) (declare (ignore args)) nil))
    (cons 'lispterm.pty:pty-write
          (lambda (pty bytes &key timeout) (declare (ignore pty timeout))
            (push (copy-seq bytes) writes) (length bytes)))
    (cons 'lispterm.pty:pty-resize (lambda (&rest args) (declare (ignore args))))
    (cons 'lispterm::window-geometry-intent (lambda (&rest args) (declare (ignore args))))
    (cons 'ltd:poll-events (lambda (&rest args) (declare (ignore args))
                           (prog1 events (setf events nil))))
    (cons 'ltd:geometry-tick (lambda (&rest args) (declare (ignore args))))
    (cons 'ltd:geometry-status (lambda (&rest args) (declare (ignore args))))
    (cons 'ltd:display-metrics (lambda (&rest args) (declare (ignore args))))
    (cons 'ltd:set-title (lambda (&rest args) (declare (ignore args))))
    (cons 'ltd:draw-frame (lambda (d grid &rest args) (declare (ignore d args))
                          (incf draws) (setf last-grid grid)))
    (cons 'ltd:set-cursor (lambda (&rest args) (declare (ignore args)) (incf cursors)))
    (cons 'ltd:present (lambda (&rest args) (declare (ignore args)) (incf presents)))
    ;; Keep actual renderer logic, supplying its documented deterministic NOW.
    (cons 'lispterm::render-session
          (lambda (s d &rest args) (declare (ignore args))
            (funcall real-render s d :now (/ now internal-time-units-per-second))))
    (cons 'ltd:close-display (lambda (&rest args) (declare (ignore args)))))
   (lambda ()
     (flet ((tick () (lispterm::owner-iteration host schedule))
            (ms (n) (* n (/ internal-time-units-per-second 1000))))
       (tick)
       (check :actual-render-initial-frame (= draws 1))
       (setf now (ms 100) read-bytes (lispterm::utf8 "A")
             events (list (ltd:make-key-event :key #\x)) read-count 0)
       (tick)
       (format t "~S~%" (list :probe :read-count read-count :backoff (lispterm::owner-schedule-io-backoff schedule) :errors (lispterm:host-errors host)))
       (check :actual-read-one-chunk (= read-count 1))
       (check :actual-event-flush-same-turn (equalp (first writes) (lispterm::utf8 "x")))
       (check :actual-feed-render-same-idle-turn (= draws 2))
       (check :exact-fed-cell-drawn (eql #\A (ltd:cell-char (aref last-grid 0 0))))
       (setf now (ms 200))
       (tick)
       (check :actual-clean-no-redundant-present (= presents 2))
       (check :actual-clean-no-redundant-draw (= draws 2))
       ;; Cursor-only control through the real renderer after clean output.
       (setf (lispterm::session-last-cursor session) nil)
       (tick)
       (check :actual-cursor-only-present (= cursors 1))
       (check :actual-cursor-only-no-grid-draw (= draws 2))
       ;; Feed a blinking visible character. Deadline and phase use virtual time.
       (setf now (ms 300)
             read-bytes (lispterm::utf8 (format nil "~C[5mB" #\Escape)))
       (tick)
       (check :actual-blink-enabled (lispterm::session-blink-visible session))
       (check :actual-blink-deadline (= (lispterm::session-next-blink session) 4/5))
       (setf now (ms 799))
       (let ((wait (tick))) (check :actual-nearest-blink-wait (= wait 1/1000)))
       (setf now (ms 800))
       (tick)
       (check :actual-blink-toggled (= 1 (lispterm::session-blink-toggles session)))
       (check :actual-blink-phase (not (lispterm::session-blink-phase session)))
       ;; Resize remains an owner session operation and forces a complete frame.
       (setf now (ms 900))
       (lispterm::session-resize session 3 10)
       (tick)
       (check :actual-resize-projection (equal (array-dimensions last-grid) '(3 10)))
       (check :actual-resize-force-consumed (null (lispterm::session-force-frame session)))
       (setf events (list (ltd:make-close-event)))
       (tick)
       (check :close-event-detaches (eq (lispterm::host-state-value host) :detached))
       (check :close-event-clears-display (null (lispterm::host-display host)))
       (check :no-recorded-errors (null (lispterm:host-errors host))))))
  (format t "~D real-path controls passed.~%" *checks*))
