;;;; Production owner policy, with deterministic device boundaries.
(defpackage #:lispterm.owner.tests (:use #:cl) (:export #:run))
(in-package #:lispterm.owner.tests)

(defvar *checks* 0)
(defun check (name value)
  (incf *checks*)
  (format t "~S~%" (list :check name :pass (not (null value))))
  (unless value (error "Owner scheduling control failed: ~S" name)))

(defun with-functions (bindings thunk)
  "Replace boundary functions only, restoring even after a failing assertion."
  (let ((saved (mapcar (lambda (binding)
                         (cons (car binding) (symbol-function (car binding)))) bindings)))
    (unwind-protect
         (progn
           (dolist (binding bindings) (setf (symbol-function (car binding)) (cdr binding)))
           (funcall thunk))
      (dolist (binding saved) (setf (symbol-function (car binding)) (cdr binding))))))


(defun run ()
(let* ((now 0) (log nil) (events nil) (written nil) (dirty t)
       (output nil) (read-error nil) (poll-error nil) (close-error nil)
       (checks 0) (failures 0) (read-cost 0)
       (session (lispterm::make-session nil 2 8))
       (host (lispterm::%make-host :session session :display :fake :state :attached))
       (schedule (lispterm::make-owner-schedule))
       (lispterm::*owner-clock* (lambda () now)))
  (flet ((verify (name value)
           (incf checks) (unless value (incf failures))
           (format t "~S~%" (list :check name :pass (not (null value))))))
    (with-functions
     (list
      (cons 'lispterm::session-read-output
            (lambda (s)
              (push :read log)
              (when read-error (error "Injected read failure"))
              (lispterm::session-flush-input s)
              (incf now read-cost)
              (when (and (vectorp output) (plusp (length output))) (setf dirty t))
              output))
      (cons 'lispterm.pty:pty-write
            (lambda (pty bytes &key timeout)
              (declare (ignore pty timeout))
              (push :write log) (push (copy-seq bytes) written) (length bytes)))
      (cons 'lispterm::window-geometry-intent (lambda (&rest x) (declare (ignore x))))
      (cons 'ltd:poll-events
            (lambda (&rest x)
              (declare (ignore x)) (push :poll log)
              (when poll-error (error "Injected poll failure"))
              (prog1 events (setf events nil))))
      (cons 'ltd:geometry-tick (lambda (&rest x) (declare (ignore x))))
      (cons 'ltd:geometry-status (lambda (&rest x) (declare (ignore x))))
      (cons 'ltd:display-metrics (lambda (&rest x) (declare (ignore x))))
      (cons 'lispterm::render-session
            (lambda (s d &key now)
              (declare (ignore d now)) (push :render-check log)
              (when dirty (push :draw log) (incf (lispterm::session-frames s)) (setf dirty nil))))
      (cons 'lispterm::window-close
            (lambda (h)
              (push :close log)
              (when close-error (error "Injected close failure"))
              (setf (lispterm::host-display h) nil)
              (lispterm::set-host-state h :detached))))
     (lambda ()
       (flet ((tick () (lispterm::owner-iteration host schedule))
              (ms (n) (* n (/ internal-time-units-per-second 1000))))
         (setf events (list (ltd:make-key-event :key #\x)))
         (tick)
         (verify :same-iteration-key-pty-flush (equalp written (list (lispterm::utf8 "x"))))
         (verify :initial-frame-drawn (= 1 (lispterm::session-frames session)))
         (setf now (ms 1) log nil events (list (ltd:make-key-event :key #\y)))
         (tick)
         (verify :input-independent-of-frame-deadline (null events))
         (verify :second-key-written (equalp (first written) (lispterm::utf8 "y")))
         (verify :one-read-per-turn (= 1 (count :read log)))
         (verify :no-warm-redraw (= 1 (lispterm::session-frames session)))
         (setf now (ms 15) log nil)
         (let ((wait (tick)))
           (verify :nearest-deadline-wait (and (> wait 0) (< wait .002))))
         (setf now (ms 40) dirty t log nil)
         (tick)
         (verify :idle-output-immediate (member :draw log))
         (setf now (ms 41) dirty t log nil)
         (tick)
         (verify :burst-coalesced (not (member :draw log)))
         (setf now (lispterm::owner-schedule-next-frame schedule) log nil)
         (tick)
         (verify :newest-dirty-frame-at-deadline (member :draw log))
         ;; A small overrun advances the old phase, not NOW+period.
         (let* ((old (lispterm::owner-schedule-next-frame schedule))
                (period (/ internal-time-units-per-second 60)))
           (setf now (+ old (ms 2)) dirty t)
           (tick)
           (verify :no-quantization-drift
                   (= (lispterm::owner-schedule-next-frame schedule) (+ old period))))
         ;; Deadline is checked after read work, not before it.
         (setf now (- (lispterm::owner-schedule-next-frame schedule) (ms 1))
               read-cost (ms 2) dirty t log nil)
         (tick)
         (verify :post-work-deadline-sample (member :draw log))
         (setf read-cost 0 output #(65) log nil events (list (ltd:make-key-event :key #\z)))
         (verify :backlog-repoll-without-sleep (zerop (tick)))
         (verify :output-load-input-fairness
                 (and (member :poll log) (member :write log) (= 1 (count :read log))))
         (setf output :eof)
         (tick)
         (verify :eof-backoff (= (lispterm::owner-schedule-io-backoff schedule) (+ now (ms 100))))
         (setf log nil events (list (ltd:make-key-event :key #\q)))
         (tick)
         (verify :backoff-skips-read (not (member :read log)))
         (verify :backoff-still-writes-key (equalp (first written) (lispterm::utf8 "q")))
         (verify :callback-pump-independent-of-read-backoff (member :poll log))
         (setf now (lispterm::owner-schedule-io-backoff schedule) read-error t log nil)
         (tick)
         (verify :error-backoff (= (lispterm::owner-schedule-io-backoff schedule)
                                  (+ now internal-time-units-per-second)))
         (setf poll-error t close-error t log nil
               now (lispterm::owner-schedule-next-frame schedule))
         (tick)
         (verify :display-error-detaches (eq :detached (lispterm::host-state-value host)))
         (verify :display-close-error-recorded
                 (find :display-close (lispterm:host-errors host) :key (lambda (e) (getf e :operation))))
         (setf (lispterm::host-stop-p host) t log nil)
         (verify :stopped-owner-returns-nil (null (tick)))
         (verify :stop-no-work (null log))
         (setf (lispterm::host-stop-p host) nil
               (lispterm::host-commands host) (list (lispterm::make-host-command :operation :stop))
               close-error nil log nil)
         (verify :queued-stop-returns-nil (null (tick)))
         (verify :queued-stop-no-read-or-poll (notany (lambda (x) (member x '(:read :poll))) log))))))
  (format t "~S~%" (list :checks checks :failures failures))
  (when (plusp failures) (error "~D owner policy failures" failures)))
)
