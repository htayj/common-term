(load (merge-pathnames "vttest-vt52-native-io.lisp" *load-truename*))
(defpackage :vttest-vt52-native-root
(:use :cl :vttest-vt52-native-io)
(:export :validate-root :validate-manifest :validate-ledger :validate-finalization :validate-cleanup))
(in-package :vttest-vt52-native-root)
(defparameter +source-root+ (namestring (truename (merge-pathnames "../" (make-pathname :name nil :type nil :defaults *load-truename*)))))
(defun lines (text)
(need (and (plusp (length text)) (char= #\Newline (char text (1- (length text))))))
(loop for start = 0 then (1+ end) for end = (position #\Newline text :start start)
  while end collect (subseq text start end)))
(defun sums (root relative)
(loop for row in (lines (read-text root relative :limit 1048576)) collect
(progn (need (and (> (length row) 66) (hex-p (subseq row 0 64))
                (string= "  " row :start2 64 :end2 66)))
     (cons (subseq row 66) (subseq row 0 64)))))
(defun checked-sums (root relative base &optional post)
(let ((rows (sums root relative)) (seen nil))
(need rows)
(dolist (row rows)
(need (not (member (car row) seen :test #'equal))) (push (car row) seen)
(need (not (or (search "capture-transaction.lisp" (car row))
               (search "capture-transaction-tests.lisp" (car row)))) "Protected")
(need (equal (cdr row) (digest-file (if (char= #\/ (char (car row) 0)) (car row)
(local-path base (if (and (> (length (car row)) 2) (string= "./" (car row) :end2 2)) (subseq (car row) 2) (car row)))))) "Source changed"))
(when post
(need (equal (read-text root post :limit 1048576)
(format nil "~{~a: OK~%~}" (mapcar #'car rows))) "Postcheck differs")) rows))
(defun validate-manifest (m backend scale)
(properties m '(:kind :version :area :backend :scale :scope-status :conditions :navigation-pauses :scenarios
            :required-count :native-driver :pins))
(need (and (eq :vttest-area-manifest (getf m :kind)) (eql 1 (getf m :version))
       (equal '(1 2 3) (getf m :navigation-pauses)) (equal "vt52-mode" (getf m :area)) (equal backend (getf m :backend))
       (eql scale (getf m :scale)) (member backend '("x11" "wayland") :test #'equal)
       (member scale (if (equal backend "x11") '(1) '(1 2)))
       (eq :frozen (getf m :scope-status)) (eql 1 (getf m :required-count))
       (equal (format nil "vt52-~a-v1" backend) (getf m :native-driver))))
(need (and (listp (getf m :conditions)) (every #'stringp (getf m :conditions))))
(need (= 1 (length (getf m :scenarios))))
(let ((s (first (getf m :scenarios))))
(properties s '(:id :recorder-label :menu-path :pauses :captures :bytes :timing :oracle :requires))
(need (and (equal "vt52-01" (getf s :id)) (equal "vt52" (getf s :recorder-label))
         (equal '(7) (getf s :menu-path)) (eql 3 (getf s :pauses))
         (equal '((:id "pause-02" :pause 2)) (getf s :captures))
         (null (getf s :bytes)) (eq t (getf s :timing)) (null (getf s :requires))))
(check-reference (getf s :oracle) +source-root+ "tests/vttest-vt52-oracle.lisp"))
(let ((seen nil))
(need (getf m :pins))
(dolist (p (getf m :pins))
(properties p '(:path :sha256))
(need (and (hex-p (getf p :sha256))
           (not (search "capture-transaction" (getf p :path)))))
(if (and (stringp (getf p :path)) (char= #\/ (char (getf p :path) 0)))
    (need (and (search "/nix/store/" (getf p :path) :end2 11)
               (equal (getf p :sha256) (digest-file (getf p :path)))))
    (check-reference p +source-root+))
(need (not (member (getf p :path) seen :test #'equal))) (push (getf p :path) seen))) m)
(defun validate-ledger (ledger root backend)
(properties ledger '(:kind :version :backend :entries))
(need (and (eq :vttest-charsets-native-stages (getf ledger :kind))
       (eql 1 (getf ledger :version)) (equal backend (getf ledger :backend))
       (= 1 (length (getf ledger :entries)))))
(let ((e (first (getf ledger :entries))))
(properties e '(:pause :request :invoked :completed :capture-exit :exit-origin :receipt))
(need (and (eql 2 (getf e :pause)) (eq t (getf e :invoked))
         (eq t (getf e :completed)) (eql 0 (getf e :capture-exit))
         (eql 0 (read-data root "recorder/pause-02-capture.exit"))))
(loop for k in '(:request :exit-origin :receipt)
    for p in '("recorder/pause-02-request" "recorder/pause-02-capture.exit" "recorder/pause-02-native.sexp")
    do (check-reference (getf e k) root p))) ledger)
(defun validate-finalization (f root backend)
(properties f '(:state :client-exit :result :abort))
(need (and (eq :complete (getf f :state)) (eql 0 (getf f :client-exit))
       (null (getf f :abort)) (eql 0 (read-data root "native/client.exit"))))
(check-reference (getf f :result) root "recorder/RESULT.sexp")
(let ((c (read-data root "native/finalization-clock.sexp"))
  (d (read-data root "native/import-deadline.sexp")))
(properties c '(:clock :limit-seconds :start-ns :end-ns :state :pid :token :run :backend))
(properties d '(:clock :deadline-ns :validated-ns :state))
(need (and (equal root (getf c :run)) (equal backend (getf c :backend))
         (eq :clock-monotonic (getf c :clock)) (eq :clock-monotonic (getf d :clock))
         (eql 15 (getf c :limit-seconds)) (eq :exited (getf c :state))
         (eq :valid (getf d :state)) (typep (getf c :pid) '(integer 1))
         (stringp (getf c :token)) (plusp (length (getf c :token)))
         (every #'digit-char-p (getf c :token))
         (every (lambda (x) (typep x '(integer 0)))
                (list (getf c :start-ns) (getf c :end-ns) (getf d :validated-ns)))
         (= (getf c :start-ns) (read-data root "native/finalization-clock.sexp.start"))
(= (+ (getf c :start-ns) 15000000000) (getf d :deadline-ns))
(<= (getf c :start-ns) (getf c :end-ns) (getf d :validated-ns))
(< (getf d :validated-ns) (getf d :deadline-ns))
(member (format nil "~d ~a" (getf c :pid) (getf c :token))
(lines (read-text root "native/owned.tsv")) :test #'equal)))) f)
(defun pin (path bytes hash)
(need (and (= bytes (sb-posix:stat-size (sb-posix:lstat path)))
       (equal hash (digest-file path))))
(list :path path :bytes bytes :sha256 hash))
(defun validate-cleanup (root clock)
(let ((log (read-text root "native/cleanup.log")))
(dolist (row (if (zerop (length log)) nil (lines log)))
(need (eql 0 (search "owned-absent /" row)))))
(local-path root "native/finalization-errors.txt" :missing t)
(let ((u (read-data root "native/owned-cleanup.sexp")) (ids nil)
  (owned (lines (read-text root "native/owned.tsv"))))
(properties u '(:version :client :server)) (need (eql 1 (getf u :version)))
(dolist (role '(:client :server))
(let* ((r (getf u role)) (pid (getf r :pid)) (token (getf r :start-token)))
  (properties r '(:pid :start-token :term-exit :kill-exit :wait-exit :waited))
  (need (and (typep pid '(integer 1)) (not (member pid ids))
             (stringp token) (plusp (length token)) (every #'digit-char-p token)
             (eq t (getf r :waited)) (typep (getf r :wait-exit) '(integer 0 255))
             (member (format nil "~d ~a" pid token) owned :test #'equal)))
  (push pid ids)
  (dolist (k '(:term-exit :kill-exit))
    (need (typep (getf r k) '(or null (integer 0 255)))))
  (when (eq role :client)
    (need (and (eql pid (getf clock :pid)) (equal token (getf clock :token))
               (eql 0 (getf r :wait-exit))))))) u))
(defun root-originals (root candidate)
(mapcar (lambda (p) (reference root p))
      (append '("MANIFEST.sexp" "native/manifest-pre.sha256" "native/manifest-post.sha256"
        "native/execution-inputs.sha256" "native/execution-inputs-post.check" "build/archive.actual.sha256"
        "build/BUILD.sexp" "native/build.exit" "build/extract.exit" "build/configure.exit" "build/make.exit"
        "build/binary.sha256" "native/binary-pre.sha256" "native/binary-post.sha256"
        "build/source.sha256" "build/source-post.check" "native/stages.sexp"
        "recorder/RESULT.sexp" "recorder/pause-02-capture.exit" "native/finalization-clock.sexp"
        "native/finalization-clock.sexp.start" "native/import-deadline.sexp" "native/client.exit"
        "native/owned.tsv" "native/owned-cleanup.sexp" "native/cleanup.log" "build/tools.sha256" "build/tools-post.check") (unless candidate '("VT52-RUN.sexp")))))
