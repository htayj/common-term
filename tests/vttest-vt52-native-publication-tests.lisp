;;;; Genuine lifecycle MAIN runs in owned forks; PNG decoding alone is injected.
(load (merge-pathnames "vttest-vt52-native-publication-test-support.lisp" *load-truename*))
(in-package :vttest-vt52-native-contract-tests)
(defun publication-case (mode)
  (publication-owned-call (lambda ()
    (let ((*publication-mode* mode) (root nil))
      (multiple-value-bind (pid token) (publication-helper)
        (multiple-value-bind (spid stoken) (publication-helper)
          (multiple-value-bind (directory files)
              (assemble-root "x11" 1 #'recorder-files
                :mutate (lambda () (publication-queue pid token spid stoken)))
            (setf root (publish directory files)))
          (dolist (row '(("BACKEND" . "x11") ("FINALIZATION" . ":COMPLETE")
                        ("CLIENT_EXIT" . "0") ("STATUS" . ":PASS")
                        ("BUILD" . ":PASS") ("STARTED" . "T")
                        ("CLEANUP" . ":PASS") ("ATTEMPTED" . "1")
                        ("REACHED" . "1") ("CAPTURED" . "1")
                        ("REASON" . "publication-test")))
            (publication-environment (car row) (cdr row)))
          (publication-environment "PID" pid) (publication-environment "TOKEN" token)
          (check :main-start (= 0 (publication-operation root "start")))
          (let ((start (io:read-data root "native/finalization-clock.sexp.start")))
            (publication-environment "START_NS" start)
            (publication-environment "DEADLINE_NS" (+ start 15000000000)))
          ;; Helpers are still our unreaped children; MAIN observes the actual zombie.
          (check :main-await (= 0 (publication-operation root "await")))
          (publication-cleanup root pid token spid stoken)
          (let ((import-exit (publication-operation root "import"
                               :missing-import (eq mode :missing-import))))
            (cond
              ((member mode '(:missing-import :import-refuse))
                (check (list mode :import-exit) (= 1 import-exit))
                (check (list mode :no-native-run)
                  (null (probe-file (concatenate 'string root "VT52-RUN.sexp"))))
                (when (eq mode :import-refuse)
                  (check :real-import-refusal
                    (and (null (probe-file (concatenate 'string root "native/recorder-import.sexp")))
                      (plusp (getf (io:read-data root "native/audit-import-refused.sexp") :decoder-calls))))))
              (t
                (check :genuine-import (= 0 import-exit))
                (let* ((exit (publication-operation root "publish"))
                       (record (io:read-data root "VT52-RUN.sexp"))
                       (report (io:read-data root "vt52-check.sexp")))
                  (check (list mode :publish-exit) (= (if mode 1 0) exit))
                  (check (list mode :native-status)
                    (eq (if (eq mode :candidate-refuse) :fail :pass) (getf record :status)))
                  (check (list mode :final-verdict) (eq (if mode :refuse :pass) (getf report :verdict)))
                  (check :candidate-original-absent
                    (null (getf (io:read-data root "native/audit-candidate.sexp") :exists)))
                  (check :actual-original-present
                    (eq t (getf (io:read-data root "native/audit-actual.sexp") :exists)))
                  (when (null mode)
                    (check :actual-provenance
                      (equal (io:reference root "VT52-RUN.sexp")
                        (getf (getf report :provenance) :native-run)))
                    (check :fresh-main-check (= 0 (publication-operation root "check")))
                    (check :fresh-check-provenance
                      (equal (io:reference root "VT52-RUN.sexp")
                        (getf (io:read-data root "native/audit-check.sexp") :native-run))))))))))
      (format t "PUBLICATION-CASE ~s ~a~%" mode root) root))))
(defun publication-ownership-tests ()
  ;; Metadata failure after two forks must preserve the cause and reap both.
  (let ((original (make-condition 'simple-error :format-control "token failure"))
        (children nil))
    (check :token-failure-original
      (eq original (handler-case
          (publication-owned-call (lambda ()
            (publication-helper)
            (publication-helper (lambda (pid) (declare (ignore pid))
              (setf children (copy-list *publication-children*)) (error original)))))
        (error (e) e))))
    (check :both-registered (= 2 (length children)))
    (dolist (child children)
      (check :helper-actually-reaped (and (null (publication-child-pid child))
        (sb-posix:wifexited (publication-child-status child))
        (zerop (sb-posix:wexitstatus (publication-child-status child)))))))
  ;; Exercise the owned-child watchdog without changing MAIN or its callbacks.
  (let ((child nil))
    (check :owned-timeout-reported
      (handler-case (publication-owned-call (lambda ()
        (let ((pid (publication-helper)))
          (setf child (publication-child-for pid)) (publication-wait pid 0))))
        (publication-errors () t)))
    (check :owned-timeout-reaped (and (null (publication-child-pid child))
      (sb-posix:wifsignaled (publication-child-status child))
      (= sb-posix:sigkill (sb-posix:wtermsig (publication-child-status child)))))))
(defun coherent-subset ()
  (change-form "MANIFEST.sexp"
    (lambda (m) (setf (getf m :pins) (list (first (getf m :pins)))) m))
  (dolist (p '("native/manifest-pre.sha256" "native/manifest-post.sha256"))
    (setf (cdr (assoc p *files* :test #'equal)) (a::bytes (qsum "MANIFEST.sexp"))))
  (let* ((m (a::parsed (queued "MANIFEST.sexp"))) (pin (first (getf m :pins)))
         (path (getf pin :path)))
    (setf (cdr (assoc "native/execution-inputs.sha256" *files* :test #'equal))
      (a::bytes (concatenate 'string (qsum "MANIFEST.sexp") (sum-row path (getf pin :sha256))))
          (cdr (assoc "native/execution-inputs-post.check" *files* :test #'equal))
      (a::bytes (format nil "~a: OK~%~a: OK~%" (qpath "MANIFEST.sexp") path))))
  (change-form "VT52-RUN.sexp"
    (lambda (n) (setf (getf n :manifest-sha256) (getf (qref "MANIFEST.sexp") :sha256)) n)))
(defun publication-subset-case ()
  (let* ((root (fixture "x11" 1 #'coherent-subset))
         (report (c:validate-vt52-native root :backend "x11" :scale 1)))
    (check :subset-final-refusal (and (eq :refuse (getf report :verdict))
                                   (equal '(:invalid-manifest) (getf report :reasons))))
    (check :subset-import-refusal
      (handler-case (progn (c::validate-recorder-import root) nil) (error () t)))
    (check :subset-no-pass-import (null (probe-file (concatenate 'string root "native/recorder-import.sexp"))))))
(defun run-publication-tests ()
  (assert (= 1 (length (sb-thread:list-all-threads))))
  (let* ((*checks* 0) (a::*calls* 0) (a::*action* nil)
         (font (a::read-bytes vttest-vt52-capture-adapter::*font-path*))
         (a::*images* (map 'vector (lambda (s)
           (vttest-vt52-pixels:expected-rgba (vttest-vt52-oracle:vt52-snapshot) font
             :font-sha256 vttest-vt52-capture-adapter::*font-pin* :scale s :blink-phase t)) '(1 2)))
         (symbol 'vttest-vt52-png-adapter:decode-original-png) (saved (symbol-function symbol)))
    (unwind-protect
      (progn
        (setf (symbol-function symbol) #'a::fake-decode)
        (publication-ownership-tests)
        (dolist (mode '(nil :candidate-refuse :final-refuse :missing-import :import-refuse))
          (publication-case mode))
        (publication-subset-case)
        (format t "PASS ~d VT52 genuine publication checks~%" *checks*) *checks*)
      (setf (symbol-function symbol) saved))))
