;;;; Offline keyboard driver controls. No recorder, display or adapter runs.
(defpackage :vttest-keyboard-driver-tests
  (:use :cl) (:export :run :check :temp-root)
  (:local-nicknames (:k :vttest-keyboard-driver) (:c :vttest-check) (:a :vttest-area)))
(in-package :vttest-keyboard-driver-tests)
(defvar *failures* nil)
(defvar *roots* nil)
(defun check (x label)
  (format t "~:[FAIL~;PASS~] ~a~%" x label) (unless x (push label *failures*)))
(defun problem-p (thunk)
  (handler-case (progn (funcall thunk) nil) (a:gate-problem (p) (a:problem-reason p))))
(defun fixture-parent (path)
  "Normalize the fixture parent; internal directory names end in one slash."
  (concatenate 'string (string-right-trim "/" path) "/"))
(defun temp-root ()
  (let* ((parent (fixture-parent
                  (or (sb-ext:posix-getenv "LISPTERM_KEYBOARD_TEST_ARTIFACTS") "/tmp")))
         (root (sb-posix:mkdtemp (c::cat parent "vttest-keyboard-XXXXXX"))))
    (car (push (c::cat root "/") *roots*))))
(defun put-bytes (path text)
  (with-open-file (s path :direction :output :element-type '(unsigned-byte 8) :if-exists :supersede)
    (write-sequence (map '(vector (unsigned-byte 8)) #'char-code text) s)))

(defun write-case (dir label &key wrong drop-key unclosed overlap (drop-phase -1) duplicate (counter 0))
  "Write gate-shaped recorder originals for LABEL; return the capture counter."
  (let ((events nil) (out "") (input "") (seq 0) (time 0) (phase "startup") (n counter)
        (spec (k::case-of label)) (cr (string #\Return)))
    (labels ((e (kind &rest args)
               (push (list* :seq (incf seq) :kind kind :phase phase :time (incf time 1/100)
                            :out (length out) :in (length input) args) events))
             (in (source bytes) (e :enqueue :source source :bytes bytes)
               (e :wire-in :source source :bytes bytes :end (+ (length input) (length bytes)))
               (setf input (c::cat input bytes)))
             (enter (name) (setf phase name) (e :phase))
             (drive (bytes) (e :driver :bytes bytes) (in :input bytes))
             (shot (id) (let ((name (format nil "~3,'0d-~a-~a" (incf n) label id)))
                          (e :capture :name name) (put-bytes (c::cat dir name ".png") "png"))))
      (enter "startup") (e :wire-out :bytes (c::esc "[c") :end 3) (setf out (c::esc "[c"))
      (in :reply (c::esc "[?1;2c"))
      (loop for choice in (second spec) for i from 0
            do (enter (format nil "navigate-~d" i)) (drive (format nil "~d~a" choice cr)))
      (dotimes (p (third spec))
        (enter (format nil "keys-~d" p))
        (unless (= p drop-phase)
          (loop for key in (append (fourth spec) '("Tab"))
                for bytes in (append (c::expected-key-byte-list label p) (list (string #\Tab)))
                for first = t then nil
                do (when (and wrong (= p 1) first) (setf bytes wrong))
                   (unless (and drop-key (= p 0) first)
                     (e :key-begin :key key)
                     (when (and overlap (= p 0) first) (e :key-begin :key key))
                     (in :input bytes)
                     (unless (and unclosed (= p (1- (third spec))) (equal key "Tab"))
                       (e :key-end :key key)))
                   (unless (equal key "Tab")
                     (shot (format nil "keys~d-~a" p (string-downcase key)))))))
      (enter "pause-1") (shot "pause01") (when duplicate (shot "pause01")) (drive cr)
      (enter "return-main") (drive (c::cat "0" cr))
      (enter "exit") (drive (c::cat "0" cr)) (e :exit))
    (put-bytes (c::cat dir label ".transcript.raw") out)
    (put-bytes (c::cat dir label ".input.raw") input)
    (with-open-file (s (c::cat dir label ".events.sexp") :direction :output :if-exists :supersede)
      (let ((*print-pretty* nil)) (dolist (ev (reverse events)) (write ev :stream s) (terpri s))))
    (c:write-value (c::cat dir label ".result.sexp")
                   (list :label label :returned-to-menu t :inventory-ok t :failure nil :errors nil
                         :status '(:error-count 0 :process-state :exited :transport-state :hangup
                                   :input-pending 0)))
    (c:write-value (c::cat dir label ".exit") 0)
    n))

(defun recorder (&key cursor keypad)
  (let* ((root (temp-root)) (dir (c::cat root "recorder/")))
    (sb-posix:mkdir dir #o700)
    (apply #'write-case dir "keyboard-keypad"
           :counter (apply #'write-case dir "keyboard-cursor" cursor) keypad)
    root))

(defun run ()
  (setf *failures* nil)
  (dolist (backend '("x11" "wayland"))
    (let ((m (k:make-manifest backend)))
      (check (eq m (k:validate m)) (list backend :closed-manifest))
      (check (eq m (a:validate-manifest m "keyboard" backend)) :public-validator)
      (check (and (= 26 (getf m :required-count))
                  (equal (mapcar (lambda (s) (getf s :menu-path)) (getf m :scenarios))
                         '((5 4) (5 5)))) :manifest-identities)
      (let ((bad (copy-tree m)))
        (setf (getf bad :native-driver) "cursor-x11-v1")
        (check (problem-p (lambda () (a:validate-manifest bad "keyboard" backend))) :foreign-driver))))
  (check (problem-p (lambda () (k:make-manifest "X11"))) :lowercase-backend)
  (dolist (label '("keyboard-cursor" "keyboard-keypad"))
    (let* ((root (recorder)) (dir (c::cat root "recorder/"))
           (events (k::events-of label dir)))
      (check (eq :pass (k::case-bytes label dir)) (list label :accepted-bytes))
      (check (and (not (eq events :malformed))
                  (= (if (equal label "keyboard-cursor") 15 16)
                (count :key-begin events :key (lambda (e) (getf e :kind))))) :brackets)
      (multiple-value-bind (state originals) (k::case-identity label dir)
        (check (and (eq state :pass) (= 13 (length originals))
                    (equal "pause01" (caar (last originals)))) :originals))))
  (dolist (bad (list (list :wrong (c::esc "[A")) '(:drop-key t) '(:unclosed t)
                     '(:overlap t) '(:drop-phase 2)))
    (let* ((root (recorder :cursor bad)) (dir (c::cat root "recorder/")))
      (check (not (eq :pass (k::case-bytes "keyboard-cursor" dir))) (list :reject bad))))
  (let* ((root (recorder :keypad '(:drop-phase 3))) (dir (c::cat root "recorder/")))
    (check (not (eq :pass (k::case-bytes "keyboard-keypad" dir))) :missing-later-wayland-event))
  (let* ((root (recorder :keypad '(:duplicate t))) (dir (c::cat root "recorder/")))
    (check (not (eq :pass (k::case-identity "keyboard-keypad" dir))) :duplicate-capture))
  (let ((root (recorder)) (m (k:make-manifest "x11")))
    (multiple-value-bind (obs evidence) (k:summarize-native m nil 3 root)
      (check (and (= 26 (length obs)) (eq :unverified (a:aggregate-observations (getf m :scenarios) obs))
                  (= 26 (getf (getf evidence :counts) :unverified))) :absent-receipt-incomplete))
    (check (getf (nth-value 1 (k:summarize-native m nil 1 root)) :native-failed) :nonzero-native-fails))
  (check (eq :unverified (k::cleanup-status '(:cleanup (:state :stopped :owned ((:state :stopped))
                                                      :wayland-holder :not-applicable))))
         :claimed-cleanup-without-launch-binding)
  (check (eq :unverified (k::pixel-status :pass nil "001-keyboard-cursor-keys0-up")) :missing-pixels)
  (check (eq :fail (k::pixel-status :pass '(:name "wrong" :pixels :pass) "actual")) :wrong-pixel-original)
  (null *failures*))
