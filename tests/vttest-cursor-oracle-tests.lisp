;;;; scripts/sbcl --script tests/vttest-cursor-oracle-tests.lisp ACTUAL FONT NEW-DIR MAGICK
(require :asdf)
(load (merge-pathnames "vttest-cursor-oracle.lisp" *load-truename*))
(defpackage #:vttest-cursor-oracle-tests (:use #:cl #:vttest-cursor-oracle))
(in-package #:vttest-cursor-oracle-tests)
(defvar *checks* 0)
(defun check (value label)
  (incf *checks*)
  (unless value (error "Check failed: ~a" label)))
(defun external (&rest args)
  (format t "COMMAND ~s~%" args)
  (uiop:run-program args :output :string :error-output *error-output*))
(defun decode-rgb (magick input output &optional (width 640))
  (check (string= (format nil "~d 384" width) (string-trim '(#\Space #\Newline #\Return)
                       (external magick "identify" "-format" "%w %h" input))) "PNG dimensions")
  (external magick input "-depth" "8" (concatenate 'string "rgba:" output))
  (let* ((rgba (read-bytes output))
         (rgb (make-array (* width 384 3) :element-type '(unsigned-byte 8))))
    (check (= (* width 384 4) (length rgba)) "decoded length")
    (check (loop for p from 3 below (length rgba) by 4 always (= 255 (aref rgba p))) "opaque alpha")
    (dotimes (p (* width 384))
      (dotimes (i 3) (setf (aref rgb (+ (* p 3) i)) (aref rgba (+ (* p 4) i)))))
    rgb))

(defun run (actual font-path directory magick &optional (pause 1))
  (let* ((*checks* 0) (out (uiop:ensure-directory-pathname directory))
         (font (read-bytes font-path)) (cells (screen pause))
         (cursor (nth-value 1 (screen pause))) (columns (array-dimension cells 1)) (width (* columns 8))
         (wrong (make-array (array-dimensions cells) :element-type 'character))
         (mutation-row (if (<= pause 2) 9 1))
         (mutation-column (if (<= pause 2) (+ 11 (/ (- columns 80) 2)) 1))
         (info (font-info font)))
    (ensure-directories-exist out)
    (flet ((path (name) (namestring (merge-pathnames name out))))
      (check (= 12 (getf info :ascent)) "font ascent")
      (check (= -4 (getf info :descent)) "font descent")
      (check (equal '(0 0 126 64 64 64 120 64 64 64 64 126 0 0 0 0)
                    (coerce (glyph-rows font #\E) 'list)) "authoritative E glyph rows")
      (check (every #'zerop (glyph-rows font #\Space)) "blank glyph")
      (dotimes (r 24) (dotimes (c columns) (setf (aref wrong r c) (aref cells r c))))
      (let ((ch (aref cells (1- mutation-row) (1- mutation-column))))
        (check (char/= ch #\Space) "mutation changes source-derived content")
        (setf (aref wrong (1- mutation-row) (1- mutation-column)) (if (char= ch #\E) #\F #\X)))
      (check (= 1 (loop for i below (array-total-size cells) count (char/= (row-major-aref cells i)
                                                      (row-major-aref wrong i)))) "one changed cell")
      (with-open-file (s (path "cells.txt") :direction :output :if-exists :error)
        (dotimes (r 24) (dotimes (c columns) (write-char (aref cells r c) s)) (terpri s)))
      (let ((expected (rasterize cells font :cursor cursor)) (mutated (rasterize wrong font :cursor cursor)))
        (write-ppm (path "expected.ppm") expected :width width)
        (write-ppm (path "wrong.ppm") mutated :width width)
        (external magick (path "expected.ppm") (path "expected.png"))
        (external magick (path "wrong.ppm") (path "wrong.png"))
        (let* ((actual-rgb (decode-rgb magick actual (path "actual.rgba") width))
               (expected-rgb (decode-rgb magick (path "expected.png") (path "expected.rgba") width))
               (wrong-rgb (decode-rgb magick (path "wrong.png") (path "wrong.rgba") width))
               (positive (compare-screen pause actual-rgb font :diff-path (path "diff.ppm")))
               (negative (compare-rgb wrong-rgb actual-rgb :width width :diff-path (path "wrong-diff.ppm"))))
          (check (equalp expected expected-rgb) "expected PNG lossless roundtrip")
          (check (equalp mutated wrong-rgb) "wrong PNG lossless roundtrip")
          (external magick (path "diff.ppm") (path "diff.png"))
          (external magick (path "wrong-diff.ppm") (path "wrong-diff.png"))
          (format t "EXPECTED-ACTUAL ~s~%WRONG-ACTUAL ~s~%" positive negative)
          ;; Retain comparisons before asserting, so a product failure keeps evidence.
          (let ((result (list :status (if (and (getf positive :pass) (not (getf negative :pass)))
                                        :pixel-checks-pass-awaiting-image-view :failed)
                              :actual actual :font font-path :font-info info
                              :pause pause :cells (array-dimensions cells) :cell-size '(8 16) :scale 1
                              :cursor cursor
                              :attributes '(:bold nil :underline nil :inverse nil :blink nil)
                              :positive positive :wrong-reference negative
                              :mutation (list :row mutation-row :column mutation-column)
                              :checks-before-final-assertions *checks*)))
            (with-open-file (s (path "RESULT.sexp") :direction :output :if-exists :error)
              (let ((*print-pretty* t)) (write result :stream s) (terpri s))))
          (check (getf positive :pass) "real first-screen exact pixel comparison")
          (check (not (getf negative :pass)) "wrong-reference rejected by pixel comparison")
          (check (equal (list (list mutation-row mutation-column)) (getf negative :different-cells)) "wrong reference fails only mutated cell")
          (check (> (getf negative :different-pixels) 0) "substantive changed pixels")
          (let ((copy (copy-seq expected)))
            (check (getf (compare-rgb expected copy :width width) :pass) "equal image control")
            (setf (aref copy 0) (logxor 1 (aref copy 0)))
            (let ((r (compare-rgb expected copy :width width)))
              (check (not (getf r :pass)) "one-channel rejection")
              (check (= 1 (getf r :different-pixels)) "one-pixel count")
              (check (equal '((1 1)) (getf r :different-cells)) "one-pixel cell")))
          (format t "PASS ~d assertions; positive~d/~d; negative~d differing pixels; no masks/tolerance~%"
                  *checks* (* width 384) (* width 384) (getf negative :different-pixels))
          (values positive negative *checks*))))))

(let ((args (uiop:command-line-arguments)))
  (unless (member (length args) '(4 5)) (error "Expected ACTUAL FONT OUTPUT-DIRECTORY MAGICK [PAUSE]"))
  (when (= 5 (length args)) (setf (fifth args) (parse-integer (fifth args))))
  (apply #'run args))
