(in-package #:lispterm.engine)
(defun make-screen (&key (columns 80) (rows 24))
  (check-type columns (integer 1)) (check-type rows (integer 1))
  (nerimux/terminal:make-screen columns rows))
(defun feed (screen octets) (nerimux/terminal:screen-process-bytes screen octets))
(defun resize (screen rows columns)
  (check-type rows (integer 1)) (check-type columns (integer 1))
  (nerimux/terminal:screen-resize screen columns rows))
(defun rows (screen) (nerimux/terminal:screen-height screen))
(defun columns (screen) (nerimux/terminal:screen-width screen))
(defun cursor-row (screen) (nerimux/terminal:screen-cursor-y screen))
(defun cursor-column (screen) (nerimux/terminal:screen-cursor-x screen))
(defun cell-at (screen row column) (nerimux/terminal:screen-cell screen column row))
(defun cell-character (cell) (nerimux/terminal:cell-char cell))
(defun cell-width (cell) (nerimux/terminal:cell-width cell))
(defun palette-color (index)
  (check-type index (integer 0 255))
  (cond ((< index 16)
         (aref #(#x000000 #xcd0000 #x00cd00 #xcdcd00 #x0000ee #xcd00cd #x00cdcd #xe5e5e5
                 #x7f7f7f #xff0000 #x00ff00 #xffff00 #x5c5cff #xff00ff #x00ffff #xffffff) index))
        ((< index 232)
         (let* ((n (- index 16)) (levels #(0 95 135 175 215 255)))
           (logior (ash (aref levels (floor n 36)) 16)
                   (ash (aref levels (mod (floor n 6) 6)) 8)
                   (aref levels (mod n 6)))))
        (t (* #x010101 (+ 8 (* 10 (- index 232)))))))
(defun resolve-color (value)
  (cond ((= value nerimux/terminal/types:+default-color+) nil)
        ((logbitp 24 value) (logand value #xffffff))
        (t (palette-color value))))
(defun cell-foreground (cell) (resolve-color (nerimux/terminal:cell-fg cell)))
(defun cell-background (cell) (resolve-color (nerimux/terminal:cell-bg cell)))
(defun cell-bold-p (cell) (logtest nerimux/terminal/types:+attr-bold+ (nerimux/terminal:cell-attrs cell)))
(defun cell-inverse-p (cell) (logtest nerimux/terminal/types:+attr-reverse+ (nerimux/terminal:cell-attrs cell)))
(defun cell-underline-p (cell) (logtest nerimux/terminal/types:+attr-underline+ (nerimux/terminal:cell-attrs cell)))
(defun dirty-p (screen) (nerimux/terminal/types:screen-dirty-p screen))
(defun clear-damage (screen) (nerimux/terminal:screen-clear-dirty screen))

(defun line-size (screen row)
  "Return ROW's native rendition keyword; physical screen dimensions do not change."
  (case (gethash row (nerimux/terminal:screen-line-sizes screen))
    (#\3 :double-height-top) (#\4 :double-height-bottom)
    (#\6 :double-width) (otherwise :single)))
(defun logical-columns (screen row)
  "Addressable character positions in ROW, half the physical columns when doubled."
  (if (eq (line-size screen row) :single) (columns screen)
      (max 1 (floor (columns screen) 2))))
(defun reverse-screen-p (screen) (nerimux/terminal:screen-reverse-screen screen))
(defun cell-blink-p (cell)
  (logtest nerimux/terminal/types:+attr-blink+ (nerimux/terminal:cell-attrs cell)))
