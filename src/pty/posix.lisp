(in-package #:lispterm.pty)
(defun %fail (type operation &optional (errno (%errno)))
  (error type :operation operation :errno errno))
(defun %check (result type operation)
  (when (minusp result) (%fail type operation)) result)
(defun %dimension (value)
  (unless (typep value '(integer 1 65535))
    (error 'type-error :datum value :expected-type '(integer 1 65535))) value)
(defun %duration (value)
  (unless (and (realp value) (<= 0 value 3600))
    (error 'type-error :datum value :expected-type '(real 0 3600))) value)
(defun %deadline (seconds) (+ (get-internal-real-time) (* (%duration seconds) internal-time-units-per-second)))
(defun %remaining (deadline) (max 0 (/ (- deadline (get-internal-real-time)) internal-time-units-per-second)))
(defun %close-requested-p (pty)
  (sb-thread:with-mutex ((pty-cancellation-lock pty))
    (pty-close-requested-p pty)))
(defun %request-close (pty)
  (sb-thread:with-mutex ((pty-cancellation-lock pty))
    (setf (pty-close-requested-p pty) t)))
(defun %ensure-open (pty)
  (when (%close-requested-p pty) (%fail 'pty-closed-error :closed nil))
  (unless (pty-open-p pty) (%fail 'pty-closed-error :closed nil)))
(defun %resize (fd rows columns)
  (cffi:with-foreign-object (ws '(:struct winsize))
    (setf (cffi:foreign-slot-value ws '(:struct winsize) 'rows) rows
          (cffi:foreign-slot-value ws '(:struct winsize) 'columns) columns
          (cffi:foreign-slot-value ws '(:struct winsize) 'x) 0
          (cffi:foreign-slot-value ws '(:struct winsize) 'y) 0)
    (%check (%ioctl fd #x5414 ws) 'pty-io-error :resize)))
(defun open-pty (&key (rows 24) (columns 80))
  (%dimension rows) (%dimension columns)
  (let ((fd (%check (%openpt (logior sb-posix:o-rdwr sb-posix:o-noctty
                                    sb-posix:o-nonblock #o2000000)) 'pty-open-error :open)))
    (when (< fd 3)
      (let ((safe-fd (%fcntl fd 1030 3))) ; Linux F_DUPFD_CLOEXEC
        (when (minusp safe-fd)
          (let ((errno (%errno))) (%close fd) (%fail 'pty-open-error :duplicate-master errno)))
        (%close fd) (setf fd safe-fd)))
    (handler-case
        (progn
          (%check (%grantpt fd) 'pty-open-error :grant)
          (%check (%unlockpt fd) 'pty-open-error :unlock)
          (cffi:with-foreign-object (name :char 256)
            (let ((rc (%ptsname fd name 256)))
              (unless (zerop rc) (%fail 'pty-open-error :slave-name rc)))
            (%resize fd rows columns)
            (%make-pty :master-fd fd :slave-name (cffi:foreign-string-to-lisp name))))
      (error (e) (%close fd) (error e)))))
(defun %ready (fd events deadline)
  (cffi:with-foreign-object (p '(:struct pollfd))
    (setf (cffi:foreign-slot-value p '(:struct pollfd) 'fd) fd
          (cffi:foreign-slot-value p '(:struct pollfd) 'events) events)
    (loop for rc = (%poll p 1 (ceiling (* 1000 (%remaining deadline))))
          do (cond ((plusp rc) (return t)) ((zerop rc) (return nil))
                   ((/= (%errno) sb-posix:eintr) (%fail 'pty-io-error :poll)))
          when (zerop (%remaining deadline)) return nil)))
(defun pty-read (pty &key (timeout 0.1))
  (let ((deadline (%deadline timeout)))
    (%ensure-open pty)
    (cffi:with-foreign-object (buffer :unsigned-char 16384)
      (loop
        ;; Cancellation is published without waiting for this syscall lock.
        ;; Once requested, no waiting reader can start another poll slice.
        (when (%close-requested-p pty) (return :eof))
        (sb-thread:with-mutex ((pty-lock pty))
          (when (or (%close-requested-p pty) (not (pty-open-p pty)))
            (return-from pty-read :eof))
          (when (%ready (pty-master-fd pty) 1 (min deadline (%deadline 0.05)))
            (let ((n (%read (pty-master-fd pty) buffer 16384)))
              (cond ((plusp n)
                     (return-from pty-read
                       (let ((out (make-array n :element-type '(unsigned-byte 8))))
                         (dotimes (i n out)
                           (setf (aref out i) (cffi:mem-aref buffer :unsigned-char i))))))
                    ((or (zerop n) (= (%errno) sb-posix:eio)) (return-from pty-read :eof))
                    ((not (member (%errno) (list sb-posix:eintr sb-posix:eagain)))
                     (%fail 'pty-io-error :read))))))
        (when (zerop (%remaining deadline)) (return nil))
        (sb-thread:thread-yield)))))
(defun pty-write (pty octets &key (timeout 2))
  "Return the accepted prefix within TIMEOUT seconds; zero never waits for readiness."
  (check-type octets (vector (unsigned-byte 8)))
  (let ((deadline (%deadline timeout)) (offset 0))
    (%ensure-open pty)
    (cffi:with-foreign-object (buffer :unsigned-char (max 1 (min 16384 (length octets))))
      (loop while (< offset (length octets))
            do (when (%close-requested-p pty) (return))
               (sb-thread:with-mutex ((pty-lock pty))
                 (when (or (%close-requested-p pty) (not (pty-open-p pty)))
                   (return-from pty-write offset))
                 (when (%ready (pty-master-fd pty) 4 (min deadline (%deadline 0.05)))
                   (let ((count (min 16384 (- (length octets) offset))))
                     (dotimes (i count)
                       (setf (cffi:mem-aref buffer :unsigned-char i) (aref octets (+ offset i))))
                     (let ((n (%write (pty-master-fd pty) buffer count)))
                       (cond ((plusp n) (incf offset n))
                             ((zerop n) (return-from pty-write offset))
                             ((not (member (%errno) (list sb-posix:eintr sb-posix:eagain)))
                              (%fail 'pty-io-error :write)))))))
            when (zerop (%remaining deadline)) do (return)))
    offset))
(defun pty-resize (pty rows columns)
  (%dimension rows) (%dimension columns)
  (sb-thread:with-mutex ((pty-lock pty))
    (%ensure-open pty) (%resize (pty-master-fd pty) rows columns))
  (values rows columns))
(defun pty-window-size (pty)
  (sb-thread:with-mutex ((pty-lock pty))
    (%ensure-open pty)
    (cffi:with-foreign-object (ws '(:struct winsize))
      (%check (%ioctl (pty-master-fd pty) #x5413 ws) 'pty-io-error :window-size)
      (values (cffi:foreign-slot-value ws '(:struct winsize) 'rows)
              (cffi:foreign-slot-value ws '(:struct winsize) 'columns)))))
(defun pty-foreground-process-group (pty)
  (sb-thread:with-mutex ((pty-lock pty))
    (%ensure-open pty) (%check (%tcgetpgrp (pty-master-fd pty)) 'pty-io-error :foreground-group)))
(defun attach-slave-to-stdio (pty &key (fds '(0 1 2)) (controlling-terminal t) disposable)
  (unless disposable (%fail 'stdio-rebind-refused :attach nil))
  (unless (and (listp fds) (every (lambda (fd) (typep fd '(integer 0 2))) fds))
    (error 'type-error :datum fds :expected-type 'list))
  (sb-thread:with-mutex ((pty-lock pty))
    (%ensure-open pty)
    (when controlling-terminal
      ;; An existing session leader may attach too; ioctl below validates it.
      (let ((rc (%setsid)))
        (when (and (minusp rc) (/= (%errno) sb-posix:eperm)) (%fail 'pty-io-error :setsid))))
    (let ((slave (%check (%open (pty-slave-name pty) (logior sb-posix:o-rdwr sb-posix:o-noctty #o2000000))
                         'pty-io-error :open-slave)))
      (unwind-protect
           (progn
             ;; Keep the temporary descriptor outside the stdio targets. A
             ;; dup2 onto itself would retain O_CLOEXEC after a closed fd0/1/2
             ;; was reused by open, losing that stream at the next exec.
             (when (< slave 3)
               (let ((safe-fd (%check (%fcntl slave 1030 3)
                                      'pty-io-error :duplicate-slave)))
                 (%close slave)
                 (setf slave safe-fd)))
             (when controlling-terminal
               (%check (%ioctl slave #x540e (cffi:null-pointer)) 'pty-io-error :controlling-terminal))
             (dolist (fd fds) (%check (%dup2 slave fd) 'pty-io-error :dup2)))
        (%close slave))))
  pty)
