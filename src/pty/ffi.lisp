(in-package #:lispterm.pty)
;; Layouts from glibc Linux x86-64 spawn.h, bits/types/__sigset_t.h,
;; bits/termios-struct.h and asm-generic/{poll,ioctls}.h. Glibc 2.40/2.42
;; reserve the same 336 bytes for spawnattr; only their reserved tail differs.
#+(or (not linux) (not x86-64)) (error "lispterm PTY requires Linux x86-64 glibc")
(cffi:defcstruct spawn-attributes
  (flags :short) (pgrp :int) (defaults :unsigned-long :count 16)
  (mask :unsigned-long :count 16) (priority :int) (policy :int) (reserved :int :count 16))
(cffi:defcstruct spawn-actions
  (allocated :int) (used :int) (actions :pointer) (reserved :int :count 16))
(cffi:defcstruct pollfd (fd :int) (events :short) (revents :short))
(cffi:defcstruct winsize (rows :unsigned-short) (columns :unsigned-short)
  (x :unsigned-short) (y :unsigned-short))
(cffi:defcfun ("__errno_location" %errno-location) :pointer)
(defun %errno () (cffi:mem-ref (%errno-location) :int))
(cffi:defcfun ("posix_openpt" %openpt) :int (flags :int))
(cffi:defcfun ("grantpt" %grantpt) :int (fd :int))
(cffi:defcfun ("unlockpt" %unlockpt) :int (fd :int))
(cffi:defcfun ("ptsname_r" %ptsname) :int (fd :int) (buffer :pointer) (size :size))
(cffi:defcfun ("close" %close) :int (fd :int))
(cffi:defcfun ("open" %open) :int (name :string) (flags :int))
(cffi:defcfun ("dup2" %dup2) :int (old :int) (new :int))
(cffi:defcfun ("ioctl" %ioctl) :int (fd :int) (request :unsigned-long) (arg :pointer))
(cffi:defcfun ("poll" %poll) :int (fds :pointer) (count :unsigned-long) (milliseconds :int))
(cffi:defcfun ("read" %read) :long (fd :int) (buffer :pointer) (count :size))
(cffi:defcfun ("write" %write) :long (fd :int) (buffer :pointer) (count :size))
(cffi:defcfun ("tcgetpgrp" %tcgetpgrp) :int (fd :int))
(cffi:defcfun ("setsid" %setsid) :int)
(cffi:defcfun ("waitpid" %waitpid) :int (pid :int) (status :pointer) (options :int))
(cffi:defcfun ("kill" %kill) :int (pid :int) (signal :int))
(cffi:defcvar ("environ" %environ) :pointer)
(cffi:defcfun ("posix_spawn_file_actions_init" %actions-init) :int (a :pointer))
(cffi:defcfun ("posix_spawn_file_actions_destroy" %actions-destroy) :int (a :pointer))
(cffi:defcfun ("posix_spawn_file_actions_addopen" %actions-open) :int
  (a :pointer) (fd :int) (name :string) (flags :int) (mode :unsigned-int))
(cffi:defcfun ("posix_spawn_file_actions_adddup2" %actions-dup) :int (a :pointer) (old :int) (new :int))
(cffi:defcfun ("posix_spawn_file_actions_addchdir_np" %actions-chdir) :int (a :pointer) (dir :string))
(cffi:defcfun ("posix_spawnattr_init" %attributes-init) :int (a :pointer))
(cffi:defcfun ("posix_spawnattr_destroy" %attributes-destroy) :int (a :pointer))
(cffi:defcfun ("posix_spawnattr_setflags" %attributes-flags) :int (a :pointer) (flags :short))
(cffi:defcfun ("posix_spawnattr_setsigmask" %attributes-mask) :int (a :pointer) (set :pointer))
(cffi:defcfun ("posix_spawnattr_setsigdefault" %attributes-defaults) :int (a :pointer) (set :pointer))
(cffi:defcfun ("sigemptyset" %sigempty) :int (set :pointer))
(cffi:defcfun ("sigfillset" %sigfill) :int (set :pointer))
(cffi:defcfun ("posix_spawnp" %spawnp) :int (pid :pointer) (file :string)
  (actions :pointer) (attributes :pointer) (argv :pointer) (env :pointer))
(cffi:defcfun ("fcntl" %fcntl) :int (fd :int) (command :int) (arg :int))
