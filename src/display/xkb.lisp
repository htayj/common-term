(in-package #:lispterm.display.wayland)
(cffi:define-foreign-library xkbcommon (:unix "libxkbcommon.so.0"))
(defvar *xkb-library* nil)
(defun ensure-xkb-library ()
  (or *xkb-library*
      (let ((path (or (let ((public (uiop:getenv "COMTERM_XKBCOMMON_LIBRARY")))
                        (and public (plusp (length public)) public))
                      (uiop:getenv "LISPTERM_XKBCOMMON_LIBRARY"))))
        (setf *xkb-library*
              (if (and path (plusp (length path)))
                  (cffi:load-foreign-library path)
                  (cffi:use-foreign-library xkbcommon))))))
(cffi:defcfun ("xkb_context_new" %xkb-context-new) :pointer (flags :int))
(cffi:defcfun ("xkb_context_unref" %xkb-context-unref) :void (context :pointer))
(cffi:defcfun ("xkb_keymap_new_from_buffer" %xkb-keymap-new) :pointer
  (context :pointer) (buffer :pointer) (length :unsigned-long) (format :int) (flags :int))
(cffi:defcfun ("xkb_keymap_unref" %xkb-keymap-unref) :void (keymap :pointer))
(cffi:defcfun ("xkb_state_new" %xkb-state-new) :pointer (keymap :pointer))
(cffi:defcfun ("xkb_state_unref" %xkb-state-unref) :void (state :pointer))
(cffi:defcfun ("xkb_state_update_mask" %xkb-update-mask) :int
  (state :pointer) (depressed :uint32) (latched :uint32) (locked :uint32)
  (depressed-layout :uint32) (latched-layout :uint32) (locked-layout :uint32))
(cffi:defcfun ("xkb_state_key_get_one_sym" %xkb-key-sym) :uint32 (state :pointer) (key :uint32))
(cffi:defcfun ("xkb_state_key_get_utf8" %xkb-key-utf8) :int
  (state :pointer) (key :uint32) (buffer :pointer) (size :unsigned-long))
(cffi:defcfun ("xkb_keysym_to_utf32" %xkb-sym-utf32) :uint32 (symbol :uint32))
(cffi:defcfun ("xkb_state_mod_name_is_active" %xkb-mod-active) :int
  (state :pointer) (name :string) (type :int))
(cffi:defcfun ("xkb_keymap_key_repeats" %xkb-key-repeats) :int (keymap :pointer) (key :uint32))
(defstruct xkb context keymap state)
(defun xkb-close (xkb)
  (when xkb
    (when (xkb-state xkb) (%xkb-state-unref (xkb-state xkb)) (setf (xkb-state xkb) nil))
    (when (xkb-keymap xkb) (%xkb-keymap-unref (xkb-keymap xkb)) (setf (xkb-keymap xkb) nil))
    (when (xkb-context xkb) (%xkb-context-unref (xkb-context xkb)) (setf (xkb-context xkb) nil))))
(defconstant +maximum-keymap-bytes+ (* 16 1024 1024))
(cffi:defcfun ("pread" %keymap-pread) :long
  (fd :int) (buffer :pointer) (count :unsigned-long) (offset :long))

(defun read-keymap (fd buffer size)
  "Copy bytes instead of mapping storage subject to concurrent truncation."
  (loop with offset = 0
        while (< offset size)
        for count = (%keymap-pread fd (cffi:inc-pointer buffer offset)
                                  (- size offset) offset)
        do (cond ((plusp count) (incf offset count))
                 ((zerop count) (wire-error "truncated keymap" nil))
                 ((/= (errno) 4) (wire-error "keymap pread"))))
  (unless (zerop (cffi:mem-aref buffer :uint8 (1- size)))
    (wire-error "keymap missing terminating NUL" nil))
  (let ((text (make-array (1- size) :element-type '(unsigned-byte 8))))
    (dotimes (i (length text))
      (let ((byte (cffi:mem-aref buffer :uint8 i)))
        (when (zerop byte) (wire-error "keymap contains embedded NUL" nil))
        (setf (aref text i) byte)))
    (handler-case (babel:octets-to-string text :encoding :utf-8 :errorp t)
      (error () (wire-error "keymap is not UTF-8 text" nil)))))

(defun xkb-from-fd (fd size)
  "Consume FD on every path; parse only private, validated memory."
  (unwind-protect
      (progn
        (unless (and (integerp size) (<= 2 size +maximum-keymap-bytes+))
          (wire-error "unsafe keymap size" nil))
        (cffi:with-foreign-pointer (buffer size)
          (read-keymap fd buffer size)
          (ensure-xkb-library)
          (let ((xkb (make-xkb)) (complete nil))
            (unwind-protect
                (progn
                  (setf (xkb-context xkb) (%xkb-context-new 0))
                  (when (cffi:null-pointer-p (xkb-context xkb))
                    (setf (xkb-context xkb) nil) (wire-error "xkb context" nil))
                  (setf (xkb-keymap xkb)
                        (%xkb-keymap-new (xkb-context xkb) buffer (1- size) 1 0))
                  (when (cffi:null-pointer-p (xkb-keymap xkb))
                    (setf (xkb-keymap xkb) nil) (wire-error "xkb keymap" nil))
                  (setf (xkb-state xkb) (%xkb-state-new (xkb-keymap xkb)))
                  (when (cffi:null-pointer-p (xkb-state xkb))
                    (setf (xkb-state xkb) nil) (wire-error "xkb state" nil))
                  (setf complete t)
                  xkb)
              (unless complete (xkb-close xkb))))))
    (%close fd)))
(defun xkb-normalized-key (xkb keycode)
  (let* ((state (xkb-state xkb)) (code (+ keycode 8))
         (sym (%xkb-key-sym state code))
         (special (cdr (assoc sym '((#xff08 . :backspace) (#xff09 . :tab)
                                   (#xff0d . :return) (#xff1b . :escape)
                                   (#xff50 . :home) (#xff51 . :left) (#xff52 . :up)
                                   (#xff53 . :right) (#xff54 . :down) (#xff55 . :prior)
                                   (#xff56 . :next) (#xff57 . :end)
                                   (#xff63 . :insert) (#xffff . :delete)))))
         (unicode (%xkb-sym-utf32 sym))
         (key (or (lispterm.display::keysym-keypad-key sym) special
                  (when (<= #xffbe sym #xffc9)
                    (intern (format nil "F~D" (1+ (- sym #xffbe))) :keyword))
                  (and (plusp unicode) (code-char unicode))))
         (mods (loop for (name . keyword) in '(("Shift" . :shift) ("Control" . :control)
                                              ("Mod1" . :alt) ("Mod4" . :super))
                     when (= 1 (%xkb-mod-active state name 8)) collect keyword))
         (text (cffi:with-foreign-object (buffer :uint8 128)
                 (let ((n (%xkb-key-utf8 state code buffer 128)))
                   (when (and (> n 0) (< n 128))
                     (cffi:foreign-string-to-lisp buffer :count n :encoding :utf-8))))))
    (when key (list :key key :text (or (lispterm.display::keypad-text key) text)
                    :modifiers mods))))
(defun emit-key (state keycode)
  (when (wayland-state-xkb state)
    (let ((key (xkb-normalized-key (wayland-state-xkb state) keycode)))
      (when key
        (lispterm.trace:trace-event :key-emit)
        (apply #'protocol-emit state :key key)))))
(defun keyboard-event (state opcode payload)
  (case opcode
    ;; Keep ancillary ownership in the wire queue until the payload is valid.
    (0 (unless (= (length payload) 8) (wire-error "invalid keymap payload" nil))
       (let ((format (bytes-u32 payload 0)) (size (bytes-u32 payload 4))
             (fd (wire-fd-pop (wayland-state-wire state))))
         (if (= format 1)
             (let ((new (xkb-from-fd fd size)))
               (xkb-close (wayland-state-xkb state))
               (setf (wayland-state-xkb state) new))
             (%close fd))))
    (1 (protocol-emit state :focus :focused-p t))
    (2 (setf (wayland-state-repeat-key state) nil)
       (protocol-emit state :focus :focused-p nil))
    (3 (let ((key (bytes-u32 payload 8)) (pressed (bytes-u32 payload 12)))
         ;; Metadata only: the compositor's event time and the state, never the key.
         (lispterm.trace:trace-event :key-dispatch :event-time (bytes-u32 payload 4)
           :pressed (= pressed 1))
         (if (= pressed 1)
             (progn
               (emit-key state key)
               (when (and (wayland-state-xkb state) (> (wayland-state-repeat-rate state) 0)
                          (= 1 (%xkb-key-repeats (xkb-keymap (wayland-state-xkb state)) (+ key 8))))
                 (setf (wayland-state-repeat-key state) key
                       (wayland-state-repeat-at state)
                       (+ (get-internal-real-time)
                          (round (* (/ (wayland-state-repeat-delay state) 1000)
                                    internal-time-units-per-second))))))
             (when (eql key (wayland-state-repeat-key state))
               (setf (wayland-state-repeat-key state) nil)))))
    (4 (when (wayland-state-xkb state)
         (%xkb-update-mask (xkb-state (wayland-state-xkb state))
                           (bytes-u32 payload 4) (bytes-u32 payload 8) (bytes-u32 payload 12)
                           0 0 (bytes-u32 payload 16))))
    (5 (setf (wayland-state-repeat-rate state) (max 0 (signed32 (bytes-u32 payload 0)))
             (wayland-state-repeat-delay state) (max 0 (signed32 (bytes-u32 payload 4)))))))
(defun keyboard-repeat (state)
  ;; At most one repeat per poll, avoiding unbounded catch-up after a stalled host.
  (when (and (wayland-state-repeat-key state) (> (wayland-state-repeat-rate state) 0)
             (>= (get-internal-real-time) (wayland-state-repeat-at state)))
    (emit-key state (wayland-state-repeat-key state))
    (setf (wayland-state-repeat-at state)
          (+ (get-internal-real-time)
             (round (/ internal-time-units-per-second (wayland-state-repeat-rate state)))))))
