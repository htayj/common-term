(in-package #:lispterm.display.wayland)
(cffi:defcfun ("memfd_create" %memfd-create) :int (name :string) (flags :unsigned-int))
(cffi:defcfun ("ftruncate" %ftruncate) :int (fd :int) (size :long))
(cffi:defcfun ("mmap" %mmap) :pointer (address :pointer) (length :unsigned-long)
  (protection :int) (flags :int) (fd :int) (offset :long))
(cffi:defcfun ("munmap" %munmap) :int (address :pointer) (length :unsigned-long))
(defstruct shm-buffer id pointer size width height generation (busy-p nil) (destroyed-p nil))
(defun destroy-shm-buffer (state buffer &optional disconnected)
  (let ((wire (wayland-state-wire state)))
    (unless (shm-buffer-destroyed-p buffer)
      (unless disconnected (wire-send wire (shm-buffer-id buffer) 0))
      (setf (shm-buffer-destroyed-p buffer) t))
    ;; Queued releases remain legal until the ordered display.delete_id.
    ;; After disconnect there can be no more events to drain.
    (when disconnected (remhash (shm-buffer-id buffer) (wire-handlers wire)))
    (when (shm-buffer-pointer buffer)
      (%munmap (shm-buffer-pointer buffer) (shm-buffer-size buffer))
      (setf (shm-buffer-pointer buffer) nil))))
(defun make-protocol-buffer (state width height)
  ;; Bound hostile compositor configure sizes before multiplication/allocation.
  (unless (and (<= 1 width 16384) (<= 1 height 16384) (<= (* width height) 67108864))
    (wire-error "unsafe shm dimensions" nil))
  (let* ((wire (wayland-state-wire state)) (size (* width height 4))
         (fd (%memfd-create "lispterm-wayland" 1)) (pointer nil) (buffer nil))
    (when (minusp fd) (wire-error "memfd_create"))
    (unwind-protect
        (progn
          (when (minusp (%ftruncate fd size)) (wire-error "ftruncate"))
          (setf pointer (%mmap (cffi:null-pointer) size 3 1 fd 0))
          (when (= (cffi:pointer-address pointer) #xffffffffffffffff)
            (setf pointer nil) (wire-error "mmap"))
          (let ((pool (wire-id wire :shm-pool (constantly nil)))
                (id (wire-id wire :buffer
                      (lambda (id opcode payload)
                        (declare (ignore id))
                        (unless (and (= opcode 0) (zerop (length payload)))
                          (wire-error "invalid wl_buffer.release event" nil))
                        (setf (shm-buffer-busy-p buffer) nil)))))
            (setf buffer (make-shm-buffer :id id :pointer pointer :size size
                                         :width width :height height
                                         :generation (wayland-state-generation state)))
            (wire-send wire (wayland-state-shm state) 0 pool (list :fd fd) size)
            (wire-send wire pool 0 id 0 width height (* 4 width) 0) ; WL_SHM_FORMAT_ARGB8888
            (wire-send wire pool 1) ; Server keeps buffer mapping after pool destruction.
            (remhash pool (wire-handlers wire))
            (push buffer (wayland-state-buffers state))
            (setf pointer nil) buffer))
      (%close fd)
      (when pointer (%munmap pointer size)))))
(defun protocol-collect-buffers (state)
  (setf (wayland-state-buffers state)
        (delete-if (lambda (buffer)
                     (when (and (not (shm-buffer-busy-p buffer))
                                (/= (shm-buffer-generation buffer) (wayland-state-generation state)))
                       (destroy-shm-buffer state buffer) t))
                   (wayland-state-buffers state))))
(defun protocol-present (state pixels width height)
  "Copy the newest CPU image into an idle SHM buffer. At most two buffers
per size generation. Busy old buffers survive resize until compositor release."
  (unless (wayland-state-configured-p state) (return-from protocol-present nil))
  (protocol-collect-buffers state)
  (when (wayland-state-frame-pending-p state) (return-from protocol-present nil))
  (let* ((scale (wayland-state-scale state))
         (bw (* width scale)) (bh (* height scale))
         (generation (wayland-state-generation state))
         (current (remove-if-not (lambda (b) (= generation (shm-buffer-generation b)))
                                 (wayland-state-buffers state)))
         (buffer (or (find-if-not #'shm-buffer-busy-p current)
                     (when (and (< (length current) 2)
                                (< (length (wayland-state-buffers state)) 8)
                                (<= (+ (* bw bh 4)
                                       (reduce #'+ (wayland-state-buffers state)
                                               :key #'shm-buffer-size :initial-value 0))
                                    268435456))
                       (make-protocol-buffer state bw bh))))
         (wire (wayland-state-wire state)))
    (unless buffer (return-from protocol-present nil))
    (unless (and (= width (wayland-state-width state)) (= height (wayland-state-height state)))
      (wire-error "framebuffer and surface dimensions differ" nil))
    ;; Integer nearest-neighbour buffer scale. CPU font rasterization stays logical-size.
    (dotimes (y bh)
      (dotimes (x bw)
        (setf (cffi:mem-aref (shm-buffer-pointer buffer) :uint32 (+ x (* y bw)))
              (aref pixels (+ (floor x scale) (* (floor y scale) width))))))
    (let ((callback (wire-id wire :callback
                     (lambda (id opcode payload)
                       (declare (ignore opcode payload))
                       (remhash id (wire-handlers wire))
                       (setf (wayland-state-frame-pending-p state) nil)))))
      (wire-send wire (wayland-state-surface state) 3 callback)
      (wire-send wire (wayland-state-surface state) 8 scale)
      (wire-send wire (wayland-state-surface state) 1 (shm-buffer-id buffer) 0 0)
      (wire-send wire (wayland-state-surface state) 2 0 0 width height)
      (setf (shm-buffer-busy-p buffer) t)
      (wire-send wire (wayland-state-surface state) 6)
      (setf (wayland-state-frame-pending-p state) t
            (wayland-state-redraw-p state) nil)) t))
(defun protocol-close (state)
  "Disconnect first: then every server SHM reference is gone. Idempotent."
  (when state
    (wire-close (wayland-state-wire state))
    (dolist (buffer (wayland-state-buffers state))
      (destroy-shm-buffer state buffer t))
    (setf (wayland-state-buffers state) nil (wayland-state-closed-p state) t)
    (when (wayland-state-xkb state) (xkb-close (wayland-state-xkb state))
          (setf (wayland-state-xkb state) nil))) nil)
