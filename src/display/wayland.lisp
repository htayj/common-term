(in-package #:lispterm.display.wayland)

;; GPU module installs these hooks after the display system is loaded.
(defvar *direct-present-hook* nil)
(defvar *direct-close-hook* nil)
(defvar *direct-metrics-hook* nil)

(defstruct wayland-window protocol events (pending-frame-p nil))
(defun window-protocol (display)
  (wayland-window-protocol (lispterm.display:display-backend-state display)))
(defun backend-failure (condition)
  (error 'lispterm.display:display-connection-lost :detail condition))
(defun convert-event (event display)
  (destructuring-bind (kind &rest args) event
    (case kind
      (:key (apply #'lispterm.display:make-key-event args))
      (:focus (apply #'lispterm.display:make-focus-event args))
      (:close (lispterm.display:make-close-event))
      (:resize (let ((font (lispterm.display:display-font display)))
                 (apply #'lispterm.display:make-resize-event
                        :columns (max 1 (floor (getf args :width) (lispterm.display:font-width font)))
                        :rows (max 1 (floor (getf args :height) (lispterm.display:font-height font)))
                        args))))))
(defmethod lispterm.display:backend-open ((backend (eql :wayland)) display)
  (declare (ignore backend))
  (let ((window (make-wayland-window)))
    (setf (lispterm.display:display-backend-state display) window)
    (setf (wayland-window-protocol window)
          (protocol-open
            :name (lispterm.display:display-name display)
            :width (lispterm.display:display-width display)
            :height (lispterm.display:display-height display)
            :title (lispterm.display:display-title display)
            :event-sink (lambda (event) (push event (wayland-window-events window)))
            :resize-sink (lambda (width height scale)
                           (lispterm.display:resize-display display width height)
                           (setf (wayland-window-pending-frame-p window) nil)
                           (push (list :resize :width width :height height :scale scale)
                                 (wayland-window-events window)))))
    window))
(defmethod lispterm.display:backend-close ((backend (eql :wayland)) display)
  (declare (ignore backend))
  (let ((window (lispterm.display:display-backend-state display)))
    (when window
      (protocol-close (wayland-window-protocol window))
        (when *direct-close-hook* (funcall *direct-close-hook* display))
      (setf (lispterm.display:display-backend-state display) nil))))
(defun flush-window (display window)
  (when (wayland-window-pending-frame-p window)
    ;; A negotiated direct presenter returns :unsupported, :busy, or :presented.
    ;; Only the unsupported case is allowed to request a CPU readback buffer.
    (let ((direct (if *direct-present-hook* (funcall *direct-present-hook* display)
                      :unsupported)))
      (when (or (eq direct :presented)
                (and (eq direct :unsupported)
                     (protocol-present (wayland-window-protocol window)
                                       (lispterm.display:display-framebuffer display)
                                       (lispterm.display:display-width display)
                                       (lispterm.display:display-height display))))
        (setf (wayland-window-pending-frame-p window) nil)))))
(defmethod lispterm.display:backend-blit ((backend (eql :wayland)) display framebuffer rectangles)
  (declare (ignore backend framebuffer rectangles))
  (let ((window (lispterm.display:display-backend-state display)))
    (setf (wayland-window-pending-frame-p window) t)
    (handler-case (flush-window display window)
      (error (c) (backend-failure c)))))
(defmethod lispterm.display:backend-poll ((backend (eql :wayland)) display timeout)
  (declare (ignore backend))
  (let* ((window (lispterm.display:display-backend-state display))
         (state (wayland-window-protocol window)))
    (handler-case
        (progn
          ;; Bound repeat latency without starting a timer thread.
          (let ((wait (if (wayland-state-repeat-key state)
                          (min (or timeout 0) .02) (or timeout 0))))
            (protocol-pump state wait))
          (keyboard-repeat state)
          (protocol-collect-buffers state)
          (flush-window display window)
          (mapcar (lambda (event) (convert-event event display))
                  (prog1 (nreverse (wayland-window-events window))
                    (setf (wayland-window-events window) nil))))
      (error (c) (backend-failure c)))))
(defmethod lispterm.display:backend-set-title ((backend (eql :wayland)) display title)
  (declare (ignore backend))
  (handler-case
      (let ((state (window-protocol display)))
        (setf (wayland-state-title state) title)
        (wire-send (wayland-state-wire state) (wayland-state-toplevel state) 2 (wl-string title)))
    (error (c) (backend-failure c))))
(defmethod lispterm.display:backend-metrics ((backend (eql :wayland)) display)
  (declare (ignore backend))
  (let ((state (window-protocol display)))
    (list :configure-serial (wayland-state-configure-serial state)
          :configure-states (copy-list (wayland-state-states state))
          :configure-generation (wayland-state-configure-generation state)
          :commit-generation (wayland-state-commit-generation state)
          :frame-generation (wayland-state-frame-generation state)
          :committed-request-id (wayland-state-committed-request-id state)
          :committed-epoch (wayland-state-committed-epoch state)
          :frame-request-id (wayland-state-frame-request-id state)
          :frame-epoch (wayland-state-frame-epoch state)
          :committed-width (wayland-state-committed-width state)
          :committed-height (wayland-state-committed-height state)
          :committed-buffer-width (wayland-state-committed-buffer-width state)
          :committed-buffer-height (wayland-state-committed-buffer-height state)
          :buffer-generation (wayland-state-generation state)
          :buffer-width (* (wayland-state-scale state) (wayland-state-width state))
          :buffer-height (* (wayland-state-scale state) (wayland-state-height state))
          :geometry-transaction (wayland-state-geometry-phase state)
          :frame-pending-p (wayland-state-frame-pending-p state)
          :buffer-scale (wayland-state-scale state)
          :configured-p (wayland-state-configured-p state)
          :native-wayland-p t
          :direct-presentation (when *direct-metrics-hook*
                                 (funcall *direct-metrics-hook* state)))))

(defmethod lispterm.display:backend-request-size ((backend (eql :wayland)) display request)
  (declare (ignore backend))
  (let ((state (window-protocol display)))
    (setf (wayland-state-geometry-display state) display
          (wayland-state-geometry-next state) request)
    (protocol-geometry-start state)))
(defmethod lispterm.display:backend-cancel-size ((backend (eql :wayland)) display request)
  (declare (ignore backend))
  (let ((state (window-protocol display)))
    (when state
      (when (eq request (wayland-state-geometry-next state))
        (setf (wayland-state-geometry-next state) nil))
      (protocol-geometry-close state))))
