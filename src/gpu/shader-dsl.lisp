;;;; A deliberately small, typed shader language. No source-text escape hatch.
(in-package #:lispterm.gpu)

(define-condition shader-error (error)
  ((form :initarg :form :reader shader-error-form)
   (reason :initarg :reason :reader shader-error-reason))
  (:report (lambda (c s) (format s "Invalid shader: ~A" (shader-error-reason c)))))

(defun shader-invalid (form control &rest arguments)
  (error 'shader-error :form form :reason (apply #'format nil control arguments)))

(defun shader-name (name)
  "Only keyword identifiers, with a restricted ASCII alphabet, enter GLSL."
  (unless (keywordp name) (shader-invalid name "Identifier must be a keyword"))
  (let ((s (string-downcase (substitute #\_ #\- (symbol-name name)))))
    (unless (and (plusp (length s)) (<= (length s) 64)
                 (find (char s 0) "abcdefghijklmnopqrstuvwxyz")
                 (every (lambda (c) (find c "abcdefghijklmnopqrstuvwxyz_0123456789")) s)
                 (not (search "__" s)) (not (search "gl_" s :end2 (min 3 (length s))))
                 (not (member s '("if" "else" "void" "main" "int" "uint" "float"
                                  "bool" "uniform" "in" "out" "layout" "precision"
                                  "return" "discard" "for" "while" "switch" "struct"
                                  "const" "flat" "smooth" "highp" "lowp" "mediump"
                                  "sampler2d" "vec2" "vec3" "vec4" "ivec2" "ivec3"
                                  "ivec4" "uvec2" "uvec3" "uvec4" "true" "false"
                                  "attribute" "varying" "centroid" "invariant" "inout"
                                  "break" "continue" "do" "case" "default" "precision"
                                  "coherent" "volatile" "restrict" "readonly" "writeonly"
                                  "buffer" "shared" "patch" "sample" "subroutine"
                                  "mat2" "mat3" "mat4" "bvec2" "bvec3" "bvec4"
                                  "atomic_uint" "double" "dvec2" "dvec3" "dvec4"
                                  "class" "union" "enum" "typedef" "template" "this"
                                  "resource" "goto" "inline" "noinline" "public" "static"
                                  "extern" "external" "interface" "long" "short" "half"
                                  "fixed" "unsigned" "superp" "input" "output" "common"
                                  "partition" "active" "filter" "sizeof" "cast" "namespace"
                                  "using" "row_major" "sampler3d" "samplercube"
                                  "position" "vertex_id" "fragment_coordinate")
                              :test #'string=)))
      (shader-invalid name "Unsafe or reserved identifier"))
    s))

(defun shader-type-name (type)
  (or (cdr (assoc type '((:int . "int") (:uint . "uint") (:float . "float")
                         (:bool . "bool") (:ivec2 . "ivec2") (:ivec3 . "ivec3")
                         (:ivec4 . "ivec4") (:uvec2 . "uvec2") (:uvec3 . "uvec3")
                         (:uvec4 . "uvec4") (:vec2 . "vec2") (:vec3 . "vec3")
                         (:vec4 . "vec4") (:sampler2d . "sampler2D"))))
      (shader-invalid type "Unsupported type")))

(defun shader-base-type (type)
  (cond ((member type '(:int :ivec2 :ivec3 :ivec4)) :int)
        ((member type '(:uint :uvec2 :uvec3 :uvec4)) :uint)
        ((member type '(:float :vec2 :vec3 :vec4)) :float)
        (t type)))

(defun shader-components (type)
  (case type ((:ivec2 :uvec2 :vec2) 2) ((:ivec3 :uvec3 :vec3) 3)
        ((:ivec4 :uvec4 :vec4) 4) (otherwise 1)))

(defun shader-tree-bound (form)
  "Reject dotted, cyclic, excessively deep or large forms before traversal."
  (let ((remaining 12000))
    (labels ((walk (x depth)
               (when (or (minusp (decf remaining)) (> depth 96))
                 (shader-invalid nil "AST exceeds its size/depth bound"))
               (when (consp x)
                 (unless (listp (cdr x)) (shader-invalid x "Dotted list"))
                 (walk (car x) (1+ depth)) (walk (cdr x) (1+ depth)))
               (unless (or (consp x) (null x) (keywordp x) (integerp x))
                 (shader-invalid x "AST leaves must be keywords or integers"))))
      (walk form 0))))

(defun emit-shader (form)
  "Emit GLSL ES 3.00 from (:SHADER stage declarations... (:MAIN statements...)).
Expressions are typed prefix lists. See shader-interface.org for the grammar.
No driver operations are performed. Malformed programs signal SHADER-ERROR."
  (shader-tree-bound form)
  (unless (and (listp form) (eq (first form) :shader)
               (member (second form) '(:vertex :fragment)) (cddr form))
    (shader-invalid form "Expected a vertex or fragment shader"))
  (let ((env nil) (stage (second form)) (locations nil) (output-count 0))
    (labels
        ((proper (x) (unless (listp x) (shader-invalid x "Expected a proper list"))
           (handler-case (length x) (type-error () (shader-invalid x "Dotted list"))))
         (arity (x n) (unless (= (proper x) n) (shader-invalid x "Wrong arity")))
         (lookup (name) (or (assoc name env) (shader-invalid name "Undeclared identifier")))
         (bind-name (name type writable)
           (shader-name name) (shader-type-name type)
           (when (find (shader-name name) env :test #'string=
                       :key (lambda (binding) (shader-name (first binding))))
             (shader-invalid name "Duplicate identifier after GLSL normalization"))
           (push (list name type writable) env))
         (expect-type (actual expected expression)
           (unless (eq actual expected) (shader-invalid expression "Expected ~S, got ~S" expected actual)))
         (expr (x)
           (cond
             ((integerp x)
              (unless (<= (- (expt 2 31)) x (1- (expt 2 31)))
                (shader-invalid x "Integer literal out of range"))
              (values (if (= x (- (expt 2 31))) "(-2147483647 - 1)" (format nil "~D" x)) :int))
             ((member x '(:true :false)) (values (string-downcase (symbol-name x)) :bool))
             ((eq x :vertex-id)
              (unless (eq stage :vertex) (shader-invalid x "Vertex ID in fragment stage"))
              (values "gl_VertexID" :int))
             ((eq x :fragment-coordinate)
              (unless (eq stage :fragment) (shader-invalid x "Fragment coordinate in vertex stage"))
              (values "gl_FragCoord" :vec4))
             ((keywordp x) (values (shader-name x) (second (lookup x))))
             ((consp x)
              (proper x)
              (let ((op (first x)) (args (rest x)))
                (cond
                  ((eq op :uint)
                   (arity x 2)
                   (unless (and (integerp (second x)) (<= 0 (second x) #xffffffff))
                     (shader-invalid x "uint literal requires unsigned 32-bit integer"))
                   (values (format nil "~Du" (second x)) :uint))
                  ((eq op :float)
                   (arity x 2)
                   (unless (and (integerp (second x)) (<= (abs (second x)) 16777216))
                     (shader-invalid x "float literal requires an exactly representable integer"))
                   (values (format nil "~D.0" (second x)) :float))
                  ((eq op :swizzle)
                   (arity x 3)
                   (multiple-value-bind (text type) (expr (second x))
                     (let* ((field (third x))
                            (s (and (keywordp field) (string-downcase (symbol-name field))))
                            (n (shader-components type)))
                       (unless (and s (> n 1) (<= 1 (length s) 4)
                                    (every (lambda (c) (find c (subseq "xyzw" 0 n))) s))
                         (shader-invalid x "Invalid vector swizzle"))
                       (values (format nil "(~A).~A" text s)
                               (if (= 1 (length s)) (shader-base-type type)
                                   (intern (format nil "~AVEC~D"
                                                   (case (shader-base-type type) (:int "I") (:uint "U") (t ""))
                                                   (length s)) :keyword))))))
                  ((eq op :cast)
                   (arity x 3)
                   (let ((target (second x)))
                     (shader-type-name target)
                     (multiple-value-bind (text type) (expr (third x))
                       (unless (and (member (shader-base-type target) '(:int :uint :float))
                                    (member (shader-base-type type) '(:int :uint :float))
                                    (= (shader-components target) (shader-components type)))
                         (shader-invalid x "Invalid numeric conversion"))
                       (values (format nil "~A(~A)" (shader-type-name target) text) target))))
                  ((member op '(:ivec2 :ivec3 :ivec4 :uvec2 :uvec3 :uvec4 :vec2 :vec3 :vec4))
                   (let ((texts nil) (count 0))
                     (dolist (a args)
                       (multiple-value-bind (text type) (expr a)
                         (expect-type (shader-base-type type) (shader-base-type op) x)
                         (incf count (shader-components type)) (push text texts)))
                     (unless (or (= count (shader-components op))
                                 (and (= (length args) 1) (= count 1)))
                       (shader-invalid x "Constructor component count mismatch"))
                     (values (format nil "~A(~{~A~^, ~})" (shader-type-name op) (nreverse texts)) op)))
                  ((eq op :choose)
                   (arity x 4)
                   (multiple-value-bind (condition ct) (expr (second x))
                     (expect-type ct :bool x)
                     (multiple-value-bind (yes yt) (expr (third x))
                       (multiple-value-bind (no nt) (expr (fourth x))
                         (expect-type yt nt x)
                         (values (format nil "(~A ? ~A : ~A)" condition yes no) yt)))))
                  ((eq op :texel-fetch)
                   (arity x 4)
                   (multiple-value-bind (sampler st) (expr (second x))
                     (expect-type st :sampler2d x)
                     (multiple-value-bind (coord ct) (expr (third x))
                       (expect-type ct :ivec2 x)
                       (multiple-value-bind (level lt) (expr (fourth x))
                         (expect-type lt :int x)
                         (values (format nil "texelFetch(~A, ~A, ~A)" sampler coord level) :vec4)))))
                  ((eq op :not)
                   (arity x 2)
                   (multiple-value-bind (text type) (expr (second x))
                     (expect-type type :bool x) (values (format nil "(!~A)" text) :bool)))
                  (t
                   (arity x 3)
                   (let ((token (cdr (assoc op '((:+ . "+") (:- . "-") (:* . "*") (:/ . "/")
                                               (:% . "%") (:bit-and . "&") (:shift-right . ">>")
                                               (:= . "==") (:/= . "!=") (:< . "<") (:<= . "<=")
                                               (:> . ">") (:>= . ">=") (:and . "&&") (:or . "||"))))))
                     (unless token (shader-invalid x "Unknown operator"))
                     (multiple-value-bind (a at) (expr (second x))
                       (multiple-value-bind (b bt) (expr (third x))
                         (cond
                           ((member op '(:and :or))
                            (expect-type at :bool x) (expect-type bt :bool x))
                           ((member op '(:= :/= :< :<= :> :>=))
                            (expect-type at bt x)
                            (unless (and (= 1 (shader-components at))
                                         (member at '(:int :uint :float :bool))
                                         (or (not (eq at :bool)) (member op '(:= :/=))))
                              (shader-invalid x "Comparison requires matching scalars")))
                           (t
                            (unless (and (member (shader-base-type at) '(:int :uint :float))
                                         (eq (shader-base-type at) (shader-base-type bt))
                                         (or (eq at bt) (= 1 (shader-components at))
                                            (= 1 (shader-components bt))))
                              (shader-invalid x "Incompatible arithmetic operands"))
                            (when (and (member op '(:% :bit-and :shift-right))
                                       (eq (shader-base-type at) :float))
                              (shader-invalid x "Integer operator on float"))))
                         (values (format nil "(~A ~A ~A)" a token b)
                                 (if (member op '(:= :/= :< :<= :> :>= :and :or)) :bool
                                    (if (> (shader-components bt) (shader-components at)) bt at))))))))))
             (t (shader-invalid x "Malformed expression"))))
         (statements (forms stream indent)
           (proper forms)
           (dolist (s forms)
             (proper s)
             (case (first s)
               (:let
                (arity s 4)
                (let ((type (second s)) (name (third s)))
                  (when (eq type :sampler2d) (shader-invalid s "Sampler must be uniform"))
                  (multiple-value-bind (text actual) (expr (fourth s))
                    (expect-type actual type s) (bind-name name type t)
                    (format stream "~V@T~A ~A = ~A;~%" indent (shader-type-name type) (shader-name name) text))))
               (:set
                (arity s 3)
                (let* ((name (second s)) (position (eq name :position))
                       (binding (unless position (lookup name)))
                       (type (if position :vec4 (second binding))))
                  (unless (if position (eq stage :vertex) (third binding))
                    (shader-invalid s "Assignment target is read-only"))
                  (multiple-value-bind (text actual) (expr (third s))
                    (expect-type actual type s)
                    (format stream "~V@T~A = ~A;~%" indent
                            (if position "gl_Position" (shader-name name)) text))))
               (:if
                (unless (member (proper s) '(3 4)) (shader-invalid s "Invalid conditional"))
                (multiple-value-bind (text actual) (expr (second s))
                  (expect-type actual :bool s)
                  (format stream "~V@Tif (~A) {~%" indent text)
                  (let ((saved env))
                    (unwind-protect (statements (third s) stream (+ indent 2))
                      (setf env saved)))
                  (format stream "~V@T}" indent)
                  (when (fourth s)
                    (format stream " else {~%")
                    (let ((saved env))
                      (unwind-protect (statements (fourth s) stream (+ indent 2))
                        (setf env saved)))
                    (format stream "~V@T}" indent))
                  (terpri stream)))
               (otherwise (shader-invalid s "Unknown statement")))))
         (emit-declaration (d stream)
           (unless (member (proper d) '(3 4 5)) (shader-invalid d "Malformed declaration"))
           (destructuring-bind (kind type name &optional location flat) d
             (unless (member kind '(:input :output :uniform)) (shader-invalid d "Unknown declaration"))
             (unless (and (or (null flat) (eq flat :flat))
                          (if (eq kind :uniform) (and (null location) (null flat))
                              (and (integerp location) (<= 0 location 15)))
                          (or (not (eq type :sampler2d)) (eq kind :uniform)))
               (shader-invalid d "Invalid declaration qualifiers"))
             (when (and (eq stage :fragment) (eq kind :input)
                        (member (shader-base-type type) '(:int :uint)) (not flat))
               (shader-invalid d "Integer fragment inputs require flat interpolation"))
             (when (and (eq stage :vertex) (eq kind :output)
                        (member (shader-base-type type) '(:int :uint)) (not flat))
               (shader-invalid d "Integer vertex outputs require flat interpolation"))
             (when (and (not (eq kind :uniform)) (eq type :bool))
               (shader-invalid d "Boolean interface variables are unsupported"))
             (when (and flat (not (or (and (eq stage :vertex) (eq kind :output))
                                      (and (eq stage :fragment) (eq kind :input)))))
               (shader-invalid d "Interpolation qualifier on non-varying"))
             (when (and (not (eq kind :uniform)) (member (cons kind location) locations :test #'equal))
               (shader-invalid d "Duplicate interface location"))
             (push (cons kind location) locations)
             (bind-name name type (eq kind :output))
             (when (eq kind :output) (incf output-count))
             ;; ES 3.00 has explicit locations for attributes and fragment results,
             ;; but not for vertex/fragment varyings (which link by name).
             (when (or (and (eq stage :vertex) (eq kind :input))
                       (and (eq stage :fragment) (eq kind :output)))
               (format stream "layout(location = ~D) " location))
             (when flat (format stream "flat "))
             (format stream "~A ~A ~A;~%" (ecase kind (:input "in") (:output "out") (:uniform "uniform"))
                     (shader-type-name type) (shader-name name)))))
      (with-output-to-string (stream)
        (format stream "#version 300 es~%precision highp float;~%precision highp int;~%")
        (proper form)
        (let* ((body (cddr form)) (main (car (last body))))
          (unless (and (consp main) (eq (car main) :main)) (shader-invalid main "Missing final main block"))
          (dolist (d (butlast body)) (emit-declaration d stream))
          (when (and (eq stage :fragment) (zerop output-count))
            (shader-invalid form "Fragment stage needs an output"))
          (format stream "void main() {~%")
          (statements (cdr main) stream 2)
          (format stream "}~%"))))))

(export '(shader-error shader-error-form shader-error-reason))
